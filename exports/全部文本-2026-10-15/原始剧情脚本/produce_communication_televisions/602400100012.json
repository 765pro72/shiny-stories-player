  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、うん\r\n口元っていうより、全体に輝いてたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6024001000110030,
    "speaker": "にちか",
    "text": "えーっ\r\nそういうのじゃなくてーーー！",
    "charAnim1": "anger2",
