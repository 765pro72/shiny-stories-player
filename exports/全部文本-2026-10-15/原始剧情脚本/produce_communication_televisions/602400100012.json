  },
  {
    "id": 6024001000110020,
    "speaker": "にちか",
    "text": "直前にリップ塗り直してもらったんですけど……\r\nつやつやしてましたかね！？",
    "charAnim1": "surp1",
    "charAnim2": "face_excite",
    "charLipAnim": "lip_smile",
    "charLabel": "nichika",
