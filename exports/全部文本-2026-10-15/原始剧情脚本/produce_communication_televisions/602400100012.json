  },
  {
    "id": 6024001000110040,
    "speaker": "にちか",
    "text": "パフォーマンスはいいとして、\r\n初見の人って結局ビジュアルが大きいじゃないですかぁ！",
    "charAnim1": "anger1",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0220",
    "voice": "produce_communication_televisions/602400100012/6024001000110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うーん\r\n否定するわけじゃないけど、そんなことより────",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0328"
  },
  {
    "id": 6024001000110050,
    "speaker": "にちか",
