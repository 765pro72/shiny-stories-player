  },
  {
    "id": 6018001000210050,
    "speaker": "冬優子",
    "text": "もっともっと良い、最高の上を突っ走るふゆを……\r\nファンにも、スタッフにも見せつけてやる！",
    "charAnim1": "hello",
    "charLipAnim": "lip_smile",
