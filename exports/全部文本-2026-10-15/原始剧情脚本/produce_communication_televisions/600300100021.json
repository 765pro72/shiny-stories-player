      "order": 0
    },
    "bg": "00009",
    "bgm": "002"
  },
  {
    "id": 6003001000210010,
    "speaker": "めぐる",
    "text": "ありがとう、すっごく楽しかったよー！\r\nでもね、まだまだできることがあると思うんだ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210010"
  },
  {
    "id": 6003001000210020,
    "speaker": "めぐる",
    "text": "カメラばっかり意識しちゃうと固まっちゃうし、\r\n次はもっと自然に動けるようになりたくって……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210020"
  },
  {
    "id": 6003001000210030,
    "speaker": "めぐる",
    "text": "カメラより、見ててくれる人のことを考えればいいのかな？\r\nそれともカメラを人だと思って……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210030"
  },
  {
    "speaker": "プロデューサー",
    "text": "（もう次に向けての反省をしてるのか）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001000210040,
    "speaker": "めぐる",
    "text": "あっ、そうだ！　連絡……は、あんまりしないって……\r\n……でも、今回は大きいお仕事だったし……いっか！",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……と思ったそばから友達に連絡をし始めるのは、\r\n本当にめぐるらしい）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001000210050,
    "speaker": "めぐる",
    "text": "うん！　じゃあまた！　……あれ？　プロデューサー\r\n笑ってるけどどうかしたの？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、めぐるも成長したなと思って",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001000210060,
    "speaker": "めぐる",
    "text": "プロデューサーもそう思ってくれてるの？\r\n最近友達にも言われて嬉しかったんだ！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210060"
  },
  {
    "id": 6003001000210070,
    "speaker": "めぐる",
    "text": "……そうやって応援してくれる人たちのために、\r\nもっともっと頑張らなきゃいけないよね！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_televisions/600300100021/6003001000210070"
  },
