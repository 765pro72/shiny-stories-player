[
  {
    "speaker": "プロデューサー",
    "text": "テレビ出演、お疲れ様\r\nよく頑張ったな",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
