    "voice": "produce_communication_televisions/600700100021/6007001000210040"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当のことだからな",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6007001000210050,
    "speaker": "結華",
    "text": "……そっか。……ふふ。三峰、味しめちゃったかも\r\nもっと褒めてもらえるように頑張らなきゃだね",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
