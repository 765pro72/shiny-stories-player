    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6007001000210030,
    "speaker": "結華",
    "text": "ありゃ？　そこは、慢心しないでレッスンあるのみ！\r\nって熱血系で忠告のパターンじゃないの？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
