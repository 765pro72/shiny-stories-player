  },
  {
    "id": 4001079010380,
    "speaker": "摩美々",
    "text": "『家中探し回ったのですが、見つかりません\r\nどこに持っていってしまったのでしょうか……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107901/4001079010380"
  },
