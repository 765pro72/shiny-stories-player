    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050220"
  },
  {
    "speaker": "プロデューサー",
