    "voice": "game_event_communications/400104305/4001043050120"
  },
  {
    "id": 4001043050130,
    "speaker": "結華",
    "text": "──……とはいえ一度も\r\n撮ってなかったなぁと思って",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050130"
  },
  {
    "id": 4001043050140,
    "speaker": "結華",
    "text": "事務所に入った記念の写真",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお……！\r\nそうか、なるほど",
