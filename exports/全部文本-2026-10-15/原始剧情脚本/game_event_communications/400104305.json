    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050340"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、俺は今の言葉で十分だよ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
