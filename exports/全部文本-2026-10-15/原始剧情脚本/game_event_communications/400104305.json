    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050320"
  },
  {
    "id": 4001043050330,
    "speaker": "結華",
    "text": "（事務所に入った記念だけど、\r\n今撮ろうとした記念でもあるんだし）",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050330"
  },
  {
    "id": 4001043050340,
    "speaker": "結華",
    "text": "まー、真剣にやろうとしてくれてるＰたんには\r\n申し訳ないなと思うけど？",
    "charAnim1": "shy1",
    "charAnim2": "face_bad",
