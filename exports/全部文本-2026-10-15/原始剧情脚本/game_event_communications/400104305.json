    "waitType": "time",
    "waitTime": 1600
  },
  {
    "speaker": "プロデューサー",
    "text": "……──でも、記念の写真って言われると\r\nちょっと緊張してくるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001043050160,
    "speaker": "結華",
    "text": "えー？　なんでよ",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
