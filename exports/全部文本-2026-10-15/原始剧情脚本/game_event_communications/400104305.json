      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400104305/4001043050160"
  },
  {
    "id": 4001043050170,
    "speaker": "結華",
    "text": "撮りたいって言い出したのは\r\nＰたんじゃん",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050170"
  },
  {
    "speaker": "プロデューサー",
    "text": "や、それはそうなんだけど！\r\nもっと気軽な感じだったというか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001043050180,
    "speaker": "結華",
    "text": "アイドルのポートレート撮るのに～？",
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104305/4001043050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\nいやっ、それもそうなんだけど！　そうじゃなくて……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一段、かしこまるだろ\r\n結華が２８３に来てくれた記念の一枚ってことなら",
