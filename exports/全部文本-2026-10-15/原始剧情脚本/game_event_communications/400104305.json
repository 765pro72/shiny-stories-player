  },
  {
    "speaker": "プロデューサー",
    "text": "え！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001043050210,
    "speaker": "結華",
    "text": "撮りたいな～って思ってたけど、\r\n機会がなくてずっとなぁなぁで来ちゃってたやつ",
