    "waitTime": 1500
  },
  {
    "speaker": "萌夢",
    "text": "まあ……………………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "……もしかして\r\n声かけちゃいけなかったやつですか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "も、もちろん\r\nそんなことないのよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "でも……こんなの……\r\n先生らしくないでしょ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
