  {
    "speaker": "彼方",
    "text": "私、今日、リップを塗ってみたんです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "あと、肌と、眉と、目と、チークも",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "今日は私も、私らしくないから、だから────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "──そう、そうなの！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "speaker": "萌夢",
    "text": "だから先生、声をかけてもらうまで気付かなかったの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "萌夢",
    "text": "今日の甲田さんは、\r\n学校で見る姿と全然違ってて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "別の人みたいに……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "萌夢",
    "text": "めっちゃ……\r\nめっちゃ、きらきらしてて……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "やっぱり、楽しんでる時の顔って、\r\nめ～っちゃかわいーねぇ……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
