  {
    "speaker": "ラジオディレクター",
    "text": "見てよ、これ\r\nこの量！！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0806",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "ラジオディレクター",
    "text": "全部、リスナーさんからのお便り！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nすごいですね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "いやいやいや…………\r\nやばいでしょ……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "メールで届いた分も合わせたら、\r\nこの３倍はあるんだけど……！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "捌ききれないよー\r\nまったく……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "すみません……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだか、ご迷惑をおかけして……？\r\n……本当に……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "ラジオディレクター",
    "text": "……ふふっ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "ん、わかってると思うけど\r\n冗談ね、冗談",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "ああやって呼びかけたいって相談されて、\r\n間髪入れずに『かませー！』って答えたの、僕だしね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "実際、こんなに反応してもらえて……\r\n嬉しい悲鳴、ってやつよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ええ、同じくです",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0806",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "ラジオディレクター",
    "text": "でも困ったよねぇ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "もともと『グッド・ネムレナイト』は\r\n３か月限定の放送だったでしょ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "その後も単発では復活させてるけど\r\n次の放送予定はないし……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "本当に困ったよねぇ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "大崎……甜花は『グッド・ネムレナイト』の収録を\r\nいつも楽しみにしていました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "……ふーん？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ゴージャス版の後には、\r\nレギュラー放送にならないかなあとも言ってましたね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "ちょっとぉ……！\r\nその攻め方はずるくなーい……！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……！\r\nすみません",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ラジオディレクター",
    "text": "ふふ……──っとにもう、\r\nさっきから全然謝ってないんだけど……！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
