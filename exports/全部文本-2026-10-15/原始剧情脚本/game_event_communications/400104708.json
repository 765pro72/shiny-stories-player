  },
  {
    "speaker": "萌夢",
    "text": "ひっ……！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "先生……？\r\n鈴藤先生ですよね……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "ひゃ、ひゃい\r\nこんにちは………………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "ぐ、偶然ね……！\r\n甲田さんもライブとか好きなんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "ああ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "えーまあ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "目当てはどのアーティスト……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "彼方",
    "text": "先生はアルストロメリアが目当てなんですね……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "萌夢",
    "text": "ひゃっ？",
