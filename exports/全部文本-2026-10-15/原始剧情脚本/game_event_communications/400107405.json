  },
  {
    "id": 4001074050100,
    "speaker": "はるき",
    "text": "『あっ……！　プロデューサーさん、急にすみません……！\r\n今、お時間大丈夫でしょうか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、大丈夫だよ\r\n何かあったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001074050110,
    "speaker": "はるき",
    "text": "『いえ、何かというより──\r\n……ルカちゃんのことで』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0000",
    "voice": "game_event_communications/400107405/4001074050110"
  },
  {
    "textFrame": "off",
    "bgm": "070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "textFrame": "off",
    "bg": "00413",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001074050120,
    "speaker": "はるき",
    "text": "『……わたし、昨日からずっと\r\n何かできることはないか、考えてたんです』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050120"
  },
  {
    "id": 4001074050130,
    "speaker": "はるき",
    "text": "『ルカちゃんに……\r\nでも、思いつかなくって──』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4001074050140,
    "speaker": "はるき",
    "text": "『どうしたらいいのかな……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 800
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001074050150,
    "speaker": "はるき",
    "text": "『──すみません、こんなこと……\r\nプロデューサーさんも困りますよね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050150"
  },
  {
    "id": 4001074050160,
    "speaker": "はるき",
    "text": "『でも、プロデューサーさんの\r\nお話を聞きたくって』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ううん\r\nありがとう、たくさん考えてくれて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、電話をするのにも\r\n勇気が必要だったよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001074050170,
    "speaker": "はるき",
    "text": "『い、いえ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107405/4001074050170"
  },
