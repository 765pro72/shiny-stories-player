  {
    "id": 4001021030040,
    "speaker": "樹里",
    "text": "──もしもし、プロデューサー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里、今大丈夫か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030050,
    "speaker": "樹里",
    "text": "ああ……\r\n大丈夫、どうした？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "この間、ポスター配りしたいって言ってただろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030060,
    "speaker": "樹里",
    "text": "うん、おっちゃ……\r\n会長さんに聞いてくれたか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "それが、もうポスター\r\n刷り上がってきてるみたいなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030070,
    "speaker": "樹里",
    "text": "えっ、早いな……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "会長さんの店に届いてるみたいなんだけど\r\n今日、行けそうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "智代子と夏葉はこれから来るには\r\n少し時間がかかるだろうから……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もし大丈夫なら樹里と凛世と果穂に\r\nお願い出来ないかと思ったんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030080,
    "speaker": "樹里",
    "text": "アタシは大丈夫！\r\n果穂と凛世にも聞いてみるよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、頼む\r\n本当は一緒に配れたらよかったんだけど──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030090,
    "speaker": "樹里",
    "text": "プロデューサーはいいって！\r\n他にも仕事あんだろ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "悪いな……気をつけて行ってきてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "何かあったらすぐ連絡してくれよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021030100,
    "speaker": "樹里",
    "text": "大丈夫だよ、心配しすぎだっつーの！\r\n…………じゃあ、行ってくるな！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102103/4001021030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……おう",
    "textCtrl": "p",
    "textFrame": "002"
  },
