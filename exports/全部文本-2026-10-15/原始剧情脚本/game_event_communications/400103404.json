    "textFrame": "001",
    "voice": "game_event_communications/400103404/4001034040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　ならいいんだけど……\r\n何かあったら遠慮なく教えてくれよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001034040110,
