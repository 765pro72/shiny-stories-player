  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nどうした、摩美々。大丈夫か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001034040100,
    "speaker": "摩美々",
    "text": "……はぁい\r\n大丈夫ですー",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
