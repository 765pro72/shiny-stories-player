    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4001034040120,
    "speaker": "摩美々",
    "text": "…………プロデューサー",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103404/4001034040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001034040130,
    "speaker": "摩美々",
    "text": "次のロケ、コツとかあると思いますー？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103404/4001034040130"
  },
  {
    "speaker": "プロデューサー",
    "text": "次のロケ……っていうと、\r\nみんな揃うまで終わらないやつだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001034040140,
    "speaker": "摩美々",
    "text": "はいー",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103404/4001034040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだなぁ……自分だけじゃなくて、\r\nみんなの気持ちを考えながら答えを決めたりとか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001034040150,
    "speaker": "摩美々",
    "text": "……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103404/4001034040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "あとは……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "textCtrl": "cm",
