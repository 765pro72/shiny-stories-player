  {
    "id": 4001076060770,
    "speaker": "ヒマワリ",
    "text": "『……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060770"
  },
  {
    "id": 4001076060780,
    "speaker": "カメリア",
    "text": "『心配しなくてもいい、あなたは優秀よ\r\n──私が背中を任せるんだから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060780"
  },
  {
    "id": 4001076060790,
    "speaker": "ヒマワリ",
    "text": "『カメリア──！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060790"
  },
  {
    "id": 4001076060800,
    "speaker": "カメリア",
    "text": "『──ここで飛び跳ねるようなら撤回するけど\r\n私の判断が間違ってたなんてことにしないでくれるわね？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060800"
  },
  {
    "id": 4001076060810,
    "speaker": "ヒマワリ",
    "text": "『ええ──ええ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060810"
  },
  {
    "id": 4001076060820,
    "speaker": "ヒマワリ",
    "text": "『────行きましょう』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060820"
  },
  {
    "id": 4001076060830,
    "speaker": "カメリア",
    "text": "『そうね、どこまでも。──私のバディ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060830"
  },
