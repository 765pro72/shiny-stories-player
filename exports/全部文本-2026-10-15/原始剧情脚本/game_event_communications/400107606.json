  {
    "speaker": "スタッフたち",
    "text": "オイなんで足場固定されてねぇんだよ！\r\nなんでこのタイミングでセットが崩れる！？",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "2313"
  },
  {
    "speaker": "スタッフたち",
    "text": "すみません！\r\n今確認中で──",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1003"
  },
  {
    "speaker": "スタッフたち",
    "text": "園田さん、大丈夫ですか！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0454"
  },
  {
    "id": 4001076060190,
    "speaker": "智代子",
    "text": "はい、っつ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107606/4001076060190"
  },
  {
    "speaker": "スタッフたち",
    "text": "無理なさらないでください！\r\n今冷やすものを──",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1769"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "se": "1839",
    "waitType": "time",
    "waitTime": 5500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "医務担当",
    "text": "──少なくとも、自由に演技ができる状態ではないですね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00506",
    "bgEffect": "fade",
    "waitType": "time",
