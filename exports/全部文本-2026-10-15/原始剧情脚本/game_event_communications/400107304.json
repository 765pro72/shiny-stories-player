  {
    "speaker": "ライター仲間",
    "text": "『媒体で書かせてもらってるんだろ？\r\nいいじゃん、食い扶持に困ってないなら』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "……それは手段であって、目的じゃない\r\nエンタメ界隈で頑張ってる場合じゃないんだよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "日の目を浴びてる人間じゃなくて……もっとこう……\r\n誰にも見向きされないような、狭くて暗い────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ライター仲間",
    "text": "『あるだろ……他にいろいろ\r\nコンクールとか、コネとか……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "だから……仕事が忙しすぎて\r\nそのための時間が取れないって話をしてる",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1105"
  },
  {
    "textFrame": "off",
    "bg": "00824",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 500
  },
  {
    "speaker": "ライター仲間",
    "text": "『じゃあ、どうするんだ\r\n俺ら、もう若くないんだぞ』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "いやいや、全然若い方でしょ\r\nまだまだここから…………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ライター仲間",
    "text": "『はぁ……いいけどさ\r\n仕事は家庭を持ってたってできるだろ』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "昼の光に夜の闇の深さが\r\nわかってたまるか、だ",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1105"
  },
  {
    "speaker": "ルポライター",
    "text": "満たされた人間で、良い仕事をした作家が\r\nどれくらいいるんだよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ライター仲間",
    "text": "『……夢を追うのは勝手だけど\r\nもう少し現実を見て────』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "……変わったな、お前",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ライター仲間",
    "text": "『変わらない方がおかしいだろ……\r\nちゃんと見てるか、鏡』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルポライター",
    "text": "いつからそんな腑抜けたんだよ\r\nなんのためのライターだよ！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0327"
  },
  {
    "speaker": "ルポライター",
    "text": "現実？　言葉こそが現実そのものだっただろ\r\n言葉で炙り出してこそ、真の現実が────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ライター仲間",
    "text": "『現実、現実って……人の生活のことバカにするなら\r\nさっさと結果を出せよ！　その傑作とやらを』",
    "textCtrl": "p",
    "textFrame": "003"
  },
