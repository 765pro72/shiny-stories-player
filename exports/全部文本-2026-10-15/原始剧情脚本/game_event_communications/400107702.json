  },
  {
    "id": 4001077020090,
    "speaker": "千雪",
    "text": "求められるものを\r\nお尋ねしてもよろしいでしょうか",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
