  {
    "speaker": "件名",
    "text": "『芹沢あさひ様、最終オーディション結果につきまして』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
