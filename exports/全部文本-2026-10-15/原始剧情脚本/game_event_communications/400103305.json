    "waitTime": 10000
  },
  {
    "id": 4001033050600,
    "speaker": "冬優子",
    "text": "あさひが頭からジュースかぶって、\r\n今愛依が全身拭いてるの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103305/4001033050600"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……じゃあ待っているよ\r\n急がなくていいからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001033050610,
    "speaker": "冬優子",
