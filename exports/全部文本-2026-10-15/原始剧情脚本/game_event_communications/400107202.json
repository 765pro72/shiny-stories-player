    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107202/4001072020020"
  },
  {
    "id": 4001072020030,
    "speaker": "愛依",
    "text": "負けないぞって気持ち\r\n強くて、最近",
