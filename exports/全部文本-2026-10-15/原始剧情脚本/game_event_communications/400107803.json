    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107803/4001078030070"
  },
  {
    "id": 4001078030080,
    "speaker": "夏葉",
    "text": "こうやって番組づくりについて知ることができて\r\nとても嬉しいです",
