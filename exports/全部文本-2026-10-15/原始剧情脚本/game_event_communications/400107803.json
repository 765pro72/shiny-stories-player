    "waitTime": 1000
  },
  {
    "id": 4001078030040,
    "speaker": "夏葉",
    "text": "……改めて、実感しますね",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107803/4001078030040"
  },
  {
    "id": 4001078030050,
    "speaker": "夏葉",
    "text": "たくさんの人に支えられているから\r\n私たち演者は力を発揮できるんだ、って",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107803/4001078030050"
  },
  {
    "id": 4001078030060,
    "speaker": "夏葉",
    "text": "ひとつひとつのお仕事がとても大切なんだと心から思います\r\n今もそうです、地味なんてとんでもなくて──",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107803/4001078030060"
  },
  {
    "id": 4001078030070,
    "speaker": "夏葉",
    "text": "やりがいがあります",
