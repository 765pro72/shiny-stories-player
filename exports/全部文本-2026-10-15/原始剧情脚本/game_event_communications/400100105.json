    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050170"
  },
  {
    "id": 4001001050180,
    "speaker": "めぐる",
    "text": "もちろん！　今は灯織が大事だもん",
