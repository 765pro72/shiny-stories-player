    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050300"
  },
  {
    "id": 4001001050310,
    "speaker": "灯織",
    "text": "まだ、焦ってたんだね\r\n今のままじゃダメだって思って、空回りしてた……",
    "charAnim1": "surp1",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
