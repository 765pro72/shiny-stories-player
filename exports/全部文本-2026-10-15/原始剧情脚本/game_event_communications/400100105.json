    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050360"
  },
  {
    "id": 4001001050370,
    "speaker": "めぐる",
    "text": "えー？　そんなんじゃないよ\r\n本当のこと言ってるだけだもん",
