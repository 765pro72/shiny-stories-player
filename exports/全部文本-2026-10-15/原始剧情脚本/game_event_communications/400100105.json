    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050230"
  },
  {
    "id": 4001001050240,
    "speaker": "めぐる",
    "text": "もー、だから迷惑なんてかけられてないってば\r\nわたしは心配してるの！",
