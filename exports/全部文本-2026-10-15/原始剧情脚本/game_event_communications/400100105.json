    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050240"
  },
  {
    "id": 4001001050250,
    "speaker": "灯織",
    "text": "……それって、違うこと？",
