    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050330"
  },
  {
    "id": 4001001050340,
    "speaker": "めぐる",
    "text": "無理しすぎちゃうのは、直さなきゃだけどね",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050340"
  },
  {
    "id": 4001001050350,
    "speaker": "めぐる",
    "text": "……でも、そうやってアイドルに真剣な灯織が、\r\n今のままでダメなわけ、ないよ",
