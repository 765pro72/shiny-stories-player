    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050190"
  },
  {
    "id": 4001001050200,
    "speaker": "灯織",
    "text": "大事な時に、私……",
