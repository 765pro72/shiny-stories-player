    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050320"
  },
  {
    "id": 4001001050330,
    "speaker": "めぐる",
    "text": "そこまでやれちゃうのは、灯織の気持ちが強いからだって、\r\nわたしも真乃もわかってる",
