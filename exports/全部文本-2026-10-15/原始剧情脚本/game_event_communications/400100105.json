    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050260"
  },
  {
    "id": 4001001050270,
    "speaker": "めぐる",
    "text": "私のせいだーって気に病んだりとかはしちゃダメなんだから\r\n……ちゃんとわかってる？",
