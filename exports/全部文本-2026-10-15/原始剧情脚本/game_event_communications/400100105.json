    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050270"
  },
  {
    "id": 4001001050280,
    "speaker": "灯織",
    "text": "ふふ……そっか。ごめんね、ありがとう",
