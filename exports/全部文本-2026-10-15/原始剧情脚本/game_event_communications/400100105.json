    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050180"
  },
  {
    "id": 4001001050190,
    "speaker": "灯織",
    "text": "私のせいで、レッスンの予定、狂っちゃったよね……\r\nせっかく、３人の動きが揃ってきたのに……",
