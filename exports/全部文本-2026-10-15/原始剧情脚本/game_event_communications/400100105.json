    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050350"
  },
  {
    "id": 4001001050360,
    "speaker": "灯織",
    "text": "……いつも、こうやって気を遣ってもらってる気がする",
