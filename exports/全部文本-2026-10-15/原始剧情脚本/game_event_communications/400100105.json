    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4001001050210,
    "speaker": "めぐる",
    "text": "ちょっとちょっと灯織！　ダメだよっ！\r\nわたし、そんな顔してもらいたかったわけじゃないよ",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050210"
  },
  {
    "id": 4001001050220,
    "speaker": "めぐる",
    "text": "今はちゃんと休むのが灯織の仕事！\r\nね？　ほら、横になって",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100105/4001001050220"
  },
  {
    "id": 4001001050230,
    "speaker": "灯織",
    "text": "……迷惑かけて……ごめん",
