      "y": 640,
      "order": 2
    }
  },
  {
    "id": 4001021010260,
    "speaker": "夏葉",
    "text": "えぇっ、気が付かなかったわ……\r\nごめんなさい、会長さん",
    "charAnim1": "sad1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 310,
      "y": 640,
      "order": 1
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102101/4001021010260"
  },
  {
    "speaker": "商店街の会長",
    "text": "いやいや、珍しくスーツなんか着てるから\r\nわからないのも仕方ないよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001021010270,
    "speaker": "樹里",
    "text": "アタシもおっちゃんのそういう格好初めて見たな",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102101/4001021010270"
  },
  {
    "charAnim1": "wait",
    "charLabel": "juri",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "charAnim1": "wait",
    "charLabel": "natsuha",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "今日は放課後クライマックスガールズに\r\n依頼があってわざわざ来て下さったんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "説明するから、座ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001021010280,
    "speaker": "樹里",
    "text": "あ……、ごめんプロデューサー",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102101/4001021010280"
  },
  {
    "charAnim1": "wait",
    "charLabel": "juri",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "商店街の会長",
    "text": "ああ、いや\r\nそんなかしこまらなくていいんですよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "商店街の会長",
    "text": "いつも樹里ちゃんや凛世ちゃんには\r\n店に来てもらってて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "商店街の会長",
    "text": "他のみんなともお揃いのジャージを着て\r\nたまに来てくれるんです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったんですか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "商店街の会長",
    "text": "だから今度の行事……祭みたいなものですけど\r\n是非みんなに盛り上げてもらいたいと思って",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001021010290,
    "speaker": "凛世",
    "text": "……\r\n行事……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
