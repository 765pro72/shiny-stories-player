      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102101/4001021010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "今度商店街で節分の豆まき行事をやるそうだ",
    "textCtrl": "p",
    "textFrame": "002"
