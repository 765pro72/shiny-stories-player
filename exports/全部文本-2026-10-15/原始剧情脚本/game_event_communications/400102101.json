  {
    "id": 4001021010190,
    "speaker": "樹里",
    "text": "ってかおっちゃん、商店街の会長だったのか！？",
    "charAnim1": "wait5",
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "p",
