    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102101/4001021010240"
  },
  {
    "id": 4001021010250,
    "speaker": "樹里",
    "text": "あそこの店のおっちゃんだよ",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
