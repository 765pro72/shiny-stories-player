  {
    "id": 4001025020720,
    "speaker": "真乃",
    "text": "プロデューサーさんもお仕事頑張ってくださいっ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
