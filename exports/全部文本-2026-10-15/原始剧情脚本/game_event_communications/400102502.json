  },
  {
    "charAnim2": "face_wait",
    "charLabel": "meguru"
  },
  {
    "id": 4001025020730,
    "speaker": "灯織",
    "text": "昼食と休憩も忘れないようにしてくださいね\r\n身体が資本なんですから",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
