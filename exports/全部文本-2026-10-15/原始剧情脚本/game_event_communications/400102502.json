  },
  {
    "charAnim2": "face_wait",
    "charLabel": "mano"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……ありがとう\r\nいってらっしゃい！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
