  {
    "id": 4001082060100,
    "speaker": "冬優子",
    "text": "『……わたしたちは誰にも負けない\r\nストレイライトは絶対にトップを獲る』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108206/4001082060100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001082060110,
    "speaker": "冬優子",
    "text": "……この言葉\r\nあんたは疑ったことある？",
    "textCtrl": "p",
    "textFrame": "001",
