    "charLipAnim": "lip_jito",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108206/4001082060030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、冬優子も心配してくれるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001082060040,
    "speaker": "冬優子",
    "text": "……",
