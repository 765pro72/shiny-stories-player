    "voice": "game_event_communications/400101408/4001014080110"
  },
  {
    "id": 4001014080120,
    "speaker": "あさひ",
    "text": "……冬優子ちゃんの言う通りだったっす",
    "textCtrl": "p",
    "textFrame": "0015",
    "voice": "game_event_communications/400101408/4001014080120"
  },
  {
    "id": 4001014080130,
