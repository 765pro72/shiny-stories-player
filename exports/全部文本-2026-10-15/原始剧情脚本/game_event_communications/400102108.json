  },
  {
    "id": 4001021080260,
    "speaker": "樹里",
    "text": "──今日のこと、忘れないようにさ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102108/4001021080260"
  },
  {
    "speaker": "商店街の会長",
    "text": "ああ、スマホの写真なら\r\nおじさんもやり方わかるぞ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001021080270,
    "speaker": "樹里",
    "text": "ちっげーよ、おっちゃんも一緒に写んの！",
