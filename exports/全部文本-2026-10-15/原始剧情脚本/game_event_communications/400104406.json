  {
    "id": 4001044060660,
    "speaker": "ツイスタの投稿",
    "text": "『アルストロメリアの桑山千雪です\r\nリレー投稿、よろしくお願いしますね』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060660"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060670,
    "speaker": "ツイスタの投稿",
    "text": "『この企画が決まってから、\r\n何を書くかすごく考えてしまいました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060670"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060680,
    "speaker": "ツイスタの投稿",
    "text": "『話したいな、伝えたいなって\r\nそう思えることが、毎日起こるから』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060680"
  },
  {
    "id": 4001044060690,
    "speaker": "ツイスタの投稿",
    "text": "『なんて、ちょっと自慢です♪』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060690"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060700,
    "speaker": "ツイスタの投稿",
    "text": "『これ、私の部屋の隅で見つけたひび』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060700"
  },
  {
    "id": 4001044060710,
    "speaker": "ツイスタの投稿",
    "text": "『初めてこのお部屋に来た頃は、\r\nどうにかしてふさげないかなって思ったんですが』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060710"
  },
  {
    "id": 4001044060720,
    "speaker": "ツイスタの投稿",
    "text": "『すぐに忙しくなっちゃって、\r\nいつの間にかそのままになって』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060720"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060730,
    "speaker": "ツイスタの投稿",
    "text": "『……もし、このひびを向こう側から覗いたら、\r\nあの頃の私が、あの頃の日々が見えるかもしれません』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060730"
  },
  {
    "id": 4001044060740,
    "speaker": "ツイスタの投稿",
    "text": "『教えてあげたいな』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060740"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060750,
    "speaker": "ツイスタの投稿",
    "text": "『どんな顔をしているかわからないけど、\r\nこっち側にいる未来の私は、とっても幸せだぞって』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060750"
  },
  {
    "id": 4001044060760,
    "speaker": "ツイスタの投稿",
    "text": "『２８３プロではこの冬休みの間\r\n#２８３をひろげよう　と題して』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060760"
  },
  {
    "id": 4001044060770,
    "speaker": "ツイスタの投稿",
    "text": "『公式チャンネルへの動画投稿や\r\nツイスタの更新を行っています』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060770"
  },
  {
    "id": 4001044060780,
    "speaker": "ツイスタの投稿",
    "text": "『ぜひURLをチェックしてくださいね』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060780"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044060790,
    "speaker": "ツイスタの投稿",
    "text": "『明日の担当はノクチル\r\n雛菜ちゃんです♪』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104406/4001044060790"
  },
  {
    "id": 4001044060800,
    "speaker": "ツイスタの投稿",
    "text": "『通知、つけておいてくださいね？』",
