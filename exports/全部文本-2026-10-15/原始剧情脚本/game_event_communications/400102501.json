  {
    "id": 4001025010100,
    "speaker": "めぐる",
    "text": "灯織ー！　灯織、いるー！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、めぐるも一緒だったのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001025010110,
    "speaker": "灯織",
    "text": "いえ、櫻木さんと先に帰ったはずなんですが……\r\nすみません、ちょっと失礼します",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
