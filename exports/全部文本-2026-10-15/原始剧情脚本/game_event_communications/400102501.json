  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、タオルだな！\r\nそこの引き出しに洗濯したやつがあるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
