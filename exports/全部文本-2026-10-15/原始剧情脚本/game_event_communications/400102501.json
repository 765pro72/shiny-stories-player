  {
    "id": 4001025010240,
    "speaker": "灯織",
    "text": "櫻木さんと八宮さんが雨で濡れて、\r\n何かお借りできる……",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
