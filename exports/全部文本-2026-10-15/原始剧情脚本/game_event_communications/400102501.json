  {
    "id": 4001025010120,
    "speaker": "めぐる",
    "text": "灯織！　たい焼きパフェ、一緒に食べようー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010120"
  },
  {
    "id": 4001025010130,
    "speaker": "灯織",
    "text": "え……ふたりともどうしたの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010130"
  },
  {
    "id": 4001025010140,
    "speaker": "真乃",
    "text": "……あのね、駅前に新しいお店があったの\r\n灯織ちゃんと一緒に食べたいねって話して、それで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010140"
  },
  {
    "id": 4001025010150,
    "speaker": "灯織",
    "text": "違う、そうじゃなくてふたりともすごく濡れてる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010150"
  },
  {
    "id": 4001025010160,
    "speaker": "めぐる",
    "text": "大丈夫だよ、スポーツタオルを傘の代わりにしたから！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010160"
  },
  {
    "id": 4001025010170,
    "speaker": "灯織",
    "text": "それも傘の役目を果たさないくらい濡れてるでしょ\r\n……新しいものを借りてくるから待ってて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010170"
  },
  {
    "id": 4001025010180,
    "speaker": "灯織",
    "text": "だから雨が強くなる前に\r\n駅に行った方がいいって言ったのに",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010180"
  },
  {
    "id": 4001025010190,
    "speaker": "めぐる",
    "text": "駅には行ったんだけどねー！\r\nそこで見つけちゃって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010190"
  },
  {
    "id": 4001025010200,
    "speaker": "灯織",
    "text": "めぐる、話は後で聞くから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……ん？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001025010210,
    "speaker": "真乃",
    "text": "あの……\r\n灯織ちゃんもたい焼きが嫌いじゃなかったら……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010210"
  },
  {
    "id": 4001025010220,
    "speaker": "灯織",
    "text": "わかったから待って\r\n真乃も、今は大丈夫でも服に染みて寒くなるよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102501/4001025010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "（…………）",
    "textCtrl": "p",
    "textFrame": "002"
  },
