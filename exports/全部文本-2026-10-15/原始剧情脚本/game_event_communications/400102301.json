  },
  {
    "id": 4001023010240,
    "speaker": "あさひ",
    "text": "どうしたんすか？　プロデューサーさん",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
