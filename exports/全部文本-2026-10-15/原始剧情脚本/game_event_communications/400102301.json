      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102301/4001023010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "イベントが終わったばっかりで悪いな\r\n新しい仕事のオファーが来てて、話をしたかったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "asahi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mei",
    "charPosition": {
      "x": 796,
      "y": 640,
      "order": 2
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 4001023010250,
    "speaker": "冬優子",
    "text": "そんな急ぎなの？\r\nそれとも、早く知らせたい大きな仕事とか？",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 310,
      "y": 640,
      "order": 1
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102301/4001023010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "どっちも、かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001023010260,
    "speaker": "愛依",
    "text": "お、何なに～？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102301/4001023010260"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mei",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "charAnim1": "wait",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "『ゴールデンアイドルフェス』\r\n……大手のスポンサーが付いた、新規のアイドルフェスだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "会場も大きいし、テレビ中継もされるらしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あと……かなりバラエティに寄せているみたいでな\r\n普通のステージ以外にも、色々な企画が予定されてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001023010270,
    "speaker": "あさひ",
    "text": "企画、っすか……？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102301/4001023010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、アイドルとコラボしたフードの販売や、\r\nゲームコーナー、アイドルと接触できるコーナー……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "その中でも一番の目玉は……\r\n事前に行われる、全ユニット参加の人気投票だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "asahi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 4001023010280,
    "speaker": "愛依",
    "text": "人気投票…………",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102301/4001023010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "投票は個人単位で行われるが、\r\n集計はユニット平均だからユニット人数で有利不利はない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そして、上位になったユニットは\r\nフェスで多くの曲を披露できる、ってシステムだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mei",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 4001023010290,
    "speaker": "冬優子",
    "text": "なるほどね、競争させることでファン同士も争わせて、\r\n注目度を高めるってわけ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
