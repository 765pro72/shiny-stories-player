    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400102301/4001023010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことだ\r\nもちろん、みんなSNSとかを使って好きに宣伝していい",
    "textCtrl": "p",
    "textFrame": "002"
  },
