  {
    "id": 4001060020060,
    "speaker": "真乃",
    "text": "本日はありがとうございました……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106002/4001060020060"
  },
  {
    "id": 4001060020070,
    "speaker": "灯織",
    "text": "私たちのステージを、\r\n少しでも楽しんでもらえたならとても嬉しく思います",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106002/4001060020070"
  },
  {
    "id": 4001060020080,
    "speaker": "めぐる",
    "text": "みんなと一緒の時間を過ごせて\r\nすっごく楽しかったよー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106002/4001060020080"
  },
  {
    "id": 4001060020090,
    "speaker": "めぐる",
    "text": "後ろのほうまでみーんな見えてるからねー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106002/4001060020090"
