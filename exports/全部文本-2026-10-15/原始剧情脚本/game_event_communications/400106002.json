  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、炭酸を選ぶかなと思ったんだけど\r\nはは、外したなあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001060020020,
    "speaker": "灯織",
    "text": "あっ……\r\nお茶のほうがよければ、どうぞ……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
