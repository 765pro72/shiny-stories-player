    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010020"
  },
  {
    "id": 4001029010030,
    "speaker": "雛菜",
    "text": "ん～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010030"
  },
  {
    "id": 4001029010040,
    "speaker": "小糸",
    "text": "ハロウィンの日にあっちの世界に行くと\r\n美味しい物がたくさんもらえるんだって……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010040"
  },
  {
    "id": 4001029010050,
    "speaker": "雛菜",
    "text": "へ～～～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010050"
  },
  {
    "id": 4001029010060,
    "speaker": "透",
    "text": "すごいね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010060"
  },
  {
    "id": 4001029010070,
    "speaker": "雛菜",
    "text": "いいな～\r\n歓迎されてる～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010070"
  },
  {
    "id": 4001029010080,
    "speaker": "円香",
    "text": "それ、あくまで噂でしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010080"
  },
  {
    "id": 4001029010090,
    "speaker": "円香",
    "text": "実際に行ったら全然違うかもよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010090"
  },
  {
