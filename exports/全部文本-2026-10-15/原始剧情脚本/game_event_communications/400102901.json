    "id": 4001029010140,
    "speaker": "あさひ",
    "text": "──あれ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010140"
  },
  {
    "id": 4001029010150,
    "speaker": "愛依",
    "text": "ん？\r\nどしたん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010150"
  },
  {
    "id": 4001029010160,
    "speaker": "あさひ",
    "text": "そこのガラスケースの本って……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010160"
  },
  {
    "id": 4001029010170,
    "speaker": "愛依",
    "text": "あ、閲覧禁止の本？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010170"
  },
  {
    "id": 4001029010180,
    "speaker": "愛依",
    "text": "今年はなんか噂が出回ったから～……\r\nって話だったじゃん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010180"
  },
  {
    "id": 4001029010190,
    "speaker": "冬優子",
    "text": "そう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010190"
  },
  {
    "id": 4001029010200,
    "speaker": "冬優子",
    "text": "面倒事はごめんだもの\r\n持ち出しはもちろん、閲覧も禁止！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010200"
  },
  {
    "id": 4001029010210,
    "speaker": "冬優子",
    "text": "ハロウィンが過ぎるまでは\r\nあんたたちも触るんじゃないわよ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010210"
  },
  {
    "id": 4001029010220,
    "speaker": "あさひ",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010220"
  },
  {
    "id": 4001029010230,
    "speaker": "冬優子",
    "text": "ま、そもそもそんな簡単に\r\n出せるような作りじゃないけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010230"
  },
  {
    "id": 4001029010240,
    "speaker": "愛依",
    "text": "アハハ～\r\nなんかすごそ～……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010240"
  },
  {
    "id": 4001029010250,
    "speaker": "あさひ",
    "text": "でも…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010250"
  },
  {
    "id": 4001029010260,
    "speaker": "あさひ",
    "text": "もう無くなってるっすよ？\r\nそこにあった本",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102901/4001029010260"
  },
