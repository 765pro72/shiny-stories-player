    "textFrame": "001",
    "voice": "game_event_communications/400108208/4001082080590"
  },
  {
    "id": 4001082080600,
    "speaker": "冬優子",
    "text": "『うちら３人が最強だって\r\n世界に認めてもらいたい』って",
