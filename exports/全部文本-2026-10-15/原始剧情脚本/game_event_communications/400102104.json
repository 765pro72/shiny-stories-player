    "textFrame": "001",
    "voice": "game_event_communications/400102104/4001021040140"
  },
  {
    "speaker": "商店街の会長",
    "text": "うん、そりゃね\r\nもうずいぶんここで店やってるもんだから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "商店街の会長",
    "text": "この街のことは大体知ってるさ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001021040150,
    "speaker": "樹里",
    "text": "……へぇ……",
