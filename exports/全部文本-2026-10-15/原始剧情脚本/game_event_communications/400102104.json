    "textFrame": "001",
    "voice": "game_event_communications/400102104/4001021040170"
  },
  {
    "speaker": "商店街の会長",
    "text": "じゃああれか、芸能人の卵ってやつ？",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "商店街の会長",
    "text": "これからいっぱいテレビに出られるように\r\n頑張らなきゃだなぁ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001021040180,
