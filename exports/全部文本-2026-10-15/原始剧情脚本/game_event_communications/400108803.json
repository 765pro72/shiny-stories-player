    "fgEffectTime": 500
  },
  {
    "speaker": "ルクア",
    "text": "『戻って来るつもりとはいえしばらく先になるから\r\nその前にふたりと話せてよかった』",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "0052"
  },
  {
    "speaker": "ルクア",
    "text": "『私が戻らん間にふたりがやるゲームも\r\n変わってるかもしれんし』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルクア",
    "text": "『このサーバーも急に終わることだってあるやろ\r\n……ほんとに、私といっぱい遊んでくれてありがとう』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "パインくんれんせい",
    "text": "『そっか……ありがとう\r\n残念だけど、伝えてくれて嬉しいよ』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルクア",
    "text": "『てか……実は今もインターンの準備終わらんくて\r\nちょっと息抜きの誘惑に負けとったんよね』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001088030780,
    "speaker": "甜花",
    "text": "それ……わかる……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108803/4001088030780"
  },
  {
    "textFrame": "off",
    "bg": "00575",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "ルクア",
    "text": "『ふたりに話せてすっきりしたし\r\nやっぱ準備に戻る……ごめん』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001088030790,
    "speaker": "甜花",
    "text": "ううん……\r\n準備、頑張れ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108803/4001088030790"
  },
  {
    "speaker": "ルクア",
    "text": "『ありがとう\r\nじゃあ、また……！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "パインくんれんせい",
    "text": "『健闘を祈る』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "2771",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "id": 4001088030800,
    "speaker": "甜花",
    "text": "えと……\r\nふたりだから……どうしよ……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108803/4001088030800"
  },
  {
    "speaker": "パインくんれんせい",
    "text": "『じゃあ\r\nこっちはイベントの準備でも進めるか』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001088030810,
    "speaker": "甜花",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108803/4001088030810"
  },
  {
