    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080360"
  },
  {
    "id": 4001046080370,
    "speaker": "智代子",
    "text": "──あっ！\r\nもちろん、ライブのことはバレないようにしてますよ！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
