  {
    "id": 4001046080230,
    "speaker": "樹里",
    "text": "あ、プロデューサー",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
