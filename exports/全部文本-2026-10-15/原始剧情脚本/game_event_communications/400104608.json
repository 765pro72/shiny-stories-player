      "time": 100
    },
    "voice": "game_event_communications/400104608/4001046080230"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、樹里\r\nどうした？　撮影はいいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001046080240,
    "speaker": "樹里",
    "text": "ああ、今チョコと夏葉のシーン撮ってるんだよ\r\nだから飾り作る方手伝ってて──",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080240"
  },
  {
    "id": 4001046080250,
    "speaker": "樹里",
    "text": "材料切れたのがあるから、買い出しに行くとこ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080250"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ああ、だからさっきのやりとり──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……優しいな、樹里は",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001046080260,
    "speaker": "樹里",
    "text": "ばっ……アンタまでそういうのやめろってば！\r\n普通のことだろ、普通のこと！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080260"
  },
  {
    "id": 4001046080270,
    "speaker": "樹里",
    "text": "こういうのは手が空いてるやつがやるんだよ\r\nたまたまアタシだっただけだ",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080270"
  },
  {
    "id": 4001046080280,
    "speaker": "樹里",
    "text": "じゃーな、行ってくる",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080280"
  },
