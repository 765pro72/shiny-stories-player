    "voice": "game_event_communications/400104608/4001046080350"
  },
  {
    "id": 4001046080360,
    "speaker": "智代子",
    "text": "どうせなら２組のみんなが好きな曲をやりたいよね\r\nってなって、みんなに聞いて回りました！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
