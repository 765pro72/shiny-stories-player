  {
    "id": 4001046080210,
    "speaker": "樹里",
    "text": "セロハンテープとホチキスの芯な、了解！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080210"
  },
  {
    "id": 4001046080220,
    "speaker": "樹里",
    "text": "いいって！　今一番アタシが暇だろ？\r\nほら、行ってくるから！",
    "textCtrl": "p",
    "textFrame": "001",
