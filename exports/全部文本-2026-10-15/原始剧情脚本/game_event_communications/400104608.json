    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104608/4001046080290"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も手が空いてるから、車出すよ",
