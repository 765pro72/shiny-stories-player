  },
  {
    "speaker": "ソラファド",
    "text": "お水、飲みます？",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0828"
  },
  {
    "speaker": "少女",
    "text": "えっ……あ、ありがとうございます！\r\n────おいくらですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ソラファド",
    "text": "いえ……大丈夫です\r\n助けてくれたお礼なんで",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "少女",
    "text": "……あ、はい\r\nいただきます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0799",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "少女",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ソラファド",
    "text": "……………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
