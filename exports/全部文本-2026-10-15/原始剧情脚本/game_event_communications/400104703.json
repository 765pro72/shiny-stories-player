  {
    "id": 4001047030310,
    "speaker": "ラジオの音声",
    "text": "『────次のお手紙は……えっと……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030310"
  },
  {
    "id": 4001047030320,
    "speaker": "ラジオの音声",
    "text": "『ラジオネーム……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030320"
  },
  {
    "id": 4001047030330,
    "speaker": "ラジオの音声",
    "text": "『教師は辛いよ、さんから……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030330"
  },
  {
    "speaker": "高校教師",
    "text": "！？！？！？\r\nきゃーーーー！？！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047030340,
    "speaker": "ラジオの音声",
    "text": "『甜花ちゃん、いつもラジオ聞いてます』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030340"
  },
  {
    "id": 4001047030350,
    "speaker": "ラジオの音声",
    "text": "『にへへ……ありがと……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030350"
  },
  {
    "speaker": "高校教師",
    "text": "うう……\r\nこちらこそありがとぉ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047030360,
    "speaker": "ラジオの音声",
    "text": "『私は教師なのですがいつも失敗ばかりです』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030360"
  },
  {
    "id": 4001047030370,
    "speaker": "ラジオの音声",
    "text": "『この間も保護者の人に先生らしくないと怒られました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030370"
  },
  {
    "id": 4001047030380,
    "speaker": "ラジオの音声",
    "text": "『甜花ちゃんはどんな先生が好きですか？\r\n教えてください！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030380"
  },
  {
    "id": 4001047030390,
    "speaker": "ラジオの音声",
    "text": "『わ……先生……！　すごい……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030390"
  },
  {
    "id": 4001047030400,
    "speaker": "ラジオの音声",
    "text": "『あ……でも……\r\nもし……甜花の先生だったら、どうしよ……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030400"
  },
  {
    "speaker": "高校教師",
    "text": "違うよぉ……\r\nでも私は甜花ちゃんの先生になりたかったよぉ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047030410,
    "speaker": "ラジオの音声",
    "text": "『……えと……甜花……\r\n先生に叱られること、結構、あって……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030410"
  },
  {
    "id": 4001047030420,
    "speaker": "ラジオの音声",
    "text": "『て、甜花が、悪いんだけど……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030420"
  },
  {
    "id": 4001047030430,
    "speaker": "ラジオの音声",
    "text": "『だから…………\r\nうーん……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030430"
  },
  {
    "textFrame": "off",
    "bg": "00093",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1300,
    "bgEffectTime": 1300
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001047030440,
    "speaker": "ラジオの音声",
    "text": "『甜花は……先生らしくない先生が……\r\n好き……かも……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030440"
  },
  {
    "speaker": "高校教師",
    "text": "わ、わあぁ…………！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "高校教師",
    "text": "ありがと、ありがとぉ、甜花ちゃーん……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "高校教師",
    "text": "これで月曜からも生きられるよぉお……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047030450,
    "speaker": "ラジオの音声",
    "text": "『にへへ……頑張ってね……\r\n教師は辛いよ……さん……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104703/4001047030450"
  },
  {
    "speaker": "高校教師",
    "text": "でも、『教師はつらいよ』って読むんだよぉ～～～……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "高校教師",
    "text": "ひらがなで書かなくてごめんねぇ～～～……",
    "textCtrl": "p",
    "textFrame": "003"
  },
