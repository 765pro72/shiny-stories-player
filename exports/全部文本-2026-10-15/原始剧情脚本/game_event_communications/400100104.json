  },
  {
    "id": 4001001040150,
    "speaker": "灯織",
    "text": "えっと……櫻木さん、大丈夫？",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
