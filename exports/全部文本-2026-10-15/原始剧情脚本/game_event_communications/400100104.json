    "voice": "game_event_communications/400100104/4001001040050"
  },
  {
    "id": 4001001040060,
    "speaker": "めぐる",
    "text": "よーし、じゃあ今日はもうちょっと頑張っちゃおうか！\r\n……でもその前に、一旦休憩にしよう！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
