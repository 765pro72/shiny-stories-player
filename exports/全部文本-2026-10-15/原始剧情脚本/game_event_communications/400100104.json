  },
  {
    "id": 4001001040200,
    "speaker": "真乃",
    "text": "私、できないことが多いから……\r\nたくさん練習しなきゃって思って",
    "charAnim1": "sad2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040200"
  },
  {
    "id": 4001001040210,
    "speaker": "灯織",
    "text": "そう……なんだ",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040210"
  },
  {
    "id": 4001001040220,
    "speaker": "真乃",
    "text": "さっき、やっと上手くできたんだよっ\r\nめぐるちゃんも、褒めてくれたんだ",
    "charAnim1": "sad1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040220"
  },
  {
    "id": 4001001040230,
    "speaker": "真乃",
    "text": "早く、ふたりと同じ場所に立ちたいって思ってたから……\r\nちょっとだけ近づけた気がして、すごく嬉しいの",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040230",
    "charAnim3Loop": false
  },
  {
    "id": 4001001040240,
    "speaker": "真乃",
    "text": "ふたりに並べるように……いつか、ふたりと一緒に\r\n歩けるように、私、これからも頑張るねっ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040240"
  },
  {
    "id": 4001001040250,
    "speaker": "灯織",
    "text": "待って！",
    "charAnim1": "wait3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040250"
  },
  {
    "id": 4001001040260,
    "speaker": "真乃",
    "text": "え……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040260"
  },
  {
    "id": 4001001040270,
    "speaker": "灯織",
    "text": "……櫻木さんが、並べてないなんてこと、ない\r\n私たちは、ちゃんと同じ場所に立ってるよ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040270",
    "charAnim3Loop": false
  },
  {
    "id": 4001001040280,
    "speaker": "灯織",
    "text": "櫻木さんだけ追いついてないみたいに……言わないで",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040280"
  },
  {
    "id": 4001001040290,
    "speaker": "真乃",
    "text": "で、でも……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040290"
  },
  {
    "id": 4001001040300,
    "speaker": "灯織",
    "text": "櫻木さん……本当に、ごめんなさい",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040300"
  },
  {
    "id": 4001001040310,
    "speaker": "真乃",
    "text": "え。えっ？",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040310"
  },
  {
    "id": 4001001040320,
    "speaker": "灯織",
    "text": "謝らなくちゃいけないことがたくさんある\r\n……レッスンの時のこと",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040320"
  },
  {
    "id": 4001001040330,
    "speaker": "灯織",
    "text": "私、いつもきつく言っちゃって……",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040330"
  },
  {
    "id": 4001001040340,
    "speaker": "真乃",
    "text": "そ、そんなっ、灯織ちゃんはアドバイスしてくれただけで、\r\n謝ることじゃないよっ",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charAnim3": "no",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040340",
    "charAnim3Loop": false
  },
  {
    "id": 4001001040350,
    "speaker": "灯織",
    "text": "ううん。私、全然言い方を考えられてなかった",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040350",
    "charAnim3Loop": false
  },
  {
    "id": 4001001040360,
    "speaker": "灯織",
    "text": "……それに、櫻木さんのことも誤解してた\r\n八宮さんのことも",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040360"
  },
  {
    "id": 4001001040370,
    "speaker": "灯織",
    "text": "……あんなふうにきつく言ってばかりだったから、\r\n私と練習するの、嫌になっちゃうんじゃないかって",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040370"
  },
  {
    "charAnim1": "wait3",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano"
  },
  {
    "id": 4001001040380,
    "speaker": "灯織",
    "text": "……ふたりのこと、全然わかってなかった\r\nもしかしたら諦めちゃうかもって、勝手に心配して……",
    "charAnim1": "wait3",
    "charAnim3": "no",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040380",
    "charAnim3Loop": false
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_sad",
    "charLabel": "mano"
  },
  {
    "id": 4001001040390,
    "speaker": "灯織",
    "text": "ふたりの、アイドルになりたいっていう気持ち、\r\n信じられてなかった",
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040390"
  },
  {
    "id": 4001001040400,
    "speaker": "灯織",
    "text": "……本当に、ごめんなさい",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040400"
  },
  {
    "id": 4001001040410,
    "speaker": "真乃",
    "text": "そ、そんなこと！　そんなこと全然気にしてないよっ\r\n灯織ちゃんの気持ちに追いつけてなかったのは本当だし……",
    "charAnim1": "sad1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040410"
  },
  {
    "id": 4001001040420,
    "speaker": "真乃",
    "text": "私、落ち込んじゃうばっかりで、\r\n灯織ちゃんと全然お話できてなかった",
    "charAnim1": "sad2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040420"
  },
  {
    "id": 4001001040430,
    "speaker": "真乃",
    "text": "こういうことっ、ほんとは話しておかなきゃなのに、\r\n上手くできなくて……！",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040430"
  },
  {
    "id": 4001001040440,
    "speaker": "真乃",
    "text": "あの、えっと、とにかく、\r\n私、灯織ちゃんと練習するの、嫌なんかじゃないよっ",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040440"
  },
  {
    "id": 4001001040450,
    "speaker": "灯織",
    "text": "…………ありがとう、櫻木さん",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040450"
  },
  {
    "id": 4001001040460,
    "speaker": "真乃",
    "text": "……うんっ。ごめんね、灯織ちゃん\r\nありがとう",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040460"
  },
  {
    "id": 4001001040470,
    "speaker": "灯織",
    "text": "私、これからもっと……もっと頑張る\r\nふたりに、恥ずかしくないように",
    "charAnim1": "sad1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040470"
  },
  {
    "id": 4001001040480,
    "speaker": "灯織",
    "text": "……ふたりに、負けないように",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100104/4001001040480"
  },
  {
    "id": 4001001040490,
    "speaker": "真乃",
    "text": "──うんっ、私も負けないよ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
