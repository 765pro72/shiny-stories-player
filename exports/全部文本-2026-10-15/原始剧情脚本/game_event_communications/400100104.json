  {
    "id": 4001001040190,
    "speaker": "真乃",
    "text": "今日はね、プロデューサーさんにお願いして、\r\nレッスン場を使わせてもらってたんだ",
    "charAnim1": "wait4",
    "charAnim2": "blank",
