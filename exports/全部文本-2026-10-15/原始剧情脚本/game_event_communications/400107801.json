    "textFrame": "001",
    "voice": "game_event_communications/400107801/4001078010420"
  },
  {
    "speaker": "精肉店店員",
    "text": "でも大丈夫だからね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "精肉店店員",
    "text": "せっかく樹里ちゃんが一日店長してくれるんだし\r\nしっかりバッチリお店の宣伝しないとね────",
