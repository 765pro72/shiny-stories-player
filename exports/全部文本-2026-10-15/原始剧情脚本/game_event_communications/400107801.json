    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107801/4001078010390"
  },
  {
    "speaker": "特番スタッフ１",
    "text": "……精肉店の奥さんに１日の作業の流れを\r\nご指導いただきたいと思っていたんですが",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "特番スタッフ１",
    "text": "昨晩、足を挫いてしまったそうなんです",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "129"
  },
  {
    "id": 4001078010400,
    "speaker": "樹里",
    "text": "えっ……",
