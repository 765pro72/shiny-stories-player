  },
  {
    "id": 4001078010410,
    "speaker": "樹里",
    "text": "……おばちゃんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107801/4001078010410"
  },
  {
    "speaker": "精肉店店員",
    "text": "あー、樹里ちゃん！\r\nごめんなさいね……なんだか迷惑をかけてるみたいで",
    "textCtrl": "p",
    "textFrame": "003"
  },
