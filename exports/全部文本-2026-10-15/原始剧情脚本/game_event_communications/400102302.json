    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102302/4001023020240"
  },
  {
    "id": 4001023020250,
    "speaker": "愛依",
    "text": "どんなトークすればいいとか、\r\nどんなカンジの写真がウケる、とかさ！",
