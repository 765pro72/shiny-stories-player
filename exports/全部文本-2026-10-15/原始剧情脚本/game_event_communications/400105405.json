    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──そうだ\r\n移動手段に困ったら言ってくれよ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "オフだし、車出せるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054050280,
    "speaker": "夏葉",
    "text": "ええ……？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
