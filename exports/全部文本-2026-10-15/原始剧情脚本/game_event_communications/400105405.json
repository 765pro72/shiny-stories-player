    "textFrame": "001",
    "voice": "game_event_communications/400105405/4001054050270"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なるほど\r\nまぁでも『わーい！』ならよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
