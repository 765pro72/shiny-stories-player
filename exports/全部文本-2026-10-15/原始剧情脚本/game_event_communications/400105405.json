  {
    "speaker": "プロデューサー",
    "text": "『もしもし、樹里か？　今、電話大丈夫かな』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054050200,
    "speaker": "樹里",
    "text": "ああ、大丈夫\r\nこの間、プロデューサーにもらった録画、見てたとこ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105405/4001054050200"
  },
  {
    "speaker": "プロデューサー",
    "text": "『はは、そうか\r\nじゃあ邪魔しないように手短に……』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『スケジュールの連絡だ\r\nいまカレンダーあるか？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054050210,
    "speaker": "樹里",
    "text": "ああ、うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105405/4001054050210"
  },
  {
    "textFrame": "off",
    "se": "0242",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "『────って感じで仕事が入るけど、\r\nその次の日曜がオフになるから』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054050220,
    "speaker": "樹里",
    "text": "わかった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105405/4001054050220"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ついでに言うと、\r\n他のみんなもオフになるように調整してある』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054050230,
    "speaker": "樹里",
    "text": "えっ、みんなって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105405/4001054050230"
  },
  {
    "speaker": "プロデューサー",
    "text": "『放クラの５人全員！　はは、珍しいだろう？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『たまにはみんなで出かけたいって言ってたしさ、\r\nこの間の番組も頑張ってくれたし……』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ちょっとしたプレゼントってことでさ！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
