  },
  {
    "id": 4001054050270,
    "speaker": "智代子",
    "text": "『みんなで遊べる！　わーい！』で止まっております",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
