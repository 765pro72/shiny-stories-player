    "bgEffectTime": 1000,
    "fgEffectTime": 500
  },
  {
    "id": 4001060060240,
    "speaker": "真乃",
    "text": "『今日はみんなでお泊まり会の予定です』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106006/4001060060240"
  },
  {
    "id": 4001060060250,
    "speaker": "真乃",
    "text": "『オフの日を合わせてくださって\r\n本当にありがとうございました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106006/4001060060250"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、満喫してるな\r\nよかったよかった……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "se": "1345",
    "waitType": "time",
    "waitTime": 2500,
    "bgEffectTime": 1000,
    "fgEffectTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "彼女たちを過保護に守るだけじゃなく",
    "textCtrl": "p",
    "textFrame": "016"
  },
  {
    "speaker": "プロデューサー",
    "text": "彼女たちの大事なものが、いろんなかたちに、\r\nゆるやかに変わっていくことを……一番近くで見て",
    "textCtrl": "p",
    "textFrame": "016"
  },
  {
    "speaker": "プロデューサー",
    "text": "それでも大丈夫だと、一緒に歩んでいく",
    "textCtrl": "p",
    "textFrame": "016"
  },
  {
    "speaker": "プロデューサー",
    "text": "プロデューサーとは、\r\nそういう仕事なのだろうかとも思う",
    "textCtrl": "p",
    "textFrame": "016"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
