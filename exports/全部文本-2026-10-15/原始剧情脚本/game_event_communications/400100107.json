    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070580"
  },
  {
    "id": 4001001070590,
    "speaker": "真乃",
    "text": "お互いに大好きって思ったメンバーが\r\n集まったユニットなんだなって……そう思う、かな",
