  {
    "id": 4001001070370,
    "speaker": "真乃",
    "text": "……あの、灯織ちゃん、めぐるちゃん",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
