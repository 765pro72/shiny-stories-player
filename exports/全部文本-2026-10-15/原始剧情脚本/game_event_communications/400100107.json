  {
    "id": 4001001070150,
    "speaker": "めぐる",
    "text": "はいっ、これが真乃と灯織の分のジュース！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
