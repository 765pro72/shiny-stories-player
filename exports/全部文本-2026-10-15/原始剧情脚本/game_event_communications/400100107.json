  {
    "id": 4001001070040,
    "speaker": "めぐる",
    "text": "わたしたち、今完璧だった！　完璧だったよね！？\r\nちゃんと揃ってたよね！？",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070040"
  },
  {
    "id": 4001001070050,
    "speaker": "灯織",
    "text": "落ち着いて、大丈夫だから",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070050"
  },
  {
    "id": 4001001070060,
    "speaker": "真乃",
    "text": "本当に……私、上手くできてたかな……？\r\nみんなに教えてもらったこと、ちゃんと守れてたかな……？",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070060"
  },
  {
    "id": 4001001070070,
    "speaker": "灯織",
    "text": "みんな、できてたよ。ちゃんと揃ってた\r\n今までの練習で、1番上手くいってたと思う",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070070"
  },
  {
    "id": 4001001070080,
    "speaker": "灯織",
    "text": "真乃も、すごく堂々としてた\r\nターンも綺麗だったし、ちゃんと前も見れてたし──",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070080"
  },
  {
    "id": 4001001070090,
    "speaker": "灯織",
    "text": "──鳥が、空を飛んでるみたいだった",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070090"
  },
  {
    "id": 4001001070100,
    "speaker": "真乃",
    "text": "ほわぁ……！",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070100"
  },
  {
    "id": 4001001070110,
    "speaker": "めぐる",
    "text": "さっすがわたしたちの真乃！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070110"
  },
  {
    "id": 4001001070120,
    "speaker": "灯織",
    "text": "……やったね、真乃",
