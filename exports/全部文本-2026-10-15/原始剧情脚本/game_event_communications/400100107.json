  },
  {
    "id": 4001001070480,
    "speaker": "灯織",
    "text": "やるからには当然だけど……\r\nさっきも言ったでしょ、油断大敵",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070480"
  },
  {
    "id": 4001001070490,
    "speaker": "めぐる",
    "text": "油断じゃないよー、自信だよー",
