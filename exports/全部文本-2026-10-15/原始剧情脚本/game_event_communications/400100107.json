    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070490"
  },
  {
    "id": 4001001070500,
    "speaker": "灯織",
    "text": "またそうやって\r\nすぐ調子に乗るの、めぐるの悪い癖だよ",
