    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100107/4001001070120"
  },
  {
    "id": 4001001070130,
    "speaker": "真乃",
    "text": "うんっ……！\r\nふたりが一緒に頑張ってくれたからだよっ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
