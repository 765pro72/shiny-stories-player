  {
    "id": 4001054040510,
    "speaker": "智代子",
    "text": "……待ってるよー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040510"
  },
  {
    "id": 4001054040520,
    "speaker": "凛世",
    "text": "はい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040520"
  },
  {
    "id": 4001054040530,
    "speaker": "樹里",
    "text": "だな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040530"
  },
  {
    "id": 4001054040540,
    "speaker": "果穂",
    "text": "小学生も、アイドルに、なれまーす……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040540"
  },
  {
    "id": 4001054040550,
    "speaker": "樹里",
    "text": "『ちなみに、放クラには小学生の小宮果穂もいるんだ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040550"
  },
  {
    "id": 4001054040560,
    "speaker": "樹里",
    "text": "『だから、大人まで待たなくたっていいからな！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040560"
  },
  {
    "id": 4001054040570,
    "speaker": "果穂",
    "text": "あっ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040570"
  },
