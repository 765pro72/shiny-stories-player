  },
  {
    "id": 4001054040280,
    "speaker": "樹里",
    "text": "『……でも、うん。ほんと楽しい仕事だよ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040280"
  },
  {
    "speaker": "司会",
    "text": "『よし、じゃあ次の質問がある子──……\r\nはい！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "子ども",
    "text": "『えっと、アイドルはどれくらいもうかりますか？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "子ども",
    "text": "『安定して稼げそうでしょうか！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001054040290,
    "speaker": "樹里",
    "text": "『えっ……！？　安定か……\r\nしっかりしてるなあ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040290"
  },
  {
    "id": 4001054040300,
    "speaker": "樹里",
    "text": "『うん……それも仕事としては大事だよな！ \r\nでもええと……なんて答えようかな……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040300"
  },
  {
    "textFrame": "off",
    "se": "1421",
    "waitType": "time",
    "waitTime": 2200
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "子ども",
    "text": "『────樹里ちゃんみたいになるには、 \r\nどうしたらいいんですか？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001054040310,
    "speaker": "樹里",
    "text": "『……！　あははっ\r\n嬉しい質問だな。ありがとう』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040310"
  },
  {
    "id": 4001054040320,
    "speaker": "樹里",
    "text": "『どうしたら、か……うーん……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "頑張れ、樹里……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054040330,
    "speaker": "樹里",
    "text": "『…………うん』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040330"
  },
  {
    "id": 4001054040340,
    "speaker": "樹里",
    "text": "『アタシになろうって思わないのがいいかもな』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040340"
  },
  {
    "id": 4001054040350,
    "speaker": "樹里",
    "text": "『西城樹里を超えてやる！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040350"
  },
  {
    "id": 4001054040360,
    "speaker": "樹里",
    "text": "『そう思ってもらえると嬉しいっつーか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040360"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001054040370,
    "speaker": "樹里",
    "text": "『や、君なら全然超えられると思うけど \r\nなんつーか、そうやって思ってもらえたら……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040370"
  },
  {
    "id": 4001054040380,
    "speaker": "樹里",
    "text": "『その方がたぶん、君が本当になりたい姿になれる』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040380"
  },
  {
    "id": 4001054040390,
    "speaker": "樹里",
    "text": "『……そんな気がする』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040390"
  },
  {
    "textFrame": "off",
    "se": "1370",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
