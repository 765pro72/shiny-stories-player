  {
    "speaker": "ディレクター",
    "text": "あれ、２８３さん──！\r\nお疲れ様です",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……！　お疲れ様です\r\n先日はどうもありがとうございました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ディレクター",
    "text": "いやー、放クラのみなさんに出てもらったアイドル特集！\r\nとってもいい出来になりましたよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ディレクター",
    "text": "視聴者さんからの反応が\r\nものすごくて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1273",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "ディレクター",
    "text": "あ、ちょっと見てもらおうかな……\r\nいま時間あります？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええ、はい……！\r\nなんでしょう……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ディレクター",
    "text": "いまちょうど放映中なんですけどね\r\nリアルタイムで子どもたちからの声が届くんですよ",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "se": "0280",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、オンラインで番組にコメントが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ディレクター",
    "text": "…………ね？　『アイドルすごい！』\r\n『放クラみたいなアイドルになりたい』って──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "これは嬉しいですね……\r\nすみません、ありがとうございます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ディレクター",
    "text": "いえいえ！\r\n本当、お礼はこちらこそで",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "ディレクター",
    "text": "いやすみませんね、呼び止めてしまいまして\r\nまたよろしくお願いします！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい、どうぞよろしくお願いします……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
