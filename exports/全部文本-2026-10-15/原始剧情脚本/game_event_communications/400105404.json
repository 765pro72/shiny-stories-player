    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040400"
  },
  {
    "id": 4001054040410,
    "speaker": "樹里",
    "text": "これは、やばい……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040410"
  },
  {
    "id": 4001054040420,
    "speaker": "智代子",
    "text": "樹里ちゃん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040420"
  },
  {
    "id": 4001054040430,
    "speaker": "樹里",
    "text": "みんなで見るもんじゃねーな……\r\n今更だけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040430"
  },
  {
    "id": 4001054040440,
    "speaker": "智代子",
    "text": "ご、ごめん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040440"
  },
  {
    "id": 4001054040450,
    "speaker": "智代子",
    "text": "でもすごく見どころだと思う、\r\n質問してくれた子に真摯に向き合ってて──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040450"
  },
  {
    "id": 4001054040460,
    "speaker": "樹里",
    "text": "真面目に見られると余計恥ずかしいだろ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040460"
  },
  {
    "id": 4001054040470,
    "speaker": "夏葉",
    "text": "それは難しいわね\r\n本当に素敵な話だったもの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040470"
  },
  {
    "id": 4001054040480,
    "speaker": "果穂",
    "text": "はい！ \r\n樹里ちゃんはスゴくてカッコいいです！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040480"
  },
  {
    "id": 4001054040490,
    "speaker": "樹里",
    "text": "────…………！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105404/4001054040490"
  },
