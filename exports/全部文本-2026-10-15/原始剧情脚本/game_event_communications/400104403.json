  {
    "id": 4001044030520,
    "speaker": "ツイスタの投稿",
    "text": "『やっほー！\r\nイルミネーションスターズの八宮めぐるだよ』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030520"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044030530,
    "speaker": "ツイスタの投稿",
    "text": "『この間の会議動画、\r\nみんなはもう見てくれた？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030530"
  },
  {
    "id": 4001044030540,
    "speaker": "ツイスタの投稿",
    "text": "『もしまだだよーって人は要チェック！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030540"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044030550,
    "speaker": "ツイスタの投稿",
    "text": "『動画でも話してたとおり、\r\n今日からリレー形式で投稿していくよ！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030550"
  },
  {
    "id": 4001044030560,
    "speaker": "ツイスタの投稿",
    "text": "『なんだか交換日記みたい！\r\nこれ打ちながらワクワクしてるよー！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030560"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044030570,
    "speaker": "ツイスタの投稿",
    "text": "『最近すごく寒い日が続いてるよね\r\nだから、誰かにぎゅーって抱きつきたくなっちゃう！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030570"
  },
  {
    "id": 4001044030580,
    "speaker": "ツイスタの投稿",
    "text": "『この間はもこもこの真乃と灯織がいたので\r\n思いっきりぎゅうぎゅうしました！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030580"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044030590,
    "speaker": "ツイスタの投稿",
    "text": "『みんなも風邪ひかないように\r\nあったかくして過ごしてね！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030590"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044030600,
    "speaker": "ツイスタの投稿",
    "text": "『今日はここまで！\r\n明日の担当はノクチルの樋口円香ちゃんだよー！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030600"
  },
  {
    "id": 4001044030610,
    "speaker": "ツイスタの投稿",
    "text": "『お楽しみに！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104403/4001044030610"
