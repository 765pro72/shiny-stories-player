    "speaker": "ピアスの女性",
    "text": "（このアイドル、他の番組でも見た気がするな……）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4001047010050,
    "speaker": "甘奈",
    "text": "『甜花ちゃーん！　千雪さーん！\r\nどうぞ～！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010050"
  },
  {
    "textFrame": "off",
    "se": "1370",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "speaker": "ピアスの女性",
    "text": "（なんかのユニットの……）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047010060,
    "speaker": "甘奈",
    "text": "『それでは！　あらためてご挨拶させていただきます』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010060"
  },
  {
    "id": 4001047010061,
    "speaker": "一同",
    "text": "『甘奈！　甜花！　千雪！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010061"
  },
  {
    "id": 4001047010070,
    "speaker": "甘奈",
    "text": "『３人合わせて～～～～？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010070"
  },
  {
    "id": 4001047010071,
    "speaker": "一同",
    "text": "『アルストロメリア、です！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010071"
  },
  {
    "textFrame": "off",
    "se": "1370",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "speaker": "ピアスの女性",
    "text": "（あーそうそう、アルストロメリアね）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "バラエティ司会",
    "text": "『どうぞ、よろしく～～～』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『ていうか待って！　何、今の挨拶！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『キミたちそんな芸風だったっけ！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047010080,
    "speaker": "甜花",
    "text": "『練習、してきました……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010080"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『いや、練習したかどうかは聞いてないから』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001047010090,
    "speaker": "千雪",
    "text": "『私たち、甘奈ちゃんが頑張ってる番組に\r\n呼んでいただいたので』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010090"
  },
  {
    "id": 4001047010100,
    "speaker": "千雪",
    "text": "『少しでも盛り上げたいなあって』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010100"
  },
  {
    "id": 4001047010110,
    "speaker": "千雪",
    "text": "『それで……ね？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010110"
  },
  {
    "id": 4001047010120,
    "speaker": "甜花",
    "text": "『うん……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104701/4001047010120"
  },
  {
    "speaker": "雛壇芸人",
    "text": "『まあまあかな』\r\n『すべってたけど』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『こらー！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
