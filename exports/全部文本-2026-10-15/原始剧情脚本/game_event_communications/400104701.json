  },
  {
    "speaker": "ピアスの女性",
    "text": "（流行りのアーティストとかわからなくなってきたなあ……）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ピアスの女性",
    "text": "（…………）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ピアスの女性",
    "text": "（私も、女将さんと一緒だわ）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "バラエティ司会",
    "text": "『はいはい、雛壇の人たち立ち上がらないで』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『盛り上げ方を競いにきたわけじゃないから！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雛壇芸人",
    "text": "『えー！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雛壇芸人",
    "text": "『いちばんウケた人が主役になれるんじゃないの！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バラエティ司会",
    "text": "『そういう番組じゃない！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
