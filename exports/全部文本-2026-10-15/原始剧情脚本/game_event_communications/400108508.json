    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "ふたりの視線は、未来は……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "textCtrl": "cm",
    "select": "きっと\r\n交わっていきます",
