  {
    "speaker": "コンビニ店員",
    "text": "あれ、店長……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "おー\r\nお疲れ様！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "コンビニ店員",
    "text": "お疲れ様です\r\n……今日は店長も一緒ですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "いやいや！\r\nもう帰らせてもらうよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "休みなしで朝からずっとだったからさ\r\nもう、くたくた……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "コンビニ店員",
    "text": "バイトの数、減りましたもんね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "うん、ずっと募集はかけてるんだけど",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "店長",
