    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "新しい人が入ったら調整するから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "コンビニ店員",
    "text": "大丈夫ですよ\r\n慣れました",
