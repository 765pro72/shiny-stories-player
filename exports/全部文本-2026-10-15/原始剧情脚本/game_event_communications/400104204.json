    "textFrame": "001",
    "voice": "game_event_communications/400104204/4001042040040"
  },
  {
    "speaker": "白組メンバー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001042040050,
    "speaker": "あさひ",
    "text": "バトンの受け渡し、もっとうまくやれるっす！\r\nもっと練習したいっす！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104204/4001042040050"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "白組メンバー",
    "text": "あ、あはは……えっと～……\r\nごめんね、今日はムカデもやらなきゃなんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "白組メンバー",
    "text": "練習予定は見てくれてる？\r\nどの種目をどれだけやるか、ちゃんと書いてあるよ",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001042040060,
    "speaker": "あさひ",
    "text": "見たっすけど──",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104204/4001042040060"
  },
  {
    "speaker": "白組メンバー",
    "text": "わ、ありがとう！\r\nじゃあわかってくれるよね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "白組メンバー",
    "text": "場所借りてる都合もあるし、スケジュール崩せなくってさ\r\nちゃんと守ってもらわなくちゃ困るんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001042040070,
    "speaker": "あさひ",
    "text": "えー！",
    "charAnim1": "surp3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104204/4001042040070"
  },
  {
    "speaker": "白組メンバー",
    "text": "他のみんなも待ってるから、ね？",
    "textCtrl": "p",
    "textFrame": "003"
  },
