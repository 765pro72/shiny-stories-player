  },
  {
    "speaker": "白組メンバー",
    "text": "オッケー！\r\nじゃ、次の練習に──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001042040040,
    "speaker": "あさひ",
    "text": "えーっ、もっとリレーがやりたいっす",
    "charAnim1": "surp3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
