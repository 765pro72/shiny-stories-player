  {
    "id": 4001025050010,
    "speaker": "真乃",
    "text": "ふふ、おはよう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050010"
  },
  {
    "id": 4001025050020,
    "speaker": "真乃",
    "text": "……昨日はごめんね\r\nあのね、もう大丈夫だよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050020"
  },
  {
    "id": 4001025050030,
    "speaker": "真乃",
    "text": "あの後、お布団に入ってから、\r\n前にめぐるちゃんにもらった言葉を思い出してたの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050030"
  },
  {
    "id": 4001025050040,
    "speaker": "真乃",
    "text": "『わたしたちの真乃』って、言葉──……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050040"
  },
  {
    "id": 4001025050050,
    "speaker": "真乃",
    "text": "そうしたら、心がぽかぽかして、\r\nあっという間に朝になってて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050050"
  },
  {
    "id": 4001025050060,
    "speaker": "真乃",
    "text": "……\r\n私、ふたりと一緒にいられることがうれしいんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050060"
  },
  {
    "id": 4001025050070,
    "speaker": "真乃",
    "text": "とっても、とっても……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050070"
  },
  {
    "id": 4001025050080,
    "speaker": "真乃",
    "text": "いつか、ふたりにも\r\nそう思ってもらえたら、いいな……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050080"
  },
  {
    "id": 4001025050090,
    "speaker": "真乃",
    "text": "ふふっ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050090"
  },
  {
    "id": 4001025050100,
    "speaker": "真乃",
    "text": "今日も頑張るから、もう心配しないでね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102505/4001025050100"
  },
  {
    "id": 4001025050110,
    "speaker": "真乃",
    "text": "──いってきます、ピーちゃんっ",
