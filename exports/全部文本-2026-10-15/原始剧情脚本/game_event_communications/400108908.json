    "se": "1121",
    "autoWaitTime": 2100
  },
  {
    "speaker": "ファン１",
    "text": "え～～～めっちゃエモい！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "尊すぎる～～～～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "あっ、だから過去のアンティーカメンバーの姿の\r\n映像だったんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン１",
    "text": "うわー……なんか応援してきてよかった",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "うん……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
