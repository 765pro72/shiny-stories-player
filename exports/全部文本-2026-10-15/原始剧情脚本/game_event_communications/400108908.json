  },
  {
    "speaker": "劇団俳優",
    "text": "これ……アンティーカに入る前の恋鐘さんたち……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "（あっ、うまく踊れてないとこある……）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "（一生懸命で、辛そうな時もあって……）",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン１",
    "text": "わ……！\r\nなんか初々しい～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "貴重映像じゃん～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン１",
    "text": "ふふっ、前も可愛いと思ったけど、\r\nこうして見るとやっぱり最初はちょっと違うね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "うんうん\r\nアイドルになりきれてないっていうか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン１",
    "text": "ずっと追いかけてきたつもりだけど、\r\nこうしてみると新鮮～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン２",
    "text": "あれ……なんかメッセージかな？",
    "textCtrl": "p",
    "textFrame": "003"
  },
