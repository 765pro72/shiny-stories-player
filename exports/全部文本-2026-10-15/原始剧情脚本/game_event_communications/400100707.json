  {
    "id": 4001007070010,
    "speaker": "恋鐘",
    "text": "んふふ～、よかアーマーばい！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070010"
  },
  {
    "id": 4001007070020,
    "speaker": "摩美々",
    "text": "恋鐘ー、もっとモールとか\r\nいっぱい巻いといた方がいいんじゃないー？",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070020"
  },
  {
    "id": 4001007070030,
    "speaker": "恋鐘",
    "text": "うんうん、よかね～\r\n採用！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070030"
  },
  {
    "id": 4001007070040,
    "speaker": "霧子",
    "text": "落として……踏んだりしないように……\r\nちゃんと留めなきゃ……",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070040"
  },
  {
    "id": 4001007070050,
    "speaker": "恋鐘",
    "text": "ん？　えへへ、ありがと～霧子！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070050"
  },
  {
    "id": 4001007070060,
    "speaker": "霧子",
    "text": "──あっ、恋鐘ちゃん\r\n動いちゃだめ……！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070060"
  },
  {
    "id": 4001007070070,
    "speaker": "恋鐘",
    "text": "ふぇ！？　……あ、ごめん～霧子！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070070"
  },
  {
    "id": 4001007070080,
    "speaker": "咲耶",
    "text": "フフ、強そうだね恋鐘\r\nその調子なら、どんな悪でも打ち負かせそうだ",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070080"
  },
  {
    "id": 4001007070090,
    "speaker": "結華",
    "text": "とはいえほどほどにねー？\r\nこがたんが怪我するようなことだけはないように！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070090"
  },
  {
    "id": 4001007070100,
    "speaker": "恋鐘",
    "text": "もっちろん！\r\nぜ～んぶうちに任せとって！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070100"
  },
  {
    "id": 4001007070110,
    "speaker": "恋鐘",
    "text": "いつでも出れるけん！\r\n悪い泥棒は、うちが追い払らうばい！",
    "textCtrl": "p",
    "textFrame": "0003",
    "voice": "game_event_communications/400100707/4001007070110"
