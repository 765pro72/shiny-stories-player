  {
    "speaker": "劇団俳優",
    "text": "『私はずっとずっと、夢見てきたの！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "『舞台に立って、誰かを笑顔にしたり\r\n楽しい気持ちを届けたいって』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0451",
    "waitType": "time",
    "waitTime": 600
  },
  {
    "speaker": "劇団俳優",
    "text": "『そう、だから信じてる──\r\n未来はわたしが進むだけ、続いていくはず』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "『だから……っ……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0306",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "舞台監督",
    "text": "ごめん、ちょっとストップ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "舞台監督",
    "text": "今のところなんだけど、なんて言うのかな……\r\nもう少し気持ち込めて情感たっぷりにしてもらえる？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "舞台監督",
    "text": "今のだと、だいぶ暗いっていうか\r\nあんまり希望に満ち溢れてる感じ出てないからさ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "はい……すみません！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "speaker": "舞台監督",
    "text": "よろしくね。それにキミも、もう新人じゃないんだし、\r\n考えないと",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "舞台監督",
    "text": "この世界でやってくなら、もっと気張っていこうよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "劇団俳優",
    "text": "……はい",
    "textCtrl": "p",
    "textFrame": "003",
    "autoWaitTime": 800
  },
  {
    "speaker": "舞台監督",
    "text": "じゃあ、休憩挟んで\r\nもう一回！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0884"
  },
