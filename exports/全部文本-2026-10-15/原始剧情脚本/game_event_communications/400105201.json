    "voice": "game_event_communications/400105201/4001052010040"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "仕事忙しいのは知ってるから、\r\n無理にとは言わないんだけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "でも、高校生って人生で一回きりだし！\r\nノータッチってのもさびしいじゃん？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "んでね、謎解き用の謎を考えるの、\r\n分担してくれたら嬉しいな～って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "これなら場所も選ばないし、\r\n自分のペースでできるんじゃないかなって思うんだけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "どうかな？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001052010050,
    "speaker": "真乃",
    "text": "……！",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105201/4001052010050"
  },
  {
    "id": 4001052010060,
    "speaker": "真乃",
    "text": "そ、その……っ\r\n私でよかったら……、ぜひ……っ",
    "charAnim1": "shy1",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105201/4001052010060"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "！　そっかあ、嬉しい！\r\nじゃあ、お願いね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "メンバーがそれぞれ３つ、お題を考えて来ると\r\nちょうどいいんだけど……どうだろ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001052010070,
    "speaker": "真乃",
    "text": "わかった\r\n作ってみるね……っ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105201/4001052010070"
  },
  {
    "speaker": "真乃のクラスメイト",
    "text": "おー！　心強いお返事っ！\r\nじゃあ、よろしくね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
