    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107902/4001079020130"
  },
  {
    "id": 4001079020140,
    "speaker": "咲耶",
    "text": "今日は摩美々と、思う存分おしゃべりしたいな",
