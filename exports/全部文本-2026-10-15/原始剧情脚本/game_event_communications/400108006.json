    "fgEffectTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──あ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら見てくれ果穂\r\n外、雪だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060520,
    "speaker": "果穂",
    "text": "わー……っ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060520"
  },
  {
    "id": 4001080060530,
    "speaker": "果穂",
    "text": "これ……！\r\n今年はホワイトクリスマスになるんでしょうか……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060530"
  },
  {
    "speaker": "プロデューサー",
    "text": "おしゃれな言葉知ってるんだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060540,
    "speaker": "果穂",
    "text": "この前テレビで言ってました！\r\n『ホワイトクリスマスになったらいいですね』って！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060540"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂はなってほしいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060550,
    "speaker": "果穂",
    "text": "はい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060550"
  },
  {
    "id": 4001080060560,
    "speaker": "果穂",
    "text": "イルミネーションとかが\r\nもっときれいに見えるようになるって言ってたので……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060560"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……そうだよなぁ\r\nそういう──特別な感じがあるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "クリスマスの雪って",
    "textCtrl": "p",
    "textFrame": "002"
  },
