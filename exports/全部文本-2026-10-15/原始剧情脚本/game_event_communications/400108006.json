    "voice": "game_event_communications/400108006/4001080060420"
  },
  {
    "id": 4001080060430,
    "speaker": "果穂",
    "text": "２８３のみなさんとたくさん会えるので！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060430"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうかぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "集中レッスンみたいになってるもんな\r\n普段より会う機会も多いよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060440,
    "speaker": "果穂",
    "text": "えへへっ\r\n運動会の準備みたいで……！",
    "charAnim1": "touch",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060440"
  },
  {
    "id": 4001080060450,
    "speaker": "果穂",
    "text": "一緒に差し入れを食べたり、おしゃべりしたりするのは、 \r\n遠足みたいだなって……！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060450"
  },
  {
    "id": 4001080060460,
    "speaker": "果穂",
    "text": "だから全然疲れませんっ！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060460"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、なるほど\r\nそれはよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charAnim3": "blank",
    "charLabel": "kaho",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00309",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……今年のクリスマスは、\r\n当日にみんなでパーティーしたりは無理そうだったからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂みたいに、事務所のみんなと\r\nわいわい過ごしてくれてるっていうのは──嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "気分だけでも、ちょっとは感じてもらえてるのかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060470,
    "speaker": "果穂",
    "text": "……！\r\nそっか……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060470"
  },
  {
    "id": 4001080060480,
    "speaker": "果穂",
    "text": "毎日パーティーみたいだったから楽しかったんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060480"
  },
  {
    "textFrame": "off",
    "bg": "00130",
    "bgEffect": "fade",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 500
  },
  {
    "id": 4001080060490,
    "speaker": "果穂",
    "text": "プロデューサーさん！\r\n練習、クリスマスパーティーみたいです！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400108006/4001080060490"
  },
  {
    "speaker": "プロデューサー",
    "text": "おおっ、ほんとか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001080060500,
    "speaker": "果穂",
    "text": "はい！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060500",
    "autoWaitTime": 1000
  },
  {
    "id": 4001080060510,
    "speaker": "果穂",
    "text": "だから──『気分』、感じてますー！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108006/4001080060510"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "kaho",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
