    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010210"
  },
  {
    "id": 4001001010220,
    "speaker": "灯織",
    "text": "……そうですか、分かりました\r\nありがとうございます",
