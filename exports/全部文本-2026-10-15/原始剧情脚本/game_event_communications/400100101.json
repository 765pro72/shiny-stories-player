    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010140"
  },
  {
    "id": 4001001010150,
    "speaker": "灯織",
    "text": "……好きに呼んでくれていいよ",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010150"
  },
  {
    "id": 4001001010160,
    "speaker": "めぐる",
    "text": "じゃあ、灯織だねっ！　えへへっ、ありがとう！",
