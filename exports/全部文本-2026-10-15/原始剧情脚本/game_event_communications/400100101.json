    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010400"
  },
  {
    "id": 4001001010410,
    "speaker": "真乃",
    "text": "す、すごいね\r\n部活の助っ人って、毎日大変そう",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010410"
  },
  {
    "id": 4001001010420,
    "speaker": "めぐる",
    "text": "えへへー、体を動かすのが好きなんだ～\r\n真乃は何をするのが好き？",
    "charAnim1": "shy2",
