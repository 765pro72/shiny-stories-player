    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010240"
  },
  {
    "id": 4001001010250,
    "speaker": "めぐる",
    "text": "みんなで合わせるために、だよ灯織！\r\nそのためにコミュニケーションを大事にしなきゃ！",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010250"
  },
  {
    "id": 4001001010260,
    "speaker": "真乃",
    "text": "わ、私も……\r\nよかったら、ふたりのこと、知りたいなって……！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010260"
  },
  {
    "id": 4001001010270,
    "speaker": "灯織",
    "text": "……わかった",
