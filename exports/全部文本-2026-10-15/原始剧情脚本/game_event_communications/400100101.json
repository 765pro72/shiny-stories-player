    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010130"
  },
  {
    "id": 4001001010140,
    "speaker": "真乃",
    "text": "あのっ。よかったら、私も……",
