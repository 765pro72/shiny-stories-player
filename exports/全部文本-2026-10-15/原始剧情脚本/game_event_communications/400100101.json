  },
  {
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "meguru"
  },
  {
    "speaker": "プロデューサー",
    "text": "できたばかりのユニットだからな\r\nまずはお互いを知るところから、ゆっくり始めていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano"
  },
  {
    "id": 4001001010230,
    "speaker": "めぐる",
    "text": "賛成！　ふたりのお話、聞かせてほしいなっ\r\nたくさんおしゃべりしようよ！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010230"
  },
  {
    "id": 4001001010240,
    "speaker": "灯織",
    "text": "……あの。この３人でデビューするなら、\r\nみんなで合わせるレッスンを早く始めたほうが……",
