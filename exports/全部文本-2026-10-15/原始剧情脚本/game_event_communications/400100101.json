    "charLipAnim": "lip_surp_s",
    "charLabel": "meguru"
  },
  {
    "id": 4001001010380,
    "speaker": "真乃",
    "text": "すごいなぁ……私、まだしっかりやれてなくて……\r\n早く追いつけるようにしないと……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010380"
  },
  {
    "id": 4001001010390,
    "speaker": "めぐる",
    "text": "そんなに気負わなくても大丈夫！　一緒に頑張ろう？\r\nわたしもたくさん練習できてるわけじゃないし",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charAnim3Loop": false,
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400100101/4001001010390"
  },
  {
    "id": 4001001010400,
    "speaker": "めぐる",
    "text": "わたしは高校で、部活の助っ人をやってるんだ\r\nバスケでしょ、バレーでしょ、あと水泳と陸上！",
