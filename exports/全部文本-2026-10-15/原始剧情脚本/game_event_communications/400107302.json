    "bgEffectTime": 1000
  },
  {
    "speaker": "宣伝担当者",
    "text": "プロデューサーさん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "宣伝担当者",
    "text": "すみません、お待たせしちゃって\r\nレジ、けっこう混んでて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "いえいえ……！",
    "textCtrl": "p",
