    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 4001073020600,
    "speaker": "灯織",
    "text": "あ……今日ごめんね\r\n自主練、行けなくて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020600"
  },
  {
    "id": 4001073020610,
    "speaker": "めぐる",
    "text": "『ううん、全然だよー\r\nあと１回合わせられる日あるから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020610"
  },
  {
    "id": 4001073020620,
    "speaker": "灯織",
    "text": "……そうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020620"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4001073020630,
    "speaker": "めぐる",
    "text": "『ありがとう、灯織！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020630"
  },
  {
    "id": 4001073020640,
    "speaker": "灯織",
    "text": "……えっ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020640"
  },
  {
    "id": 4001073020650,
    "speaker": "めぐる",
    "text": "『ダンスの動画、送ってくれたでしょ？\r\nおかげで真乃もわたしもすごく助かったから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020650"
  },
  {
    "id": 4001073020660,
    "speaker": "めぐる",
    "text": "『灯織のアドバイスもわかりやすかったし……\r\nだから、今日は灯織のおかげ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020660"
  },
  {
    "textFrame": "off",
    "bg": "00883",
    "bgEffect": "fade",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 700
  },
  {
    "id": 4001073020670,
    "speaker": "灯織",
    "text": "…………そんな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020670"
  },
  {
    "id": 4001073020680,
    "speaker": "灯織",
    "text": "……\r\n何も、してないよ",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "096",
    "voice": "game_event_communications/400107302/4001073020680"
  },
  {
    "textFrame": "off",
    "bg": "00093",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "隣席の声１",
    "text": "正直、苦手なんですよ\r\nああいうグループ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "いるでしょ、いつも明るくて前向きな────\r\n親切が服着てるような人たち",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "ポジティブ・アレルギーっていうのかな\r\nまるで、こっちまで元気じゃないといけなくなるというか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00392",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "隣席の声２",
    "text": "いい子たちだと思うけどなぁ\r\n必要とされてるから売れてるわけでしょう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "それは否定しませんよ\r\nけど、それに息苦しさを感じてる人もいて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "見てると、こう、体力が持っていかれるような……\r\n太陽だって、ずっと見ていられないでしょ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声２",
    "text": "中学生の反抗期じゃないんだから……\r\nアイドルってそういうものじゃないですか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "そうだけど……\r\n綺麗事じゃ、目の前の現実は────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1148",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "隣席の声１",
    "text": "ほら……こうやって何か言うと\r\n何言っても、こっちが悪者になってしまう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "ポジティブなものだけ、人のためになってると思われて\r\n……僕らだって、頑張ってやってるのに……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1604",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "隣席の声２",
    "text": "飲みすぎですって……\r\nストイックも、そこまでいくと極端ですよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "隣席の声１",
    "text": "むしろ足りないくらいです\r\nまだまだ────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00093",
    "bgEffect": "fade",
