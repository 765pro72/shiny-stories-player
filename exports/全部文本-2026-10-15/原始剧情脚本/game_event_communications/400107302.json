    },
    "voice": "game_event_communications/400107302/4001073020530"
  },
  {
    "id": 4001073020540,
    "speaker": "めぐる",
    "text": "『ごめんね！\r\nいきなり電話しちゃって』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020540"
  },
  {
    "id": 4001073020550,
    "speaker": "灯織",
    "text": "────あっ\r\nそっか、返信忘れて……",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020550"
  },
  {
    "id": 4001073020560,
    "speaker": "めぐる",
    "text": "『ううん、それは大丈夫！』",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020560"
  },
  {
    "id": 4001073020570,
    "speaker": "めぐる",
    "text": "『いろいろ話しておきたいことあったんだけど……\r\nんーと、思い出すからちょっと待ってね……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020570"
  },
  {
    "id": 4001073020580,
    "speaker": "めぐる",
    "text": "『んー、んー、んー、んー……』",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107302/4001073020580"
  },
  {
    "id": 4001073020590,
    "speaker": "灯織",
    "text": "……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
