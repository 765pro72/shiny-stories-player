  },
  {
    "textFrame": "off",
    "se": "0580",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "宣伝担当者",
    "text": "────あ、もうこんな……\r\nいやー楽しかった、ありがとうございました",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "とんでもないです……！\r\nこちらこそ貴重なお話をありがとうございました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "宣伝担当者",
    "text": "先にお会計してきちゃうんで\r\nちょっと待っててもらえますか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "すみません、何から何まで……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "1487",
    "waitType": "time",
    "waitTime": 4000
  },
  {
    "textFrame": "off",
    "se": "1105",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……ふぅ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
