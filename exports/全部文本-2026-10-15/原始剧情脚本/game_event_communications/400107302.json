    "voice": "game_event_communications/400107302/4001073020470"
  },
  {
    "speaker": "困っている女性",
    "text": "……はぁー、最悪！\r\nダメだ、私",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001073020480,
    "speaker": "灯織",
    "text": "……えっ",
