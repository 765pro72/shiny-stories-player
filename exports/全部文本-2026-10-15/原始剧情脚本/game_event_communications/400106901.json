    "waitTime": 500
  },
  {
    "speaker": "乗客１",
    "text": "これ、インタビューの動画なんだけどさ────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00493",
