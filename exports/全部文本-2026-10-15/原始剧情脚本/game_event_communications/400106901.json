  },
  {
    "speaker": "乗客１",
    "text": "このアイドル、知ってる──────？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "乗客２",
    "text": "あ～、見たことある\r\n最近よく出てるよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "乗客２",
    "text": "大型の新人アイドルだって──────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "乗客１",
    "text": "そうそう、この前見て\r\n推しになっちゃったんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "乗客１",
    "text": "お前もチェックしといたほうがいいって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bgm": "fade_out",
