  {
    "speaker": "白いＴシャツの男の子",
    "text": "いや、ほんとに悪かったって思ってるんだって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "白いＴシャツの男の子",
    "text": "コーラ飲んでた時、\r\nお前いねーとやっぱつまんねーなって思ったし……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "白いＴシャツの男の子",
    "text": "っていうか、後半に謎解きなんてあるのか？\r\n初めて知った",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "星柄シャツの男の子",
    "text": "……あるよ\r\nスタッフさんがそう言ってたじゃないか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "星柄シャツの男の子",
    "text": "お前、ほんと人の話聞かないよな……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "白いＴシャツの男の子",
    "text": "ふうん……\r\nじゃあ、お前の言うとおり、そういうヒントあるかもなー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "半ズボンの男の子",
    "text": "そっか……俺も聞いてなかった\r\nお前やっぱ頭いいな！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "星柄シャツの男の子",
    "text": "…………お前ら……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "星柄シャツの男の子",
    "text": "…………もういいよ\r\n俺も、言い過ぎたとこあるし……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "半ズボンの男の子",
    "text": "おう\r\nコーラ飲むか？",
    "textCtrl": "p",
    "textFrame": "003"
