  },
  {
    "id": 4001018060230,
    "speaker": "めぐる",
    "text": "でも、泣き言を言う暇があったら、\r\n今の自分にできることをがんばらなくちゃだよね",
    "textCtrl": "p",
    "textFrame": "0006",
    "voice": "game_event_communications/400101806/4001018060230"
