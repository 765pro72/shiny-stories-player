  {
    "speaker": "パパ",
    "text": "『──甜花、甘奈。ちょっとおいで』",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "0040"
  },
  {
    "speaker": "パパ",
    "text": "『今日はふたりにおともだちを紹介するよ』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030020070,
    "speaker": "甘奈",
    "text": "『おともだち？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020070"
  },
  {
    "speaker": "パパ",
    "text": "『ああ、そうだ\r\nふたりがたくさんお願いしていた……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030020080,
    "speaker": "甜花",
    "text": "『わ……！\r\nデビたろう……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020080"
  },
  {
    "id": 4001030020090,
    "speaker": "甘奈",
    "text": "『とっても、とっても、大きい……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020090"
  },
  {
    "speaker": "ママ",
    "text": "『ふふ、ふたりでかわいがってあげてね』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030020100,
    "speaker": "甜花",
    "text": "『うん……！\r\nいっぱい、ぎゅーってする……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020100"
  },
  {
    "id": 4001030020110,
    "speaker": "甘奈",
    "text": "『パパ、ママ……\r\nありがとーー！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020110"
  },
  {
    "textFrame": "off",
    "fg": "001923",
    "fgEffect": "switch_fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4001030020120,
    "speaker": "off",
    "text": "はじめて、デビ太郎がおうちに来た日……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020120"
  },
  {
    "id": 4001030020130,
    "speaker": "off",
    "text": "その日から……毎日、一緒",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020130"
  },
  {
    "id": 4001030020140,
    "speaker": "off",
    "text": "遊ぶ時も、ごはんの時も、おやつの時も……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020140"
  },
  {
    "id": 4001030020150,
    "speaker": "off",
    "text": "お昼寝の時も……\r\nふたりの真ん中……置いて、ぎゅー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020150"
  },
  {
    "id": 4001030020160,
    "speaker": "off",
    "text": "けど、甜花……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020160"
  },
  {
    "id": 4001030020170,
    "speaker": "off",
    "text": "だんだんデビ太郎に\r\nなーちゃん、取られた気持ちになって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103002/4001030020170"
  },
  {
    "textFrame": "off",
    "fg": "001921",
    "fgEffect": "switch_fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
