  {
    "speaker": "プロデューサー",
    "text": "──────もしもし\r\nはい、アイドルフェスのお話ですよね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "イベントプロデューサー",
    "text": "『その後いかがかなと思いまして』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "イベントプロデューサー",
    "text": "『こちらとしましても、是非ご出演いただきたく\r\n何度もお電話してしまい、申し訳ないのですが』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "いえ、とてもありがたいです……！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0454"
  },
  {
    "speaker": "プロデューサー",
    "text": "ただ……\r\nすみませんが、もう少しお待ちいただきたく……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
