    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　すまん\r\nそういうことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001030040110,
    "speaker": "甜花",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
