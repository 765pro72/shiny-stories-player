  },
  {
    "id": 4001030040440,
    "speaker": "甜花",
    "text": "やっぱ……\r\nなんでもない……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040440"
  },
  {
    "speaker": "プロデューサー",
    "text": "……どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001030040450,
    "speaker": "甜花",
    "text": "……えと……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040450"
  },
  {
    "id": 4001030040460,
    "speaker": "甜花",
    "text": "もし……なーちゃんが、\r\nお仕事まで、よくならなかったら……",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040460"
  },
  {
    "id": 4001030040470,
    "speaker": "甜花",
    "text": "甜花が……なーちゃんの格好で\r\nお仕事、行こうかなって、思った……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040470"
  },
  {
    "id": 4001030040480,
    "speaker": "甜花",
    "text": "でも……やっぱり、ダメか……って",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040480"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……！\r\nなるほどな、ふたごならではの……ってやつだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "プライベートなら面白いかもしれないけど、\r\n確かに、仕事では難しそうだ",
    "charAnim2": "face_wait2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
