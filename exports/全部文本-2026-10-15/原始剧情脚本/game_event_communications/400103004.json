  },
  {
    "speaker": "パパ",
    "text": "そうかそうか\r\nそれじゃ、ゆっくり考えながら散歩しようか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030040360,
    "speaker": "甜花",
    "text": "甜花……ゲーム売り場、行きたい……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040360"
  },
  {
    "speaker": "パパ",
    "text": "おっ、いいな、覗いてみよう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030040370,
    "speaker": "甘奈",
    "text": "甘奈はお洋服とアクセサリーが見たい……！\r\nあとコスメ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040370"
  },
  {
    "speaker": "パパ",
    "text": "コスメ……！？\r\nハハハ、甘奈はおませだなあ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001030040380,
    "speaker": "甘奈",
    "text": "えー？　いまどき普通だよー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040380"
  },
  {
