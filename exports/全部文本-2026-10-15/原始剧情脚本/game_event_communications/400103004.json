  {
    "id": 4001030040381,
    "speaker": "off",
    "text": "服が２着、違うもの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040381"
  },
  {
    "id": 4001030040382,
    "speaker": "off",
    "text": "靴が２足、違うもの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040382"
  },
  {
    "id": 4001030040390,
    "speaker": "off",
    "text": "ペンケースを、開いた時の香りが変わって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040390"
  },
  {
    "id": 4001030040400,
    "speaker": "off",
    "text": "お弁当に、好きなおかずを入れてもらって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040400"
  },
  {
    "id": 4001030040410,
    "speaker": "off",
    "text": "なーちゃんのいいところは、\r\n明るくて、きらきらしてて、お友達がいっぱいなところ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040410"
  },
  {
    "id": 4001030040420,
    "speaker": "off",
    "text": "甜花ちゃんのいいところは、\r\n優しくて、強くて、かっこよくて、かわいーところ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040420"
  },
  {
    "id": 4001030040421,
    "speaker": "off",
    "text": "いいところは、違うところ──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103004/4001030040421"
  },
  {
