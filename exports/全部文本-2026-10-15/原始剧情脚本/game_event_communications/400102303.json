    "voice": "game_event_communications/400102303/4001023030260"
  },
  {
    "id": 4001023030270,
    "speaker": "愛依",
    "text": "あ、そのストラップ！\r\n冬優子ちゃん好きって言ってたアニメのじゃん！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030270"
  },
  {
    "charAnim2": "face_wait",
    "charLabel": "fuyuko"
  },
  {
    "id": 4001023030280,
    "speaker": "愛依",
    "text": "名前……あの、えーっと……\r\nぱぷりん……ぽむたん……違くて、えーっと…………",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030280"
  },
  {
    "id": 4001023030290,
    "speaker": "冬優子",
    "text": "……虹色妖精ぽぽりん\r\nぱぷりんは夢色で、ぽむたんは闇色",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030290"
  },
  {
    "id": 4001023030300,
    "speaker": "愛依",
    "text": "それー！\r\nどうしてもごっちゃになっちゃうんだよね～",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030300"
  },
  {
    "charAnim2": "face_surp",
    "charLabel": "mei"
  },
  {
    "id": 4001023030310,
    "speaker": "冬優子",
    "text": "……無理に話合わせなくていいわよ\r\n別に、好きでもない人に押し付けるつもりないから",
    "charAnim1": "sad2",
    "charAnim2": "face_down",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030310"
  },
  {
    "id": 4001023030320,
    "speaker": "愛依",
    "text": "や、無理にとか全然ないし！\r\nてゆーか、うちが覚えれてないだけでアニメも見たんだよ！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030320"
  },
  {
    "id": 4001023030330,
    "speaker": "冬優子",
    "text": "え……\r\nなんで…………？",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030330"
  },
  {
    "id": 4001023030340,
    "speaker": "愛依",
    "text": "前に冬優子ちゃんが教えてくれたんじゃん",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030340"
  },
  {
    "id": 4001023030350,
    "speaker": "愛依",
    "text": "そんで\r\nプロデューサーに見る方法も教えてもらったし！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030350"
  },
  {
    "id": 4001023030360,
    "speaker": "冬優子",
    "text": "だから、なんでって──……",
    "charAnim1": "wait3",
    "charAnim2": "face_down",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102303/4001023030360"
  },
  {
    "id": 4001023030370,
    "speaker": "愛依",
    "text": "？　冬優子ちゃんが好きなのなんでしょ？\r\nそれなら、絶対面白いに決まってるって思ってたから！",
    "charAnim1": "shy1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile1",
