  {
    "id": 4001023030260,
    "speaker": "冬優子",
    "text": "！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
