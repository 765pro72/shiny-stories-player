    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "…………あ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "イベントスタッフ",
    "text": "えっ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\nいや、すみません",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……まだ可能性の段階ですが\r\nもしかすると──",
