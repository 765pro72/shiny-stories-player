  {
    "id": 4001063020130,
    "speaker": "冬優子",
    "text": "……有馬かなは元子役……\r\n芸歴が長いのね",
    "charAnim1": "shrug",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
