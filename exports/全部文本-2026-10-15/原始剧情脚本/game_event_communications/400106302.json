    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400106302/4001063020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、まだ活動を始めて間もないが、\r\n３人とも先代の名を継ぐ実力の持ち主と見ていいだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
