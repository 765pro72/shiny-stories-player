    "waitTime": 1000
  },
  {
    "id": 4001042030880,
    "speaker": "愛依",
    "text": "……かっこいいけど、大変だよね──",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
