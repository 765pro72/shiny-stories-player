    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だとしたら\r\n愛依は、冬優子に何をしてやりたい？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001042030890,
    "speaker": "愛依",
    "text": "え？",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104203/4001042030890"
  },
  {
    "speaker": "プロデューサー",
    "text": "心配なんだろ？　冬優子が",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001042030900,
    "speaker": "愛依",
    "text": "えっ、いや！\r\nそういうカンジじゃ──",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "099",
    "voice": "game_event_communications/400104203/4001042030900"
  },
  {
    "id": 4001042030910,
    "speaker": "愛依",
    "text": "だって冬優子ちゃんからしてみたら、\r\nうちの方が心配だよって話だと思うし！",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104203/4001042030910"
  },
  {
    "id": 4001042030920,
    "speaker": "愛依",
    "text": "そうじゃなくて、なんか！\r\nその──",
    "charAnim1": "serious",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
