    "waitTime": 1500
  },
  {
    "id": 4001042030930,
    "speaker": "愛依",
    "text": "『いいのかな』",
    "charAnim2": "face_close2",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104203/4001042030930"
  },
  {
    "id": 4001042030940,
    "speaker": "愛依",
    "text": "『よくないんじゃないかな』\r\nみたいな……えーっと……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104203/4001042030940"
  },
  {
    "charAnim2": "face_close2",
