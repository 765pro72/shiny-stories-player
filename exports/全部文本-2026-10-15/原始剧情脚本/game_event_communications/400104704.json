    "waitTime": 1500
  },
  {
    "speaker": "コンビニ店員",
    "text": "────じゃ、シフト交換については、\r\n俺から店長に話しときますんで",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "バイト仲間",
    "text": "マジでありがと\r\n助かるよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00476",
