    "textFrame": "001",
    "voice": "game_event_communications/400107705/4001077050010"
  },
  {
    "id": 4001077050020,
    "speaker": "甘奈",
    "text": "プロデューサーさん、車停めに行くよね？\r\n甘奈たち、先に入って待ってるね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107705/4001077050020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00129",
    "bgEffect": "fade",
