    "fgEffectTime": 500
  },
  {
    "id": 4001086080330,
    "speaker": "千雪",
    "text": "『幸いなことに、私は今\r\n自分が思い描いた道を歩けていると、感じている』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080330"
  },
  {
    "id": 4001086080340,
    "speaker": "千雪",
    "text": "『そして、これからも\r\n歩み続けて行きたい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080340"
  },
  {
    "id": 4001086080350,
    "speaker": "千雪",
    "text": "『初心を忘れず』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080350"
  },
  {
    "id": 4001086080360,
