    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080280"
  },
  {
    "speaker": "ファン",
    "text": "……！\r\n覚えててくださったんですか……！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0327"
  },
  {
    "id": 4001086080290,
    "speaker": "千雪",
    "text": "うん、もちろん",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080290"
  },
  {
    "speaker": "ファン",
    "text": "すっごく嬉しいです！\r\nあ、エッセイ読みましたよ！　とっても素敵でした！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ファン",
    "text": "千雪さんの笑顔に、あんな秘密があったなんて……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001086080300,
    "speaker": "千雪",
    "text": "ふふっ。赤裸々に書いたから、面と向かって言われると\r\nちょっと恥ずかしい気持ち♪",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080300"
  },
  {
    "speaker": "ファン",
    "text": "わ、す、すみません……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001086080310,
    "speaker": "千雪",
    "text": "ううん、ありがとう\r\n時々でいいから、読み返してくれると嬉しいな",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080310"
  },
  {
    "speaker": "スタッフ",
    "text": "桑山さん……すみません\r\nそろそろ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001086080320,
    "speaker": "千雪",
    "text": "ごめんなさい……もう時間みたい\r\n楽しい時間はあっという間だね",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400108608/4001086080320"
  },
  {
    "charAnim1": "wait",
