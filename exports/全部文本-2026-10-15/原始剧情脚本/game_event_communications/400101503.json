  },
  {
    "id": 4001015030800,
    "speaker": "真乃",
    "text": "あっ……ごめんなさい……っ",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030800"
  },
  {
    "id": 4001015030810,
    "speaker": "千雪",
    "text": "ううん、違うの\r\n私もだから──",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030810"
  },
  {
    "id": 4001015030820,
    "speaker": "真乃",
    "text": "……やっぱり、一緒ですね",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030820"
  },
  {
    "id": 4001015030830,
    "speaker": "千雪",
    "text": "そう！\r\n……だって、すごく楽しいもんね",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030830"
  },
  {
    "id": 4001015030840,
    "speaker": "真乃",
    "text": "はいっ……ふふ……\r\nみんなでこうやって、お泊りができて……",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030840"
  },
  {
    "id": 4001015030850,
    "speaker": "真乃",
    "text": "明日もあさっても楽しみで、ドキドキするんです",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030850"
  },
  {
    "id": 4001015030860,
    "speaker": "真乃",
    "text": "──……寝なきゃいけないのもわかってるんですけど……",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030860"
  },
  {
    "id": 4001015030870,
    "speaker": "千雪",
    "text": "そうなんだよね……\r\nどうしたらいいかなぁ……",
