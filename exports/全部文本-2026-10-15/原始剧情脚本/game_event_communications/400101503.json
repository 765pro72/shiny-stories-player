    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030890"
  },
  {
    "id": 4001015030900,
    "speaker": "結華",
    "text": "ふふっ……！　や、ごめん、\r\nチョコが言うみたいにあんまり平和だったからつい……！",
    "textCtrl": "p",
    "textFrame": "0017",
