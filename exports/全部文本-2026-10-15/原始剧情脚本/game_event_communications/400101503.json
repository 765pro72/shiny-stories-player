  {
    "id": 4001015030730,
    "speaker": "真乃",
    "text": "……智代子ちゃん？",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030730"
  },
  {
    "id": 4001015030740,
    "speaker": "智代子",
    "text": "ああっ、ごめんね……！\r\n早く明日にならないかなーって思って！",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030740"
  },
  {
    "id": 4001015030750,
    "speaker": "結華",
    "text": "こーら、チョコ～\r\n自分から言ったくせにまだ寝ないつもりー？",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030750"
  },
  {
    "id": 4001015030760,
    "speaker": "智代子",
    "text": "違います違いますっ\r\nちゃんと寝るよ！",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030760"
  },
  {
    "id": 4001015030770,
    "speaker": "智代子",
    "text": "今のはどうぞ、忘れてください……！",
    "textCtrl": "p",
    "textFrame": "0017",
    "voice": "game_event_communications/400101503/4001015030770"
  },
  {
    "id": 4001015030771,
    "speaker": "真乃＆結華＆千雪",
    "text": "ふふふっ……",
