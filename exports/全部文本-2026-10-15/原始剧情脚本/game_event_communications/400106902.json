  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "イベントプロデューサー",
    "text": "『あぁ、それと──』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "イベントプロデューサー",
    "text": "『ユニットでの参加もできることになりまして────』",
