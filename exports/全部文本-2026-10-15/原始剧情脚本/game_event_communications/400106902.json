  {
    "speaker": "プロデューサー",
    "text": "というわけで、今週末は\r\nはるきとの合同レッスンになった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001069020210,
    "speaker": "羽那",
    "text": "えーっ、本当？",
