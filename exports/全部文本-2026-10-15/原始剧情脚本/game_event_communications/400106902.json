    "charAnim2": "face_wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400106902/4001069020280"
  },
  {
    "speaker": "プロデューサー",
    "text": "……その時は\r\n俺がなんとかするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001069020290,
    "speaker": "羽那",
    "text": "えーっ、その可能性大ってこと……！？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hana",
