    "textFrame": "001",
    "voice": "game_event_communications/400108201/4001082010220"
  },
  {
    "speaker": "電機メーカー社長",
    "text": "さっき、君たちのプロデューサーくんと話していて\r\nリーダーは君だと聞いたんで、挨拶をね",
    "charAnim2": "face_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001082010230,
    "speaker": "冬優子",
    "text": "すみません！\r\nこちらから伺うべきところ──",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
