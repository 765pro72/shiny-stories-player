    "textFrame": "001",
    "voice": "game_event_communications/400108201/4001082010230"
  },
  {
    "speaker": "電機メーカー社長",
    "text": "はは、そんなにかしこまらなくていいから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
