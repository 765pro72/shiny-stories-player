  },
  {
    "id": 4001072010220,
    "speaker": "愛依",
    "text": "えへへ～\r\nかさ、友達と一緒に入ったの！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010220"
  },
  {
    "id": 4001072010230,
    "speaker": "愛依",
    "text": "それで、こうなっちゃった！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010230"
  },
  {
    "id": 4001072010240,
    "speaker": "愛依",
    "text": "忘れちゃったーって、困ってたから！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010240"
  },
  {
    "speaker": "愛依の母",
    "text": "……そっか～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010250,
    "speaker": "愛依",
    "text": "うん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010250"
  },
  {
    "speaker": "愛依の母",
    "text": "本当はね～\r\n濡れないと嬉しかったけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010260,
    "speaker": "愛依",
    "text": "……ダメだった……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010260"
  },
  {
    "speaker": "愛依の母",
    "text": "そんなことないぞ～！\r\nあんたは本当に友達想いで偉い！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010270,
    "speaker": "愛依",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010270"
  },
  {
    "textFrame": "off",
    "bg": "01080",
    "bgEffect": "fade",
