    "text": "愛依、今日もお疲れ様",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001072010300,
    "speaker": "愛依",
    "text": "うん、お疲れ",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
