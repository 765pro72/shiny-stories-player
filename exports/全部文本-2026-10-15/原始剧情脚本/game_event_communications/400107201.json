  {
    "id": 4001072010210,
    "speaker": "愛依",
    "text": "ただいま～！！！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010210"
  },
  {
    "speaker": "愛依の母",
    "text": "おかえり……\r\nってどうしたの！　びしょびしょじゃない！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00820",
