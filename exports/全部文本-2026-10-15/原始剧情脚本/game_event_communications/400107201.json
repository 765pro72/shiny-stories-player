    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 800,
    "middleFg": "fade_out",
    "middleFgEffectTime": 800
  },
  {
    "speaker": "愛依の母",
    "text": "今日の夕飯は愛依の好きなものにしよう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010280,
    "speaker": "愛依",
    "text": "やったー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010280"
  },
  {
    "speaker": "愛依の母",
    "text": "ほら、早く中入って！　まずは髪を乾かそう！\r\nでも、次は濡れないようにしないとダメだぞ～？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010290,
    "speaker": "愛依",
    "text": "はーい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010290"
  },
