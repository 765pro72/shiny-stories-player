  {
    "id": 4001072010020,
    "speaker": "愛依",
    "text": "ただいま～！！！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010020"
  },
  {
    "speaker": "愛依の母",
    "text": "おっ、おかえり！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00886",
    "bgEffect": "fade",
    "se": "0242b",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 4001072010030,
    "speaker": "愛依",
    "text": "きいてきいて！\r\n今日ねー、こくごでかんじ！　ならった！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010030"
  },
  {
    "speaker": "愛依の母",
    "text": "おー、どんな字を習ったの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010040,
    "speaker": "愛依",
    "text": "うーんとね……\r\nいろいろ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010040"
  },
  {
    "speaker": "愛依の母",
    "text": "いろいろか～\r\nじゃあ、額に入ってるあれ、読めるかな～？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010050,
    "speaker": "愛依",
    "text": "がく……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010050"
  },
  {
    "speaker": "愛依の母",
    "text": "私の指の先見て～？\r\n四角い形の中に、４つ、文字が書いてあるでしょ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の母",
    "text": "あれ、読めるかな～？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010060,
    "speaker": "愛依",
    "text": "やってみる！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010060"
  },
  {
    "textFrame": "off",
    "bg": "00645",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 4001072010070,
    "speaker": "愛依",
    "text": "うーんと……\r\nえーっと……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010070"
  },
  {
    "id": 4001072010080,
    "speaker": "愛依",
    "text": "いち……にち……いち……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010080"
  },
  {
    "id": 4001072010090,
    "speaker": "愛依",
    "text": "４つめのはわかんない！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010090"
  },
  {
    "speaker": "愛依の母",
    "text": "うんうん！\r\n３つ目まで読めただけでも、えらいよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010100,
    "speaker": "愛依",
    "text": "えへへー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010100"
  },
  {
    "speaker": "愛依の母",
    "text": "４文字目はね『ぜん』って読むの\r\n全部合わせて『一日一善』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010110,
    "speaker": "愛依",
    "text": "いち……にち……いち……ぜん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010110"
  },
  {
    "textFrame": "off",
    "bg": "00886",
    "bgEffect": "fade",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 500
  },
  {
    "id": 4001072010120,
    "speaker": "愛依",
    "text": "いちにちいちぜん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010120"
  },
  {
    "speaker": "愛依の母",
    "text": "そうそう！　一日一善！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0508"
  },
  {
    "speaker": "愛依の母",
    "text": "あれはね、和泉家の家訓……だと難しいか……\r\nおやくそく！　みたいなもので",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010130,
    "speaker": "愛依",
    "text": "うんうん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010130"
  },
  {
    "speaker": "愛依の母",
    "text": "１日に１回は、人に優しくしよう！\r\nっていうことよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010140,
    "speaker": "愛依",
    "text": "やさしくする……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010140"
  },
  {
    "speaker": "愛依の母",
    "text": "うん、お友達が泣いてたりしたら\r\nどうしたの？　って言ってあげたりとか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の母",
    "text": "困っているお友達を\r\n助けてあげたりとか！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の母",
    "text": "そういうことができるようになろう！\r\nっていう言葉！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010150,
    "speaker": "愛依",
    "text": "うーん……わかんないけど……\r\n……わかった！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010150"
  },
  {
    "speaker": "愛依の母",
    "text": "よしよし！　それじゃ\r\nもう少し大きくなったら、また教えるぞ～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001072010160,
    "speaker": "愛依",
    "text": "はーい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107201/4001072010160"
  },
