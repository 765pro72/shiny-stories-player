    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4001030060750,
    "speaker": "甜花",
    "text": "……ね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060750"
  },
  {
    "id": 4001030060760,
    "speaker": "甜花",
    "text": "プレゼント、違うの……\r\nお願いするようになったの、何歳、だっけ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060760"
  },
  {
    "id": 4001030060770,
    "speaker": "甜花",
    "text": "覚えてる……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060770"
  },
  {
    "id": 4001030060780,
    "speaker": "甘奈",
    "text": "９歳じゃなかったかなぁ……\r\n９歳の誕生日",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060780"
  },
  {
    "id": 4001030060790,
    "speaker": "甜花",
    "text": "あ……そうかも",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060790"
  },
  {
    "id": 4001030060800,
    "speaker": "甜花",
    "text": "えと……甜花がゲームで、なーちゃんがメイクセット……\r\n買ってもらったの、何歳だっけ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060800"
  },
  {
    "id": 4001030060810,
    "speaker": "甘奈",
    "text": "あー……それは、\r\n10歳くらいだったかなぁ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060810"
  },
  {
    "id": 4001030060820,
    "speaker": "甜花",
    "text": "10歳……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060820"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060830,
    "speaker": "甜花",
    "text": "……本当は、甜花も……\r\nあのメイクセット、欲しかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060830"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060840,
    "speaker": "甘奈",
    "text": "えっ……そうだったの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060840"
  },
  {
    "id": 4001030060850,
    "speaker": "甜花",
    "text": "CMやってて……かわいかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060850"
  },
  {
    "id": 4001030060860,
    "speaker": "甘奈",
    "text": "そうだったんだ……\r\n同じのお願いしてよかったのに",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060860"
  },
  {
    "id": 4001030060870,
    "speaker": "甜花",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060870"
  },
  {
    "id": 4001030060880,
    "speaker": "甜花",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060880"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060890,
    "speaker": "甜花",
    "text": "……でも……ゲームの方が、\r\nもっと欲しかった……気がする……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060890"
  },
  {
    "id": 4001030060900,
    "speaker": "甜花",
    "text": "両方……欲しかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060900"
  },
  {
    "id": 4001030060910,
    "speaker": "甘奈",
    "text": "それはパパとママにダメって言われちゃうね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060910"
  },
  {
    "id": 4001030060920,
    "speaker": "甜花",
    "text": "にへへ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060920"
  },
  {
    "textFrame": "off",
    "bg": "00430",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4001030060930,
    "speaker": "甘奈",
    "text": "流星群、一緒に見ようって、\r\n千雪さんを誘っておいたよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060930"
  },
  {
    "id": 4001030060940,
    "speaker": "甜花",
    "text": "わ……ありがとー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060940"
  },
  {
    "id": 4001030060950,
    "speaker": "甜花",
    "text": "それまでに……治るかな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060950"
  },
  {
    "id": 4001030060960,
    "speaker": "甘奈",
    "text": "きっと、治るよ\r\nまだ数日あるもん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060960"
  },
  {
    "id": 4001030060970,
    "speaker": "甜花",
    "text": "……うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060970"
  },
  {
    "id": 4001030060980,
    "speaker": "甘奈",
    "text": "甜花ちゃんは……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060980"
  },
  {
