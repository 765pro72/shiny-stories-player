    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……朝イチで病院に連れていくか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "ん……それじゃ、千雪が帰る時は車で送るから、\r\nメッセージをもらえるかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
