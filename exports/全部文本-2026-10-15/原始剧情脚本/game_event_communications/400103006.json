    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4001030060550,
    "speaker": "甜花",
    "text": "……ごめん、ね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060550"
  },
  {
    "id": 4001030060560,
    "speaker": "甘奈",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060560"
  },
  {
    "id": 4001030060570,
    "speaker": "甜花",
    "text": "なーちゃんが熱の間は、\r\n甜花が……なーちゃん……だったのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060570"
  },
  {
    "id": 4001030060580,
    "speaker": "甜花",
    "text": "なーちゃん、みたいに、\r\nなろうって思ってたのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060580"
  },
  {
    "id": 4001030060590,
    "speaker": "甘奈",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060590"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060600,
    "speaker": "甘奈",
    "text": "甜花ちゃんも熱が出たんだから、\r\n……また交換",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060600"
  },
  {
    "id": 4001030060610,
    "speaker": "甘奈",
    "text": "甜花ちゃんは甜花ちゃんに戻って、\r\n甘奈は甘奈に戻ったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060610"
  },
  {
    "id": 4001030060620,
    "speaker": "甜花",
    "text": "……そっか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060620"
  },
  {
    "id": 4001030060630,
    "speaker": "甜花",
    "text": "甜花……\r\n甜花に、戻っちゃった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060630"
  },
  {
    "id": 4001030060640,
    "speaker": "甘奈",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060640"
  },
  {
    "id": 4001030060650,
    "speaker": "甘奈",
    "text": "それで、甘奈は、\r\n甜花ちゃんな甜花ちゃんがだーいすき",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060650"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060660,
    "speaker": "甘奈",
    "text": "……だーいすき、なんだよ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060660"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060670,
    "speaker": "甜花",
    "text": "……あぅ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060670"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060680,
    "speaker": "甜花",
    "text": "……なーちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060680"
  },
  {
    "id": 4001030060690,
    "speaker": "甘奈",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060690"
  },
  {
    "id": 4001030060700,
    "speaker": "甜花",
    "text": "えと……今の甜花は、甜花だけど…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060700"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060710,
    "speaker": "甜花",
    "text": "なーちゃんも、甜花に……\r\n甘えて、ね……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060710"
  },
  {
    "id": 4001030060720,
    "speaker": "甜花",
    "text": "頼っていい、からね……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060720"
  },
  {
    "id": 4001030060730,
    "speaker": "甘奈",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060730"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4001030060740,
    "speaker": "甘奈",
    "text": "うん…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103006/4001030060740"
  },
  {
    "textFrame": "off",
