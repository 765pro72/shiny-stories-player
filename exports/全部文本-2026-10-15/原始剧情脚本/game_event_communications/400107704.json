    "textFrame": "001",
    "voice": "game_event_communications/400107704/4001077040040"
  },
  {
    "speaker": "off",
    "text": "『アルストちゃんの配信の感想\r\nネガ結構あるな……良さわからん感じっぽい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "off",
    "text": "『初見向けに楽しみ方の動画でも作るか』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001077040050,
    "speaker": "甜花",
    "text": "（応援……\r\nして、くれてる……？）",
