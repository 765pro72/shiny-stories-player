    "se": "0328",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "先方の担当者",
    "text": "かしこまりました、では\r\n一度そちらでお持ち帰りいただければと思います",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先方の担当者",
    "text": "ただ……やはり我々としては\r\n視聴を止めてしまった新規の方への訴求もしていきたいので",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先方の担当者",
    "text": "是非、強めに勝負をする姿勢を持っていただけますと\r\n大変ありがたく思います",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "無論、そのつもりです。御社にご納得いただける企画を\r\n考えてまいりますので、よろしくお願いいたします",
    "textCtrl": "p",
    "textFrame": "002"
