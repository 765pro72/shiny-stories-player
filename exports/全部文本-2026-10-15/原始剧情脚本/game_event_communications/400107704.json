  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "先方の担当者",
    "text": "具体的には、コラボを行うことや\r\nこちらで考えた企画を行っていただく",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先方の担当者",
    "text": "という方法を考えております",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ご提案、ありがとうございます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ですが、その方法ですと、今度はファン側の視聴者が\r\n離れてしまうのではないかと思います",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001077040090,
    "speaker": "甜花",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
