  },
  {
    "id": 4001044050660,
    "speaker": "千雪",
    "text": "さ、いい感じに今年を締められたかな……？",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104405/4001044050660"
  },
  {
    "id": 4001044050670,
    "speaker": "千雪",
    "text": "ゲストは放課後クライマックスガールズ西城樹里さん",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
