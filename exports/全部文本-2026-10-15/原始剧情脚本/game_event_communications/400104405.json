  {
    "id": 4001044050700,
    "speaker": "ツイスタの投稿",
    "text": "『放課後クライマックスガールズ\r\n西城樹里だ』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050700"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044050710,
    "speaker": "ツイスタの投稿",
    "text": "『昨日からリレー投稿ってことで\r\n円香からのパス、受け取った！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050710"
  },
  {
    "id": 4001044050720,
    "speaker": "ツイスタの投稿",
    "text": "『最近、めぐると雛菜を中心に\r\n２８３プロの動画を撮ったりしてるから』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050720"
  },
  {
    "id": 4001044050730,
    "speaker": "ツイスタの投稿",
    "text": "『みんなもチェックしてくれよな！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050730"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044050740,
    "speaker": "ツイスタの投稿",
    "text": "『最近、寒くて布団から出るのが\r\nつらいよなー』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050740"
  },
  {
    "id": 4001044050750,
    "speaker": "ツイスタの投稿",
    "text": "『けど、こんな時期だからこそ身体を動かさないとな\r\nみんなはできてるか？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050750"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044050760,
    "speaker": "ツイスタの投稿",
    "text": "『誰かと一緒にランニングするのがおすすめだな\r\nいつもアタシの場合は放クラメンバーとだけど』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050760"
  },
  {
    "id": 4001044050770,
    "speaker": "ツイスタの投稿",
    "text": "『この間も、メンバー全員と果穂の飼い犬のマメ丸と\r\n夏葉の飼い犬のカトレアと一緒にランニングしたんだ！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050770"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044050780,
    "speaker": "ツイスタの投稿",
    "text": "『年末年始、ゆっくり過ごすのもいいけど\r\n身体鈍らないようにしたいよな』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050780"
  },
  {
    "id": 4001044050790,
    "speaker": "ツイスタの投稿",
    "text": "『ってことで次は千雪さんにパス！\r\nって言っても、今寮で一緒にこれ打ってるんだけどさ』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050790"
  },
  {
    "id": 4001044050800,
    "speaker": "ツイスタの投稿",
    "text": "『じゃあ、明日も楽しみにしててくれよな！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104405/4001044050800"
  },
