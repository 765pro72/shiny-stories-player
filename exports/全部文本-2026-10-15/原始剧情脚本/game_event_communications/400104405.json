    "textFrame": "001",
    "voice": "game_event_communications/400104405/4001044050670"
  },
  {
    "id": 4001044050680,
    "speaker": "千雪",
    "text": "そして桑山千雪にお付き合いいただきました",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104405/4001044050680"
  },
  {
    "id": 4001044050690,
    "speaker": "千雪",
    "text": "『それではまた、来年。ベッドルームから\r\n世界をジャミングしちゃいましょう……♪』",
