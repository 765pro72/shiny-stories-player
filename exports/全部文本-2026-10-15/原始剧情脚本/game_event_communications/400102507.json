    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "はい、はい──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、３人は変わらずですよ\r\n本当に仲が良くて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当にお互いを大切に思いやっていて……\r\n心が通じ合っていて……まさに、以心伝心というか──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お互いで知らないことなんて、\r\nもう無いんじゃないでしょうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00309",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4001025070300,
    "speaker": "灯織",
    "text": "この気持ち、\r\n全部、伝えられたらいいのにな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070300"
  },
  {
    "id": 4001025070310,
    "speaker": "灯織",
    "text": "その気持ち、\r\n全部、見えたらいいのに",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070310"
  },
  {
    "id": 4001025070320,
    "speaker": "灯織",
    "text": "全部──……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070320"
  },
  {
    "id": 4001025070330,
    "speaker": "灯織",
    "text": "やっぱり、私は……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070330"
