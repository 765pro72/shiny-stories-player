    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070340"
  },
  {
    "id": 4001025070350,
    "label": "回想",
    "speaker": "真乃",
    "text": "よかったらこれ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070350"
  },
  {
    "id": 4001025070360,
    "label": "回想",
    "speaker": "めぐる",
    "text": "わー、すごい！　なあに？　綺麗な石ー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070360"
  },
  {
    "id": 4001025070370,
    "label": "回想",
    "speaker": "灯織",
    "text": "えっ、これ……\r\nメノウのストラップ……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070370"
  },
  {
    "id": 4001025070380,
    "label": "回想",
    "speaker": "真乃",
    "text": "うんっ……\r\nひとつの石から、お揃いを作ったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070380"
  },
  {
    "id": 4001025070390,
    "label": "回想",
    "speaker": "真乃",
    "text": "よかったら……一緒に……っ\r\n……あのね、灯織ちゃんに教えてもらったんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070390"
  },
  {
    "id": 4001025070400,
    "label": "回想",
    "speaker": "真乃",
