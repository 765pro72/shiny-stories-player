  {
    "id": 4001025070010,
    "speaker": "真乃",
    "text": "わ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070010"
  },
  {
    "id": 4001025070020,
    "speaker": "真乃",
    "text": "ツツジが綺麗だよ、灯織ちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070020"
  },
  {
    "id": 4001025070030,
    "speaker": "灯織",
    "text": "真乃は花も詳しいの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070030"
  },
  {
    "id": 4001025070040,
    "speaker": "真乃",
    "text": "詳しいってわけじゃ……でも、\r\n見かけると可愛いなって気になっちゃうんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070040"
  },
  {
    "id": 4001025070050,
    "speaker": "灯織",
    "text": "そうなんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070050"
  },
  {
    "id": 4001025070060,
    "speaker": "灯織",
    "text": "そういえば、ツツジの別名が『杜鵑』っていうの知ってる？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070060"
  },
  {
    "id": 4001025070070,
    "speaker": "真乃",
    "text": "とけん……\r\nううん、そんな別名があるんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070070"
  },
  {
    "id": 4001025070080,
    "speaker": "灯織",
    "text": "うん、それで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070080"
  },
  {
    "id": 4001025070090,
    "speaker": "灯織",
    "text": "ホトトギスも別名『杜鵑』っていうらしいよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070090"
  },
  {
    "id": 4001025070100,
    "speaker": "真乃",
    "text": "おんなじ名前を持ってるんだ……っ\r\n私、全然知らなかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070100"
  },
  {
    "id": 4001025070110,
    "speaker": "灯織",
    "text": "鳥のことを調べていたら……\r\nそう書いてあったから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070110"
  },
  {
    "id": 4001025070120,
    "speaker": "真乃",
    "text": "ほわ……そうなんだ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070120"
  },
  {
    "id": 4001025070130,
    "speaker": "真乃",
    "text": "ありがとう、灯織ちゃん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070130"
  },
  {
    "id": 4001025070140,
    "speaker": "灯織",
    "text": "──知らなかったね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070140"
  },
  {
    "id": 4001025070150,
    "speaker": "真乃",
    "text": "うん、知らなかった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070150"
  },
  {
    "textFrame": "off",
    "bg": "99999",
    "bgEffect": "white_add",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "textFrame": "off",
    "bg": "00158",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4001025070160,
    "speaker": "灯織",
    "text": "銀曜日──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070160"
  },
  {
    "id": 4001025070170,
    "speaker": "灯織",
    "text": "ってなんだっけ。どこかで聞いたことあるよね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070170"
  },
  {
    "id": 4001025070180,
    "speaker": "めぐる",
    "text": "あ、そうだね！　……なんだっけ……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070180"
  },
  {
    "id": 4001025070190,
    "speaker": "真乃",
    "text": "ほわ……あれ、なんだっけ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070190"
  },
  {
    "id": 4001025070200,
    "speaker": "めぐる",
    "text": "でも、なんだか……いいね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070200"
  },
  {
    "id": 4001025070210,
    "speaker": "めぐる",
    "text": "ちょっと素敵な響きだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070210"
  },
  {
    "id": 4001025070220,
    "speaker": "めぐる",
    "text": "どこにも無いけど、ありそうな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070220"
  },
  {
    "textFrame": "off",
    "bg": "99999",
    "bgEffect": "white_add",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "textFrame": "off",
    "bg": "00077",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4001025070230,
    "speaker": "めぐる",
    "text": "ピンク、紫、青……青紫……赤……うーん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070230"
  },
  {
    "id": 4001025070240,
    "speaker": "めぐる",
    "text": "ダメだ、数えきれないや",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070240"
  },
  {
    "id": 4001025070250,
    "speaker": "めぐる",
    "text": "くもりガラスの向こうにある色",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070250"
  },
  {
    "id": 4001025070260,
    "speaker": "めぐる",
    "text": "たくさんの色があるからさ、\r\n多分、アジサイの色だけじゃないような気がするんだよねー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070260"
  },
  {
    "id": 4001025070270,
    "speaker": "めぐる",
    "text": "きっと綺麗な庭なんだろうなー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070270"
  },
  {
    "id": 4001025070280,
    "speaker": "めぐる",
    "text": "見えそうで、見えない……だけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070280"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4001025070290,
    "speaker": "めぐる",
    "text": "見えたらいいな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400102507/4001025070290"
  },
  {
    "textFrame": "off",
    "bg": "99999",
