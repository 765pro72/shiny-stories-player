    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050670"
  },
  {
    "id": 4001076050680,
    "speaker": "夏葉",
    "text": "両チーム、渡されている脚本は同じなのよね？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050680"
  },
  {
    "id": 4001076050690,
    "speaker": "凛世",
    "text": "どう演出し……どう演じるかは……\r\nチームの自由……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050690"
  },
  {
    "id": 4001076050700,
    "speaker": "樹里",
    "text": "あかねなら、ここで相手を目立たせたい場合、どうする？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050700"
  },
  {
    "id": 4001076050710,
    "speaker": "あかね",
    "text": "他の役が捌けて声だけの演技をしている中、\r\n彼女だけが真ん中で大きく芝居を見せたりとか──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050710"
  },
  {
    "id": 4001076050720,
    "speaker": "智代子",
    "text": "実際のお客さんは劇場で見てるわけじゃなくて\r\n配信で見てるから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050720"
  },
  {
    "id": 4001076050730,
    "speaker": "智代子",
    "text": "撮り方とかも気を遣いたいよね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400107605/4001076050730"
  },
  {
    "id": 4001076050740,
