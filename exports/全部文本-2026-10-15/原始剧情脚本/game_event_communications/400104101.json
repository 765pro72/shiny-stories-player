    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、あれ……！\r\nありました、すみません！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001041010070,
    "speaker": "はづき",
    "text": "『いえ～、お疲れのところ申し訳ないんですが\r\n早めにお願いしますね～』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010070"
  },
  {
    "id": 4001041010080,
    "speaker": "はづき",
    "text": "『勤怠と経費申請と、契約書類も\r\nあると助かります～』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい……この後\r\n事務所で諸々確認して提出します……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001041010090,
    "speaker": "はづき",
    "text": "『了解しました\r\nそれじゃあお待ちしてますね～』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、お疲れ様です……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
