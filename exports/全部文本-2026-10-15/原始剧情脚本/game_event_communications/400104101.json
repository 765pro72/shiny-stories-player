  {
    "id": 4001041010010,
    "speaker": "はづき",
    "text": "『プロデューサーさん\r\nお疲れ様です～』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010010"
  },
  {
    "id": 4001041010020,
    "speaker": "はづき",
    "text": "『今日って事務所には戻られますか～？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……はい\r\nとりあえずこれから戻ろうかと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001041010030,
    "speaker": "はづき",
    "text": "『それはよかったです～』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010030"
  },
  {
    "id": 4001041010040,
    "speaker": "はづき",
    "text": "『ロケバスの車検用の書類、\r\n月内に出してくださいねって伝えたくて』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "え…………\r\nそれってもう出したような──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001041010050,
    "speaker": "はづき",
    "text": "『え～？\r\nお預かりしてませんよ～？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010050"
  },
  {
    "id": 4001041010060,
    "speaker": "はづき",
    "text": "『まだお持ちじゃないですか～？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104101/4001041010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
