  },
  {
    "id": 4001044040630,
    "speaker": "ツイスタの投稿",
    "text": "『先日２８３プロのチャンネルに\r\nアップロードした動画はご覧いただけましたか？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040630"
  },
  {
    "id": 4001044040640,
    "speaker": "ツイスタの投稿",
    "text": "『ぜひURLからチェックしてみてください』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040640"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044040650,
    "speaker": "ツイスタの投稿",
    "text": "『先日小糸から送られてきた写真を載せます』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040650"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044040660,
    "speaker": "ツイスタの投稿",
    "text": "『寒い日が続いているのでぬいぐるみに\r\nマフラーを貸してあげたそうです』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040660"
  },
  {
    "id": 4001044040670,
    "speaker": "ツイスタの投稿",
    "text": "『次の日、小糸はマフラーを忘れていました\r\nみなさんもお気をつけて』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040670"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4001044040680,
    "speaker": "ツイスタの投稿",
    "text": "『では明日の投稿もお楽しみに』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040680"
  },
  {
    "id": 4001044040690,
    "speaker": "ツイスタの投稿",
    "text": "『明日の担当は放課後クライマックスガールズ\r\n西城樹里さんです』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040690"
