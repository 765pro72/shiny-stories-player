  {
    "id": 4001044040620,
    "speaker": "ツイスタの投稿",
    "text": "『ノクチルの樋口です\r\n本日の担当になりました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "game_event_communications/400104404/4001044040620"
  },
  {
    "textFrame": "off",
