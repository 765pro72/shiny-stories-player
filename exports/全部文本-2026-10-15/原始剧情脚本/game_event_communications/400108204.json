    "voice": "game_event_communications/400108204/4001082040040"
  },
  {
    "speaker": "司会者",
    "text": "あさひちゃんは、特にダンスのキレ！\r\n中学生とは思えなかったよ",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0328"
  },
  {
    "id": 4001082040050,
    "speaker": "あさひ",
    "text": "おー……",
