    "voice": "game_event_communications/400108204/4001082040030"
  },
  {
    "speaker": "司会者",
    "text": "みんなのライブ映像、見せてもらったんだけど\r\n本当に決まってて、かっこいいんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001082040040,
    "speaker": "あさひ",
    "text": "そっすか",
    "charAnim1": "wait3",
