  {
    "speaker": "プロデューサー",
    "text": "（あれ？　この質問は\r\n聞かれる想定になかったよな……？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00269",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "司会者",
    "text": "もしかして、秘密にしてて\r\n誰にも言えない、とかかな？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001082040210,
    "speaker": "あさひ",
