  },
  {
    "id": 4001053010140,
    "speaker": "霧子",
    "text": "私も……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010140"
  },
  {
    "id": 4001053010150,
    "speaker": "霧子",
    "text": "すみません……\r\n調べておきます……",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010150"
  },
  {
    "speaker": "女性",
    "text": "……ふふ、ありがとうございます\r\nでも心配なさらないでください",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kiriko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "女性",
    "text": "今回、挑戦していただくのは、\r\n番組オリジナルの『怪物探し』というゲームになります",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女性",
    "text": "ルールブックを用意しておきますので、\r\nご安心ください",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 4001053010160,
    "speaker": "霧子",
    "text": "……！\r\nはい……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400105301/4001053010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "kiriko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0100",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "プロデューサー",
    "text": "……とまあ、資料にずらーっと書かかれているように、\r\nライブにちなんだ企画がたくさん走ることになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そこで、この一連の仕事が終わるまでの間、\r\nサポートに入ってくださるのが──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "女性",
    "text": "冒頭でもご挨拶させていただきましたが、\r\n……あらためまして",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女性",
    "text": "うりゅうと申します\r\n雨に竜と書いて、雨竜です",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雨竜",
    "text": "しばらく進行のお手伝いをさせていただくことになりました",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雨竜",
    "text": "アンティーカのみなさんとのお仕事、とってもうれしいです\r\nどうぞよろしくお願いいたします",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "charPosition": {
      "x": 796,
      "y": 640,
      "order": 2
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 4001053010170,
    "speaker": "恋鐘",
    "text": "よろしくばい～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 310,
      "y": 640,
      "order": 1
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "game_event_communications/400105301/4001053010170"
  },
  {
    "id": 4001053010180,
    "speaker": "咲耶",
    "text": "珍しい名字ですね\r\nそれにとても美しい",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010180"
  },
  {
    "charAnim2": "face_wait",
    "charLabel": "kogane"
  },
  {
    "speaker": "雨竜",
    "text": "ふふ、そんなことは……\r\nでもありがとうございます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_smile",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
