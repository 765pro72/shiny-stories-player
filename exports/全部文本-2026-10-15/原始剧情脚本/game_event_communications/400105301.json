    "waitTime": 1500
  },
  {
    "id": 4001053010220,
    "speaker": "咲耶",
    "text": "仮装の種類については──……ああ、すまない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010220"
  },
  {
    "id": 4001053010230,
    "speaker": "咲耶",
    "text": "『怪物の種類は問いません』\r\n『おひとりずつ、バラバラでお願いします』か",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4001053010240,
    "speaker": "摩美々",
    "text": "はぁい\r\nモンスターズクッキーは経費で落ちますかぁ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400105301/4001053010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……\r\nお、落ちるんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はづきさんに確認しておくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "雨竜",
    "text": "あ……\r\nではそれも私の方で",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ……あ、すみません……\r\nご、ご無理ありませんように……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "雨竜",
    "text": "いえいえ、これくらいはまだまだ……！\r\nぜんぜんです……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "た、助かります……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
