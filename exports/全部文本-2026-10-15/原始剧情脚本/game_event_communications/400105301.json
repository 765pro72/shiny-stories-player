  },
  {
    "speaker": "プロデューサー",
    "text": "現時点で何か質問はあるかな？\r\nあれば遠慮なく",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0100",
