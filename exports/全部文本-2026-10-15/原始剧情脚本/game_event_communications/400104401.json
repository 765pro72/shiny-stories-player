  {
    "id": 4001044010190,
    "speaker": "雛菜",
    "text": "それで\r\n雛菜、何を手伝うの～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400104401/4001044010190"
  },
  {
    "textFrame": "off",
