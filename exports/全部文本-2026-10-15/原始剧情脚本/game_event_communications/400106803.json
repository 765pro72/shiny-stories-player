    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 800
  },
  {
    "speaker": "ディレクター",
    "text": "ははは……！\r\n冗談です！　真に受けないでくださいよ～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "は、ははは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、彼女たちなら、きっと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
