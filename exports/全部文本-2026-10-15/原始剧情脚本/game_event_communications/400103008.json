  {
    "id": 4001030080150,
    "speaker": "甜花",
    "text": "ち、千雪さん……！　これ、ママから……\r\nあったかいの、飲んで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080150"
  },
  {
    "id": 4001030080160,
    "speaker": "千雪",
    "text": "ありがとう……！\r\nあれ、これもしかしてホットワイン……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080160"
  },
  {
    "id": 4001030080170,
    "speaker": "甘奈",
    "text": "あっ、そう！\r\n甘奈がお母さんに作ってもらったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080170"
  },
  {
    "id": 4001030080180,
    "speaker": "甘奈",
    "text": "今日の千雪さんは大崎家のゲストですから……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080180"
  },
  {
    "id": 4001030080190,
    "speaker": "千雪",
    "text": "わ……！　そんな……\r\n私のせいで遠出できなかったのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080190"
  },
  {
    "id": 4001030080200,
    "speaker": "千雪",
    "text": "えーん……\r\n明日、部屋のガス点検がなければ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080200"
  },
  {
    "id": 4001030080210,
    "speaker": "甘奈",
    "text": "ええっ、むしろ、\r\nうちにご招待でごめんなさい……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080210"
  },
  {
    "id": 4001030080220,
    "speaker": "甘奈",
    "text": "でも今日は『千雪さんにお礼する日』なので、\r\nささやかですが、めーっちゃ、おもてなしさせてください☆",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080220"
  },
  {
    "id": 4001030080230,
    "speaker": "甜花",
    "text": "うん……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080230"
  },
  {
    "id": 4001030080240,
    "speaker": "甜花",
    "text": "いっぱい、いっぱい、助かりました\r\nいっぱいありがと……千雪さん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "game_event_communications/400103008/4001030080240"
  },
