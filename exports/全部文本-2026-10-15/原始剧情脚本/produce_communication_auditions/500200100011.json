    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communication_auditions/500200100011/5002001000110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（良い刺激になったみたいだ\r\n灯織のやる気に、俺も応えていかないとな！）",
    "charLabel": "hiori",
