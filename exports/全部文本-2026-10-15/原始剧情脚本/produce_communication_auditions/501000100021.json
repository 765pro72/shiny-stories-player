  },
  {
    "id": 5010001000210030,
    "speaker": "智代子",
    "text": "そしたらきっと、みんな楽しんでくれますよね……！\r\n見てくれた人たち、喜んでくれますよね……！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
