    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102829/4901028290030"
  },
  {
    "id": 4901028290040,
    "speaker": "智代子",
    "text": "さすがにどうかなって思ったんですけど、\r\nでもやっぱりどれも食べていただきたくて！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
