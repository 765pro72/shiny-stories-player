    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102664/4901026640010"
  },
  {
    "id": 4901026640020,
    "speaker": "千雪",
    "text": "……なんて、私自身も\r\n手元を見るたびに幸せな気分になるんですけどね",
