  {
    "speaker": "プロデューサー",
    "text": "………………\r\n……バレンタインの時は、悪かったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901009120020,
    "speaker": "咲耶",
    "text": "え？",
    "charAnim1": "wait3",
