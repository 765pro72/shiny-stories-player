    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100912/4901009120040"
  },
  {
    "id": 4901009120050,
    "speaker": "咲耶",
    "text": "……クス、本当に……アナタは……",
    "charAnim1": "anger2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100912/4901009120050"
  },
  {
    "id": 4901009120060,
    "speaker": "咲耶",
    "text": "ああそうだよ、私の大切な人たちに対する想いは、\r\nどれひとつとして同じ形をしていないからね",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100912/4901009120060"
  },
  {
    "id": 4901009120070,
    "speaker": "咲耶",
    "text": "そしてアナタに渡したのは、\r\nアナタだけの特別品さ。──だから……",
    "charAnim1": "smile2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100912/4901009120070"
  },
  {
    "id": 4901009120080,
