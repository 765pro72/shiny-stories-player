    "voice": "special_communications/490103232/4901032320410"
  },
  {
    "id": 4901032320420,
    "speaker": "千雪",
    "text": "……あーあ、言っちゃった\r\n弟さんや妹さんも、これから大変なことになっちゃう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320420"
  },
  {
    "id": 4901032320430,
    "speaker": "愛依",
    "text": "隠そうとすれば、今回みたいに利用されるだけ……\r\nそう、弟や妹たちには教えるつもり",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320430"
  },
  {
    "id": 4901032320440,
    "speaker": "千雪",
