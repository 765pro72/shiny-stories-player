      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490103232/4901032320320"
  },
  {
    "id": 4901032320330,
    "speaker": "愛依",
    "text": "あの事件の犯人……うちの父さんなんだ……",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320330"
  },
  {
    "id": 4901032320340,
    "speaker": "愛依",
    "text": "けど、それを知ってるのは……\r\n母さんとお兄とお姉……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320340"
  },
  {
    "id": 4901032320350,
    "speaker": "愛依",
    "text": "それから『Ａ』だけ……",
    "charAnim1": "wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320350"
