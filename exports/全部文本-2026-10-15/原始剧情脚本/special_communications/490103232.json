    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 4901032320280,
    "speaker": "小糸",
    "text": "こ、凍らせたペットボトルを入れたバッグを持って\r\n『Ａ』の部屋に行ったなら……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320280"
  },
  {
    "id": 4901032320290,
    "speaker": "小糸",
    "text": "さ、最初から\r\n殺すつもりだったはず……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320290"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "bg": "00682",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032320300,
    "speaker": "千雪",
    "text": "いやね、小糸ちゃん\r\nそんな怖いこと、私にはできないな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320300"
  },
  {
    "id": 4901032320310,
    "speaker": "愛依",
    "text": "……できるっしょ……自分のために……\r\n簡単に人を利用できる……あんたには……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320310"
  },
  {
    "textFrame": "off",
    "bg": "00277",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032320320,
    "speaker": "愛依",
    "text": "……みんなさ……『アンダルシアの乙女強奪事件』って\r\n聞いたことあるっしょ？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030190010",
