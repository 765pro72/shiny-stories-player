  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "家族のみなさんが知ってるなら\r\n犯罪に手を染めてまで、ファイルを手に入れる必要は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032320360,
    "speaker": "愛依",
    "text": "──妹と弟がさ、いるんだよね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320360"
  },
  {
    "id": 4901032320370,
    "speaker": "愛依",
    "text": "まだ小さいふたりはそのこと知らないんだ……\r\nそんで……絶対に、知ってほしくなくて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320370"
  },
  {
    "id": 4901032320380,
    "speaker": "愛依",
    "text": "……だから真相ファイルがどうしても\r\n欲しかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103232/4901032320380"
  },
  {
