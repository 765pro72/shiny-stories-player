    },
    "voice": "special_communications/490170010/4901700100020"
  },
  {
    "speaker": "プロデューサー",
    "text": "カメラ……？\r\n珍しいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700100030,
