  },
  {
    "speaker": "プロデューサー",
    "text": "千雪……！？\r\n千雪こそ、どうしてこんな時間に事務所に……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901100640020,
    "speaker": "千雪",
    "text": "今日の撮影、機材トラブルで押しちゃって……",
    "charAnim1": "sad2",
