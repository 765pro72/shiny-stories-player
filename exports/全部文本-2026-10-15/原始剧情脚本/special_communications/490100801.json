    "voice": "special_communications/490100801/4901008010030"
  },
  {
    "id": 4901008010040,
    "speaker": "真乃",
    "text": "プロデューサーさんに、バレンタインのチョコの代わりに\r\nその……一緒に食べられたらなって思って……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
