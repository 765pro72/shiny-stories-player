  {
    "speaker": "プロデューサー",
    "text": "おはよう、サンタさん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901017280030,
    "speaker": "結華",
    "text": "あはは、さすがプロデューサー！\r\n気付くのが早い！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
