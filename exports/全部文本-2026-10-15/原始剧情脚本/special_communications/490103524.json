  },
  {
    "speaker": "プロデューサー",
    "text": "一番突拍子もないのはどれかって？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901035240040,
    "speaker": "咲耶",
    "text": "フフッ、そう",
