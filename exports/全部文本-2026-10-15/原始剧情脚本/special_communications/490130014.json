  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃあそうだろ\r\n結華と行きたいとこなんか山ほどあるし、スッと出るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901300140030,
    "speaker": "結華",
    "text": "……！\r\n山ほど──……？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
