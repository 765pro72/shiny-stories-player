  {
    "speaker": "プロデューサー",
    "text": "このあとお茶でもどうだ？\r\n甘いもの食べよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901300140010,
    "speaker": "結華",
