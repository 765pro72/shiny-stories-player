  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、ご名答。よければ今日は\r\n俺が見つけた店に連れていかせてくれないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901300140020,
    "speaker": "結華",
    "text": "え～？　スマートじゃーん",
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
