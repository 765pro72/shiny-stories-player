  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろん\r\nお返しには足りないくらいだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901029260030,
    "speaker": "夏葉",
