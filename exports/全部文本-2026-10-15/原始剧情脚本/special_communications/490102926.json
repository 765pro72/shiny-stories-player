  {
    "speaker": "プロデューサー",
    "text": "ああ、ホワイトデーだからさ\r\nいつもありがとな、夏葉",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901029260020,
    "speaker": "夏葉",
    "text": "…………！\r\nいいのかしら、貰ってしまって",
    "charAnim1": "surp1",
