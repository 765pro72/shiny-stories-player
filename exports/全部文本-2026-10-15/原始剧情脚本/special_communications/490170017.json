  {
    "id": 4901700170030,
    "speaker": "果穂",
    "text": "２８３プロは人がたくさんいるから、\r\nあたしもそうしたらだれかと同じのになっちゃうかもって",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170017/4901700170030"
  },
  {
    "id": 4901700170040,
    "speaker": "果穂",
    "text": "だから、あたししか選ばなそうなのにしました！",
