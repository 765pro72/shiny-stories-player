[
  {
    "speaker": "主人公",
    "text": "掃除でもしてみるか",
    "textCtrl": "p",
    "textFrame": "0023",
    "bg": "00332",
    "bgm": "0046"
  },
  {
    "speaker": "主人公",
    "text": "しばらく使われていなかったらしいからな\r\n──うわっ、棚の上がホコリだらけ……",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "textFrame": "off",
