  },
  {
    "speaker": "主人公",
    "text": "えっと、そうですね……",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "ほうじ茶とか……",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011110130,
    "speaker": "はづき",
    "text": "わあ、それはよかったです\r\n持ってきたのほうじ茶なんですよ～",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
