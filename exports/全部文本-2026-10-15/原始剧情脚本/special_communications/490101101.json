  },
  {
    "id": 4901011010450,
    "speaker": "はづき",
    "text": "私、教師の七草はづきといいます\r\nこれからよろしくお願いしますね♪",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
    "voice": "special_communications/490101101/4901011010450"
  },
  {
    "speaker": "主人公",
    "text": "はい、よろしくお願いします！",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011010460,
    "speaker": "はづき",
    "text": "先生の到着が遅いので心配していたんですよ～",
    "charAnim1": "wait1",
