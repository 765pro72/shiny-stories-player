  {
    "speaker": "女生徒",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "主人公",
    "text": "（あ、あれ……？　無視されてしまった……\r\nもしかして、聞こえなかったかな……）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "女生徒",
    "text": "……ねぇ、もしかしてあの人……",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "女生徒",
    "text": "うん、多分……",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "主人公",
    "text": "あの！\r\nおはよう！",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "女生徒",
    "text": "ひぃ……！",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "女生徒",
    "text": "ごめんなさい……！",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "主人公",
    "text": "あ、ちょっと……！",
