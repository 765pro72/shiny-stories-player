  },
  {
    "speaker": "女生徒",
    "text": "あら、ごきげんよう\r\n今日もいいお天気ですわね",
    "textCtrl": "p",
    "textFrame": "0024"
  },
  {
    "speaker": "主人公",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "（ここが、今日から俺が勤める２８３女学院か……）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "（全寮制だけあって、敷地も広いし\r\n校舎自体もすごく大きい……）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "（噂には聞いていたが、実際に見てみると\r\n想像以上に華やかな場所だな……）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "（これから、上手くやっていけるんだろうか……）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "speaker": "主人公",
    "text": "（……いや！　最初からこんな気持ちじゃダメだ！\r\n自分から動いていかないと……！）",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
