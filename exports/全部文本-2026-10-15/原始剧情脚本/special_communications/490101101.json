    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
    "voice": "special_communications/490101101/4901011010460"
  },
  {
    "speaker": "主人公",
    "text": "すみません……\r\n少し、道に迷ってしまって……",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011010470,
    "speaker": "はづき",
    "text": "ああ～、まだ資料をお渡ししてなかったですもんね……\r\n大丈夫でしたか？",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
    "voice": "special_communications/490101101/4901011010470"
  },
  {
    "speaker": "主人公",
    "text": "ええ、生徒に道を教えてもらいまして……！",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011010480,
    "speaker": "はづき",
    "text": "わぁ……\r\nもう生徒のみなさんと仲良くなれたんですね♪",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
    "voice": "special_communications/490101101/4901011010480"
  },
  {
    "speaker": "主人公",
    "text": "ああ、いえいえ……ほんの少し話しただけです",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011010490,
    "speaker": "はづき",
    "text": "それでもすごいですよ～\r\nこれから、もっと色々なお話をしてあげてください",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "0024",
    "voice": "special_communications/490101101/4901011010490"
  },
  {
    "speaker": "主人公",
    "text": "……はい！",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011010500,
    "speaker": "はづき",
    "text": "それじゃあ、さっそくですが\r\nこれからのお仕事について説明させてもらいますね",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
