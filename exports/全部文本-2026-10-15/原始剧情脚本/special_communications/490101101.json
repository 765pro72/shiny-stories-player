  },
  {
    "id": 4901011010140,
    "speaker": "結華",
    "text": "ビックリしたー……\r\nお兄さん、元気いいね？",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
