  },
  {
    "id": 4901019120040,
    "speaker": "咲耶",
    "text": "見てわかるだろう？\r\n私は今、こんなにも満たされている",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
