    "waitTime": 2000
  },
  {
    "id": 4901032090030,
    "speaker": "咲耶",
    "text": "この部屋からも遺体からも\r\n『アレ』が見つからないのが気になるし……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103209/4901032090030"
  },
  {
    "id": 4901032090040,
    "speaker": "摩美々",
    "text": "『アレ』ねー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103209/4901032090040"
  },
  {
    "speaker": "弟子",
    "text": "アレって……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "ファイルのことですか？",
    "nextLabel": "1"
  },
  {
    "select": "凶器のことですか？",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "鍵のことですか？",
    "nextLabel": "3"
  },
  {
    "id": 4901032090050,
    "label": "1",
    "speaker": "恋鐘",
    "text": "うん～、そいも気になるけど、\r\nうちらが気になっとるのは『鍵』ばい",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "special_communications/490103209/4901032090050"
  },
  {
    "id": 4901032090060,
    "label": "2",
    "speaker": "咲耶",
    "text": "確かに凶器が見つかれば\r\n犯人に近付けるかもしれない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103209/4901032090060"
  },
  {
    "id": 4901032090070,
    "speaker": "咲耶",
    "text": "でも、私たちが気になっているのは『鍵』だ\r\nそうだよね、みんな？",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "special_communications/490103209/4901032090070"
  },
  {
    "label": "3",
