  {
    "id": 4901032090010,
    "speaker": "霧子",
    "text": "現場の調査は、こんなところでしょうか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103209/4901032090010"
  },
  {
    "id": 4901032090020,
    "speaker": "咲耶",
    "text": "そうだね",
    "textCtrl": "p",
