    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490101805/4901018050010"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、悪いな\r\nありがとう……こっちは？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "se": "0177",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off"
  },
  {
    "id": 4901018050020,
    "speaker": "灯織",
    "text": "今お出ししたのと同じものなんですけど……\r\nチョコレートスプーンです",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490101805/4901018050020"
  },
  {
    "id": 4901018050030,
    "speaker": "灯織",
    "text": "ええと、その……バレンタインです\r\nいつもありがとうございます、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101805/4901018050030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、もうそんな時期か……！\r\nどっちももらっちゃっていいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901018050040,
    "speaker": "灯織",
    "text": "実は……\r\nお出ししたのは成形が上手くいかなかったものなんです",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101805/4901018050040"
  },
  {
    "id": 4901018050050,
    "speaker": "灯織",
    "text": "そんなものを出すなという話なんですけど\r\nプロデューサーのために作ったのに、自分で飲むのは……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101805/4901018050050"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな\r\nじゃあ、両方ありがたくいただいちゃうよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901018050060,
    "speaker": "灯織",
    "text": "味は大丈夫なはずなので……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101805/4901018050060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、そこの心配はしてないからな？\r\nありがとう、大事に飲むよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
