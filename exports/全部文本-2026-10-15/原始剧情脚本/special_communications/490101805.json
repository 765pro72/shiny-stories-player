  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901018050010,
    "speaker": "灯織",
    "text": "お疲れ様です、プロデューサー\r\n休憩にホットチョコレートどうぞ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
