    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011130081,
    "speaker": "真乃＆主人公",
    "text": "ふふっ……",
