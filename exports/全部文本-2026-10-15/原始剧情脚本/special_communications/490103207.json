  {
    "id": 4901032070060,
    "speaker": "あさひ",
    "text": "あっ、そのデータも欲しいっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070060"
  },
  {
    "id": 4901032070070,
    "speaker": "雛菜",
    "text": "ん～？\r\nはい、いいですよ～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070070"
  },
  {
    "id": 4901032070080,
    "speaker": "千雪",
    "text": "データを集めて犯人を捜すの、とってもいいと思う……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070080"
  },
  {
    "id": 4901032070090,
    "speaker": "千雪",
    "text": "ただ、死亡推定時刻の偽装トリックには\r\n気をつけたい、かな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070090"
  },
  {
    "id": 4901032070100,
    "speaker": "甘奈",
    "text": "甘奈が前に関わった事件でも\r\nそういうのあったよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070100"
  },
  {
    "id": 4901032070110,
    "speaker": "甘奈",
    "text": "遺体を氷で冷やして\r\n死亡推定時刻を実際より前に誤認させる、って",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070110"
  },
  {
    "id": 4901032070120,
    "speaker": "甜花",
    "text": "……冷やす、か……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070120"
  },
  {
    "id": 4901032070130,
    "speaker": "冬優子",
    "text": "すみませーん……！\r\n誰か、行動表書くのを手伝ってもらえますかー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070130"
  },
  {
    "id": 4901032070140,
    "speaker": "甘奈",
    "text": "あ、はーい！\r\n甜花ちゃん、千雪さん、行こう？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070140"
  },
  {
    "id": 4901032070150,
    "speaker": "咲耶",
    "text": "それじゃあ、私たちも現場に向かおう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070150"
  },
  {
    "id": 4901032070160,
    "speaker": "咲耶",
    "text": "お弟子さん、案内を頼むよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103207/4901032070160"
  },
  {
    "speaker": "弟子",
    "text": "承りました、こちらです──",
    "textCtrl": "p",
    "textFrame": "002"
