  {
    "id": 4901026840021,
    "speaker": "円香＆プロデューサー",
    "text": "『クリスマスプレゼント、ありがとう』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "054",
    "voice": "special_communications/490102684/4901026840021"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ…………\r\nはは、用件はバレバレか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026840030,
    "speaker": "円香",
    "text": "『そうですね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102684/4901026840030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん……今、事務所に戻ってきて──\r\nデスクに置かれていたのを見つけたところでさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0177",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "これは……ワックスか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "プロデューサー",
    "text": "よーし、これで毛先を遊ばせて、\r\n俺もいけてるメンズに大変身だ──！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026840040,
    "speaker": "円香",
    "text": "『……え？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102684/4901026840040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なんて冗談だよ\r\nでもちょうど整髪剤が欲しかったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "円香",
    "text": "『……』",
    "textCtrl": "p",
    "textFrame": "001",
    "autoWaitTime": 1500
  },
  {
    "textFrame": "off",
