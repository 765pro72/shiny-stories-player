  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとう\r\n遠慮なく使わせてもらうよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
