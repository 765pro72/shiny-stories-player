    "textFrame": "001",
    "voice": "special_communications/490101736/4901017360090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　果穂が赤じゃないんだな\r\nジャスティスレッドの色を選ぶと思ってたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
