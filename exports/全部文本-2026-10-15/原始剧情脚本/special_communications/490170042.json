    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170042/4901700420070"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん。円香がこの道を歩きたいと思ううちは\r\n勝手に隣を歩くんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
