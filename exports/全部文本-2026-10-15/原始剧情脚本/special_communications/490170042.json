  {
    "charLabel": "madoka",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "だけど\r\n隣にいてくれるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700420070,
    "speaker": "円香",
    "text": "あなたが勝手に隣を歩こうとしてくるから\r\nいちいち避けるのも疲れたので",
