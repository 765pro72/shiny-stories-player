  },
  {
    "id": 4901700420050,
    "speaker": "円香",
    "text": "……あなたのことは中身を知ったうえで\r\n大嫌い",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170042/4901700420050"
  },
  {
    "speaker": "プロデューサー",
    "text": "大まで付いてるのかー",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700420060,
    "speaker": "円香",
    "text": "そう、大嫌い",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
