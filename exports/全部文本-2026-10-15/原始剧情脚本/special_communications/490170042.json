    "voice": "special_communications/490170042/4901700420010"
  },
  {
    "id": 4901700420020,
    "speaker": "円香",
    "text": "好きにはなれませんでしたが",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170042/4901700420020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか\r\n感じのいい人だと思ったけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700420030,
    "speaker": "円香",
    "text": "そんな表面的なことで言ってない",
