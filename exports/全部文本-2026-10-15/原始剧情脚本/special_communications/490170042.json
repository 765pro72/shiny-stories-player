    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170042/4901700420030"
  },
  {
    "id": 4901700420040,
    "speaker": "円香",
    "text": "あなたも感じのいい人でしたが\r\nそれだけの人だったなら",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
