  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901007280010,
    "speaker": "結華",
    "text": "『…………はい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ結華！\r\nクリスマスプレゼント、受け取ったよ！　ありがとうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901007280020,
    "speaker": "結華",
    "text": "『……いいえー\r\nたいしたものも用意できませんで』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280020"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことはないよ\r\n……でも、カードっていうのは確かに意外だった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "正直、結華からこういうものもらえるとは\r\n思ってなかったからさ。すごく嬉しい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901007280030,
    "speaker": "結華",
    "text": "『～～……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……結華？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901007280040,
    "speaker": "結華",
    "text": "『……ああもう……！　全部言っちゃうし……！\r\n──いいですかＰたん！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280040"
  },
  {
    "speaker": "プロデューサー",
    "text": "は、はい！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901007280050,
    "speaker": "結華",
    "text": "『三峰がなぜ何も言わずにカードだけ置いて帰ったかを\r\nちょっとでも考えましたか！？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280050"
  },
  {
    "id": 4901007280060,
    "speaker": "結華",
    "text": "『Ｐたんも思った通り、ガラにもないことしたんです、\r\nだから恥ずかしいんです、おっけー！？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280060"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おっけー……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901007280070,
    "speaker": "結華",
    "text": "『それをわざわざっ、電話までして……！\r\n明日とかに言ってくれればいいのに……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ご、ごめん……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901007280080,
    "speaker": "結華",
    "text": "『嬉しいんだから謝んないでよ\r\n……こちらこそ、やつあたり失礼しました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280080"
  },
  {
    "id": 4901007280090,
    "speaker": "結華",
    "text": "『……まぁ、うん、そういうわけだから\r\n何はともあれメリークリスマス……です』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100728/4901007280090"
  },
