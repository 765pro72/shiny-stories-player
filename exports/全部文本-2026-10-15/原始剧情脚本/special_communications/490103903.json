  {
    "speaker": "同僚マネージャー",
    "text": "──────っと！？",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1273"
  },
  {
    "speaker": "マネージャー",
    "text": "……！\r\nご、ごめんなさい……失礼しました、急いでいて……！",
    "textCtrl": "p",
    "textFrame": "003",
