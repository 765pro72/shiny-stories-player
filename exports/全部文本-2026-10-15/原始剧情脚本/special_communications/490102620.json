    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102620/4901026200020"
  },
  {
    "id": 4901026200030,
    "speaker": "摩美々",
    "text": "そしたら\r\nみんなで鍋パーティーとか、できますしー",
