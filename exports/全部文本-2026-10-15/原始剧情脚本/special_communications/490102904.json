  {
    "id": 4901029040020,
    "speaker": "灯織",
    "text": "なんというか、珍しいですね……？",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102904/4901029040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織がおせんべいをくれたからさ\r\n俺も定番以外で考えてみたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "暖かい時期には難しい食べ物だから、\r\n今かなと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901029040030,
    "speaker": "灯織",
    "text": "ああ……なるほど、確かに\r\n溶けちゃいますもんね",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102904/4901029040030"
  },
  {
    "id": 4901029040040,
    "speaker": "灯織",
    "text": "風味も変わってしまいますし",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102904/4901029040040"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nだから、俺なりに美味しいと思ったものにしてみた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織の口にも合うといいんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901029040050,
    "speaker": "灯織",
    "text": "プロデューサー、私の味付けの料理が平気ですし\r\n逆も問題ないと思いますよ",
