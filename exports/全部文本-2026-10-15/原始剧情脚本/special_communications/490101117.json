    "voice": "special_communications/490101117/4901011170080"
  },
  {
    "speaker": "主人公",
    "text": "…………",
    "charAnim2": "face_sad",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011170081,
    "speaker": "あさひ＆主人公",
    "text": "ふふっ……",
