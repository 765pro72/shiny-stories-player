  },
  {
    "speaker": "主人公",
    "text": "……僕たちはずっと勘違いしていたのかもしれないな",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "0023"
  },
  {
    "id": 4901011170090,
