    "charId": "1040020020",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490170004/4901700040010"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいものが見つかってよかった\r\nきっと、撮影チームのみなさんも喜んでくれるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700040020,
    "speaker": "灯織",
    "text": "はい\r\n撮影の日はちょうどクリスマスですし──",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040020"
  },
  {
    "id": 4901700040030,
    "speaker": "灯織",
    "text": "この差し入れがちょっとしたサプライズに\r\nなれば嬉しいです",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040030"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな\r\n忙しいのに気を遣ってくれてありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700040040,
    "speaker": "灯織",
    "text": "いえ──というか、私よりプロデューサーの方が\r\n忙しいですよね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040040"
  },
  {
    "id": 4901700040050,
    "speaker": "灯織",
    "text": "ここ最近、ほとんど休んでいないようですし……\r\nあまり無理しないでくださいね",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "休める時は、休んでいるから大丈夫だぞ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに灯織をはじめ、みんなが活躍してくれてるから\r\n俺も頑張りたくてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700040060,
    "speaker": "灯織",
    "text": "そう、ですか────",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040060"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2200
  },
  {
    "charAnim1": "wait",
