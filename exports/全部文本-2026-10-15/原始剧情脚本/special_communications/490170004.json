  {
    "id": 4901700040090,
    "speaker": "灯織",
    "text": "ふふっ……",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
