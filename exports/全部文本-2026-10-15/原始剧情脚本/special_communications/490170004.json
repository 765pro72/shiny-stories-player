  {
    "id": 4901700040010,
    "speaker": "灯織",
    "text": "付き合っていただき、ありがとうございました",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
