    },
    "voice": "special_communications/490170004/4901700040090"
  },
  {
    "id": 4901700040100,
    "speaker": "灯織",
    "text": "撮影チームより先に、プロデューサーへの\r\nクリスマスプレゼントになってしまいましたね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは\r\nなんだか申し訳ないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700040110,
    "speaker": "灯織",
    "text": "いえ、気にしないでください\r\nそして、せっかくなので……",
