  },
  {
    "id": 4901700040070,
    "speaker": "灯織",
    "text": "……これ、１つどうぞ",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490170004/4901700040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ、いいのか？\r\nせっかくの差し入れなのに……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700040080,
    "speaker": "灯織",
    "text": "はい、多めに買ったので\r\n忙しくても、このお菓子とか、何かお腹にいれてくださいね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170004/4901700040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、わかった\r\nありがとな、灯織……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close",
