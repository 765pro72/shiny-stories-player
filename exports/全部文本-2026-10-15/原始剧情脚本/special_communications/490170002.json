  {
    "id": 4901700020010,
    "speaker": "真乃",
    "text": "プロデューサーさん\r\n連れてきてくださってありがとうございます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020010"
  },
  {
    "textFrame": "off",
    "bg": "00049",
