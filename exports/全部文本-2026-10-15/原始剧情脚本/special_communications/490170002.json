    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、こちらこそ\r\nいい機会だよ",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "idols",
    "charId": "1040010040",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "クリスマス近くの時期に\r\nハイキングをするのもさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700020020,
    "speaker": "真乃",
    "text": "はい……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020020"
  },
  {
    "id": 4901700020030,
    "speaker": "真乃",
    "text": "ですが、お忙しいかなって思っていたので……\r\n大丈夫でしたか……？",
    "charAnim1": "think",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、スケジュールとかは問題ない\r\nそれに……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これも真乃の仕事に関わることだから\r\nもし何かあっても、なんとか調整したさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700020040,
    "speaker": "真乃",
    "text": "えっと……\r\n……ありがとうございます……",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020040"
  },
  {
    "id": 4901700020050,
    "speaker": "真乃",
    "text": "あの……\r\nお疲れでは、なかったでしょうか……？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。むしろ\r\nいい気分転換になるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700020060,
    "speaker": "真乃",
    "text": "そうなんですね……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "本番でうまくいくように\r\nそして今日は今日で楽しみながらの予行練習だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700020070,
    "speaker": "真乃",
    "text": "はい、よろしくお願いします……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "実はさ、ベタかもしれないんだけど\r\nコーヒーセットを持ってきたんだ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "山頂に着いたら\r\nごちそうするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700020080,
    "speaker": "真乃",
    "text": "ほわ、ありがとうございます……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170002/4901700020080"
  },
  {
