  {
    "id": 4901032080010,
    "speaker": "結華",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040070010",
    "charPosition": {
      "x": 568,
