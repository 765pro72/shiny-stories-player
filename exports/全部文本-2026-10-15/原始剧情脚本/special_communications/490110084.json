  {
    "id": 4901100840010,
    "speaker": "円香",
    "text": "はい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490110084/4901100840010"
  },
  {
    "speaker": "プロデューサー",
    "text": "『お疲れ様！\r\n急に連絡して悪いな、そんなに時間は取らせないから』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901100840020,
    "speaker": "円香",
    "text": "……律儀にお礼の電話、ありがとうございます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490110084/4901100840020"
  },
  {
    "speaker": "プロデューサー",
    "text": "『はは、やっぱりバレてたか\r\nだけど言わせてくれ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『メリークリスマス、円香！\r\nクリスマスプレゼントありがとう』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901100840030,
    "speaker": "円香",
    "text": "いえ\r\nたいしたものではありませんので",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490110084/4901100840030"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901100840040,
    "speaker": "円香",
    "text": "……いま、事務所にいるんですね\r\nお疲れ様です",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490110084/4901100840040"
  },
  {
    "speaker": "プロデューサー",
    "text": "『バレバレだな\r\nいまプレゼントを開けてるよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00002",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 1200
  },
  {
