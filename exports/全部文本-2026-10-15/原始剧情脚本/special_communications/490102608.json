  {
    "speaker": "プロデューサー",
    "text": "──お\r\nインスタントコーヒー？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080010,
    "speaker": "灯織",
    "text": "はい\r\nブラックがないんです、それ",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040020040",
    "charPosition": {
