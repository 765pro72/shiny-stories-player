      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490102608/4901026080010"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？\r\n……本当だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080020,
    "speaker": "灯織",
    "text": "王道のミルク入りやカフェオレ、カフェラテはもちろん\r\nちょっと珍しい味なんかも入っています",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080020"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……！\r\nブラックがない理由って何かあるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういう詰め合わせだと\r\nだいたい入ってるものだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_angry_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901026080030,
    "speaker": "灯織",
    "text": "プロデューサー、\r\n本当に自分には無頓着ですよね",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080040,
    "speaker": "灯織",
    "text": "クリスマスプレゼントなのに、\r\nブラックなんて渡しません",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080040"
  },
  {
    "id": 4901026080050,
    "speaker": "灯織",
    "text": "だって、プロデューサーが\r\n仕事の時によく飲んでいるものですよ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん？　うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080060,
    "speaker": "灯織",
    "text": "ええ……？　まだわからないですか？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080060"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ、わかるものなのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080070,
    "speaker": "灯織",
    "text": "……これはボケで、\r\n本当はツッコミ待ち、とか──",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026080080,
    "speaker": "灯織",
    "text": "いえ、なんでもありません",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080080"
  },
  {
    "id": 4901026080090,
    "speaker": "灯織",
    "text": "ブラックは、事務所にも、\r\nプロデューサーの家にもあるでしょうから",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102608/4901026080090"
  },
  {
    "id": 4901026080100,
    "speaker": "灯織",
    "text": "それを飲んでいる時間くらいは\r\n仕事から離れてほしかっただけですよ",
