  },
  {
    "speaker": "プロデューサー",
    "text": "ほらあっちの──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700200020,
    "speaker": "智代子",
    "text": "わーっ、ほんとだ！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200020"
  },
  {
    "id": 4901700200030,
    "speaker": "智代子",
    "text": "今度入れ替えちゃおっかなぁ",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、さすがに本物とオーナメントは\r\nわかるんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700200040,
    "speaker": "智代子",
    "text": "え～？　そうですか～？",
    "charAnim1": "sad1",
    "charAnim2": "face_anger3",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200040"
  },
  {
    "id": 4901700200050,
    "speaker": "智代子",
    "text": "そんなこと言って、\r\nプロデューサーさんが一番気づかなかったり",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200050"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ確かに一回飾ったら\r\n注意深く見直すことなんてしないしな──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ってこらこら\r\n俺をなんだと思ってるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700200051,
    "speaker": "智代子＆プロデューサー",
    "text": "──ははっ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200051"
  },
  {
    "speaker": "プロデューサー",
    "text": "下手なノリツッコミまでしちゃったよ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700200060,
    "speaker": "智代子",
    "text": "下手じゃないです！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200060"
  },
  {
    "id": 4901700200070,
    "speaker": "智代子",
    "text": "よーし、じゃあちょこっとお待ちくださいね！\r\n買ってきます！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170020/4901700200070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え！？\r\n本気でやるつもりか！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700200080,
    "speaker": "智代子",
    "text": "違いますよ！",
    "charAnim2": "face_shy2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
