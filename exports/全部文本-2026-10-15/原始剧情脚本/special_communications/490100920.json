  },
  {
    "speaker": "プロデューサー",
    "text": "おう、喜んでもらえてよかったよ\r\nここのシュークリーム、クリームたっぷりでさ",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつもこぼしそうになるんだけど、智代子も気を付け──\r\nって……まったく危なげがない……！",
    "charAnim1": "wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 4901009200020,
    "speaker": "智代子",
    "text": "えへへ、それは任せてください！　得意分野です！\r\nせっかくの贈り物ですから、大事に食べてますよ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490100920/4901009200020"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか。ありがとう──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyoko",
    "textFrame": "off",
