  },
  {
    "speaker": "プロデューサー",
    "text": "かなりリアルだよな\r\n俺も、言われないとわからないって思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901300380020,
    "speaker": "愛依",
    "text": "マジでそれ～！\r\nいやー、ちょーよくできてるわ～",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
