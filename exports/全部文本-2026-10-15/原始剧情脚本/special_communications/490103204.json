  {
    "id": 4901032040340,
    "speaker": "『Ａ』",
    "text": "……みないい表情をしている",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040340"
  },
  {
    "id": 4901032040350,
    "speaker": "『Ａ』",
    "text": "この中から、私の後継者たる輝きを持つ人間を選ぶのは\r\nありふれた方法では難しそうだ",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040350"
  },
  {
    "id": 4901032040360,
    "speaker": "『Ａ』",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040360"
  },
  {
    "id": 4901032040370,
    "speaker": "『Ａ』",
    "text": "そこで、早速ひとつ依頼したい",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040370"
  },
  {
    "id": 4901032040380,
    "speaker": "『Ａ』",
    "text": "前提として────\r\n君たちが食べた夕食には、致死性の毒が入っている",
    "textCtrl": "p",
    "textFrame": "004",
    "bgm": "095",
    "voice": "special_communications/490103204/4901032040380"
  },
  {
    "id": 4901032040381,
    "speaker": "探偵たち",
    "text": "…………！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040381"
  },
  {
    "id": 4901032040390,
    "speaker": "『Ａ』",
    "text": "まあ、落ちついて話を聞きたまえ",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040390"
  },
  {
    "id": 4901032040400,
    "speaker": "『Ａ』",
    "text": "いかなる時も冷静であることは\r\n探偵に求められる資質のひとつではないか？",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040400"
  },
  {
    "textFrame": "off",
    "bg": "00198",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032040410,
    "speaker": "『Ａ』",
    "text": "……むろん、解毒剤は用意してある",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040410"
  },
  {
    "id": 4901032040420,
    "speaker": "『Ａ』",
    "text": "諸氏においては、\r\n明日の19時までにそれを摂取されたし",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040420"
  },
  {
    "textFrame": "off",
    "bg": "00731",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032040430,
    "speaker": "『Ａ』",
    "text": "解毒剤は私の部屋の金庫にあり……",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040430"
  },
  {
    "textFrame": "off",
    "bg": "00732",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032040440,
    "speaker": "『Ａ』",
    "text": "金庫の鍵は、本棟のマスターキーと共に\r\nこの胸ポケットの中にある",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040440"
  },
  {
    "id": 4901032040450,
    "speaker": "『Ａ』",
    "text": "……あいにくと\r\nこれらの鍵は１つずつしか用意がなくてね",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040450"
  },
  {
    "textFrame": "off",
    "se": "0773",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 4901032040460,
    "speaker": "『Ａ』",
    "text": "私から鍵を奪い、いち早く金庫を開けた者を──",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040460"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901032040470,
    "speaker": "『Ａ』",
    "text": "私の後継者としようと思う",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040470"
  },
  {
    "textFrame": "off",
    "bg": "00225",
    "bgEffect": "fade",
    "bgEffectTime": 300,
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 4901032040480,
    "speaker": "樹里",
    "text": "はぁあ……？　ふざけるな！\r\nアタシは乗らねーぞ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040480"
  },
  {
    "id": 4901032040490,
    "speaker": "樹里",
    "text": "みんなも帰ろうぜ！\r\nこんな茶番つきあってられねー……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040490"
  },
  {
    "id": 4901032040500,
    "speaker": "『Ａ』",
    "text": "……茶番であればお帰り願えるのだが────",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040500"
  },
