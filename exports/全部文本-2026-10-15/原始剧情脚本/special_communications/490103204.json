    "voice": "special_communications/490103204/4901032040270"
  },
  {
    "id": 4901032040280,
    "speaker": "恋鐘",
    "text": "どれもばりうまかったけど、\r\nこんハーブの入ったたれだけ、材料がわからんかったと",
    "textCtrl": "p",
