    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040010"
  },
  {
    "id": 4901032040020,
    "speaker": "甘奈",
    "text": "ちなみに……\r\nこれってメインディッシュかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040020"
  },
  {
    "id": 4901032040030,
    "speaker": "甘奈",
    "text": "『Ａ』さんも同席してくれるなら\r\n食べ終わっちゃうとよくないかなって思って",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040030"
  },
  {
    "speaker": "弟子",
    "text": "それは──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "waitType": "time",
