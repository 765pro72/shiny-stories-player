    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040510"
  },
  {
    "id": 4901032040520,
    "speaker": "『Ａ』",
    "text": "確認してくるといい",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040520"
  },
  {
    "id": 4901032040530,
    "speaker": "『Ａ』",
    "text": "現時点をもって、電話やネットの類も使用不可能だ",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040530"
  },
  {
    "id": 4901032040540,
    "speaker": "夏葉",
    "text": "…………！\r\n人命を賭けて遊ぶなんて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040540"
  },
  {
    "id": 4901032040550,
    "speaker": "夏葉",
    "text": "許せないわ\r\nお弟子さん、『Ａ』の部屋に今すぐ案内して",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103204/4901032040550"
  },
  {
    "id": 4901032040560,
    "speaker": "『Ａ』",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040560"
  },
  {
    "id": 4901032040570,
    "speaker": "『Ａ』",
    "text": "彼もまた後継者候補でね",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "special_communications/490103204/4901032040570"
  },
  {
    "id": 4901032040580,
    "speaker": "『Ａ』",
    "text": "君たち以上の情報は持ち合わせていない",
    "textCtrl": "p",
