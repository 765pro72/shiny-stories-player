  },
  {
    "id": 4901032120030,
    "speaker": "果穂",
    "text": "夕食会の前に、\r\nあたしが足を怪我したから……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120030"
  },
  {
    "id": 4901032120040,
    "speaker": "恋鐘",
    "text": "そがんことがあったんやね……\r\n薬は見つけられたと？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
