    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032120060,
    "speaker": "霧子",
    "text": "お弟子さんに声をかけようかと思ったんですけど、\r\nちょうど入れ違ってたみたいで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120060"
  },
  {
    "id": 4901032120070,
    "speaker": "果穂",
    "text": "幽谷さんは、あたしが熱を出すかもって\r\n毛布を持ってきて、ずっと一緒にいてくれました！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120070"
  },
  {
    "id": 4901032120080,
    "speaker": "果穂",
    "text": "犯行時刻がそっちだったら\r\n幽谷さんのアリバイを証言できたのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120080"
  },
  {
    "id": 4901032120090,
    "speaker": "円香",
    "text": "……浅倉は？\r\nその時間、何してたの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120090"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 4901032120100,
    "speaker": "透",
    "text": "んー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120100"
  },
  {
    "id": 4901032120110,
    "speaker": "円香",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120110"
  },
  {
    "id": 4901032120120,
    "speaker": "円香",
    "text": "じゃ、アリバイなしってことで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120120"
  },
  {
    "id": 4901032120130,
    "speaker": "千雪",
    "text": "私は台所で、お菓子をつくっていました\r\n伝わるかどうかわからないんですけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120130"
  },
  {
    "id": 4901032120140,
    "speaker": "千雪",
    "text": "解毒剤を飲まないと死ぬって言われて、私──\r\n実感ないのに、ショックだけはあって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120140"
  },
  {
    "id": 4901032120150,
    "speaker": "智代子",
    "text": "わかります……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120150"
  },
  {
    "id": 4901032120160,
    "speaker": "千雪",
    "text": "気がついたら、キッチンでクッキーを焼いていたんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120160"
  },
  {
    "id": 4901032120170,
    "speaker": "甜花",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120170"
  },
  {
    "id": 4901032120180,
    "speaker": "甜花",
    "text": "甜花……そのクッキー……\r\n千雪さんに、わけてもらった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120180"
  },
  {
    "id": 4901032120190,
    "speaker": "甘奈",
    "text": "焼き上がるまで一緒にいたら、\r\n千雪さんのアリバイ、ちゃんと立証できたのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120190"
  },
  {
    "id": 4901032120200,
    "speaker": "千雪",
    "text": "ありがとう、甘奈ちゃん、甜花ちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120200"
  },
  {
    "textFrame": "off",
    "bg": "00277",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "弟子",
    "text": "あまりこういうことは言いたくないのですが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "アリバイのない７人を\r\n１人で行動させないようにした方がいいでしょう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00684",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032120210,
    "speaker": "千雪",
    "text": "それぞれのお部屋や、所持品も……\r\n初対面の人同士で調べあった方がよさそうです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120210"
  },
  {
    "id": 4901032120220,
    "speaker": "夏葉",
    "text": "……そうね\r\nどちらも妥当な判断だと思うわ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120220"
  },
  {
    "id": 4901032120230,
    "speaker": "夏葉",
    "text": "でも、私もそろそろ調査に向かいたいの\r\n真犯人を見つけて、無実を証明するためにもね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120230"
  },
  {
    "id": 4901032120240,
    "speaker": "智代子",
    "text": "お部屋と所持品の確認が終わったら、\r\nみんなで手分けして色々調べましょう！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103212/4901032120240"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgm": "fade_out",
    "se": "1082",
    "waitType": "time",
    "waitTime": 2700
  },
  {
    "textFrame": "off",
    "bg": "00225",
    "fg": "002341",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "弟子",
    "text": "（部屋の調査を終えたところで……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（話し合って、有栖川夏葉たちは凶器について、\r\n緋田美琴たちは犯行時刻の絞り込みについて）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（浅倉透たちは動機について調べることになった）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（桑山千雪、八宮めぐる、和泉愛依はそれぞれ、\r\n屋敷の中を調べてみることにしたようだ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（俺も、ぼうっとしてはいられないな──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]