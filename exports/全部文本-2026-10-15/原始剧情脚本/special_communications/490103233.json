    "fgEffect": "fade",
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032330100,
    "speaker": "はづき",
    "text": "だから彼女は、台所にいたんじゃないでしょうか\r\n他の探偵たちに、あぶり出しをさせないように",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "special_communications/490103233/4901032330100"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901032330110,
    "speaker": "はづき",
    "text": "そして、先代の『Ａ』は……",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "special_communications/490103233/4901032330110"
  },
  {
    "id": 4901032330120,
    "speaker": "はづき",
    "text": "探偵の誰かと協力しないと解けない謎を、\r\nあなたに出したかったんじゃないでしょうか",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "special_communications/490103233/4901032330120"
  },
  {
    "textFrame": "off",
    "bg": "00681",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "『Ａ』",
    "text": "……なるほど、納得しました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
