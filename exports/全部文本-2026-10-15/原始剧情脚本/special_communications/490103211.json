[
  {
    "textFrame": "off",
    "bg": "00000",
    "bgm": "015"
  },
  {
    "id": 4901032110001,
    "speaker": "めぐる",
    "text": "見えてきたね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110001"
  },
  {
    "id": 4901032110010,
    "speaker": "めぐる",
    "text": "アリバイらしいアリバイがないのは\r\nわたし、幽谷さん、有栖川さん、桑山さん──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110010"
  },
  {
    "id": 4901032110020,
    "speaker": "冬優子",
    "text": "それからふゆ、透ちゃん、美琴さん……\r\nこの７人ってことになりそうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110020"
  },
  {
    "textFrame": "off",
    "bg": "00737",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "なるほど……死亡推定時刻にみなさんが何をしていたのか\r\n改めて教えてもらってもいいですか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032110030,
    "speaker": "めぐる",
    "text": "うん、もちろん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110030"
  },
  {
    "id": 4901032110040,
    "speaker": "めぐる",
    "text": "わたしはお屋敷を見ようと思って\r\n外に出てたよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110040"
  },
  {
    "speaker": "弟子",
    "text": "何か理由はあるんでしょうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032110050,
    "speaker": "めぐる",
    "text": "『Ａ』は隠し部屋にいるんじゃないかなって思ってて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110050"
  },
  {
    "id": 4901032110060,
    "speaker": "めぐる",
    "text": "例えば、外から見える窓の数と\r\n中からわかる窓の数が違えば──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110060"
  },
  {
    "id": 4901032110070,
    "speaker": "めぐる",
    "text": "みたいな！\r\nこういう探し方もできるんじゃないかなって思ったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110070"
  },
  {
    "id": 4901032110080,
    "speaker": "小糸",
    "text": "あ……\r\nな、なるほど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110080"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 4901032110090,
    "speaker": "小糸",
    "text": "で、でも……ドア、鍵……かかってるとこ多くて……\r\n館の構造……わかりづらかった、ような……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110090"
  },
  {
    "id": 4901032110100,
    "speaker": "めぐる",
    "text": "そうなんだよね\r\nお屋敷の中を歩いててちょっと失敗したなって！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110100"
  },
  {
    "id": 4901032110110,
    "speaker": "夏葉",
    "text": "私も外にいたんだけど、\r\nめぐるとはすれ違わなかったわね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110110"
  },
  {
    "id": 4901032110120,
    "speaker": "夏葉",
    "text": "雨が降っていて、月や室外灯もなかったし\r\n視界が悪くて気が付かなかったのかしら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110120"
  },
  {
    "id": 4901032110130,
    "speaker": "めぐる",
    "text": "たぶんそうじゃないかな\r\n雨足が強くなってきたところだったから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110130"
  },
  {
    "id": 4901032110140,
    "speaker": "果穂",
    "text": "有栖川さんも建物を見たかったんですか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110140"
  },
  {
    "id": 4901032110150,
    "speaker": "夏葉",
    "text": "いいえ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110150"
  },
  {
    "id": 4901032110160,
    "speaker": "夏葉",
    "text": "ただ、屋敷の周りを走っていたのよ\r\n身体を動かしていた方が、考えを整理できるから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110160"
  },
  {
    "id": 4901032110170,
    "speaker": "果穂",
    "text": "わかる気がしますっ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110170"
  },
  {
    "id": 4901032110180,
    "speaker": "果穂",
    "text": "あたしも、うちの犬と散歩してる時が\r\n一番ひらめくんです！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110180"
  },
  {
    "id": 4901032110190,
    "speaker": "夏葉",
    "text": "あら、アナタも犬を飼っているの？\r\n私も──……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110190"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901032110200,
    "speaker": "冬優子",
    "text": "えーっと……！\r\nふゆも話して大丈夫かな……！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110200"
  },
  {
    "speaker": "弟子",
    "text": "そういえば、あなたもアリバイがない組でしたね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032110210,
    "speaker": "冬優子",
    "text": "はい\r\nふゆはその時、お風呂に入っていて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110210"
  },
  {
    "id": 4901032110220,
    "speaker": "あさひ",
    "text": "お風呂……\r\nじゃあ誰もアリバイ実証できないっすね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110220"
  },
  {
    "id": 4901032110230,
    "speaker": "冬優子",
    "text": "うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110230"
  },
  {
    "id": 4901032110240,
    "speaker": "美琴",
    "text": "私はひとりで館の中を歩き回っていて、\r\n一度もリビングや部屋には戻らなかったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110240"
  },
  {
    "id": 4901032110250,
    "speaker": "にちか",
    "text": "美琴さんはところどころ動画に切れて映ってますけど、\r\n15分ずつくらい、飛び飛びですもんね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110250"
  },
  {
    "id": 4901032110260,
    "speaker": "にちか",
    "text": "どの美琴さんも、変わった様子はなかったですけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110260"
  },
  {
    "id": 4901032110270,
    "speaker": "美琴",
    "text": "うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110270"
  },
  {
    "id": 4901032110280,
    "speaker": "美琴",
    "text": "『Ａ』の部屋の近くにも行ったけど\r\n揉み合ったりする物音は聞こえなかったかな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103211/4901032110280"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]