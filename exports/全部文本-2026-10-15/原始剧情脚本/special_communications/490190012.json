    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490190012/4901900120040"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶も言ったように、火を使わないで楽しめるものだろ？\r\n溶けないものだからさ",
