    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220080"
  },
  {
    "id": 4901032220090,
    "speaker": "あさひ",
    "text": "…………これ、どうなってるんすか……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220090"
  },
  {
    "id": 4901032220100,
    "speaker": "冬優子",
    "text": "…………わからない。でも……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220100"
  },
  {
    "id": 4901032220110,
    "speaker": "冬優子",
    "text": "みんなも……\r\n犯人だったはずの愛依ちゃんも──……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220110"
  },
  {
