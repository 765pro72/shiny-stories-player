    "text": "……注射の跡……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220180"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901032220190,
    "speaker": "冬優子",
    "text": "ふゆの腕にもある──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220190"
  },
  {
