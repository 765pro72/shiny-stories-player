    "waitTime": 1000
  },
  {
    "id": 4901032220120,
    "speaker": "冬優子",
    "text": "…………あ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220120"
  },
  {
    "id": 4901032220130,
    "speaker": "あさひ",
    "text": "どうしたんすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220130"
  },
  {
    "id": 4901032220140,
    "speaker": "冬優子",
    "text": "愛依ちゃんの手元に、注射器が転がってる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220140"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901032220150,
    "speaker": "あさひ",
    "text": "千雪さんと、お弟子さんの遺体だけが\r\n見当たらないっすね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220150"
  },
  {
    "id": 4901032220160,
    "speaker": "あさひ",
    "text": "──ん……？\r\nなんだろ、わたし、腕が……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220160"
  },
  {
    "id": 4901032220170,
    "speaker": "冬優子",
    "text": "……？\r\nごめん、ちょっと見せてもらってもいいかな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103222/4901032220170"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901032220180,
