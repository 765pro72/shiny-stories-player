    "voice": "special_communications/490170006/4901700060020"
  },
  {
    "id": 4901700060030,
    "speaker": "めぐる",
    "text": "夜が長い分長く見られるから、\r\nなんか嬉しくなっちゃうんだ",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170006/4901700060030"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに\r\nクリスマスシーズンの楽しみだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700060040,
    "speaker": "めぐる",
    "text": "ねー！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
