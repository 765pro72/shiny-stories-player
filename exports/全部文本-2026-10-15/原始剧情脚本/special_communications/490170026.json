  },
  {
    "speaker": "プロデューサー",
    "text": "よかったのか夏葉、せっかくの空き時間に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700260010,
    "speaker": "夏葉",
    "text": "あら！\r\n確認するなら私の方よ、お邪魔して大丈夫かしらって",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040130070",
    "charPosition": {
