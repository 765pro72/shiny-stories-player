    "textFrame": "001",
    "voice": "special_communications/490101708/4901017080070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……ありがとうな\r\nちなみに、どうしてフクロウなんだ？　好きだったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901017080080,
    "speaker": "灯織",
    "text": "最近気に入っていて……",
