  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "………………摩美々に悪いことしたな……\r\nでも、イタズラじゃないならなんで無いんだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？　箱の底にメモ用紙が──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0181",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 4901007200090,
    "speaker": "摩美々",
    "text": "『プリンは冷蔵庫で食べ頃を迎えてます\r\nゆっくり味わって食べてくださいねー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490100720/4901007200090"
  },
