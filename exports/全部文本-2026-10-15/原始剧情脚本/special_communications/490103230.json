      "time": 100
    },
    "voice": "special_communications/490103230/4901032300110"
  },
  {
    "speaker": "弟子",
    "text": "屋敷の他の出入り口は全て施錠されています",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
