    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "fgEffect": "fade",
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032300090,
    "speaker": "千雪",
    "text": "台所にいた私が一番怪しい、というのはわかりますけど……\r\nそれは少し雑じゃありません？　お弟子さん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300090"
  },
  {
    "speaker": "弟子",
    "text": "台所にいたからだけではありません\r\n先ほどご説明いたしました通り……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "このトリックでは、\r\n凍らせたペットボトルが必要になります",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032300100,
    "speaker": "千雪",
    "text": "そうですね……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300100"
  },
