    "text": "はい",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 4901032300050,
    "speaker": "千雪",
    "text": "それなら……\r\nじっくり、伺わせていただきたいと思います♪",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300050"
  },
  {
    "id": 4901032300060,
    "speaker": "千雪",
    "text": "私は犯人ではないので……\r\nあなたのお話には、無理が出てくるはず",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300060"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "弟子",
    "text": "（肝が据わっているな……\r\nさすがにこの状況で『Ａ』を殺しただけある……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "……わかりました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "まず、第一に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00737",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "死亡推定時刻に\r\nアリバイがない７人の中の１人であること",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032300070,
    "speaker": "千雪",
    "text": "ふふっ……そうですね\r\nそれから？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300070"
  },
  {
    "speaker": "弟子",
    "text": "21時半まで台所にいたことです",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032300080,
    "speaker": "千雪",
    "text": "ガムシロップ、エコバッグ\r\nそれに、過冷却で凍ったペットボトル……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103230/4901032300080"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 300,
    "waitType": "time",
    "waitTime": 1000
  },
  {
