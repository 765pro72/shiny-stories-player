  {
    "speaker": "プロデューサー",
    "text": "はは、みんな気をつけて行くんだぞ",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "id": 4901002010041,
    "speaker": "一同",
    "text": "はーいっ",
    "textCtrl": "p",
    "textFrame": "0009",
    "voice": "special_communications/490100201/4901002010041"
  },
  {
    "textFrame": "off",
    "se": "0113",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "ふぅ……\r\n一気にいなくなると、急に物寂しくなるな……",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "speaker": "プロデューサー",
    "text": "──って、いかんいかん！\r\n仕事が残ってるんだから、気合いを入れないと",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "speaker": "プロデューサー",
    "text": "よしっ、みんなのためにも頑張るぞ！",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
