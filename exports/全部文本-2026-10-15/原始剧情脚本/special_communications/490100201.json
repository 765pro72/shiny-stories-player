    },
    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "——あ、れ……？\r\nなんだか、急に眠気が……",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "speaker": "プロデューサー",
    "text": "ここのところ、しばらく働きづめだったから\r\n思ったより、疲れ……て……",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "effectLabel": "black3",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
