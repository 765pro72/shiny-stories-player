    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "ふぅ……\r\nこれで、書類は終わりか……次は……",
    "textCtrl": "p",
    "textFrame": "0011"
  },
  {
    "textFrame": "off",
