    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901700140110,
    "speaker": "結華",
    "text": "三峰がアイドルとして頑張れているのはー、\r\nＰたんのおかげなのでー",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490170014/4901700140110"
  },
  {
    "id": 4901700140120,
    "speaker": "結華",
    "text": "クリスマスにかこつけて\r\n何かできたらって思って",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140120"
  },
  {
    "id": 4901700140130,
    "speaker": "結華",
    "text": "あはは、ちょっと照れくさいけど\r\nそういう感じ",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140130"
  },
  {
    "id": 4901700140140,
    "speaker": "結華",
    "text": "師走ってだけあって、まだまだ忙しいけどさ\r\nこの一杯分は一緒にのんびりしよってことで！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
