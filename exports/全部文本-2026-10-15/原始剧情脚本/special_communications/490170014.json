  {
    "id": 4901700140010,
    "speaker": "結華",
    "text": "はー……\r\nあったまる～……！",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
