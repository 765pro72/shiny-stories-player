    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490170014/4901700140010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとな、ドリンクチケット分けてくれて",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700140020,
    "speaker": "結華",
    "text": "どういたしまして！\r\n期限今日までだったし、こっちも助かっちゃったよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140020"
  },
  {
    "id": 4901700140030,
    "speaker": "結華",
    "text": "Ｐたん巻き込めてラッキー",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140030"
  },
  {
    "id": 4901700140040,
    "speaker": "結華",
    "text": "──あ、ちなみにこの件、\r\nアンティーカのみんなには内緒ね？",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140040"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど、共犯にされたってことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700140050,
    "speaker": "結華",
    "text": "何共犯ってー、人聞きが悪いなぁ\r\n特別扱いしてるんですけど？",
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……？　チケットの枚数的に\r\nみんなが誘えなかったから、ってことじゃ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700140060,
    "speaker": "結華",
    "text": "えーっ、心外～！",
    "charAnim1": "anger2",
    "charAnim2": "face_jito",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140060"
  },
  {
    "id": 4901700140070,
    "speaker": "結華",
    "text": "誰に声かけるか考えたとき\r\n真っ先に浮かんだのに",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140070"
  },
  {
    "id": 4901700140080,
    "speaker": "結華",
    "text": "日々戦うＰたんを癒せたらって思っての\r\nお誘いだったのに",
    "charAnim1": "wait2",
    "charAnim2": "face_close5",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140080"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまんすまん\r\nちょっとからかってみたくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700140090,
    "speaker": "結華",
    "text": "大丈夫でーす、知ってまーす",
    "charAnim1": "wink",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そんなにわかりやすいか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700140100,
    "speaker": "結華",
    "text": "そりゃあそうでしょう\r\nそれなりの時間、一緒にいますから？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170014/4901700140100"
  },
  {
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
