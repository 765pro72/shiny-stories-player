    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101725/4901017250020"
  },
  {
    "id": 4901017250030,
    "speaker": "結華",
    "text": "ありがとうだけどさぁ、\r\nどんだけ三峰ファーストにするつもりなの？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
