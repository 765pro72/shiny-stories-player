  {
    "id": 4901700320030,
    "speaker": "千雪",
    "text": "プロデューサーさんは『永遠の命』\r\nが手に入るとしたら、欲しいって思います？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
