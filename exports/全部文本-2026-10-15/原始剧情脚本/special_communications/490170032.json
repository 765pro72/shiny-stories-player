    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490170032/4901700320030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nどうしてだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700320040,
    "speaker": "千雪",
    "text": "りんごのオーナメントは、エデンの園に由来\r\nしているって知って、ちょっと気になったんです",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170032/4901700320040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……俺はいいかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分だけ生き続けても、周りの大切な人が\r\nそうじゃないなら、辛いだろうって思うから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901700320050,
    "speaker": "千雪",
    "text": "わかります。私も、限りある時間の中で\r\n生きる方に、尊さを感じます",
