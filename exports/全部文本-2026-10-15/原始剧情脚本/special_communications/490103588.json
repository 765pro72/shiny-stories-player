  {
    "id": 4901035880010,
    "speaker": "小糸",
    "text": "ま、招き猫なんですけど……\r\n福を呼び込むらしくて",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
