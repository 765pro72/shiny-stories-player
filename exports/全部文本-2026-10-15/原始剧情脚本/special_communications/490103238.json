    "voice": "special_communications/490103238/4901032380060"
  },
  {
    "speaker": "弟子",
    "text": "はい\r\n確かに冷凍庫の中は空でしたが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
