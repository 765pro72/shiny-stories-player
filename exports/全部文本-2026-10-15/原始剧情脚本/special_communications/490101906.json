  },
  {
    "id": 4901019060030,
    "speaker": "めぐる",
    "text": "じゃあじゃあ、届いたらたくさん写真撮って\r\nメッセするね！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
