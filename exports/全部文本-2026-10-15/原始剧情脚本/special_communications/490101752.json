    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101752/4901017520040"
  },
  {
    "id": 4901017520050,
    "speaker": "夏葉",
    "text": "頭のてっぺんから爪先まで、\r\n完璧にコーディネートしてあげるわ",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490101752/4901017520050"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、頼もしいな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901017520060,
