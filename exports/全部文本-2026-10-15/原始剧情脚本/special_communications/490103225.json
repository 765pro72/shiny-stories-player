  {
    "id": 4901032250010,
    "speaker": "恋鐘",
    "text": "お弟子さん\r\nほんとに犯人、わかったと……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103225/4901032250010"
  },
  {
    "speaker": "弟子",
    "text": "はい",
