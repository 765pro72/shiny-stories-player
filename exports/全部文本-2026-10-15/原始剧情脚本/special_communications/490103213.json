    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130170"
  },
  {
    "id": 4901032130180,
    "speaker": "美琴",
    "text": "彼女、この前の時間帯にはアリバイがあるし……\r\nひとりでうろついていても不思議じゃないと思うけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130180"
  },
  {
    "speaker": "弟子",
    "text": "（確かに、それもそうか……）",
