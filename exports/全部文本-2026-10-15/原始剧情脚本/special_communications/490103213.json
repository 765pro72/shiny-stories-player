    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032130250,
    "speaker": "美琴",
    "text": "カメラは、21時45分から朝まで\r\n置かれていたみたい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130250"
  },
  {
    "id": 4901032130260,
    "speaker": "美琴",
    "text": "他にも何人か映っている人はいたけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130260"
  },
  {
    "id": 4901032130270,
    "speaker": "美琴",
    "text": "みんな程なく、\r\nがっかりした顔で戻ってきているの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130270"
  },
  {
    "id": 4901032130280,
    "speaker": "にちか",
    "text": "部屋を見つけても、中の『Ａ』が死んでたら\r\n開けてもらえませんもんね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130280"
  },
  {
    "id": 4901032130290,
    "speaker": "美琴",
    "text": "そうだね\r\n鍵を持っていない限り……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130290"
  },
  {
    "speaker": "弟子",
    "text": "確かに……",
