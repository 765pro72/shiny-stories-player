    },
    "voice": "special_communications/490103213/4901032130060"
  },
  {
    "id": 4901032130070,
    "speaker": "美琴",
    "text": "凍ってるのは……\r\n過冷却の原理",
    "charAnim1": "think1",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130070"
  },
  {
    "speaker": "弟子",
    "text": "過冷却……ですか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mikoto",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032130080,
    "speaker": "にちか",
    "text": "『Ａ』の弟子なのに知らないんですか～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130080"
  },
  {
    "id": 4901032130090,
    "speaker": "にちか",
    "text": "過冷却っていうのは、凝固点以下の温度になっても\r\n液体のままでいる状態なんですよー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130090"
  },
  {
    "id": 4901032130100,
    "speaker": "にちか",
    "text": "そこに衝撃を与えたりすると、一気に凍るんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130100"
  },
  {
    "speaker": "弟子",
    "text": "へえ……そういうこともあるんですね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032130110,
    "speaker": "美琴",
    "text": "夏になると、これを利用したコーラやビールが\r\n売られることもあるみたい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130110"
  },
  {
    "speaker": "弟子",
    "text": "……機会があれば、飲んでみたいですね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00670",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032130120,
    "speaker": "美琴",
    "text": "そうだ\r\n映像と動画を整理していたんだけど……",
