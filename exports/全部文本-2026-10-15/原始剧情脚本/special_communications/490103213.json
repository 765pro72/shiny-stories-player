  {
    "id": 4901032130010,
    "speaker": "美琴",
    "text": "死亡推定時刻の前後に写真や動画を撮っていた人が\r\n何人かいたよね？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130010"
  },
  {
    "id": 4901032130020,
    "speaker": "にちか",
    "text": "私と美琴さんで、それを集めて何か情報が出ないか\r\n調べてみようと思ってるんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130020"
  },
  {
    "id": 4901032130030,
    "speaker": "にちか",
    "text": "お弟子さん、動画とか得意ですか？\r\n倍速再生の仕方とかわかります？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103213/4901032130030"
  },
  {
    "speaker": "弟子",
    "text": "はは、正直それほど自信はありませんが……\r\nあとで様子を見に伺います",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 4000
  },
  {
    "speaker": "off",
