    },
    "voice": "special_communications/490103213/4901032130120"
  },
  {
    "id": 4901032130130,
    "speaker": "美琴",
    "text": "ちょっと気になるところがあって\r\nこれ、見て",
    "charAnim1": "anger1",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
