    "voice": "special_communications/490102652/4901026520040"
  },
  {
    "id": 4901026520050,
    "speaker": "夏葉",
    "text": "アナタごと、アナタのお家まで\r\n運んでしまおうかと思って",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490102652/4901026520050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……！\r\nそういうことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで、俺は一体何を貰えるんだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901026520060,
    "speaker": "夏葉",
