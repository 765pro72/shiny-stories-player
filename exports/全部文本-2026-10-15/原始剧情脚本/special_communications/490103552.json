    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとう\r\n履かせてもらうよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901035520050,
