  {
    "speaker": "プロデューサー",
    "text": "し、失礼します……！　社長、お呼びでしょうか……？",
    "charLabel": "ceo",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "sub_characters",
    "charId": "ceo",
    "charPosition": {
      "x": 568,
