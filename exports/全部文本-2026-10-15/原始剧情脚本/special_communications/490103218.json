    "id": 4901032180360,
    "speaker": "愛依",
    "text": "うちが行った時は……\r\nもうめちゃくちゃな状態だった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180360"
  },
  {
    "id": 4901032180370,
    "speaker": "愛依",
    "text": "天窓は開いてて\r\n『Ａ』の遺体は濡れてて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180370"
  },
  {
    "id": 4901032180380,
    "speaker": "愛依",
    "text": "かわいそうだから……\r\n雨が当たんないとこにずらしたの……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180380"
  },
  {
    "id": 4901032180390,
    "speaker": "愛依",
    "text": "でも、そのあと、色々いじったらヤバいって\r\n気付いたから……窓閉めて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180390"
  },
  {
    "id": 4901032180400,
    "speaker": "冬優子",
    "text": "うん、それから？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180400"
  },
  {
    "id": 4901032180410,
    "speaker": "愛依",
    "text": "……ドア開けて\r\n……廊下に誰もいないことを確かめて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180410"
  },
  {
    "id": 4901032180420,
    "speaker": "愛依",
    "text": "……鍵かけてから\r\n自分の部屋に戻った……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180420"
  },
  {
    "id": 4901032180430,
    "speaker": "あさひ",
    "text": "……鍵は今、愛依ちゃんが持ってるんすか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180430"
  },
  {
    "id": 4901032180440,
    "speaker": "愛依",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180440"
  },
  {
    "id": 4901032180450,
    "speaker": "冬優子",
    "text": "どうやって手に入れたの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180450"
  },
  {
    "id": 4901032180460,
    "speaker": "愛依",
    "text": "それは……マジで……\r\n言えない…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180460"
  },
  {
    "id": 4901032180470,
    "speaker": "愛依",
    "text": "ごめん…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180470"
  },
  {
    "textFrame": "off",
    "se": "0453",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 4901032180480,
    "speaker": "冬優子",
    "text": "……っ……、愛依ちゃん……！\r\nそれじゃあ守りきれない……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180480"
  },
  {
    "id": 4901032180490,
    "speaker": "あさひ",
    "text": "そっすよ\r\n愛依ちゃんは犯人じゃないっすよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180490"
  },
  {
    "id": 4901032180500,
    "speaker": "あさひ",
    "text": "黙ってたら\r\n本当の犯人に濡れ衣を着せられちゃうっすよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180500"
  },
  {
    "id": 4901032180510,
    "speaker": "愛依",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "special_communications/490103218/4901032180510"
  },
  {
    "id": 4901032180520,
    "speaker": "愛依",
    "text": "けど…………それだけは無理…………\r\nマジでごめん…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180520"
  },
  {
    "id": 4901032180530,
