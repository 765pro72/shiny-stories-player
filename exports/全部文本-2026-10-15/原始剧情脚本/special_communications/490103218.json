    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180270"
  },
  {
    "textFrame": "off",
    "bg": "00277",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "知っていることがあるなら、話していただけませんか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "あなたが無実でも、今の態度のままでは\r\nそう思わない方もいらっしゃるでしょう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "そうなると、解毒剤の在処がわからないまま……\r\nみんな、タイムリミットを迎えて死ぬことになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "あなたに理解を示しているこのふたりもです",
    "textCtrl": "p",
    "textFrame": "002"
  },
