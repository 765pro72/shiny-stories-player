  },
  {
    "id": 4901032180260,
    "speaker": "あさひ",
    "text": "何か事情があるっすか？\r\nキリキリ白状するっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180260"
  },
  {
    "id": 4901032180270,
