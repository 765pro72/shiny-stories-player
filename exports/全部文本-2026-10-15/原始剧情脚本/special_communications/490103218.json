    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180220"
  },
  {
    "id": 4901032180230,
    "speaker": "冬優子",
    "text": "でも、『Ａ』の部屋には行ったんだよね……？\r\nせめて何を見たのか、教えてくれないかな……",
