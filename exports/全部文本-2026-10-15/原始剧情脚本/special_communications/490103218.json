    "textFrame": "001",
    "voice": "special_communications/490103218/4901032180320"
  },
  {
    "id": 4901032180330,
    "speaker": "愛依",
    "text": "でも、目当てのものはなくて……\r\nクローゼットとか引き出しとか探して……",
