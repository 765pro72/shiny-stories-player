  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901032050010,
    "speaker": "結華",
    "text": "……はぁ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050010"
  },
  {
    "id": 4901032050020,
    "speaker": "結華",
    "text": "好き勝手やってくれるよね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050020"
  },
  {
    "textFrame": "off",
    "bg": "00684",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4901032050030,
    "speaker": "結華",
    "text": "みんなはどうする？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050030"
  },
  {
    "id": 4901032050040,
    "speaker": "あさひ",
    "text": "わたしはやるっすよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050040"
  },
  {
    "id": 4901032050050,
    "speaker": "あさひ",
    "text": "解毒剤さえ見つければ死なないっすよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050050"
  },
  {
    "id": 4901032050060,
    "speaker": "あさひ",
    "text": "謎解き、ワクワクするっす～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050060"
  },
  {
    "id": 4901032050070,
    "speaker": "冬優子",
    "text": "わ、わくわくかぁ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050070"
  },
  {
    "id": 4901032050080,
    "speaker": "冬優子",
    "text": "……ええと\r\nとにかく、相手は本気だと思うな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050080"
  },
  {
    "id": 4901032050090,
    "speaker": "愛依",
    "text": "やるっきゃないっしょ……！\r\n死にたくないし、『Ａ』のファイルも欲しいからね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050090"
  },
  {
    "id": 4901032050100,
    "speaker": "真乃",
    "text": "は、はい……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050100"
  },
  {
    "id": 4901032050110,
    "speaker": "真乃",
    "text": "解毒剤を見つけないと……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050110"
  },
  {
    "textFrame": "off",
    "bg": "00225",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 4901032050120,
    "speaker": "千雪",
    "text": "考えてたんだけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050120"
  },
  {
    "id": 4901032050130,
    "speaker": "千雪",
    "text": "お弟子さんも\r\n私たちと情報量がそんなに変わらないのなら……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050130"
  },
  {
    "id": 4901032050140,
    "speaker": "千雪",
    "text": "まずは『Ａ』の部屋を探すところから始めないと\r\nいけないのかな……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050140"
  },
  {
    "id": 4901032050150,
    "speaker": "甘奈",
    "text": "そうだね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050150"
  },
  {
    "id": 4901032050160,
    "speaker": "甘奈",
    "text": "お弟子さん、本棟の見取り図\r\n描いてもらっていいかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050160"
  },
  {
    "id": 4901032050170,
    "speaker": "甘奈",
    "text": "当てずっぽうに歩くより、\r\n何か、指針になるものがあった方がいいと思うんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050170"
  },
  {
    "id": 4901032050180,
    "speaker": "甜花",
    "text": "わ……\r\nそう……だね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050180"
  },
  {
    "id": 4901032050190,
    "speaker": "甜花",
    "text": "──あ、あと……\r\n何か、手がかりも……ないかな……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050190"
  },
  {
    "id": 4901032050200,
    "speaker": "甜花",
    "text": "『Ａ』が、言っていたこととかで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050200"
  },
  {
    "speaker": "弟子",
    "text": "『Ａ』はあまり不用意なことを言う方ではないのですが……\r\n何か思い出したら、お話しますね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032050210,
    "speaker": "甜花",
    "text": "うん……！\r\nお願いします……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050210"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 500,
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "se": "0766",
    "waitType": "time",
    "waitTime": 4000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "弟子",
    "text": "こちらが本棟の見取り図となります",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00727",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032050220,
    "speaker": "めぐる",
    "text": "今わたしたちがいるのが本棟ロビーで……\r\n客室棟には、ここを通らないと行けないみたいだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050220"
  },
  {
    "id": 4901032050230,
    "speaker": "真乃",
    "text": "たくさんあるお部屋……\r\nロビーと台所の他は、名前がないんですね……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050230"
  },
  {
    "speaker": "弟子",
    "text": "『Ａ』自身がいろいろと手を加えておりましたので、\r\n私にもわからない部分がありまして……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "間違いがあってはいけないので、空欄にしております",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "なお、屋敷に詳しい私はハンデとして、\r\nしばらくロビーでみなさんのご質問に答えております",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032050240,
    "speaker": "灯織",
    "text": "すみません、質問なのですが……\r\n入ってはいけない場所はあるのでしょうか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050240"
  },
  {
    "speaker": "弟子",
    "text": "『Ａ』からは\r\nそのような指示はございませんでした",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "この屋敷は、襲撃者に備え\r\n頑丈なロック、防弾ガラスが取り付けられていますし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "全てのドアも、\r\n鍵を持っていなければ開けることは不可能……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "開けられるのは『怪盗２８３』くらいだと\r\n『Ａ』は申しておりました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032050250,
    "speaker": "結華",
    "text": "ああ、それインタビューで読んだことある",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050250"
  },
  {
    "id": 4901032050260,
    "speaker": "めぐる",
    "text": "うんうんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050260"
  },
  {
    "id": 4901032050270,
    "speaker": "めぐる",
    "text": "『怪盗２８３』以外には決して開けられない鍵\r\n──って！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050270"
  },
  {
    "id": 4901032050280,
    "speaker": "灯織",
    "text": "なるほど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050280"
  },
  {
    "id": 4901032050290,
    "speaker": "結華",
    "text": "……要するに。鍵がかかってなければ入っていいし、\r\nかかってても開けられれば入っていいってことかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050290"
  },
  {
    "speaker": "弟子",
    "text": "そういうことだと思います",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032050300,
    "speaker": "めぐる",
    "text": "そっかー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050300"
  },
  {
    "textFrame": "off",
    "bg": "00277",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032050310,
    "speaker": "めぐる",
    "text": "じゃあじゃあ、隠し部屋とか謎の地下室──\r\nみたいな定番もきっとあるんだろうね……！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030030040",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490103205/4901032050310"
  },
  {
    "id": 4901032050320,
    "speaker": "めぐる",
    "text": "頑張らなきゃだ……！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050320"
  },
  {
    "charLabel": "meguru",
    "textFrame": "off",
