    }
  },
  {
    "id": 4901032050330,
    "speaker": "灯織",
    "text": "ありがとうございます",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040020030",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "special_communications/490103205/4901032050330"
  },
  {
    "id": 4901032050340,
    "speaker": "灯織",
    "text": "……『死神』はさすがに言い過ぎだと思っていたけど",
    "charAnim1": "surp2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050340"
  },
  {
    "id": 4901032050350,
    "speaker": "灯織",
    "text": "こんなにたくさんの人を巻き込んで……\r\n名実共に死神じゃない……",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050350"
  },
  {
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00225",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032050360,
    "speaker": "真乃",
    "text": "……あのっ\r\nめぐるちゃん、風野さん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050360"
  },
  {
    "id": 4901032050370,
    "speaker": "真乃",
    "text": "よかったら、なんだけど……\r\n『Ａ』の部屋、一緒に探してみるのはどうかな……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050370"
  },
  {
    "id": 4901032050380,
    "speaker": "灯織",
    "text": "……え\r\n私も、一緒に行っていいの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050380"
  },
  {
    "id": 4901032050390,
    "speaker": "真乃",
    "text": "うん、ぜひ……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050390"
  },
  {
    "id": 4901032050400,
    "speaker": "めぐる",
    "text": "一緒に行きたい！\r\n──んだけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050400"
  },
  {
    "id": 4901032050410,
    "speaker": "めぐる",
    "text": "ちょっと気になることがあるんだ\r\nそれを調べてから合流したい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050410"
  },
  {
    "id": 4901032050420,
    "speaker": "真乃",
    "text": "うん\r\nわかった、ありがとう……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050420"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 4901032050430,
    "speaker": "真乃",
    "text": "──……あの、それと……\r\nこれも、よかったら……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050430"
  },
  {
    "id": 4901032050440,
    "speaker": "真乃",
    "text": "灯織ちゃんって呼んでもいい……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050440"
  },
  {
    "id": 4901032050450,
    "speaker": "灯織",
    "text": "好きに呼んでもらえれば……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050450"
  },
  {
    "id": 4901032050460,
    "speaker": "真乃",
    "text": "ありがとう……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103205/4901032050460"
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "fg": "002341",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "fgEffect": "fade",
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "（見渡してみれば、\r\n他の面々もそれぞれ動き出しているようだ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（櫻木真乃たちのようにチームを作るもの……\r\nひとりで行動すると決めてロビーを出て行くもの……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（俺も、ぼうっとしてはいられないな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "fgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "弟子",
    "text": "（『Ａ』からの命令だ、\r\n弟子としての仕事はこなしつつも……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "弟子",
    "text": "（本当の自室を探るとするか…………）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
