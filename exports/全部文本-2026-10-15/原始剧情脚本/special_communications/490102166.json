  },
  {
    "speaker": "仲間",
    "text": "ああ\r\nさすがの身のこなしだったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901021660030,
    "speaker": "雛菜",
    "text": "あは～\r\nやっぱり雛菜泥棒って向いてるかも～",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
