    "voice": "special_communications/490102166/4901021660040"
  },
  {
    "speaker": "仲間",
    "text": "よし、じゃあこの盗み出したこの金品を\r\n町の人たちへ返しに行こう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "仲間",
