  },
  {
    "speaker": "仲間",
    "text": "そうだな\r\n雛菜は何やらせても器用にやるからな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901021660040,
    "speaker": "雛菜",
    "text": "やは～\r\n褒められちゃった～",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
