  {
    "id": 4901700460010,
    "speaker": "雛菜",
    "text": "クリスマスデートコーデか……\r\nね、プロデューサーならどんなのがいい～？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040230050",
