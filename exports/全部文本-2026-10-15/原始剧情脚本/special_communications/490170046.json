    "voice": "special_communications/490170046/4901700460070"
  },
  {
    "id": 4901700460080,
    "speaker": "雛菜",
    "text": "雛菜がクリスマスデートするときは、\r\nすっごくかわいい雛菜になって……",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490170046/4901700460080"
  },
  {
    "id": 4901700460090,
    "speaker": "雛菜",
    "text": "おしゃれなレストラン行って、\r\nおいしいごはんとケーキ食べて……",
    "charAnim1": "smile1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
