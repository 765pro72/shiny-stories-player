  {
    "id": 4901700460070,
    "speaker": "雛菜",
    "text": "あは～\r\nやっぱりそうだよね～♡",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
