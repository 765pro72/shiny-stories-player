  {
    "id": 4901032170150,
    "speaker": "灯織",
    "text": "なるほど……\r\nでしたら、絨毯をずらしてみるのはどうでしょうか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
