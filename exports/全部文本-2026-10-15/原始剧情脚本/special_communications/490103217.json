    "waitTime": 1500
  },
  {
    "speaker": "弟子",
    "text": "私はそう思います",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032170280,
    "speaker": "真乃",
    "text": "そ、そうですね……っ\r\nすみません……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170280"
  },
  {
    "id": 4901032170290,
    "speaker": "灯織",
    "text": "死亡推定時刻の後に、\r\nこの部屋の方に来た人がいたのを忘れていました……",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "special_communications/490103217/4901032170290"
  },
  {
    "label": "2",
    "speaker": "弟子",
    "text": "……でしょうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032170300,
    "speaker": "めぐる",
    "text": "本当にそれだけなのかな？\r\nなんだかしっくりこないような……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170300"
  },
  {
    "id": 4901032170310,
    "speaker": "灯織",
    "text": "そうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "special_communications/490103217/4901032170310"
  },
  {
    "label": "3",
    "speaker": "弟子",
    "text": "そう思いました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032170320,
    "speaker": "真乃",
    "text": "えっと……\r\n最初は死亡推定時刻をずらそうと思っていたけれど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170320"
  },
  {
    "id": 4901032170330,
    "speaker": "真乃",
    "text": "雨に打たれている姿を見て、やっぱりやめようと思った\r\n……ということでしょうか……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170330"
  },
  {
    "id": 4901032170340,
    "speaker": "めぐる",
    "text": "真乃の言うとおりで、それだとちょっと変だよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170340"
  },
  {
    "id": 4901032170350,
    "speaker": "めぐる",
    "text": "犯人って、最初から凶器を持ち込んでるような\r\n殺意の高い人だよ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170350"
  },
  {
    "id": 4901032170360,
    "speaker": "灯織",
    "text": "そうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "special_communications/490103217/4901032170360"
  },
  {
    "label": "join",
    "textFrame": "off",
    "bg": "00682",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032170370,
    "speaker": "灯織",
    "text": "そもそも、死亡推定時刻をずらしたいなら、\r\n天窓の下から移動させる必要はない……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170370"
  },
  {
    "id": 4901032170380,
    "speaker": "めぐる",
    "text": "もうちょっと考えてみないとダメそう！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170380"
  },
  {
    "id": 4901032170390,
    "speaker": "めぐる",
    "text": "でもでも、なんとなく\r\n犯人の行動がわかってきた気がする",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170390"
  },
  {
    "textFrame": "off",
    "bg": "00531",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 4901032170400,
    "speaker": "真乃",
    "text": "光が……見えてきた気がします",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170400"
  },
  {
    "speaker": "弟子",
    "text": "ええ、ですが……\r\nまだ、犯人を特定するには足りない情報がありそうです",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 4901032170410,
    "speaker": "めぐる",
    "text": "うん\r\n頑張ろう！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170410"
  },
