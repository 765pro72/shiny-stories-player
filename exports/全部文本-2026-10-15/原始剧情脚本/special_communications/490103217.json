    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "fg": "002341"
  },
  {
    "speaker": "弟子",
    "text": "（……俺は３人に、大崎姉妹から聞いた\r\n胸ポケットの内側の紙の話……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
