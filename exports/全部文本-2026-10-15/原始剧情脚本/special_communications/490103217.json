      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "special_communications/490103217/4901032170150"
  },
  {
    "id": 4901032170160,
    "speaker": "灯織",
    "text": "絨毯の上で遺体を動かした形跡はありません\r\nとすれば──",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "special_communications/490103217/4901032170160"
  },
  {
    "id": 4901032170170,
    "speaker": "灯織",
    "text": "床に血痕があると考える方が自然です",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
