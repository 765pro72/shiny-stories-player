    "voice": "produce_events/200500704/2005007040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……それもそうか\r\n今更だったな、すまん！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005007040100,
    "speaker": "摩美々",
    "text": "……え\r\nいや……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
