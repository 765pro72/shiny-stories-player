    "textFrame": "001",
    "voice": "produce_events/200500704/2005007040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "──さ、残りはポラロイドが乾いて現像できたら\r\nこのペンでサインだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005007040110,
    "speaker": "摩美々",
    "text": "あぁ……",
