    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500704/2005007040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、なんか改めて……その格好がさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005007040090,
    "speaker": "摩美々",
    "text": "当たり前じゃないですかぁ\r\nまみみですからねー",
