    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500704/2005007040140"
  },
  {
    "id": 2005007040150,
    "speaker": "摩美々",
    "text": "……それより\r\nプロデューサー的にはどうだったんですかぁ？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500704/2005007040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな、俺は──\r\n反省と前進……かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005007040160,
    "speaker": "摩美々",
