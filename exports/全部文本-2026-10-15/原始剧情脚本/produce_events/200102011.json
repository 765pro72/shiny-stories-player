    "textFrame": "001",
    "voice": "produce_events/200102011/2001020110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ピーちゃんの写真か……、相変わらず\r\n元気そうだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001020110020,
    "speaker": "真乃",
    "text": "『お散歩をしていたら\r\n空にきれいな虹がかかっていました』",
