  {
    "id": 2018016110020,
    "speaker": "冬優子",
    "text": "……確かにふゆから誘ったことよ\r\nでも、そこまでしてほしいなんて頼んでない",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801611/2018016110020"
  },
  {
    "id": 2018016110030,
    "speaker": "冬優子",
    "text": "ふゆとの約束のせいで寝不足にさせるくらいなら\r\nいっそ約束しなきゃよかったって思うじゃない",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801611/2018016110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………はい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
