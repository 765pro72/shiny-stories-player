    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2018016110120,
    "speaker": "冬優子",
    "text": "……はい、おしまい。そういうわけで\r\n今日のあんたの予定は、午後しっかり休むこと",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
