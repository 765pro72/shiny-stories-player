    "voice": "produce_events/102300105/1023001050300"
  },
  {
    "id": 1023001050310,
    "speaker": "雛菜",
    "text": "あ、駅まで競争しよ～！\r\n負けた方がケーキ買うやつね～～～！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300105/1023001050310"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……いや、おい……！\r\n急になんでだ、雛菜！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023001050320,
    "speaker": "雛菜",
