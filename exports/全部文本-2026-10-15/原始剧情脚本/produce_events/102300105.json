    "textFrame": "001",
    "voice": "produce_events/102300105/1023001050260"
  },
  {
    "id": 1023001050270,
    "speaker": "雛菜",
    "text": "……雛菜、もうちょっとだけ頑張って、\r\nもっとしあわせ～になるね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
