    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300105/1023001050250"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからそれは……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023001050260,
    "speaker": "雛菜",
    "text": "あはは～～～～～",
    "charAnim1": "wait2",
