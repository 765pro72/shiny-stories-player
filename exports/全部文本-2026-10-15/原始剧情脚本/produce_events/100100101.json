    },
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1001001010070,
    "speaker": "？？？",
    "text": "アイドル……私がアイドルなんて……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100101/1001001010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "やあ、また会えたね\r\nアイドルの話、もう一度考えてみてほしいんだ",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0098"
  },
  {
    "speaker": "プロデューサー",
    "text": "君の中には光り輝くものがある\r\nアイドルになって、今までとは違う世界を見てみないか？",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001001010080,
    "speaker": "？？？",
    "text": "今までとは違う……",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100101/1001001010080"
  },
  {
    "id": 1001001010090,
    "speaker": "？？？",
    "text": "…………はい",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100101/1001001010090"
  },
  {
    "id": 1001001010100,
    "speaker": "？？？",
    "text": "私、アイドルやりますっ",
    "charAnim1": "wait4",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100101/1001001010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当？　よかった！！\r\n君の名前、聞いてもいいかな？",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001001010110,
    "speaker": "真乃",
    "text": "櫻木真乃、１6歳です\r\nこれからよろしくお願いしますね",
