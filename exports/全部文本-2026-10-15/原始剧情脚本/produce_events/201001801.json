    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010180"
  },
  {
    "id": 2010018010190,
    "speaker": "智代子",
    "text": "あっ、えっと、チョコのこともアイドルとしての活動では\r\nあるんですけど、そうではなく──！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ライブしたりとかってことだな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010018010200,
    "speaker": "智代子",
    "text": "それです……！",
