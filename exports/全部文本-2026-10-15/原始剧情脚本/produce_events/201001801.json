    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010170",
    "autoWaitTime": 1000
  },
  {
    "id": 2010018010180,
    "speaker": "智代子",
    "text": "でももちろん、アイドルとしての活動を\r\nしっかりやったうえでのことっていうのはわかっていて──",
