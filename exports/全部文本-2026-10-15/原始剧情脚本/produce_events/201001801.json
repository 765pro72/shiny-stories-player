    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010150"
  },
  {
    "id": 2010018010160,
    "speaker": "智代子",
    "text": "チョコに関わっている人たちの何かを\r\n少しでもプラスにできたらいいなって……！",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nそれが智代子の思う、チョコへの恩返しってことだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010018010170,
    "speaker": "智代子",
    "text": "はい……！",
