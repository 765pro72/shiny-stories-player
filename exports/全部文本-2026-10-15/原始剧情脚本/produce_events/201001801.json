    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010130"
  },
  {
    "id": 2010018010140,
    "speaker": "智代子",
    "text": "チョコができるまでの流れとか──\r\nカカオの問題とか、勉強してみたいと思ってます……！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001801/2010018010140"
  },
  {
    "id": 2010018010150,
    "speaker": "智代子",
    "text": "微力でしかないんですけど……！\r\n私が勉強して発信したり、行動することで──",
