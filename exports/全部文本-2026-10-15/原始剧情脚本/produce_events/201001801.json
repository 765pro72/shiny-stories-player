  {
    "id": 2010018010080,
    "speaker": "『chiyokoiro』",
    "text": "『難しいことなんですけど……目指せ全制覇というか、\r\nチョコに関する知識は突き詰めるぞと思っていて』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/201001801/2010018010080"
  },
  {
    "id": 2010018010090,
    "speaker": "『chiyokoiro』",
    "text": "『チョコアイドルにとって、\r\nチョコは一緒に戦うための武器であり相棒ですから』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/201001801/2010018010090"
  },
  {
    "id": 2010018010100,
    "speaker": "『chiyokoiro』",
    "text": "『失礼にならないように、全部知っていきたいんです』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/201001801/2010018010100"
  },
  {
    "id": 2010018010110,
    "speaker": "『chiyokoiro』",
    "text": "『あと、いつかチョコへの\r\n恩返しもできるといいなって！』──────",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/201001801/2010018010110"
  },
