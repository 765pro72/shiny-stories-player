  {
    "speaker": "プロデューサー",
    "text": "……やはり、次の現場入りは\r\nギリギリになってしまいそうだな",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
