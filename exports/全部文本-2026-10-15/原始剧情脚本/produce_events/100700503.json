  {
    "speaker": "プロデューサー",
    "text": "……いかがでしょうか？\r\n所属についてのお気持ちは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007005030050,
    "speaker": "結華",
    "text": "あっ、それはもう！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700503/1007005030050"
  },
  {
    "id": 1007005030060,
    "speaker": "結華",
    "text": "もともとアイドルが好きで──っていうのは\r\nこの間見られちゃってますよね",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700503/1007005030060"
  },
  {
    "id": 1007005030070,
    "speaker": "結華",
    "text": "なので興味自体は本当にあって、\r\n今お話を聞いて、ぜひやってみたいとも思いました",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700503/1007005030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当ですか！！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0327"
  },
  {
    "id": 1007005030080,
    "speaker": "結華",
    "text": "えっ",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700503/1007005030080",
    "autoWaitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……！　よかったぁ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
