    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201901/2002019010130"
  },
  {
    "id": 2002019010140,
    "speaker": "灯織",
    "text": "うまくできたような気がします",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201901/2002019010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、灯織もそう思えているなら何よりだ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019010150,
    "speaker": "灯織",
    "text": "これまで、教育番組の司会らしく見えるようにって\r\n慣れることに必死だったんですけど……",
