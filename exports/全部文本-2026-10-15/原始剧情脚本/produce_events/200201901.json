  {
    "speaker": "プロデューサー",
    "text": "ああ、俺はすごく良かったと思うぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019010120,
    "speaker": "灯織",
    "text": "ありがとうございます……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201901/2002019010120"
  },
  {
    "id": 2002019010130,
    "speaker": "灯織",
    "text": "私も今回はいつもより、ほんの少しだけ……",
