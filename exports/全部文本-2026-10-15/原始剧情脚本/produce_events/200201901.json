    "voice": "produce_events/200201901/2002019010310"
  },
  {
    "id": 2002019010320,
    "speaker": "灯織",
    "text": "プロデューサーをはじめ、周りの人たちに\r\nどれだけ助けられていたのか実感しました",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201901/2002019010320"
  },
