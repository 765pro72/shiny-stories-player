    "voice": "produce_events/200201901/2002019010150"
  },
  {
    "id": 2002019010160,
    "speaker": "灯織",
    "text": "私のおすすめの本の紹介ということもあって、\r\n少し肩の力を抜いて……進行できました",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
