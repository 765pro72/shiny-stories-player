    "textFrame": "001",
    "voice": "produce_events/201801703/2018017030320"
  },
  {
    "speaker": "プロデューサー",
    "text": "『待つよ、もちろん\r\nただ…………』",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "『俺の目から見た\r\n冬優子は……』",
    "nextLabel": "1"
