    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400902/2004009020110"
  },
  {
    "id": 2004009020120,
    "speaker": "恋鐘",
    "text": "み、みんなに配るやつ！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400902/2004009020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、なるほどなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大変だよな\r\nそういうの準備するの",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょうどいい感じのものって\r\nなかなか無いもんな",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004009020130,
    "speaker": "恋鐘",
    "text": "う、うん……！",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400902/2004009020130"
  },
  {
    "id": 2004009020140,
    "speaker": "恋鐘",
    "text": "雑誌とかで特集見とったばってん\r\n余計なんがよかかわからん～ってなって……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
