  {
    "speaker": "プロデューサー",
    "text": "円香は、みんなのことが好きなんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021004040150,
    "speaker": "円香",
    "text": "……好きとか嫌いとか、あえて考えたりしませんね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100404/2021004040150"
  },
  {
    "id": 2021004040160,
    "speaker": "円香",
    "text": "一緒にいるのが当たり前なので",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100404/2021004040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
