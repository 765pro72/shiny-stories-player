    "textFrame": "002"
  },
  {
    "id": 2002012030020,
    "speaker": "灯織",
    "text": "プロデューサー……お疲れ様です",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
