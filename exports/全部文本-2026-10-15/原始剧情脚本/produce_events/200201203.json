      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201203/2002012030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\n……灯織さ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もしかして、困ってるか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030030,
    "speaker": "灯織",
    "text": "……はい、ちょっと",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030030"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2002012030040,
    "speaker": "灯織",
    "text": "自分が、パートナーと一緒にいるだとか\r\nパートナーにはどういう態度をとるのかとか",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030040"
  },
  {
    "id": 2002012030050,
    "speaker": "灯織",
    "text": "全然、想像がつかなくて",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030050"
  },
  {
    "id": 2002012030060,
    "speaker": "灯織",
    "text": "…………",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030060",
    "autoWaitTime": 2200
  },
  {
    "id": 2002012030070,
    "speaker": "灯織",
    "text": "雑誌の撮影なのでセリフはないですし\r\n態度や表情だけで表現しなきゃと思ったら……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030070"
  },
  {
    "id": 2002012030080,
    "speaker": "灯織",
    "text": "『パートナーとふたり』という\r\n状況の正解がわからなくて",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど\r\n……そうだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織、パートナーってどういう人を想像してたんだ？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030090,
    "speaker": "灯織",
    "text": "どういう……？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんとなくなんだけど、\r\n恋人をイメージしてるんじゃないかと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030100,
    "speaker": "灯織",
    "text": "え？　違うんですか",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030100"
  },
  {
    "id": 2002012030110,
    "speaker": "灯織",
    "text": "だって、『ふたり』って\r\nカメラをその人と想定してって──",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうなんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もし恋人の想定だったら『恋人のつもりで』って\r\n言われるような気もしてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030120,
    "speaker": "灯織",
    "text": "恋人じゃない、パートナー……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織にも思い当たる人\r\nいるんじゃないかと思うんだけど、どうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030130,
    "speaker": "灯織",
    "text": "…………\r\nそれって",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030130"
  },
  {
    "id": 2002012030140,
    "speaker": "灯織",
    "text": "真乃とか、めぐるとか──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030140"
  },
  {
    "id": 2002012030150,
    "speaker": "灯織",
    "text": "そういうこと……ですか？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nそういうことだと思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030160,
    "speaker": "灯織",
    "text": "なるほど……",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030160",
    "autoWaitTime": 1300
  },
  {
    "speaker": "プロデューサー",
    "text": "特別に思ってる人でもいい\r\n一緒に何かを成そうとする相手でもいい",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏の縁側で、こんなふうに涼む\r\nその想像ができる相手なら、誰でも",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012030170,
    "speaker": "灯織",
    "text": "……はい",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030170"
  },
  {
    "id": 2002012030180,
    "speaker": "灯織",
    "text": "想像できる相手でいいなら\r\nどうにかなりそうです",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0328",
    "voice": "produce_events/200201203/2002012030180"
  },
  {
    "id": 2002012030190,
    "speaker": "灯織",
    "text": "真乃やめぐる相手なら、\r\n自分がどんなやりとりをするかわかりますし",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201203/2002012030190"
  },
  {
    "id": 2002012030200,
