[
  {
    "speaker": "プロデューサー",
    "text": "えーっと、乗り換えの電車は──これでいいみたいだな\r\nもうじき出発するみたいだし行こうか、真乃",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00136",
    "bgm": "0000"
  },
  {
    "id": 2001009040010,
    "speaker": "真乃",
    "text": "はいっ、プロデューサーさん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100904/2001009040010"
  },
  {
    "textFrame": "off"
  },
