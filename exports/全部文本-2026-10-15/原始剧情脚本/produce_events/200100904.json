      "time": 100
    },
    "voice": "produce_events/200100904/2001009040180"
  },
  {
    "id": 2001009040190,
    "speaker": "真乃",
    "text": "それにっ、私も最初寝ていたのでっ\r\nだから、その、気にしないでくださいっ",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100904/2001009040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ありがとう、真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009040200,
    "speaker": "真乃",
    "text": "い、いえっ\r\n本当に、そんな……",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
