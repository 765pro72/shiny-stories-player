    "voice": "produce_events/202201011/2022010110060"
  },
  {
    "id": 2022010110070,
    "speaker": "小糸",
    "text": "そ、その勢いで、お仕事しようって思って……！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201011/2022010110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、いい曲に出来上がったもんな\r\nあの時の小糸はイキイキしてたし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022010110080,
    "speaker": "小糸",
    "text": "……あ、あの、プロデューサーさん……",
