    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020030"
  },
  {
    "id": 2008005020040,
    "speaker": "霧子",
    "text": "すみません……\r\nプロデューサーさん……",
