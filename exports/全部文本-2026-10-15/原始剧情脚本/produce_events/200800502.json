      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200800502/2008005020300"
  },
  {
    "speaker": "プロデューサー",
    "text": "（つやつや……お水……？\r\n……あ、鉢植えを見てるのか）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0182",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2008005020310,
    "speaker": "霧子",
    "text": "『ゼラニウムさんと　いうのですが\r\n　お水をあげるのが　むずかしい子なんです』",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp_s",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020310"
  },
  {
    "id": 2008005020320,
    "speaker": "霧子",
    "text": "『お水を　たっぷりのんでくれますが\r\n　あげすぎると　元気がなくなります』",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020320"
  },
  {
    "speaker": "プロデューサー",
    "text": "（はは、霧子、\r\nメールだといつもよりたくさん話してくれるんだな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0106",
    "waitType": "time",
