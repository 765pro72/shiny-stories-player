    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、いや……\r\nただ気になっただけで……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008005020030,
    "speaker": "霧子",
    "text": "わたし……\r\n喉を痛めた……みたいです……",
