  {
    "id": 2008005020300,
    "speaker": "霧子",
    "text": "『つやつやで　とってもげんきです\r\n　でも　ちょっとお水がしんぱいです』",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
