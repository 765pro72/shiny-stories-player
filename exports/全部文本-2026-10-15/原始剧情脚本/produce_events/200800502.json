  {
    "se": "0106",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "『さすが、霧子は詳しいな\r\nゼラニウムさんのために、何か買って帰ろうか？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0182",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2008005020330,
    "speaker": "霧子",
    "text": "『ありがとうございます！\r\nでも　ゼラニウムさんは　とてもつよいので』",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020330"
  },
  {
    "id": 2008005020340,
    "speaker": "霧子",
    "text": "『とくべつなものをあげなくても　大丈夫です』",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800502/2008005020340"
  },
  {
    "speaker": "プロデューサー",
    "text": "（はは、よくしゃべる霧子って……\r\nちょっと不思議な感じがするな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0106",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "se": "0106",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "『わかった。じゃあ、何か飲み物でも買って戻るけど\r\n霧子の欲しいものはあるか？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
