  {
    "speaker": "プロデューサー",
    "text": "手を放していただけますか\r\n彼女は弊社のタレントです",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "0290"
  },
  {
    "id": 1026004030180,
    "speaker": "ルカ",
    "text": "……！",
