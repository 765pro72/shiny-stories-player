    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "114",
    "voice": "produce_events/102600403/1026004030130"
  },
  {
    "speaker": "記者",
    "text": "絶対話題になりますから\r\nあなたの事務所にとっても悪い話ではないでしょう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1026004030140,
    "speaker": "ルカ",
    "text": "！",
    "charAnim1": "surp2",
