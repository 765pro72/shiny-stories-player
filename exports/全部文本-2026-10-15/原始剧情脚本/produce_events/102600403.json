    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102600403/1026004030140"
  },
  {
    "speaker": "記者",
    "text": "お互いに、いい関係が築けると思うんですよ\r\n……ね？　斑鳩さん。賢く判断してください",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1769"
  },
