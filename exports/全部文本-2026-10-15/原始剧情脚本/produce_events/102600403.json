    "bg": "00000",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1026004030080,
    "speaker": "ルカ",
    "text": "（────そうだ\r\n今、騒ぎを起こしたら）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102600403/1026004030080"
  },
  {
    "textFrame": "off",
    "waitType": "time",
