  {
    "speaker": "他事務所の面接官",
    "text": "んー、長崎出身か……だから方言……\r\n──ねぇ、その方言って、すぐに直せる？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004003030020,
    "speaker": "恋鐘",
    "text": "ふぇ……？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
