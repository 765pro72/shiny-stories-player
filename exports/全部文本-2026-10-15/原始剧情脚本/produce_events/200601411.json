    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110070,
    "speaker": "咲耶",
    "text": "──あの時もそうだったんだけれどね",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110070"
  },
  {
    "id": 2006014110080,
    "speaker": "咲耶",
    "text": "今みたいに、嬉しいことがあった時\r\n私は──……",
    "charAnim1": "wait5",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110080"
  },
  {
    "id": 2006014110090,
    "speaker": "咲耶",
    "text": "どうやら私が思うより、\r\n緩んだ表情をしてしまうみたいなんだ",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110090"
  },
  {
    "id": 2006014110100,
    "speaker": "咲耶",
    "text": "だから、こう……コントロールできるように\r\n自分なりに練習を……",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから急にキリッとしたのか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110110,
    "speaker": "咲耶",
    "text": "うーん……すまない",
    "charAnim1": "sad1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110110"
  },
  {
    "id": 2006014110120,
    "speaker": "咲耶",
    "text": "ちょっと油断していて、\r\n対応が間に合わなかった",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110120"
  },
  {
    "id": 2006014110130,
    "speaker": "咲耶",
    "text": "急な変化と捉えられてしまうようでは\r\nまだまだ問題があるね",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや\r\nごめんだけど、咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "問題って言うなら、捉え方そのものにあるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110140,
    "speaker": "咲耶",
    "text": "……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110140"
  },
  {
    "id": 2006014110150,
    "speaker": "咲耶",
    "text": "……それは──……詳しく聞いても？",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう\r\nだって咲耶、表情を抑えることしか考えてないだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110160,
    "speaker": "咲耶",
    "text": "……？",
    "charAnim1": "wait1",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601411/2006014110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "普段どおりをキープしようとしなくていいんだ\r\n『思ったより緩んでる』って認識を改めよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──『ああ、こんなにいい顔してるんだ』ってさ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110170,
