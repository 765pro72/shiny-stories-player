  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nど、どうした……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014110050,
    "speaker": "咲耶",
    "text": "……ああ、ええと……",
