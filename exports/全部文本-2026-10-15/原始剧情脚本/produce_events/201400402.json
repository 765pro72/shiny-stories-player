    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400402/2014004020180"
  },
  {
    "id": 2014004020190,
    "speaker": "甘奈",
    "text": "プロデューサーさん、長く付き合わせちゃって悪いけど\r\nもう１回Ｂメロから聴いててもらえるかな？",
