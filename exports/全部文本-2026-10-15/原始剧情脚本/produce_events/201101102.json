    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101102/2011011020040"
  },
  {
    "id": 2011011020050,
    "speaker": "樹里",
    "text": "……けど、いつもだと\r\nこういうのはチョコ担当っつーか……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101102/2011011020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに\r\n樹里がひとりで食レポするのは珍しいかもな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011011020060,
    "speaker": "樹里",
    "text": "ああ",
    "charAnim1": "smile2",
