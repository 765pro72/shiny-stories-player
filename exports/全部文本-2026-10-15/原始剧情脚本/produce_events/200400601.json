    "textFrame": "001",
    "voice": "produce_events/200400601/2004006010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………\r\n……ふふっ、なんかおとなしいお姫様になったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004006010210,
