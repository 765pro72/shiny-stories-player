  },
  {
    "speaker": "カメラマン",
    "text": "オッケー、じゃあ次は……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……美琴、いい顔をしてるな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
