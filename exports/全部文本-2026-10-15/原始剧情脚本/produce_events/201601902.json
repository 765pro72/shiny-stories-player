  {
    "id": 2016019020080,
    "speaker": "千雪",
    "text": "僭越ながら、そちらは\r\n自作させていただいたものが、いくつかあるんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601902/2016019020080"
  },
  {
    "id": 2016019020090,
    "speaker": "千雪",
    "text": "桑山千雪という『個』を見せるのなら\r\n絶対に自分の手は入れるべきだと、考えたので",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601902/2016019020090"
  },
  {
    "speaker": "インタビュアー",
    "text": "随所に、アーティスト桑山千雪の\r\nこだわりが入っているわけですね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
