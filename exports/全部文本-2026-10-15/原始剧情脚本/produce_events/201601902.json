  {
    "speaker": "インタビュアー",
    "text": "では、最後に、桑山さんが\r\n目指していきたい自分、を教えてください",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2016019020100,
    "speaker": "千雪",
