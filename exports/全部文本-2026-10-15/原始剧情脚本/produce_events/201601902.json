    "voice": "produce_events/201601902/2016019020040"
  },
  {
    "id": 2016019020050,
    "speaker": "千雪",
    "text": "デザインを起こす段階から\r\n私の希望をいくつもお伝えして",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601902/2016019020050"
  },
  {
    "id": 2016019020060,
    "speaker": "千雪",
    "text": "これだ！　というものを\r\n作っていただきました",
