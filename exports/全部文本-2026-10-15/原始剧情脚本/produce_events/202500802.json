    "waitTime": 2000
  },
  {
    "speaker": "デザイナー",
    "text": "当たり前じゃない\r\n美琴くらい完璧な素材はそうそういないもの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "デザイナー",
    "text": "何着せても綺麗だし、映えるし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "デザイナー",
    "text": "そこにいて、ただ衣装を着て\r\n立っていてくれるだけでいいんだもの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00115",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "waitType": "time",
    "waitTime": 2000
  },
  {
