  },
  {
    "id": 1010003020060,
    "speaker": "智代子",
    "text": "『学校でのお仕事は、やっぱり特別ですね……！\r\nなんと言っても放クラなので！』",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "juri",
    "textCtrl": "p",
