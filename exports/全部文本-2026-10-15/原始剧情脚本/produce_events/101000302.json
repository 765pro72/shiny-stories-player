  },
  {
    "id": 1010003020110,
    "speaker": "智代子",
    "text": "──……よし",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101000302/1010003020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……今日の投稿は何にしたんだ？",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020120,
    "speaker": "智代子",
    "text": "えっとですね──",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020120"
  },
  {
    "id": 1010003020130,
    "speaker": "智代子",
    "text": "さっき控室で、凛世ちゃんと夏葉ちゃんに\r\n髪をいじってもらってた時の写真を……！",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、なるほど\r\n綺麗に結べてたもんなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020140,
    "speaker": "智代子",
    "text": "はい！\r\nえへへ、せっかくですから……！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020140"
  },
  {
    "id": 1010003020150,
    "speaker": "智代子",
    "text": "……ちなみにプロデューサーさんから見て、\r\n最近の内容っていかがでしょう……？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺がただのファンだったら嬉しいものばっかりだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyoko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "出演情報はちゃんとまとまってるし、\r\n当日にリマインドしてくれるし、オフショットもあるし──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あと、投稿頻度が上がってるのもシンプルに嬉しい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020160,
    "speaker": "智代子",
    "text": "……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101000302/1010003020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ただ、俺は他の人には見えないところも\r\n知っちゃってるから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これまでより負荷が上がってることに対して、\r\n若干心配をしてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020170,
    "speaker": "智代子",
    "text": "あ、あはははは……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "逆に聞かせてくれ\r\n本人としてはどう思ってる？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020180,
    "speaker": "智代子",
    "text": "……無理、ってラインまではいってないと思ってますよ\r\nあくまで、これまでより頑張ってる、の範囲です",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なるほど？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020190,
    "speaker": "智代子",
    "text": "あ～～…………",
    "charAnim2": "face_sad",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020200,
    "speaker": "智代子",
    "text": "……もうっ\r\n今日のプロデューサーさんは意地悪です……！",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020200"
  },
  {
    "id": 1010003020210,
    "speaker": "智代子",
    "text": "私たちは──いえ、私は！\r\nまだまだ知ってもらえていないんですから！",
    "charAnim2": "face_anger3",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020210"
  },
  {
    "id": 1010003020220,
    "speaker": "智代子",
    "text": "いっきに注目を集められる今のタイミングって\r\n逃すべきじゃないじゃないですか～～！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger3",
    "charLipAnim": "lip_anger",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000302/1010003020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nいや、すまんすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyoko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "頑張ってるのも、頑張りたいと思ってくれてるのも\r\n知ってるし、水を差すつもりはないんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ただ、ちょっとのことだったはずのものが、\r\n知らず知らずのうちに大変なことにならないように──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "息切れしないように、っていう念押しをしときたくてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020230,
    "speaker": "智代子",
    "text": "……プロデューサーさん……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101000302/1010003020230"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyoko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "……『G.R.A.D.』の告知があってから、\r\n少しずつではあるけど、またフォロワーが増えてきてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちゃんと結果がついてきてるってことだ\r\nだからこそ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分の状態は、しっかり把握しておくべきだと思うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003020240,
    "speaker": "智代子",
