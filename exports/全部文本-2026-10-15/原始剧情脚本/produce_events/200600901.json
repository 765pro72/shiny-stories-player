    "voice": "produce_events/200600901/2006009010140"
  },
  {
    "id": 2006009010150,
    "speaker": "咲耶",
    "text": "アハハハハッ！",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600901/2006009010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "さ、咲耶……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006009010160,
    "speaker": "咲耶",
    "text": "ああ、安心してほしい、変なところをぶつけたわけじゃない\r\n──ただ、これは……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600901/2006009010160"
  },
  {
    "id": 2006009010170,
    "speaker": "咲耶",
    "text": "……格好悪いなぁ、と思ってね",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600901/2006009010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2006009010180,
    "speaker": "咲耶",
    "text": "──ねえプロデューサー\r\n私の服、もうこんなに雪まみれになってしまったんだ",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600901/2006009010180"
  },
  {
    "id": 2006009010190,
    "speaker": "咲耶",
    "text": "せっかくだし、思い切り雪で遊びたいのだけど……\r\n……少しだけ、付き合ってはもらえないかな？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600901/2006009010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……付き合おう\r\n少しなんて言わず、こっちも本気でな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
