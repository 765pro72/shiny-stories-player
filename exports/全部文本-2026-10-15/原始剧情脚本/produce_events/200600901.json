  {
    "speaker": "プロデューサー",
    "text": "…………！？\r\nさ、咲耶！　大丈夫か──！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006009010120,
    "speaker": "咲耶",
    "text": "あ、ああ……",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
