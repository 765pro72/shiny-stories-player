    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200600901/2006009010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "痛くないか！？\r\nどこか怪我とかは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006009010130,
    "speaker": "咲耶",
    "text": "いや……うん、大丈夫…………\r\nどこも……なんとも……",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
