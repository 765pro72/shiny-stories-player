    "textFrame": "001",
    "voice": "produce_events/701700107/7017001070100"
  },
  {
    "id": 7017001070110,
    "speaker": "あさひ",
    "text": "だから、今のこの気持ちを……みんなに届けたいんす！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701700107/7017001070110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、俺も今からあさひのステージが楽しみだよ！",
