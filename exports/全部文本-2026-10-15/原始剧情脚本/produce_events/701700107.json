    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701700107/7017001070120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ここまで来たんだ\r\n『W.I.N.G.』、優勝しような！",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7017001070130,
    "speaker": "あさひ",
    "text": "はいっす！\r\nプロデューサーさん、見ててくださいっす！",
