    "text": "じゃあ、いってくるったい！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400102/1004001020230"
