[
  {
    "speaker": "プロデューサー",
    "text": "さて、恋鐘\r\n今日はアイドルとして初仕事なわけだけど……",
    "charAnim1": "wait1",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002",
