  },
  {
    "id": 1004001020280,
    "speaker": "恋鐘",
    "text": "……じゃあ、これで今日のキャンペーンは終わり～！\r\nみんな、ありがとーね！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
