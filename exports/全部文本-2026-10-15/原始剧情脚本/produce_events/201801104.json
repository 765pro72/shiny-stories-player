    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──みんなが冬優子を見てる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018011040030,
    "speaker": "冬優子",
    "text": "……──",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
