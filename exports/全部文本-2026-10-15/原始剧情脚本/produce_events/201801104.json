  {
    "id": 2018011040010,
    "speaker": "冬優子",
    "text": "……顔緩みすぎ\r\n今日から公開なんだもの、いるに決まってんでしょ",
    "charAnim1": "shrug",
    "charAnim2": "face_sad",
    "charAnim3": "mask_on",
