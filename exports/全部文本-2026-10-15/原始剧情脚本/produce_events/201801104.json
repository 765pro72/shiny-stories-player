  },
  {
    "id": 2018011040120,
    "speaker": "冬優子",
    "text": "……結局説明することになってふゆがバカみたいじゃない",
    "charLipAnim": "lip_jito",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801104/2018011040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ご、ごめんな……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018011040130,
    "speaker": "冬優子",
    "text": "だから、これ以上いたたまれなくしないで\r\nって言ってんの！",
    "charAnim1": "anger3",
