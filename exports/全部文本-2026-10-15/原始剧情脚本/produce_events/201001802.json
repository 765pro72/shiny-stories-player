      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "司会",
    "text": "ブランドムービーへのご出演も印象に残っています",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2010018020010,
    "speaker": "智代子",
    "text": "ありがとうございます……！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
