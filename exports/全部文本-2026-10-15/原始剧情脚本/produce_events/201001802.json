    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "日本店の責任者",
    "text": "カカオ生産国の社会課題について\r\n考えていらっしゃったり",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0888"
  },
  {
    "speaker": "日本店の責任者",
    "text": "サステナブルカカオの考え方が\r\n多くの人に届くよう力を尽くしていらっしゃったり",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "日本店の責任者",
    "text": "チョコレートに関わる業界を\r\n豊かにしようとする努力が伝わってくる",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "2394"
  },
  {
    "textFrame": "off",
    "bg": "00441",
    "bgEffect": "fade",
