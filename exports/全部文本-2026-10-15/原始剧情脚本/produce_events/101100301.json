      "time": 100
    },
    "voice": "produce_events/101100301/1011003010010"
  },
  {
    "id": 1011003010020,
    "speaker": "樹里",
    "text": "や、なんでこのラジオネームにしようと思ったんだよ！\r\nいいけどさ……メッセージ、ありがとな！",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010020"
  },
  {
    "id": 1011003010030,
    "speaker": "樹里",
    "text": "『樹里ちゃん、単独ラジオ決定おめでとう！』\r\nおー、ありがとな！　聴いてるかー？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010030"
  },
  {
    "id": 1011003010040,
    "speaker": "樹里",
    "text": "『最近、樹里ちゃんの活躍ぶりに驚いています\r\n全部追いかけたいけど、それが大変なくらい（笑）』",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010040"
  },
  {
    "id": 1011003010050,
    "speaker": "樹里",
    "text": "『樹里ちゃんが色々なことに挑戦してくれて、前よりも\r\n積極的に活動してくれてる感じがしてすごく嬉しい！』",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010050"
  },
  {
    "id": 1011003010060,
    "speaker": "樹里",
    "text": "『忙しいと思うけど、病気や怪我に気を付けて、\r\nいつも素敵な樹里ちゃんでいてね』",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010060"
  },
  {
    "id": 1011003010070,
    "speaker": "樹里",
    "text": "『これからも応援しています！』",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010070"
  },
  {
    "id": 1011003010080,
    "speaker": "樹里",
