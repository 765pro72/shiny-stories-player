  {
    "id": 1011003010090,
    "speaker": "樹里",
    "text": "ん～……今回この番組に送ってもらったメッセージもだし\r\n事務所の方に送ってくれる手紙とかもそうなんだけど",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
