    "voice": "produce_events/101100301/1011003010210"
  },
  {
    "id": 1011003010220,
    "speaker": "樹里",
    "text": "アタシ個人のこと、放課後クライマックスガールズのこと\r\n質問、感想、相談などなんでも募集してます",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010220"
  },
  {
    "id": 1011003010230,
    "speaker": "樹里",
    "text": "次回はラジオ本番中に『生電話』をするってことなので\r\n番組公式サイトから応募してくれよな！",
