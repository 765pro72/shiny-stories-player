    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101100301/1011003010090"
  },
  {
    "id": 1011003010100,
    "speaker": "樹里",
    "text": "みんな必ず、『身体に気を付けて』とか\r\n『怪我しないでね』とか心配してくれてて……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010100"
  },
  {
    "id": 1011003010110,
    "speaker": "樹里",
    "text": "いつも、そういうのを、すごくありがたいと思ってる\r\n……けど、なかなか感謝を伝えられなかったりとかさ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010110"
  },
  {
    "id": 1011003010120,
    "speaker": "樹里",
    "text": "こうやってすげーいい言葉をかけてもらってるのに\r\nなんにも返せてないなーって思ったりして",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010120"
  },
  {
    "id": 1011003010130,
    "speaker": "樹里",
    "text": "だからこそ、もっと頑張って色んなことに挑戦していこう\r\nって思ってたりするんだけど",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010130"
  },
  {
    "id": 1011003010140,
    "speaker": "樹里",
    "text": "それで今回、こうやって自由に話せるラジオを３回も、\r\nしかもひとりでやらせてもらえるってことなので",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100301/1011003010140"
  },
  {
    "id": 1011003010150,
    "speaker": "樹里",
    "text": "その中でもみんなに\r\n……色々、伝えていけたらなって思うよ",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
