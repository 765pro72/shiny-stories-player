  {
    "id": 1011003010210,
    "speaker": "樹里",
    "text": "次回に向けての、お便り、メールもお待ちしてます\r\n放送日程と合わせて公式サイトでご確認下さい",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
