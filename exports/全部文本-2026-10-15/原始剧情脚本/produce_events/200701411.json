    "waitTime": 1500
  },
  {
    "id": 2007014110070,
    "speaker": "結華",
    "text": "『もしもーし？　プロデューサー？\r\nこれを聞いてるってことはお仕事は終わってるね？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701411/2007014110070"
  },
  {
    "id": 2007014110080,
    "speaker": "結華",
    "text": "『お疲れ様～！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701411/2007014110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2007014110090,
    "speaker": "結華",
    "text": "『今日夜までめちゃめちゃ詰まってたけど\r\nへろへろになってない？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701411/2007014110090"
  },
  {
    "id": 2007014110100,
    "speaker": "結華",
    "text": "『とにかくご飯はちゃんと食べなきゃダメだよー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701411/2007014110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "（……これ、なんの用事で……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014110110,
    "speaker": "結華",
    "text": "『あとはホットアイマスク使って休息とるのも\r\nおすすめかな！』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/200701411/2007014110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（これ……！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014110120,
    "speaker": "結華",
    "text": "『察しのいいプロデューサーは、そろそろこの電話が\r\nなんの用件もないということに気付いているかと思います』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "127",
    "voice": "produce_events/200701411/2007014110120"
  },
  {
    "id": 2007014110130,
    "speaker": "結華",
    "text": "『お疲れだったらもう切って平気だよ～\r\n悪ふざけに付き合ってくれてありがとう！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701411/2007014110130"
  },
  {
