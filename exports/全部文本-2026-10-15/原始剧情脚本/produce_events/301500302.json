    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500302/3015003020550"
  },
  {
    "id": 3015003020560,
    "speaker": "甘奈",
    "text": "甜花ちゃんが『もっと良くなりそう』って言ったからだよ\r\nそのヒラメキ、天才的☆",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500302/3015003020560"
  },
  {
    "id": 3015003020570,
    "speaker": "甜花",
    "text": "そ、そんなこと、ないよ……\r\nにへへ……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500302/3015003020570"
  },
  {
    "id": 3015003020580,
    "speaker": "甘奈",
    "text": "それに……\r\nこの髪飾りなら、世界でひとつだけのプレゼントになるねっ☆",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500302/3015003020580"
  },
  {
    "id": 3015003020590,
    "speaker": "甜花",
    "text": "世界で、ひとつだけ……？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500302/3015003020590"
  },
  {
    "id": 3015003020600,
    "speaker": "甘奈",
    "text": "うん！　甘奈たちは千雪さんみたいに、\r\nかわいー小物を作ったりできないけど……",
