    "voice": "produce_events/101600401/1016004010020"
  },
  {
    "id": 1016004010030,
    "speaker": "千雪",
    "text": "す、すみません\r\n気がつかなくって……",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、構わないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ずいぶん集中してたみたいだけど、\r\n何を聴いていたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
