  },
  {
    "id": 1016004010290,
    "speaker": "千雪",
    "text": "ライブに向けて、\r\nそんな気持ちを込めてみたんです",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
