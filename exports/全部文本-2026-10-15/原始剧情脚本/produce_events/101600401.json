  {
    "id": 1016004010280,
    "speaker": "千雪",
    "text": "『始まりじゃないけど、始まり――』",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
