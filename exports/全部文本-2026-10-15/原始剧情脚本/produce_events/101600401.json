    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………お、アルストロメリアの曲も入れてあるのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004010150,
    "speaker": "千雪",
    "text": "はい……！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600401/1016004010150"
  },
  {
    "id": 1016004010160,
    "speaker": "千雪",
    "text": "今まで自分達の曲を入れるのは、\r\nなんだか、こそばゆいような……",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010160"
  },
  {
    "id": 1016004010170,
    "speaker": "千雪",
    "text": "落ち着かないような気がして、\r\nできなかったんですが……",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010170"
  },
  {
    "id": 1016004010180,
    "speaker": "千雪",
    "text": "今回は思い切って",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "――７曲目に入れたのは、\r\nラッキーセブンってことか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004010190,
    "speaker": "千雪",
    "text": "ふふっ、確かに……！\r\nラッキーセブンですね",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010190"
  },
  {
    "id": 1016004010200,
    "speaker": "千雪",
    "text": "でも、今回はそうではなくて――",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010200"
  },
  {
    "id": 1016004010210,
    "speaker": "千雪",
    "text": "私の好きなアーティストのアルバム、\r\n７曲目くらいに、いいな……って思う曲が入ってるんです",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010210"
  },
  {
    "id": 1016004010220,
    "speaker": "千雪",
    "text": "偶然かな、って思ってたんですけど……",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010220"
  },
  {
    "id": 1016004010230,
    "speaker": "千雪",
    "text": "『カセットテープのＢ面、その１曲目に\r\nどんな曲を入れるのか、いつも悩んだものだった』",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010230"
  },
  {
    "id": 1016004010240,
    "speaker": "千雪",
    "text": "『だからだろうか、\r\nテープがすたれた今でも……』",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010240"
  },
  {
    "id": 1016004010250,
    "speaker": "千雪",
    "text": "『私はそこに、\r\n始まりじゃないけど、始まり……っていう曲を入れている』",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010250"
  },
  {
    "id": 1016004010260,
    "speaker": "千雪",
    "text": "アーティストの方が、\r\nそうお話ししているインタビューを見つけて……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010260"
  },
  {
    "id": 1016004010270,
    "speaker": "千雪",
    "text": "ああ、今の私の気持ちにぴったりだなって",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
