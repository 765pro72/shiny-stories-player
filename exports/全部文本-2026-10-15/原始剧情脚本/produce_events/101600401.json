    "waitTime": 1500
  },
  {
    "id": 1016004010040,
    "speaker": "千雪",
    "text": "お留守番している間に、\r\nプレイリストを作っていたんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600401/1016004010040"
  },
  {
    "id": 1016004010050,
    "speaker": "千雪",
    "text": "気持ちを高めて、気合いを入れられるような……",
    "charAnim2": "face_close2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010050"
  },
  {
    "id": 1016004010060,
    "speaker": "千雪",
    "text": "アルストロメリアのワンマンライブに向けて、\r\nいろいろ、整えていきたくて",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010060"
  },
  {
    "id": 1016004010070,
    "speaker": "千雪",
    "text": "どんな感じかなぁ……って、\r\n通しで聴いてみていて、それで",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "アスリートも、大会の前にお気に入りの曲を聴いて\r\nテンション上げるっていうもんな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "どんな曲が入ってるんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1016004010080,
    "speaker": "千雪",
    "text": "えっと、こんな感じなんですけど――",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010080"
  },
  {
    "textFrame": "off",
    "se": "0152",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "どれどれ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1016004010090,
    "speaker": "千雪",
    "text": "……って、お見せするの、\r\nなんだか恥ずかしいですね……！",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600401/1016004010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうものか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004010100,
    "speaker": "千雪",
    "text": "そういうものです……！",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010100"
  },
  {
    "id": 1016004010110,
    "speaker": "千雪",
    "text": "部屋の本棚やＤＶＤのコレクションを見られたりするのも、\r\n私は少し照れちゃうんですけど……",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010110"
  },
  {
    "id": 1016004010120,
    "speaker": "千雪",
    "text": "それと似たような感じと言いますか……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010120"
  },
  {
    "id": 1016004010130,
    "speaker": "千雪",
    "text": "…………",
    "charAnim2": "face_shy",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010130"
  },
  {
    "id": 1016004010140,
    "speaker": "千雪",
    "text": "自分の趣味というか、好みというかが……\r\n生々しい裸の状態で、そこにある気がして……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600401/1016004010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……\r\n千雪のリストを見てると、ひとつの世界って気がするし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "半端に触れられたくない気持ちは、\r\nわかるような気がするな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
