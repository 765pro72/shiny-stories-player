  {
    "speaker": "プロデューサー",
    "text": "お疲れ様",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003050350,
    "speaker": "智代子",
    "text": "はいっ、お疲れ様です……！\r\nお付き合いいただいてありがとうございました！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
