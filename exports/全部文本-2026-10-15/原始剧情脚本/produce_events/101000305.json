  {
    "id": 1010003050010,
    "speaker": "智代子",
    "text": "『本日20時から、ツイスタで生配信を行います！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000305/1010003050010"
  },
  {
    "id": 1010003050020,
    "speaker": "智代子",
    "text": "『オーディションのことについて、\r\nお話ができたらいいなぁって思っておりますよ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000305/1010003050020"
  },
  {
    "id": 1010003050030,
    "speaker": "智代子",
    "text": "『お時間がありましたら！\r\nぜひ！　チェックしてみてくださいね～！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000305/1010003050030"
  },
