    "speaker": "プロデューサー",
    "text": "うん──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6028001090110,
    "speaker": "はるき",
    "text": "いままで、すごく大変だったこととか\r\nたくさん浮かんできて……",
