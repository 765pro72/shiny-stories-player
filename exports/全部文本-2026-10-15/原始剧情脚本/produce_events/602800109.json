    "voice": "produce_events/602800109/6028001090030"
  },
  {
    "id": 6028001090040,
    "speaker": "はるき",
    "text": "この手は、歌うように踊れたかなって",
    "charAnim1": "think",
    "charAnim2": "face_close",
