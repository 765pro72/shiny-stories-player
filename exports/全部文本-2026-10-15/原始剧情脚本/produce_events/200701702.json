    "text": "……覚えた方がいいと思いまーす",
    "charAnim1": "wait3",
    "charAnim2": "face_jito",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
