  {
    "speaker": "プロデューサー",
    "text": "そうかもしれないけど──\r\nやっぱり自分には縁がないからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "すごいなって\r\nあと、長くてさらさらで綺麗だよな、髪",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007017020160,
    "speaker": "結華",
    "text": "っ、……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
