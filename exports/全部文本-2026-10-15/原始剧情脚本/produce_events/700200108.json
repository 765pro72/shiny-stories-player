    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/700200108/7902001080010"
  },
  {
    "id": 7901001080030,
    "speaker": "はづき",
    "text": "……私、きっとあの子のファンだったんですね\r\nだからこの結果が、悔しくてたまらないんです……",
