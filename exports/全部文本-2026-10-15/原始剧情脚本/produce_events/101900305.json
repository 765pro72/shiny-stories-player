  },
  {
    "id": 1019003050130,
    "speaker": "愛依",
    "text": "プロデューサー的にはこれ、\r\nあんま良くなかった？",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050130"
  },
  {
    "id": 1019003050140,
    "speaker": "愛依",
    "text": "うちは結構いいカンジだと\r\n思ったんだけど……",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050140"
  },
  {
    "id": 1019003050150,
    "speaker": "愛依",
    "text": "そんじゃ、\r\nもう一回撮りなおして──……",
    "charAnim1": "anger2",
    "charAnim2": "face_anger1",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050150"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、そうじゃないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050160,
    "speaker": "愛依",
    "text": "へ？",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "その写真もすごく良かったと思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、そんなに無理して\r\n笑うのを我慢しなくてもいいんじゃないかって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050170,
    "speaker": "愛依",
    "text": "えっ、けどそれじゃ──……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050170"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依がキャラを守って\r\n大切にしてくれてるのはわかる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050180,
    "speaker": "愛依",
    "text": "う、うん……！",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからこそ、そんな愛依に\r\nプロデューサーとして伝えたいことがある",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050190,
    "speaker": "愛依",
    "text": "えっ！？　何なに！？",
    "charAnim1": "anger1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050190"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ギャップは間違いなく、ウケる！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050200,
    "speaker": "愛依",
    "text": "………………",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050200"
  },
  {
    "id": 1019003050210,
    "speaker": "愛依",
    "text": "……へ……？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050210"
  },
  {
    "speaker": "プロデューサー",
    "text": "普段クールでミステリアスな印象の愛依が\r\nここぞというところで笑顔の写真をあげたら……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "間違いなく話題になる！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だから俺としては\r\n最初に撮ってた笑顔の写真も捨てがたい！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう思ってさ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050220,
    "speaker": "愛依",
    "text": "…………っ",
