    "speaker": "プロデューサー",
    "text": "なんだ、愛依\r\n信じてないのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050250,
    "speaker": "愛依",
    "text": "いやいや、そういうワケじゃ\r\nないけどさ～！",
    "charAnim1": "sad2",
