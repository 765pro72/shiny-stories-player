  {
    "speaker": "プロデューサー",
    "text": "……愛依、写真撮ろうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050020,
    "speaker": "愛依",
    "text": "ん～……",
    "charAnim1": "shy1",
