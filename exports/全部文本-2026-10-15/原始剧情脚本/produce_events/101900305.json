    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050220"
  },
  {
    "id": 1019003050230,
    "speaker": "愛依",
    "text": "アッハハ\r\n真剣な顔するから何言うのかと思ったら……",
