    },
    "voice": "produce_events/101900305/1019003050020"
  },
  {
    "id": 1019003050030,
    "speaker": "愛依",
    "text": "や、大丈夫！\r\nちょっと表情研究中～っていうか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050030"
  },
  {
    "id": 1019003050040,
    "speaker": "愛依",
    "text": "なんかいまいちキマんなくてさー",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……さっきのも\r\nかなり良かったと思うけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003050050,
    "speaker": "愛依",
    "text": "えっ、いやいや\r\nにこ～って笑いすぎでしょ！",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050050"
  },
  {
    "id": 1019003050060,
    "speaker": "愛依",
    "text": "あれじゃ『ミステリアスキャラ』じゃないって！",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050060"
  },
  {
    "id": 1019003050070,
    "speaker": "愛依",
    "text": "もっとクールなカンジでキメないと……\r\n角度のせいかな～……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900305/1019003050070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
