  {
    "id": 2003006020100,
    "speaker": "めぐる",
    "text": "すみっこに隠れて……\r\nなんだかひとりぼっちみたい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるには寂しそうに見える？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020110,
    "speaker": "めぐる",
    "text": "ん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2003006020120,
    "speaker": "めぐる",
    "text": "……ううん、わたしにはわからないよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020120"
  },
  {
    "id": 2003006020130,
    "speaker": "めぐる",
    "text": "この魚の気持ちは、\r\nこの魚にしかわからないもん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020130"
  },
  {
    "id": 2003006020140,
    "speaker": "めぐる",
    "text": "寂しいとか悲しいとか、\r\n一言で言えるのかどうかも……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020140"
  },
  {
    "id": 2003006020150,
    "speaker": "めぐる",
    "text": "もしかしたら、\r\n自分も他の魚と同じ色だったらって思ってるかも……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020150"
  },
  {
    "id": 2003006020160,
    "speaker": "めぐる",
    "text": "だけど、でも……だから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020160"
  },
  {
