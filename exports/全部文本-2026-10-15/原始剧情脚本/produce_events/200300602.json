    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ここに『初心者向け』って書いてあるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020250,
    "speaker": "めぐる",
    "text": "初心者向け……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
