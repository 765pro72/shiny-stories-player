      "time": 100
    },
    "voice": "produce_events/200300602/2003006020040"
  },
  {
    "id": 2003006020050,
    "speaker": "めぐる",
    "text": "！　プロデューサー\r\nこのお店の中、魚がいるよ！",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
