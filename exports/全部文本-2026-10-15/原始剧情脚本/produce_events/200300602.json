    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "気にするほどの寝癖じゃない\r\nあとでスタイリストさんに直してもらおう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
