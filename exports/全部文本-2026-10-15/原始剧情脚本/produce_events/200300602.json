  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nなんだかいいな。この魚",
    "textCtrl": "p",
    "textFrame": "002"
  },
