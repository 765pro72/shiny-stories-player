    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "いざとなったら事務所に持っていくでも……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020260,
    "speaker": "めぐる",
    "text": "事務所かー……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020260"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n魚ってそんなに難しいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020270,
    "speaker": "めぐる",
    "text": "生き物のこと、簡単に考えたらいけないよーっ？",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020270"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまん、そういうつもりじゃないんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、そろそろスタッフさんが到着する時間かな！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "魚のことはお店の人にちゃんと相談するとして……\r\n今は仕事だ、めぐる！",
