    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる、そこは鏡じゃなくてお店のガラスだぞ\r\nお店の人がびっくりしちゃうだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020040,
    "speaker": "めぐる",
    "text": "ああっ、そうだよね！\r\nつい……！",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
