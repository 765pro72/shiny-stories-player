    "charAnim2": "face_shy",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020210"
  },
  {
    "id": 2003006020220,
    "speaker": "めぐる",
    "text": "この水槽以外の水槽もあるんだよって\r\n教えてあげたいよ……！",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300602/2003006020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、わかった！\r\nじゃあ仕事が終わったらもう一度来てみよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003006020230,
    "speaker": "めぐる",
    "text": "わー……うんっ……！",
