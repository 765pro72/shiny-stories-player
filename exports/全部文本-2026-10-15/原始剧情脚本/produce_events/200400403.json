    "speaker": "プロデューサー",
    "text": "……恋鐘",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030400,
    "speaker": "恋鐘",
    "text": "よし！　そうと決まれば早よ戻らんね！\r\nおーい、タクシー！　あ、ちょうど止まったばい！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
