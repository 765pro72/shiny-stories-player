    }
  },
  {
    "id": 2004004030010,
    "speaker": "恋鐘",
    "text": "んふふ～、ありがと～！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030010"
  },
  {
    "speaker": "プロデューサー",
    "text": "腹、減っただろ？\r\nちょっと遅くなったけど昼飯にしようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030020,
    "speaker": "恋鐘",
    "text": "うん！　……あ、じゃあ今日はお礼ばさせて！\r\nこの前、ぐちゃぐちゃのお弁当……食べてくれたけんね",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030020"
  },
  {
    "id": 2004004030030,
    "speaker": "恋鐘",
    "text": "リベンジのタイミングもなかなか合わんし、\r\n今日はうちがお昼ご馳走するけん！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030030"
  },
  {
    "id": 2004004030040,
    "speaker": "恋鐘",
    "text": "なんでもリクエストして！\r\nふたりでリッチに外食ばい！",
    "charAnim1": "anger1",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ありがとな\r\nでも、担当アイドルに奢ってもらうわけにもなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030050,
    "speaker": "恋鐘",
    "text": "え～、そんなこと言わんとご馳走させて～！\r\nうち、ちょっと節約しとるけん、今月はリッチばい！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……だったら、俺が恋鐘にご馳走して、\r\n恋鐘は俺にご馳走するっていうのはどうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030060,
    "speaker": "恋鐘",
    "text": "ん？\r\n……それってうちがご馳走したことに……なるん？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、なるって思うぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030070,
    "speaker": "恋鐘",
    "text": "なると？　じゃあ、それでよか！\r\nんふふ～、プロデューサーとご飯～♪",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030070"
  },
  {
    "id": 2004004030080,
    "speaker": "恋鐘",
    "text": "なんば食べたいと？\r\nお礼なんやけんプロデューサーが決めてよかよ～！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、じゃあ、そうだな……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "洋食がいいかな",
    "nextLabel": "1"
  },
  {
    "select": "和食にしよう",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "中華はどうだ？",
    "nextLabel": "3"
  },
  {
    "id": 2004004030090,
    "label": "1",
    "speaker": "恋鐘",
    "text": "洋食か～\r\nじゃあ、オムライス食べに行こ！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいけど、なんでオムライスなんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030100,
    "speaker": "恋鐘",
    "text": "んふふ～、うちがケチャップで『お疲れ様』とか\r\n似顔絵とか描いちゃろと思って！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘、ケチャップはかかった状態で出てくると思うぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030110,
    "speaker": "恋鐘",
    "text": "うちの店は、自分でかけとったばい\r\nよく描いたんよ～……",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、恋鐘のご実家か……\r\n定食屋さんだもんな",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030130,
    "speaker": "恋鐘",
    "text": "そうたい！\r\n長崎一……日本一うまか店とよ",
    "charAnim1": "smile3",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030130"
  },
  {
    "id": 2004004030140,
    "speaker": "恋鐘",
    "text": "……食べたか、オムライス",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……恋鐘？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030150,
    "speaker": "恋鐘",
    "text": "あ、ここはどげんね！\r\nオムライスの絵が描いてあるばい！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、専門店みたいだな\r\nじゃあ入ってみ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0103",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──と、着信だ\r\n悪いけど、ちょっと待っててくれ",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "kogane",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0106",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "もしもし、はい……はい、\r\n……わかりました……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off",
    "se": "0106",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2004004030160,
    "speaker": "恋鐘",
    "text": "なんね～？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200400403/2004004030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘、すまん……\r\n急ぎの仕事で……すぐに出なきゃいけない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004030170,
    "speaker": "恋鐘",
    "text": "そ、そうなんやね～！\r\n仕事ならしょうがなか！　忙しいんやもん",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030170"
  },
  {
    "id": 2004004030180,
    "speaker": "恋鐘",
    "text": "ばってん、それやとプロデューサーお腹空くばい～……\r\nあ！　じゃあ、2分！　2分待っとって！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400403/2004004030180"
  },
