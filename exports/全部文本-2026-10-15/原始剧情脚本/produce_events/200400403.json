  {
    "id": 2004004030370,
    "speaker": "恋鐘",
    "text": "あ、さっきの取材のやつ？　見せて見せて！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
