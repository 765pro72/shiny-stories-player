    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010650"
  },
  {
    "id": 3003005010660,
    "speaker": "めぐる",
    "text": "だから、こちらこそ、ね？　……って、あれっ！？\r\nもうこんな時間！　灯織大変、早く事務所に行かなきゃ！",
