    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010550"
  },
  {
    "id": 3003005010560,
    "speaker": "めぐる",
    "text": "……えへへ、ちゃんといつも通りだね\r\nまた灯織の元気な顔が見れて、本当に良かった",
