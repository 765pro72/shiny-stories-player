    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010610"
  },
  {
    "id": 3003005010620,
    "speaker": "灯織",
    "text": "こ、こちらこそって……\r\nお礼を言うのは、私の方で……",
