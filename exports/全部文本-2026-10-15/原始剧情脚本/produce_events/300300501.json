  {
    "id": 3003005010100,
    "speaker": "めぐる",
    "text": "楽しみだねー、真乃のおかゆ！",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
