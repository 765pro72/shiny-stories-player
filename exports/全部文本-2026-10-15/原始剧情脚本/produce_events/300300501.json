    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010600"
  },
  {
    "id": 3003005010610,
    "speaker": "めぐる",
    "text": "……ううん！　こちらこそ！",
