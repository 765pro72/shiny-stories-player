    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010210",
    "charAnim1Loop": false
  },
  {
    "id": 3003005010220,
    "speaker": "めぐる",
    "text": "ごめん、お話できたのが嬉しくて、\r\nわたしちょっとはしゃぎすぎちゃったかも",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010220"
  },
  {
    "id": 3003005010230,
    "speaker": "めぐる",
    "text": "今はゆっくり休まなきゃだよね",
