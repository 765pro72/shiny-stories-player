    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010590"
  },
  {
    "id": 3003005010600,
    "speaker": "灯織",
    "text": "……あ、ありがとう\r\n今日、家に来てくれて……それに、お見舞いも……",
