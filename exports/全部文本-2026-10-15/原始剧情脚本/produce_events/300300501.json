    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010630"
  },
  {
    "id": 3003005010640,
    "speaker": "めぐる",
    "text": "ちゃんとお話ができたのは灯織のおかげだもん\r\nわたしも真乃も、ありがとうって思ってるよ",
