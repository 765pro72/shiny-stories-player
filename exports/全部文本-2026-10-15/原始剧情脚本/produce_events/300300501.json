  },
  {
    "id": 3003005010110,
    "speaker": "めぐる",
    "text": "もうちょっとしたら、こっちの部屋にも\r\nいい匂いがしてくるのかなぁ",
    "charAnim1": "wait",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010110"
  },
  {
    "id": 3003005010120,
    "speaker": "灯織",
    "text": "もう、めぐるは食べないでしょ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010120"
  },
  {
    "id": 3003005010130,
    "speaker": "灯織",
    "text": "……ふたりも頑張ってるし、\r\n私も、これからもっと頑張らなくちゃ",
    "charAnim1": "wait",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010130"
  },
  {
    "id": 3003005010140,
    "speaker": "めぐる",
    "text": "ストップストップ！\r\n灯織がまず頑張るのは体調を戻すことだよ？",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010140"
  },
  {
    "id": 3003005010150,
    "speaker": "めぐる",
    "text": "今日から張りきって無理とかしたらダメだからねっ？",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010150"
  },
  {
    "id": 3003005010160,
    "speaker": "灯織",
    "text": "それは……分かってる……けど",
    "charAnim1": "wait",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010160"
  },
  {
    "id": 3003005010170,
    "speaker": "めぐる",
    "text": "えへへー、それならいいんだっ\r\nわたしも真乃も、早く灯織と一緒にレッスンしたいんだもん",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010170"
  },
  {
    "id": 3003005010180,
    "speaker": "めぐる",
    "text": "きっとすぐに３人で揃えられるようになるから、\r\n１番のターンも、２番の移動もババッと決めちゃって──",
    "charAnim1": "wait",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010180"
  },
  {
    "id": 3003005010190,
    "speaker": "灯織",
    "text": "そう……だね……",
    "charAnim1": "wait",
