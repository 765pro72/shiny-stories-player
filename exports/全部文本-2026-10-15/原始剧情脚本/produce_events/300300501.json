    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010230"
  },
  {
    "id": 3003005010240,
    "speaker": "めぐる",
    "text": "わたしも真乃も、そばにいるから\r\n……えーと、安心してくれたら嬉しいなっ",
