    "charLipAnim": "lip_wait",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300501/3003005010580"
  },
  {
    "id": 3003005010590,
    "speaker": "灯織",
    "text": "……\r\nあの……",
