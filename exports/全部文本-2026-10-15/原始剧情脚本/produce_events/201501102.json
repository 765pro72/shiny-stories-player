  {
    "speaker": "プロデューサー",
    "text": "甜花、どうしたんだ？　こんな時間に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020040,
    "speaker": "甜花",
    "text": "『あ、えと……その……\r\n用事とか、じゃなくて……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020040"
  },
  {
    "id": 2015011020050,
    "speaker": "甜花",
    "text": "『プロデューサーさん……\r\n今、おうち……？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、家の最寄駅だよ\r\nこれから帰るところだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020060,
    "speaker": "甜花",
    "text": "『え、あ……\r\n……お疲れ様、です……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ありがとう\r\n……甜花はちゃんと家にいるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020070,
    "speaker": "甜花",
    "text": "『うん……なーちゃん、寝ちゃったから……\r\nお布団被って……電話、してる……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、それがいいな\r\n甘奈を起こしちゃいけないし、偉いぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020080,
    "speaker": "甜花",
    "text": "『にへへ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020080"
  },
  {
    "id": 2015011020090,
    "speaker": "甜花",
    "text": "『…………プロデューサーさんの、ハート……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020100,
    "speaker": "甜花",
    "text": "『くれたの、初めてで……\r\nちょっと、びっくりした……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501102/2015011020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、ゲームのか……\r\nやり方、あんまりよくわかってなかったからな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011020110,
    "speaker": "甜花",
    "text": "『にへへ……』",
