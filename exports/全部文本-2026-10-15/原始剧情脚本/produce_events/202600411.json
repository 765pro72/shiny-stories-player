  {
    "speaker": "プロデューサー",
    "text": "もしもし……\r\nあ、お世話になっております……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『ライブレポのゲラが上がりましたので\r\nメールでお送りいたしました』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "承知いたしました\r\nすぐに確認いたします",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『本当にすごいライブでしたからね\r\n会場の臨場感が少しでも伝わると良いのですが』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ありがとうございます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『いやあ、斑鳩さんは本当に唯一無二というか……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『いや、うーん……？\r\nなんて言えばいいのかな……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『他の子と違って』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "制作プロデューサー",
    "text": "『生身で、むき出しで』────────",
    "textCtrl": "p",
    "textFrame": "003"
  },
