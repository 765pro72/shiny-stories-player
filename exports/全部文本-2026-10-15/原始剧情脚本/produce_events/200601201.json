    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601201/2006012010020"
  },
  {
    "speaker": "雑誌担当者",
    "text": "がっつりご指示いただいても大丈夫ですし、\r\n細かいところはお任せでもオッケーですよ！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑誌担当者",
    "text": "いかがでしょう？\r\n今時点で、何か浮かんでくるイメージなどあれば──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006012010030,
    "speaker": "咲耶",
    "text": "そうですね……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601201/2006012010030"
  },
  {
