  },
  {
    "speaker": "雑誌担当者",
    "text": "はい！　誰のためでもない、\r\n白瀬さんご本人のための一枚を撮りたいんです！",
    "charAnim4": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑誌担当者",
    "text": "なんでも、白瀬さんのご希望を叶えられれば……！\r\nと思っています",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006012010020,
    "speaker": "咲耶",
    "text": "なんでも──……",
