    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901203/2009012030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……！\r\nそういうことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009012030070,
    "speaker": "果穂",
    "text": "はい！\r\nなので、おそうじをします！",
