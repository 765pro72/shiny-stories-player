  },
  {
    "speaker": "プロデューサー",
    "text": "んん……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009012030060,
    "speaker": "果穂",
    "text": "子ども会のイベントです！\r\nだから、神社でやるんですー！",
