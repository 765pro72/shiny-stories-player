  },
  {
    "speaker": "プロデューサー",
    "text": "掃除？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009012030080,
    "speaker": "果穂",
    "text": "はい！　ここ、スッゴく広いので\r\nあたしたちがお手伝いするんです！",
