    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010180"
  },
  {
    "id": 2009013010190,
    "speaker": "果穂",
    "text": "マメ丸を部屋の外に出したら、\r\nドアの前できゅーんって鳴いちゃって──",
    "charAnim1": "wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010190"
  },
  {
    "id": 2009013010200,
