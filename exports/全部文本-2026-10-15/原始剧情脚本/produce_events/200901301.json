    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\n想像つくな",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
