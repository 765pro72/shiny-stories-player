    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010140"
  },
  {
    "id": 2009013010150,
    "speaker": "果穂",
    "text": "それで、牛乳パックと割りばしで作ったんですけど……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ！\r\n中身、リリアンと毛糸だったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "リリアンから手作りなんてすごいな！\r\nよくできてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009013010160,
    "speaker": "果穂",
    "text": "えへへっ",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901301/2009013010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "家でやる方が集中できそうだけど……事務所がいいのか？\r\nここは人の出入りが激しいだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009013010170,
