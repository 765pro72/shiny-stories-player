[
  {
    "speaker": "プロデューサー",
    "text": "灯織、オファーが来てるから資料に目を通して、\r\nどうするか決めてく──",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "charCategory": "stand_fix",
    "charType": "characters",
