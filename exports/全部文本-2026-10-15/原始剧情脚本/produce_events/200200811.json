      "time": 100
    },
    "bg": "00070",
    "bgm": "005"
  },
  {
    "id": 2002008110010,
    "speaker": "灯織",
    "text": "やります──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……内容もわからないのに、即決していいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110020,
    "speaker": "灯織",
    "text": "……そうですね、軽率だったかもしれません",
    "charAnim1": "sad3",
    "charAnim2": "blank",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "r",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110020",
    "voiceKeep": true
  },
  {
    "speaker": "灯織",
    "text": "でも……",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "id": 2002008110030,
    "speaker": "灯織",
    "text": "プロデューサーが持ってきてくださった仕事が、\r\n私のためにならなかったことはありません",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110030"
  },
  {
    "id": 2002008110040,
    "speaker": "灯織",
    "text": "自分で決めることに意味があるのは、\r\nわかっているつもりです",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110040"
  },
  {
    "id": 2002008110050,
    "speaker": "灯織",
    "text": "わかった上で、プロデューサーが私にと\r\n決めたお仕事なら、私が断る理由はないんです",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは……ずいぶんと信用されているなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110060,
    "speaker": "灯織",
    "text": "信用に足るだけのことを、\r\nプロデューサーがやってきたから、とは思いませんか？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110060"
  },
  {
    "id": 2002008110070,
    "speaker": "灯織",
    "text": "プロデューサーがいるから、\r\n私はアイドルの仕事を受けることができるんですよ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織を起用したいという声があがるのは、\r\n灯織が仕事に対して真摯だからだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺じゃなくて、灯織の力だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110080,
    "speaker": "灯織",
    "text": "そんなこと……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "あるんだよ、そんなこと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ……あれだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事を持ってきた俺が言うのも変な話だけど、\r\n詰め込みすぎはよくない",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、色々挑戦するのはいいことだからな\r\nまずは資料を読もう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それから決めるのもいいと思うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110090,
    "speaker": "灯織",
    "text": "……わかりました",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110090"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2002008110100,
    "speaker": "灯織",
    "text": "プロデューサー、資料出していただいてもいいですか\r\n私、コーヒー淹れてきます",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、ありがとう\r\n頼むよ",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
  {
    "textFrame": "off"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hiori",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "se": "0242c",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（灯織が読んでた雑誌──の占いコーナーか……？\r\n魚座、今月の運勢……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（『仕事運が絶好調。とにかくなんでも挑戦してみて』\r\n……なるほどなあ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off"
  },
  {
    "id": 2002008110110,
    "speaker": "灯織",
    "text": "プロデューサー、お砂糖とミルク使います──か？",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0242",
    "voice": "produce_events/200200811/2002008110110"
  },
  {
    "id": 2002008110120,
    "speaker": "灯織",
    "text": "あっ……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200200811/2002008110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "おわっ！　……すまん、勝手に読んだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110130,
    "speaker": "灯織",
    "text": "い、いえ……困るようなものでもないですし……\r\n広げっぱなしで邪魔でしたね、すみません",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、大丈夫だ……\r\n──仕事",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110140,
    "speaker": "灯織",
    "text": "……仕事？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "006",
    "voice": "produce_events/200200811/2002008110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "最近、受ける仕事のジャンルが広くなったから\r\nなんでかなと思ってたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "占いの後押しもあったからなんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110150,
    "speaker": "灯織",
    "text": "あ、いえ……その",
    "charAnim1": "anger1",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110150"
  },
  {
    "id": 2002008110160,
    "speaker": "灯織",
    "text": "えっと……占いも関係なくはないんですけど……",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110160"
  },
  {
    "id": 2002008110170,
    "speaker": "灯織",
    "text": "占いやおまじないは、大事な決定の指針にしてないんです\r\n精神的な支えみたいなものなので",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008110180,
    "speaker": "灯織",
    "text": "はい\r\n──だって",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110180"
  },
  {
    "id": 2002008110190,
    "speaker": "灯織",
    "text": "私には、私のことを考えて\r\n道を標してくれる人、ちゃんといますから",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200811/2002008110190"
  },
