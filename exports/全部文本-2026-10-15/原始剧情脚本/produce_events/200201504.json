  {
    "id": 2002015040010,
    "speaker": "灯織",
    "text": "……え、真乃とめぐる、\r\nこれから事務所に来るんですか？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
