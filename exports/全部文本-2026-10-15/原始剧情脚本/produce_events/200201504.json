    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201504/2002015040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃とめぐるが似てきたってだけじゃなくて\r\n灯織もふたりに似てきたところがあるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015040160,
