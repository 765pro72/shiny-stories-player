    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織も事務所で待つだろ？\r\nふたりの反応一緒に見ような！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015040130,
    "speaker": "灯織",
    "text": "……！\r\nはい……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
