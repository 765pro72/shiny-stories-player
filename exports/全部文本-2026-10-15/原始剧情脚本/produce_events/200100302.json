    "voice": "produce_events/200100302/2001003020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃もいつも以上にいい笑顔だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001003020040,
    "speaker": "真乃",
    "text": "そ、そうですか……？\r\nありがとうございます……",
