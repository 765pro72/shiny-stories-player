  {
    "speaker": "プロデューサー",
    "text": "ん……めぐる……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040020,
    "speaker": "めぐる",
    "text": "おはよっ！",
    "charAnim1": "hello",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはよう……ああ……\r\nデスクで寝てしまったのか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この毛布は？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040030,
    "speaker": "めぐる",
    "text": "はづきさんだよ\r\n一度、起こしたけどダメだったって言ってた",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040030"
  },
  {
    "id": 2003005040040,
    "speaker": "めぐる",
    "text": "お仕事忙しかったんだね……\r\n家でちゃんと寝た方がいいよー",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040040"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、大丈夫だよ\r\n今日も頑張らないとな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040050,
    "speaker": "めぐる",
    "text": "あープロデューサー\r\nいけないんだー",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040050"
  },
  {
    "id": 2003005040060,
    "speaker": "めぐる",
    "text": "わたしにはちゃんと休めーって言うのに……",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040060"
  },
  {
    "id": 2003005040070,
    "speaker": "めぐる",
    "text": "プロデューサー、\r\n最近、休んでるところ見てないよ？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "今は少し忙しいけど\r\n落ち着いたらもちろん休むから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040080,
    "speaker": "めぐる",
    "text": "もしかして、わたしのせいで大変なの？",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040080"
  },
  {
    "id": 2003005040090,
    "speaker": "めぐる",
    "text": "レッスン見に来てくれるし、\r\n話し相手にもなってくれてるから……",
    "charAnim1": "wait1",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……どうしようか……）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "めぐるのせいじゃない",
    "nextLabel": "1"
  },
  {
    "select": "楽しいから大丈夫だ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "実は休んでるんだ",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "そんなふうに思わせてしまってすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040100,
    "speaker": "めぐる",
    "text": "プロデューサー……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるも毎日厳しいレッスンを乗り越えてるだろう？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ステージで輝くのがめぐるの仕事、\r\n裏で支えるのが俺の仕事なんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040110,
    "speaker": "めぐる",
    "text": "うん……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "でもなるべく心配させないようにするからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040120,
    "speaker": "めぐる",
    "text": "うんっ！　早くゆっくり休んでね……",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040120"
  },
  {
    "id": 2003005040130,
    "speaker": "めぐる",
    "text": "わたしが心配するからじゃなくて\r\nプロデューサーの身体の為だよっ？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040130"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう。でも、めぐるも人のこと言ってられないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからもっともっと仕事をとってくるからな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040140,
    "speaker": "めぐる",
    "text": "大丈夫！\r\nわたしの忙しいは楽しいってことだもんっ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040140"
  },
  {
    "id": 2003005040150,
    "speaker": "めぐる",
    "text": "どんとこいって感じだよー！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "その意気だ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……お、そろそろ出かける時間だな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040160,
    "speaker": "めぐる",
    "text": "わっ、ほんとだーっ",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "顔を洗ってくる\r\nめぐるも支度しておいてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040170,
    "speaker": "めぐる",
    "text": "はーい……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040170"
  },
  {
    "id": 2003005040180,
    "speaker": "めぐる",
    "text": "あっ！　プロデューサー、待ってーっ\r\n寝癖ついてるよ、寝癖……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200300504/2003005040180"
  },
