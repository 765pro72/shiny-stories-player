  },
  {
    "text": "★選択肢②【楽しいから大丈夫だ】",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "楽しいから大丈夫だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "めぐるが頑張っているのを見てると、\r\n俺も頑張らなきゃって思うんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040190,
    "speaker": "めぐる",
    "text": "うー……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040190"
  },
  {
    "id": 2003005040200,
    "speaker": "めぐる",
    "text": "それならわたしも\r\nプロデューサーのために頑張りたいよっ",
    "charAnim1": "anger1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040200"
  },
  {
    "id": 2003005040210,
    "speaker": "めぐる",
    "text": "プロデューサーの頑張ってるとこ、\r\n一番近くで見てるもん！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040210"
  },
  {
    "id": 2003005040220,
    "speaker": "めぐる",
    "text": "わたしに手伝えるお仕事はあんまり無いかもだけど……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040220"
  },
  {
    "id": 2003005040230,
    "speaker": "めぐる",
    "text": "プロデューサーが疲れたら話し相手になるし、\r\n予定も自分でしっかり確認するっ！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040230"
  },
  {
    "id": 2003005040240,
    "speaker": "めぐる",
    "text": "歌もダンスも頑張って、\r\n心配させないようにするよー！",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……めぐる……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるはあっという間に成長するんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040250,
    "speaker": "めぐる",
    "text": "うん、任せてっ！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040250"
  },
  {
    "id": 2003005040260,
    "speaker": "めぐる",
    "text": "……って言いたいけど、\r\nやっぱりすぐには難しいかもー……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040260"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとう、気持ちだけでも充分だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005040270,
    "speaker": "めぐる",
    "text": "えへへっ……\r\nでも話し相手だったらいつでもだからね",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300504/2003005040270"
  },
  {
    "id": 2003005040280,
    "speaker": "めぐる",
    "text": "そろそろお仕事の時間でしょ？\r\nコーヒー、熱いの淹れてくるねっ",
