    "voice": "produce_events/200201211/2002012110120"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2002012110130,
    "speaker": "灯織",
    "text": "『付き合ってくれ』って、このことだったんですね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201211/2002012110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\n今日の現場、実は海が近いって知ってな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "帰りに海沿いをドライブできないかなって思ってたんだ\r\n間に合ってよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002012110140,
    "speaker": "灯織",
    "text": "教えてくれても良かったのに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201211/2002012110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、すまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "間に合わなかった時が申し訳ないからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
