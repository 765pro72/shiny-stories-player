    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2009007020140,
    "speaker": "果穂",
    "text": "えへへっ\r\n今はまだ秘密です！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900702/2009007020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\n……なら、いつか教えてもらえるのかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007020150,
    "speaker": "果穂",
    "text": "はいっ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900702/2009007020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それは嬉しいな\r\n楽しみにしてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007020160,
    "speaker": "果穂",
    "text": "こうご期待、です！",
