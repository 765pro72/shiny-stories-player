  {
    "id": 2009007020120,
    "speaker": "果穂",
    "text": "──プロデューサーさん！\r\nビーチグラスって、持って帰っても大丈夫ですか？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900702/2009007020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫だと思うぞ\r\nどうするんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007020130,
    "speaker": "果穂",
    "text": "夏休みの宿題と──",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
