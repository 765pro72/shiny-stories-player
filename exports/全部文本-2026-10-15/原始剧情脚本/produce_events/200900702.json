    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900702/2009007020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "──よし、じゃあ俺も探すの手伝うよ\r\nどのくらいほしい？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007020170,
    "speaker": "果穂",
    "text": "わっ！　ありがとうございます……！\r\nえっと、きれいなのを、たくさん、ほしいです！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
