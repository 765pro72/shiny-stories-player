    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500402/3015004020160"
  },
  {
    "id": 3015004020170,
    "speaker": "甜花",
    "text": "それで……ち、ちょっと、緊張してるだけ……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500402/3015004020170"
  },
  {
    "id": 3015004020180,
    "speaker": "千雪",
    "text": "大丈夫です、甜花ちゃん\r\nとりあえずお店に入ってみましょうか",
