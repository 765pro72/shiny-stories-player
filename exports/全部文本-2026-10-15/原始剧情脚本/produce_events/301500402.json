    "textFrame": "001",
    "voice": "produce_events/301500402/3015004020250"
  },
  {
    "id": 3015004020260,
    "speaker": "千雪",
    "text": "そうね……甜花ちゃんならこういう\r\n落ち着いたカーディガンも合ってると思いますよ？",
    "charAnim1": "wait",
    "charLabel": "chiyuki",
