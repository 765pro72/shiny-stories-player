    "textFrame": "001",
    "voice": "produce_events/301500402/3015004020260"
  },
  {
    "id": 3015004020270,
    "speaker": "甘奈",
    "text": "おおー、さすが千雪さん！\r\n大人っぽい甜花ちゃんもかわいー！",
    "charAnim1": "wait",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500402/3015004020270"
  },
  {
    "id": 3015004020280,
    "speaker": "甜花",
