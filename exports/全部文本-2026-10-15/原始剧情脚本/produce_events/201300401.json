    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010090"
  },
  {
    "id": 2013004010100,
    "speaker": "夏葉",
    "text": "後はVRトレーニング！\r\n渦巻く英語の中心でエクササイズするマシンなの！",
