    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "海外か……\r\nそれだと英語が少し不安かな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004010070,
    "speaker": "夏葉",
    "text": "あら、文法？　スピーキング？",
