    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010080"
  },
  {
    "id": 2013004010090,
    "speaker": "夏葉",
    "text": "一度、言語体系から学んでみるのも良いかもね！\r\n世界の言葉は繋がっているってわかるから",
