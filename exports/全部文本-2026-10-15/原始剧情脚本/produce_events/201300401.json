    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに……備えあれば憂い無しだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004010050,
    "speaker": "夏葉",
    "text": "言っておくけどアナタもよ？",
