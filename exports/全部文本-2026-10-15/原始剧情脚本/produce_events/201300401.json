    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010100"
  },
  {
    "id": 2013004010110,
    "speaker": "夏葉",
    "text": "こうやって……！",
