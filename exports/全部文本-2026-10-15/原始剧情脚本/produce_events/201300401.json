    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300401/2013004010070"
  },
  {
    "id": 2013004010080,
    "speaker": "夏葉",
    "text": "今のうちに勉強しておきましょう\r\n私、本ならなんでも持ってるの",
