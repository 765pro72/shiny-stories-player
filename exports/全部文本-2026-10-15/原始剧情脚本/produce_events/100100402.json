    "bgm": "012",
    "voice": "produce_events/100100402/1001004020040"
  },
  {
    "id": 1001004020050,
    "speaker": "真乃",
    "text": "きれいなお花と、たくさんの鳥さんたちに会える\r\nこちらの花鳥園をご紹介させていただきます……っ",
    "charAnim1": "wait2",
