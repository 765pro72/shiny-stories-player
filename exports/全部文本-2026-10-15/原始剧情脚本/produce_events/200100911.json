  {
    "speaker": "プロデューサー",
    "text": "真乃、撮影お疲れ様\r\nよかったら、タオル使ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009110020,
    "speaker": "真乃",
    "text": "ありがとうございますっ\r\nプロデューサーさ──",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100911/2001009110020"
  },
  {
    "charLabel": "mano",
    "textFrame": "off",
