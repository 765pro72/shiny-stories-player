    "waitType": "time",
    "waitTime": 3000
  },
  {
    "textFrame": "off",
    "se": "0418",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "speaker": "プロデューサー",
    "text": "さぁ、風も強くなってきたし\r\nそろそろ戻ろうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009110230,
    "speaker": "真乃",
    "text": "……はいっ\r\nそうですね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100911/2001009110230"
  },
  {
    "id": 2001009110240,
    "speaker": "真乃",
    "text": "一緒に行きましょう\r\nプロデューサーさんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100911/2001009110240"
