    "voice": "produce_events/302001503/3020015030450"
  },
  {
    "id": 3020015030460,
    "speaker": "透",
    "text": "あー、それ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030460"
  },
  {
    "id": 3020015030470,
    "speaker": "小糸",
    "text": "『出来心だったんです』\r\nって言ったんだね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030470"
  },
  {
    "id": 3020015030480,
    "speaker": "透",
    "text": "うん──『出来心』……ってさ、なんかいいね\r\n『心ができてる』って感じ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030480"
  },
  {
    "id": 3020015030490,
    "speaker": "小糸",
    "text": "そ、そういう意味じゃないと思うけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030490"
  },
