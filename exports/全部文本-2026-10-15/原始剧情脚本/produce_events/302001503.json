    "text": "へ～？\r\nなんの話～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030230"
  },
  {
    "id": 3020015030240,
    "speaker": "円香",
    "text": "……落語？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030240"
  },
  {
    "id": 3020015030250,
    "speaker": "透",
    "text": "そう。思い出した",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030250"
  },
  {
    "id": 3020015030260,
    "speaker": "雛菜",
    "text": "あ～、落語か～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030260"
  },
  {
    "id": 3020015030270,
    "speaker": "小糸",
    "text": "……ど、泥棒、\r\n家の人に見つかっちゃうの……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030270"
  },
  {
    "id": 3020015030280,
    "speaker": "透",
    "text": "ううん\r\n隠れる、縁の下",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030280"
  },
  {
    "id": 3020015030290,
    "speaker": "透",
    "text": "でも気付いて、家の人\r\n泥棒入ったって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030290"
  },
  {
    "id": 3020015030300,
    "speaker": "透",
    "text": "で、盗られてないのに盗られたって嘘吐く\r\n大家さんに",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030300"
  },
  {
    "id": 3020015030310,
    "speaker": "雛菜",
    "text": "なんで～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030310"
  },
  {
    "id": 3020015030320,
    "speaker": "透",
    "text": "あー、なんでだっけ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030320"
  },
  {
    "id": 3020015030330,
    "speaker": "円香",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030330"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3020015030340,
    "speaker": "透",
    "text": "でも……\r\n下手で、嘘が",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030340"
  },
  {
    "id": 3020015030350,
    "speaker": "円香",
    "text": "家の人も間抜け？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030350"
  },
  {
    "id": 3020015030360,
    "speaker": "透",
    "text": "うん\r\nで、その嘘聞いてた泥棒が出てくる。怒って",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030360"
  },
  {
    "id": 3020015030370,
    "speaker": "雛菜",
    "text": "え～、見つかっちゃうのに～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030370"
  },
  {
    "id": 3020015030380,
    "speaker": "透",
    "text": "間抜けだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030380"
  },
  {
    "id": 3020015030390,
    "speaker": "雛菜",
    "text": "あ～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030390"
