    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030400"
  },
  {
    "id": 3020015030410,
    "speaker": "透",
    "text": "あー……\r\nえっと……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030410"
  },
  {
    "id": 3020015030420,
    "speaker": "透",
    "text": "──なんか、『心』って……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030420"
  },
  {
    "id": 3020015030430,
    "speaker": "雛菜",
    "text": "『心』？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001503/3020015030430"
  },
  {
    "textFrame": "off",
