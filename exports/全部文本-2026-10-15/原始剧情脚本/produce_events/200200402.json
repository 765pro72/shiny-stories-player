  {
    "bg": "00004",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "しかし、こんなに夜遅くまで残って練習なんて、\r\n本当にえらいな",
    "charAnim1": "wait3",
    "charLabel": "hiori",
