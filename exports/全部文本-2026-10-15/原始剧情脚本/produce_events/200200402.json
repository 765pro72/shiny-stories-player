[
  {
    "speaker": "プロデューサー",
    "text": "よぉ～し！\r\nようやく仕事がひと段落ついたぞ……！",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00002",
    "bgm": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "とりあえず、今日はここまでにして帰ろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……と、その前に戸締り確認しておかなくちゃな",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0113"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ん？　レッスン場のほうにまだ明かりが……？）",
