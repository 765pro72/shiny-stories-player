  {
    "id": 2007017010020,
    "speaker": "結華",
    "text": "いいお部屋～……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
