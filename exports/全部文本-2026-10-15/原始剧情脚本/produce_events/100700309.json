  {
    "id": 1007003090140,
    "speaker": "結華",
    "text": "あたたかく見守ってもらえてるんだなって──\r\nすごく嬉しいし、光栄ですよね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
