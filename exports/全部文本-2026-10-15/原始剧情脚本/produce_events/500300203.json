    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500300203/5003002030080"
  },
  {
    "id": 5003002030090,
    "speaker": "智代子",
    "text": "この間、果穂がうたた寝をしながら抱えていたのは\r\n発見しました",
