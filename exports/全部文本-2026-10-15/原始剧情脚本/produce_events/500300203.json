    "textFrame": "001",
    "voice": "produce_events/500300203/5003002030100"
  },
  {
    "id": 5003002030110,
    "speaker": "夏葉",
    "text": "──３日前にいれたお菓子のストックはどう？",
    "charAnim1": "wait4",
