    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500300203/5003002030090"
  },
  {
    "id": 5003002030100,
    "speaker": "智代子",
    "text": "しかし、使い心地は上々でも、シチュエーション自体は\r\nそう頻繁に起こるものではありません",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_serious",
    "charLabel": "chiyoko",
