  },
  {
    "id": 2011011030330,
    "label": "2",
    "speaker": "樹里",
    "text": "や、やめろ……！\r\nここだけの秘密にしといてくれ！",
    "charAnim1": "touch",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101103/2011011030330"
  },
  {
    "id": 2011011030340,
    "speaker": "樹里",
    "text": "……や、もう電波には乗っちまってるんだけど……！",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101103/2011011030340"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……わかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、みんな喜ぶと思うぞ？",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "意外と、メンバーがどんなふうに思ってくれてるかを\r\n知る機会ってないと思うし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011011030350,
    "speaker": "樹里",
    "text": "それは……\r\nそー、かもだけど……",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101103/2011011030350"
  },
  {
    "id": 2011011030360,
    "speaker": "樹里",
    "text": "……けどやっぱ、\r\nそういうのはいつか直接伝えるよ",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101103/2011011030360"
  },
  {
    "id": 2011011030370,
    "speaker": "樹里",
    "text": "きっと……たぶんな……！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
