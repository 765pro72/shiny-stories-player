    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100104/1021001040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、それはないと思うよ\r\n不合格者も出たはずだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001040250,
    "speaker": "円香",
    "text": "……ふうん……",
