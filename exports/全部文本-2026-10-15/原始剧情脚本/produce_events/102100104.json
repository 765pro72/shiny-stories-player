  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "……だけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001040190,
    "speaker": "円香",
    "text": "……",
