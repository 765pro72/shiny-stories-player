    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "～♪",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020040,
    "speaker": "摩美々",
    "text": "………………",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020040"
  },
  {
    "id": 1005002020050,
    "speaker": "摩美々",
    "text": "──そんなに大事な予定なんですかぁ？",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020060,
    "speaker": "摩美々",
    "text": "なんか、顔がにやけてたんで……",
    "charAnim1": "think",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "に、にやけて……！？\r\n──そんなに顔に出てたかな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前に、駆け出しの時に世話になった人の話をしただろ\r\n今日はその人と飲むことになったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020070,
    "speaker": "摩美々",
    "text": "ああ……そういうことですかぁ",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ふたりで飲むのは久しぶりだからさ、\r\nちょっと気恥ずかしくってな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020080,
    "speaker": "摩美々",
    "text": "プロデューサーの弱みを\r\nいっぱい知ってる人ですからねー",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "弱みとは違うんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020090,
    "speaker": "摩美々",
    "text": "ふふー\r\nまぁ、盛大にからかわれてきてくださいー",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、でも摩美々がそう言うなら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "数年後、俺も摩美々に久しぶりに会った時には、\r\nたくさんからかうとするかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020100,
    "speaker": "摩美々",
    "text": "…………！",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "駆け出しが弱みだなんて思わないけど、\r\n摩美々はそう思うんだったらなぁ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
