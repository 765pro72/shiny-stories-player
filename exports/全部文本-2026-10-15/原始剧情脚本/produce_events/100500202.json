    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、今日はちょっとな\r\nどうかしたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020020,
    "speaker": "摩美々",
    "text": "いえ、別に……声かけただけですよー\r\nお疲れ様でしたぁ",
    "charAnim1": "surp1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500202/1005002020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、お疲れ様\r\n摩美々も遅くならないうちにな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002020030,
    "speaker": "摩美々",
    "text": "はぁい……",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
