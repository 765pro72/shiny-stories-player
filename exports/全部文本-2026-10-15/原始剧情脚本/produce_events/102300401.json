    "id": 1023004010190,
    "speaker": "雛菜",
    "text": "透先輩と同じ名前だな～って思ったから\r\n覚えてたんだけど～……",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
