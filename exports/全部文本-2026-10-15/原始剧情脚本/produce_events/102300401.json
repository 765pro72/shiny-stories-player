  },
  {
    "id": 1023004010180,
    "speaker": "雛菜",
    "text": "前に共演したアイドルの人だった\r\n男の子の",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
