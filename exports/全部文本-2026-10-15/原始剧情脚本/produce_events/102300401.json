  {
    "id": 1023004010170,
    "speaker": "雛菜",
    "text": "『トール』ってワードがツイスタでバズってるから\r\n透先輩のことかな～って思ったんだけど",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
