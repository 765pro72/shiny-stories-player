  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004010210,
    "speaker": "雛菜",
    "text": "アイドルのグループ、辞めるみたい\r\nよくわかんないけど",
