    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102300401/1023004010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、事務所にある資料も\r\n好きに見てくれていいからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004010130,
    "speaker": "雛菜",
    "text": "やは～",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300401/1023004010130"
  },
  {
    "id": 1023004010140,
    "speaker": "雛菜",
    "text": "ワンマンライブ楽しみって\r\nツイスタでもたくさん宣伝しちゃお～",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300401/1023004010140"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hinana",
