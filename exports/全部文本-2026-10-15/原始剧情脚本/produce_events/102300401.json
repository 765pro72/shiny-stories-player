      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0272",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、準備の様子とかも見せられたら\r\nみんなの期待も高まるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
