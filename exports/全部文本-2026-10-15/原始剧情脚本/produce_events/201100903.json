  {
    "id": 2011009030010,
    "speaker": "樹里",
    "text": "──まだかかりそうか？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_costume",
    "charType": "idols",
    "charId": "1040110040",
    "charPosition": {
