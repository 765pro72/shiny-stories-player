    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ハッピーアイスクリーム！\r\nよし、今度は勝ったな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013030090,
    "speaker": "千雪",
    "text": "えーん、先に言われちゃいました……！\r\n私がアイス買いにいかなくちゃ……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030090"
  },
  {
    "id": 2016013030330,
    "speaker": "千雪",
    "text": "寄りません？　コンビニ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030330"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ……うん\r\n時間はまだあるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でもさ、なんかこんなことで\r\n千雪におごってもらうのは、ちょっと悪いよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013030100,
    "speaker": "千雪",
    "text": "ダメダメ、ハッピーアイスクリームは絶対なんです\r\n行きましょう？",
