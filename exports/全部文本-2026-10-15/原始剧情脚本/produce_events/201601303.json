    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030250"
  },
  {
    "id": 2016013030260,
    "speaker": "千雪",
    "text": "これからこの人と一緒に人生を歩みます、っていう節目には\r\n大切なみんなに立ち会ってもらいたいって思いますもん",
    "charAnim1": "surp1",
