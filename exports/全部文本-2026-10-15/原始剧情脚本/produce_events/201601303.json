    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030180"
  },
  {
    "id": 2016013030190,
    "speaker": "千雪",
    "text": "プロデューサーさんはどうです？\r\n惹かれるもの、ありました……？",
