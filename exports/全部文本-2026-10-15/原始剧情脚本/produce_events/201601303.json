    },
    "voice": "produce_events/201601303/2016013030160"
  },
  {
    "id": 2016013030170,
    "speaker": "千雪",
    "text": "結婚式場と、有名ホテル……神社、教会……\r\n貸しスペース、レストラン、それから……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
