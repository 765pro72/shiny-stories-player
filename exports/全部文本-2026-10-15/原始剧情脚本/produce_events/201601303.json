  {
    "id": 2016013030050,
    "speaker": "千雪",
    "text": "リスト作りに熱中しちゃって、肝心の旅行、\r\n初日は少し眠かったなって、思い出してました",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかる気がするよ\r\n学生の頃の夜ふかしって、妙にはかどるんだよな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんでだろうな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013030060,
    "speaker": "千雪",
    "text": "不思議ですよね",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030060"
  },
  {
    "id": 2016013030070,
    "speaker": "千雪",
    "text": "みんな寝静まってる夜中に、\r\nそっと起きてて、何かに没頭していく、なんていうか──",
    "charAnim1": "smile2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
