    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030170"
  },
  {
    "speaker": "プロデューサー",
    "text": "こんなに選択肢があるのは楽しいだろうけど、\r\n迷って大変かもしれないなぁ……",
    "charAnim4": "blank",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013030180,
    "speaker": "千雪",
    "text": "ふふっ、わかります\r\n私も最後の二択とかで、すっごく悩んじゃうだろうなぁ……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
