    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうそう、海側がガラス張りになってるやつ……\r\nなんとなく、一生の思い出になりそうだなってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013030210,
    "speaker": "千雪",
    "text": "インパクトがありますよね",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030210"
  },
  {
    "id": 2016013030220,
    "speaker": "千雪",
    "text": "モデルさんの表情とか、\r\n海に向かって誓いを捧げるような雰囲気も素敵……",
