    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601303/2016013030190"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？\r\nうーん────",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "海辺の\r\nチャペルかな？",
    "nextLabel": "1"
  },
  {
    "select": "こぢんまりした\r\n内輪のパーティ",
    "nextLabel": "2"
