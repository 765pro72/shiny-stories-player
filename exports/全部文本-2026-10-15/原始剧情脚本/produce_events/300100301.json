    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010390"
  },
  {
    "id": 3001003010400,
    "speaker": "灯織",
    "text": "うん、いいよ",
