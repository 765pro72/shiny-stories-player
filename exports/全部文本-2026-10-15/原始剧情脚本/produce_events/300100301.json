    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010240"
  },
  {
    "id": 3001003010250,
    "speaker": "灯織",
    "text": "ごめん、そうじゃなくて",
    "charAnim1": "surp1",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010250"
  },
  {
    "id": 3001003010260,
    "speaker": "灯織",
    "text": "ただ、好きって言い切るから\r\nちょっと驚いちゃって",
