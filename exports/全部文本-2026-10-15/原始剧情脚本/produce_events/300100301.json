  {
    "id": 3001003010040,
    "speaker": "真乃",
    "text": "あっ、灯織ちゃん……",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010040"
  },
  {
    "id": 3001003010050,
    "speaker": "灯織",
    "text": "本当に公園にいるんだ？",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010050"
  },
  {
    "id": 3001003010060,
    "speaker": "真乃",
    "text": "うん……\r\n何かあったのかな……？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010060"
  },
  {
    "id": 3001003010070,
    "speaker": "灯織",
    "text": "真乃はここにいるって、\r\nプロデューサーから聞いて",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010070"
  },
  {
    "id": 3001003010080,
    "speaker": "灯織",
    "text": "半信半疑で来てみたんだけど……\r\n本当にいたから",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010080"
  },
  {
    "id": 3001003010090,
    "speaker": "真乃",
    "text": "そうだったんだね、\r\n私、灯織ちゃんに何か迷惑かけちゃったのかと思った……",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010090"
  },
  {
    "id": 3001003010100,
    "speaker": "灯織",
    "text": "どうして？\r\n何か心当たりでもあるの",
    "charAnim1": "sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010100"
  },
  {
    "id": 3001003010110,
    "speaker": "真乃",
    "text": "え？\r\nううん、そういうわけじゃ……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010110"
  },
  {
    "id": 3001003010120,
    "speaker": "灯織",
    "text": "だったらビクビクするのはおかしいと思う",
    "charAnim1": "anger1",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010120"
  },
  {
    "id": 3001003010130,
    "speaker": "真乃",
    "text": "そ、そうだね……\r\nほわわ……",
    "charAnim1": "smile3",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010130"
  },
  {
    "id": 3001003010140,
    "speaker": "灯織",
    "text": "……で、\r\nここで何してたの？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010140"
  },
  {
    "id": 3001003010150,
    "speaker": "灯織",
    "text": "もうすぐレッスン始まるけど\r\n事務所にいないし",
    "charAnim1": "sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010150"
  },
  {
    "id": 3001003010160,
    "speaker": "真乃",
    "text": "あ、そっか！\r\nごめんなさい、ちゃんと事務所にいないとだよね",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010160"
  },
  {
    "id": 3001003010170,
    "speaker": "真乃",
    "text": "すぐに戻るから──",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010170"
  },
  {
    "id": 3001003010180,
    "speaker": "灯織",
    "text": "そうじゃなくて……",
    "charAnim1": "anger1",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010180"
  },
  {
    "id": 3001003010190,
    "speaker": "灯織",
    "text": "真乃がなんで公園にいるのか、\r\n純粋に質問してるだけ",
    "charAnim1": "sad2",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010190"
  },
  {
    "id": 3001003010200,
    "speaker": "真乃",
    "text": "ほわっ、あ……えっと、\r\nお天気がよかったからだよ",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010200"
  },
  {
    "id": 3001003010210,
    "speaker": "真乃",
    "text": "私ね、公園が好きなの\r\n鳩さんたちとお話するのも好きなんだ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010210"
  },
  {
    "id": 3001003010220,
    "speaker": "真乃",
    "text": "だからよく、ここに来るんだよ",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010220"
  },
  {
    "id": 3001003010230,
    "speaker": "灯織",
    "text": "そう、なんだ……",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010230"
  },
  {
    "id": 3001003010240,
    "speaker": "真乃",
    "text": "あの……私、変なこと言った……かな？",
