    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010280"
  },
  {
    "id": 3001003010290,
    "speaker": "真乃",
    "text": "ほわ……そうなのかな……？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010290"
  },
  {
    "id": 3001003010300,
    "speaker": "灯織",
    "text": "他にも好きなものとかあったりするの？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010300"
  },
  {
    "id": 3001003010310,
    "speaker": "真乃",
    "text": "自然がいっぱいのところに、\r\nお出かけするのも好きだよ",
    "charAnim1": "smile3",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010310"
  },
  {
    "id": 3001003010320,
    "speaker": "真乃",
    "text": "例えば、\r\nお弁当を持ってピクニックとか……",
    "charAnim1": "think",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010320"
  },
  {
    "id": 3001003010330,
    "speaker": "灯織",
    "text": "……とか？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010330"
  },
  {
    "id": 3001003010340,
    "speaker": "真乃",
    "text": "えっと……灯織ちゃん、あのね\r\n……その、急にお願いして驚くと思うんだけど",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010340"
  },
  {
    "id": 3001003010350,
    "speaker": "真乃",
    "text": "……こっ、今度、\r\n一緒にピクニックに行って……欲しいな？",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010350"
  },
  {
    "id": 3001003010360,
    "speaker": "灯織",
    "text": "真乃とふたりで？",
    "charAnim1": "surp1",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010360"
  },
  {
    "id": 3001003010370,
    "speaker": "真乃",
    "text": "あ、でも……迷惑だったら別に……？",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010370"
  },
  {
    "id": 3001003010380,
    "speaker": "灯織",
    "text": "……迷惑なんて言ってないよ\r\nいいよ、一緒に行こう",
    "charAnim1": "surp2",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010380"
  },
  {
    "id": 3001003010390,
    "speaker": "真乃",
    "text": "ほわっ\r\n本当にいいの？",
