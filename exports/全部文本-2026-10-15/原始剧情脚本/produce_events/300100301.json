    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010260"
  },
  {
    "id": 3001003010270,
    "speaker": "真乃",
    "text": "そう……かな？",
    "charAnim1": "think",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100301/3001003010270"
  },
  {
    "id": 3001003010280,
    "speaker": "灯織",
    "text": "好きってはっきり言えるの、すごいと思って",
