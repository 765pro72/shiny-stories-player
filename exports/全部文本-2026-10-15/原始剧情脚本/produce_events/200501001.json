      "type": "to",
      "x": 200,
      "alpha": 0,
      "time": 450
    },
    "se": "0242",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ\r\n気を付けてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010180,
    "speaker": "摩美々",
    "text": "はぁい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010180"
  },
  {
    "textFrame": "off",
    "se": "0114",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……はぁ、次から大事なことは\r\nもっと早くに確認するようにしよう……",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
