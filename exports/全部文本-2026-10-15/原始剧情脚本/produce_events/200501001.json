  {
    "id": 2005010010190,
    "speaker": "摩美々",
    "text": "『うちの子たちが引き立つ\r\nお菓子でした』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "047",
    "voice": "produce_events/200501001/2005010010190"
  },
  {
    "speaker": "プロデューサー",
