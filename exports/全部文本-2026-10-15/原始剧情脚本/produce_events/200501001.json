  },
  {
    "id": 2005010010200,
    "speaker": "摩美々",
    "text": "『WEBサイトにも\r\nば〜りばり映えるように撮りました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010200"
  },
