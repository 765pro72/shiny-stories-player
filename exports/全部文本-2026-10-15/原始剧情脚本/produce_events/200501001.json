  {
    "id": 2005010010010,
    "speaker": "摩美々",
    "text": "おはよーございまぁす",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
