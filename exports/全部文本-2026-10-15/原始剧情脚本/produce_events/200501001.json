    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200501001/2005010010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはよう、摩美々\r\nちょうどいいところに──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、摩美々がメガネなんて珍しいな\r\n──おしゃれメガネってやつか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010020,
    "speaker": "摩美々",
    "text": "……まぁ、度なしなんで\r\nそんなところですかねー",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……やっぱり、こういうのひとつで\r\n結構印象変わるんだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──あ、もちろんいい意味でだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010030,
    "speaker": "摩美々",
    "text": "はぁ、どうもー……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010030"
  },
  {
    "id": 2005010010040,
    "speaker": "摩美々",
    "text": "……そうだぁ\r\nプロデューサー、これ預かってもらっていいですかぁ",
    "charAnim1": "shy2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010040"
  },
  {
    "charLabel": "mamimi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "se": "0163",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、かまわないよ\r\n……お菓子か？　ずいぶんたくさんあるな",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 2005010010050,
    "speaker": "摩美々",
    "text": "レッスン後にみんなで食べようって話になってー\r\n……プロデューサーもいりますー？",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010050"
  },
  {
    "charLabel": "mamimi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "se": "0164",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……これって、粉と水を混ぜると\r\nお菓子になるやつか……懐かしいなぁ",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 2005010010060,
    "speaker": "摩美々",
    "text": "──おすすめはこれですー\r\nたくさんあるんでひとつどうぞー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　うーん、せっかくだから頂くか\r\n後で作ってみるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "えーと『本物そっくりのおすしが作れる』……か\r\nへぇ、ちょっと楽しそうだな",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010070,
    "speaker": "摩美々",
    "text": "プロデューサーもそう思いますー？\r\n作ってみたら結構楽しいんですよねー",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なんとなくわかる気がするよ\r\n種類も増えてるみたいだし、結構凝ったのがあるもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010080,
    "speaker": "摩美々",
    "text": "……ふふー、そうなんですー\r\nこの間作ったのとか、色もすごく綺麗で……",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010080"
  },
  {
    "id": 2005010010090,
    "speaker": "摩美々",
    "text": "写真も撮ったんですケド──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "おー、どんな写真だ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010091,
    "speaker": "摩美々＆プロデューサー",
    "text": "──あ、そうだ……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010091"
  },
  {
    "id": 2005010010092,
    "speaker": "摩美々",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010092"
  },
  {
    "id": 2005010010100,
    "speaker": "摩美々",
    "text": "……プロデューサー\r\nどうかしたんですかぁ？",
    "charAnim1": "anger1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、ちょっと摩美々に\r\n確認することがあったのを思い出して……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々こそ、何か言いかけなかったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010110,
    "speaker": "摩美々",
    "text": "いえー、私のは後でも……\r\nプロデューサーからどうぞー",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？\r\nえっと、それじゃあ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前に用意してくれってお願いしてた\r\nWEBサイトに載せる画像のこと覚えてるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010120,
    "speaker": "摩美々",
    "text": "………………",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010120"
  },
  {
    "id": 2005010010130,
    "speaker": "摩美々",
    "text": "……そんな話もありましたねー",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "も、もしかして忘れてたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010140,
    "speaker": "摩美々",
    "text": "んー、どうでしょうー\r\nそうかもしれませんねー？",
    "charAnim1": "think",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……確認が遅れた俺も悪いんだが、\r\n締め切りも迫ってるから、早めにお願いできると嬉しい",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010150,
    "speaker": "摩美々",
    "text": "はぁい",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010150"
  },
  {
    "id": 2005010010160,
    "speaker": "摩美々",
    "text": "……そろそろレッスンなんで\r\nもう行きますねー",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、摩美々の話は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005010010170,
    "speaker": "摩美々",
    "text": "別にー、大したことじゃないんで\r\nじゃー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501001/2005010010170"
  },
  {
    "charLabel": "mamimi",
    "textFrame": "off",
