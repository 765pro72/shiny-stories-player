    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002020030210,
    "speaker": "灯織",
    "text": "それに、すごく後悔していることがあるって\r\n話をしてくれたのに……",
