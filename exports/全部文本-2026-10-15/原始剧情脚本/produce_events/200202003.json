    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030180"
  },
  {
    "id": 2002020030190,
    "speaker": "灯織",
    "text": "……その人も『卒業』を悲しんでいたんです\r\nだから、やっぱり『卒業』はそこで終わり……",
