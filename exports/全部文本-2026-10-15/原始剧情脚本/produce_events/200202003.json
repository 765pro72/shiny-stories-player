  {
    "speaker": "３年生",
    "text": "わっ……ありがとう……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "３年生",
    "text": "…………\r\nこれをつけて式が終わったらもう──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "３年生",
    "text": "っ……ぐすっ──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002020030030,
    "speaker": "灯織",
    "text": "え……！　あのっ……\r\n私、何か失礼なこと……",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
