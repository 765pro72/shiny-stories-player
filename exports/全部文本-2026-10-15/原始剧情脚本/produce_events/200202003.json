    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200202003/2002020030030"
  },
  {
    "speaker": "３年生",
    "text": "ああっ、ごめんね……！\r\nいざ卒業だと思ったら、色々……ね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002020030040,
    "speaker": "灯織",
    "text": "……いえ、そうですよね\r\nたくさんの寂しさがあると思います……",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030040"
  },
  {
    "speaker": "３年生",
    "text": "そう、だね……\r\nただ、私はちょっと後悔してることがあって────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "３年生",
    "text": "それが、どうしても心残りなんだ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002020030050,
    "speaker": "灯織",
    "text": "……そうだったんですね",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030050"
  },
  {
    "speaker": "３年生",
    "text": "すごく仲の良かった子とケンカしたままに\r\nなっちゃってて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "３年生",
    "text": "もう本当にどうにもできないんだって……\r\nその子との関係はもう終わりなんだなって思ったら……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002020030060,
    "speaker": "灯織",
    "text": "……それは──",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030060"
  },
  {
    "id": 2002020030070,
    "speaker": "灯織",
    "text": "（……卒業したら二度と\r\n繋ぐことができない縁かもしれない）",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030070"
  },
  {
    "id": 2002020030080,
    "speaker": "灯織",
    "text": "──その……っ……",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202003/2002020030080"
  },
  {
    "speaker": "３年生",
    "text": "……って、本当にごめんね！\r\nせっかくお祝いで来てくれたのに",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002020030090,
    "speaker": "灯織",
