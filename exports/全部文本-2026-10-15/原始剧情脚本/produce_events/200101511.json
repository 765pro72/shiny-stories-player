    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101511/2001015110130"
  },
  {
    "id": 2001015110140,
    "speaker": "真乃",
    "text": "明日、砂抜きができたら\r\n今度はお料理コーナーの撮影です",
