    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101511/2001015110140"
  },
  {
    "id": 2001015110150,
    "speaker": "真乃",
    "text": "旬の貝を美味しく頂くレシピに\r\n実際に挑戦しますっ",
