    "bgEffectTime": 1300
  },
  {
    "speaker": "飼育員",
    "text": "フラミンゴ、ハシビロコウ、ペンギン──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1001004060030,
    "speaker": "真乃",
    "text": "ペリカンさん、クジャクさん……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060030"
  },
  {
    "speaker": "飼育員",
    "text": "どうでしょう？\r\nお好きな子がいましたら。もちろん全部でも──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1001004060040,
