      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/100100406/1001004060020"
  },
  {
    "speaker": "飼育員",
    "text": "ええ、櫻木さんがリポートしてくれた子たちを集めました",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_smile",
