    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004060070,
    "speaker": "真乃",
    "text": "……最後の日なので、\r\nもっとさみしい気持ちになると思っていたんですけれど",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
