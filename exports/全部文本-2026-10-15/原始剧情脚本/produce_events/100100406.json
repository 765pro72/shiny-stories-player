  },
  {
    "id": 1001004060120,
    "speaker": "真乃",
    "text": "……どんな時もフクロウさんが見守ってくれているので",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060120"
  },
  {
    "id": 1001004060130,
    "speaker": "真乃",
    "text": "……私も、あまり迷わないように頑張ります",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060130"
  },
  {
    "id": 1001004060140,
    "speaker": "真乃",
    "text": "……ちゃんと前を向いて歩くように頑張ります",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060140"
  },
  {
    "id": 1001004060150,
    "speaker": "真乃",
    "text": "……でも……それでも迷ってしまった時には",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060150"
  },
  {
    "id": 1001004060160,
    "speaker": "真乃",
    "text": "……また、優しくてあたたかい言葉をください",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100406/1001004060160"
  },
  {
    "speaker": "フクロウ",
    "text": "『モチロンだッ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004060170,
    "speaker": "真乃",
    "text": "……！",
