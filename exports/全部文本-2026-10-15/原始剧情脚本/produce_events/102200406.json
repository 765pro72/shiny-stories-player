  {
    "id": 1022004060010,
    "speaker": "小糸",
    "text": "──妹から聞いたんですけど",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
