  {
    "id": 2007011020030,
    "speaker": "結華",
    "text": "……、すみません……！\r\n遅くなりました……！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
