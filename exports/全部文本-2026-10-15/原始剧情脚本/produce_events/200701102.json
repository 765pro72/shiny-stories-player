    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200701102/2007011020030"
  },
  {
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいやいや、時間ぴったりだろ\r\n走ってきたんだよな、お疲れ様──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "事前に連絡くれてたんだし、\r\n無理して間に合わせなくてもよかったのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺との打ち合わせなんだしさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020040,
    "speaker": "結華",
    "text": "……いや、それは……\r\nさすがに……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200701102/2007011020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか\r\n悪いな、ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2200
  },
  {
    "speaker": "プロデューサー",
    "text": "──まぁほら、お茶でも飲んで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020050,
    "speaker": "結華",
    "text": "……いただきます……",
    "charAnim1": "hello",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020050"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……ちなみに、理由は聞いても？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020060,
    "speaker": "結華",
    "text": "……通年の授業で……\r\n夏休みにグループ課題を出されまして……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020070,
    "speaker": "結華",
    "text": "『三峰ちゃん大変だよね？　できるとこやっとくよ！』\r\nって言ってもらったんだけど",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020070"
  },
  {
    "id": 2007011020080,
    "speaker": "結華",
    "text": "……それを受けたら、負けな気がして……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "負け",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 600
  },
  {
    "id": 2007011020090,
    "speaker": "結華",
    "text": "だって、他にバイトとかサークルとかで\r\n忙しい人もいるんだし",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020090"
  },
  {
    "id": 2007011020100,
    "speaker": "結華",
    "text": "三峰だけズルみたいになっちゃうの\r\n嫌じゃん……？！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020100"
  },
  {
    "id": 2007011020110,
    "speaker": "結華",
    "text": "だから今日、課題やる会に出てて……\r\n抜けるタイミングが掴みづらくて……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "あー、なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020120,
    "speaker": "結華",
    "text": "──でもそれで遅刻してたら世話ないよね\r\nごめんなさい、ご迷惑をおかけしました",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、今回のはノーカンだよ\r\n対俺の場合、時間ぴったりはセーフだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "普段からの５分前行動に救われたと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020130,
    "speaker": "結華",
    "text": "……すみません。ありがとうございます",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん",
    "textCtrl": "l",
    "textFrame": "002",
    "autoWaitTime": 600
  },
  {
    "select": "それにしても──",
    "nextLabel": "1"
  },
  {
    "select": "課題の方も頑張ってな",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "じゃあ改めて、\r\n業務上の確認だ",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "結構な負けず嫌いエピソードだな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020140,
    "speaker": "結華",
    "text": "あ、そこ見栄っ張りエピソードって言わないあたり\r\nＰたんは優しい",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……見栄っ張りって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020150,
    "speaker": "結華",
    "text": "実際そうだもん",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020150"
  },
  {
    "id": 2007011020160,
    "speaker": "結華",
    "text": "みんなの善意はわかるんだけどさー！",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020160"
  },
  {
    "id": 2007011020170,
    "speaker": "結華",
    "text": "それに乗ったら、今後三峰が勝手に\r\n負い目感じたりしそうだなっていうさぁ……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020170"
  },
  {
    "id": 2007011020180,
    "speaker": "結華",
    "text": "さすがに今そこに甘えるわけには──みたいな\r\nわかる……？",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかるよ\r\n自分だけ甘えてると不安になるもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020190,
    "speaker": "結華",
    "text": "そう！",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020190"
  },
  {
    "id": 2007011020200,
    "speaker": "結華",
    "text": "そしてせっかくの親切を受け取らないなんてー！\r\nっていう自己嫌悪……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 800
  },
  {
    "id": 2007011020210,
    "speaker": "結華",
    "text": "……でもまぁ、それが三峰なんですけどね",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020210"
  },
  {
    "textFrame": "off",
    "nextLabel": "end",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2007011020220,
    "label": "2",
    "speaker": "結華",
    "text": "！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかく両方頑張ろうと思ったんだからさ\r\n負けにならないだけじゃなくて、勝てるようにっていうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "結華がきっちり納得できるように、ファイトだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020230,
    "speaker": "結華",
    "text": "ふふっ、ありがとう！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020230"
  },
  {
    "speaker": "プロデューサー",
    "text": "……まぁそんなの言われなくてもって\r\n感じだとは思うんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020240,
    "speaker": "結華",
    "text": "ええーっ、なんでよ",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020240"
  },
  {
    "id": 2007011020250,
    "speaker": "結華",
    "text": "それはもちろん言われなくても頑張るつもりだったけど",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020250"
  },
  {
    "id": 2007011020260,
    "speaker": "結華",
    "text": "言ってもらった方が嬉しいんだからさ！\r\nそんな申し訳なさそうにしないでよ～",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020260"
  },
  {
    "id": 2007011020270,
    "speaker": "結華",
    "text": "──言葉にしてくれてありがとう、も込めた\r\n『ありがとう』なんだから",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020270"
  },
  {
    "textFrame": "off",
    "nextLabel": "end",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2007011020280,
    "label": "3",
    "speaker": "結華",
    "text": "？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020280"
  },
  {
    "speaker": "プロデューサー",
    "text": "この件に関して、俺が手伝うことってあるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020290,
    "speaker": "結華",
    "text": "！\r\n──ふふっ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020290"
  },
  {
    "id": 2007011020300,
    "speaker": "結華",
    "text": "だーいじょうぶです！\r\nちゃんと無事になんとかできる予定を組みました！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020300"
  },
  {
    "id": 2007011020310,
    "speaker": "結華",
    "text": "今日以降、ご迷惑とご心配をかける予定はありません！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020310"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 600
  },
  {
    "id": 2007011020320,
    "speaker": "結華",
    "text": "──でも、途中でサボっちゃったら便宜よろしく",
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701102/2007011020320"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん\r\nサボっちゃうやつには約束できないなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011020330,
