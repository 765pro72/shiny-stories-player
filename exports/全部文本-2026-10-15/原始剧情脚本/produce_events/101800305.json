    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050110"
  },
  {
    "id": 1018003050120,
    "speaker": "冬優子",
    "text": "信じるに足るふゆを、\r\n見せられていなかったってわけでしょ？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050120"
  },
  {
    "speaker": "プロデューサー",
