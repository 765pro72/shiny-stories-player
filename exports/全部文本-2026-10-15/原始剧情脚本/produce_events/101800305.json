    "waitTime": 4000
  },
  {
    "id": 1018003050180,
    "speaker": "冬優子",
    "text": "……ふゆにとっては、もうどっちも本物だから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "え──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018003050190,
    "speaker": "冬優子",
    "text": "認めたくないけど、\r\n今あんたと話してる性格の悪いふゆも本物",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050190"
  },
  {
    "id": 1018003050200,
    "speaker": "冬優子",
    "text": "その他大勢がふゆだと思ってる、\r\nふゆの理想のふゆも──本物",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050200"
  },
  {
    "id": 1018003050210,
    "speaker": "冬優子",
    "text": "本物にできるように、\r\n頑張って頑張って猫をかぶり続けたのよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050210"
  },
  {
    "textFrame": "off",
    "bg": "00216",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 3500
  },
  {
