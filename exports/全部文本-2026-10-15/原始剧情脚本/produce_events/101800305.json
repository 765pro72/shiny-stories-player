    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050270"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな──",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
