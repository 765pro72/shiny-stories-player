    "textFrame": "002"
  },
  {
    "id": 1018003050230,
    "speaker": "冬優子",
    "text": "……ふゆが、ふゆのままじゃ愛されないのは悲しいけど",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050230"
  },
  {
    "id": 1018003050240,
    "speaker": "冬優子",
    "text": "ふゆが作ったふゆが、\r\nたくさんの人に受け入れられるのは気持ちいい",
    "charAnim1": "smile1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050240"
  },
  {
    "id": 1018003050250,
    "speaker": "冬優子",
    "text": "どうしたって痛いし、どうしたって幸せで──\r\nそういう歩き方にするって決めたのはふゆだから",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050250"
  },
  {
    "id": 1018003050260,
    "speaker": "冬優子",
    "text": "……まぁ、何……？\r\n心配とか逆に失礼だから、ってとこかしら……",
