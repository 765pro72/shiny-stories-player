    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050130"
  },
  {
    "id": 1018003050140,
    "speaker": "冬優子",
    "text": "──まぁ、腹の立つ話だとは思ってるけど！",
    "charAnim1": "anger1",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、すまん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018003050150,
    "speaker": "冬優子",
    "text": "……あんたが思ってるより長く、ふゆはふゆをやってるし\r\nあんたが思ってるより全然、大変な作業じゃないのよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
