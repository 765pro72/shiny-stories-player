    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1018003050090,
    "speaker": "冬優子",
    "text": "……これは\r\n綺麗な景色に免じて口を滑らせるんだけど",
