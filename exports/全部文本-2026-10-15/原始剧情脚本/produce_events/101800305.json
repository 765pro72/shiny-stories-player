    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800305/1018003050090"
  },
  {
    "id": 1018003050100,
    "speaker": "冬優子",
    "text": "もし、あんたが──ふゆの大丈夫って言葉を\r\n信じられなかったんだとしたら",
    "charAnim1": "wait3",
