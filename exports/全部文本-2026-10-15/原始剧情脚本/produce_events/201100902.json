  },
  {
    "speaker": "プロデューサー",
    "text": "え、あ……\r\nなんだ、樹里？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011009020150,
    "speaker": "樹里",
    "text": "なんだ、じゃねーよ\r\nアンタの方がぼーっとしてるだろ……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……\r\n……すまん、樹里の真剣な表情に、引き込まれてた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011009020160,
    "speaker": "樹里",
    "text": "な……！？\r\nへ、変な言い訳すんなよ！",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "言い訳じゃないぞ\r\n本当に、真剣にやってるからさ",
    "charAnim4": "eye_right",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011009020170,
    "speaker": "樹里",
    "text": "……人に……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020170"
  },
  {
    "id": 2011009020180,
    "speaker": "樹里",
    "text": "……アンタに食わすもん作ってるんだから、\r\n真剣になるのは当たり前だろ",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020180"
  },
  {
    "id": 2011009020190,
    "speaker": "樹里",
    "text": "手ぇ抜くとか、そっちのほうが……\r\nないだろ",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、樹里は……そうだよな",
    "charAnim2": "face_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011009020200,
    "speaker": "樹里",
    "text": "……んなことより、完成したから\r\nアンタが次にやること、わかってるよな？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100902/2011009020200"
  },
  {
    "id": 2011009020210,
    "speaker": "樹里",
    "text": "本気で作ったんだ\r\n変なお世辞とかなしの、本気の感想頼んだからな！",
    "charAnim1": "anger1",
