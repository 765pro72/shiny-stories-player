  {
    "id": 2011009020010,
    "speaker": "樹里",
    "text": "──よし、準備できた\r\n……はじめるか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040110040",
    "charPosition": {
