    "voice": "produce_events/380100103/3801001030320"
  },
  {
    "id": 3801001030330,
    "speaker": "ルビー",
    "text": "（いやむしろ、『姉妹にしか見えない親子』？）",
    "charAnim1": "sad2",
    "charAnim2": "face_anger1",
    "charLipAnim": "lip_wait_s",
    "charLabel": "ruby",
