    "voice": "produce_events/380100103/3801001030310"
  },
  {
    "id": 3801001030320,
    "speaker": "ルビー",
    "text": "（そんなことになったら、\r\n『美人すぎる親子』ってメディアに引っ張りだこかな？）",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
