    "voice": "produce_events/380100103/3801001030070"
  },
  {
    "id": 3801001030080,
    "speaker": "off",
    "text": "輝くべくして輝いていた、アイドルの一番星\r\n私の光",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030080"
  },
  {
    "id": 3801001030090,
    "speaker": "off",
