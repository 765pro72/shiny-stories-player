  },
  {
    "id": 3801001030150,
    "speaker": "ルビー",
    "text": "あのね……！\r\nこの踊り、練習したの……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030150"
  },
  {
    "id": 3801001030160,
    "speaker": "ルビー",
    "text": "どうかな……？　ママ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030160"
  },
  {
    "id": 3801001030170,
    "speaker": "アイ",
    "text": "上手だよルビー！\r\nすっごく可愛い！",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/380100103/3801001030170"
  },
  {
    "id": 3801001030180,
    "speaker": "ルビー",
    "text": "！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030180"
  },
  {
    "id": 3801001030190,
    "speaker": "アイ",
    "text": "やっぱうちの子天才だな～～\r\nコツなんてすぐ覚えちゃう！",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/380100103/3801001030190"
  },
  {
    "id": 3801001030200,
    "speaker": "アイ",
    "text": "そろそろなんらかの賞とかもらった方が\r\nいいんじゃないかな……才能が溢れてるもんね……",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/380100103/3801001030200"
  },
  {
    "id": 3801001030210,
    "speaker": "ルビー",
    "text": "えへへ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030210"
  },
  {
    "id": 3801001030220,
    "speaker": "アイ",
    "text": "あっそうだ、ママも一緒に踊ってみていい？",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/380100103/3801001030220"
  },
  {
    "id": 3801001030230,
    "speaker": "ルビー",
    "text": "いいの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/380100103/3801001030230"
  },
  {
    "id": 3801001030240,
    "speaker": "アイ",
    "text": "ふふっ\r\n教えてよ、ルビー",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/380100103/3801001030240"
  },
  {
    "id": 3801001030250,
    "speaker": "ルビー",
    "text": "うん──！\r\n任せてママ！　一緒にやろっ！",
    "textCtrl": "p",
    "textFrame": "001",
