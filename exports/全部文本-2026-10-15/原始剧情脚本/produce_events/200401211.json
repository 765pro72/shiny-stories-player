  },
  {
    "id": 2004012110180,
    "speaker": "恋鐘",
    "text": "……っくしゅん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401211/2004012110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫か、恋鐘？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "急に寒くなったからな……\r\n俺の上着、羽織っとくか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004012110190,
    "speaker": "恋鐘",
    "text": "…………ふぇ",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
