  },
  {
    "id": 2004012110200,
    "speaker": "恋鐘",
    "text": "……嬉しかけど、プロデューサーは寒くなか？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
