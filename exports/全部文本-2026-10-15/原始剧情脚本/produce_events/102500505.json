    "waitTime": 1000
  },
  {
    "id": 1025005050030,
    "speaker": "美琴",
    "text": "すると、壁の向こうから\r\n音が聞こえてきた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500505/1025005050030"
  },
  {
    "id": 1025005050040,
    "speaker": "美琴",
    "text": "無意識に\r\n私もその音に合わせて壁を叩く",
