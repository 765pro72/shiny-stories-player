  },
  {
    "id": 1025005050050,
    "speaker": "美琴",
    "text": "お互いに叩く位置がズレているせいか\r\n噛み合わずに不協和音となってしまう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500505/1025005050050"
  },
  {
    "id": 1025005050060,
    "speaker": "美琴",
