    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701201/2007012010130"
  },
  {
    "id": 2007012010140,
    "speaker": "結華",
    "text": "三峰がＰたんに気を許しすぎなのか\r\nＰたんの観察力がやばすぎなのか、どっちだと思う？",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701201/2007012010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええ……？",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "というより……",
    "nextLabel": "1"
  },
  {
    "select": "やっぱり、\r\n何かあったのか？",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "仮にどっちだった\r\nとしても",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "結華がそれだけ真剣に考えてた、\r\nってことじゃないのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007012010150,
    "speaker": "結華",
    "text": "顔に出るくらいってことー？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701201/2007012010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "顔には出てないんだけど……\r\nうーん……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……何か、ちゃんと考えたいことがあるのかなって\r\n気がした……みたいな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007012010160,
    "speaker": "結華",
    "text": "あは、何それー",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701201/2007012010160"
  },
  {
    "id": 2007012010170,
    "speaker": "結華",
    "text": "実は全然わかってないんじゃん！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
