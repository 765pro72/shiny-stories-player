    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600400109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600400109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600400109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600400109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600400109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600400109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "off",
    "bgEffect": "mask",
    "bg": "00002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 6004001090010,
    "speaker": "恋鐘",
    "text": "……ただいま～",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "004",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/600400109/6004001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘、おかえり\r\nどこいってたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090020,
    "speaker": "恋鐘",
    "text": "……うん、ちょっとお父ちゃんとお母ちゃんに\r\n電話しとったんよ。優勝したって……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090020"
  },
  {
    "id": 6004001090030,
    "speaker": "恋鐘",
    "text": "ホントにうちが、優勝したんよね……\r\nあの『W.I.N.G.』で……",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……間違いないよ\r\n本当におめでとう！　恋鐘",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090040,
    "speaker": "恋鐘",
    "text": "……んふ、んふふふ……！　えへへ……！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090040"
  },
  {
    "id": 6004001090050,
    "speaker": "恋鐘",
    "text": "うち、うち……\r\nいつか絶対この日が来ると思っとったばい～！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090050"
  },
  {
    "id": 6004001090060,
    "speaker": "恋鐘",
    "text": "地元のみんなはやっぱ間違ってなかった！\r\nうちはやっぱアイドルになるために生まれてきたとよ～！",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090060"
  },
  {
    "id": 6004001090070,
    "speaker": "恋鐘",
    "text": "ね？　ね？　プロデューサーもそう思うやろ～！？",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "（最後まで自分を信じ続けることができたからこそ\r\n恋鐘はここまで来れたんだな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、俺も恋鐘なら絶対優勝できると思ってたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090080,
    "speaker": "恋鐘",
    "text": "そうやろそうやろ！？　やっぱり見る人が見れば\r\nうちの才能はわかるってことばい～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090080"
  },
  {
    "id": 6004001090090,
    "speaker": "恋鐘",
    "text": "うーん、これでうちもアイドルの中のアイドル！\r\nまぁ、なるべくしてなったって感じかね！？",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090090"
  },
  {
    "id": 6004001090100,
    "speaker": "恋鐘",
    "text": "ほらほら、プロデューサー！\r\nナンバー１アイドルと握手せんでよかと？　ほら手出して！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ……握手握手……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090110,
    "speaker": "恋鐘",
    "text": "うん！　よっしゃ～！　万歳もするばい！\r\nほら、万歳～！　バンザーイ！",
    "charAnim1": "smile4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090110"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おお……バンザーイ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090120,
    "speaker": "恋鐘",
    "text": "うん！　これでプロデューサーとは\r\n改めて喜びを分かち合えたばいー！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090120"
  },
  {
    "id": 6004001090130,
    "speaker": "恋鐘",
    "text": "あとは、地元のみんなにも\r\nうちのライブば見て欲しいんよねー",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090130"
  },
  {
    "id": 6004001090140,
    "speaker": "恋鐘",
    "text": "やけん、長崎に凱旋ライブっちゃ\r\nできたらな～って思うとやけど……",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090140"
  },
  {
    "id": 6004001090150,
    "speaker": "恋鐘",
    "text": "まぁ、それはまた東京のお仕事が片付いてからやね\r\n東京のみんなも地元のみんなもどっちも大事やし！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090150"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘……\r\n本当に立派なアイドルになったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090160,
    "speaker": "恋鐘",
    "text": "えへへ……褒めてもなんも出んけど\r\nもっと褒めるばい～……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、けど本当にすごく力がついてるよ\r\nなにせ、あの『W.I.N.G.』で優勝したんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090170,
    "speaker": "恋鐘",
    "text": "えへへ……いやー、でも……やっぱりここまで来れたのは\r\nうちの力だけじゃなかよ～",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090170"
  },
  {
    "id": 6004001090180,
    "speaker": "恋鐘",
    "text": "うちを、全力で支えてくれたプロデューサーがいたから\r\nここまで来れて、そんで優勝までできたったい～！",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090180"
  },
  {
    "id": 6004001090190,
    "speaker": "恋鐘",
    "text": "プロデューサーがおらんかったら、きっと、うち\r\n途中で迷走してどうにもならんかったと思うばい",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090190"
  },
  {
    "id": 6004001090200,
    "speaker": "恋鐘",
    "text": "やけん、ホントに感謝してるんよ！\r\nホントにホントにありがとーね！　プロデューサー！",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、俺もいつも自信たっぷりの恋鐘だったから\r\n自信をもって全力でプロデュースできたんだ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんな恋鐘のプロデューサーで本当によかったと思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090210,
    "speaker": "恋鐘",
    "text": "ええ～？　もう……そんなこと面と向かって言われちゃ\r\nうち、えへへ……照れるばい～……",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090210"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、恋鐘と仕事するとなにかと退屈しないしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090220,
    "speaker": "恋鐘",
    "text": "あ！　それみんな言うてくれるばい～！\r\nスタッフも事務所のみんなも、うちといると楽しいって！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090220"
  },
  {
    "id": 6004001090230,
    "speaker": "恋鐘",
    "text": "それで、そうやってうちを見て楽しんでくれる人を\r\nこれからもっともーっと増やしたい思うんよ～！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090230"
  },
  {
    "id": 6004001090240,
    "speaker": "恋鐘",
    "text": "日本中、いや世界中を\r\nうちのファンでいっぱいにしたい！　いや、するばい！",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090240"
  },
  {
    "id": 6004001090250,
    "speaker": "恋鐘",
    "text": "やから……これからも、うちを応援してくれんかね？\r\nプロデューサー？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090250"
  },
  {
    "speaker": "プロデューサー",
    "text": "聞くまでもないだろ、そんなこと\r\n俺はずっと恋鐘のプロデューサーだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6004001090260,
    "speaker": "恋鐘",
    "text": "やっ……たー！！　うちとプロデューサーが一緒なら\r\n何でもできる！　無敵たい～！",
    "charAnim1": "smile4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090260"
  },
  {
    "id": 6004001090270,
    "speaker": "恋鐘",
    "text": "これからも、ずっと最高で無敵のコンビでいようね！\r\nよろしゅうお願いするばい！　プロデューサー！",
    "charAnim1": "smile1",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600400109/6004001090270"
  },
  {
    "label": "end"
  }
]