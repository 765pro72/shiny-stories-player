    "voice": "produce_events/300402003/3004020030210"
  },
  {
    "id": 3004020030220,
    "speaker": "恋鐘",
    "text": "やけん今日は、海から直接スタジオに来ました",
    "charAnim1": "wait4",
    "charAnim2": "blank",
