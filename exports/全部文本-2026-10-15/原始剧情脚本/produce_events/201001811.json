  },
  {
    "speaker": "プロデューサー",
    "text": "おめでとう！\r\n日本で一番チョコを愛している人！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010018110020,
    "speaker": "智代子",
    "text": "！\r\nふふっ、もう……！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001811/2010018110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "──おめでとう",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyoko",
    "textFrame": "off",
    "se": "1273",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "日本で一番チョコを愛していて、\r\n一番チョコのために活動している人だって──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──そうだって思ってもらえるくらい、\r\nひたむきに頑張って認めてもらえた智代子……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010018110030,
    "speaker": "智代子",
    "text": "……っ、……──ありがとうございます",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001811/2010018110030"
  },
  {
    "id": 2010018110040,
    "speaker": "智代子",
    "text": "もちろん、私だけの力ではないですけど──",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001811/2010018110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、智代子の力があってこそだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait5",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyoko",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2010018110050,
    "speaker": "智代子",
    "text": "──はい",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001811/2010018110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "智代子が一番だってことは、世界にも通用するんだ\r\n──まずは一社。でもこれからきっと──",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "────全制覇",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010018110060,
    "speaker": "智代子",
    "text": "そっ、……れは……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001811/2010018110060"
  },
  {
    "id": 2010018110070,
    "speaker": "智代子",
    "text": "……ビッグですね？",
