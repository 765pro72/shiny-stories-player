    "voice": "produce_events/601000202/6010002020060"
  },
  {
    "id": 6010002020070,
    "speaker": "智代子",
    "text": "……だからみんなとの自主練の時間も、\r\nもうちょっと取れたらいいんですけどー……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
