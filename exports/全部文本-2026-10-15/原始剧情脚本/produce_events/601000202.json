    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601000202/6010002020030"
  },
  {
    "id": 6010002020040,
    "speaker": "智代子",
    "text": "そのためには、まだまだ直さなきゃいけないところも\r\nあるとは思うんですけど……",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601000202/6010002020040"
  },
  {
    "id": 6010002020050,
    "speaker": "智代子",
    "text": "でも、だからこそ、今日からまた頑張ろう！\r\nって思えました！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601000202/6010002020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、やる気充分だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6010002020060,
    "speaker": "智代子",
    "text": "はいっ！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
