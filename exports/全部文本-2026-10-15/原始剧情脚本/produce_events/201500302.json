  {
    "id": 2015003020170,
    "speaker": "甜花",
    "text": "プロデューサーさん……やっぱりこのクッションが、\r\n一番……これで……事務所の、お昼寝もはかどる……",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500302/2015003020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは。甜花らしいな\r\nじゃあ、ちょっと待っててくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "effectLabel": "black2",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
