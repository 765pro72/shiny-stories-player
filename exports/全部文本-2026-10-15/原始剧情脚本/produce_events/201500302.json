    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003020280,
    "speaker": "甜花",
    "text": "にへへ……甜花……\r\nプロデューサーさんと、ゲームできて……楽しかった……！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
