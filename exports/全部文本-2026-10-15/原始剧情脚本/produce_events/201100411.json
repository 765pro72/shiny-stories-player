    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 2011004110010,
    "speaker": "樹里",
    "text": "おはよ\r\n……朝から大荷物持って……どーしたんだ？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里に届いたプレゼントとファンレターだよ\r\n中身、今確認するか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110020,
    "speaker": "樹里",
    "text": "おー……\r\nじゃあ、ちょっと見てみるかな",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110020"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textFrame": "off",
    "se": "0177",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2011004110030,
    "speaker": "樹里",
    "text": "ぬいぐるみか……\r\n『樹里ちゃんにそっくりだから送ります！』って……",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110030"
  },
  {
    "id": 2011004110040,
    "speaker": "樹里",
    "text": "言うほど似てるか……？\r\nアタシ、こんなツリ目かな……",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、結構似てると思うぞ\r\n樹里に似て可愛いじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110050,
    "speaker": "樹里",
    "text": "あ、アタシに似てって……！\r\nや、やめろよそういうの！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、なんというか……\r\n雰囲気が似てるのかな……黄色いし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110060,
    "speaker": "樹里",
    "text": "色かよ……",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110060"
  },
  {
    "id": 2011004110070,
    "speaker": "樹里",
    "text": "でもまぁ、プロデューサーも言うならそうなのかもな……",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110070"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textFrame": "off",
    "se": "0163",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2011004110080,
    "speaker": "樹里",
    "text": "……ん、こっちは……\r\n服まで届いてんのか",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110080"
  },
  {
    "id": 2011004110090,
    "speaker": "樹里",
    "text": "アタシに似合いそうな部屋着……って\r\nこれはさすがに可愛すぎだろ……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、\r\nやっぱりファンはよく見てくれてるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110100,
    "speaker": "樹里",
    "text": "はぁ？",
    "charAnim1": "wait4",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里の潜在的な部分というか……\r\nしっかりポイントを抑えたデザインの部屋着だと思うぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……\r\n俺も負けてられないな……",
    "charAnim2": "face_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110110,
    "speaker": "樹里",
    "text": "ったく……",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110120,
    "speaker": "樹里",
    "text": "プロデューサー？\r\n何ニヤニヤしてんだ？",
    "charAnim1": "smile2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……良かったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110130,
    "speaker": "樹里",
    "text": "……？\r\n何がだよ",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……樹里を応援する人たちがこれだけ……\r\nこれ以上にいる──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつの間にか、そんな場所に来てたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110140,
    "speaker": "樹里",
    "text": "……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "off",
    "voice": "produce_events/201100411/2011004110140"
  },
  {
    "id": 2011004110150,
    "speaker": "樹里",
    "text": "……そーだなぁ",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110150"
  },
  {
    "id": 2011004110160,
    "speaker": "樹里",
    "text": "なんつーか……今更だけどよ……\r\n最近、よく思うんだよな",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "006",
    "voice": "produce_events/201100411/2011004110160"
  },
  {
    "id": 2011004110170,
    "speaker": "樹里",
    "text": "アンタにスカウトされて、アイドルになって……\r\nレッスンしたり、ユニットのやつらと話したり……",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110170"
  },
  {
    "id": 2011004110180,
    "speaker": "樹里",
    "text": "それで、ステージに立って──",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110180"
  },
  {
    "id": 2011004110190,
    "speaker": "樹里",
    "text": "青春ってこんな感じなのかなー……って",
    "charAnim2": "face_sad",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110200,
    "speaker": "樹里",
    "text": "──じ、自分でも変なこと言ってるのはわかってんだよ！\r\n笑いたきゃ笑え！",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、変なんかじゃないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も時々、プロデューサーとして\r\n青春してるなって思うくらいだし……はは",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110210,
    "speaker": "樹里",
    "text": "……なんだよそれ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110210"
  },
  {
    "id": 2011004110220,
    "speaker": "樹里",
    "text": "でも……\r\n……そっか",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110220"
  },
  {
    "id": 2011004110230,
    "speaker": "樹里",
    "text": "……今からでも、遅くねーんだよな",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ\r\nいつからでも、遅くないさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004110240,
    "speaker": "樹里",
    "text": "……っふふ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100411/2011004110240"
  },
  {
    "id": 2011004110250,
    "speaker": "樹里",
    "text": "……ありがとな、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
