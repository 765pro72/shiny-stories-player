  {
    "speaker": "プロデューサー",
    "text": "──お、樹里\r\nおはよう。ちょうど良いところに来たな！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_surp_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "011",
    "charPosition": {
