  {
    "id": 2002008010190,
    "label": "2",
    "speaker": "灯織",
    "text": "騙されません\r\nプロデューサー、明らかに驚いた顔をしていました",
    "charAnim1": "sad1",
    "charAnim2": "face_anger",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger",
    "charLabel": "hiori",
