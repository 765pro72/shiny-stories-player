    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200801/2002008010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "先方はめぐるにって言っていたけど、\r\n俺がぜひ灯織をって推したんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008010110,
    "speaker": "灯織",
    "text": "……え？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
