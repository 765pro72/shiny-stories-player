    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200801/2002008010330"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008010340,
    "speaker": "灯織",
    "text": "お仕事、受けます",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
