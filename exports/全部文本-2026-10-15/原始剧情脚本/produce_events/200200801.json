    "textFrame": "001",
    "voice": "produce_events/200200801/2002008010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ばれてたか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008010200,
    "speaker": "灯織",
    "text": "ばればれですよ",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charAnim4": "blank",
