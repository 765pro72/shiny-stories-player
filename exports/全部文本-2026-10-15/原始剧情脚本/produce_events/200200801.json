    "textFrame": "001",
    "voice": "produce_events/200200801/2002008010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "うちの事務所からひとり、としか言われてなくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008010290,
    "speaker": "灯織",
    "text": "……え？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
