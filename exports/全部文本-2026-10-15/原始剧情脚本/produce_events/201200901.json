  {
    "speaker": "プロデューサー",
    "text": "……ははっ、凛世\r\n遠慮してる顔だな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012009010140,
    "speaker": "凛世",
