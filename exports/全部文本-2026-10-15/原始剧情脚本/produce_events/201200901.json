    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200901/2012009010290"
  },
  {
    "id": 2012009010300,
    "speaker": "凛世",
    "text": "──それが……嬉しく……",
