    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040230"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あんなにきらきらした目で見られてたら、\r\nなかなか本当のことは言えないよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004040240,
    "speaker": "千雪",
    "text": "ふふっ\r\nそうなんです",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040240"
  },
  {
    "id": 1016004040250,
    "speaker": "千雪",
    "text": "でも……不思議ですね",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040250"
  },
  {
    "id": 1016004040260,
    "speaker": "千雪",
    "text": "彼女の中の『桑山千雪』は、\r\n本物の桑山千雪とは違うのに……",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040260"
  },
  {
    "id": 1016004040270,
    "speaker": "千雪",
    "text": "それを否定することは、私本人にもできないんですよ",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040270"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに……\r\n言われてみると、不思議なものだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004040280,
    "speaker": "千雪",
    "text": "逆に、私の方も────",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040280"
  },
  {
    "id": 1016004040290,
    "speaker": "千雪",
    "text": "緊張してるな、一生懸命なのが伝わってくるなあ……\r\n昔の私もこうだったのかなって思ったら……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040290"
  },
  {
    "id": 1016004040300,
    "speaker": "千雪",
    "text": "他人に思えなかったんです",
