    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040220"
  },
  {
    "id": 1016004040230,
    "speaker": "千雪",
    "text": "デビューしたての頃だけって顔しちゃいましたけど……",
    "charAnim1": "anger2",
