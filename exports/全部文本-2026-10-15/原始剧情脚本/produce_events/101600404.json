    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040300"
  },
  {
    "id": 1016004040310,
    "speaker": "千雪",
    "text": "もちろん、それも私の勝手なイメージで、\r\n昔の私と彼女は全然違う人間だってわかってるんですが……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040310"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\n俺の記憶の中の千雪は、またちょっと違ってた気がする",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、千雪の感じ方もわかるんだよな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1016004040320,
    "speaker": "千雪",
    "text": "歌、プレイリスト、憧れの人……",
