    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040120"
  },
  {
    "speaker": "新人アイドル",
    "text": "わーー……\r\nやっぱりそうなんだ……",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016004040130,
    "speaker": "千雪",
    "text": "ふふっ、大丈夫ですよ\r\nきゃーってなるのは、成長の証だから",
