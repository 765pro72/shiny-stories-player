      "time": 100
    },
    "voice": "produce_events/101600404/1016004040030"
  },
  {
    "speaker": "新人アイドル",
    "text": "いつもラジオ聴いてるんです\r\n雑誌のコラムも読んで……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "新人アイドル",
    "text": "あの、この間お薦めされていた絵本も読みました……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016004040040,
    "speaker": "千雪",
    "text": "わあ……！　ありがとうございます",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040040"
  },
  {
    "speaker": "新人アイドル",
    "text": "ごめんなさい、馴れ馴れしく話しかけてしまって……\r\nでも、どうしてもご挨拶したくて……！",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016004040050,
    "speaker": "千雪",
    "text": "ふふっ、いえいえ……\r\nとっても嬉しいです……！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040050"
  },
  {
    "id": 1016004040060,
    "speaker": "千雪",
    "text": "今日の番組、私の前のコーナーに\r\n出られる方ですよね……？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600404/1016004040060"
  },
  {
    "speaker": "新人アイドル",
    "text": "わ、そこまで知っていただいてるなんて……！\r\n今回テレビ初出演なのに……私もその、嬉しいです！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016004040070,
