    "textFrame": "003"
  },
  {
    "id": 1018003020210,
    "speaker": "冬優子",
    "text": "──……\r\nふゆが何かしてるんじゃなくて、恵まれてるだけだよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800302/1018003020210"
  },
  {
    "id": 1018003020220,
    "speaker": "冬優子",
    "text": "ふたりみたいに優しい人ばっかりなんだもんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800302/1018003020220"
  },
  {
    "speaker": "冬優子の友人２",
    "text": "あははっ、また調子いいこと言って～",
