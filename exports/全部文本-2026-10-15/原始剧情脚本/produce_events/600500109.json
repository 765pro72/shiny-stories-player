    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600500109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600500109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600500109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600500109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600500109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600500109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "off",
    "bgEffect": "mask",
    "bg": "00002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "改めて、優勝おめでとう\r\n最高だったぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090010,
    "speaker": "摩美々",
    "text": "なんかぁ、気づいたら優勝しちゃってましたねー\r\n私も驚きですー",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "005",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "voice": "produce_events/600500109/6005001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほんと、相変わらずだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長とはづきさんも喜んでたし\r\n摩美々は本当によくやったよ。最高だ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090020,
    "speaker": "摩美々",
    "text": "み、みんなして褒めすぎですよー\r\nまみみは、フツーにやっただけですからぁ",
    "charAnim1": "shy1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいや、それだけのことを摩美々はやったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "最初の頃、心配や不安に思う日もあったけど\r\n絶対優勝できるって……信じてた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090030,
    "speaker": "摩美々",
    "text": "……プロデューサーが感慨に耽っちゃうなんてー\r\n調子狂っちゃいますねー",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃ、色々あった末の優勝なんだ\r\n今までのことを思い出してしまうさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090040,
    "speaker": "摩美々",
    "text": "……思えばぁ、プロデューサーは初めて会ったときから、\r\n他の人とは感じが違いましたよねー",
    "charAnim1": "surp1",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090040"
  },
  {
    "id": 6005001090050,
    "speaker": "摩美々",
    "text": "私と本気で正面からぶつかってくれる人なんて、\r\n今までいませんでしたぁ",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090050"
  },
  {
    "id": 6005001090060,
    "speaker": "摩美々",
    "text": "私にあーだこーだ言ってくれるのは、\r\nプロデューサーくらいですよ",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "たしかに色々と注意してきたが\r\nちゃんと実になっただろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090070,
    "speaker": "摩美々",
    "text": "そんなのー\r\n今更聞かなくても、いいんじゃないですかぁ？",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、\r\n確かにそうかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090080,
    "speaker": "摩美々",
    "text": "ふふー……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090080"
  },
  {
    "id": 6005001090090,
    "speaker": "摩美々",
    "text": "…………",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090090"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090100,
    "speaker": "摩美々",
    "text": "……ね、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？\r\nどうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090110,
    "speaker": "摩美々",
    "text": "スカウトしてくれたのが\r\nプロデューサーじゃなかったら",
    "charAnim1": "sad2",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090110"
  },
  {
    "id": 6005001090120,
    "speaker": "摩美々",
    "text": "絶対にアイドルにならなかったし……\r\nこんな……こんな気持ち知らないままでした",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090120"
  },
  {
    "id": 6005001090130,
    "speaker": "摩美々",
    "text": "まみみをアイドルにしてくれて、\r\n……ありがとうございます",
    "charAnim1": "wait2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……摩美々",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090140,
    "speaker": "摩美々",
    "text": "えっ",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090140"
  },
  {
    "id": 6005001090150,
    "speaker": "摩美々",
    "text": "今度はプロデューサーが泣く番なんですか？\r\nなにもそこまで……",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090150"
  },
  {
    "speaker": "プロデューサー",
    "text": "な、泣いてないからなっ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090160,
    "speaker": "摩美々",
    "text": "……じゃー、そういうことにしておいてあげますねー",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090160"
  },
  {
    "id": 6005001090170,
    "speaker": "摩美々",
    "text": "……はぁ\r\nなんかー、一件落着って感じですー",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことないぞ！\r\n摩美々のアイドル人生は、まだ始まったばかりだ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "まだまだ摩美々にはできることがたくさんある\r\nむしろこれからが本番だ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090180,
    "speaker": "摩美々",
    "text": "えー、これからはすごいアイドルとしてー、\r\n高見の見物じゃないんですかぁ？",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090180"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからもっと忙しくなるんだ、\r\n気を緩めちゃダメだぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090190,
    "speaker": "摩美々",
    "text": "今までいろいろしてきた気がするのにー、\r\nまだまだだって、プロデューサーは言うんですねー",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、摩美々はもっと上を目指せるはずだ\r\n俺も全力でプロデュース頑張るからな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005001090200,
    "speaker": "摩美々",
    "text": "まぁここまできちゃいましたし……\r\nもうちょっと、アイドルやってみますねー",
    "charAnim1": "anger1",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090200"
  },
  {
    "id": 6005001090210,
    "speaker": "摩美々",
    "text": "これからも悪い子のまみみを、\r\nよろしくお願いします",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600500109/6005001090210"
  },
  {
    "label": "end"
  }
]