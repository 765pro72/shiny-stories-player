    "voice": "produce_events/200900801/2009008010010"
  },
  {
    "id": 2009008010020,
    "speaker": "果穂",
    "text": "スケジュール帳にも書きました！\r\nばっちりです！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、綺麗に書けてるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010030,
    "speaker": "果穂",
    "text": "はい！　月曜日は祝日なので、おうちから直接──",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010030"
  },
  {
    "id": 2009008010040,
    "speaker": "果穂",
    "text": "──……？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂、どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010050,
    "speaker": "果穂",
    "text": "プロデューサーさん……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010050"
  },
  {
    "id": 2009008010060,
    "speaker": "果穂",
    "text": "どうして、秋がいいんですか？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010070,
    "speaker": "果穂",
    "text": "この前、秋はスポーツや読書にいい季節なんだよって\r\n先生が教えてくれたんですけど",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010070"
  },
  {
    "id": 2009008010080,
    "speaker": "果穂",
    "text": "なんで『スポーツの秋』って言うのかなって",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに、スポーツも食欲も読書も秋で、\r\n春夏冬にはあんまり勧めないよなあ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『スポーツの秋』については、世界的なスポーツ大会が\r\n初めて日本で開催された時期だったからかな",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "スポーツを身近に感じてほしかったんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010090,
    "speaker": "果穂",
    "text": "そっか……！\r\nだから秋にスポーツをしましょう！　って言うんですね！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "きっとな\r\n──しかし、スポーツか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この時期の運動会って、大体祝日にやるだろ？\r\n子どもの頃は、振り替えで平日休みになるのが嬉しくてさ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "懐かしいなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010100,
    "speaker": "果穂",
    "text": "……？\r\n運動会を秋にやるんですか……？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、違うのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010110,
    "speaker": "果穂",
    "text": "はい！　運動会は春にやりました！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……\r\n果穂の学校だと春頃にやるんだな",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "なんの種目に出たんだ？",
    "nextLabel": "1"
  },
  {
    "select": "応援団とかやったか？",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "優勝できたか？",
    "nextLabel": "3"
  },
  {
    "id": 2009008010120,
    "label": "1",
    "speaker": "果穂",
    "text": "大縄跳びとムカデ競争は全員参加で、\r\n個人種目は騎馬戦と二人三脚を選びました！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "全部協力して戦う競技なんだな\r\n協力技が得意な果穂らしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010130,
    "speaker": "果穂",
    "text": "えへへっ……！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010130"
  },
  {
    "id": 2009008010140,
    "speaker": "果穂",
    "text": "クラスの友達とたっくさん特訓したんです！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010140"
  },
  {
    "id": 2009008010150,
    "speaker": "果穂",
    "text": "ユニットのみなさんとステップを合わせる時みたいに、\r\n呼吸を合わせて……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010150"
  },
  {
    "id": 2009008010160,
    "speaker": "果穂",
    "text": "レッスンでやっていることの応用だったので、\r\nとっても上手にできました！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、ということは、勝てたみたいだな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010170,
    "speaker": "果穂",
    "text": "はいっ！\r\n大縄跳びとムカデ競争はあたしのクラスが１番で……",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010170"
  },
  {
    "id": 2009008010180,
    "speaker": "果穂",
    "text": "騎馬戦と二人三脚はあたしのチームが勝ちました！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010180"
  },
  {
    "id": 2009008010190,
    "speaker": "果穂",
    "text": "特訓の成果！　です！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200900801/2009008010190"
  },
  {
    "textFrame": "off"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "『フレー！　フレー！』って、\r\n自分の組を応援するアレ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010200,
    "speaker": "果穂",
    "text": "やりました！\r\nあたし、おうえん団長だったんです！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010200"
  },
  {
    "id": 2009008010210,
    "speaker": "果穂",
    "text": "あたしのクラスは赤組で、\r\nジャスティスレッドの色だったので",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010210"
  },
  {
    "id": 2009008010220,
    "speaker": "果穂",
    "text": "赤いハチマキを巻いて、\r\nたくさんがんばりました！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか！　応援団長の果穂か……\r\nそれは見たかったなあ……",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010230,
    "speaker": "果穂",
    "text": "お父さんがビデオをとってくれて、\r\nお母さんが写真をとってくれたんです……！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010230"
  },
  {
    "id": 2009008010240,
    "speaker": "果穂",
    "text": "今度持ってきます！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010250,
    "speaker": "果穂",
    "text": "はい！\r\nあたしも、プロデューサーさんに見てほしいです！",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010250"
  },
  {
    "id": 2009008010260,
    "speaker": "果穂",
    "text": "楽しみにしててください！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
