    "voice": "produce_events/200900801/2009008010270"
  },
  {
    "id": 2009008010280,
    "speaker": "果穂",
    "text": "あたしたちの赤組は、\r\n１年生も２年生も３年生も４年生も５年生も６年生もっ",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010280"
  },
  {
    "id": 2009008010290,
    "speaker": "果穂",
    "text": "みんな、とってもとってもとーっても強かったんです！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010290"
  },
  {
    "id": 2009008010300,
    "speaker": "果穂",
    "text": "ライバルのチームをどんどんたおしちゃって……\r\n２位が追い付けないくらい点を取りました！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010300"
  },
  {
    "id": 2009008010310,
    "speaker": "果穂",
    "text": "みんなカッコよかったです……！",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900801/2009008010310"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、果穂の話を聞いてると、\r\nまるでヒーローのことを話してるみたいだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008010320,
    "speaker": "果穂",
    "text": "……！\r\nそうです！　ヒーローです！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
