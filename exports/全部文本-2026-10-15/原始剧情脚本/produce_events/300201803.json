  },
  {
    "id": 3002018030030,
    "speaker": "真乃",
    "text": "ふふふっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030030"
  },
  {
    "id": 3002018030040,
    "speaker": "真乃",
    "text": "めぐるちゃん、お疲れさま……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030040"
  },
  {
    "id": 3002018030050,
    "speaker": "めぐる",
    "text": "真乃もお疲れさま！\r\n今日もみんな色々あったねー！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030050"
  },
  {
    "id": 3002018030060,
    "speaker": "灯織",
    "text": "めぐるは撮影だっけ？",
    "charAnim1": "sad2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030060"
  },
  {
    "id": 3002018030070,
    "speaker": "めぐる",
    "text": "そうだよー！　ちょっと遠くまで行ってきた！\r\n真乃はキャンペーンのお仕事だよね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030070"
  },
  {
    "id": 3002018030080,
    "speaker": "めぐる",
    "text": "どうだったー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030080"
  },
  {
    "id": 3002018030090,
    "speaker": "真乃",
    "text": "……楽しくて\r\nあっという間だった……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030090"
  },
  {
    "id": 3002018030100,
    "speaker": "真乃",
    "text": "あのね、灯織ちゃんとめぐるちゃんにもって\r\nおみやげもいただいたの……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030100"
  },
  {
    "id": 3002018030110,
    "speaker": "真乃",
    "text": "事務所にあるから、明日渡すね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030110"
  },
  {
    "id": 3002018030120,
    "speaker": "めぐる",
    "text": "やったー！\r\nなんだろ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030120"
  },
  {
    "id": 3002018030130,
    "speaker": "灯織",
    "text": "真乃のキャンペーンって、飲食系だったよね\r\nじゃあ、食べ物なのかな",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030130"
  },
  {
    "id": 3002018030140,
    "speaker": "真乃",
    "text": "ふふ……\r\nお楽しみに……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030140"
  },
  {
    "id": 3002018030150,
    "speaker": "真乃",
    "text": "灯織ちゃんは……\r\nラジオのゲストだったよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030150"
  },
  {
    "id": 3002018030160,
    "speaker": "灯織",
    "text": "うん、そう",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030160"
  },
  {
    "id": 3002018030170,
    "speaker": "灯織",
    "text": "生放送でもないし、\r\nそこまで緊張せずにできたかな",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030170"
  },
  {
    "id": 3002018030180,
    "speaker": "灯織",
    "text": "放送日決まったら教えるね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030180"
  },
  {
    "id": 3002018030190,
    "speaker": "真乃",
    "text": "……うんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030190"
  },
  {
    "id": 3002018030200,
    "speaker": "真乃",
    "text": "……今日は、みんなバラバラだったけど、\r\n明日は一緒に打合せだね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030200"
  },
  {
    "id": 3002018030210,
    "speaker": "真乃",
    "text": "集まれるのうれしいなっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030210"
  },
  {
    "id": 3002018030220,
    "speaker": "灯織",
    "text": "そうだね\r\nいつもイルミネ３人でっていうのは難しくなってきたから",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030220"
  },
  {
    "id": 3002018030230,
    "speaker": "灯織",
    "text": "……って言っても、\r\n会える時は会ってるし、お泊り会もするし",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030230"
  },
  {
    "id": 3002018030240,
    "speaker": "灯織",
    "text": "こうして通話もするんだけど",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030240"
  },
  {
    "id": 3002018030250,
    "speaker": "真乃",
    "text": "……ふふ\r\nふたりとお話するの楽しいから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030250"
  },
  {
    "id": 3002018030260,
    "speaker": "真乃",
    "text": "こんなことがあったよって、\r\nこうして伝えられるのもうれしいな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030260"
  },
  {
    "id": 3002018030270,
    "speaker": "灯織",
    "text": "それは私もそう",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030270"
  },
  {
    "id": 3002018030280,
    "speaker": "灯織",
    "text": "メッセすればいい話なのかもしれないし\r\nそういう人もきっといるんだろうけど",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201803/3002018030280"
  },
  {
    "id": 3002018030290,
    "speaker": "灯織",
    "text": "なんていうか……\r\nふたりとは話したくなる",
    "charAnim1": "sad2",
