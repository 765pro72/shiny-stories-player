    "id": 1016005020170,
    "speaker": "小さな声",
    "text": "『降って湧いた、\r\n華やかな世界へのお誘いに浮ついてるだけじゃない？』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "057b",
    "voice": "produce_events/101600502/1016005020170"
  },
  {
    "id": 1016005020180,
    "speaker": "小さな声",
    "text": "『今からアイドルになる、って選択肢は……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600502/1016005020180"
  },
  {
    "id": 1016005020190,
    "speaker": "小さな声",
    "text": "『本当に現実味があるものなの？』",
    "textCtrl": "p",
