    "voice": "produce_events/101600502/1016005020190"
  },
  {
    "id": 1016005020200,
    "speaker": "小さな声",
    "text": "『雑貨屋で働くことにだって、\r\n千雪は不安があったじゃない……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600502/1016005020200"
  },
  {
    "id": 1016005020210,
    "speaker": "小さな声",
    "text": "『今、ハンドルを切ったとして……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600502/1016005020210"
  },
  {
    "id": 1016005020220,
    "speaker": "小さな声",
    "text": "『それは、\r\n千雪の納得のいく……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600502/1016005020220"
  },
  {
    "id": 1016005020230,
    "speaker": "小さな声",
