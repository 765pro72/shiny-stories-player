    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300711/2003007110070"
  },
  {
    "id": 2003007110080,
    "speaker": "めぐる",
    "text": "わたしも話し相手くらいにはなれるから\r\n……一緒に家まで頑張るよ！",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
