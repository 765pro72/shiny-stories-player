    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200611/2002006110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "っと……すまん、途中から参考じゃなくて\r\n俺の欲しいものになっちゃってたな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002006110200,
    "speaker": "灯織",
