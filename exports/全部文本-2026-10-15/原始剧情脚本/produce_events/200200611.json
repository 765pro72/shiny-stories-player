    "waitTime": 800
  },
  {
    "id": 2002006110090,
    "speaker": "灯織",
    "text": "あ！　なかなか良いみたいですよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200611/2002006110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは嬉しいな\r\nそう思うとなんだか元気になってくるような",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002006110100,
    "speaker": "灯織",
    "text": "ふふ、良い結果だと嬉しいですよね……！",
