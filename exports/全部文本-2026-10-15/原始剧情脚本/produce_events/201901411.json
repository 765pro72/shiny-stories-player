    "charLipAnim": "lip_smile_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分以外の人の夢を\r\n心から応援できたり",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
