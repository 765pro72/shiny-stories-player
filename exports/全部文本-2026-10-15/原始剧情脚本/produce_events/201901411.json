    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつか、絶対に言えるだろうから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019014110100,
    "speaker": "愛依",
    "text": "……うん\r\nサンキュ",
