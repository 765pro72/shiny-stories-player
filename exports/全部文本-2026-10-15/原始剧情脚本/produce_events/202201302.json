    },
    "voice": "produce_events/202201302/2022013020010"
  },
  {
    "id": 2022013020020,
    "speaker": "小糸",
    "text": "わたしは……えっと\r\n詳しいわけじゃないんですけど……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201302/2022013020020"
  },
  {
    "id": 2022013020030,
    "speaker": "小糸",
    "text": "資料のお写真を見て……\r\nす、素敵だなって思いました……！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
