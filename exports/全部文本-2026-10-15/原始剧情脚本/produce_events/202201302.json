  {
    "speaker": "プロデューサー",
    "text": "小糸、おまたせ\r\n──っと、調べものしてたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022013020070,
    "speaker": "小糸",
    "text": "あ、はい……！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
