[
  {
    "id": 2015003110010,
    "speaker": "甜花",
    "text": "……じゃあ、お喋りする番組の台本、\r\n確認、しておくね……",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp2",
    "charLabel": "tenka",
    "textCtrl": "p",
