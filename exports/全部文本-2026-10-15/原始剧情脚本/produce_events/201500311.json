    "bg": "00002",
    "bgm": "002",
    "voice": "produce_events/201500311/2015003110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、頼んだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003110020,
    "speaker": "甜花",
    "text": "うん……え、えっと……次の予定は……\r\nスタジオで、打ち合わせ……だったかな……？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500311/2015003110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだ\r\nもう一人でスケジュールの管理もばっちりだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……けどまだ時間もあるから、\r\n今のうちにちょっと休んでおこうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003110030,
    "speaker": "甜花",
    "text": "うん……\r\n……プロデューサーさん……コーヒー、飲む……？",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500311/2015003110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、甜花に淹れてもらうのは悪いから\r\n自分で淹れるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003110040,
    "speaker": "甜花",
    "text": "いいよ……気分転換……\r\nプロデューサーさん、待ってて……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500311/2015003110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nじゃあ、お願いしようかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003110050,
    "speaker": "甜花",
    "text": "……うん\r\n頑張って、淹れるね……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500311/2015003110050"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
