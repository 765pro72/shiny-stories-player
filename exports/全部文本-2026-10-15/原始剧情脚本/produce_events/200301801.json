    "voice": "produce_events/200301801/2003018010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "────おっ\r\n今度の舞台の……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003018010040,
    "speaker": "めぐる",
    "text": "それ！\r\nすっごく素敵なお話だったの！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、偉いな\r\nオファー受けたばかりなのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003018010050,
    "speaker": "めぐる",
    "text": "えへへ……\r\nどんなお話か気になっちゃって……！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010050"
  },
  {
    "id": 2003018010060,
    "speaker": "めぐる",
    "text": "主人公のサウレがね\r\n太陽みたいに元気で明るくて……！",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010060"
  },
  {
    "id": 2003018010070,
    "speaker": "めぐる",
    "text": "不思議な力を使って\r\n困ってる人たちを助けていくんだよ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010070"
  },
  {
    "id": 2003018010080,
    "speaker": "めぐる",
    "text": "……って、プロデューサーは\r\nもう知ってると思うんだけど！",
