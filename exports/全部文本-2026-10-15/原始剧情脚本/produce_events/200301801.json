    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、実はまだ読めてないんだ\r\nよかったら少し教えてくれないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003018010090,
    "speaker": "めぐる",
    "text": "そうなの？\r\nお仕事お疲れさまです……！",
