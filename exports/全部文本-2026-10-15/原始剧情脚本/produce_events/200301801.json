  {
    "id": 2003018010100,
    "speaker": "めぐる",
    "text": "サウレはねー、ずっと曇ってて作物が育たない町に\r\nたまたま立ち寄るんだけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010100"
  },
  {
    "id": 2003018010110,
    "speaker": "めぐる",
    "text": "そこで町の人たちに力を貸してあげるの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010110"
  },
  {
    "id": 2003018010120,
    "speaker": "めぐる",
    "text": "サウレの不思議な力で\r\nみんながどんどん笑顔になっていって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301801/2003018010120"
  },
  {
    "id": 2003018010130,
    "speaker": "めぐる",
    "text": "ほんとに太陽みたいな子なんだー！",
