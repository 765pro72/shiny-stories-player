  },
  {
    "id": 1023004020220,
    "speaker": "雛菜",
    "text": "──あ、あと！\r\nもう一個、いいなって思ったのがあって",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
