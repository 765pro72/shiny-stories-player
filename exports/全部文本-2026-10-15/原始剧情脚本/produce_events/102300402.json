      "time": 100
    },
    "voice": "produce_events/102300402/1023004020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、なんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004020230,
    "speaker": "雛菜",
    "text": "オープニングとか、あと曲の間に映像が入るでしょ？\r\nああいう時に、小さい頃の写真使うの",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300402/1023004020230"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hinana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
