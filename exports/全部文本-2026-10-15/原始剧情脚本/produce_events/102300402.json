    "waitTime": 1500
  },
  {
    "id": 1023004020150,
    "speaker": "雛菜",
    "text": "曲の間にバラエティコーナーみたいなのやってる\r\nアイドルの人も多くて",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
