  {
    "id": 3002013010010,
    "speaker": "灯織",
    "text": "水族館の割引券……\r\n本当にいただいてしまっていいんでしょうか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201301/3002013010010"
  },
  {
    "speaker": "新聞配達員",
    "text": "どうぞどうぞ。それ、結構割引率いいやつなんで\r\n気が向いたらうちの新聞契約してもらえると嬉しいっす",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3002013010020,
    "speaker": "灯織",
    "text": "契約の方が本命なのでは……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201301/3002013010020"
  },
  {
    "speaker": "新聞配達員",
    "text": "アハハ、まあそうなんすけど\r\n親御さんいないなら用はないからバイバイってわけにもね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3002013010030,
    "speaker": "灯織",
    "text": "その……すみません……\r\n母は帰宅が遅くて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201301/3002013010030"
  },
  {
    "speaker": "新聞配達員",
    "text": "いやいや、責めてるとかじゃないっすから！\r\nじゃ、親御さん帰ってきたらよろしくお伝えくださーい",
    "textCtrl": "p",
    "textFrame": "003"
  },
