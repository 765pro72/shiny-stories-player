    "charAnim2": "face_close6",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701703/2007017030030"
  },
  {
    "id": 2007017030040,
    "speaker": "結華",
    "text": "部屋の近くぐるっと回ったら戻ろうと思ってて",
