    }
  },
  {
    "id": 2013008010070,
    "speaker": "夏葉",
    "text": "トランプを使った……\r\nパフォーマンスの練習を……しているけれど",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0736",
    "voice": "produce_events/201300801/2013008010070"
  },
  {
