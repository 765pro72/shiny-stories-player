    "voice": "produce_events/201300801/2013008010040"
  },
  {
    "id": 2013008010050,
    "speaker": "夏葉",
    "text": "あのゲームアプリは、\r\nポーカーを題材にしているでしょう？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
