    "textFrame": "001",
    "voice": "produce_events/201300801/2013008010050"
  },
  {
    "id": 2013008010060,
    "speaker": "夏葉",
    "text": "だからこうやって……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
