    "waitTime": 1000
  },
  {
    "id": 2013008010080,
    "speaker": "夏葉",
    "text": "……ごめんなさい、うるさかった？\r\nここでやっていたらまずかったかしら",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201300801/2013008010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、それはいいけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008010090,
    "speaker": "夏葉",
    "text": "そう？　よかった",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300801/2013008010090"
  },
  {
    "id": 2013008010100,
    "speaker": "夏葉",
    "text": "やるからには完璧にしなくちゃって……\r\n空き時間には練習するようにしているけれど",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300801/2013008010100"
  },
  {
    "id": 2013008010110,
    "speaker": "夏葉",
    "text": "でも……まだ全然だめね",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300801/2013008010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……\r\n衣装を着てやるとなると一層難しいだろうしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008010120,
    "speaker": "夏葉",
    "text": "そうね\r\nでも、失敗出来ないわ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300801/2013008010120"
  },
  {
    "id": 2013008010130,
    "speaker": "夏葉",
    "text": "キャラクターに扮して\r\nステージに立つんだから",
