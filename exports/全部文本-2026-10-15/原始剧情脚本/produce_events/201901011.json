  {
    "speaker": "プロデューサー",
    "text": "愛依、そっちはどうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 2019010110010,
    "speaker": "愛依",
    "text": "オッケーっぽい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、じゃあやるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110011,
    "speaker": "愛依",
    "text": "ゲームスタート！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110011"
  },
  {
    "textFrame": "off",
    "bg": "99999",
    "bgEffect": "fade",
    "bgEffectTime": 600,
    "se": "1059",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "textFrame": "off",
    "bg": "00608",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "bgm": "0153",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2019010110020,
    "speaker": "愛依",
    "text": "ふぅ～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "景色の流れ方がリアルだな……！\r\n本当に走ってるみたいだ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110030,
    "speaker": "愛依",
    "text": "でしょ！\r\nマジでハンパないよね～♪",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "これなら、ちょっとバイク乗ってみたい\r\nくらいの人は満足しちゃいそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、でも愛依は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110040,
    "speaker": "愛依",
    "text": "あ～……\r\nそのことなんだけどさ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110050,
    "speaker": "愛依",
    "text": "うち、やっぱ今はやめとく！\r\n免許！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、そうなのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2019010110060,
    "speaker": "愛依",
    "text": "うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110060"
  },
  {
    "id": 2019010110070,
    "speaker": "愛依",
    "text": "うちさ、今はみんなに喜んでもらうことに\r\n全力でいたいんだよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110070"
  },
  {
    "id": 2019010110080,
    "speaker": "愛依",
    "text": "練習とかレッスンとかしてたら\r\n勉強の時間なさそうじゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110080"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110090,
    "speaker": "愛依",
    "text": "……どっちもできたらいいけどさ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110090"
  },
  {
    "id": 2019010110100,
    "speaker": "愛依",
    "text": "うちそんな器用じゃないし！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110100"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2019010110110,
    "speaker": "愛依",
    "text": "だから\r\nまだしばらくはよろしく！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110110"
  },
  {
    "id": 2019010110120,
    "speaker": "愛依",
    "text": "車！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう\r\n任せとけ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110130,
    "speaker": "愛依",
    "text": "サンキュ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2019010110140,
    "speaker": "愛依",
    "text": "代わりにさ、\r\nいつか免許取ったら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110140"
  },
  {
    "id": 2019010110150,
    "speaker": "愛依",
    "text": "プロデューサー乗せて\r\n好きなとこ連れてったげる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、それは楽しみだ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110160,
    "speaker": "愛依",
    "text": "どこ行きたいとか決めといてね～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "それなら\r\nちょっとわがままを言っていいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110170,
    "speaker": "愛依",
    "text": "お、何々～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110170"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依がライブをした場所を全部回ろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019010110180,
    "speaker": "愛依",
    "text": "え～？\r\nそんなんでいいの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、かなり大変だぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依が免許を取る頃には、一日じゃ回り切れない数に\r\nなってるに決まってるからな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 2019010110190,
    "speaker": "愛依",
    "text": "それじゃ、プロデューサーにも\r\nちょー長い休み取ってもらわなきゃね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901011/2019010110190"
  },
