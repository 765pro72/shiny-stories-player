[
  {
    "speaker": "プロデューサー",
    "text": "真乃、平気か？　緊張とかしていないか？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textCtrl": "p",
