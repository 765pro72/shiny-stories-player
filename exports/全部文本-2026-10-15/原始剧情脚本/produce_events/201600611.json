    "charAnim2": "blank",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600611/2016006110040"
  },
  {
    "id": 2016006110050,
    "speaker": "千雪",
    "text": "今日は、ご褒美だからいいんですよっ",
