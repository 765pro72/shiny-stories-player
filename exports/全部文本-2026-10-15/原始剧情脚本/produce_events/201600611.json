    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "でもさ\r\nいちごのことも、たい焼きのしっぽも、千雪らしいよ",
