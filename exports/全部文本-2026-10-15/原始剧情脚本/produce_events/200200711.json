  {
    "id": 2002007110210,
    "speaker": "灯織",
    "text": "これからも、私の隣で……\r\n一緒に歩んでください、プロデューサー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200711/2002007110210"
  },
  {
    "id": 2002007110220,
    "speaker": "灯織",
    "text": "もし私が先に行くことがあっても、こうやって……\r\n絶対に……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200711/2002007110220"
  },
  {
    "id": 2002007110230,
    "speaker": "灯織",
    "text": "絶対に待ってますから……！",
