    "waitTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00087",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2002007110180,
    "speaker": "灯織",
    "text": "プロデューサーがそう思ってくれてるなら……\r\n先に行って引っ張れるよう、頑張ります",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200711/2002007110180"
  },
  {
    "id": 2002007110190,
    "speaker": "灯織",
    "text": "でも、私ひとりじゃ、きっと今みたいに\r\n数歩しか……少ししか先に進めません……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200711/2002007110190"
  },
  {
    "id": 2002007110200,
    "speaker": "灯織",
    "text": "だから……",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/200200711/2002007110200"
  },
  {
