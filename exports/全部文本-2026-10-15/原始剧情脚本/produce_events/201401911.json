  },
  {
    "id": 2014019110200,
    "speaker": "甘奈",
    "text": "じゃあ、もっとわがままなこと！\r\nお願いしちゃうよ！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201401911/2014019110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、言ってみてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110210,
    "speaker": "甘奈",
    "text": "プロデューサーさんにとって甘奈が一番の\r\nアイドルだって言えるくらい、ずっと輝き続けられたら",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110210"
  },
  {
    "id": 2014019110220,
    "speaker": "甘奈",
    "text": "その時は、甘奈のお願いを\r\nなんでもひとつ、聞いてくれる？",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "っと……確かに……\r\n甘奈にしては結構なわがままだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110230,
    "speaker": "甘奈",
    "text": "えー、いいって言ったのに～！",
    "charAnim1": "sad1",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、わかったよ\r\nその時は言うことを聞こう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110240,
    "speaker": "甘奈",
    "text": "絶対だからね～！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110240"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "amana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
