    "bgEffectTime": 1000
  },
  {
    "id": 2014019110100,
    "speaker": "甘奈",
    "text": "ねぇ、プロデューサーさん\r\nさっき、スランプ解決のこと、秘密にしちゃったから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110100"
  },
  {
    "id": 2014019110110,
    "speaker": "甘奈",
    "text": "代わりにって言ったら変だけど、\r\n別のこと、お話ししてもいい？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nああ、いいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00457",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 2014019110120,
    "speaker": "甘奈",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110120"
  },
  {
    "textFrame": "off",
    "bgm": "103",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2014019110130,
    "speaker": "甘奈",
    "text": "誰かに対して、迷惑な気持ちを抱えちゃったら？\r\nっていう話、したでしょ？",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201401911/2014019110130"
  },
  {
    "id": 2014019110140,
    "speaker": "甘奈",
    "text": "あれ、誰のことって言わずにお話したけど\r\n甘奈のことだったんだ",
    "charAnim1": "wait2",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110140"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_trouble",
    "charLabel": "amana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "なんとなく、そうじゃないかとは\r\n思ってたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "その話をしてくれる、っていうことは\r\n甘奈なりに解決したってことかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2014019110150,
    "speaker": "甘奈",
    "text": "……うん",
    "charAnim1": "wait3",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201401911/2014019110150"
  },
  {
    "id": 2014019110160,
    "speaker": "甘奈",
    "text": "甘奈ね、プロデューサーさんに対して\r\n持っちゃった気持ちがあったの",
    "charAnim1": "sad2",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110160"
  },
  {
    "id": 2014019110170,
    "speaker": "甘奈",
    "text": "甘奈がアイドルでいる間は、ずっと……ちゃんと\r\n見ててほしいっていう気持ち",
    "charAnim1": "shy2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nそれのどこが迷惑なんだ？　当たり前じゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110180,
    "speaker": "甘奈",
    "text": "えぇっ！？　ずっとだよ！？\r\n甘奈がおばあちゃんになって、アイドルしててもだよ？",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、だったら\r\n俺はおじいちゃんになってもプロデューサーでいればいいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110190,
    "speaker": "甘奈",
    "text": "……はぁ……敵わないなぁ\r\nプロデューサーさんには……",
    "charAnim1": "wait1",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110190"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "amana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
