    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201401911/2014019110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "プロモーション映像に合わせて\r\nアンドロメダ特集をやってたのも印象的だったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈が教えてくれた話の続きで\r\nペルセウスの恋人になるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110080,
    "speaker": "甘奈",
    "text": "そうなんだよ～！　お互いにとって\r\n運命の人だったんだと思う！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110080"
  },
  {
    "charAnim1": "wait",
