  {
    "id": 2014019110250,
    "speaker": "甘奈",
    "text": "（プロデューサーさんが誰かに\r\n想われてるかは、結局聞けなかったけど）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110250"
  },
  {
    "id": 2014019110260,
    "speaker": "甘奈",
    "text": "（そんなことは、もういいんだ）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110260"
  },
  {
    "id": 2014019110270,
    "speaker": "甘奈",
    "text": "（『好き』っていう気持ちに\r\n蓋をすることはできないし）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401911/2014019110270"
  },
  {
    "id": 2014019110280,
    "speaker": "甘奈",
    "text": "（甘奈がいっちばん魅力的になっちゃえば\r\nそんなこと、関係ないもんね！）",
