  },
  {
    "id": 2014019110090,
    "speaker": "甘奈",
    "text": "……プロデューサーさん。甘奈、もう少し\r\n星が見たいんだけど、いいかな？　近くにいい所、あるの",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201401911/2014019110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、大丈夫だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "amana",
