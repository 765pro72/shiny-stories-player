  {
    "speaker": "プロデューサー",
    "text": "お、甘奈、あのモニター見てくれ\r\nこの前撮影したムービーが映ってるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014019110020,
    "speaker": "甘奈",
    "text": "本当だ～、こんな感じで使われてるんだね～",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
