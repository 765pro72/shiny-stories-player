  {
    "id": 2014019110070,
    "speaker": "甘奈",
    "text": "映像、綺麗だったね～\r\nめっちゃ楽しかった～",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
