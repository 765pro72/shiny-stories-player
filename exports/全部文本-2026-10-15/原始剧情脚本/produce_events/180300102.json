  {
    "id": 1803001020010,
    "speaker": "MEMちょ",
    "text": "プロデューサー、動画作ってもいい！？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "803",
    "charPosition": {
