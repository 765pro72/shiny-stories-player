  {
    "speaker": "プロデューサー",
    "text": "あさひにドラマのヒロイン役の\r\nオファーがあったんだ",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious_s",
