  {
    "id": 6016004040020,
    "speaker": "千雪",
    "text": "そんな、気がします",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\n最高のライブだったぞ、千雪",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016004040030,
    "speaker": "千雪",
    "text": "……はい\r\nおこがましいですけど……自分でも、そう思います",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040030"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪は謙虚だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もっと自信をもっていい、\r\nそのくらいすごい成功だったんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016004040040,
    "speaker": "千雪",
    "text": "ふふっ、私――",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040040"
  },
  {
    "id": 6016004040050,
    "speaker": "千雪",
    "text": "謙虚どころか、\r\n傲慢だったな、って思ってました",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016004040060,
    "speaker": "千雪",
    "text": "私たちの世界をただ、一方的に伝えるんじゃなくて……",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040060"
  },
  {
    "id": 6016004040070,
    "speaker": "千雪",
    "text": "皆が求めてくれることで、\r\nアルストロメリアは咲けるんだなあ……って……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040070"
  },
  {
    "id": 6016004040080,
    "speaker": "千雪",
    "text": "ステージの上の私たちだけじゃなくって……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040080"
  },
  {
    "id": 6016004040090,
    "speaker": "千雪",
    "text": "客席のファンの皆さん……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040090"
  },
  {
    "id": 6016004040100,
    "speaker": "千雪",
    "text": "いっぱい、満開の花が咲いていて……\r\nああ、綺麗だなって……胸がいっぱいになりました",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかる気がするよ\r\n一体感、舞台袖まで伝わってきたからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016004040110,
    "speaker": "千雪",
    "text": "今までも、ぼんやりわかっていたんですが……",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600404/6016004040110"
  },
  {
    "id": 6016004040120,
    "speaker": "千雪",
    "text": "全身で実感したのは初めてで……",
    "charAnim1": "anger2",
