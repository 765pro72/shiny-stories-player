    "voice": "produce_events/101000504/1010005040150"
  },
  {
    "speaker": "智代子の弟",
    "text": "乗らないで姉さん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1010005040160,
    "speaker": "智代子",
    "text": "あは、ごめん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040160"
  },
  {
    "speaker": "智代子の父",
    "text": "ふたりともお母さんと俺の子だしな……\r\n正直芸能界にスカウトされるポテンシャルはあると思う",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1999"
  },
  {
    "speaker": "智代子の弟",
    "text": "『俺たちの子だしな、うんうん』じゃないんだよ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
