      "time": 100
    },
    "voice": "produce_events/101000504/1010005040050"
  },
  {
    "speaker": "智代子の母",
    "text": "なんで？　なるんじゃないの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1010005040060,
    "speaker": "智代子",
    "text": "ならないよ！？\r\nっていうかなれないよ！！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040060"
  },
  {
    "id": 1010005040070,
    "speaker": "智代子",
    "text": "あれは絶対スタッフさんのお世辞みたいなヤツだって\r\n言ったじゃん……！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
