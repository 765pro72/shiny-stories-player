    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040070"
  },
  {
    "speaker": "智代子の母",
    "text": "ええー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "智代子の父",
    "text": "待ってくれ智代子、状況が飲み込めない\r\nお父さんにも説明を……",
