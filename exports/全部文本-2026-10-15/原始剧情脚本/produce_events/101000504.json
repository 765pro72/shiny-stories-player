  {
    "id": 1010005040090,
    "speaker": "智代子",
    "text": "あすみちゃんが……その\r\n緊張でオーディションに参加できなくなっちゃって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040090"
  },
  {
    "speaker": "智代子の父",
    "text": "……そうか",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "2314",
    "autoWaitTime": 1000
  },
  {
    "id": 1010005040100,
    "speaker": "智代子",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040100",
    "autoWaitTime": 1000
  },
  {
    "id": 1010005040110,
    "speaker": "智代子",
    "text": "……でもそのまま不参加になっちゃうと、グループ課題で\r\n他の人に迷惑がかかっちゃうって気にしてて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040110"
  },
  {
    "id": 1010005040120,
    "speaker": "智代子",
    "text": "だから代わりに出させてもらって──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040120"
  },
  {
    "textFrame": "off",
    "bg": "00031",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "智代子の母",
    "text": "それでそのあと事務所の人に\r\n『合格通知を送りたい』って言われたんだってー",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0508"
  },
  {
    "speaker": "智代子の父",
    "text": "おお……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1010005040130,
    "speaker": "智代子",
    "text": "全然『おお……！』じゃないんだってば\r\n事務所の人が気を遣ってくれただけだよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000504/1010005040130"
  },
  {
    "speaker": "智代子の母",
    "text": "そうかなぁ",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0328",
    "autoWaitTime": 1000
  },
  {
    "speaker": "智代子の母",
    "text": "いい加減なこと言って不合格にしたら\r\n責められかねないのに、そんなことする？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "智代子の母",
    "text": "少なくともその人は本気だね",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "id": 1010005040140,
    "speaker": "智代子",
    "text": "いやいやいや……",
