  },
  {
    "id": 3001003030030,
    "speaker": "真乃",
    "text": "うん、今日お天気良くてよかったね\r\nピクニック日和だよ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030030"
  },
  {
    "id": 3001003030040,
    "speaker": "灯織",
    "text": "そうだね、確かにいい天気\r\nシートに座ると意外と気持ちいいし",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030040"
  },
  {
    "id": 3001003030050,
    "speaker": "真乃",
    "text": "ほわぁ～、こんなぽかぽかの日に\r\nお昼寝すると気持ちいいんだよ～",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030050"
  },
  {
    "id": 3001003030060,
    "speaker": "灯織",
    "text": "ここでお昼寝か……\r\n私はちょっと恥ずかしいかな……",
    "charAnim1": "shy2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030060"
  },
  {
    "id": 3001003030070,
    "speaker": "真乃",
    "text": "そっか、じゃあ今日はやめておくよ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030070"
  },
  {
    "id": 3001003030080,
    "speaker": "真乃",
    "text": "……あ、鳩さんだ\r\nこんにちは、いいお天気だね～",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030080"
  },
  {
    "id": 3001003030090,
    "speaker": "灯織",
    "text": "なんだろう、\r\n真乃が鳥と話してるのを見てると癒されるな",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030090"
  },
  {
    "id": 3001003030100,
    "speaker": "真乃",
    "text": "ほわっ\r\nな、なんだか恥ずかしいよ……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030100"
  },
  {
    "id": 3001003030110,
    "speaker": "真乃",
    "text": "……でも、\r\n私もいろんな鳥さんたちと遊んでると癒されるんだ",
