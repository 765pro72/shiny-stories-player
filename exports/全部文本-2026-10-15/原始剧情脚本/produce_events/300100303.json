    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030370"
  },
  {
    "id": 3001003030380,
    "speaker": "灯織",
    "text": "今日、真乃とピクニックに来れてよかった\r\nなんとなく、真乃が公園を好きな理由がわかったから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030380"
  },
  {
    "id": 3001003030390,
    "speaker": "灯織",
    "text": "こうやって鳥たちを見ながら、\r\n太陽の下でピクニックしてる雰囲気全部が……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030390"
  },
  {
    "id": 3001003030400,
    "speaker": "灯織",
    "text": "真乃そのものに似てるんだなって思った",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030400"
  },
  {
    "id": 3001003030410,
    "speaker": "真乃",
    "text": "ほわわっ……\r\nそんなふうに言われると、うれしいかも……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030410"
  },
  {
    "id": 3001003030420,
    "speaker": "灯織",
    "text": "それに今日改めて思った\r\n真乃は好きなものがあって、本当にすごいって",
    "charAnim1": "anger1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030420"
  },
  {
    "id": 3001003030430,
    "speaker": "灯織",
    "text": "公園や鳥、自然が好きっていう気持ちが\r\n真乃の柔らかい雰囲気を作ってるんだね",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030430"
  },
  {
    "id": 3001003030440,
    "speaker": "真乃",
    "text": "……灯織ちゃんはどうかな？\r\nどんなのが好き？",
    "charAnim1": "shy2",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030440"
  },
  {
    "id": 3001003030450,
    "speaker": "灯織",
    "text": "私は、そういうのよくわからなくて\r\n真乃みたいに、好きって言えるものはないの",
    "charAnim1": "sad1",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030450"
  },
  {
    "id": 3001003030460,
    "speaker": "灯織",
    "text": "だから、なんで真乃は公園や鳥が好きなんだろうって\r\n気になった",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030460"
  },
  {
    "id": 3001003030470,
    "speaker": "灯織",
    "text": "一緒にピクニックに行けば何かわかるかも、\r\nそう思って今日は来たんだ",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100303/3001003030470"
  },
  {
    "id": 3001003030480,
    "speaker": "真乃",
    "text": "そっか……それなら灯織ちゃんにも、\r\n公園や鳥さんを好きになって欲しいな",
    "charAnim1": "sad1",
    "charAnim2": "face_smile",
