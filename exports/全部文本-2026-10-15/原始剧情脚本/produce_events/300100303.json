  {
    "id": 3001003030130,
    "speaker": "灯織",
    "text": "あ、そろそろお昼かな？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
