    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301601/2003016010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺から見ると、めぐるはひとりでも十分すぎるほど\r\nパフォーマンスできると思ってるんだけど",
