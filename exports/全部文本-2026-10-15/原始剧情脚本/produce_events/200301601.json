    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ソロでの仕事も増えてきてるし、\r\n場合によってはひとりで歌うことも踊ることもあるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
