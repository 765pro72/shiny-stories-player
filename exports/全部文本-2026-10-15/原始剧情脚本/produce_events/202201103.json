    "voice": "produce_events/202201103/2022011030120"
  },
  {
    "id": 2022011030130,
    "speaker": "小糸",
    "text": "……なんだか、少し掴めたような気がして\r\nいざ演じてみたら、監督さんにも良かったって言われて",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201103/2022011030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、すごいじゃないか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011030140,
    "speaker": "小糸",
    "text": "……アドバイスをくれた俳優さんの\r\nおかげなんです",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
