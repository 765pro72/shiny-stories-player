  {
    "speaker": "プロデューサー",
    "text": "どうだった？　初日は……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011030120,
    "speaker": "小糸",
    "text": "は、はい、順調でした……！",
