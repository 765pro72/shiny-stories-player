    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201103/2022011030060"
  },
  {
    "speaker": "信重役の俳優",
    "text": "よし、じゃあ兄の俺と一緒に考えてみよう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022011030070,
    "speaker": "小糸",
