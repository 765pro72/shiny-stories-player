    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201103/2022011030230"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、期待してるぞ！",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end",
    "autoWaitTime": 1700
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "小糸にとって、今回の仕事は楽しいものに\r\nなってくれそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011030240,
    "speaker": "小糸",
    "text": "はい。最初はちょっと……結構、悩みましたけど……",
    "charAnim1": "wait3",
