    "voice": "produce_events/201600801/2016008010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはよう\r\nやっぱり千雪だったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こんな朝早くから……ランニングか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016008010020,
    "speaker": "千雪",
    "text": "は、はいっ\r\n寮から軽く走ってきたんです",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010020"
  },
  {
    "id": 2016008010030,
    "speaker": "千雪",
    "text": "それで今は、公園で何してたかっていうと\r\n休憩しているところで……",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、見てればわかるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016008010040,
    "speaker": "千雪",
    "text": "……そ、そうですよね！\r\nあはは……！",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、朝から走るなんて頑張ってるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016008010050,
    "speaker": "千雪",
    "text": "いえ、そんなことないんです……！",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010050"
  },
  {
    "id": 2016008010060,
    "speaker": "千雪",
    "text": "ただ最近は日中の気温が高いから、\r\n朝早くに走っちゃおうって決めているだけで……",
