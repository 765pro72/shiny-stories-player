    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010060"
  },
  {
    "id": 2016008010070,
    "speaker": "千雪",
    "text": "……それに、それを言うなら\r\nプロデューサーさんもですよ",
