    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600801/2016008010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\n俺も、千雪と同じような感じだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "日中は暑いからな……\r\n少しでも涼しいうちに出勤しちゃおうと思ってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016008010090,
    "speaker": "千雪",
    "text": "ふふ、そうだったんですね",
