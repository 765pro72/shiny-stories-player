    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000301/1010003010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nそれはちょっと意味が違う気が……",
    "textCtrl": "p",
    "textFrame": "002"
  },
