      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまん凛世！\r\n時間がかかりすぎ……た……",
    "charAnim2": "face_serious",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010070,
    "speaker": "凛世",
    "text": "いえ……\r\n打ち合わせは、お済みになったのですね",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010080,
    "speaker": "凛世",
    "text": "あの、プロデューサーさま？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はっ、すまん！\r\n思わず見とれてしまった",
    "charAnim1": "wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010090,
    "speaker": "凛世",
    "text": "ええ……\r\n素晴らしい、お庭でございますね……",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "（見とれていたのは庭の景色だけじゃないんだが……\r\n……このまま撮影したいぐらいだ）",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010100,
    "speaker": "凛世",
    "text": "……？",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや……機材の方がもうちょっとかかるみたいだから\r\nまだゆっくりしてていいぞ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010110,
    "speaker": "凛世",
    "text": "承知いたしました\r\nプロデューサーさまも、こちらに……？",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、しばらく待機だ\r\n……どうかしたか？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010120,
    "speaker": "凛世",
    "text": "ふふ……いえ",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nところで、それ、何読んでるんだ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010130,
    "speaker": "凛世",
    "text": "少女漫画でございます……\r\n──智代子さんに、お借りしました",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、さっき何か持ってきてるって言ってたな",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いまドラマで放送してるやつか\r\n凛世はそういうのが好きなのか？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010140,
    "speaker": "凛世",
    "text": "はい……\r\n勉強を……しております……",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "勉強？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010150,
    "speaker": "凛世",
    "text": "はい……智代子さんが……\r\n「恋のいろは」が、書かれていると",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "（んん……たしかあのドラマは\r\n独特な世界観が売りだったような……）",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010160,
    "speaker": "凛世",
    "text": "……どうか、なさいましたか？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……間違ってないと思うけど、\r\nあまり真に受けない方がいいぞ？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010170,
    "speaker": "凛世",
    "text": "……そう、でしょうか……",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、たぶんな。……と、もうこんな時間か\r\n凛世、そろそろ移動しよう",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010180,
    "speaker": "凛世",
    "text": "……プロデューサーさま",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010190,
    "speaker": "凛世",
    "text": "……ずっと……お慕いしております",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010190"
  },
  {
    "id": 2012003010200,
    "speaker": "凛世",
    "text": "もう、お傍を……\r\n……離れたくありません",
    "charAnim1": "sad1",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ、ど、どうしたんだ急に……？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010210,
    "speaker": "凛世",
    "text": "貴方さまと、\r\n永遠に、添い遂げたいのです……",
    "charAnim1": "shy2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あ、ああ！　さっきの少女漫画の台詞か！\r\nびっくりした……）",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こ、こほん、緊張はしていないようだな\r\n……それじゃあ頑張ろう、凛世！",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012003010220,
    "speaker": "凛世",
    "text": "……はい、プロデューサーさま",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010220"
  },
  {
    "id": 2012003010230,
    "speaker": "凛世",
    "text": "……はい……",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200501/2012003010230"
  },
