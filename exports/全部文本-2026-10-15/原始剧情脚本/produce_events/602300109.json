  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6023001090220,
    "speaker": "雛菜",
    "text": "あ～～～！　でも～……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
