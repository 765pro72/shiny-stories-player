  {
    "speaker": "プロデューサー",
    "text": "おう、差し入れ持ってきたんだ\r\nいつものドリンクと軽食",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025009040070,
    "speaker": "美琴",
    "text": "ありがとう、いただくね",
