    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500904/2025009040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういえばさっきトレーナーさんに会って\r\n美琴の調子が良くなったって聞いたけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……大丈夫そうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025009040080,
    "speaker": "美琴",
    "text": "うん……",
