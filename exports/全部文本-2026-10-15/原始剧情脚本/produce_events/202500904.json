    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500904/2025009040090"
  },
  {
    "id": 2025009040100,
    "speaker": "美琴",
    "text": "休んで死んだら夢を叶えられないまま終わる……\r\nそう思ったらすごく、レッスンがしたくなって",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
