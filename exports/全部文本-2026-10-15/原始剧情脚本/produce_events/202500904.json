    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500904/2025009040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……俺にはまだ少し、思うことがあるように見えてるけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "shy1",
