    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500904/2025009040100"
  },
  {
    "id": 2025009040110,
    "speaker": "美琴",
    "text": "だから、今は歌い続けて、動き続けるしかない\r\n────そう思ったの",
    "charAnim1": "think1",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
