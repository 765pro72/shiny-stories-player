  },
  {
    "id": 2019016020170,
    "speaker": "愛依",
    "text": "『ストレイライトの解散のことだけは\r\n色々と考えちゃうんだよね、それも何回も』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020170"
  },
