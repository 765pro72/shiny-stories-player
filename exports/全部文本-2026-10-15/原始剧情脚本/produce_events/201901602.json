  {
    "speaker": "プロデューサー",
    "text": "『風を受けて走るの、いいなぁ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019016020090,
    "speaker": "愛依",
    "text": "『超気持ちいいっしょ\r\n疲れとかストレス、吹っ飛ばしてってね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ああ、いいリフレッシュになりそうだ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "2539",
    "waitType": "time",
    "waitTime": 5300
  },
  {
    "speaker": "プロデューサー",
    "text": "『ところで、愛依。たぶんだけど\r\n俺に話したいこと、あるんだよな？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019016020100,
    "speaker": "愛依",
    "text": "『！？　なんでわかったの？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "『昔から、愛依は顔に出やすいからな』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019016020110,
    "speaker": "愛依",
    "text": "『高校の頃よりは\r\n隠すの上手くなったつもりなんだけどなぁ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020110"
  },
  {
    "id": 2019016020120,
    "speaker": "愛依",
    "text": "『けどそっか。付き合い６年になるし\r\nプロデューサーにはわかっちゃうか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "『だな。それに、少しの変化に気付くのも\r\n俺の役目だろ？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019016020130,
    "speaker": "愛依",
    "text": "『アハハ。そういうとこ、昔から変わってないね\r\n本当、かっこいいわ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020130"
  },
  {
    "textFrame": "off",
    "bg": "00087",
    "bgEffect": "fade",
    "se": "2535",
    "waitType": "time",
    "waitTime": 6000,
    "bgEffectTime": 1500
  },
  {
    "id": 2019016020140,
    "speaker": "愛依",
    "text": "『……プロデューサーはさ、後悔した経験ってある？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "『……ない！　って言えればいいんだろうけど\r\nもちろんあるよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『あの時ああしていれば、とか\r\nもっといい方法があったんじゃないか、とか』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『人並みに思うことはある』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『でも、その時の自分はそれが最善だって判断\r\nしたんだろうから、後悔しすぎないようにはしてるよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019016020150,
    "speaker": "愛依",
    "text": "『だよね。うちもそう考えるようにしてる』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020150"
  },
  {
