  },
  {
    "id": 2019016020180,
    "speaker": "愛依",
    "text": "『うちらは、しっかり行くとこまでは行ったし\r\nみんな納得して、今は別々の道を進んでる』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020180"
  },
