  {
    "id": 2019016020160,
    "speaker": "愛依",
    "text": "『でも、あのこと』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201901602/2019016020160"
  },
  {
    "textFrame": "off",
