  },
  {
    "id": 2019016020210,
    "speaker": "愛依",
    "text": "サンキュ、ソフトクリーム\r\nバニラとチョコどっちがいい？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
