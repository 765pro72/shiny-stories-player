  {
    "speaker": "プロデューサー",
    "text": "お疲れ様",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "先日のプロモーションビデオの件\r\n前撮りの写真撮影シーンがあっただろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 3025022040020,
    "speaker": "美琴",
    "text": "うん、あったね",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502204/3025022040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あの時に撮った写真が先方から送られてきたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "にちかには先に見せたんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile1_s",
    "charLabel": "mikoto",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
