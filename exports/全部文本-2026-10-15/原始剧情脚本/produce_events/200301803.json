    "voice": "produce_events/200301803/2003018030030"
  },
  {
    "speaker": "演出家",
    "text": "読み合わせ、頑張ってたね\r\nサウレのイメージに合わせて、しっかり作ってきてくれて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003018030040,
    "speaker": "めぐる",
    "text": "……！\r\nありがとうございます！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301803/2003018030040"
  },
  {
    "speaker": "演出家",
    "text": "ちゃんと形にしようとしてくれてるのが伝わったよ\r\nその気持ち、すごく嬉しかった",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003018030050,
    "speaker": "めぐる",
    "text": "…………っ",
