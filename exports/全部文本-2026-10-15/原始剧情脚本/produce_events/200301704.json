    "se": "0957",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、はい！　どうぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00695",
    "bgEffect": "fade",
    "se": "0113",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "speaker": "メイクスタッフ",
    "text": "失礼します！\r\nめぐるちゃんトラブルって聞いたんですけど──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……はい、ちょっと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "あ～空気重いですね、きのこ生えちゃいそう……\r\n────任せてもらっても？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、お願いします",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "1391",
    "waitType": "time",
    "waitTime": 600
  },
  {
    "speaker": "メイクスタッフ",
    "text": "めぐるちゃーん！　どしたどした、何があったのー\r\nお顔見ーせて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
