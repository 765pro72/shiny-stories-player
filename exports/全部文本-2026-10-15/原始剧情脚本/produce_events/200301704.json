  {
    "id": 2003017040010,
    "speaker": "めぐる",
    "text": "ごめんなさい！！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301704/2003017040010"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、謝ることじゃない──って言うと\r\n逆に苦しくなっちゃうのかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも本当に、めぐるのせいとかじゃなくてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00695",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "誰も事前に予想なんてできなかったことだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017040020,
    "speaker": "めぐる",
    "text": "でも……自己管理も仕事のうちなのに……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040030100",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200301704/2003017040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……\r\nそう言えばそういうことになるかもしれないけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "気を付けるだけじゃ、どうにもならないことだってあるよ\r\n今がまさにそうだと思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017040030,
    "speaker": "めぐる",
    "text": "プロデューサー……",
    "charAnim1": "wait4",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301704/2003017040030"
  },
  {
    "id": 2003017040040,
    "speaker": "めぐる",
    "text": "でもでも、やっぱり自分のせいで\r\nいろんな人に迷惑かけてる……",
    "charAnim1": "wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301704/2003017040040"
  },
  {
    "id": 2003017040050,
    "speaker": "めぐる",
    "text": "────ニキビなんて全然できなかったのに",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301704/2003017040050"
  },
  {
    "id": 2003017040060,
    "speaker": "めぐる",
    "text": "うぅ…………",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301704/2003017040060"
  },
  {
    "charAnim1": "wait",
