  },
  {
    "speaker": "プロデューサー",
    "text": "（……どうしよう）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（こういう時に、\r\nどう声をかければいいかまったくわからない……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
