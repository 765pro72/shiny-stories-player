    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、\r\n千雪、すごく頑張ってたからな",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001010050,
    "speaker": "千雪",
    "text": "そんな……\r\nやりたくてやってただけなんですよ",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010050",
    "charAnim3Loop": false
  },
  {
    "id": 7016001010060,
    "speaker": "千雪",
    "text": "わからないことばっかりですけど、\r\nでも、レッスンも仕事も、本当に楽しくて……",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "それでも千雪が努力していたことにかわりないぞ\r\n二つのことを、どっちもきちんとやってたからな",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001010070,
    "speaker": "千雪",
    "text": "そうでしょうか……\r\nふふ、ありがとうございます",
    "charAnim2": "face_wait",
