    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010070",
    "charAnim3Loop": false
  },
  {
    "id": 7016001010080,
    "speaker": "千雪",
    "text": "こうなったら、次も頑張らなきゃ……ですね",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010080"
  },
  {
    "id": 7016001010090,
    "speaker": "千雪",
    "text": "神頼みというわけじゃないですけど\r\nお守りでも……作ろうかな……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010090",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、千雪らしくていいんじゃないか？",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001010100,
    "speaker": "千雪",
    "text": "そうですか？",
    "charAnim1": "anger2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010100"
  },
  {
    "id": 7016001010110,
    "speaker": "千雪",
    "text": "じゃあ、その時はプロデューサーさんの分も\r\nお揃いで作りますね♪",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺もいいのか？\r\n俺にはどんなご利益があるんだろうな",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001010120,
    "speaker": "千雪",
    "text": "それは……\r\n私に声をかけたことを後悔しないご利益、でしょうか",
