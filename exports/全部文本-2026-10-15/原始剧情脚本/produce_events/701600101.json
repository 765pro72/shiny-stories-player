    "textFrame": "001",
    "voice": "produce_events/701600101/7016001010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、それなら意味ないな\r\n俺は千雪のこと、一瞬でも後悔したことはないよ",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
