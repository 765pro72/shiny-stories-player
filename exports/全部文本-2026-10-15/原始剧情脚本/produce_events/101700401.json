  {
    "id": 1017004010190,
    "speaker": "あさひ",
    "text": "……プロデューサーさん\r\nなんか、バタバタしてるっす",
    "charAnim1": "think1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
