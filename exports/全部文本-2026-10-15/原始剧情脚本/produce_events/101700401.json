    "waitTime": 1500
  },
  {
    "id": 1017004010120,
    "speaker": "あさひ",
    "text": "『最近始めた新しいことはありますか』",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
