    "voice": "produce_events/101700401/1017004010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん？\r\nなんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010090,
    "speaker": "あさひ",
    "text": "その音、夢にまで出てきたっす",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ、そうだったのか、すまん……\r\n集中してたから、強く打ってたかな",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "0000"
  },
