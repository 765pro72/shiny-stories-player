    "voice": "produce_events/101700401/1017004010120"
  },
  {
    "id": 1017004010130,
    "speaker": "あさひ",
    "text": "『どんな小さなことでも構いません』",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010130"
  },
  {
    "id": 1017004010140,
    "speaker": "あさひ",
    "text": "……考えてたら、寝ちゃったっす",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ\r\nそうだったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっと、そのアンケートって、\r\nティーン向け雑誌のだったよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あさひの等身大の話を聞きたいと思うんだ\r\nそんなに難しく考えなくていいんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010150,
    "speaker": "あさひ",
    "text": "うーん……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "朝はヨーグルトを食べるようにしたとか\r\n通学カバンをリュックに変えたとか……",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010160,
    "speaker": "あさひ",
    "text": "そんなの聞いてどうするっすか？",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうもしないけど\r\nそういうの聞くと嬉しいものなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010170,
    "speaker": "あさひ",
    "text": "ふーん……？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "すぐ思いつかないなら、今は飛ばして\r\n他のものから答えればいいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010180,
    "speaker": "あさひ",
    "text": "そっすね\r\nそうするっす",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
