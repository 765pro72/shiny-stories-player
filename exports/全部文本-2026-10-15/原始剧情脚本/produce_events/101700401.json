  },
  {
    "id": 1017004010100,
    "speaker": "あさひ",
    "text": "……まだ出かけないんすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。ちょっと返事をしておきたいのがあって……\r\nもう少しだけ待っててほしいんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010110,
    "speaker": "あさひ",
    "text": "わかったっす\r\nアンケートの続きやってるっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700401/1017004010110"
