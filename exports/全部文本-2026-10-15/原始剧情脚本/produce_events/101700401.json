  {
    "speaker": "プロデューサー",
    "text": "疲れてるなら、まだ寝てていいぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004010080,
    "speaker": "あさひ",
    "text": "────なんだ、\r\nプロデューサーさんだったっすか……",
    "charAnim1": "think1",
