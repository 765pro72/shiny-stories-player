[
  {
    "textFrame": "off",
    "bg": "00523",
    "bgm": "0085"
  },
  {
    "speaker": "プロデューサー",
    "text": "（水中撮影が、こんなに大変だとはな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（重りを巻きつけながら、\r\nそんなものはありませんって顔をしなきゃいけないし……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（水中眼鏡するわけにはいかないから、何も見えない\r\n指示されたポーズを取るのも一苦労……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（なのに俺は、モニターの前で見てるだけ……\r\nもどかしいな……！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0255",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2016013040010,
    "speaker": "千雪",
    "text": "……はぁっ、…………ふ、…………っ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040010"
  },
  {
    "textFrame": "off"
  },
  {
    "speaker": "プロデューサー",
    "text": "（なんとかついていけてるけど……\r\nでも千雪、苦しかっただろう……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あ……水中でアシストしてくれるダイバーさんも\r\n心配そうな顔で上がってきた）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……万一の事があったら、後悔してもしきれない）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（もう少し安全に気を遣った撮影にしてもらえないか、\r\n頼んでみるか……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0403",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2016013040020,
    "speaker": "千雪",
    "text": "…………っ、くしゅん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040020"
  },
  {
    "speaker": "監督",
    "text": "桑山ちゃん、大丈夫？\r\n６月だからなァ……水、まだ冷たいでしょう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2016013040030,
    "speaker": "千雪",
    "text": "ご心配かけてすみません……\r\n大丈夫です",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040160030",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/201601304/2016013040030"
  },
  {
    "id": 2016013040040,
    "speaker": "千雪",
    "text": "休憩も多めに取っていただいてますし\r\nヒーターも設置していただいてますから……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040040"
  },
  {
    "id": 2016013040050,
    "speaker": "千雪",
    "text": "それより、ちゃんと世界観を表現できているのかって\r\nそっちの方が心配で……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040050"
  },
  {
    "speaker": "監督",
    "text": "そこはいい感じよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "監督",
    "text": "桑山ちゃん、味のあるいい表情してくれるしさ、\r\n表現にグッと深みが出たよねェ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2016013040060,
    "speaker": "千雪",
    "text": "わ……！　恐縮です……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040060"
  },
  {
    "id": 2016013040070,
    "speaker": "千雪",
    "text": "……その、足りないところは\r\nもっともっと言っていただけると嬉しいので……！",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040070"
  },
  {
    "speaker": "監督",
    "text": "うん、こちらこそありがとね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "監督",
    "text": "桑山ちゃん、ボクの予想より全然動けるから、\r\n色々、やれることは増えてるよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2016013040080,
    "speaker": "千雪",
    "text": "……よかった",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040080"
  },
  {
    "id": 2016013040090,
