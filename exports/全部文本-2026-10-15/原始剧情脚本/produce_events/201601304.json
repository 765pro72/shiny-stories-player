    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601304/2016013040160"
  },
  {
    "id": 2016013040170,
    "speaker": "千雪",
    "text": "それがすごく感動的で、\r\n希望のように感じられるというか",
