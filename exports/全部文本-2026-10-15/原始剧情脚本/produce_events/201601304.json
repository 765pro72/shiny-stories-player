  },
  {
    "id": 2016013040160,
    "speaker": "千雪",
    "text": "地上だと当たり前のことに感じますけど、\r\n目の前が見えにくい水中だと、なんていうか────",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
