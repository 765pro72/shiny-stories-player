      "time": 100
    },
    "voice": "produce_events/201601304/2016013040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ならいいんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "スタッフ",
    "text": "ドレスのコンディション、撮り直すたびに悪くなりますから\r\n一発で、最高のテイクを撮りましょう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2016013040110,
    "speaker": "千雪",
    "text": "はい！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
