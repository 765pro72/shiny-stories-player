    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100901/2001009010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……秋は美味しいものが多いから、\r\n食べ過ぎないように自制もしないとって思ってな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009010210,
    "speaker": "真乃",
    "text": "ほわ…………",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100901/2001009010210"
  },
  {
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……い、いや、すまん──\r\n真乃は心配しなくても大丈夫だと思うぞ……！",
    "charAnim4": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "レッスンでしっかり体を動かしてるんだし──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009010220,
    "speaker": "真乃",
    "text": "で、でも、お仕事に支障があったらいけないですし\r\nやっぱり、普段から心掛けた方がいいですよね……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100901/2001009010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "えーと……──真乃は、今からダンスレッスンだよな？\r\nそれを頑張るためのご褒美だと思ってもいいんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、ある程度お腹に入れておいた方が\r\nレッスンにも集中できるだろうし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009010230,
    "speaker": "真乃",
    "text": "……確かに、それもそうです……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100901/2001009010230"
  },
  {
    "id": 2001009010231,
    "speaker": "真乃",
    "text": "ありがとうございます、プロデューサーさんっ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
