    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 1002001040020,
    "speaker": "灯織",
    "text": "ありがとうございます、プロデューサー",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040020"
  },
  {
    "id": 1002001040030,
    "speaker": "灯織",
    "text": "自分でも調子はいいと思うのですが……\r\n念のため、もう少しやっておきます",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040030"
  },
  {
    "id": 1002001040040,
    "speaker": "灯織",
    "text": "明日のオーディションは\r\n絶対に合格したいから……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……\r\nだが、気負いすぎるなよ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040050,
    "speaker": "灯織",
    "text": "はい。でも、プロデューサーが私のために\r\n見つけてくれたものだから、その期待に応えたいんです",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織……",
    "charLabel": "hiori",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "ならトコトンやるか！",
    "nextLabel": "1"
  },
  {
    "select": "頼もしくなったな",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "だからと言って、\r\n無茶はダメだ",
    "nextLabel": "3"
  },
  {
    "id": 1002001040060,
    "label": "1",
    "speaker": "灯織",
    "text": "……いえ、必要な分だけにとどめておきます",
    "charAnim1": "surp2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040060"
  },
  {
    "id": 1002001040070,
    "speaker": "灯織",
    "text": "プロデューサーの言うとおり、オーディション前に\r\n体力を使い切ったら本末転倒ですから",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ……\r\nすまんな、休めといったのに矛盾していたな……",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040080,
    "speaker": "灯織",
    "text": "ふふ。プロデューサーなりの気づかいだってこと\r\nちゃんと伝わってますから、安心してください",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……なら、よかった\r\n灯織が満足できるまで残りも頑張ろう",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040090,
    "speaker": "灯織",
    "text": "はい……！",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040090"
  },
  {
    "effectLabel": "black2",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "effectLabel": "black2",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "id": 1002001040100,
    "speaker": "灯織",
    "text": "――ふう\r\n今日はここまでにします",
    "charAnim1": "smile3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "お疲れ様、灯織\r\n満足のいく出来になったか？",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040110,
    "speaker": "灯織",
    "text": "……いいえ",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040110"
  },
  {
    "id": 1002001040120,
    "speaker": "灯織",
    "text": "でも、キリがないし、明日のことを考えるのなら\r\nここまでにしておかないと",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "（どうやら、少しはメンタルをコントロールできるように\r\nなったらしいな……）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040130,
    "speaker": "灯織",
    "text": "……プロデューサー\r\n私、成長できているんでしょうか？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040130"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうしたんだ？　急に",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040140,
    "speaker": "灯織",
    "text": "いえ……どんなにレッスンを重ねても\r\n理想の自分に近づけている気がしなくて……",
    "charAnim1": "anger1",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……灯織は、間違いなく成長していると思う\r\n初めて会った時と比べると、見違えるほどだ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040150,
    "speaker": "灯織",
    "text": "そうでしょうか……\r\n自分ではあまり実感できません……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040150"
  },
  {
    "id": 1002001040160,
    "speaker": "灯織",
    "text": "でも、明日のオーディションに合格することができたら\r\nきっと……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "（明日は灯織の正念場でもある、か……）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040170,
    "speaker": "灯織",
    "text": "プロデューサー。もしも……\r\nもしも、明日のオーディションに――",
    "charAnim1": "sad3",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "たとえどんな結果になろうとも、灯織は灯織だ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040180,
    "speaker": "灯織",
    "text": "！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040180"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、先の見えない不安を心配するよりも\r\n今日まで積み重ねてきた、灯織の実力を信じてやれ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は信じているぞ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040190,
    "speaker": "灯織",
    "text": "……ありがとうございます、プロデューサー",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040190"
  },
  {
    "id": 1002001040200,
    "speaker": "灯織",
    "text": "明日のオーディション、私の全てを出し切ります",
    "charAnim1": "sad3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/100200104/1002001040200"
  },
  {
    "id": 1002001040210,
    "label": "2",
    "speaker": "灯織",
    "text": "頼もしく、ですか……？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、前までの灯織はどこか余裕がないように見えたけど\r\n今は、そうじゃないように見える",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040220,
    "speaker": "灯織",
    "text": "……そうでしょうか？",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040220"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織……？",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "灯織",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1002001040230,
    "speaker": "灯織",
    "text": "今でも、余裕なんて全然ないです",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040230"
  },
  {
    "id": 1002001040240,
    "speaker": "灯織",
    "text": "レッスンをこなせばこなすほど\r\n自分と理想の違いを思い知らされて……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040240"
  },
  {
    "id": 1002001040250,
    "speaker": "灯織",
    "text": "プロデューサー\r\n私、本当に変われていますか……？",
    "charAnim1": "sad3",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040250"
  },
  {
    "speaker": "プロデューサー",
    "text": "……俺は、\r\n人一倍灯織のことを見てきた",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんな俺が言うんだから間違いない\r\n灯織は、成長した。絶対にだ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040260,
    "speaker": "灯織",
    "text": "プロデューサー……はい、ありがとうございます",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040260"
  },
  {
    "id": 1002001040270,
    "speaker": "灯織",
    "text": "まだ不安な気持ちもありますけど\r\n少しは、自分に自信を持てた気がします",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040270"
  },
  {
    "speaker": "プロデューサー",
    "text": "アイドルを続けていけば\r\nいつか、灯織が自分のことを認められる日が来るよ",
    "charAnim2": "blank",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040280,
    "speaker": "灯織",
    "text": "……はい",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040280"
  },
  {
    "speaker": "プロデューサー",
    "text": "そのためにも、\r\nまずは明日のオーディション、頑張ろうな",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040290,
    "speaker": "灯織",
    "text": "はい……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040290"
  },
  {
    "id": 1002001040300,
    "speaker": "灯織",
    "text": "プロデューサー。最終確認をしたいので、\r\nもう少しだけ私に付き合ってくれますか？",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだ！",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1002001040310,
    "label": "3",
    "speaker": "灯織",
    "text": "心配しないでくださいプロデューサー",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040310"
  },
  {
    "id": 1002001040320,
    "speaker": "灯織",
    "text": "私はいつもどおり、本気でやろうとしているだけです",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だからこそ心配なんだ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040330,
    "speaker": "灯織",
    "text": "え……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040330"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織はいつだって本気だ。充分すぎるほど頑張っている\r\n……でも、頑張りすぎているようにも見えるんだ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつか、突然倒れたりするんじゃないかって\r\n心配してるんだぞ？",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040340,
    "speaker": "灯織",
    "text": "プロデューサー……すみません……",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200104/1002001040340"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、謝る必要はない。今の灯織があるのは\r\nその積み重ねてきたレッスンのおかげだからな",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "よくここまで頑張ったな\r\n今の灯織は立派なアイドルだ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001040350,
    "speaker": "灯織",
    "text": "……",
