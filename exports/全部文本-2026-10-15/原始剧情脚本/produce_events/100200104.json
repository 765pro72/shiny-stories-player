  {
    "speaker": "プロデューサー",
    "text": "灯織、練習熱心なのはいいことだけど、\r\n明日は本番なんだから、あまり無理をするな",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "charCategory": "stand_jersey",
    "charType": "characters",
