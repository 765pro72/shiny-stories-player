  {
    "id": 2001006020020,
    "speaker": "真乃",
    "text": "……ふふっ\r\n偶然ですね、プロデューサーさん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100602/2001006020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ\r\nやっぱり、真乃だよな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001006020030,
    "speaker": "真乃",
    "text": "はい、びっくりしましたか？",
