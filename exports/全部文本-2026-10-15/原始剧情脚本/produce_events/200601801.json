  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2006018010250,
    "speaker": "咲耶",
    "text": "フフ、そんなことを言っていいのかな？",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601801/2006018010250"
  },
  {
    "id": 2006018010260,
    "speaker": "咲耶",
    "text": "私がこのままワガママになり続けたら、\r\n傍若無人な人間になってしまうかもしれないよ？",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601801/2006018010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、そういうことなら心配してないよ\r\n咲耶がそんな人になるわけないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006018010270,
    "speaker": "咲耶",
    "text": "おや……どうやらアナタも、\r\n私を無条件に信じる癖に、拍車がかかっているようだ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
