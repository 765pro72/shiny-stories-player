  {
    "id": 2006018010220,
    "speaker": "咲耶",
    "text": "人にどう思われるかはわからなくても、\r\nやりたいと思うことが増えてきた気がする",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
