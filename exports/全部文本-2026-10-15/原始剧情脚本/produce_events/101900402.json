    "waitTime": 2500
  },
  {
    "speaker": "テレビの音声",
    "text": "『──っていう感じでしたっ！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "テレビの音声",
    "text": "『それはまた素晴らしいご経験でしたね』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019004020130,
    "speaker": "愛依",
    "text": "……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
