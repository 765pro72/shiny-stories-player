    }
  },
  {
    "speaker": "テレビの音声",
    "text": "『それでは次の質問ですが』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "テレビの音声",
    "text": "『アイドルとしての信念を教えてください』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019004020140,
    "speaker": "愛依",
    "text": "……！",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101900402/1019004020140"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLabel": "mei",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "テレビの音声",
    "text": "『そうですね、私でいうと──』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019004020150,
    "speaker": "愛依",
    "text": "──信念……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101900402/1019004020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　何か気になったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019004020160,
    "speaker": "愛依",
    "text": "この前教えてくれた自伝にさ\r\n信念、書いてあったんだよね～",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020160"
  },
  {
    "id": 1019004020170,
    "speaker": "愛依",
    "text": "でさ、ちょーかっこよかったの！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020170"
  },
  {
    "id": 1019004020180,
    "speaker": "愛依",
    "text": "だから考えてみたんだけど\r\nうちは出てこなかったんだよね～",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "きっと愛依にもあると思うよ\r\n言葉にできないだけで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019004020190,
    "speaker": "愛依",
    "text": "マジか～……",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020190",
    "autoWaitTime": 2000
  },
  {
    "id": 1019004020200,
    "speaker": "愛依",
    "text": "あ！　あれとか！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020200"
  },
  {
    "id": 1019004020201,
    "speaker": "愛依",
    "text": "冬優子ちゃんとあさひちゃんに負けたくない！",
    "charAnim1": "smile3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020201"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは信念じゃなくて目標かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019004020210,
    "speaker": "愛依",
    "text": "そうなん？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分が大切にしたいこと！\r\nとかで考えるとわかりやすいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019004020220,
    "speaker": "愛依",
    "text": "……\r\nほほ～……",
    "charAnim1": "smile3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900402/1019004020220"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "もし難しそうだったら言ってくれ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この質問、毎回聞かれるわけじゃないから\r\n無理そうだったら外してもらえるように頼んでおくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
