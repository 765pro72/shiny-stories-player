  {
    "id": 1013001050040,
    "speaker": "夏葉",
    "text": "っ！\r\nここで最後にこのポーズ……！",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
