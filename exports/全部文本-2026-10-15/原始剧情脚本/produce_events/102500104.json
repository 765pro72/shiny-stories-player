    "voice": "produce_events/102500104/1025001040061"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……\r\nなんで──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040070,
    "speaker": "美琴",
    "text": "顔に書いてあるよ\r\n『美琴に聞きたいことがあって来た』ってね",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……もし、美琴が話してくれるなら\r\n美琴のこれまでのことが知りたいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040080,
    "speaker": "美琴",
    "text": "…………\r\nこれまでって？　生まれたところから？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
