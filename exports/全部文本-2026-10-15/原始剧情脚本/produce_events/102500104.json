    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そこから聞いていいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040090,
    "speaker": "美琴",
    "text": "……嘘、冗談だったのに",
