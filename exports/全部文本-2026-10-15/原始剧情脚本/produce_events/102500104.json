    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040190"
  },
  {
    "id": 1025001040200,
    "speaker": "美琴",
    "text": "だけど結局なりたいアイドルには、なれなかったの\r\n……その時はね",
