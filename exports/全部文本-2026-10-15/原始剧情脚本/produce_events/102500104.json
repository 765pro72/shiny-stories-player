    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040100,
    "speaker": "美琴",
    "text": "──私はね、北海道で生まれて\r\n歌手になるために、14歳で上京してきたの",
    "charAnim1": "think1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040100"
  },
  {
    "id": 1025001040110,
    "speaker": "美琴",
    "text": "その時はまだ、歌手……っていうか\r\n歌いたいって気持ちでね",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040110"
  },
  {
    "id": 1025001040120,
    "speaker": "美琴",
    "text": "事務所で研究生としてレッスンを受けるうちに\r\n歌って踊りたいになって",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040130,
    "speaker": "美琴",
    "text": "先輩のステージを見たり、\r\n後ろで踊ったりするうちに、段々",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040130"
  },
  {
    "id": 1025001040140,
    "speaker": "美琴",
    "text": "自分のステージで誰かを感動させるような、\r\nそういう……アイドルになりたいって、思ったの",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "その頃からなんだな\r\n美琴が、アイドルを目指したのは",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040150,
    "speaker": "美琴",
    "text": "うん、自分の夢に気が付いてからは、\r\nとにかくデビューしようって、必死だった",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040150"
  },
  {
    "id": 1025001040160,
    "speaker": "美琴",
    "text": "上京してきて、こっちの学校に通ってたけど\r\n学生時代の思い出なんて全然なくて",
    "charAnim1": "sad2",
    "charAnim2": "face_anger1",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040160"
  },
  {
    "id": 1025001040170,
    "speaker": "美琴",
    "text": "記憶の中は、ほとんどレッスン室の背景なの\r\n……笑っちゃうけど",
    "charAnim1": "wait2",
    "charAnim2": "face_anger1",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001040180,
    "speaker": "美琴",
    "text": "何回もデビューのチャンスが来て、\r\nダメになって、その繰り返し",
    "charAnim1": "wait3",
    "charAnim2": "face_close3",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500104/1025001040180"
  },
  {
    "id": 1025001040190,
    "speaker": "美琴",
    "text": "だからルカとユニットでデビューして、\r\n自分たちの歌がCDになった時、夢みたいだった",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
