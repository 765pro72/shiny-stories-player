  {
    "id": 2001005110020,
    "speaker": "真乃",
    "text": "空気がとっても美味しいですっ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100511/2001005110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務所の近くに、こんなに気持ちの良い場所が\r\nあるなんて知らなかったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005110030,
    "speaker": "真乃",
    "text": "はい、私も全然知りませんでした\r\n木漏れ日がキラキラしてとっても綺麗ですっ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100511/2001005110030"
  },
  {
    "id": 2001005110040,
    "speaker": "真乃",
    "text": "プロデューサーさんのおかげで\r\n素敵な場所に出会えましたっ",
    "charAnim1": "sad1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100511/2001005110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは。そんなに喜んでもらえるとはな\r\nいつもと違う道も、たまには通ってみるもんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005110050,
    "speaker": "真乃",
    "text": "プロデューサーさん、\r\nせっかくですから少し一緒に歩きませんか？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100511/2001005110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、俺もそうしたいなって思ってたところだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
