    "speaker": "プロデューサー",
    "text": "ああ……！\r\nすまんな……気を遣わせて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110290,
    "speaker": "冬優子",
    "text": "いいのいいの、気にしないで",
    "charAnim1": "wait4",
