    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110170"
  },
  {
    "id": 2018006110180,
    "speaker": "冬優子",
    "text": "期限過ぎちゃうなんて嘘よ、う・そ\r\nふゆがそんなこと知るわけないでしょー",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……な、なんだ……そうか……\r\nよかった……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110190,
    "speaker": "冬優子",
    "text": "……まぁでも、ずっと下敷きにして寝てた書類は\r\n無事じゃないかもしれないけど",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
