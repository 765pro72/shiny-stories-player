    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2018006110210,
    "speaker": "冬優子",
    "text": "ずいぶん忙しそうねぇ？",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやっ、そんな──たいしたことじゃないんだ\r\nちょっと俺の要領が悪くて、色々重なっちゃってるだけで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110220,
    "speaker": "冬優子",
    "text": "え～……？",
    "charAnim1": "surp3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほんとにっ、冬優子に心配してもらうようなことじゃ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110230,
    "speaker": "冬優子",
    "text": "……ふゆのプロデューサーさんって、\r\nそんなにできない子さんだったんですか……？",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "うっ……！\r\nそっちか……！！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110240,
    "speaker": "冬優子",
    "text": "ふゆ、心配です……",
