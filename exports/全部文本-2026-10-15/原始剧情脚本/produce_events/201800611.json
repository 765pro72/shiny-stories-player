    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああっ……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110200,
    "speaker": "冬優子",
    "text": "ふふふっ……！",
