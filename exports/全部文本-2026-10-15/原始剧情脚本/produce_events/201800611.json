      "time": 100
    },
    "voice": "produce_events/201800611/2018006110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……！？\r\n冬優子……ドッキリ……？？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006110170,
    "speaker": "冬優子",
    "text": "あははっ、何その顔！\r\nしっかりしなさいよね",
