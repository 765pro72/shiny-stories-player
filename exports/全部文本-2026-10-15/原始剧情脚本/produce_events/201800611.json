    "text": "……でも、トーゼン？\r\nふゆの優しさは安くないから？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800611/2018006110300"
  },
  {
    "id": 2018006110310,
