  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "信重役の俳優",
    "text": "お疲れ様、お敬",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022011040040,
    "speaker": "小糸",
    "text": "あ…………",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202201104/2022011040040"
  },
  {
    "speaker": "信重役の俳優",
    "text": "はは、初めより慣れてきたかなって時にクランクアップ\r\nだもんなぁ……兄としては寂しいよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022011040050,
    "speaker": "小糸",
    "text": "……え、あ…………は、はい……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201104/2022011040050"
  },
  {
    "charAnim1": "wait",
    "charLabel": "koito",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "信重役の俳優",
    "text": "うん、いい笑顔だね\r\n改めて、お疲れ様────福丸さん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "信重役の俳優",
    "text": "兄としての俺はここでおしまいだけどさ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "信重役の俳優",
    "text": "これからはいちファンとして、アイドルの福丸さんを\r\nテレビの前から応援するよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "信重役の俳優",
    "text": "今回の役、お敬のことも糧に……\r\nこれからも頑張ってたくさん活躍してな！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022011040060,
    "speaker": "小糸",
    "text": "…………はい……！\r\nあ、あの、あ、ありがとう、ございました……！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
