    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090040"
  },
  {
    "id": 1004003090050,
    "speaker": "恋鐘",
    "text": "うちがオーディションしてもらったのもここやったし\r\n……ここは大切な場所ばい",
    "charAnim1": "shy1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだったな\r\nここで、初めて恋鐘に会ったんだよな",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003090060,
