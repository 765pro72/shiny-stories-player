  },
  {
    "id": 1004003090020,
    "speaker": "恋鐘",
    "text": "つい、ここに来てしまったとよ\r\n……もう終わってしまったとに",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "実はそうじゃないかと思って、\r\nここを覗いたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003090030,
    "speaker": "恋鐘",
    "text": "ふぇ……！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090030"
  },
  {
    "id": 1004003090040,
    "speaker": "恋鐘",
    "text": "プロデューサーはうちのこと、\r\nなんでもお見通しやね……！",
