    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090070"
  },
  {
    "id": 1004003090080,
    "speaker": "恋鐘",
    "text": "『あっという間にアイドルの１番になれる～』って\r\n思っとったとに、全然そがんことなかった",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090080"
  },
  {
    "id": 1004003090090,
    "speaker": "恋鐘",
    "text": "それどころか、オーディションも受からんで……\r\n『落ち込んでる暇があったら、練習練習』って",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400309/1004003090090"
  },
  {
    "id": 1004003090100,
    "speaker": "恋鐘",
    "text": "……きっとその時間のあったけん、\r\n今も頑張れとるとかなって思うとよ",
