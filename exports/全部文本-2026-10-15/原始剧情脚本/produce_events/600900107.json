    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900107/6902001070030"
  },
  {
    "id": 6902001070040,
    "speaker": "社長",
    "text": "さあ、早くその最高のアイドルに\r\n会いに行ってこい",
