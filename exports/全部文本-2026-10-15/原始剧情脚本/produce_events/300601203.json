  {
    "id": 3006012030070,
    "speaker": "咲耶",
    "text": "…………みんな、もう寝てしまったかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030070"
  },
  {
    "id": 3006012030080,
    "speaker": "摩美々",
    "text": "寝たぁ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030080"
  },
  {
    "id": 3006012030090,
    "speaker": "結華",
    "text": "いやいやそれは寝てない人の速度！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030090"
  },
  {
    "id": 3006012030100,
    "speaker": "恋鐘",
    "text": "んふふ～\r\nそいば言うなら結華もた～い！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030100"
  },
  {
    "id": 3006012030110,
    "speaker": "霧子",
    "text": "ふふっ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030110"
  },
  {
    "id": 3006012030120,
    "speaker": "結華",
    "text": "うっ、だって今のはツッコミの性だし……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030120"
  },
  {
    "id": 3006012030130,
    "speaker": "摩美々",
    "text": "ってことで、全員寝てないー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030130"
  },
  {
    "id": 3006012030140,
    "speaker": "咲耶",
    "text": "フフ、そうか……！　安心したよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030140"
  },
  {
    "id": 3006012030150,
    "speaker": "咲耶",
    "text": "今日という日に心躍ってばかりで\r\n寝つける気がしないものだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030150"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3006012030160,
    "speaker": "霧子",
    "text": "旅行の……\r\n夜だから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030160"
  },
  {
    "id": 3006012030170,
    "speaker": "霧子",
    "text": "もったいなくて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030170"
  },
  {
    "id": 3006012030171,
    "speaker": "恋鐘＆結華",
    "text": "わかる～～～～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030171"
  },
  {
    "id": 3006012030180,
    "speaker": "結華",
    "text": "旅行の醍醐味って夜だもんね！\r\nおしゃべり、トランプ、深夜の間食……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030180"
  },
  {
    "id": 3006012030190,
    "speaker": "恋鐘",
    "text": "か、間食…………！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030190"
  },
  {
    "id": 3006012030200,
    "speaker": "恋鐘",
    "text": "うちもまだまだしゃべり足らんし、\r\nトランプもやりたかったとよ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601203/3006012030200"
  },
  {
    "id": 3006012030210,
