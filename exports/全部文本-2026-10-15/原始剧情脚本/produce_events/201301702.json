    "autoWaitTime": 800
  },
  {
    "speaker": "音楽番組の司会",
    "text": "じゃあせっかくだし\r\n視聴者のみんなにメッセージ、いっちゃってよ",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1556"
  },
  {
    "speaker": "音楽番組の司会",
    "text": "卒業に向けて、伝えたいことがあれば！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2013017020120,
    "speaker": "夏葉",
    "text": "ありがとうございます",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020120",
    "autoWaitTime": 2000
  },
  {
    "id": 2013017020130,
    "speaker": "夏葉",
    "text": "──",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020130",
    "autoWaitTime": 1800
  },
  {
    "id": 2013017020140,
    "speaker": "夏葉",
    "text": "まずはコメントの機会をいただけたことに感謝を",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020140"
  },
  {
    "id": 2013017020150,
    "speaker": "夏葉",
    "text": "これからお話しすることは……\r\nもうどこかで聞かれている方もいらっしゃるかもしれません",
    "charAnim1": "sad2",
    "charAnim2": "face_sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020150"
  },
  {
    "id": 2013017020160,
    "speaker": "夏葉",
    "text": "私の気持ちは変わりませんから……\r\n同じことを言っているでしょう",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020160"
  },
  {
    "id": 2013017020170,
    "speaker": "夏葉",
    "text": "でも、何度だって伝えさせてください",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020170"
  },
  {
    "id": 2013017020180,
    "speaker": "夏葉",
    "text": "応援してくださるみなさんにとっても、私にとっても\r\n悔いのない最後になるよう努めます",
    "charAnim1": "wink",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020180"
  },
  {
    "id": 2013017020190,
    "speaker": "夏葉",
    "text": "やれること、やりたいこと、やるべきこと\r\n──全部やるわ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020190"
  },
  {
    "id": 2013017020200,
    "speaker": "夏葉",
    "text": "だから見ていてください、最後まで",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020200"
  },
  {
