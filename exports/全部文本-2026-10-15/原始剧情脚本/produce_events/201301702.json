  {
    "speaker": "SNSの投稿",
    "text": "『推し、なんで辞めてしまうの……\r\n永遠に放クラでいてよ……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1806",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "SNSの投稿",
    "text": "『夏葉の人生だし好きに生きる権利がある\r\n全力で応援するよ！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1806",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "speaker": "SNSの投稿",
    "text": "『悲しいけど、推しが決めたことだと思ったら\r\n何も言えない。だからこそつらい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1806",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "SNSの投稿",
    "text": "『覚悟はしてた……！　一番最初だろうなって……！\r\nだから笑って送り出すって前から決めてたんだ俺は……！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "1806",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "SNSの投稿",
    "text": "『私に夏葉を推させた責任、取ってくれるといいな』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2013017020010,
    "speaker": "夏葉",
    "text": "──────……",
