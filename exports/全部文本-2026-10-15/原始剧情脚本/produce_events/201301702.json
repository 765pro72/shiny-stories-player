    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 2013017020030,
    "speaker": "夏葉",
    "text": "心配させてしまったのかしら\r\n……大丈夫よ、カトレア",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020030"
  },
  {
    "textFrame": "off",
    "se": "2472",
