  },
  {
    "id": 2013017020020,
    "speaker": "夏葉",
    "text": "あら……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301702/2013017020020"
  },
  {
    "textFrame": "off",
