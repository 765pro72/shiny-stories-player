    },
    "bg": "00002",
    "bgm": "000"
  },
  {
    "id": 7002001050010,
    "speaker": "灯織",
    "text": "……そう、ですか",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050010"
  },
  {
    "id": 7002001050020,
    "speaker": "灯織",
    "text": "まだ最終審査が残っていますが……\r\n少し、安心しました",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050020"
  },
  {
    "speaker": "プロデューサー",
    "text": "喜んでるのは俺たちだけじゃないぞ",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、ツイスタを見てみてくれ\r\nファンもすごく喜んでるぞ！",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7002001050030,
    "speaker": "灯織",
    "text": "……わぁ",
    "charAnim1": "surp1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050030"
  },
  {
    "id": 7002001050040,
    "speaker": "灯織",
    "text": "すごい……結果が発表されたばかりなのに、\r\nこんなに書き込みが……",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050040"
  },
  {
    "id": 7002001050050,
    "speaker": "灯織",
    "text": "こんなにたくさんのファンが、\r\n私のことを応援してくれているんですね",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだ、すごいだろ？",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7002001050060,
    "speaker": "灯織",
    "text": "……なぜプロデューサーが自慢げなんですか",
    "charAnim1": "anger2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050060"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、いや、つい嬉しくてな……",
    "charAnim1": "wait1",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7002001050070,
    "speaker": "灯織",
    "text": "……でも、そうですね",
    "charAnim1": "yes",
    "charLipAnim": "lip_wait",
    "charAnim1Loop": false,
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050070"
  },
  {
    "id": 7002001050080,
    "speaker": "灯織",
    "text": "こんなにたくさんの人が\r\n応援してくれているんですから……",
    "charAnim1": "wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050080"
  },
  {
    "id": 7002001050090,
    "speaker": "灯織",
    "text": "『W.I.N.G.』にかならず出場できるよう、\r\n頑張らないといけませんね",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050090"
  },
  {
    "id": 7002001050100,
    "speaker": "灯織",
    "text": "ファンの期待に……応えたいです",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ。一緒に頑張っていこう！",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7002001050110,
    "speaker": "灯織",
    "text": "はい。よろしくお願いします",
    "charAnim1": "yes",
    "charLipAnim": "lip_wait",
    "charAnim1Loop": false,
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050110"
  },
  {
    "id": 7002001050120,
    "speaker": "灯織",
    "text": "……それじゃ私、行ってきます",
    "charAnim1": "no",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charAnim1Loop": false,
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050120"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？　どこに行くんだ？",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7002001050130,
    "speaker": "灯織",
    "text": "もちろん、スタジオに練習に行くんです",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050130"
  },
  {
    "id": 7002001050140,
    "speaker": "灯織",
    "text": "少しでも、時間は無駄にしたくありませんから",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700200105/7002001050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "（結局レッスンか……灯織らしいな）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（しかし俺も……\r\n灯織に負けないよう、頑張らないとな！）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
