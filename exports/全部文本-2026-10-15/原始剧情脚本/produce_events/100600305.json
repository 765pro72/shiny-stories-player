    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050330"
  },
  {
    "id": 1006003050340,
    "speaker": "咲耶",
    "text": "私の、自己満足にすぎないんだ",
    "charAnim1": "wait5",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050340"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………………………\r\n………………………………………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003050350,
    "speaker": "咲耶",
    "text": "すまないね、\r\nそんなものに付き合わせてしまって",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050350"
  },
