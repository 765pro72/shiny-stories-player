    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050291"
  },
  {
    "id": 1006003050300,
    "speaker": "咲耶",
    "text": "…………これは綺麗事だよ",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050300"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003050310,
    "speaker": "咲耶",
    "text": "私にとって最良でも、これが正解ではないとはわかっている\r\nあの子が求めた形が、これでないことも理解している",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050310"
  },
  {
    "id": 1006003050320,
    "speaker": "咲耶",
    "text": "そもそも、こんなやり方がいつまでも続けられるわけがない\r\n──そう、わかっているよ",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600305/1006003050320"
  },
  {
    "id": 1006003050330,
    "speaker": "咲耶",
    "text": "だからこれは、\r\n誰のためでもなくて──……",
