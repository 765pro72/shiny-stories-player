    "waitTime": 2700
  },
  {
    "id": 1006003050140,
    "speaker": "咲耶",
    "text": "……戻ることは、できないんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "062",
    "voice": "produce_events/100600305/1006003050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00129",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2700
  },
  {
    "id": 1006003050150,
    "speaker": "咲耶",
    "text": "………………\r\n私はもう、あの頃の私に戻れない",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100600305/1006003050150"
  },
  {
    "id": 1006003050160,
    "speaker": "咲耶",
    "text": "私はアイドルを、アンティーカを、アナタを、\r\n知ってしまったから",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
