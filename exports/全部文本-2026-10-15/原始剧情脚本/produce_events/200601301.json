  {
    "speaker": "プロデューサー",
    "text": "昨日はよく眠れたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010090,
    "speaker": "咲耶",
    "text": "もちろん",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010090"
  },
  {
    "id": 2006013010100,
    "speaker": "咲耶",
    "text": "この時間に起きなくてはならなかったからね\r\nいつもより早くベッドに入ってぐっすりさ",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、さすが",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも着くまでしばらくかかるから\r\n眠くなったら気にせず休んでくれよ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010110,
    "speaker": "咲耶",
    "text": "フフ、お気遣いありがとう",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010110",
    "autoWaitTime": 4400
  },
  {
    "id": 2006013010120,
    "speaker": "咲耶",
    "text": "──……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010120",
    "autoWaitTime": 2000
  },
  {
    "id": 2006013010130,
    "speaker": "咲耶",
    "text": "アナタの方はどう？\r\nあまり時間のない朝だったのかな",
    "charAnim1": "wait3",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？\r\n──あはは、気付かれちゃったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_sad",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0289",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "いつもより早く寝るの、俺は失敗しちゃって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "見てのとおり、コンビニで買っただけで\r\n朝ご飯がお預けになってるんだ、はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010140,
    "speaker": "咲耶",
    "text": "言ってくれたらよかったのに",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601301/2006013010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや\r\n咲耶を待たせて食べる朝ご飯なんか存在しないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010150,
    "speaker": "咲耶",
    "text": "咲耶を心配させる朝ご飯は存在していいのかい？",
    "charAnim1": "wait3",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うっ……\r\n痛いところを突いてくるな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010160,
    "speaker": "咲耶",
    "text": "フフフッ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010160"
  },
  {
    "id": 2006013010170,
    "speaker": "咲耶",
    "text": "食事は疎かにしてはいけない\r\n一日を過ごすための活力に繋がるのだから",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010170"
  },
  {
    "id": 2006013010180,
    "speaker": "咲耶",
    "text": "今回は大丈夫そうだけれど──\r\n抜くようなことがあっては大変だ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\n肝に銘じておくよ",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "咲耶は\r\nお腹空いてないか？",
    "nextLabel": "1"
  },
  {
    "select": "隙を見て……",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
