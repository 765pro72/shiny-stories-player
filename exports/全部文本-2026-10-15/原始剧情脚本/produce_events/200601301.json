    "nextLabel": "3"
  },
  {
    "id": 2006013010190,
    "label": "1",
    "speaker": "咲耶",
    "text": "ああ\r\n朝食もしっかりとってきたからね",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお……！\r\nちなみにメニューは？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010200,
    "speaker": "咲耶",
    "text": "目玉焼きとベーコンと、サラダと──……",
    "charAnim1": "think",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010200"
  },
  {
    "id": 2006013010210,
    "speaker": "咲耶",
    "text": "……まぁ、簡単なものばかりだよ",
    "charAnim1": "wink",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "嘘だろ……？\r\nそんなにちゃんとしてるのに簡単なものって言うのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010220,
    "speaker": "咲耶",
    "text": "え……？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601301/2006013010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "バランスが考えられた食事なんて\r\n買わなきゃ出てこない……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013010230,
    "speaker": "咲耶",
    "text": "……フフッ、もう\r\nアナタは普段どんな食生活をしているの？",
