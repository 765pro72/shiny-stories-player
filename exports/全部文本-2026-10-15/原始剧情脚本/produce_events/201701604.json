      "time": 100
    },
    "voice": "produce_events/201701604/2017016040040"
  },
  {
    "speaker": "トレーナー",
    "text": "えっ、あさひちゃん、まだ上手くなるつもり……？\r\nいいね、その貪欲さ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
