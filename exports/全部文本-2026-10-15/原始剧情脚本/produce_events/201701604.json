    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "speaker": "トレーナー",
    "text": "そんなに焦らなくていいと思うけどね\r\nまだまだ人生、先は長いんだし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2017016040050,
