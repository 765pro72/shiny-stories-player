  {
    "id": 2017016040040,
    "speaker": "あさひ",
    "text": "先生、わたし、もっと上手くなるには\r\nどうしたらいっすかね？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
