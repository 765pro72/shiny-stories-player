    "waitTime": 1500,
    "bgEffectTime": 800
  },
  {
    "id": 1016005010110,
    "speaker": "千雪",
    "text": "（ふふっ……\r\n嬉しいな）",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600501/1016005010110"
  },
  {
    "id": 1016005010120,
    "speaker": "千雪",
    "text": "（ひとつひとつ、やれることが増えていって……\r\n少しずつ、素敵なものを広げられていくの……）",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010120"
  },
  {
    "id": 1016005010130,
    "speaker": "千雪",
    "text": "（ハリネズミくん、お客さんにも評判よかったし……\r\nもう一匹作ろうかな……？）",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
