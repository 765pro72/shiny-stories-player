  {
    "id": 1016005010080,
    "speaker": "千雪",
    "text": "はあ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010080"
  },
  {
    "id": 1016005010090,
    "speaker": "千雪",
    "text": "（出展する企業さん、だいたい全部さらったかな？）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010090"
  },
  {
    "id": 1016005010100,
    "speaker": "千雪",
    "text": "（……回る順番も決めたし\r\n少し、ゆっくりしてもいいぞ、千雪）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010100"
  },
  {
    "textFrame": "off",
    "bg": "00627",
