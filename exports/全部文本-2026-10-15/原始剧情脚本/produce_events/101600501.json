  },
  {
    "id": 1016005010150,
    "speaker": "千雪",
    "text": "……もしもし\r\nお母さん、どうかした？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600501/1016005010150"
  },
  {
    "charAnim1": "wait",
    "charAnim4": "blank",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00425",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1016005010160,
    "speaker": "千雪",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010160"
  },
  {
    "id": 1016005010170,
    "speaker": "千雪",
    "text": "ごめんなさい、\r\nお店から帰って、バイブ解除しておくの忘れちゃってて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010170"
  },
  {
    "speaker": "千雪の母",
    "text": "そう、それならよかった\r\n最近は順調？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005010180,
    "speaker": "千雪",
    "text": "うん\r\n今度ね、仕入れを少しだけ任されたりして──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010180"
  },
  {
    "textFrame": "off",
    "fg": "002922",
    "fgEffect": "fade",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 800,
    "fgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 1016005010190,
    "speaker": "小さな声",
    "text": "『そうなのね\r\n将来は、やっぱりそちらの道で考えているの？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010190"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010200,
    "speaker": "千雪",
    "text": "それは──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010200"
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010210,
    "speaker": "千雪",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010210"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1016005010220,
    "speaker": "千雪",
    "text": "今は、いろいろ勉強させてもらってるところ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010220"
  },
  {
    "id": 1016005010230,
    "speaker": "千雪",
    "text": "素敵だと思うものを作ったり、仕入れたりして\r\nお客様が喜んでくれるのは嬉しいよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010230"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010240,
    "speaker": "小さな声",
    "text": "『そう……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010240"
  },
  {
    "id": 1016005010250,
    "speaker": "小さな声",
    "text": "『でも、だんだんわかってきたなら……』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "057b",
    "voice": "produce_events/101600501/1016005010250"
  },
  {
    "id": 1016005010260,
    "speaker": "小さな声",
    "text": "『憧れだけじゃすまない、\r\n大変なところも見えてきているわよね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010260"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010270,
    "speaker": "千雪",
    "text": "それは…………\r\nそう、なんだけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010270"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010280,
    "speaker": "小さな声",
    "text": "『お母さんは、千雪とは違う生き方をしていたから\r\nわからないこともあるでしょう』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010280"
  },
  {
    "id": 1016005010290,
    "speaker": "小さな声",
    "text": "『でも、どんな生き方を選ぶにせよ……\r\nちゃんとした大人として──……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010290"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005010300,
    "speaker": "千雪",
    "text": "…………うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010300"
  },
