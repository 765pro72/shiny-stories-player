    "voice": "produce_events/101600501/1016005010010"
  },
  {
    "speaker": "雑貨店店主",
    "text": "来週、文房具の展示会あるでしょう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "僕、\r\n用事ができて行けなくなっちゃってね……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "今回は千雪さんにお任せしたいなって思うんだけど、\r\nどうかな？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 1016005010020,
    "speaker": "千雪",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010020"
  },
  {
    "id": 1016005010030,
    "speaker": "千雪",
    "text": "前に一度、ご一緒した展示会ですよね\r\n私で大丈夫でしょうか……？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010030"
  },
  {
    "speaker": "雑貨店店主",
    "text": "うん。新しい仕入れ先候補と、\r\nゼロからお話をしてもらうことになるから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "ちょっと難しいかもしれないんだけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "千雪さんもだいぶ慣れてきたみたいだからね\r\nひとつ上の仕事、お願いできたら嬉しい",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005010040,
    "speaker": "千雪",
    "text": "はい……！\r\n頑張ります、ちゃんと下調べもしていかないとですね",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010040"
  },
  {
    "speaker": "雑貨店店主",
    "text": "うん、いい意気",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "ふふっ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1016005010050,
    "speaker": "千雪",
    "text": "店長……？",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010050"
  },
  {
    "speaker": "雑貨店店主",
    "text": "ちょっとね、楽しみなんだよ\r\nどんなの選んで、仕入れてきてくれるのか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "この間、ハリネズミの\r\nぬいぐるみを作ってきてくれたでしょう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "千雪さんのああいうセンス、僕も好きだからね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005010060,
    "speaker": "千雪",
    "text": "わあ……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010060"
  },
  {
    "id": 1016005010070,
    "speaker": "千雪",
    "text": "えっと、あの……とっても嬉しいです\r\n頑張りますね！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600501/1016005010070"
  },
  {
    "speaker": "雑貨店店主",
    "text": "うん\r\n期待してます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
