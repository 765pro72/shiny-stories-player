  },
  {
    "id": 1016005010010,
    "speaker": "千雪",
    "text": "はい……？\r\nなんでしょうか",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
