  {
    "speaker": "プロデューサー",
    "text": "──……ここで樹里をスカウトしたんだったよなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011002010010,
    "speaker": "樹里",
    "text": "え、なんだよ急に……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
