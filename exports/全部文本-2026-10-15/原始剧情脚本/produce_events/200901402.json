    "waitType": "time",
    "waitTime": 4500
  },
  {
    "id": 2009014020050,
    "speaker": "果穂",
    "text": "なんの鳥なんでしょうか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……ウミネコとかかなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020060,
    "speaker": "果穂",
    "text": "プロデューサーさん、わかるんですか！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっとだけな、自信はあんまりないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
