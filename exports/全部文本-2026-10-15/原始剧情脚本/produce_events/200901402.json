  {
    "id": 2009014020070,
    "speaker": "果穂",
    "text": "あっ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020070"
  },
  {
    "id": 2009014020080,
    "speaker": "果穂",
    "text": "あたし、これはわかります！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、じゃあ果穂\r\n答えをどうぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020090,
    "speaker": "果穂",
    "text": "ウグイスです！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "大当たりだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020100,
    "speaker": "果穂",
    "text": "えへへっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "こっちのほうにいるの珍しいな\r\n近所の家の木にでも止まってるのかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020110,
    "speaker": "果穂",
    "text": "じゃあ、ウグイスは見つからないですね────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020110"
  },
  {
    "textFrame": "off",
    "se": "1396",
    "waitType": "time",
    "waitTime": 4800
  },
  {
    "id": 2009014020120,
    "speaker": "果穂",
    "text": "なんか……他にもたくさん鳥がいます！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020120"
  },
  {
    "id": 2009014020130,
    "speaker": "果穂",
    "text": "なんていう鳥なのか\r\n全然わかんないけど……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだなぁ……\r\n俺も今のは全然だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "1396",
    "waitType": "time",
    "waitTime": 4500
  },
  {
    "id": 2009014020140,
    "speaker": "果穂",
    "text": "なんて言ってるんだろ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "あったかくなってきたね\r\nとかかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020150,
    "speaker": "果穂",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020150"
  },
  {
    "id": 2009014020160,
    "speaker": "果穂",
    "text": "遊びに行こう！　って\r\n言ってる子もいるかもしれません！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020160"
  },
  {
    "id": 2009014020170,
    "speaker": "果穂",
    "text": "あったかくなってきたから……っ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "過ごしやすくなってきたもんなぁ\r\n外に飛び出したくなるような────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0132",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 2009014020180,
    "speaker": "果穂",
    "text": "！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020180"
  },
  {
    "textFrame": "off",
    "se": "0327",
    "waitType": "time",
    "waitTime": 900
  },
  {
    "speaker": "監督",
    "text": "撮っちゃった～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "か、監督……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "監督",
    "text": "いや～いい画だったからつい",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00578",
    "bgEffect": "fade",
    "bgEffectTime": 1000,
    "se": "0116",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "すみません、ちょっとはしゃいでしまって",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "idols",
    "charId": "1040090070",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "監督",
    "text": "いいのいいの\r\n休憩時間なんだから、何するも自由よ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "監督",
    "text": "いいショットも撮れたしね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009014020190,
    "speaker": "果穂",
    "text": "……？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020190"
  },
  {
    "speaker": "監督",
    "text": "果穂ちゃんさ、カメラ回す時も今みたいにしててよ\r\nその感じで煽りのカット追加するから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009014020200,
    "speaker": "果穂",
    "text": "今みたい……？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020200"
  },
  {
    "speaker": "監督",
    "text": "そ。プロデューサーさんと話してる時の感じ\r\nコレ、ファミリー向けの車だから、そういうのがいいの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009014020210,
    "speaker": "果穂",
    "text": "そういうの……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020210"
  },
  {
    "speaker": "監督",
    "text": "ありゃ、無自覚？\r\nまだわかんないかな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009014020220,
    "speaker": "果穂",
    "text": "えっと、お父さん役の人とお芝居する時、\r\nプロデューサーさんとお話するつもりでいればいい……",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020220"
  },
  {
    "id": 2009014020230,
    "speaker": "果穂",
    "text": "──んですか……？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901402/2009014020230"
  },
  {
    "speaker": "監督",
    "text": "そそ、ばっちり\r\nそれでよろしくね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
