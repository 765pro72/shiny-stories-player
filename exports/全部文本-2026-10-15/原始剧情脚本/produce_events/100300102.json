  {
    "id": 1003001020160,
    "speaker": "めぐる",
    "text": "ただいま、プロデューサー！\r\nわたしのダンス、どうだった！？",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300102/1003001020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "最高だったよ\r\nスタッフたちもみんな感心してたぞ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1003001020170,
    "speaker": "めぐる",
    "text": "ホント！？　よかったー！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300102/1003001020170"
  },
  {
    "id": 1003001020180,
    "speaker": "めぐる",
    "text": "わたしもこんなに思いっきり踊れたのはじめてかも\r\nまわりのみんなと一緒なんだって思えたからかな",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300102/1003001020180"
  },
  {
    "id": 1003001020190,
    "speaker": "めぐる",
    "text": "これもプロデューサーのアドバイスのおかげだね！\r\nありがとう、プロデューサー！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charAnim3Loop": false,
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300102/1003001020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "（めぐるはアドバイスを活かして一つ成長したみたいだ\r\n俺も負けていられないな！）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1003001020200,
    "label": "2",
    "speaker": "めぐる",
    "text": "……！　なるほど、気合いだね！\r\nわたし、なんだか燃えてきたよ！",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300102/1003001020200"
  },
  {
    "id": 1003001020210,
    "speaker": "めぐる",
