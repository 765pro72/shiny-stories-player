    "speaker": "めぐる",
    "text": "えっ……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_a",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
