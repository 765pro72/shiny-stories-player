[
  {
    "id": 1003001020010,
    "speaker": "めぐる",
    "text": "すっご～い！\r\n今日はこの舞台で踊れるんだね！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
