    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、それでこそめぐるだ！",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010090,
    "speaker": "めぐる",
    "text": "うんっ！　プロデューサー！\r\n今のわたしのランク、なんだっけ！？",
