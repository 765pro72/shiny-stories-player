    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるの努力は絶対に裏切らな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010170,
    "speaker": "めぐる",
    "text": "う、うしろ、スタッフさん……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "え！　あっ……",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "off"
  },
  {
    "charLabel": "meguru",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
