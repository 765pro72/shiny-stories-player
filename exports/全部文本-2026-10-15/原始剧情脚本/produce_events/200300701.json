    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "肩を回して、いち、に、さん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010250,
    "speaker": "めぐる",
    "text": "いち、に、さん",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "……では問題です\r\n逆立ちすると、軽くなる動物はなーんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010260,
    "speaker": "めぐる",
    "text": "！？　えっと……えーっと──鳩！？",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
