    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "め、めぐるー！",
    "charAnim2": "face_close2",
    "charLabel": "meguru",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "これは試合だ──",
    "nextLabel": "1"
  },
  {
    "select": "まあ落ち着こう",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "待ちの戦法でいこう",
    "nextLabel": "3"
  },
  {
    "id": 2003007010100,
    "label": "1",
    "speaker": "めぐる",
    "text": "えっ、どういう意味？\r\nプロデュー……",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "off",
    "voice": "produce_events/200300701/2003007010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや！　今はコーチだ、めぐる！",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "014"
  },
  {
    "id": 2003007010110,
    "speaker": "めぐる",
    "text": "！？　は、はい！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "勝負という意味ではクイズもスポーツと同じだ\r\nそれならめぐるの得意分野だろう？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "スポーツの試合で大切なことはなんだ？",
    "charAnim2": "face_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010120,
    "speaker": "めぐる",
    "text": "えっと……\r\n集中すること、まわりをよく見て、息を合わせること",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010120"
  },
  {
    "id": 2003007010130,
    "speaker": "めぐる",
    "text": "あとは、思い切り楽しむことっ！",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！　──それから、\r\n練習してきた自分を信じることだ",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010140,
    "speaker": "めぐる",
    "text": "はいっ！　コーチ……！",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるがクイズの練習問題をたくさん解いてきたって……\r\n俺は知ってるからな",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010150,
    "speaker": "めぐる",
    "text": "でも、最後まで全問正解はできなくて……\r\nごめんなさい、わたし、わたしっ……！",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいんだ！　それ以上言うな……！",
    "charAnim2": "face_close2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0116",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2003007010160,
    "speaker": "めぐる",
    "text": "っ──……プ、プロデューサー",
