  {
    "id": 2003007010060,
    "speaker": "めぐる",
    "text": "今日はイルミネーションスターズの\r\n代表として参加してるんだもん",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010060"
  },
  {
    "id": 2003007010070,
    "speaker": "めぐる",
    "text": "このまま画面から消えたりなんて絶対ダメだよ！\r\n真乃と灯織のためにも……！",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010070"
  },
  {
    "id": 2003007010080,
    "speaker": "めぐる",
    "text": "後半戦の収録開始まで、まだ15分ある……\r\n残った時間でまだまだなにかできるよねっ……！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
