    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010220"
  },
  {
    "id": 2003007010230,
    "speaker": "めぐる",
    "text": "いってきまーす、コーチ！",
