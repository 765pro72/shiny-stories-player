    "textFrame": "001",
    "voice": "produce_events/200300701/2003007010210"
  },
  {
    "id": 2003007010220,
    "speaker": "めぐる",
    "text": "『一流アイドル』を目指して……\r\nここまで頑張った自分を、信じればいいんだよねっ",
