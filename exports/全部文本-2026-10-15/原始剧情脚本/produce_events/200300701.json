  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……正解はイルカだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003007010270,
    "speaker": "めぐる",
    "text": "あっ、それ練習用の問題で解いた！\r\n知ってるやつだよー！",
