  },
  {
    "textFrame": "off"
  },
  {
    "id": 2015004010220,
    "label": "3",
    "speaker": "甜花",
    "text": "……そうなの？",
    "charAnim1": "think",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500401/2015004010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、\r\n甜花の笑顔には人を幸せにする力があるから……",
