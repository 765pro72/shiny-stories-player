    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500401/2015004010230"
  },
  {
    "id": 2015004010240,
    "speaker": "甜花",
    "text": "プロデューサーさんに、そう言われたら\r\nできるような気がしてきた……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
