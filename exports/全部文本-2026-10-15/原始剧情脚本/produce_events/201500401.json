    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "甜花はたくさん笑って、みんなに幸せを届けてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015004010230,
    "speaker": "甜花",
    "text": "人を幸せにする、笑顔……",
