      "time": 100
    },
    "voice": "produce_events/201601311/2016013110120"
  },
  {
    "id": 2016013110130,
    "speaker": "千雪",
    "text": "もうちょっと欲しいってところで止めるのが\r\nいちばん美味しい気がするんです、私",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なるほど？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110140,
    "speaker": "千雪",
    "text": "ふた口三口って食べちゃったら、\r\n全部欲しくなっちゃうし……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
