  {
    "id": 2016013110022,
    "speaker": "千雪＆プロデューサー",
    "text": "ははっ、ハッピーアイスクリーム！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110022"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、同時だったな……\r\n千雪、こういう時はどういう判定になるんだ？",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110030,
    "speaker": "千雪",
    "text": "私も、\r\n２回ハッピーアイスクリームしたのは初めてなんです",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110030"
  },
  {
    "id": 2016013110040,
    "speaker": "千雪",
    "text": "どうしたらいいと思います……？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、俺が決めていいのか？\r\nだったら、お互いにごちそうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110050,
    "speaker": "千雪",
    "text": "賛成です……！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110050"
  },
  {
    "id": 2016013110060,
    "speaker": "千雪",
    "text": "あ、ちょうどあるんじゃないです？\r\nご当地アイスクリームチェーン",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいじゃないか\r\n行こう……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "chiyuki",
