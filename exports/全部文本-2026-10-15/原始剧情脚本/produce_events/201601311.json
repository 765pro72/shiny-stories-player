    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201601311/2016013110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、いいのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110080,
    "speaker": "千雪",
    "text": "もちろんです\r\nそのかわり……",
