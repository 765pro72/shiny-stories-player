  {
    "id": 2016013110150,
    "speaker": "千雪",
    "text": "……なんだか、こういうふうに言っちゃうと\r\n素直じゃないみたいですね……！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201601311/2016013110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん\r\n素直じゃない、か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "撮影の時は、\r\n自分に素直すぎて焦ったけどな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110160,
    "speaker": "千雪",
    "text": "……！\r\nごめんなさい、それは……本当に",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601311/2016013110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、悪い悪い\r\nもう言いっこなしだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は、すごいと思ったよ\r\nあんなふうに手を伸ばせること",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
