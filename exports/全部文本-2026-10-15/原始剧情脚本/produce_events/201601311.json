  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "一口なら、\r\nもっとたっぷりすくってくれてもいいのに……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110120,
    "speaker": "千雪",
    "text": "ふふっ、そうですね",
    "charAnim1": "touch",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
