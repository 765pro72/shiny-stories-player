    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "お、紅いもアイスも美味そうだな\r\n……迷ったんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013110070,
    "speaker": "千雪",
    "text": "ふふっ、まだ食べてませんし、\r\nそちらのスプーンでひとさじすくってみませんか？",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
