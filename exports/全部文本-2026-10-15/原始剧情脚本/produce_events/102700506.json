  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n『色々』のうちの、他の理由も聞いていいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1027005060060,
    "speaker": "羽那",
