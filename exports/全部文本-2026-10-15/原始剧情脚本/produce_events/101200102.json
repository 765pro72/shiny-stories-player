  {
    "id": 1012001020040,
    "speaker": "凛世",
    "text": "本日も、ありがとう、ございました……\r\n次回も、お願いいたします……",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
