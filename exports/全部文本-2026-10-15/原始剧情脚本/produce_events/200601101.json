    },
    "voice": "produce_events/200601101/2006011010120"
  },
  {
    "id": 2006011010130,
    "speaker": "咲耶",
    "text": "……私は、アナタの期待に応え得る吸血鬼だったかな？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601101/2006011010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃあもう……！\r\nドキドキしたよ、咲耶の本気はすごいな",
