    "voice": "produce_events/200601101/2006011010020"
  },
  {
    "id": 2006011010030,
    "speaker": "咲耶",
    "text": "親愛なる我がプロデューサーが、\r\n心なしか浮かれているように見えるのはなぜか──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601101/2006011010030"
  },
  {
    "id": 2006011010040,
    "speaker": "咲耶",
    "text": "こんな質問はアリかい？",
