  },
  {
    "id": 2001011020200,
    "label": "2",
    "speaker": "真乃",
    "text": "……はい",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020200"
  },
  {
    "id": 2001011020210,
    "speaker": "真乃",
    "text": "それと…… \r\nお気に入りの傘を差して歩くのも楽しかったり……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、確かに……テンションが上がるって聞くし\r\n最近はそういう気持ちも、わかるようになってきたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も、気に入った傘があって\r\nそれを持っている日は、雨でも少し遠回りしたりしてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020220,
    "speaker": "真乃",
    "text": "……ふふ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020220"
  },
  {
    "id": 2001011020230,
    "speaker": "真乃",
    "text": "私も、雨だからちょっとだけって思ったお散歩が\r\n楽しくなって、遠回りしちゃうことがあります……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020230"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
