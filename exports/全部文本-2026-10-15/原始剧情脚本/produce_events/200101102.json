  {
    "id": 2001011020010,
    "speaker": "真乃",
    "text": "……プロデューサーさん、\r\nあったかいお茶、淹れてきました……",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0000",
    "voice": "produce_events/200101102/2001011020010"
  },
  {
    "textFrame": "off",
    "se": "0166",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、レッスン前にすまない真乃\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020020,
    "speaker": "真乃",
    "text": "い、いえっ\r\nあっ……え、エアコン寒かったりしませんか……？",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040010050",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200101102/2001011020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、平気だ、ちょうどいいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃がすぐタオルを貸してくれたおかげで\r\nだいぶ乾いたんじゃないかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020030,
    "speaker": "真乃",
    "text": "……そ、それならよかったです……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020030"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……心配してくれてありがとう\r\nでも、本当に大丈夫だからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020040,
    "speaker": "真乃",
    "text": "は、はい……\r\n……すみません",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020040"
  },
  {
    "id": 2001011020050,
    "speaker": "真乃",
    "text": "……プロデューサーさんが、\r\nびしょ濡れになって帰ってきて、びっくりしてしまって……",
    "charAnim1": "think",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……あともうちょっとで事務所ってところで\r\n急に降られちゃってな──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0125",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……最近は急な雨が多くて困るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も、真乃みたいに\r\nタオルを持ち歩くかな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いざという時に備えられるように……！",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020060,
    "speaker": "真乃",
    "text": "……通り雨も多いので\r\nそれもいいかもしれません……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ、でも\r\n今日のは通り雨ってわけでもなさそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00133",
    "fg": "001331",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1600,
    "fgEffectTime": 1600
  },
  {
    "textFrame": "off",
    "bgm": "0003",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "さっきより勢いが強くなってきた……\r\n帰りまでには止んでくれればいいんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020070,
    "speaker": "真乃",
    "text": "そうですね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020080,
    "speaker": "真乃",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020080"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2001011020090,
    "speaker": "真乃",
    "text": "……私、こういう雨を見ると\r\nちょっとだけワクワクする気持ちもあるんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020100,
    "speaker": "真乃",
    "text": "はい……その……雨が降ってるときにしか\r\nできないことがある気がして……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020100"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2001011020110,
    "speaker": "真乃",
    "text": "……小さい頃、たくさん雨が降った次の日に、\r\n大きな水たまりを探すのが好きでした",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020110"
  },
  {
    "id": 2001011020120,
    "speaker": "真乃",
    "text": "晴れた日は、水たまりに空が映って\r\nそこに飛び込んだら鳥さんになれた気がして……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020120"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2001011020130,
    "speaker": "真乃",
    "text": "……両親が心配するのも気にしないで、\r\nびしょ濡れになって遊んでいました……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、真乃もやんちゃに遊ぶときがあったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020140,
    "speaker": "真乃",
    "text": "ふふ……はい……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020140"
  },
  {
    "textFrame": "off",
    "bg": "00034",
    "fg": "fade_out",
    "bgEffect": "fade",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 2500,
    "bgEffectTime": 1600,
    "fgEffectTime": 1600
  },
  {
    "id": 2001011020150,
    "speaker": "真乃",
    "text": "……今ではもう、水たまりで遊ぶなんて\r\nしなくなっちゃいましたけれど……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101102/2001011020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、でも、雨の日にしかできないことか……\r\nそういうふうに考えると雨もいいかもしれないな",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "……今度、水たまり\r\n遊びをしてみるか",
    "nextLabel": "1"
  },
  {
    "select": "傘を選ぶのが\r\n楽しいとか……",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "片付けが\r\n捗ったり……",
    "nextLabel": "3"
  },
  {
    "id": 2001011020160,
    "label": "1",
    "speaker": "真乃",
    "text": "ほわ……\r\nぷ、プロデューサーさんがですか……？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……！　真乃の話を聞いてたら、\r\n久しぶりにやってみたくなってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020170,
    "speaker": "真乃",
    "text": "ほわ……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020170"
  },
  {
    "id": 2001011020180,
    "speaker": "真乃",
    "text": "……プロデューサーさんが水たまりで……\r\nなんだかちょっと意外で、想像ができないです……",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101102/2001011020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……！　確かにそうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "まあ、子どもの頃みたいにはできないけどさ\r\nたまにはそうしてはしゃぐのもいいだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011020190,
    "speaker": "真乃",
    "text": "……ふふ、そうですね\r\nそうかもしれません……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
