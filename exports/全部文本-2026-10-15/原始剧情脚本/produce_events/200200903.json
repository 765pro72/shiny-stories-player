    "voice": "produce_events/200200903/2002009030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっ、じゃあさ、よかったら俺に付き合ってくれないか？\r\n行ってみたいところがあるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009030040,
    "speaker": "灯織",
    "text": "行ってみたいところ……？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200903/2002009030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "美術館？　アートっていうのか……？\r\nなんて言うか、壮大な感じの……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009030050,
    "speaker": "灯織",
    "text": "すみません、ちょっとよくわかりません",
