  {
    "id": 1003004030040,
    "speaker": "めぐる",
    "text": "『そうだね！\r\nもしかしたらそういう子もいてくれるのかもしれない』",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0377",
    "voice": "produce_events/100300403/1003004030040"
  },
  {
    "id": 1003004030050,
    "speaker": "めぐる",
    "text": "『でもね、さっき書いたみたいに\r\nこのご招待はわたしがお礼をしたい人にしてるんだ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030050"
  },
  {
    "id": 1003004030060,
    "speaker": "めぐる",
    "text": "『今さらって思うかもなんだけど\r\nこれはわたしが転校してきた日のお礼なの』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030060"
  },
  {
    "id": 1003004030070,
    "speaker": "めぐる",
    "text": "『あの時声をかけてくれてありがとう\r\nおかげでみんなとも仲良くなれたよ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0000",
    "se": "0377",
    "voice": "produce_events/100300403/1003004030070"
  },
  {
    "id": 1003004030080,
    "speaker": "めぐる",
    "text": "『ずっとちゃんと言えてなかったけど本当に嬉しかったんだ\r\nだから、そのお返しをしたくて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030080"
  },
  {
    "id": 1003004030090,
    "speaker": "めぐる",
    "text": "『他の子じゃダメなの』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030090"
  },
  {
    "id": 1003004030100,
    "speaker": "めぐる",
    "text": "『招待って全然大げさなものじゃなくてね\r\n受付で名前を言うだけでいいんだ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030100"
  },
  {
    "id": 1003004030110,
    "speaker": "めぐる",
    "text": "『だから\r\nしつこくてごめんなんだけど』",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0377",
    "voice": "produce_events/100300403/1003004030110"
  },
  {
    "id": 1003004030120,
    "speaker": "めぐる",
    "text": "『もしよかったら\r\nもう一度考えてみてくれると嬉しいな！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030120"
  },
  {
    "id": 1003004030130,
    "speaker": "めぐる",
    "text": "『予定とかあると思うし\r\n本当無理はしなくていいからね！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300403/1003004030130"
  },
