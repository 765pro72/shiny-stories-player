    "waitTime": 2000
  },
  {
    "id": 7802001070090,
    "speaker": "かな",
    "text": "ありがとう、プロデューサー",
    "charAnim1": "shy1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/780200107/7802001070090"
  },
  {
    "id": 7802001070100,
    "speaker": "かな",
    "text": "ちゃんと私を見て、\r\nできるって信じてくれるのは嬉しい",
    "charLipAnim": "lip_smile",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/780200107/7802001070100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ、もちろんだ\r\nここまでのかなを────────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7802001070110,
    "speaker": "かな",
    "text": "言っとくけど、『信じてる』とか『きっと必ず』とか\r\nそういう言葉はいらないからね？",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/780200107/7802001070110"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7802001070120,
    "speaker": "かな",
    "text": "あなたってなんかキザっていうか、\r\nたまに拒否反応が出るのよね……！",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/780200107/7802001070120"
  },
  {
    "speaker": "プロデューサー",
    "text": "きょ……！？",
