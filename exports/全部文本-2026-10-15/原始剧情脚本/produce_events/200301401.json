    "voice": "produce_events/200301401/2003014010050"
  },
  {
    "id": 2003014010060,
    "speaker": "めぐる",
    "text": "『対バン』ってバンドもあるの！？　ってなるけど、\r\nそういうことじゃないよね……？",
    "charAnim1": "shy1",
    "charAnim2": "face_surp",
