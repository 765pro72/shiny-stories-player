    "voice": "produce_events/200601103/2006011030160"
  },
  {
    "id": 2006011030170,
    "speaker": "咲耶",
    "text": "ハロウィンの住人のやったこととして──\r\n水に流してもらえると嬉しいな？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
