  {
    "speaker": "プロデューサー",
    "text": "お疲れ様、咲耶！\r\nすごくよかったぞ──！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011030010,
    "speaker": "咲耶",
    "text": "ああ──ありがとう、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040060050",
    "charPosition": {
