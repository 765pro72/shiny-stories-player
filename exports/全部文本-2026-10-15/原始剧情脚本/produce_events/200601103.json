    },
    "voice": "produce_events/200601103/2006011030010"
  },
  {
    "id": 2006011030020,
    "speaker": "咲耶",
    "text": "アナタの尽力のおかげだね",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030020"
  },
  {
    "id": 2006011030030,
    "speaker": "咲耶",
    "text": "吸血鬼という役を\r\n迷いなく演じることができたのは──",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030030"
  },
  {
    "id": 2006011030040,
    "speaker": "咲耶",
    "text": "アナタとの練習があったからだ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは\r\nなんでもかんでも俺の手柄にされちゃ困るな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "立派な吸血鬼だったのは、間違いなく咲耶なんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011030050,
    "speaker": "咲耶",
    "text": "フフ……",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030050"
  },
  {
    "id": 2006011030060,
    "speaker": "咲耶",
    "text": "私としては、アナタという乙女の献身が\r\n吸血鬼の私を形作ったのだと思っているのだけれど",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030060"
  },
  {
    "id": 2006011030070,
    "speaker": "咲耶",
    "text": "──しかし、アナタからの賛辞という糧もまた\r\n甘くて味わい深い",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030070"
  },
  {
    "id": 2006011030080,
    "speaker": "咲耶",
    "text": "ありがたく頂戴するとしようか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうしてくれると嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あと、乙女は勘弁だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011030090,
    "speaker": "咲耶",
    "text": "フフフ……！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "──それじゃあ、先に控室に戻っててくれ\r\nインタビューが始まるまで休憩時間になるから──",
    "charAnim2": "face_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011030100,
    "speaker": "咲耶",
    "text": "……ああ\r\nアナタはもう行ってしまうんだね……？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/200601103/2006011030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011030110,
    "speaker": "咲耶",
    "text": "ひどい人だ\r\nプロデューサー、私はアナタを確かに虜にしたと思ったのに",
    "charAnim1": "anger1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030110"
  },
  {
    "id": 2006011030120,
    "speaker": "咲耶",
    "text": "アナタは簡単に私のそばを離れると言う\r\n……やはり私のチャームでは不十分なのだろうか",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601103/2006011030120"
  },
  {
    "id": 2006011030130,
    "speaker": "咲耶",
    "text": "アナタをとどめておけないのだから──……",
    "charAnim1": "wait5",
