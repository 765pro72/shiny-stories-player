      "time": 100
    },
    "voice": "produce_events/102300304/1023003040130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……うん\r\nそれはちゃんとわかってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023003040140,
    "speaker": "雛菜",
    "text": "そう～？\r\nそれならいいけど～",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
