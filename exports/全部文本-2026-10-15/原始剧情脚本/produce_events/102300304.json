    "waitTime": 1500
  },
  {
    "id": 1023003040010,
    "speaker": "雛菜",
    "text": "…………！\r\nえ、どうしたんですか～……？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "023",
    "charPosition": {
      "x": 568,
