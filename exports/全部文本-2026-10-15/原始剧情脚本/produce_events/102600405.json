    "text": "──うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "理由は……聞いてもいいか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
