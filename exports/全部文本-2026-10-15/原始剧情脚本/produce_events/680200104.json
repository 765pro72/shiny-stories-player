    "textFrame": "001",
    "voice": "produce_events/680200104/6802001040020"
  },
  {
    "id": 6802001040030,
    "speaker": "かな",
    "text": "まあ……落ちぶれてた私を\r\nここまで引き上げてくれたのはたしかだけどね",
