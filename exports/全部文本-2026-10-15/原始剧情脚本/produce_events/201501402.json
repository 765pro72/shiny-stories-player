  {
    "id": 2015014020310,
    "speaker": "甜花",
    "text": "『も、もしもし……？\r\nプロデューサーさん……何……？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020310"
  },
  {
    "speaker": "プロデューサー",
    "text": "甜花、お疲れ様\r\n今度の仕事について伝えたいことがあってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "電話の方が早いと思ってな──\r\n今大丈夫か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015014020320,
    "speaker": "甜花",
    "text": "『う、うん……！\r\n大丈夫……だけど……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020320"
  },
  {
    "id": 2015014020330,
    "speaker": "甜花",
    "text": "『えと……いっこ、プロデューサーさんに\r\n聞きたいこと、ある……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020330"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015014020340,
    "speaker": "甜花",
    "text": "『プロデューサーさん……\r\n今日ずっと、事務所こない……よね……！？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020340"
  },
  {
    "id": 2015014020350,
    "speaker": "甜花",
    "text": "『あと……はづきさんも……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020350"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、その予定だけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "何か用事でもあるのか？\r\nそれなら、遅くなるかもしれないけど事務所に──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015014020360,
    "speaker": "甜花",
    "text": "『や、いい……！\r\n大丈夫……！　用事ないよ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020360"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……ところで甜花、今どこにいるんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015014020370,
    "speaker": "甜花",
    "text": "『え……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020370"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2015014020380,
    "speaker": "甜花",
    "text": "『そ……外だよ……！』",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/201501402/2015014020380"
  },
  {
    "select": "なんかすごい音が\r\n聞こえるんだが……",
    "nextLabel": "1"
  },
  {
    "select": "それなら後でかけ直すよ",
