      "time": 100
    },
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2006004040040,
    "speaker": "咲耶",
    "text": "フフ……\r\n本当に、いい海だな……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040040"
