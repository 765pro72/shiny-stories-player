      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "お疲れ様、咲耶\r\nこの日差しの中、よく頑張ったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040080,
    "speaker": "咲耶",
    "text": "ありがとう、プロデューサー",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040080"
  },
  {
    "id": 2006004040090,
    "speaker": "咲耶",
    "text": "私こそ、こんな素敵な仕事を持ってきてくれたアナタに\r\nお礼を言いたいよ",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040090"
  },
  {
    "id": 2006004040100,
    "speaker": "咲耶",
    "text": "ねえ、頑張ったご褒美……と言ってはなんだけど、お願いだ\r\nこのまま、もう少しだけここにいてもいいかい？",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。せっかく来たんだし、撮影もスムーズだったからな\r\n少しくらいなら大丈夫だぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040110,
    "speaker": "咲耶",
    "text": "やった！\r\nありがとう、プロデューサー",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040110"
  },
  {
    "id": 2006004040120,
    "speaker": "咲耶",
    "text": "せっかくだし、一緒に波打ち際を歩かないかい？",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、俺もか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040130,
    "speaker": "咲耶",
    "text": "さっきの撮影で足に触れる波がとても心地良くてね……",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040130"
  },
  {
    "id": 2006004040140,
    "speaker": "咲耶",
    "text": "プロデューサーは、暑い中見てるだけだっただろう？\r\n足くらい、水につけてみたらどうだい？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040140"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、咲耶！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0265",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "bgm": "008",
    "se": "1040060010",
    "movie": "1040060010"
  },
  {
    "id": 2006004040150,
    "speaker": "咲耶",
    "text": "ほら、プロデューサーもおいでよ！\r\n足をつけるだけでも、すごく気持ちいいんだ！",
    "charAnim1": "sad1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200600404/2006004040150"
  },
  {
    "id": 2006004040160,
    "speaker": "咲耶",
    "text": "こんな素敵な場所……\r\nフフ、プライベートでも遊びに来たいな",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……なんだかいつもより生き生きとしてるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040170,
    "speaker": "咲耶",
    "text": "……そうか、やはりそう見えてしまったかい？",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\n別に悪いことじゃないだろ？　なんで嫌そうなんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040180,
    "speaker": "咲耶",
    "text": "嫌……というか、\r\nファンには、いつでも最高の自分を届けたいんだ",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040180"
  },
  {
    "id": 2006004040190,
    "speaker": "咲耶",
    "text": "だから、仕事によって差ができてしまうのは\r\n良くないことのような気がしていてね……",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……咲耶はいつも最高の姿をファンに届けてるぞ\r\nかっこいい咲耶に、今日みたいに無邪気な咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "またひとつ、咲耶の新たな魅力をファンに届けられたんだ\r\n素直に喜んでいいんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040200,
    "speaker": "咲耶",
    "text": "そうか、新しい……魅力……\r\n……フフ、ありがとう、プロデューサー",
    "charAnim1": "wait5",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040200"
  },
  {
    "id": 2006004040210,
    "speaker": "咲耶",
    "text": "私はね、海のすべてが好きでたまらないんだ\r\nこうやって、触れた時の心地良さはもちろん──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040210"
  },
  {
    "id": 2006004040220,
    "speaker": "咲耶",
    "text": "波の音や潮の香り、浜辺から見える街の風景\r\nそして、太陽を映して煌めく美しい水面……",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040220"
  },
  {
    "id": 2006004040230,
    "speaker": "咲耶",
    "text": "その上、海の魅力に魅せられ集う人たちと\r\n交流を深めることもできる……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040230"
  },
  {
    "id": 2006004040240,
    "speaker": "咲耶",
    "text": "それに……大切な人とこうやって肩を並べて、\r\n波打ち際を歩いたり……ね",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶は本当に海が好きなんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040250,
    "speaker": "咲耶",
    "text": "うん……私の、一番好きな場所だ\r\nだから、今日は撮影に連れて来てくれてありがとう",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040250"
  },
  {
    "id": 2006004040260,
    "speaker": "咲耶",
    "text": "こんなに美しい海で仕事ができて嬉しかったし、\r\n心から楽しませてもらったよ",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040260"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺のほうこそ、今日の撮影は本当に良かった\r\n見ているだけで、俺まで楽しい気分になったからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040270,
    "speaker": "咲耶",
    "text": "……そんなに良かったかい？",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040270"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、今日の写真を見た人はみんな咲耶のファンになる\r\n間違いない！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040280,
    "speaker": "咲耶",
    "text": "そうか……\r\nフフ、それは嬉しいな",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040280"
  },
  {
    "id": 2006004040290,
    "speaker": "咲耶",
    "text": "みんな、私のファンに……か",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040290"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2006004040300,
    "speaker": "咲耶",
    "text": "……ねえ、プロデューサー\r\nもうひとつだけ、お願いをしてもいいかな？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　改まってどうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040310,
    "speaker": "咲耶",
    "text": "私はいつか、あそこへ行きたいんだ",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "bg": "00075",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200600404/2006004040310",
    "bgEffect": "fade"
  },
  {
    "textFrame": "off",
    "bg": "00062",
    "waitType": "time",
    "waitTime": 3000,
    "bgEffect": "fade"
  },
  {
    "speaker": "プロデューサー",
    "text": "海……？\r\n……いや、水平線か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006004040320,
    "speaker": "咲耶",
    "text": "ああ\r\n私は、あの水平線の向こうに行きたい",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200600404/2006004040320"
  },
  {
    "id": 2006004040330,
    "speaker": "咲耶",
    "text": "そして、世界中の人々に出会い\r\nその人たちに、たくさんの笑顔を届けたい……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
