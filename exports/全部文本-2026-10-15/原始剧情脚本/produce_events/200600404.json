    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2006004040050,
    "speaker": "咲耶",
    "text": "………………",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040050"
  },
  {
    "id": 2006004040060,
    "speaker": "咲耶",
    "text": "……おっと\r\nすみません、海に見惚れていて……",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040060"
  },
  {
    "speaker": "カメラマン",
    "text": "いや、これはこれで……\r\nうん、すごくいい表情だ！　これでいこう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "se": "0131",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "se": "0131",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "speaker": "スタッフ",
    "text": "はい、OKですー！\r\nお疲れ様でしたー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006004040070,
    "speaker": "咲耶",
    "text": "お疲れ様です\r\nありがとうございました",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600404/2006004040070"
  },
  {
    "textFrame": "off",
