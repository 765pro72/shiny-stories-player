    "voice": "produce_events/200600811/2006008110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006008110150,
    "speaker": "咲耶",
    "text": "アナタと歩く時、\r\nアナタを待たすことのない私でいられる……",
