    "textFrame": "001",
    "voice": "produce_events/700300107/7003001070030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ごほん！\r\nま、まあそれはさておき……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる、あらためて合格おめでとう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001070040,
    "speaker": "めぐる",
    "text": "……うんっ",
