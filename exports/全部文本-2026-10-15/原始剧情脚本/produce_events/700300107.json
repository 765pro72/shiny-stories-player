    "textFrame": "001",
    "voice": "produce_events/700300107/7003001070090"
  },
  {
    "id": 7003001070100,
    "speaker": "めぐる",
    "text": "最後のライブをちゃんとやりきるまで、\r\nどっちもできたなんて、言えないから！",
