    "textFrame": "001",
    "voice": "produce_events/700300107/7003001070050"
  },
  {
    "id": 7003001070060,
    "speaker": "めぐる",
    "text": "わたし……『W.I.N.G.』に出られるんだよね！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300107/7003001070060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n間違いなく、出られるぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001070070,
    "speaker": "めぐる",
    "text": "えへへ……！",
