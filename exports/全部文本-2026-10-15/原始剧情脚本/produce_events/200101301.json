    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101301/2001013010030"
  },
  {
    "id": 2001013010040,
    "speaker": "真乃",
    "text": "淹れてくださってありがとうございます……っ",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
