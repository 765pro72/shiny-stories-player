    "textFrame": "001",
    "voice": "produce_events/200101301/2001013010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、いいんだ、よかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
