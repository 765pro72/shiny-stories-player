      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "それで、相談はレッスンをもう少し\r\n増やしたいってことだったよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013010050,
    "speaker": "真乃",
    "text": "……はい……っ\r\n今度のライブに向けてたくさん練習できたらって",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101301/2001013010050"
  },
  {
    "id": 2001013010060,
    "speaker": "真乃",
    "text": "今からでは難しいでしょうか……？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101301/2001013010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかった、ちょっと調整してみるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ただ、もしかすると３人一緒の日で\r\n予定を入れるのは難しいかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それでもいいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013010070,
    "speaker": "真乃",
    "text": "は、はい、大丈夫です……っ",
    "charAnim1": "anger3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101301/2001013010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、じゃあ、予定が決まったら\r\nみんなにチェインでスケジュール送るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013010080,
    "speaker": "真乃",
    "text": "ありがとうございます……っ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101301/2001013010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "とんでもない\r\nこっちこそ、相談してくれてありがとう",
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "当日はサプライズ企画もやってみたいって\r\n言ってくれてたもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃たちのライブへの気持ちを詰め込めるように、\r\n俺ももっと頑張ろうって思ったくらいだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当にありがとうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s3",
    "charLabel": "mano",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、俺からの確認はこれくらいかな……\r\n他に真乃から話しておきたいことはないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
