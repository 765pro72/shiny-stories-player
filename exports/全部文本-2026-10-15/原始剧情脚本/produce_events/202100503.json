    "waitTime": 1200
  },
  {
    "id": 2021005030070,
    "speaker": "円香",
    "text": "今日は素晴らしい機会をいただきまして、\r\n本当にありがとうございました",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
