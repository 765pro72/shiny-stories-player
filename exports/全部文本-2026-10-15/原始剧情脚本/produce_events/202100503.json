    "waitTime": 1500
  },
  {
    "id": 2021005030090,
    "speaker": "円香",
    "text": "言葉で表せないくらい、\r\n素晴らしかったです",
    "charAnim1": "sigh",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030090"
  },
  {
    "id": 2021005030100,
    "speaker": "円香",
    "text": "最初は……恐縮ながら、\r\n主人公をつまらない男だと思っていたのですが",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030100"
  },
  {
    "id": 2021005030110,
    "speaker": "円香",
    "text": "途中で、主人公の心情がピアノの音と\r\nリンクしていることに気付いて本当に驚きました",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021005030120,
    "speaker": "円香",
    "text": "ラストシーン、埃だらけのピアノに触れた瞬間、\r\n世界が金色に染まったのは……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030120"
  },
  {
    "id": 2021005030130,
    "speaker": "円香",
    "text": "彼の心が世界に溢れ出た表れなのだろうなと",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030130"
  },
  {
    "speaker": "関係者",
    "text": "なるほど、なるほど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2021005030140,
    "speaker": "円香",
    "text": "……すみません、素人の解釈なので、\r\n間違っているかもしれませんが……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030140"
  },
  {
    "id": 2021005030150,
    "speaker": "円香",
    "text": "一般公開されたら、もう一度……一度とは言わず何度も、\r\n繰り返し、観させていただきます",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030150"
  },
  {
    "id": 2021005030160,
    "speaker": "円香",
    "text": "本当に感動しました",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100503/2021005030160"
  },
  {
    "speaker": "関係者",
    "text": "ありがとうございます\r\n楽しんでもらえたなら私も嬉しいです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
