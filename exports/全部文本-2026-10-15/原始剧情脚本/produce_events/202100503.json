      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202100503/2021005030070"
  },
  {
    "speaker": "関係者",
    "text": "樋口さん、こちらこそありがとうございました\r\nどうでしたか……試写をご覧いただいて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2021005030080,
    "speaker": "円香",
    "text": "はい",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
