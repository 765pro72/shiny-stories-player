    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201102/2022011020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだな\r\nそれが合ってるみたいだ",
