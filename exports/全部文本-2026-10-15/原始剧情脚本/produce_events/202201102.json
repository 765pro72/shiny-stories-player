    "charAnim4": "eye_left",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201102/2022011020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、小糸姉さんは真面目だなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011020200,
    "speaker": "小糸",
    "text": "ぷ、プロデューサーさん……！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201102/2022011020200"
  },
  {
