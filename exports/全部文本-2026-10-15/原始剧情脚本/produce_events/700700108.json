    "voice": "produce_events/700700108/7007001080020"
  },
  {
    "id": 7007001080030,
    "speaker": "結華",
    "text": "プロデューサーが三峰のために\r\nたくさん頑張ってくれたこと、知ってる",
    "charAnim1": "shy2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700700108/7007001080030"
  },
  {
    "id": 7007001080040,
    "speaker": "結華",
    "text": "だから……期待に応えられなくて、ごめんなさい",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700700108/7007001080040"
  },
  {
    "id": 7007001080050,
    "speaker": "結華",
    "text": "ねぇプロデューサー……三峰のこと、呆れた？",
