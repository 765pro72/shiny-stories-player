    "charAnim2": "face_close",
    "charLipAnim": "lip_shy_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7007001080060,
    "speaker": "結華",
    "text": "……なら！　三峰はもっと気張らないとね\r\n次こそプロデューサーの期待に応えるために！",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
