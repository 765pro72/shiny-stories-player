  },
  {
    "speaker": "プロデューサー",
    "text": "『ああ、しっかり保管してある』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014018110060,
    "speaker": "甘奈",
    "text": "せっかくだし、一緒に飲まない？\r\n３年は大丈夫って言ってたけど、それ以上はわからないから",
