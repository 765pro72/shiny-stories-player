  {
    "speaker": "プロデューサー",
    "text": "『３年前のやつだよな\r\n大丈夫、しっかり覚えてるぞ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014018110050,
    "speaker": "甘奈",
    "text": "プロデューサーさんに持って帰ってもらってた\r\n気がするんだけど、あってる……？",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
