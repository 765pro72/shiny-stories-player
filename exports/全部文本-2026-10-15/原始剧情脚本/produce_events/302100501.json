    "textFrame": "003",
    "autoWaitTime": 1500
  },
  {
    "speaker": "生徒２",
    "text": "ふふっ……\r\nいや、その気持ち、わかるよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒２",
    "text": "浅倉さんってさ、なんか気になるよね\r\n私もたまに見ちゃうもん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "あ、やっぱり？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒２",
    "text": "なんだろ、なんか……\r\nどこ見てるのかなーって感じの顔してることない？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "あるある……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒２",
    "text": "変わったことしてる訳じゃないんだけど\r\nなんとなく、目が離せない時、あるんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "わかる～～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "ほんと目の保養～ってくらい綺麗だけどさ、\r\nそれだけじゃないっていうか",
