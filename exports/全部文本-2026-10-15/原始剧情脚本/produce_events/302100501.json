  },
  {
    "speaker": "生徒２",
    "text": "ん……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "何か、ずっと見上げてるから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒２",
    "text": "……空を見てるのかな？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "生徒１",
    "text": "ね、なんだろう……\r\n……………………",
