      "time": 100
    },
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "speaker": "プロデューサー",
    "text": "────はは、可愛いのつけてるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "館内スタッフ",
    "text": "とっても似合っていますよ、市川さん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2023011010020,
    "speaker": "雛菜",
    "text": "やは～～～♡\r\nありがとうございます～！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202301101/2023011010020"
  },
  {
    "id": 2023011010030,
    "speaker": "雛菜",
    "text": "どこ見てもユアクマちゃんばっかりで、\r\n雛菜、すっごくしあわせです～～～！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202301101/2023011010030"
  },
  {
