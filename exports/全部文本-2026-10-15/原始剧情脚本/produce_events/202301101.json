      "time": 100
    }
  },
  {
    "speaker": "カメラマン",
    "text": "市川さん、こっちの準備バッチリなんで\r\n撮影始めちゃいましょう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2023011010040,
