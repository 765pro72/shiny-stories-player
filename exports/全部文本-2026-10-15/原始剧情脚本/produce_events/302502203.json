    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030250"
  },
  {
    "id": 3025022030260,
    "speaker": "美琴",
    "text": "『ちょっとぎこちない』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030260"
  },
  {
    "id": 3025022030270,
    "speaker": "美琴",
    "text": "『にちかちゃんは\r\nいつも通りの方がいいのに』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030270"
  },
  {
    "id": 3025022030280,
    "speaker": "にちか",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030280"
  },
  {
    "id": 3025022030290,
    "speaker": "にちか",
    "text": "『でもさ──成人式の前撮りとか……\r\nやっぱ緊張しちゃって──』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030290"
  },
  {
    "id": 3025022030300,
    "speaker": "美琴",
    "text": "『大丈夫、落ち着いて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030300"
  },
  {
    "id": 3025022030310,
    "speaker": "美琴",
    "text": "『ちゃんと笑えないと\r\nもったいないよ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030310"
  },
  {
    "id": 3025022030320,
    "speaker": "美琴",
    "text": "『ずっと残るんだから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030320"
  },
  {
    "id": 3025022030330,
    "speaker": "にちか",
    "text": "『えー\r\nそんな風に言われたら余計に緊張するんですけど』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030330"
  },
  {
    "id": 3025022030340,
    "speaker": "美琴",
    "text": "『そっか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030340"
  },
  {
    "id": 3025022030350,
    "speaker": "美琴",
    "text": "『でも、にちかちゃんは\r\nそういうところが、いいのかもね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030350"
  },
  {
    "id": 3025022030360,
    "speaker": "にちか",
    "text": "『……そういうところ？\r\nどういうとこか、いまいちわかんないけど──』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030360"
  },
  {
    "id": 3025022030370,
    "speaker": "にちか",
    "text": "『なんか落ち着いてるよね\r\n……みーちゃんは』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030370"
  },
  {
    "id": 3025022030380,
    "speaker": "にちか",
    "text": "『……あーあ\r\nやっぱ私たち全然違う』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302502203/3025022030380"
  },
  {
    "id": 3025022030390,
    "speaker": "美琴",
