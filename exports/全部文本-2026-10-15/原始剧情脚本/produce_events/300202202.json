  {
    "id": 3002022020030,
    "speaker": "めぐる",
    "text": "毎週あんなことやこんなことが\r\nてんこ盛りなので、お見逃しなくお願いします！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
