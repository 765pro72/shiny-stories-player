    "waitTime": 1500
  },
  {
    "speaker": "ダンストレーナー",
    "text": "……まぁ、実際は────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "自分が思い描くアイドルになれる人なんて\r\nほとんどいないのが現実だけど……",
    "charAnim2": "face_wait",
