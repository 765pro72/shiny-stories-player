  },
  {
    "speaker": "ダンストレーナー",
    "text": "なんていうか……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "現実は厳しいけど\r\n一緒に頑張っていけたらいいねってことを伝えたかったんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1023005030040,
    "speaker": "雛菜",
    "text": "はい～……\r\nこれからもよろしくお願いします～！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
