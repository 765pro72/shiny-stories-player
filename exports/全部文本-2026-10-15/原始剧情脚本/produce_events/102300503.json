    "textFrame": "001",
    "voice": "produce_events/102300503/1023005030010"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "そうなんだ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "────いや、すごく筋がいいからさ\r\n教えがいがあるなーって思って！",
