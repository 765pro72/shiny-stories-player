    "voice": "produce_events/202301211/2023012110060"
  },
  {
    "speaker": "雑誌記者",
    "text": "そうですか……！\r\n少し先の未来を夢でご覧になったんですね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2023012110070,
