  {
    "id": 3009002020120,
    "speaker": "夏葉",
    "text": "ワン、ツー、スリー、フォー……\r\n果穂、ここのステップは左につられるけど、右足からね？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020120"
  },
  {
    "id": 3009002020130,
    "speaker": "果穂",
    "text": "はいっ！　夏葉さん、スッゴく上手ですっ！",
    "charAnim1": "wait1",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
