    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020010"
  },
  {
    "id": 3009002020020,
    "speaker": "樹里",
    "text": "よう、果穂\r\n今からレッスンスタジオで自主トレだ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020020"
  },
  {
    "id": 3009002020030,
    "speaker": "夏葉",
    "text": "樹里が、どうしても一緒に～って聞かないのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020030",
    "charAnim3Loop": false
  },
  {
    "id": 3009002020040,
    "speaker": "樹里",
    "text": "なっ……！　そっちが言い出したんだろっ！？",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020040"
  },
  {
    "id": 3009002020050,
    "speaker": "夏葉",
    "text": "あら、そうだったかしら",
    "charAnim1": "surp1",
    "charAnim2": "face_smile1",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020050"
  },
  {
    "id": 3009002020060,
    "speaker": "果穂",
    "text": "わぁっ！\r\nあたしも一緒に、自主トレしたいですっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020060"
  },
  {
    "id": 3009002020070,
    "speaker": "樹里",
    "text": "今日はアタシら用に組んだメニューだからキツいぞ\r\n……それでも大丈夫か？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020070"
  },
  {
    "id": 3009002020080,
    "speaker": "果穂",
    "text": "頑張りますっ\r\nあたしも、もっと練習したいですからっ！",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020080"
  },
  {
    "id": 3009002020090,
    "speaker": "夏葉",
    "text": "いい熱意ね！　それじゃあついてきなさい！\r\n樹里、いいわよね？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020090"
  },
  {
    "id": 3009002020100,
    "speaker": "樹里",
    "text": "そこまでのやる気なら、いいんじゃねーか？\r\nけど、無理だけはしねーようにしろよ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020100"
  },
