  {
    "id": 3009002020010,
    "speaker": "果穂",
    "text": "あ、夏葉さん、樹里ちゃん！\r\nどこに行くんですか？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
