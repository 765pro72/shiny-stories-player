  },
  {
    "id": 3009002020140,
    "speaker": "樹里",
    "text": "夏葉もしょっちゅう間違えるとこだけどな",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020140"
  },
  {
    "id": 3009002020150,
    "speaker": "夏葉",
    "text": "樹里～？　何か言ったかしら～？",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020150"
  },
  {
    "id": 3009002020160,
    "speaker": "樹里",
    "text": "何も言ってねーぞー。勘違いじゃねーの？\r\n果穂ー、疲れたらちゃんと言えよー？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charAnim3": "no",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020160",
    "charAnim3Loop": false
  },
  {
    "id": 3009002020170,
    "speaker": "果穂",
    "text": "ありがとうございますっ、大丈夫ですっ！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020170"
  },
  {
    "id": 3009002020180,
    "speaker": "夏葉",
    "text": "あらあら……、果穂にかこつけて休もうっていう魂胆ね？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020180"
  },
  {
    "id": 3009002020190,
    "speaker": "樹里",
    "text": "んだとっ、これくらいまだまだ余裕だっての！",
    "charAnim1": "anger1",
    "charAnim3": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020190"
  },
  {
    "id": 3009002020200,
    "speaker": "夏葉",
    "text": "本当かしら？\r\nそれじゃあもっとペース上げましょ",
    "charAnim1": "think",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020200"
  },
  {
    "id": 3009002020210,
    "speaker": "樹里",
    "text": "ああ、望むところだ！",
    "charAnim1": "anger3",
    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020210"
  },
  {
    "id": 3009002020220,
    "speaker": "果穂",
    "text": "わぁっ……",
    "charAnim1": "think",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020220"
  },
  {
    "id": 3009002020230,
    "speaker": "夏葉",
    "text": "あら、どうしたの？　果穂",
    "charAnim1": "surp1",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020230"
  },
  {
    "id": 3009002020240,
    "speaker": "果穂",
    "text": "ふたりは『せっさたくま』しあうライバルなんですねっ！",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020240"
  },
  {
    "id": 3009002020250,
    "speaker": "果穂",
    "text": "普段はチームの仲間として協力し合い、\r\n時にはライバルとして、譲れない思いが熱くぶつかり合う！",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020250"
  },
  {
    "id": 3009002020260,
    "speaker": "果穂",
    "text": "ヒーローみたいで、スゴくカッコいいですっ！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020260"
  },
  {
    "id": 3009002020270,
    "speaker": "樹里",
    "text": "ら、ライバル！？　アタシと夏葉が？\r\nそんなわけ……",
    "charAnim1": "shy1",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020270"
  },
  {
    "id": 3009002020280,
    "speaker": "果穂",
    "text": "だから樹里ちゃんと夏葉さんは、\r\nあんなにスゴいダンスができるんですね！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020280"
  },
  {
    "id": 3009002020290,
    "speaker": "夏葉",
    "text": "まぁ……確かに\r\n樹里がいるといつもよりトレーニング捗るわね……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020290"
  },
  {
    "id": 3009002020300,
    "speaker": "果穂",
    "text": "やっぱり、二人はスゴいですっ！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020300"
  },
  {
    "id": 3009002020310,
    "speaker": "果穂",
    "text": "あたしも負けてられませんっ\r\nもっともっと、レッスン頑張りますっ！",
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020310"
  },
  {
    "id": 3009002020320,
    "speaker": "夏葉",
    "text": "大丈夫？\r\nかなりハードだったし、今日はもう厳しいんじゃないかしら",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020320"
  },
  {
    "id": 3009002020330,
    "speaker": "果穂",
    "text": "平気ですっ！　あたしももっといっぱい練習して、\r\n早く上手になりたいですから！",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020330"
  },
  {
    "id": 3009002020340,
    "speaker": "樹里",
    "text": "いい心意気じゃねーか\r\nじゃあ、次は３人で合わせてみるか！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020340"
  },
  {
    "id": 3009002020350,
    "speaker": "夏葉",
    "text": "そうね\r\nでも、つらくなったら無理せずちゃんと言うのよ？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020350"
  },
  {
    "id": 3009002020360,
    "speaker": "果穂",
    "text": "えへへっ、ありがとうございますっ\r\nあたし、もっともっと頑張りますっ！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900202/3009002020360"
  },
  {
    "id": 3009002020370,
    "speaker": "果穂",
    "text": "あたしも、ふたりと『せっさたくま』しあえるような、\r\n仲間でありライバルに、なりたいですからっ！",
    "charAnim1": "think",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
