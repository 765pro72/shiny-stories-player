    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110210"
  },
  {
    "id": 2002015110220,
    "speaker": "灯織",
    "text": "だから、プロデューサーや、\r\n真乃とめぐる、２８３のみんなと一緒に過ごす時間って──",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110220"
  },
  {
    "id": 2002015110230,
    "speaker": "灯織",
    "text": "こういうただ帰るだけの道のりだって",
