    "waitTime": 1500
  },
  {
    "id": 2002015110150,
    "speaker": "灯織",
    "text": "私、結構気に入ってるんですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015110160,
    "speaker": "灯織",
    "text": "学校に行っているだけでは絶対に歩かないような場所を\r\nこうして仕事終わりに歩けたり",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110160"
  },
  {
    "id": 2002015110170,
    "speaker": "灯織",
    "text": "仕事があってもなくても\r\n事務所に寄って誰かと話をしたり",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110170"
  },
  {
    "id": 2002015110180,
    "speaker": "灯織",
    "text": "今日のおやつはなんだろうねって話をしたり\r\nおやつを一緒に食べたり",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110180"
  },
  {
    "id": 2002015110190,
    "speaker": "灯織",
    "text": "今日は寒いねとか\r\n雪が降りそうだよねとか",
    "charAnim1": "surp1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 1000
  },
  {
    "id": 2002015110200,
    "speaker": "灯織",
    "text": "朝布団から出られないとか\r\nそういう、他愛もない話をただするだけなんですけど",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201511/2002015110200"
  },
  {
    "id": 2002015110210,
    "speaker": "灯織",
    "text": "学校に行っているだけじゃ、\r\n絶対になかった繋がりなんです",
    "charAnim1": "sad2",
