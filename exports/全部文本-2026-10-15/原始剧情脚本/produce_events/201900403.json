    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030050"
  },
  {
    "id": 2019004030060,
    "speaker": "愛依",
    "text": "今度文化祭があってさ～\r\nうちら、お化け屋敷やんだよね～",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……それでか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030070,
    "speaker": "愛依",
    "text": "いや～……それにしても\r\nふ……アハハ……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
