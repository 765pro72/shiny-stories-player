    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺だって、お化け屋敷で『来る』って覚悟してたら\r\nあそこまでは驚かないぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030110,
    "speaker": "愛依",
    "text": "え～！　本当に～？",
