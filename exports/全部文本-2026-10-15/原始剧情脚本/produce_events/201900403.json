    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……愛依、待ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030100,
    "speaker": "愛依",
    "text": "え？　何なに～？",
