  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030090,
    "speaker": "愛依",
    "text": "お客さんがみんなあれくらいリアクションしてくれたら\r\nサイコーなんだけどな～",
