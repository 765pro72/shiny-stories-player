    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030070"
  },
  {
    "id": 2019004030080,
    "speaker": "愛依",
    "text": "さっきのプロデューサーの反応、よすぎたわ～\r\nマジ気持ちよかった！",
