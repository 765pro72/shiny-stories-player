    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030110"
  },
  {
    "id": 2019004030120,
    "speaker": "愛依",
    "text": "……あ、じゃあさ！\r\nそれ、文化祭に来て証明してみてよ！",
