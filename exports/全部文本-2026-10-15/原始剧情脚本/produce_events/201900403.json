  },
  {
    "speaker": "プロデューサー",
    "text": "な、なんだ、今のは？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030040,
    "speaker": "愛依",
    "text": "へ？　驚かしただけだけど？",
