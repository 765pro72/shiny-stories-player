    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし！　いいだろう！　望むところだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004030140,
    "speaker": "愛依",
    "text": "勝負勝負～♪\r\nんじゃ、文化祭来んの、約束ね！",
