    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900403/2019004030120"
  },
  {
    "id": 2019004030130,
    "speaker": "愛依",
    "text": "うち、本番でもプロデューサーのこと\r\n絶対驚かしてみせるし！",
