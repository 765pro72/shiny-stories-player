  {
    "speaker": "プロデューサー",
    "text": "──これがこの間撮影した\r\n夏葉の練習風景の動画",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "つい１時間前くらいに公開されたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013003030050,
    "speaker": "夏葉",
    "text": "……ツイスタに心配のメッセージが\r\nたくさん来ていたのは、これのせいね",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "013",
