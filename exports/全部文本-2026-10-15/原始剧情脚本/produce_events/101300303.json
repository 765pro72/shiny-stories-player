      "time": 100
    },
    "voice": "produce_events/101300303/1013003030050"
  },
  {
    "id": 1013003030060,
    "speaker": "夏葉",
    "text": "『一生懸命な姿を応援したくなった』って\r\n言ってくれていた人もいたけれど……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300303/1013003030060"
  },
  {
    "id": 1013003030070,
    "speaker": "夏葉",
    "text": "ナレーションと編集の仕方で\r\nなんだかすごく辛そうに見えるじゃない？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300303/1013003030070"
  },
  {
    "id": 1013003030080,
    "speaker": "夏葉",
    "text": "……私は全然、そんなことないのに",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300303/1013003030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏葉自身はそう思っているんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013003030090,
    "speaker": "夏葉",
    "text": "え……？",
    "charAnim1": "wait4",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300303/1013003030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ひとりで練習してる夏葉、一生懸命だけど……\r\n一生懸命だからこそ、必死で辛そうに見えるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013003030100,
    "speaker": "夏葉",
    "text": "……さっきの動画みたいに？",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300303/1013003030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、\r\n練習動画、もう一回見直すか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013003030110,
    "speaker": "夏葉",
    "text": "──ええ、お願い",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
