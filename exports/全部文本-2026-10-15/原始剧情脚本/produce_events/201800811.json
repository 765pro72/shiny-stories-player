    "textFrame": "002"
  },
  {
    "id": 2018008110090,
    "speaker": "冬優子",
    "text": "普段から人気ってわけでもないのに今日に限って、よ\r\nおかげでもう一軒余計に寄るはめになったわ",
    "charAnim1": "smile1",
