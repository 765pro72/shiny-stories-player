    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020010"
  },
  {
    "id": 3002023020020,
    "speaker": "めぐる",
    "text": "だね\r\n真乃と灯織とアフタヌーンティー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020020"
  },
  {
    "id": 3002023020030,
    "speaker": "真乃",
    "text": "お洋服も、ふわふわしてて\r\nケーキみたい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020030"
  },
  {
    "id": 3002023020040,
    "speaker": "灯織",
    "text": "うん、お菓子も綺麗で可愛くて\r\n紅茶も美味しい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020040"
  },
  {
    "textFrame": "off",
    "se": "0326",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 3002023020050,
    "speaker": "めぐる",
    "text": "次はどれにしようかなー\r\nスコーン……いったんしょっぱいものを挟む……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020050"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3002023020060,
    "speaker": "めぐる",
    "text": "そうだ……！",
    "textCtrl": "p",
