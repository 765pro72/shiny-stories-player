    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020160"
  },
  {
    "id": 3002023020170,
    "speaker": "灯織",
    "text": "……それじゃあ、少しだけ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020170"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3002023020180,
    "speaker": "灯織",
    "text": "────えっと……\r\nめぐるさん、こちらの焼き菓子が私のおすすめですわ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020180"
  },
  {
    "textFrame": "off",
    "se": "0328",
