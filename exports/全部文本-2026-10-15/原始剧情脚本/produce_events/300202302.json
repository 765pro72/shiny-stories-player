  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3002023020070,
    "speaker": "めぐる",
    "text": "おほほ、灯織さん\r\nおすすめのお菓子はどれかしら？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020070"
  },
  {
    "id": 3002023020080,
    "speaker": "灯織",
    "text": "ふふっ……めぐる、何その言葉遣い",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020080"
  },
  {
    "id": 3002023020090,
    "speaker": "真乃",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020090"
  },
  {
    "id": 3002023020100,
    "speaker": "めぐる",
    "text": "お洋服が可愛くてお嬢様っぽいから、\r\nなりきってみた！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020100"
  },
  {
    "id": 3002023020110,
    "speaker": "灯織",
    "text": "……確かに、こういう素敵なドレスと一緒に\r\nアフタヌーンティーを楽しむことが多いって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020110"
  },
  {
    "id": 3002023020120,
    "speaker": "灯織",
    "text": "デザイナーさんが言ってたもんね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020120"
  },
  {
    "id": 3002023020130,
    "speaker": "真乃",
    "text": "うん……『コミュニケーションの場』として\r\nお菓子とお茶を楽しむんだったよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020130"
  },
  {
    "id": 3002023020140,
    "speaker": "灯織",
    "text": "だとすると、さっきは反射でツッコんじゃったけど、\r\nめぐるの行動は理にかなっていたのかも……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020140"
  },
  {
    "id": 3002023020150,
    "speaker": "めぐる",
    "text": "えへへっ！\r\nではでは、改めて……──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300202302/3002023020150"
  },
  {
    "textFrame": "off",
    "se": "2314",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3002023020160,
    "speaker": "めぐる",
    "text": "灯織さんのおすすめ、教えてくださる？",
