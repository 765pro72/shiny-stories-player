  },
  {
    "speaker": "プロデューサー",
    "text": "と、ときめくってどういう……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007004030100,
    "speaker": "結華",
    "text": "いやぁほら、こういうのってさ、巷じゃ\r\n憧れのシチュエーション、なんて呼ばれたりするじゃん？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700403/2007004030100"
  },
  {
    "id": 2007004030110,
    "speaker": "結華",
    "text": "三峰的にどんな感じか、そしてされた側はどう思うのか、\r\n体験してみたくって",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700403/2007004030110"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLabel": "yuika",
