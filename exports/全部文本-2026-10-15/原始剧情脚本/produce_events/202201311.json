    "voice": "produce_events/202201311/2022013110020"
  },
  {
    "id": 2022013110030,
    "speaker": "小糸",
    "text": "な、なんでしょうか……？",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、身構えるような内容じゃないから安心してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "まずはこれ、家主さんからの手紙\r\n小糸宛に届いたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022013110040,
    "speaker": "小糸",
    "text": "ぴぇ……！？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110040"
  },
  {
    "id": 2022013110050,
    "speaker": "小糸",
    "text": "……あ、あの、ここで読んでもいいですか……？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022013110060,
