  },
  {
    "speaker": "プロデューサー",
    "text": "あ、おはよう。ちょうどよかった\r\nこの間撮影した広告の件で伝えたいことがあるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022013110020,
    "speaker": "小糸",
    "text": "……！",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
