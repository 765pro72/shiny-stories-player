    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110230"
  },
  {
    "id": 2022013110240,
    "speaker": "小糸",
    "text": "（思い出もたくさんあって、\r\n一緒にいて落ち着くし……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110240"
  },
  {
    "id": 2022013110250,
    "speaker": "小糸",
    "text": "（それと──）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110250"
  },
  {
    "id": 2022013110260,
    "speaker": "小糸",
    "text": "（何かあったとき、\r\n大丈夫だよって迎えてくれる……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201311/2022013110260"
