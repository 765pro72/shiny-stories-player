    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500404/2015004040030"
  },
  {
    "id": 2015004040040,
    "speaker": "甜花",
    "text": "そ、それに……\r\nここ、落ち着くから……",
