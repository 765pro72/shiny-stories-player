    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100303/1021003030050"
  },
  {
    "id": 1021003030060,
    "speaker": "円香",
    "text": "でも、あなたがまったく気が付かないので",
