  {
    "speaker": "プロデューサー",
    "text": "一通一通、結構分厚いな……\r\n小糸、一体何枚書いたんだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022002020040,
    "speaker": "小糸",
    "text": "え、えっと…………\r\nす、すみません",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
