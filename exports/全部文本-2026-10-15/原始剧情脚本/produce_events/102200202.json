    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200202/1022002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "この後郵便局に行くから\r\nその時に持っていくな",
