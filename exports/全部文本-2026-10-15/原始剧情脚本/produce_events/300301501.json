  },
  {
    "id": 3003015010370,
    "speaker": "めぐる",
    "text": "んー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010370"
  },
  {
    "id": 3003015010380,
    "speaker": "灯織",
    "text": "『わー！　って感じじゃなくていい』とは言ってたけど\r\nこれでいいの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010380"
  },
  {
    "id": 3003015010390,
    "speaker": "灯織",
    "text": "遊びたいんだと思ってたんだけど\r\n遊ぶのとはちょっと違うでしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010390"
  },
  {
    "id": 3003015010400,
    "speaker": "めぐる",
    "text": "いいのいいの！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010400"
  },
  {
    "id": 3003015010410,
    "speaker": "めぐる",
    "text": "何をするかじゃなくて\r\n誰といるかが大事なの！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010410"
  },
  {
    "id": 3003015010420,
    "speaker": "めぐる",
    "text": "だから、これで正解！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010420"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3003015010430,
    "speaker": "めぐる",
    "text": "……あ、ごめん\r\nもしかして困らせちゃった……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010430"
  },
  {
    "id": 3003015010440,
    "speaker": "めぐる",
    "text": "っていうか、困らせてるよね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010440"
  },
  {
    "id": 3003015010450,
    "speaker": "めぐる",
    "text": "わたしが突っ走っちゃったから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010450"
  },
  {
    "id": 3003015010460,
    "speaker": "灯織",
    "text": "──もう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010460"
  },
  {
    "id": 3003015010470,
    "speaker": "灯織",
    "text": "私の性格知ってるでしょ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010470"
  },
  {
    "id": 3003015010480,
    "speaker": "灯織",
    "text": "嫌だったらすぐ口に出てるし\r\nそもそもめぐるにここのこと教えないよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010480"
  },
  {
    "id": 3003015010490,
    "speaker": "めぐる",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301501/3003015010490"
  },
