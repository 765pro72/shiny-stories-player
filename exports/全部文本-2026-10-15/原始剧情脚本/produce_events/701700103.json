    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701700103/7017001030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おめでとう、通過してたぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7017001030030,
    "speaker": "あさひ",
    "text": "やったっす～！",
