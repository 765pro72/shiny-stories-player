    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300702/2013007020060"
  },
  {
    "id": 2013007020070,
    "speaker": "夏葉",
    "text": "まさかそんなこと言われるなんて\r\n思わないじゃない……！",
