    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300702/2013007020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……でも珍しいな\r\n夏葉がそんなふうに言うなんて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007020060,
    "speaker": "夏葉",
