  {
    "speaker": "プロデューサー",
    "text": "摩美々、そろそろ出るけど\r\n準備できてるか？",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "1278"
  },
  {
    "id": 2005017110010,
    "speaker": "摩美々",
    "text": "はいー、\r\nぼちぼちー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110010"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく動く気配がないんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110020,
    "speaker": "摩美々",
    "text": "まぁ、オフがいいのでー",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040050100",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200501711/2005017110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "結局、摩美々をオンにするには\r\nどうすればいいんだ？",
    "charAnim2": "face_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110030,
    "speaker": "摩美々",
    "text": "言ったじゃないですかぁ\r\nそんなスイッチはないですー",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110030"
  },
  {
    "id": 2005017110040,
    "speaker": "摩美々",
    "text": "とゆーわけで、\r\nおやすみなさぁい",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110040"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "mamimi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
