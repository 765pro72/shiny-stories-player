    "waitTime": 1500,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "わかった……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、横になったままでいいから\r\n仕事の説明をさせてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "1588",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "今日はラジオの収録だ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "番組内では毎回テーマがあって、そのテーマに沿って\r\nトークをすることになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110050,
    "speaker": "摩美々",
    "text": "テーマって、\r\nなんでしたっけー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええと……今日は確か──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00413",
    "bgEffect": "fade",
    "se": "1940",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "『日頃お世話になっている人のあんなことやこんなこと』\r\nだな──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110060,
    "speaker": "摩美々",
    "text": "日頃お世話になってる人……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "身近な人のおもしろエピソードについて\r\nリスナーからのメールを読んだり──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々自身もいくつか話してもらうことになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00224",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2005017110070,
    "speaker": "摩美々",
    "text": "あんなことや、こんなことー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういう話、ありそうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110080,
    "speaker": "摩美々",
    "text": "まぁ、そうですねー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110080"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "se": "1461",
    "waitType": "time",
    "waitTime": 1800,
    "bgEffectTime": 1000
  },
  {
    "id": 2005017110090,
    "speaker": "摩美々",
    "text": "例えばですケドー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200501711/2005017110090"
  },
  {
    "id": 2005017110100,
    "speaker": "摩美々",
    "text": "誰かさんが料理に塩と間違えて\r\n砂糖をかけちゃったりー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110100"
  },
  {
    "id": 2005017110110,
    "speaker": "摩美々",
    "text": "洗顔フォームと間違えて\r\n歯磨き粉で顔を洗っちゃったり",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110110"
  },
  {
    "id": 2005017110120,
    "speaker": "摩美々",
    "text": "そういうのでいいんですかねー",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501711/2005017110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ、そうだな……\r\n全部心当たりがあるんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "というか、あれは摩美々が仕掛けたんだろう……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005017110130,
    "speaker": "摩美々",
    "text": "ふふー\r\nそうでしたっけー？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
