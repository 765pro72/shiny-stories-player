    "textFrame": "002"
  },
  {
    "id": 6007004010020,
    "speaker": "結華",
    "text": "あったかくてさ、いつも応援してくれて",
    "charAnim1": "wait1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
