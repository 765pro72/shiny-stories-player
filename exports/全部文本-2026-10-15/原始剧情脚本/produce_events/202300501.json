  {
    "speaker": "プロデューサー",
    "text": "……お疲れ、雛菜\r\n急に思い立ってやったにしては、盛り上がったな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "見てくれてる人も多かったし、\r\n新しくフォローしてくれた人もいたみたいだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "質問とかリクエストのコメントもあって……\r\nそういうの、また応えていけるといいよな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005010230,
    "speaker": "雛菜",
    "text": "うん～、そうだね～！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
