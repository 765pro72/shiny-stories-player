  {
    "id": 2023005010120,
    "speaker": "雛菜",
    "text": "ここがリビング～！\r\nここでおやつ食べたり～、打ち合わせしたりします～",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
