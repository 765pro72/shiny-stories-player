  {
    "id": 2023005010050,
    "speaker": "雛菜",
    "text": "やは～、はじまった～？\r\n雛菜だよ～、見えてる～？",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
