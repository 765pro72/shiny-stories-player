  },
  {
    "id": 2023005010090,
    "speaker": "コメント",
    "text": "『こんな所映して大丈夫？　雛菜怒られない？』",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
