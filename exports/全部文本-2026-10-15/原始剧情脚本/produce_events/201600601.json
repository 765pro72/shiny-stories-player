    "voice": "produce_events/201600601/2016006010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "この後、何か食べに行かないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016006010030,
    "speaker": "千雪",
    "text": "えっ──",
