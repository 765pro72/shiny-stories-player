  {
    "speaker": "プロデューサー",
    "text": "今日、これから時間はあるか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016006010020,
    "speaker": "千雪",
    "text": "ええ、私は大丈夫ですが──\r\nどうかされましたか？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
