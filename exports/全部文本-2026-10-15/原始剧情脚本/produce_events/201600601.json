    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……今日、事務所で\r\n千雪のこれからの仕事について考えてたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016006010080,
    "speaker": "千雪",
    "text": "わぁ……ありがとうございます",
