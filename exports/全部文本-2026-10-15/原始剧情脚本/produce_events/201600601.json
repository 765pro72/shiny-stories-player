    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600601/2016006010040"
  },
  {
    "id": 2016006010050,
    "speaker": "千雪",
    "text": "でしたら……是非ご一緒させてください",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600601/2016006010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、ありがとう\r\nそれじゃあ急ぎの仕事、早く終わらせるよ",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまん、少しだけ待っててもらえるかな",
