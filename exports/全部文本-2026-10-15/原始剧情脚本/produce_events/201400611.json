  {
    "id": 2014006110290,
    "speaker": "甘奈",
    "text": "『未来の自分へ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110290"
  },
  {
    "id": 2014006110300,
    "speaker": "甘奈",
    "text": "『アイドルとして、しっかり輝けていますか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110300"
  },
  {
    "id": 2014006110310,
    "speaker": "甘奈",
    "text": "『ファンのみんなを、今よりもっと笑顔にできていますか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110310"
  },
  {
    "id": 2014006110320,
    "speaker": "甘奈",
    "text": "『そして』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110320"
  },
  {
    "id": 2014006110330,
    "speaker": "甘奈",
    "text": "『甘奈の大切な人は』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110330"
  },
  {
    "id": 2014006110340,
    "speaker": "甘奈",
    "text": "『今と変わらない素敵な笑顔で、笑っていますか？』",
