  },
  {
    "id": 2014006110190,
    "speaker": "甘奈",
    "text": "よし、こんな感じかな",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、キリがいいみたいだな\r\nじゃあちょっと早いけど、移動するか？",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014006110200,
    "speaker": "甘奈",
    "text": "うん！　そうしよ！",
    "charAnim1": "anger3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110200"
  },
  {
    "id": 2014006110210,
    "speaker": "甘奈",
    "text": "……",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_surp_s",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈、どうかしたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014006110220,
    "speaker": "甘奈",
    "text": "……ねぇ、プロデューサーさん\r\nお手紙書いてて思ったんだけどね……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110220"
  },
  {
    "id": 2014006110230,
    "speaker": "甘奈",
    "text": "将来の甘奈は……",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "off",
    "voice": "produce_events/201400611/2014006110230"
  },
  {
    "id": 2014006110240,
    "speaker": "甘奈",
    "text": "今の甘奈の願いを叶えてくれるかな？",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110240"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、絶対に大丈夫だ",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "020"
  },
  {
    "id": 2014006110250,
    "speaker": "甘奈",
    "text": "そうかな……？",
    "charAnim1": "sad2",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。だって甘奈は、\r\n昔の甘奈のお願いを立派に叶えたじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だったら未来の甘奈だって大丈夫だ",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp_s",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014006110260,
    "speaker": "甘奈",
    "text": "そっか……そうだよね……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110260"
  },
  {
    "id": 2014006110270,
    "speaker": "甘奈",
    "text": "それに、甘奈には……",
    "charAnim1": "surp1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400611/2014006110270"
  },
  {
    "id": 2014006110280,
    "speaker": "甘奈",
    "text": "プロデューサーさんがついてくれてるもんね☆",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
