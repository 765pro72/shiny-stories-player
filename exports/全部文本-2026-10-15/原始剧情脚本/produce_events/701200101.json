  },
  {
    "id": 7012001010010,
    "speaker": "凛世",
    "text": "はい……",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010010"
  },
  {
    "id": 7012001010020,
    "speaker": "凛世",
    "text": "プロデューサーさまの\r\nご鞭撻の賜物で、ございます……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "何を言うんだ\r\n凛世が頑張ってくれたからこそだ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7012001010030,
    "speaker": "凛世",
    "text": "そう、なのでしょうか……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうに決まっているだろ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "毎日、真剣にレッスンをこなしている姿\r\n俺はちゃんと見ていたからな",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからこの結果は、\r\n凛世の努力の賜物だよ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7012001010040,
    "speaker": "凛世",
    "text": "プロデューサーさまが、\r\nそう、おっしゃるのでしたら……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、だからもっと喜んでいいんだぞ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "よくやったな、凛世\r\nこの調子でどんどん進んでいこう",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7012001010050,
    "speaker": "凛世",
    "text": "はい、貴方さまが、\r\nお傍にいてくださるなら……",
    "charAnim1": "smile3",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010050"
  },
  {
    "id": 7012001010060,
    "speaker": "凛世",
    "text": "……ふふ",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうしたんだ……？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7012001010070,
    "speaker": "凛世",
    "text": "いえ……\r\nプロデューサーさまに、喜んで頂けたのが……",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010070"
  },
  {
    "id": 7012001010080,
    "speaker": "凛世",
    "text": "凛世には、嬉しかったのでございます……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃ、喜ぶに決まっているだろ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7012001010090,
    "speaker": "凛世",
    "text": "ありがたく、存じます……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010090"
  },
  {
    "id": 7012001010100,
    "speaker": "凛世",
    "text": "これからも、ご期待に応えられるよう……\r\n努力してまいります",
    "charAnim1": "smile3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701200101/7012001010100"
  },
  {
    "id": 7012001010110,
    "speaker": "凛世",
    "text": "プロデューサーさま\r\nどうか、末永く……お傍に置いてくださいませ",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
