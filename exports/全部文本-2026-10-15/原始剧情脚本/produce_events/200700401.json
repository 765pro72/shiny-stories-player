  {
    "id": 2007004010010,
    "speaker": "結華",
    "text": "あれ、プロデューサーからだ",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
