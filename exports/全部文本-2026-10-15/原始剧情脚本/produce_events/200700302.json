[
  {
    "speaker": "プロデューサー",
    "text": "（……お、結華だ。自主練中かな？）",
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "007",
    "charPosition": {
