      "y": 640,
      "order": 0
    },
    "bg": "00014",
    "bgm": "001",
    "charCategory": "stand_jersey"
  },
  {
    "speaker": "プロデューサー",
    "text": "結華、お疲れ様",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020010,
    "speaker": "結華",
    "text": "……ふんふーん……♪",
    "charAnim1": "wait1",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020010"
  },
  {
    "speaker": "プロデューサー",
    "text": "？　結華ー",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（気づかないな、どうしたんだ……？）",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……結華？　おーい",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020020,
    "speaker": "結華",
    "text": "……えっ、プロデューサー！？　ビックリした……！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020020"
  },
  {
    "id": 2007003020030,
    "speaker": "結華",
    "text": "なになに、急にどうしたの？　何か用事だった？\r\nごめん、全然聞こえてなくて……",
    "charAnim1": "surp1",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ悪い、音楽聴いてたのか。こっちこそ邪魔しちゃったな\r\n特に用事はないんだけど、姿が見えたから",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020040,
    "speaker": "結華",
    "text": "なら良かった",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020040"
  },
  {
    "id": 2007003020050,
    "speaker": "結華",
    "text": "サボってないかって、\r\n抜き打ちチェックでもしに来たのかと思っちゃったよ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そんなんじゃないよ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……お。そこにあるの、今聴いてたCDか？\r\nそのアイドル、好きだって言ってたもんな",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020060,
    "speaker": "結華",
    "text": "え？　あ、うん……今日発売だったから、聴きたくて",
    "charAnim1": "shy2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020060"
  },
  {
    "id": 2007003020070,
    "speaker": "結華",
    "text": "まぁこの話はいいでしょ",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、せっかくだから、結華の好きなアイドルの話を\r\n聞かせてくれないか",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020080,
    "speaker": "結華",
    "text": "あはは……プロデューサー、別に気を遣わなくていいよ",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020080"
  },
  {
    "id": 2007003020090,
    "speaker": "結華",
    "text": "三峰の好きなものの話聞いても、\r\n別に面白くもないだろうしさ",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020090"
  },
  {
    "select": "そんなことないぞ",
    "nextLabel": "1"
  },
  {
    "select": "プロデューサーとして\r\n知っておきたい",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "他のアイドルのことも\r\n知っておかないと",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "誰かが一生懸命になってるものや、\r\n好きなものの話を聞いて、面白くないとは思わない",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020100,
    "speaker": "結華",
    "text": "直球だなぁ\r\nそんな真正面から来られたら逆に話しづらいってば",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、すまん……",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020110,
    "speaker": "結華",
    "text": "……でも、さっきみたいに言ってもらえたら\r\n嬉しくなっちゃうってこともあるかも",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020120,
    "speaker": "結華",
    "text": "あ、三峰がじゃなくて、世間一般的な話ね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020120"
  },
  {
    "id": 2007003020130,
    "speaker": "結華",
    "text": "……さてさて、勤勉な三峰は、\r\nそろそろレッスンに戻ろっと！",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだか邪魔しちゃって悪かったな。頑張れよ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020140,
    "speaker": "結華",
    "text": "うん！",
    "charAnim1": "smile2",
    "charAnim2": "yes",
    "charLipAnim": "lip_smile",
    "charAnim2Loop": false,
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020140"
  },
  {
    "id": 2007003020150,
    "speaker": "結華",
    "text": "……ありがとね",
    "charAnim1": "shy2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "何がだ？",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020160,
    "speaker": "結華",
    "text": "いやいや、なんでもないよ",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200700302/2007003020160"
  },
  {
    "id": 2007003020170,
    "label": "2",
    "speaker": "結華",
    "text": "あー、他のアイドルのことが気になるんだね？\r\nほんと仕事熱心だなぁ、プロデューサーは",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうじゃなくてさ。担当アイドルのことを\r\nちゃんと知っておきたいと思ったんだ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "結華が本当に嫌なら、無理にとは言わないけど……",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020180,
    "speaker": "結華",
    "text": "…………！",
    "charAnim1": "shy2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020180"
  },
  {
    "id": 2007003020190,
    "speaker": "結華",
    "text": "……ふむ。プロデューサーにそこまで言われたら、\r\n話さないのもアイドルが廃るね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020190"
  },
  {
    "id": 2007003020200,
    "speaker": "結華",
    "text": "──Ｐたん、三峰のことが知りたいというその言葉、\r\n二言はないかな！？",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ない！",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020210,
    "speaker": "結華",
    "text": "よっしわかった！\r\nじゃ、さっきのCD、聴いてみる？",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいのか？",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020220,
    "speaker": "結華",
    "text": "その方がよくわかるでしょ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、ありがとう",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020230,
    "speaker": "結華",
    "text": "いいっていいって……その代わり、\r\n現役アイドルプロデューサーの感想、しっかり聞かせてね！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200700302/2007003020230"
  },
  {
    "id": 2007003020240,
    "label": "3",
    "speaker": "結華",
    "text": "あは、Ｐたんは仕事の鬼だね～\r\nそんなんじゃ、せっかく立ったフラグも折れちゃうよ？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020240"
  },
  {
    "id": 2007003020250,
    "speaker": "結華",
    "text": "こういう時はさ、嘘でも、\r\n君の好きなものを知りたいんだ、って言っとかないと",
    "charAnim1": "wait2",
    "charAnim2": "no",
    "charLipAnim": "lip_smile",
    "charAnim2Loop": false,
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうなのか",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020260,
    "speaker": "結華",
    "text": "そうなのです。……乙女心は案外繊細だよ～？\r\n三峰は大丈夫でも、他の子たち相手じゃまずいかも",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020260"
  },
  {
    "id": 2007003020270,
    "speaker": "結華",
    "text": "ということで、今のシーン、リテイクいってみる？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020270"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、いや、その。もちろん、結華の好きなものを\r\n知っておきたいとも思ってる、んだけど……",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020280,
    "speaker": "結華",
    "text": "あはは！　慌ててる慌ててる！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020280"
  },
  {
    "id": 2007003020290,
    "speaker": "結華",
    "text": "うそうそ。プロデューサーは真面目でこそ\r\nプロデューサーなんだから、今のままでいいよ",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020290"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020300,
    "speaker": "結華",
    "text": "Ｐたんがわたわたしてるとこ見れて、\r\n個人的にはだいぶ満足したし！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020300"
  },
  {
    "speaker": "プロデューサー",
    "text": "あんまりからかわないでくれ……",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003020310,
    "speaker": "結華",
    "text": "ごめんごめん、楽しくってつい",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020310"
  },
  {
    "id": 2007003020320,
    "speaker": "結華",
    "text": "お詫びって言ったらなんだけど、\r\n三峰が好きなアイドルのこと、教えるからさ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700302/2007003020320"
  },
  {
    "id": 2007003020330,
    "speaker": "結華",
    "text": "それでトントンってことにしてよ。ね？",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200700302/2007003020330"
  },
  {
    "label": "end"
  }
]