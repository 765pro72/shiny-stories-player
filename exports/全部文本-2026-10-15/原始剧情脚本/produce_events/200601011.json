    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006010110110,
    "speaker": "咲耶",
    "text": "そして昼前のまだかろうじてみずみずしい光の中へ\r\n柔軟剤の香る真っ白なタオルを干し",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110110"
  },
  {
    "id": 2006010110120,
    "speaker": "咲耶",
    "text": "一息つく前に\r\nお気に入りの茶葉を踊らせる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110120"
  },
  {
    "textFrame": "off",
    "bg": "00114",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、そういうの\r\n魔法っぽいじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110130,
    "speaker": "咲耶",
