    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ……ていっても──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110030,
    "speaker": "咲耶",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110030"
  },
  {
    "textFrame": "off",
    "bg": "00086",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ここのところ立て込んでたから、\r\n洗濯とか掃除からスタートなんだよなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0117",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2006010110040,
    "speaker": "咲耶",
    "text": "……フフッ\r\n掃除から始まるなんて、素敵な一日じゃないか",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601011/2006010110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、そういう考え方もあるか……\r\nでも俺はやっぱり、面倒の方が勝つなぁ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110050,
    "speaker": "咲耶",
    "text": "クス……ああ\r\n本当のところ、私も同じさ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110050"
  },
  {
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0243",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110060,
    "speaker": "咲耶",
    "text": "掃除や洗濯は面倒──\r\n魔法のように、一瞬で片付けばどんなにいいだろう",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601011/2006010110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "おおっ\r\n咲耶でもそう思うか！",
    "charAnim2": "face_sad",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110070,
    "speaker": "咲耶",
    "text": "『でも』とはなんだい？",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0220",
    "voice": "produce_events/200601011/2006010110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、咲耶はさ\r\n本当に魔法みたいに全部やっちゃうんじゃないかって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110080,
    "speaker": "咲耶",
    "text": "そんな都合のいい能力は持ち合わせていないな",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、すまんすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "textFrame": "off",
