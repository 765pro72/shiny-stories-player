  },
  {
    "id": 2006010110090,
    "speaker": "咲耶",
    "text": "優雅に洗濯機を回し、\r\n洗い上がりを待ちながらクリーナーでもかけて──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110090"
  },
  {
    "id": 2006010110100,
    "speaker": "咲耶",
    "text": "脱水が始まる頃に、\r\n紅茶のための湯を沸かす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110100"
  },
  {
    "textFrame": "off",
    "bg": "00151",
