  {
    "id": 2006010110140,
    "speaker": "咲耶",
    "text": "起き抜けにうっかり\r\n文庫本などへ手をのばしてしまうと一大事──",
    "charAnim1": "wait5",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
