    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601011/2006010110140"
  },
  {
    "id": 2006010110150,
    "speaker": "咲耶",
    "text": "誰かにうるさく言ってもらわないかぎり\r\nそのまま一日が終わってしまいかねないのさ",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601011/2006010110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ……それはよくわかるよ\r\n俺も誰かにうるさくされないと、そのまま一日が消える！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110160,
    "speaker": "咲耶",
    "text": "難儀だね\r\n明日は互いに、よい休日にしようじゃないか",
