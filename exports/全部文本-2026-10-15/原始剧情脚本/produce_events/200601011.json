  {
    "speaker": "プロデューサー",
    "text": "──じゃあ、明日はよく休んでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006010110010,
    "speaker": "咲耶",
    "text": "了解、プロデューサー\r\nアナタこそ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
