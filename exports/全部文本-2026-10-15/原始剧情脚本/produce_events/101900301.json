  {
    "speaker": "プロデューサー",
    "text": "──もしもし、愛依か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010070,
    "speaker": "愛依",
    "text": "『うん、プロデューサー！\r\n電話くれてたのにごめん！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、いいんだ\r\nメッセージも送っておいたんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010080,
    "speaker": "愛依",
    "text": "『見たよ！\r\n『G.R.A.D.』のことっしょ？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そろそろオファー、受けるかどうか\r\n返事をしなくちゃと思ってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……よく、考えてくれたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010090,
    "speaker": "愛依",
    "text": "『そんなん、出るに決まってるっしょ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010100,
    "speaker": "愛依",
    "text": "『でも、今回はストレイライトとしてじゃなくて\r\n完全にひとりなんだもんね！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010100"
  },
  {
    "id": 1019003010110,
    "speaker": "愛依",
    "text": "『いつもより、\r\n気合い入れていかないとだよね……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！\r\nだけど愛依ならきっと大丈夫だ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "頑張ろうな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010120,
    "speaker": "愛依",
    "text": "『うん、そだね！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010120"
  },
  {
    "id": 1019003010130,
    "speaker": "愛依",
    "text": "『頑張らないと──…………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……愛依？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "何か不安なことがあれば\r\nなんでも言ってくれていいんだぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010140,
    "speaker": "愛依",
    "text": "『あー、ううん\r\n全然、そういうんじゃないんだけど』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010140"
  },
  {
    "id": 1019003010150,
    "speaker": "愛依",
    "text": "『なんかうち、アイドルになってから\r\nずっと競争してるなーって思って』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003010160,
    "speaker": "愛依",
    "text": "『……あ、ううん！\r\nなんでもない！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010160"
  },
  {
    "id": 1019003010170,
    "speaker": "愛依",
    "text": "『けど、出るからには優勝しないとだよね！\r\nプロデューサー！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010170"
  },
  {
    "id": 1019003010180,
    "speaker": "愛依",
    "text": "『うち、頑張るから！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900301/1019003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
