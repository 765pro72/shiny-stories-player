  },
  {
    "speaker": "プロデューサー",
    "text": "……どこに連絡しようとしてるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005002010060,
    "speaker": "摩美々",
    "text": "プロデューサーの若気の至り、\r\nみんなに教えてあげようかなぁってー",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
