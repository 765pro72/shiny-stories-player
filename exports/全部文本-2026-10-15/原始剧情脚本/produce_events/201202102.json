    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "こんな感じで質問が書いてあるから、回答を記入してほしい\r\n答えにくい質問があったら、遠慮なく相談してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
