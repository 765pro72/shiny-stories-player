    "waitTime": 2500
  },
  {
    "id": 1023004050120,
    "speaker": "雛菜",
    "text": "考えたんだけど、アイドルじゃなくなったらとか\r\n将来やりたいことって、あんまり無いかも",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
