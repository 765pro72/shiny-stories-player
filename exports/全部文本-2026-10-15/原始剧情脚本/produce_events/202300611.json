  {
    "id": 2023006110030,
    "speaker": "雛菜",
    "text": "じゃ～ん！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
