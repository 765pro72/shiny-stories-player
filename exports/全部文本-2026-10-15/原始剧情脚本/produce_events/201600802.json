    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600802/2016008020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、初めて見たよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ちなみに、味はちゃんと\r\nレモネードなのか……？",
