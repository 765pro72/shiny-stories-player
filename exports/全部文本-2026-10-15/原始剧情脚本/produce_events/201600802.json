    "voice": "produce_events/201600802/2016008020050"
  },
  {
    "id": 2016008020060,
    "speaker": "千雪",
    "text": "綺麗だし飲みたくなって\r\n買っちゃいました",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600802/2016008020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "へえ……！\r\nそんなものがあるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016008020070,
    "speaker": "千雪",
    "text": "はい\r\n青と黄色のグラデーションなんて、珍しいですよね",
