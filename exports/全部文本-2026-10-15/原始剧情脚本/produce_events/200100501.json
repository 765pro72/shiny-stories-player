  {
    "id": 2001005010030,
    "speaker": "真乃",
    "text": "あれ……？\r\nプロデューサーさん……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……真乃？\r\nこんなところで会うなんて、珍しいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005010040,
    "speaker": "真乃",
    "text": "そ、そうですね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010040"
  },
  {
    "id": 2001005010050,
    "speaker": "真乃",
    "text": "さっき手が当たっちゃったの\r\nプロデューサーさんだったんだ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　今、何か言ったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005010060,
    "speaker": "真乃",
    "text": "あっ……！　い、いえっ\r\nなんでもないです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　何もないならいいけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃も、この雑誌を買いに来たのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005010070,
    "speaker": "真乃",
    "text": "はい、そうなんです\r\n……プロデューサーさんもですか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、貰った見本誌は\r\n事務所で保管しないといけないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかく真乃が記事になってるんだから、\r\n自分用にも欲しくなったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005010080,
    "speaker": "真乃",
    "text": "そ、そうだったんですね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100501/2001005010080"
  },
  {
    "textFrame": "off",
    "effectLabel": "white1",
