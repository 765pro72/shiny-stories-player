  },
  {
    "speaker": "プロデューサー",
    "text": "……灯織",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002011040050,
    "speaker": "灯織",
    "text": "ひゃあ！？",
    "charAnim1": "touch",
    "charAnim2": "face_anger",
