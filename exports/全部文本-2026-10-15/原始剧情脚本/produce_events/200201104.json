  {
    "speaker": "SNSの書き込み",
    "text": "『おまけ、そら『これは……！』ってなるっしょｗ\r\n癪だが思惑通り。灯織ちゃん推さざるをえない。ずりい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002011040040,
    "speaker": "灯織",
    "text": "おまけ……──？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
