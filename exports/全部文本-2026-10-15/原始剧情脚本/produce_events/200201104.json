  {
    "speaker": "SNSの書き込み",
    "text": "『主人公、灯織の役が立てるフラグ全部バキバキに折ってて\r\nめちゃくちゃ笑った　強い　そらまたねされるしまた来る』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『突然のホラー回　灯織ちゃんはまり役だったねー！\r\nあと予告が予告じゃなかった』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織ちゃん全然演技違ってましたねぇ監督？\r\n監督見てます？　予告なんだったんですか？　詐欺では？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0280",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『灯織ちゃんはおまけのほうが素です！！！！！！\r\nああいう子です！！！！　よろしくお願いします！！！！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織ね。覚えた』",
    "textCtrl": "p",
    "textFrame": "003"
  },
