    "waitType": "time",
    "waitTime": 1700
  },
  {
    "id": 2002021020110,
    "speaker": "灯織",
    "text": "『……つまみぐいする人は明日からお弁当ナシだからね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202102/2002021020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ちょっ……それは勘弁！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ごめんって、な？　この通り』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002021020120,
    "speaker": "灯織",
    "text": "『ふふっ……\r\nもう、しょうがないなあ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202102/2002021020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "『毎日作ってくれて本当にありがとう！\r\nだけど、たまにはサボっていいから』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002021020130,
    "speaker": "灯織",
    "text": "『えっ……？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202102/2002021020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "『いつも頑張りすぎなくらいやってくれてるだろ？\r\nたまには『疲れた～』とか言ってほしいんだ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
