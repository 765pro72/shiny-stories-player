  },
  {
    "id": 2002021020140,
    "speaker": "灯織",
    "text": "あ、そうですね\r\nありがとうございました",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
