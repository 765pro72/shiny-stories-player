      "time": 100
    },
    "voice": "produce_events/200202102/2002021020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……今演じてみて少し思ったんだけど、\r\n結婚というか家族って",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "頼ったり、甘えたりはもちろん、心配かけたり、\r\nかけられたりするものなのかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002021020150,
    "speaker": "灯織",
    "text": "心配をかけたり、かけられたり……？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202102/2002021020150"
  },
  {
    "id": 2002021020160,
    "speaker": "灯織",
    "text": "……",
    "charAnim1": "think",
