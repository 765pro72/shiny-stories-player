  {
    "speaker": "子ども",
    "text": "────ぜんぜん飛ばない……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ちょっと難しいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLipAnim": "lip_serious_s",
    "charLabel": "luca",
    "textFrame": "off",
