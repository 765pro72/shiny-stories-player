    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "お……\r\nルカ──────？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2026006110010,
    "speaker": "ルカ",
    "text": "…………",
    "charAnim1": "anger2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務所、行ってたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2026006110020,
    "speaker": "ルカ",
    "text": "悪ぃかよ",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_serious",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、わざわざ来てくれて、ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺もさっきまで事務所にいたんだけど\r\nちょっと外出しようと思ってここを通ったら────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "子ども",
    "text": "ねぇ、凧揚がらないよ～\r\nどうすればいいの～？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_serious_s",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、わかったよ\r\nじゃあ、一緒に飛ばしてみようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "子ども",
    "text": "本当！？\r\nやったー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ルカもどうだ？\r\n一緒に、凧揚げ──────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2026006110030,
    "speaker": "ルカ",
    "text": "────\r\nやるわけねぇだろ",
    "charAnim1": "smile2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110030"
  },
  {
    "id": 2026006110040,
    "speaker": "ルカ",
    "text": "勝手にやってろ",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_serious",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……？\r\nたまにはこういうのも、いいもんだぞ",
    "charLipAnim": "lip_serious_s",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに……\r\nきっと、かっこいいと思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "luca",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00484",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 1200
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "この凧が\r\n高く揚がってるところ──────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2026006110050,
    "speaker": "ルカ",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "────見てみたくないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2026006110060,
    "speaker": "ルカ",
    "text": "──────……\r\nどうでもいい……そんなもん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202600611/2026006110060"
  },
  {
    "textFrame": "off",
    "bg": "00013",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 1200
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ、忙しければ無理にとは言わないけど────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "子ども",
    "text": "ねぇ、早くやってよ～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おう、わかったわかった！　それじゃ行くぞ？\r\nまずは風を見て────どっちから吹いてる？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "子ども",
    "text": "あっちー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\n凧は向かい風に吹かれて高く揚がるから……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "子ども",
    "text": "風が来るほうに走ればいいのー？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、その通りだ\r\nじゃあ、行くぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
