    }
  },
  {
    "id": 1016001050080,
    "speaker": "千雪",
    "text": "みんな～、こんにちは～！\r\nちゆきおねえさんと、ウサちゃんだよ～",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101600105/1016001050080"
  },
  {
    "id": 1016001050090,
    "speaker": "千雪",
    "text": "うーん、すこーし元気がないみたいかな～？\r\nみんな、もう一度！　こんにちは～",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050090",
    "charAnim3Loop": false
  },
  {
    "id": 1016001050100,
    "speaker": "千雪",
    "text": "うんうん、いい笑顔だね～！\r\nウサちゃんも大喜びだよ～",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050100",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "（はは、すごいな……\r\n子どもたちがすっかり夢中になってるぞ！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（千雪……パペットなんて\r\nいつの間に用意してたんだろう……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "chiyuki",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
