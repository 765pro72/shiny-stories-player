      "alpha": 0,
      "time": 240
    }
  },
  {
    "id": 1016001050110,
    "speaker": "千雪",
    "text": "お疲れさまです、プロデューサーさん",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101600105/1016001050110"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪、お疲れさま\r\n撮影、すごく良かったぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、パペットであんな上手に\r\n子どもたちをあやすなんてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050120,
    "speaker": "千雪",
    "text": "ふふ、もしかして何かに使えるかも～って、\r\n昔作ったのを持ってきてたんです",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050120"
  },
  {
    "id": 1016001050130,
    "speaker": "千雪",
    "text": "こんなふうに役に立つなんて……",
    "charAnim1": "surp1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050130"
  },
  {
    "speaker": "プロデューサー",
    "text": "スタッフも親御さんも、みんな千雪に感謝してたな\r\nパペットも、番組で使ってもらえるかもって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪は本当にすごいな……\r\n俺の想像なんか、どんどん超えていく",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050140,
    "speaker": "千雪",
    "text": "そ、そんなに褒められると、\r\n恥ずかしいです～……",
    "charAnim1": "smile1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、べつに大げさなことは言ってないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050150,
    "speaker": "千雪",
    "text": "でも……ちょっとは考えちゃいますよ",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050150",
    "charAnim3Loop": false
  },
  {
    "id": 1016001050160,
    "speaker": "千雪",
    "text": "以前だったら、パペットを持ってても\r\nどうしていいかわからなかったんじゃないかな、って",
    "charAnim1": "smile2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050160"
  },
  {
    "id": 1016001050170,
    "speaker": "千雪",
    "text": "アイドル活動をしてたからこそ\r\nこうして子どもたちとつながれたのかもしれないです……",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうかもしれないな\r\n千雪の今までが全部……今になってるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050180,
    "speaker": "千雪",
    "text": "プロデューサーさん……\r\nもう……ときどき、名言ぽいこと言うんですから",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、名言じゃあないんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、本当に今の千雪は……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "立派なアイドルだな",
    "nextLabel": "1"
  },
  {
    "select": "最高のアイドルだな",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "すごくいい顔しているよ",
    "nextLabel": "3"
  },
  {
    "id": 1016001050190,
    "label": "1",
    "speaker": "千雪",
    "text": "……本当ですか？\r\n私、自分ではあんまりわからないんですよ",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050190",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そういうものかもな……\r\nでも……今日は手ごたえがあったんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050200,
    "speaker": "千雪",
    "text": "……はい。みんな、とっても楽しそうで……\r\nすごーく、心があったかくなりました",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050200",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "うん。それがアイドルってことだと思うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050210,
    "speaker": "千雪",
    "text": "こんな素敵な仕事ができるなんて……\r\n私、本当に幸せ者です",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/101600105/1016001050210"
  },
  {
    "id": 1016001050220,
    "label": "2",
    "speaker": "千雪",
    "text": "えっ……そ、そんな！　急にどうしたんですか\r\nその、私なんてまだまだ新人ですっ",
    "charAnim1": "smile1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050220"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは。カメラに映ってないところでも\r\n最高のパフォーマンスができるかどうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺の中では、それが最高のアイドルの基準かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050230,
    "speaker": "千雪",
    "text": "もう……そんなに褒められたら\r\n照れちゃいますよう……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050230",
    "charAnim3Loop": false
  },
  {
    "id": 1016001050240,
    "speaker": "千雪",
    "text": "でも……今日もとっても勉強になりました\r\nアイドルって、こういうことなのかもしれないって……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050240"
  },
  {
    "id": 1016001050250,
    "speaker": "千雪",
    "text": "ありがとうございます、プロデューサーさん……",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/101600105/1016001050250"
  },
  {
    "id": 1016001050260,
    "label": "3",
    "speaker": "千雪",
    "text": "わ、そんな……見ないでくださいー！",
    "charAnim1": "anger1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050260"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、見てるこっちまで嬉しくなるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050270,
    "speaker": "千雪",
    "text": "……たくさんの笑顔に囲まれたから、\r\n自分もつい幸せな気分になっちゃって……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050270",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nそういう笑顔を増やしていくのが、千雪の仕事だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001050280,
    "speaker": "千雪",
    "text": "プ、プロデューサーさん……\r\nふふっ、もうっ、ほんとに嬉しいです……！",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600105/1016001050280"
  },
  {
    "id": 1016001050290,
    "speaker": "千雪",
    "text": "ほんとに嬉しい、お仕事です……！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/101600105/1016001050290"
