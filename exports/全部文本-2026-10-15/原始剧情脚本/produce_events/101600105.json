[
  {
    "id": 1016001050010,
    "speaker": "千雪",
    "text": "はぁ……\r\nまだ夢みたいです……",
    "charAnim1": "sad1",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
