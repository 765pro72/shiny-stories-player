    "voice": "produce_events/300100402/3001004020010"
  },
  {
    "id": 3001004020020,
    "speaker": "めぐる",
    "text": "ううん、こちらこそ！　いっぱい練習しようね",
    "charAnim1": "smile3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020020"
  },
  {
    "id": 3001004020030,
    "speaker": "めぐる",
    "text": "何から始めよっか？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020030"
  },
  {
    "id": 3001004020040,
    "speaker": "真乃",
    "text": "えっとね、まだ振りつけに自信がなくて……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020040"
  },
  {
    "id": 3001004020050,
    "speaker": "真乃",
    "text": "昨日、ふたりがアドバイスしてくれたところ、\r\nちゃんと踊れるようになりたいって思ってるの",
    "charAnim1": "think",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020050"
  },
  {
    "id": 3001004020060,
    "speaker": "めぐる",
    "text": "オッケー、じゃあまずはダンスからだね！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020060"
  },
  {
    "id": 3001004020070,
    "speaker": "真乃",
    "text": "うんっ。私、踊ってみるから、見ててもらってもいい？",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
