    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020320"
  },
  {
    "id": 3001004020330,
    "speaker": "めぐる",
    "text": "タイミング違ったな―とか、\r\n歌とのバランス、もっと考えなきゃな―とか",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020330"
  },
  {
    "id": 3001004020340,
    "speaker": "真乃",
    "text": "そうなんだ……めぐるちゃんのダンス、\r\n完璧だと思ってたから、わからなかったよ",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020340"
  },
  {
    "id": 3001004020350,
    "speaker": "めぐる",
    "text": "そんなことないよー！\r\nわたしだってもっともっと練習しなきゃだもん！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru2",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020350"
  },
  {
    "id": 3001004020360,
