      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/300100402/3001004020090",
    "charCategory": "stand_jersey"
  },
  {
    "id": 3001004020100,
    "speaker": "めぐる",
    "text": "なんか……固い？",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020100"
  },
  {
    "id": 3001004020110,
    "speaker": "めぐる",
    "text": "間違えちゃった後とか、それに引きずられて、\r\n動きが小さくなってる気がする",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020110"
  },
  {
    "id": 3001004020120,
    "speaker": "真乃",
    "text": "そ、そっか……立て直さなきゃって思うと\r\nどんどん焦っちゃうの……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020120"
  },
  {
    "id": 3001004020130,
    "speaker": "めぐる",
    "text": "……真乃はさ、\r\n絶対に間違っちゃダメだって思ってるんじゃないかな？",
    "charAnim1": "shy2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020130"
  },
  {
    "id": 3001004020140,
    "speaker": "真乃",
    "text": "えっ、……うん、そうかもしれない\r\n私、ちゃんとできないと、ふたりに迷惑かけちゃうし……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020140"
  },
  {
    "id": 3001004020150,
    "speaker": "めぐる",
    "text": "ううん、真乃。そうじゃないよ\r\nそうじゃなくて、今はたくさん失敗しても大丈夫なんだよ",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020150"
  },
  {
    "id": 3001004020160,
    "speaker": "真乃",
    "text": "──！　で、でも……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020160"
  },
  {
    "id": 3001004020170,
    "speaker": "めぐる",
    "text": "だって、本番で間違えないように、\r\nもし間違えちゃってもカバーできるように",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020170"
  },
  {
    "id": 3001004020180,
    "speaker": "めぐる",
    "text": "そのために練習するんだもん",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020180"
  },
  {
    "id": 3001004020190,
    "speaker": "真乃",
    "text": "そう……なの？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020190"
  },
  {
    "id": 3001004020200,
    "speaker": "めぐる",
    "text": "そうだよ！　まずはね、失敗と仲良くなるんだ\r\nたくさん失敗して、そこからいつも通りに戻す練習をして",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020200"
  },
  {
    "id": 3001004020210,
    "speaker": "めぐる",
    "text": "何があっても自分でカバーできるようになっちゃうの\r\nそうすれば、もう怖くなくなるでしょ？",
    "charAnim1": "smile3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020210"
  },
  {
    "id": 3001004020220,
    "speaker": "めぐる",
    "text": "怖くなくなったら、焦ったりもしなくなるし、\r\nいつも通りの真乃で頑張れると思うんだ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020220"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano"
  },
  {
    "id": 3001004020230,
    "speaker": "めぐる",
    "text": "だからね、失敗しちゃダメって思うんじゃなくて",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020230"
  },
  {
    "id": 3001004020240,
    "speaker": "めぐる",
    "text": "あれこれ試してみるつもりで\r\nやってみるといいんじゃないかなって！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020240"
  },
  {
    "id": 3001004020250,
    "speaker": "真乃",
    "text": "……そっか、そうだよねっ",
    "charAnim1": "smile2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020250"
  },
  {
    "id": 3001004020260,
    "speaker": "真乃",
    "text": "間違いを怖がってるだけだったら、\r\nいつまでも上手くならないよね",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020260"
  },
  {
    "id": 3001004020270,
    "speaker": "めぐる",
    "text": "そうそう！　その調子だよ！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100402/3001004020270"
  },
  {
    "id": 3001004020280,
    "speaker": "真乃",
