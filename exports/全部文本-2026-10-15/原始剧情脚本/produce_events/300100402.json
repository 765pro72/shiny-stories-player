  {
    "id": 3001004020080,
    "speaker": "真乃",
    "text": "ワン、ツー、スリー、フォー\r\nワン、ツー、スリー、フォー",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp_s",
    "charLabel": "meguru",
    "textCtrl": "p",
