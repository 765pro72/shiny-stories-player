    "se": "0121",
    "voice": "produce_events/300100402/3001004020080"
  },
  {
    "id": 3001004020090,
    "speaker": "真乃",
    "text": "……はぁ、はぁ……\r\nど、どうだった、かな？",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "001",
    "charPosition": {
      "x": 796,
      "y": 640,
      "order": 2
    },
