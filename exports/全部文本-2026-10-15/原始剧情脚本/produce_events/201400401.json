    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400401/2014004010130"
  },
  {
    "id": 2014004010140,
    "speaker": "甘奈",
    "text": "それより、\r\nプロデューサーさんは頼むもの決めた？",
