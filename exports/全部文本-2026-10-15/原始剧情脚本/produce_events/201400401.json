    "voice": "produce_events/201400401/2014004010110"
  },
  {
    "id": 2014004010120,
    "speaker": "甘奈",
    "text": "よし！　決めた、ソフトクリームにする！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400401/2014004010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "良いのか？\r\n遠慮しないで、なんでも好きなものを頼んでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014004010130,
    "speaker": "甘奈",
    "text": "ううん、遠慮なんてしてないよ！\r\n最初に気になったからこれが良いなって思ったの☆",
    "charAnim1": "wait",
    "charAnim2": "face_smile",
