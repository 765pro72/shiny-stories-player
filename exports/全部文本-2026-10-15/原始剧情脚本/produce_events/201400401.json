    "charAnim2": "blank",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400401/2014004010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "メニューを見てる時、甜花と食べたいって言ってたろ？\r\n食べたいものは遠慮しないで頼んだら良いんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014004010210,
    "speaker": "甘奈",
    "text": "そっか……えへへ……\r\nプロデューサーさん、ありがと",
