    "waitTime": 1000
  },
  {
    "id": 3008004020550,
    "speaker": "結華",
    "text": "三峰のタルトを……いや、みんなのタルトを独占している、\r\n食いしん坊のうさぎどもを捕らえよー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800402/3008004020550"
  },
  {
    "id": 3008004020560,
