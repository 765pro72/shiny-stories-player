  },
  {
    "id": 3008004020580,
    "speaker": "咲耶",
    "text": "やれやれ、言わんこっちゃない\r\nこうなってしまっては、もうどうすることもできないな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800402/3008004020580"
  },
  {
    "id": 3008004020590,
    "speaker": "咲耶",
