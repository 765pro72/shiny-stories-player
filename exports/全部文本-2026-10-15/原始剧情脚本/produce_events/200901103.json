  },
  {
    "speaker": "プロデューサー",
    "text": "『ピレヅャーコーこをふ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
