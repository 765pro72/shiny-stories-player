    "text": "（帰ってきた時に気付く書置き、なんかいいな\r\n手書きの手紙だもんなぁ……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0130",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……マフィンいただくか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
