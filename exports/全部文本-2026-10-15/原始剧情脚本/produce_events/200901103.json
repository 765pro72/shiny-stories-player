    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "（よくわからない文字以外、真っ白だけど……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（書き損じ……なわけないよなぁ\r\n俺のデスクに置いてあったんだし）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（何かの暗号とか……？\r\n謎の文字、読めない手紙、事務所ミステリー……なんてな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0300",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、差出人は果穂か\r\nえっと……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（一文字ずつ下にずらす……\r\nぷ、ろ、で、ゅ、さ、さ、ん、へ……長音はそのままか）",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "029"
  },
  {
    "speaker": "プロデューサー",
    "text": "（『プロデューサーさんへ』\r\n俺宛……じゃあ、他が白紙なのも意味があるな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（…………そういえば\r\n前に果穂と遊んだ時のブラックライトペンが──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あれ、透明なインクを可視化できるやつだから、\r\nもしかしたら……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0781",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "あった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0559",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……おお、浮かび上がった。正解か\r\nええと……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00224",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2009011030010,
    "speaker": "果穂",
    "text": "『プロデューサーさん、お仕事お疲れ様です！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030010"
  },
  {
    "id": 2009011030020,
    "speaker": "果穂",
    "text": "『このお手紙を読んでくれてるってことは』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030020"
  },
  {
    "id": 2009011030030,
    "speaker": "果穂",
    "text": "『ひみつの暗号に気付いてくれて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030030"
  },
  {
    "id": 2009011030040,
    "speaker": "果穂",
    "text": "『まほうの光も使ってくれてるんだと思います！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030040"
  },
  {
    "id": 2009011030050,
    "speaker": "果穂",
    "text": "『スッゴくうれしいです！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030050"
  },
  {
    "id": 2009011030060,
    "speaker": "果穂",
    "text": "『実は、プロデューサーさんにひみつのお話があって』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030060"
  },
  {
    "id": 2009011030070,
    "speaker": "果穂",
    "text": "『でも、プロデューサーさんがお仕事でいなかったので』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030070"
  },
  {
    "id": 2009011030080,
    "speaker": "果穂",
    "text": "『まほうのペンでお手紙を書きました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030080"
  },
  {
    "id": 2009011030090,
    "speaker": "果穂",
    "text": "『なので、近くにだれもいない時に読んでください！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030090"
  },
  {
    "textFrame": "off",
    "bg": "00002",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なるほど\r\n秘密の話か！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに、暗号とこのペンはぴったりだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00224",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2009011030100,
    "speaker": "果穂",
    "text": "『今日は、学校で調理実習があったんです！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030100"
  },
  {
    "id": 2009011030110,
    "speaker": "果穂",
    "text": "『マフィンと、フィナンシェと、マドレーヌから選べて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030110"
  },
  {
    "id": 2009011030120,
    "speaker": "果穂",
    "text": "『（ほとんど同じ材料でできるんです！　スゴいです！）』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030120"
  },
  {
    "id": 2009011030130,
    "speaker": "果穂",
    "text": "『あたしは、マフィンにしました！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030130"
  },
  {
    "id": 2009011030140,
    "speaker": "果穂",
    "text": "『本当は、事務所のみなさんに作りたかったんですけど』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030140"
  },
  {
    "id": 2009011030150,
    "speaker": "果穂",
    "text": "『オーブンが足りなくて、３つしか作れませんでした』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030150"
  },
  {
    "id": 2009011030160,
    "speaker": "果穂",
    "text": "『全然足りなくてどうしようってなった時に』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030160"
  },
  {
    "id": 2009011030170,
    "speaker": "果穂",
    "text": "『暗号を思い出したんです！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030170"
  },
  {
    "id": 2009011030180,
    "speaker": "果穂",
    "text": "『これなら、だれにも気付かれません！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030180"
  },
  {
    "id": 2009011030190,
    "speaker": "果穂",
    "text": "『気付かれてないですよね？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030190"
  },
  {
    "id": 2009011030200,
    "speaker": "果穂",
    "text": "『戸だなのおくの方にかくしておきました！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030200"
  },
  {
    "id": 2009011030210,
    "speaker": "果穂",
    "text": "『小宮果穂からプロデューサーさんへ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030210"
  },
  {
    "id": 2009011030220,
    "speaker": "果穂",
    "text": "『マフィンの差し入れです！！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030220"
  },
  {
    "id": 2009011030230,
    "speaker": "果穂",
    "text": "『味は、プレーンとチョコチップです！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030230"
  },
  {
    "id": 2009011030240,
    "speaker": "果穂",
    "text": "『だれにも気付かれないように、こっそり食べてください』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030240"
  },
  {
    "id": 2009011030250,
    "speaker": "果穂",
    "text": "『あたしも、おうちで食べてみます！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030250"
  },
  {
    "id": 2009011030260,
    "speaker": "果穂",
    "text": "『今度はみなさんに配れるくらい作るので』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030260"
  },
  {
    "id": 2009011030270,
    "speaker": "果穂",
    "text": "『その時は、みんなで一緒に食べたいです！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030270"
  },
  {
    "id": 2009011030280,
    "speaker": "果穂",
    "text": "『お疲れ様でした！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030280"
  },
  {
    "id": 2009011030290,
    "speaker": "果穂",
    "text": "『明日は会えたらいいなって思います！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901103/2009011030290"
  },
  {
