    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100400402/1004004020090"
  },
  {
    "speaker": "夢追いガール",
    "text": "雑誌撮影にライブの準備……！\r\n恋鐘さんも忙しそう……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004004020100,
    "speaker": "恋鐘",
    "text": "んふふ～、ばってん楽しかよ！\r\nライブの準備もわくわくするばい！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、そうだ恋鐘。ディレクターさんのところに寄るから\r\nちょっと待っててもらっていいか？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "例の件で、スケジュールの相談があるからさ\r\nこっちにも影響ないようにしたいし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004004020110,
    "speaker": "恋鐘",
    "text": "大丈夫～、ここで話しとくけん",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020110"
  },
  {
    "speaker": "夢追いガール",
    "text": "なにかあったんですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004004020120,
    "speaker": "恋鐘",
    "text": "うち、舞台の仕事決まったとよ～",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020120"
  },
  {
    "speaker": "夢追いガール",
    "text": "……えっ！",
    "textCtrl": "p",
    "textFrame": "003",
    "autoWaitTime": 1500
  },
  {
    "id": 1004004020130,
    "speaker": "恋鐘",
    "text": "急やったけん、プロデューサーが\r\nスケジュールを確認しとるとこで……",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020130"
  },
  {
    "speaker": "夢追いガール",
    "text": "わぁ、恋鐘さん、ますます忙しくなるんですね……！\r\nなのに私のところに何度も来ていただいて……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004004020140,
    "speaker": "恋鐘",
    "text": "サポーターやもん、当然やろ～？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020140"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "夢追いガール",
    "text": "ありがとうございます……\r\n恋鐘さんに来ていただけるだけで力もらえます！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "夢追いガール",
    "text": "舞台出演おめでとうございます……！\r\n頑張ってください……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "夢追いガール",
    "text": "……なんて、まだ何もできてない私に\r\n言われてもって感じですけど……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004004020150,
    "speaker": "恋鐘",
    "text": "ううん、嬉しかよ！　うち、頑張るけん\r\n絶対舞台観にきてほしか！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charAnim3": "no",
    "charAnim3Loop": false,
