    "textFrame": "002"
  },
  {
    "id": 1004004020220,
    "speaker": "恋鐘",
    "text": "やけん、あの子のお手本っていうか……\r\nよか先輩になりたか～って思うばい！",
    "charAnim1": "smile4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400402/1004004020220"
  },
  {
