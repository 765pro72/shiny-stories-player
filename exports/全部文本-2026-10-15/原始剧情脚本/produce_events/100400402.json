  {
    "speaker": "プロデューサー",
    "text": "また仕事詰め込んじゃってごめんな、恋鐘",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004004020160,
    "speaker": "恋鐘",
    "text": "なして謝るとね～？",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
