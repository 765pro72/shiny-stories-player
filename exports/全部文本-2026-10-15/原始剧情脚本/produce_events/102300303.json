  {
    "speaker": "モニター芸人",
    "text": "──さて、今回も始まりました！",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "015"
  },
  {
    "speaker": "モニター芸人",
    "text": "大人気青春ジャーニー♡恋愛リアリティーショー\r\n『これは恋ではありません！』　-３rdシーズン-！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
