  },
  {
    "id": 2003015110040,
    "speaker": "めぐる",
    "text": "太陽って偉大！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういうところで太陽のすごさを感じるとはなぁ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003015110050,
    "speaker": "めぐる",
    "text": "あはは、ちょっと規模が小さすぎたかな！？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110050"
  },
  {
    "id": 2003015110060,
    "speaker": "めぐる",
    "text": "あ！\r\n太陽すごいと言えばね……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110060"
  },
  {
    "id": 2003015110070,
    "speaker": "めぐる",
    "text": "雪だるまたち、みんな溶けちゃってた！",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\nうん、昨日の朝はまだ残ってたんだけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "日中暖かくなったから……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003015110080,
    "speaker": "めぐる",
    "text": "そっか……！",
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "残念だよな\r\nせっかく作ったのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003015110090,
    "speaker": "めぐる",
    "text": "そうだね……！",
    "charAnim2": "face_sad",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110090"
  },
  {
    "id": 2003015110100,
    "speaker": "めぐる",
    "text": "でもでも、もともと雪ってそういうものだから……！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110100"
  },
  {
    "id": 2003015110110,
    "speaker": "めぐる",
    "text": "それにね、雪だるまたちが並んでる写真もしっかり撮ったし\r\n何より作っててすっごく楽しかったし！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110110"
  },
  {
    "id": 2003015110120,
    "speaker": "めぐる",
    "text": "溶けちゃったなーとは思うけど、\r\n溶けちゃった……！　って感じじゃないよ！",
    "charAnim1": "sad1",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110120"
  },
  {
    "id": 2003015110130,
    "speaker": "めぐる",
    "text": "そもそも、あんなに遊べるくらい\r\n雪が積もったことが珍しいんだもん",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、このまま冷え込みも緩んでいくみたいだし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この冬はもう降らないかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003015110140,
    "speaker": "めぐる",
    "text": "あっほんとに！？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
