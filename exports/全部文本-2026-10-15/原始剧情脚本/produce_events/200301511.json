    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110140"
  },
  {
    "id": 2003015110150,
    "speaker": "めぐる",
    "text": "今日の天気しか見てないから知らなかったや……",
