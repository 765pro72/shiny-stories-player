    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301511/2003015110150"
  },
  {
    "id": 2003015110160,
    "speaker": "めぐる",
    "text": "じゃあじゃあ、\r\nやっぱりあの日雪遊びできてよかったー！",
