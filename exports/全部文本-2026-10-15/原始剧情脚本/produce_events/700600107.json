[
  {
    "id": 7006001070010,
    "speaker": "咲耶",
    "text": "プロデューサー、待っていたよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
