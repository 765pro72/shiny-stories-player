  {
    "id": 2019004110020,
    "speaker": "愛依",
    "text": "……プロデューサー",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110020"
  },
  {
    "id": 2019004110030,
    "speaker": "愛依",
    "text": "もし、うちがホントに\r\nゾンビになっちゃったとしたらさぁ……",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110030"
  },
  {
    "id": 2019004110040,
    "speaker": "愛依",
    "text": "噛みついていい……？",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "！？\r\n愛依、急にどうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110050,
    "speaker": "愛依",
    "text": "文化祭のために\r\nゾンビのこと調べたんだけどさ",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110050"
  },
  {
    "id": 2019004110060,
    "speaker": "愛依",
    "text": "ゾンビって治んないじゃん？\r\nけど死なないじゃん？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger2",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110060"
  },
  {
    "id": 2019004110070,
    "speaker": "愛依",
    "text": "そんなんでずーっと、ウロウロするわけでしょ？",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110070"
  },
  {
    "id": 2019004110080,
    "speaker": "愛依",
    "text": "……ちょーつまんなさそうじゃん！！！",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\nなるほどな、そういうことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110090,
    "speaker": "愛依",
    "text": "ガブッとしちゃえば\r\nプロデューサーもゾンビになるっしょ？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110090"
  },
  {
    "id": 2019004110100,
    "speaker": "愛依",
    "text": "そしたら一緒にウロウロできるなーって！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110100"
  },
  {
    "id": 2019004110110,
    "speaker": "愛依",
    "text": "プロデューサーがいれば退屈しないし！\r\n……ってわけだから、噛まれて♪",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、ゾンビって\r\n記憶が無くなるんじゃなかったか？",
    "charAnim2": "face_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依がゾンビになったら\r\n俺のこともわからなくなるんじゃ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110120,
    "speaker": "愛依",
    "text": "いや、そんなことないっしょ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n何か、考えでもあるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110130,
    "speaker": "愛依",
    "text": "ないっ！！！！！！",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110140,
    "speaker": "愛依",
    "text": "でも、プロデューサーとうちなら\r\nどうにかなりそ～じゃん？",
    "charAnim1": "anger1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110140"
  },
  {
    "id": 2019004110150,
    "speaker": "愛依",
    "text": "今までだってふたりで色々乗り越えてきたし\r\nうちらの絆なら記憶くらいどうってことないっしょ！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110150"
  },
  {
    "id": 2019004110160,
    "speaker": "愛依",
    "text": "ゾンビになってもなんか……\r\n魂？　でつながってたりとかさ！",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "魂でつながってる……か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そこまで言われると、\r\nそうかもしれないって気がしてきたな",
    "charAnim2": "face_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110170,
    "speaker": "愛依",
    "text": "え～？　うちらだったら当たり前じゃない？",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110170"
  },
  {
    "id": 2019004110180,
    "speaker": "愛依",
    "text": "プロデューサーって、うちが困ってる時 \r\nいつも助けてくれんじゃん？",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110180"
  },
  {
    "id": 2019004110190,
    "speaker": "愛依",
    "text": "なんかうちがやらかしたーって時も \r\n一緒に解決方法考えてくれるし……",
    "charAnim1": "sad2",
    "charAnim2": "face_smile2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110190"
  },
  {
    "id": 2019004110200,
    "speaker": "愛依",
    "text": "うちを人前に立てるようにするとかさ\r\nプロデューサーにしかできないし！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110200"
  },
  {
    "id": 2019004110210,
    "speaker": "愛依",
    "text": "それができたんだから\r\n魂でくらい余裕でつながれそうじゃん",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "……愛依",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110220,
    "speaker": "愛依",
    "text": "それにさー……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110220"
  },
  {
    "id": 2019004110230,
    "speaker": "愛依",
    "text": "もしうちがゾンビになりそーってピンチの時は\r\nプロデューサー、絶対来てくれるっしょ？",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110230"
  },
  {
    "id": 2019004110240,
    "speaker": "愛依",
    "text": "だからうちがゾンビになっちゃったとして\r\nその時一番近くにいてくれんの",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110240"
  },
  {
    "id": 2019004110250,
    "speaker": "愛依",
    "text": "たぶんプロデューサーだろうな～って",
    "charAnim2": "face_shy",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110260,
    "speaker": "愛依",
    "text": "だからゾンビのうちが噛み付いて、\r\nプロデューサーがゾンビになっても",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110260"
  },
  {
    "id": 2019004110270,
    "speaker": "愛依",
    "text": "またよろしく～ってカンジなんだけど……",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110270"
  },
  {
    "speaker": "プロデューサー",
    "text": "……愛依、それは違うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110280,
    "speaker": "愛依",
    "text": "へ……？",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110280"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依が仮にゾンビになりそうってピンチの時には\r\n必ず駆けつける",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで、助けるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110290,
    "speaker": "愛依",
    "text": "……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110290"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから愛依はゾンビにならない\r\nもちろん俺もだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからもアイドルの愛依と、\r\nプロデューサーの俺のままでさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依が退屈しないような……\r\nそれで、ファンを退屈させないような",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_serious_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうアイドルになっていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110300,
    "speaker": "愛依",
    "text": "……うん、そうだね",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110300"
  },
  {
    "id": 2019004110310,
    "speaker": "愛依",
    "text": "……アッハハ！\r\nありがとね、プロデューサー",
    "charAnim1": "serious",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110310"
  },
  {
    "id": 2019004110320,
    "speaker": "愛依",
    "text": "うち、こういうくだらない話にも \r\nマジで付き合ってくれるとこちょー好き系だわ",
    "charAnim1": "anger1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110320"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか……",
    "charAnim2": "face_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004110330,
    "speaker": "愛依",
    "text": "そんじゃ、絶対ゾンビ倒そうね！\r\nうちも一緒に戦うし！",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110330"
  },
  {
    "id": 2019004110340,
    "speaker": "愛依",
    "text": "そんで、ゾンビになんかならないでさ……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900411/2019004110340"
  },
  {
    "id": 2019004110350,
    "speaker": "愛依",
    "text": "プロデューサーも退屈させないような\r\nちょーすっごいアイドルになるから！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
