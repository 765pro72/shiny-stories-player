  {
    "id": 1022004020010,
    "speaker": "小糸",
    "text": "あ、ありがとうございますプロデューサーさん\r\nまだ全然バスある時間なのに……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
