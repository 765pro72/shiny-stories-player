  {
    "speaker": "プロデューサー",
    "text": "（霧子のほう……大丈夫かな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……っつ、やっちゃったな\r\nいてて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010140,
    "speaker": "霧子",
    "text": "プ、プロデューサーさん……！　どうしたんですか……！\r\nちち、血がたくさん……出ちゃってます……！",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200800301/2008003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや……\r\nちょっと切っただけだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010150,
    "speaker": "霧子",
    "text": "応急、処置……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010150"
  },
  {
    "id": 2008003010160,
    "speaker": "霧子",
    "text": "救急箱と……\r\nタオルを濡らす……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや……ちょっとカッターで切っただけだから\r\nそんなに慌てなくても大丈夫だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010170,
    "speaker": "霧子",
    "text": "だ、ダメです！\r\n万が一、バイキンが入ってひどくなったりしたら……",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010170"
  },
  {
    "textFrame": "off",
