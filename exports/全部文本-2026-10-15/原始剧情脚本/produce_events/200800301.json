  {
    "speaker": "プロデューサー",
    "text": "ああ、いい仕上がりだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010020,
    "speaker": "霧子",
    "text": "はい……\r\nイメージ通り……です……！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いよいよ今日の販売会でお披露目だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010030,
    "speaker": "霧子",
    "text": "みなさんに……\r\n喜んでいただけそうですね……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、バッチリじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010040,
    "speaker": "霧子",
    "text": "あ、あの……プ、プロデューサーさんは\r\nこのまま準備……されますか……？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうするつもりだよ\r\n霧子は……まだしばらく待機だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010050,
    "speaker": "霧子",
    "text": "あの……\r\nもしご迷惑でなければ……ですけど……",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010050"
  },
  {
    "id": 2008003010060,
    "speaker": "霧子",
    "text": "わたしも……\r\nお手伝い、させていただけませんか……？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、霧子は待機していてくれ……\r\nと、いいたいところだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "心配してくれてるんだな\r\n簡単なことならかまわないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ありがとうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010061,
    "speaker": "霧子",
    "text": "は、はい……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010061"
  },
  {
    "textFrame": "off",
