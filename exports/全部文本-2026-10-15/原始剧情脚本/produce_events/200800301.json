  {
    "id": 2008003010180,
    "speaker": "霧子",
    "text": "……よかった、止血……できました……",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……あんなに出血してたのにもう止まってる\r\n傷口の周りもキレイなもんだ……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010190,
    "speaker": "霧子",
    "text": "血が止まったら、もう大丈夫です……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010190"
  },
  {
    "id": 2008003010200,
    "speaker": "霧子",
    "text": "最後に、包帯を巻いて……と……",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "（テキパキしてて……霧子、すごいなぁ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010210,
    "speaker": "霧子",
    "text": "痛いのさん……飛んでいけ……！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010210"
  },
  {
    "id": 2008003010220,
    "speaker": "霧子",
    "text": "で、できました……！\r\nまだ……しばらくは痛むかも……ですけど",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお……すごくキレイに巻かれてるな\r\n包帯で感心したのは初めてだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003010230,
    "speaker": "霧子",
    "text": "そ、そんなことないですよ……\r\nでも……よかったです……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010230"
  },
  {
    "id": 2008003010240,
    "speaker": "霧子",
    "text": "では、救急箱を片付けてきますね……！",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800301/2008003010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、霧子！\r\n手当て……ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
