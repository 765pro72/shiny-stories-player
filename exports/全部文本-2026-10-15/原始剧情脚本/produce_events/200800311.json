    }
  },
  {
    "id": 2008003110060,
    "speaker": "霧子",
    "text": "お、お待たせしました……！",
    "charAnim1": "surp1",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030080010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200800311/2008003110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……はは、そんなに急がなくてもいいのに\r\nじゃ、駅まで送るよ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……と、霧子？\r\n腕の絆創膏、はがれかけてるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110070,
    "speaker": "霧子",
    "text": "……わわ！　本当です……！\r\nあ、あの、これは……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうした？\r\n……痛むのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110080,
    "speaker": "霧子",
    "text": "な、なんでもないんです……！\r\n……気に……しないでください",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、でも……\r\n見せてみろ、俺が貼り替えるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110090,
    "speaker": "霧子",
    "text": "み、見ちゃ……だめです……！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nこれ、傷じゃなくて、文字か……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110100,
    "speaker": "霧子",
    "text": "うう……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ？　これ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110110,
    "speaker": "霧子",
    "text": "プ、プロデューサーさんの……お名前です……",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そ、そうだな\r\nなんで……そんなところに書いてたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110120,
    "speaker": "霧子",
    "text": "え、えっと……\r\nおまじないっていうか……",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110120"
  },
  {
    "id": 2008003110130,
    "speaker": "霧子",
    "text": "プロデューサーさんの名前を書いて\r\n絆創膏で守っていたんです……",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110130"
  },
  {
    "id": 2008003110140,
    "speaker": "霧子",
    "text": "こうすると……\r\nプロデューサーさんがずっとそばにいてくれる気がして……",
    "charAnim1": "sad1",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110140"
  },
  {
    "id": 2008003110150,
    "speaker": "霧子",
    "text": "緊張とか、不安とかが……すっ……て消えて……\r\n大きな舞台でも、笑顔でいられて……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110150"
  },
  {
    "id": 2008003110160,
    "speaker": "霧子",
    "text": "か、勝手に書いて……\r\nごめんなさい……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "（こんなおまじないみたいなことして……\r\n霧子も必死にがんばってるんだな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "霧子、全然謝ることじゃないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110170,
    "speaker": "霧子",
    "text": "……本当ですか……？\r\nき、気持ち悪かったりしませんか……？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "全然……なんでだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110180,
    "speaker": "霧子",
    "text": "き、嫌いになったり……しませんか……？",
    "charAnim1": "anger1",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、どうして……\r\n俺が霧子を励ますことができるんなら、嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことしなくても、\r\n俺はずっと……霧子のそばにいるけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110190,
    "speaker": "霧子",
    "text": "プ、プロデューサーさん……！\r\nわ、わたし……",
    "charAnim1": "surp2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110190"
  },
  {
    "id": 2008003110200,
    "speaker": "霧子",
    "text": "プロデューサーさんに見つけてもらって\r\n本当に……よかったって……",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200800311/2008003110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も、霧子に出会えてよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "霧子、がんばろうな\r\nこれからも……一緒に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2008003110210,
    "speaker": "霧子",
    "text": "は、はい……！",
    "charAnim2": "yes",
    "charAnim3": "face_shy",
    "charAnim2Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
