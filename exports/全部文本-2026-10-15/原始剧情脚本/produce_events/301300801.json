    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300801/3013008010150"
  },
  {
    "id": 3013008010160,
    "speaker": "果穂",
    "text": "はいっ！　サプライズ、ですっ！",
