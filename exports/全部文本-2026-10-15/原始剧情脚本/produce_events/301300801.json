    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300801/3013008010110"
  },
  {
    "id": 3013008010120,
    "speaker": "果穂",
    "text": "はいっ\r\nあっ、もちろんおもちも入れます！",
