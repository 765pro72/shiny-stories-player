    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300801/3013008010160"
  },
  {
    "id": 3013008010170,
    "speaker": "夏葉",
    "text": "お雑煮に地域差があるとは聞いたことがあるけど……\r\nこんなに違うものなのね……",
