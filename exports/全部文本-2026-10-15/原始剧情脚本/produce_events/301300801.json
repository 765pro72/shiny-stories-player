    "charAnim2": "face_anger1",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300801/3013008010130"
  },
  {
    "id": 3013008010140,
    "speaker": "果穂",
    "text": "はいっ！",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300801/3013008010140"
  },
  {
    "id": 3013008010150,
    "speaker": "夏葉",
    "text": "かるた練習の日、サプライズで\r\nみんなにお雑煮を振る舞うって計画のことよね……？",
    "charAnim2": "face_anger2",
