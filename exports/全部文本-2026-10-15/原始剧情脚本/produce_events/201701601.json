    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201701601/2017016010220"
  },
  {
    "id": 2017016010230,
    "speaker": "あさひ",
    "text": "『せんてい』した方が\r\n育つっていうのが──……",
    "charAnim1": "why",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/201701601/2017016010230"
  },
  {
    "select": "それも\r\nそうだけど……",
