    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、それがいい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──じゃあ、何か飲むか？\r\nスタッフさんがいくつか用意してくれてるみたいだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003008020140,
    "speaker": "めぐる",
    "text": "何があるかわかる？",
