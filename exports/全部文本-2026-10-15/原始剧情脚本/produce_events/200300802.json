    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020080"
  },
  {
    "id": 2003008020090,
    "speaker": "めぐる",
    "text": "さっきも途中で直してもらっちゃったし……",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020090"
  },
  {
    "id": 2003008020100,
    "speaker": "めぐる",
    "text": "いつもより大人しくしてないといけないなって、\r\nすごく思ったの！",
