    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、それで気疲れしすぎてしまうのもいけない",
