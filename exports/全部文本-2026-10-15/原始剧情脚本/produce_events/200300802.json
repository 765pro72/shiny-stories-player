    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええと、ラムネとか麦茶とか──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003008020150,
    "speaker": "めぐる",
    "text": "わぁっ、夏って感じ……！\r\nプロデューサーだったらどれにするの？",
