    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2003008020110,
    "speaker": "めぐる",
    "text": "……わたし、そんなに疲れてそう？",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
