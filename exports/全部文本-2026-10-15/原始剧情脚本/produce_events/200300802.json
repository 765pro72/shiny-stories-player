    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300802/2003008020120"
  },
  {
    "id": 2003008020130,
    "speaker": "めぐる",
    "text": "……うん\r\n気をつけるけど、気をつけすぎないようにする……！",
