    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200300802/2003008020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そこまで気にしなくても平気だと思うんだが──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003008020080,
    "speaker": "めぐる",
    "text": "ダメだよーっ！\r\n気をつけてないと絶対崩しちゃうもん！",
