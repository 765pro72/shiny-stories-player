  },
  {
    "speaker": "プロデューサー",
    "text": "わっ……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010010,
    "speaker": "？？？",
    "text": "おー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、あさひ！？\r\nなんで床に転がってるんだ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、また出張土産のスノードーム見てたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010020,
    "speaker": "あさひ",
    "text": "はいっす！\r\n赤ずきんちゃん、面白いっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、気に入ってくれてよかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0242",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 600
  },
  {
    "speaker": "プロデューサー",
    "text": "あさひ、床に転がっていると身体を痛くするぞ\r\nソファに座った方がいいんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "asahi",
    "textFrame": "off",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "017",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "se": "0327",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 2017009010030,
    "speaker": "あさひ",
    "text": "ここに寝転がってると日差しが入って\r\n雪がすっごくキラキラするんすよ！",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……今日は天気いいもんなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010040,
    "speaker": "あさひ",
    "text": "……ふん、ふん",
    "charAnim1": "why",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0454",
    "voice": "produce_events/201700901/2017009010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうした？　横に振ったりして……\r\n落とさないようにな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010050,
    "speaker": "あさひ",
    "text": "木にキラキラが引っかかったっす",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、雪を振り落としているのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、あんまり振ると、赤ずきんちゃんの気分が\r\n悪くなるかもしれないぞ。ほどほどにな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010060,
    "speaker": "あさひ",
    "text": "プロデューサーさん、面白いこと言うっすね！\r\n赤ずきんちゃんの気持ち、わかるっすか？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかるっていうか……だってさかさまにされて\r\n振り回されるんだぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010070,
    "speaker": "あさひ",
    "text": "あはは、確かに！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "これは、赤ずきんちゃんの世界だからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "赤ずきんちゃんは、お母さんの言い付けで\r\nおばあさんのお家に向かうところだろ？",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010080,
    "speaker": "あさひ",
    "text": "ふんふん……あったっすね、\r\nお花摘みのシーンっす！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "無事におばあさんの家に着けるよう\r\n優しくしてやってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010090,
    "speaker": "あさひ",
    "text": "赤ずきんちゃんは\r\nおばあさんの家、行きたくないっすよ",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？　なんでだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010100,
    "speaker": "あさひ",
    "text": "この赤ずきんちゃんの顔、めんどくさそうっす！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あはは、言われてみれば……\r\n顔がしっかり描き込まれてないからそう見える",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、どうして森なんて危ないところに\r\nいやいや来たんだろう？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010110,
    "speaker": "あさひ",
    "text": "お小遣いか、お菓子がもらえるからっすよ！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ、赤ずきんちゃんって\r\n意外とちゃっかりしてるんだな",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "赤ずきんちゃん、後ろ振り返ってるぞ\r\nオオカミの気配を感じてるんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017009010120,
    "speaker": "あさひ",
    "text": "うーん……そっすか？\r\n天気が気になるっすよ",
    "charAnim1": "shy1",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700901/2017009010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "天気？",
    "textCtrl": "p",
    "textFrame": "002"
  },
