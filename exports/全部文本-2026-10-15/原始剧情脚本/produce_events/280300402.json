    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280300402/2803004020110"
  },
  {
    "id": 2803004020120,
    "speaker": "MEMちょ",
    "text": "ちょっと水飲んでからにしよう！\r\nプロデューサー、多分自分で思ってるより調子悪いよ",
