    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280300402/2803004020100"
  },
  {
    "id": 2803004020110,
    "speaker": "MEMちょ",
    "text": "お言葉に甘えます！\r\n──でも",
