  {
    "id": 1004003010040,
    "speaker": "恋鐘",
    "text": "──ふぇ、オーディション？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
