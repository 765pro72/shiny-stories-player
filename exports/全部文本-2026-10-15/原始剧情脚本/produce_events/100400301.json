    "voice": "produce_events/100400301/1004003010160"
  },
  {
    "id": 1004003010170,
    "speaker": "恋鐘",
    "text": "アンティーカになってからは\r\n歌もダンスもば～りばりに鍛えてきたとよ！",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400301/1004003010170"
  },
  {
    "id": 1004003010180,
    "speaker": "恋鐘",
    "text": "オーディションに向けてこれからもっと練習して、\r\n今よりもっとすごかアイドルになれることも間違いなし！",
    "charAnim1": "smile3",
