    "voice": "produce_events/100400301/1004003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……最初にそう言ってたもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003010150,
    "speaker": "恋鐘",
    "text": "うん～、そうやったね……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
