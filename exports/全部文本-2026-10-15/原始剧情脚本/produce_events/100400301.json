  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003010190,
    "speaker": "恋鐘",
    "text": "そいで何より、うちは２８３プロのオーディションで\r\nプロデューサーに選ばれとるけん！",
