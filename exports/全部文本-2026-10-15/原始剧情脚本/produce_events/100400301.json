    "voice": "produce_events/100400301/1004003010130"
  },
  {
    "id": 1004003010140,
    "speaker": "恋鐘",
    "text": "数え切れんくらい、たくさん……\r\nもう片っ端からオーディションば受けてきたとよ",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
