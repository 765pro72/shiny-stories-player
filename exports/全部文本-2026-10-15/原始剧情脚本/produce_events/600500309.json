    "textFrame": "001",
    "voice": "produce_events/600500309/6005003090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかく、ここまで頑張ったのに……な",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6005003090050,
    "speaker": "摩美々",
