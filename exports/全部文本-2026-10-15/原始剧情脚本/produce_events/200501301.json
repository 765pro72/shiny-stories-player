  },
  {
    "id": 2005013010030,
    "speaker": "摩美々",
    "text": "クリスマスって……\r\n随分早いんですねー",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501301/2005013010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは\r\nすまん、つい……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々にぴったりの新しい話が来ててな\r\nクリスマスの仕事でさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005013010040,
    "speaker": "摩美々",
    "text": "ふーん……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
