  {
    "speaker": "客",
    "text": "前の機種が気に入っていたから\r\n同じものがあればと思ったんですけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3026004010040,
    "speaker": "ルカ",
    "text": "……",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
