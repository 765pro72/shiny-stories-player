    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302600401/3026004010040"
  },
  {
    "speaker": "スタッフ１",
    "text": "ええと……\r\n申し訳ございません……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ１",
    "text": "こちらの機種は既に生産が\r\n終了しておりまして……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "客",
    "text": "そうなんだ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ１",
    "text": "新しい機種の方がより使いやすくなっていると\r\n思いますので",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ１",
    "text": "この機会に\r\n最新のスマートフォンにしてはいかがでしょうか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious_s",
    "charLabel": "luca",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "客",
    "text": "うーん\r\n前のに愛着も湧いてたんだけどなぁ……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3026004010050,
