  },
  {
    "id": 7004001020010,
    "speaker": "恋鐘",
    "text": "そうかぁ……\r\nちょこっと残念やね……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
