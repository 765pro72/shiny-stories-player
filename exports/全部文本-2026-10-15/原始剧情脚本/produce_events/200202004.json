  {
    "id": 2002020040100,
    "speaker": "灯織",
    "text": "あっ……私も事務所に行かなくちゃ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040100"
  },
  {
