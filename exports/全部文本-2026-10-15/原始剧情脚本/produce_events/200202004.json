    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040290"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだとしたら嬉しいな",
