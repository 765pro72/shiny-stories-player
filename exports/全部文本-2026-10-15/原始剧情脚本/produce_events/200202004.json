  {
    "speaker": "プロデューサー",
    "text": "……スケジュールも少しタイトで\r\n内容も挑戦になるんだけど──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002020040160,
    "speaker": "灯織",
    "text": "……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
