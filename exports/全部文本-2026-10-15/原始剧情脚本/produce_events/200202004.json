    "waitTime": 1200
  },
  {
    "id": 2002020040110,
    "speaker": "灯織",
    "text": "（中学生の時には予想もしなかったな──……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040110"
  },
  {
    "id": 2002020040120,
    "speaker": "灯織",
    "text": "（……こんな風に小さな出会いが\r\n未来に繋がることもあるんだ……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040120"
  },
  {
    "id": 2002020040130,
    "speaker": "灯織",
    "text": "（……そこで終わり、じゃないのかも）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040130"
  },
  {
    "id": 2002020040140,
    "speaker": "灯織",
    "text": "（────あの卒業生にも……\r\nこんな未来があるといいな）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040140"
  },
  {
    "id": 2002020040150,
    "speaker": "灯織",
    "text": "（いつか、あの人と友達のわだかまりが\r\n解ける日が来ますように────）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202004/2002020040150"
  },
