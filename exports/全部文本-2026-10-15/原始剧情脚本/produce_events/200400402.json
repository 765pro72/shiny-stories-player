    "textFrame": "001",
    "voice": "produce_events/200400402/2004004020090"
  },
  {
    "id": 2004004020100,
    "speaker": "恋鐘",
    "text": "ご、ごめん～！！",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400402/2004004020100"
  },
  {
