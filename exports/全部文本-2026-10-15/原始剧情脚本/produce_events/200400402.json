    "voice": "produce_events/200400402/2004004020130"
  },
  {
    "id": 2004004020140,
    "speaker": "恋鐘",
    "text": "……うち、気合入れて作ったけん",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400402/2004004020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘……",
    "textCtrl": "l",
