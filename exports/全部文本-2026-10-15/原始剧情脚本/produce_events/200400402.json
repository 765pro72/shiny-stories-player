  {
    "speaker": "プロデューサー",
    "text": "……こ、恋鐘、大丈夫か……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004004020090,
    "speaker": "恋鐘",
    "text": "う、うん……うちは大丈夫やけど……\r\nお弁当……落ちてもうたばい～……！",
    "charAnim1": "sad1",
    "charAnim2": "blank",
