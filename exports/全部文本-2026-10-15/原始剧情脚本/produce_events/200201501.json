    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201501/2002015010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ、第二の家みたいな感じはあるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015010080,
    "speaker": "灯織",
    "text": "ふふ、プロデューサーは\r\nもはや住んでしまっていそうですもんね？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201501/2002015010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そこまでではないからな！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015010090,
    "speaker": "灯織",
    "text": "どうでしょうか\r\nみんなが知らないだけ……なんてことありませんか？",
