    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201501/2002015010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……\r\nいや……うん、ないはず……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫だよな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015010100,
    "speaker": "灯織",
