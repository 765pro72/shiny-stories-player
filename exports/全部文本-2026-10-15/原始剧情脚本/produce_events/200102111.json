    "voice": "produce_events/200102111/2001021110060"
  },
  {
    "id": 2001021110070,
    "speaker": "真乃",
    "text": "そうしているうちに、もう『旅』は始まっているんだなって\r\n実感が湧いてきました",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200102111/2001021110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、こうしてるうちにも\r\n新しい一年はどんどん動いていくから……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだ、真乃が選んでくれた正月飾りも\r\nそろそろ飾り納めだな",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
