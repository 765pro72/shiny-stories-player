    "voice": "produce_events/200102111/2001021110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、それならよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001021110060,
    "speaker": "真乃",
    "text": "公園の鳩さんたちにも新年のご挨拶をして……",
