  {
    "speaker": "プロデューサー",
    "text": "少し遅めの休暇にはなったけど\r\nゆっくりできたかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001021110050,
    "speaker": "真乃",
    "text": "はい、家族やピーちゃんとも\r\nのんびりできました",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
