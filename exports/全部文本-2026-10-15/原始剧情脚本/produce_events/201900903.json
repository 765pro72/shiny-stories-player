    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900903/2019009030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "なりたくないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009030130,
    "speaker": "愛依",
    "text": "うちには合わないかな～\r\nちょーっと自由がなさすぎて",
