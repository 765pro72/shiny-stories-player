  },
  {
    "id": 2015003010020,
    "speaker": "甜花",
    "text": "あ……プロデューサーさん……",
    "stillType": "idols",
    "stillId": "1030150010",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010020"
  },
  {
    "id": 2015003010030,
    "speaker": "甜花",
    "text": "え……\r\nなんで……家に……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010030"
  },
  {
    "id": 2015003010040,
    "speaker": "甜花",
    "text": "なーちゃんの……おむかえ……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010040"
  },
  {
    "id": 2015003010050,
    "speaker": "甜花",
    "text": "それとも、三者面談……？\r\n甜花、ちゃんとできてないから……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、どれも違うよ……\r\nでも、無事なら良かった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003010060,
    "speaker": "甜花",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "甜花がレッスンに来なかったから、迎えに来たんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003010070,
    "speaker": "甜花",
    "text": "え……え……？　レッスンは、明日じゃ……\r\n確か……スマホにも、登録……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010070"
  },
  {
    "id": 2015003010080,
    "speaker": "甜花",
    "text": "あ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010080"
  },
  {
    "id": 2015003010090,
    "speaker": "甜花",
    "text": "きょ、今日だった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010090"
  },
  {
    "id": 2015003010100,
    "speaker": "甜花",
    "text": "ご、ごめんなさい、プロデューサーさん……\r\n甜花……明日だと思ってた、から……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……事情はわかったよ\r\nとにかく、今は早いとこレッスンに行こう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003010110,
    "speaker": "甜花",
    "text": "で、でも……今から行ったら……遅刻で……\r\n先生、怒らない……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "たしかに怒られるかもな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003010120,
    "speaker": "甜花",
    "text": "ひぅっ……！\r\nや、やっぱり……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、遅れることは連絡してあるしな\r\nもし怒られたら、そのときは俺も一緒に謝るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015003010130,
    "speaker": "甜花",
    "text": "プロデューサーさん、も……？\r\nじゃあ……い、行ってみる……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500301/2015003010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\n俺は外で待ってるから、準備ができたら来てくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
