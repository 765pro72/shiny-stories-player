  {
    "id": 6014003070010,
    "speaker": "甘奈",
    "text": "あのね、プロデューサーさん\r\n甘奈やっぱり、今ここにいるのが怖いんだけど",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
