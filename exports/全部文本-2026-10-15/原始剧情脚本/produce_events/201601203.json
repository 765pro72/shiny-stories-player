      "time": 100
    },
    "voice": "produce_events/201601203/2016012030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030050,
    "speaker": "千雪",
    "text": "こんな素敵な景色……\r\n見られて本当に良かったです",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪が最後までやり遂げたおかげだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030060,
    "speaker": "千雪",
    "text": "ふふ、そうですか？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、おかげで俺まで得しちゃったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030070,
    "speaker": "千雪",
    "text": "そんなことはないですけど……\r\n本当に――赤い……ですね",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪の頬も\r\n紅葉が映ったみたいだったぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030080,
    "speaker": "千雪",
    "text": "そ、そんな……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、肌に赤みが映えて\r\n本当に千雪の絵とそっくりだった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "絵を描いてよかったな\r\nきっといいイメージトレーニングになった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030090,
    "speaker": "千雪",
    "text": "そうですね……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030090"
  },
  {
    "id": 2016012030100,
    "speaker": "千雪",
    "text": "久しぶりに絵を描いたら\r\n自分に向き合えた気がします",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで撮影がうまくいったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030110,
    "speaker": "千雪",
    "text": "はい、きっと",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030110"
  },
  {
    "id": 2016012030120,
    "speaker": "千雪",
    "text": "絵って……\r\nそういうものだったりも、するのかも",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030120"
  },
  {
    "id": 2016012030130,
    "speaker": "千雪",
    "text": "――よく描いたなぁ……\r\nちょうどこのくらいの時期で",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030140,
    "speaker": "千雪",
    "text": "いえ、ふふっ",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030140"
  },
  {
    "id": 2016012030150,
    "speaker": "千雪",
    "text": "ちょっと、センチメンタルな感じに\r\nなっちゃいました……",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030150"
  },
  {
    "id": 2016012030160,
    "speaker": "千雪",
    "text": "きっと、この景色のせいだなぁ……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん……なんか、わかるような気がするな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012030170,
    "speaker": "千雪",
    "text": "プロデューサーさんも\r\nセンチメンタルなんです……？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601203/2016012030170"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？　いや……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は、そういうんじゃないんだけど\r\nなんだろう、雰囲気というか……！",
