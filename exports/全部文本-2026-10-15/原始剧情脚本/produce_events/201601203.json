  {
    "id": 2016012030040,
    "speaker": "千雪",
    "text": "わぁ……！　すごい……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
