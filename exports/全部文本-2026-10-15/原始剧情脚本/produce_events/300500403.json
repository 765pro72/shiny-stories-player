    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500403/3005004030460"
  },
  {
    "id": 3005004030470,
    "speaker": "摩美々",
    "text": "それじゃー……このドレスに合う靴は？",
