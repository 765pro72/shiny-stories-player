    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500403/3005004030150"
  },
  {
    "id": 3005004030160,
    "speaker": "咲耶",
    "text": "だから、つまらないとは逆なんじゃないかってね\r\n違うかい？",
