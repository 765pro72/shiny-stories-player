  },
  {
    "speaker": "雑誌担当者",
    "text": "……──お疲れ様です、プロデューサーさん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\nお疲れ様です",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "雑誌担当者",
    "text": "白瀬さん、熱心に取り組んでくださって……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑誌担当者",
    "text": "いいものにしたいって、スタッフの士気も上がってるんです\r\nありがとうございます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "いえ、そんな！　こちらこそ\r\n恐れ入ります──！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "雑誌担当者",
    "text": "──実を言うと、意外に思ったんです\r\n白瀬さんからテーマについてお話を頂いた時",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑誌担当者",
    "text": "白瀬さんは、笑顔の印象が強かったので",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ええ",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 600
  },
  {
    "speaker": "プロデューサー",
    "text": "私も、新しい挑戦をさせていただいているなと\r\n思っています──",
    "textCtrl": "p",
    "textFrame": "002"
  },
