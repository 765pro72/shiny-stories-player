    },
    "voice": "produce_events/200601204/2006012040010"
  },
  {
    "speaker": "カメラマン",
    "text": "そうですね……！\r\nテーマ的には、その方が映えると思います",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006012040020,
    "speaker": "咲耶",
    "text": "もう何枚か撮らせていただくことって──",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601204/2006012040020"
  },
  {
    "speaker": "カメラマン",
    "text": "もちろん大歓迎です！\r\n一緒に最高の一枚を仕上げましょうね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006012040030,
    "speaker": "咲耶",
    "text": "──ありがとうございます！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
