  {
    "id": 2006012040040,
    "speaker": "咲耶",
    "text": "『私が一番撮りたい自分、伝えたい自分』の企画に\r\nつきまして",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
