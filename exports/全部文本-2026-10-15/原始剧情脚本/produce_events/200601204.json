  {
    "id": 2006012040010,
    "speaker": "咲耶",
    "text": "……もう少し、表情を鋭くした方がいいでしょうか",
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
