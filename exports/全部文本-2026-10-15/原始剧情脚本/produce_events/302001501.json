  {
    "id": 3020015010060,
    "speaker": "店主",
    "text": "お客様、\r\n相すみません、お待ちどおさまでございます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001501/3020015010060"
  },
  {
    "id": 3020015010070,
    "speaker": "客",
    "text": "もうできたのかい？\r\nどうもありがとう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001501/3020015010070"
  },
  {
    "textFrame": "off",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3020015010080,
    "speaker": "客",
    "text": "お、蕎麦屋さん、おめぇんとこ感心だねぇ\r\n箸は割り箸使ってるじゃねぇか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001501/3020015010080"
  },
  {
    "id": 3020015010090,
    "speaker": "客",
    "text": "器もいいねぇ。器がいいと、少しくらい中身が\r\nまずくたって……そりゃあ、まずくはねぇだろうけどもさ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001501/3020015010090"
  },
  {
    "id": 3020015010100,
    "speaker": "客",
    "text": "うまく感じるってぇやつだ\r\nありがてぇじゃねぇか、いただきますよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302001501/3020015010100"
  },
  {
    "textFrame": "off",
    "bg": "00487",
