    "waitTime": 5800,
    "voice": "produce_events/200400801/2004008010050"
  },
  {
    "id": 2004008010060,
    "speaker": "恋鐘",
    "text": "──くしゅん",
    "charAnim1": "smile2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "わっ、大丈夫か？　恋鐘",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010070,
    "speaker": "恋鐘",
    "text": "へ、平気ばい\r\n心配せんでよか……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "waitType": "time",
    "waitTime": 4200,
    "voice": "produce_events/200400801/2004008010070"
  },
  {
    "id": 2004008010080,
    "speaker": "恋鐘",
    "text": "──くしゅん",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……大丈夫、じゃないな\r\nやっぱりその服はまだ少し早かったんじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010090,
    "speaker": "恋鐘",
    "text": "ん～\r\nそうかもしれんね……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010090"
  },
  {
    "id": 2004008010100,
    "speaker": "恋鐘",
    "text": "朝起きた時は、今日こそいける～！",
    "charAnim1": "anger1",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "r",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010100",
    "voiceKeep": true
  },
  {
    "text": "って思ったとやけど……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "その服を着るの、ずっと楽しみにしてたんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010110,
    "speaker": "恋鐘",
    "text": "うん～！",
    "charAnim1": "wait5",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010110"
  },
  {
    "id": 2004008010120,
    "speaker": "恋鐘",
    "text": "おしゃれにはすこ～し我慢も必要って\r\nなんかにも書いてあったけん……",
    "charAnim1": "smile4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010120"
  },
  {
    "id": 2004008010130,
    "speaker": "恋鐘",
    "text": "心配せんでよかよ\r\nプロデューサー",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……風邪引いたら\r\n元も子もないだろ？",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お気に入りの服で出かけることも\r\n出来なくなるわけだし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010140,
    "speaker": "恋鐘",
    "text": "そ、それもそうやね……！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……事務所までまだ少し歩くし、\r\nせっかくの服が隠れちゃって悪いけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺の上着でよければ、貸そうか？",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0220"
  },
  {
    "id": 2004008010150,
    "speaker": "恋鐘",
    "text": "ふぇ！？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_a",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010150"
  },
  {
    "id": 2004008010160,
    "speaker": "恋鐘",
    "text": "よ、よかよ～……\r\nプロデューサーが寒くなってしまうたい",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は平気だよ\r\n着てもらえたほうが安心なんだけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010170,
    "speaker": "恋鐘",
    "text": "ば、ばってん──……",
    "charAnim1": "wait5",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "それなら、タクシーを拾って\r\n早めに事務所に着くようにしようか",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務所なら何か\r\n羽織るものくらいあるだろうし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010180,
    "speaker": "恋鐘",
    "text": "──えっ、ま、待たんね！　プロデューサー！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLabel": "kogane",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2004008010190,
    "speaker": "恋鐘",
    "text": "う、上着……\r\nほんとに借りてよかと……？",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは構わないけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010200,
    "speaker": "恋鐘",
    "text": "──じゃあ、うちそれ着て\r\n事務所まで歩きたか……！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……わかった\r\n恋鐘がそれでいいなら、そうしようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010210,
    "speaker": "恋鐘",
    "text": "うん～……！",
    "charAnim1": "smile3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "r",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010210",
    "voiceKeep": true
  },
  {
    "speaker": "恋鐘",
    "text": "ありがと～、プロデューサー",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "どういたしまして\r\n……しばらくそのお気に入りの服はお預けだぞ",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "風邪だけは引かないようにな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010220,
    "speaker": "恋鐘",
    "text": "は～い\r\n了解～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010220"
  },
  {
    "id": 2004008010230,
    "speaker": "恋鐘",
    "text": "──……そいでも、お気に入りの服出して\r\nそれ着てどこ行こ～って考えて……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010230"
  },
  {
    "id": 2004008010240,
    "speaker": "恋鐘",
    "text": "タンスの中、わくわく～ってなっとるけん\r\nもう少し暑か季節になったら……",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010240"
  },
  {
    "id": 2004008010250,
    "speaker": "恋鐘",
    "text": "そがん時になったら、\r\nい～っぱい思い出作りたか！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……そうだな",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "俺も早く\r\n衣替えしなきゃな！",
    "nextLabel": "1"
  },
  {
    "select": "色んな仕事に\r\n挑戦しような！",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "恋鐘はどんなことが\r\nしたいんだ？",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "……と言っても、恋鐘みたいにちゃんと\r\nタンスの中を入れ替えるわけじゃないんだけどな",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010260,
    "speaker": "恋鐘",
    "text": "ん～……そいやったら、\r\nどがんしよると？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな……薄手のジャケットから\r\nかけっぱなしのクリーニングのカバーを取って……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "長袖と半袖のワイシャツの順番を\r\n入れ替えるくらいかな……はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010270,
    "speaker": "恋鐘",
    "text": "そ、そいは衣替えやろか……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、まだやってなくて\r\nよかったのかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、この上着はちょっと厚手の生地だから\r\n寒さを凌ぐくらいは出来ると思うぞ！",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
