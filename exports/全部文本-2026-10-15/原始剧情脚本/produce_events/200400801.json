  {
    "id": 2004008010020,
    "speaker": "恋鐘",
    "text": "うち、この間のお休みに\r\nタンスの中、衣替えしたと！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nもうそんな時期か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004008010030,
    "speaker": "恋鐘",
    "text": "うん～……そうなんやけど",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010030"
  },
  {
    "id": 2004008010040,
    "speaker": "恋鐘",
    "text": "やっぱちょっと早かったかも\r\n夜はまだ肌寒かね～……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400801/2004008010040"
  },
  {
    "id": 2004008010050,
    "speaker": "恋鐘",
    "text": "ばってん、このお気に入りの服ば\r\n早く着れて嬉し──……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
