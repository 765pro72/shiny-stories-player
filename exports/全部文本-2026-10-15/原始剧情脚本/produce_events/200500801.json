      "time": 100
    },
    "voice": "produce_events/200500801/2005008010060"
  },
  {
    "id": 2005008010070,
    "speaker": "摩美々",
    "text": "パープル・ミラージュ──\r\n夏の限定色なんですよー",
    "charAnim1": "play",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………ネイルだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010080,
    "speaker": "摩美々",
    "text": "ですねー",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……摩美々",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今回は仕方ないが……\r\n事務所はみんなが使う場なんだ",
    "charAnim2": "face_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "次からは、窓を開けて換気するとかで\r\nにおいがこもらないよう気を遣ってほしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010090,
    "speaker": "摩美々",
    "text": "ふふー\r\n覚えてたら気を付けまぁす",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……覚えてたら、か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "それなら俺にも\r\n策がある",
    "nextLabel": "1"
  },
  {
    "select": "最悪、没収だからな",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "摩美々、ネイルが\r\n好きなのか？",
    "nextLabel": "3"
  },
  {
    "id": 2005008010100,
    "label": "1",
    "speaker": "摩美々",
    "text": "策……？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n事務所内に貼り紙をするんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『事務所内でネイルを塗る際は\r\n窓を開けて換気すること』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010110,
    "speaker": "摩美々",
    "text": "はあ……",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010110"
  },
  {
    "id": 2005008010120,
    "speaker": "摩美々",
    "text": "……なんかめんどーなことになりましたねー",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだ、ついでに他の禁止事項も貼り紙しておくか\r\nえーと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『事務所内の無断飾り付け禁止』\r\n『ビリビリペンの持ち込み禁止』……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010130,
    "speaker": "摩美々",
    "text": "えー……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010130"
  },
  {
    "charAnim2": "face_close",
