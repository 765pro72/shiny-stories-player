    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010170"
  },
  {
    "id": 2005008010180,
    "speaker": "摩美々",
    "text": "撮影用の水着、よさそうなの見つけたんでー\r\n後で画像、送っておきますねー",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！　ああ……！\r\nさっきの説明、ちゃんと聞いてたのか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010190,
    "speaker": "摩美々",
    "text": "まぁ……",
