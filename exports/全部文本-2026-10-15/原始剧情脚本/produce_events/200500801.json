    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200500801/2005008010140"
  },
  {
    "textFrame": "off"
  },
  {
    "id": 2005008010150,
    "label": "2",
    "speaker": "摩美々",
    "text": "えー\r\nそれはちょっと、厳しすぎるんじゃないですかぁ",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々が気を付けてくれさえすれば\r\n没収なんてしなくて済むんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺だって、あまり荒っぽい手は使いたくないよ\r\nわかってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010160,
    "speaker": "摩美々",
    "text": "…………\r\nそーですね、覚えてたらぁ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……",
