    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──摩美々\r\n今度の撮影についてなんだが",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010030,
    "speaker": "摩美々",
    "text": "はいー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "テーマは『田中摩美々の亜熱帯』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏をイメージした特集で、\r\n色んなシチュエーションを撮りたいということだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010040,
    "speaker": "摩美々",
    "text": "はいー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、何度かに分けて撮影を──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010050,
    "speaker": "摩美々",
    "text": "はいー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500801/2005008010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……聞いてないな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……というか、さっきから\r\nすごいにおいがするんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005008010060,
    "speaker": "摩美々",
    "text": "……ああ、これですかぁ？\r\nふふー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
