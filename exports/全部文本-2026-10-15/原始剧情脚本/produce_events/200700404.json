  },
  {
    "id": 2007004040300,
    "speaker": "結華",
    "text": "ブランケットまで持ってきてくれてるのに、\r\n見てないって……！　ふふっ……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700404/2007004040300"
  },
  {
    "id": 2007004040310,
    "speaker": "結華",
    "text": "Ｐたんたまにすごいこと言うよね？\r\nふふっ、はぁ、おっかしー……！",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
