    "voice": "produce_events/200700404/2007004040310"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、まぁ、それはそうなんだけどな？\r\nでもほら、そういうことにしておこう、みたいな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007004040320,
    "speaker": "結華",
    "text": "三峰のために？",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700404/2007004040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そのつもりだった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007004040330,
    "speaker": "結華",
    "text": "そっかそっか\r\n……ふふっ、ありがとね",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700404/2007004040330"
  },
  {
    "id": 2007004040340,
    "speaker": "結華",
    "text": "Ｐたんのおかげで、なんかもう見られてもいいじゃんって\r\n気がしてきたよ",
    "charAnim1": "shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700404/2007004040340"
  },
  {
