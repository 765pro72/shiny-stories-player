    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020490"
  },
  {
    "id": 3003017020500,
    "speaker": "灯織",
    "text": "『普通のビックリっていうか……\r\n可愛すぎてビックリ、みたいな、動物の映像も多くて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020500"
  },
  {
    "id": 3003017020510,
    "speaker": "灯織",
    "text": "『よちよち歩きの子パンダとか、\r\nカルガモ親子の引っ越しとか……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020510"
  },
  {
    "id": 3003017020520,
    "speaker": "めぐる",
    "text": "あー……！\r\nそれは可愛い……！",
    "charAnim1": "think",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020520"
  },
  {
    "id": 3003017020530,
    "speaker": "灯織",
    "text": "『うん\r\n他にもヒヨコとかフクロウとか、鳥も割とあって』",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020530"
  },
  {
    "id": 3003017020540,
    "speaker": "灯織",
    "text": "『真乃にも見てほしかった』",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020540"
  },
  {
    "id": 3003017020550,
    "speaker": "灯織",
    "text": "『……あ、いや\r\nオンエア分で見られるんだけど……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020550"
  },
  {
    "id": 3003017020560,
    "speaker": "めぐる",
    "text": "ううん、わかる！\r\n一刻も早くってことだよね……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020560"
  },
  {
    "id": 3003017020570,
    "speaker": "灯織",
    "text": "『……うん』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020570"
  },
  {
    "id": 3003017020580,
    "speaker": "めぐる",
    "text": "そういうのもあるよねー！\r\n『今日絶対わたしじゃなかった！』みたいな",
    "charAnim1": "sad1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020580"
  },
  {
    "id": 3003017020590,
    "speaker": "灯織",
    "text": "『うん。ありがたいのは本当にそうだし、\r\n自分だって精一杯やるのはもちろんなんだけど』",
    "charAnim2": "face_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020590"
  },
  {
    "id": 3003017020600,
    "speaker": "めぐる",
    "text": "アイドルじゃない部分のわたしが\r\n今回だったら真乃のことを呼ぶんだよね！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020600"
  },
  {
    "id": 3003017020610,
    "speaker": "めぐる",
    "text": "『なんで今真乃いないのー！』って",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020610"
  },
  {
    "id": 3003017020620,
    "speaker": "灯織",
    "text": "『それ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020620"
  },
  {
    "id": 3003017020630,
    "speaker": "めぐる",
    "text": "えへへっ\r\n今日はふたりとも真乃の日だったわけだ！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020630"
  },
  {
    "id": 3003017020640,
    "speaker": "灯織",
    "text": "『ふふ、真乃の日』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020640"
  },
  {
    "id": 3003017020650,
    "speaker": "めぐる",
    "text": "ちなみに、この間は灯織の日だったよ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020650"
  },
  {
    "id": 3003017020660,
    "speaker": "灯織",
    "text": "『それで言ったら私だって\r\nめぐるの日、あったよ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301702/3003017020660"
  },
