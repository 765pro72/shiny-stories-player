    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010160"
  },
  {
    "id": 3012002010170,
    "speaker": "智代子",
    "text": "そんなっ……伝わらない……！？\r\n凛世ちゃんは？　凛世ちゃんはきゅんきゅんするよね！？",
