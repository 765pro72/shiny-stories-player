    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010140"
  },
  {
    "id": 3012002010150,
    "speaker": "智代子",
    "text": "そこがいいんだよー！　考えてみて！？\r\nこれ、好きな人に言われちゃったら……！",
