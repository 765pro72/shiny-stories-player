    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010050"
  },
  {
    "id": 3012002010060,
    "speaker": "智代子",
    "text": "あっ、夏葉ちゃん！\r\n漫画の話だよー。凛世ちゃんに貸してたの",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
