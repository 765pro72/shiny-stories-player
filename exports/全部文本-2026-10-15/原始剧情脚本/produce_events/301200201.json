    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010130"
  },
  {
    "id": 3012002010140,
    "speaker": "夏葉",
    "text": "……少し、キザすぎないかしら？",
