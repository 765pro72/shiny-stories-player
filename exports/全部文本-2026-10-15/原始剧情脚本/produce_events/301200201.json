    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010110"
  },
  {
    "id": 3012002010120,
    "speaker": "智代子",
    "text": "セリフの一つひとつがね、こう……胸にくるんだぁ\r\n……ほら、こういうのとか！",
