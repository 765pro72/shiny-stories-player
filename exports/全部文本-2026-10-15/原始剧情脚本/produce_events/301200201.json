    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010120"
  },
  {
    "id": 3012002010130,
    "speaker": "夏葉",
    "text": "ふぅん……\r\n『今日は帰さないからな。お前の答えを聞くまで……』",
