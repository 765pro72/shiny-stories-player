    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010090"
  },
  {
    "id": 3012002010100,
    "speaker": "夏葉",
    "text": "そういえば、あまり読まないわね……\r\nでも、興味はあるわ！",
