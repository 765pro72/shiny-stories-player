    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010060"
  },
  {
    "id": 3012002010070,
    "speaker": "凛世",
    "text": "はい……\r\n良いものを……お借りできました……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010070"
  },
  {
    "id": 3012002010080,
    "speaker": "夏葉",
    "text": "へぇ……\r\nこれは恋愛もの？",
