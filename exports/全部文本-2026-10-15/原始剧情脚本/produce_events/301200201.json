    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010080"
  },
  {
    "id": 3012002010090,
    "speaker": "智代子",
    "text": "そうそう、少女漫画！\r\n夏葉ちゃんもこういうの読む？",
