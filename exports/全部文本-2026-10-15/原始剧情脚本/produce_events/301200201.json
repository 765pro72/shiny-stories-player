    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200201/3012002010100"
  },
  {
    "id": 3012002010110,
    "speaker": "智代子",
    "text": "あっ、興味ある？\r\nほんとに面白いから、興味あったら読んでほしい！",
