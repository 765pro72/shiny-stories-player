    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800603/2018006030060"
  },
  {
    "id": 2018006030070,
    "speaker": "冬優子",
    "text": "本番前に絆創膏貼れたし、\r\nそんな大変なことにはなってないと思うけど……",
