    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800603/2018006030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまない！\r\n俺、全然気付かなくて……",
