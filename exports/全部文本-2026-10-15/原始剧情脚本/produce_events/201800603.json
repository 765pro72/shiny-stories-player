  {
    "speaker": "プロデューサー",
    "text": "ああ、カバンに入ってるはずだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018006030050,
    "speaker": "冬優子",
    "text": "そ。なら二枚もらってもいい？\r\nさっき使い切っちゃったのよね",
