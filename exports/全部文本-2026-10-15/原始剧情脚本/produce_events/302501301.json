    "autoWaitTime": 1000
  },
  {
    "speaker": "少女",
    "text": "────大丈夫！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間１",
    "text": "……とか言って、この前ぶっ倒れてたじゃん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間１",
    "text": "ほら、水分取って休憩しな！\r\n仲間との交流も大事にしなってー",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0328"
  },
