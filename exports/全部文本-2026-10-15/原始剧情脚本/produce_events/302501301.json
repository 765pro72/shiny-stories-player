    "bgEffectTime": 800
  },
  {
    "speaker": "ダンサー仲間３",
    "text": "あー、あれじゃん？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間３",
    "text": "あたしらは面白系じゃないよーってとこ、\r\nアピールしときたいんじゃないのー？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間２",
    "text": "うーわ、アイドルって大変～！",
