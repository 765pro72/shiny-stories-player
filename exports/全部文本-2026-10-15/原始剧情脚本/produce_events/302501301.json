  {
    "speaker": "ダンサー仲間１",
    "text": "ねーえ、\r\nちょっとは休憩しなよー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間１",
    "text": "朝からそのペースでやってたらマジでぶっ倒れるからー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "少女",
    "text": "…………はっ、はっ……",
    "textCtrl": "p",
    "textFrame": "003",
