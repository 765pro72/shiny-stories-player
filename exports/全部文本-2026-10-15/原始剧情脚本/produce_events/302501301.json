  {
    "speaker": "ダンサー仲間２",
    "text": "えー、ちょ、何これ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間１",
    "text": "ん、どしたー？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間２",
    "text": "このダンスコンテスト、シーズのふたりも出るんだって",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0454"
  },
  {
    "speaker": "ダンサー仲間２",
    "text": "ね、これさ\r\nあんたも出るやつだよねー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "少女",
    "text": "……ああ、うん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間１",
    "text": "え、うそ。マジで？\r\n十分、露出してんのにね、あの人たちー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ダンサー仲間２",
    "text": "確かに\r\n最近、まぁまぁいろんなテレビとか出てるよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
