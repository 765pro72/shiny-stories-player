  },
  {
    "id": 2011019010280,
    "speaker": "樹里",
    "text": "声は聞こえないけど、なんとなく伝わってくるんだよな\r\n『久しぶり！』とか『元気だった？』って話してるのがさ",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
