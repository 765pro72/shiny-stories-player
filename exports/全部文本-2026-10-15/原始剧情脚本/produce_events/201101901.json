      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201101901/2011019010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういう……ファン同士の絆はさ\r\n他の誰でもない樹里がつくったんだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011019010290,
    "speaker": "樹里",
    "text": "……ん",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010290",
    "autoWaitTime": 1200
  },
  {
    "id": 2011019010300,
    "speaker": "樹里",
    "text": "──うし！\r\n今日も目一杯、楽しんでもらうか！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、その意気だ\r\n今日は本当にてんこ盛りだしな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011019010310,
    "speaker": "樹里",
    "text": "一部がお悩み相談コーナー、二部がミニライブだからなー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010310"
  },
  {
    "speaker": "プロデューサー",
    "text": "席もしっかり埋まったし\r\nいいイベントになるといいなって、心から思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011019010320,
    "speaker": "樹里",
    "text": "うん……",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010320",
    "autoWaitTime": 1000
  },
  {
    "id": 2011019010330,
    "speaker": "樹里",
    "text": "ラジオが始まってから、スタッフさんには\r\nずーっとお世話になりっぱなしだったし",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010330"
  },
  {
    "id": 2011019010340,
    "speaker": "樹里",
    "text": "今日のイベント成功させて少しでも恩返ししねーと",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010340"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 800
  },
  {
    "id": 2011019010350,
    "speaker": "樹里",
    "text": "？　どうした？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010350"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……さ\r\n樹里のそういうとこ、変わらないなと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつだって周りの人の気持ちを尊重して、大切にしてさ\r\n樹里のそういうとこ、本当に素敵だなって思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011019010360,
    "speaker": "樹里",
    "text": "……真顔でそういうこと言われるの、\r\nこっちは全然慣れねーけどな",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010360"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、そっか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011019010370,
    "speaker": "樹里",
    "text": "言っとくけど、ここまで連れてきてくれたのは\r\nプロデューサーなんだからな",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/201101901/2011019010370"
  },
  {
    "select": "そうかも\r\nしれない、けど",
    "nextLabel": "1"
