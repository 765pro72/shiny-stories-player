    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2003011020180,
    "speaker": "めぐる",
    "text": "あのねっ！　ウェディングドレス、\r\n動いても大丈夫そうだから、スタッフさんに伝えてくる！",
    "charAnim1": "touch",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020180"
  },
  {
    "speaker": "プロデューサー",
