  },
  {
    "speaker": "プロデューサー",
    "text": "（今の……夢……？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011020110,
    "speaker": "めぐる",
    "text": "……プロデューサー？　どうしたの？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020110"
  },
  {
    "id": 2003011020120,
    "speaker": "めぐる",
    "text": "なんか変な顔してるけど……\r\nもしかして、どこか変だったりする……？",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020120"
  },
  {
    "charAnim1": "wait",
    "charLabel": "meguru",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "（昨日、資料を読み返したせいかな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、すまん。なんでもないんだ\r\nすごく似合ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "アイドルの衣装もドレスっぽいけどさ\r\nやっぱりウェディングドレスとなると、だいぶ印象が違うな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011020130,
    "speaker": "めぐる",
    "text": "えへへっ、そう……？\r\n自分じゃわからないけど……！",
    "charAnim1": "touch",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200301102/2003011020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺もうまく言えないんだけど\r\n初めて見るめぐるっていうか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011020140,
    "speaker": "めぐる",
    "text": "あっ着られてる感あるってことかな……！？\r\nわたしも思ってたんだよね……！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……\r\n…………そういうことなのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011020150,
    "speaker": "めぐる",
    "text": "うん……なんでだろう……\r\nちょっと違うなって思うんだー",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020150"
  },
  {
    "id": 2003011020160,
    "speaker": "めぐる",
    "text": "花嫁さんになれてないっていうか……",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん\r\n俺は全然そんなことないと思うけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011020170,
    "speaker": "めぐる",
    "text": "ぷっ、プロデューサー……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020170"
  },
  {
    "charAnim1": "wait1",
