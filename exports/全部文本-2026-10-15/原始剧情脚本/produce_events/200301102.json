  {
    "id": 2003011020010,
    "speaker": "めぐる",
    "text": "あっあれ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020010"
  },
  {
    "speaker": "スタッフ",
    "text": "大丈夫ですか？　ちょっと触りますね\r\nブライダルインナー、着慣れないですよねー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2003011020020,
    "speaker": "めぐる",
    "text": "えへへ、ありがとうございます！\r\nこういうものを着るって知りませんでした……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020020"
  },
  {
    "speaker": "スタッフ",
    "text": "これがあるのとないのでは、全然見た目が違うんですよ\r\n苦しくないですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003011020030,
    "speaker": "めぐる",
    "text": "大丈夫です……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020030"
  },
  {
    "id": 2003011020040,
    "speaker": "めぐる",
    "text": "ドレスって着ればオッケー！　ってわけじゃないんですね\r\n花嫁さんって大変なんだなー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020040"
  },
  {
    "speaker": "スタッフ",
    "text": "ふふっ……よし、これで大丈夫！\r\nじゃあ、お待ちかねのドレス、着てみましょう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003011020050,
    "speaker": "めぐる",
    "text": "はーい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020050"
  },
  {
    "speaker": "スタッフ",
    "text": "今日の試着で着用感を確認して、\r\n本番までに調整しておく感じです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ",
    "text": "気になったところはドンドン言ってくださいね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003011020060,
    "speaker": "めぐる",
    "text": "はい！　よろしくお願いしまーす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（なんていうか……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（仕事というより、付き添いの気分になるな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "スタッフ",
    "text": "どうですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003011020070,
    "speaker": "めぐる",
    "text": "ピッタリです！\r\n調整とか要らないくらい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020070"
  },
  {
    "speaker": "スタッフ",
    "text": "ふふっ、よかった\r\n動くと違うこともあるので、ちょっと歩いてみてください",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003011020080,
    "speaker": "めぐる",
    "text": "あっ！　じゃあじゃあ、\r\nプロデューサーに見てもらってもいいですか！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301102/2003011020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "スタッフ",
    "text": "もちろん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
