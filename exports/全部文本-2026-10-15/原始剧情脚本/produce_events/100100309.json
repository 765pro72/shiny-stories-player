    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──わ、すまん\r\n鳩、みんな飛んでっちゃったか……驚かせちゃったよな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "005"
  },
  {
    "id": 1001003090020,
    "speaker": "真乃",
    "text": "ふふ……いえ……っ\r\n鳩さんたち、きっと大丈夫です……っ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか？\r\nいや、でも──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003090030,
    "speaker": "真乃",
    "text": "……ふふっ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003090040,
    "speaker": "真乃",
    "text": "す、すみません\r\n前にも同じようなことがあったなって思って",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか\r\n確かにそうだったかもな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003090050,
    "speaker": "真乃",
    "text": "……あの時は、しょんぼりしていた私を\r\nプロデューサーさんが励ましてくれました",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090050"
  },
  {
    "charAnim1": "wait2",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1001003090060,
    "speaker": "真乃",
    "text": "……あの、事務所に戻る前に少しだけ、\r\nここでお話聞いてもらってもいいでしょうか……っ",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ、もちろんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もともと、休憩しようって\r\n立ち寄ったんだしさ、ゆっくりしていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile_s",
