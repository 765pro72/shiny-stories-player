  },
  {
    "id": 1001003090070,
    "speaker": "真乃",
    "text": "……プロデューサーさん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090070"
  },
  {
    "id": 1001003090080,
    "speaker": "真乃",
    "text": "私、あの時は、変わらなきゃって\r\nそればかり考えていました",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090080"
  },
  {
    "id": 1001003090090,
    "speaker": "真乃",
    "text": "……でも、\r\n『変わること』が本当に必要なのは……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090090"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1001003090100,
    "speaker": "真乃",
    "text": "臆病な自分を変えなきゃって思っていた、\r\nアイドルになる前の自分……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090100"
  },
  {
    "id": 1001003090110,
    "speaker": "真乃",
    "text": "アイドルじゃない時の自分だったんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090110"
  },
  {
    "id": 1001003090120,
    "speaker": "真乃",
    "text": "……それが、いつの間にか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090120"
  },
  {
    "id": 1001003090130,
    "speaker": "真乃",
    "text": "アイドルでいられるためには、『変わること』が\r\n必要なんだって、そう思い込んでいました……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090130"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00013",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1001003090140,
    "speaker": "真乃",
    "text": "……でも今は──アイドル櫻木真乃に必要なのは\r\n『変わること』だけじゃないってわかりました……",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100100309/1001003090140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003090150,
    "speaker": "真乃",
    "text": "灯織ちゃん、めぐるちゃんと一緒に\r\nアイドルでいられるのがうれしくて……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090150"
  },
  {
    "id": 1001003090160,
    "speaker": "真乃",
    "text": "２８３プロで、プロデューサーさんや、\r\n事務所のみなさんと過ごせるのがうれしくて……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090160"
  },
  {
    "id": 1001003090170,
    "speaker": "真乃",
    "text": "私は、ひとりですけれど……\r\nでも、ひとりじゃないんだって思い出したんです……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003090180,
    "speaker": "真乃",
    "text": "それに、ファンのみなさんも……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090180"
  },
  {
    "id": 1001003090190,
    "speaker": "真乃",
    "text": "今回、私が『G.R.A.D.』のステージに立てたのも、\r\nたくさんの声援に支えられたおかげでした……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090190"
  },
  {
    "id": 1001003090200,
    "speaker": "真乃",
    "text": "だから、これからも変わらず、アイドルとして\r\nファンのみなさんに『ありがとう』を返していきたいですっ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090200"
  },
  {
    "id": 1001003090210,
    "speaker": "真乃",
    "text": "そのためにも今は、自分に何ができるのか\r\nしっかりと考えて、伸ばしていきたいと思いますっ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090210"
  },
  {
    "id": 1001003090220,
    "speaker": "真乃",
    "text": "──臆病な自分は、\r\nまだ私の中にいるままですけれど……",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100309/1001003090220"
  },
  {
    "speaker": "プロデューサー",
    "text": "……大丈夫だ。それをちゃんとわかってる分だけ\r\n真乃はどんなふうにも成長していけるさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに……俺も、真乃のよさを伸ばせるように、\r\n変わらずしっかりサポートしていくよ……！",
