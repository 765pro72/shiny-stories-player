    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/701500104/7901001040020"
  },
  {
    "id": 7902001040010,
    "speaker": "社長",
    "text": "しかし、新人アイドルと新人プロデューサーにしては、\r\n悪くない結果だった",
