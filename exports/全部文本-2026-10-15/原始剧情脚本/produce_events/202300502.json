  },
  {
    "id": 2023005020260,
    "speaker": "雛菜",
    "text": "雛菜、別にもうひとつの方を\r\nやりたくなかったわけじゃないよ",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300502/2023005020260"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、そうだよな",
