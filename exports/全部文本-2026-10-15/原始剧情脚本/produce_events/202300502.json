    "text": "そんなの、\r\n……すぐにわかるよ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300502/2023005020230"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……そうか",
