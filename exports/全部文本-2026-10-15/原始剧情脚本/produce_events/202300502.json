    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005020240,
    "speaker": "雛菜",
    "text": "……プロデューサーは、それでいいの？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300502/2023005020240"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん、いいに決まってるよ\r\n雛菜がちゃんと考えて出した答えならさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005020250,
    "speaker": "雛菜",
    "text": "それならいいけど～……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
