  {
    "speaker": "プロデューサー",
    "text": "今日の行き先は電車だと行きづらいからな\r\n気にしないでくれ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003020020,
    "speaker": "愛依",
    "text": "アハハ、送迎とかちょー\r\nアイドルってカンジすんね～！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900302/2019003020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうかもな\r\nこれくらいで良かったら、いつでもやるぞ",
    "charAnim2": "face_smile2",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003020030,
    "speaker": "愛依",
    "text": "マジで～！？\r\nじゃあ、今度ドライブでもする？",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900302/2019003020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん\r\n仕事以外はダメだからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003020040,
    "speaker": "愛依",
    "text": "アハハ、わかってるよ～\r\nちょっと言ってみただけ～",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900302/2019003020040"
  },
  {
    "id": 2019003020050,
    "speaker": "愛依",
    "text": "行き先ってここからどんくらいなの？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900302/2019003020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "２時間くらいかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003020060,
    "speaker": "愛依",
    "text": "へぇ～結構かかんだね",
