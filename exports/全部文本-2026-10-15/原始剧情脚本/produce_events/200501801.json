  {
    "speaker": "先輩アイドル",
    "text": "ふ～～終わった～～\r\n摩美々ちゃんもお疲れ様～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010010,
    "speaker": "摩美々",
    "text": "お疲れ様ですー",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040050110",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200501801/2005018010010"
  },
  {
    "speaker": "先輩アイドル",
    "text": "番組、盛り上がったね！\r\n摩美々ちゃん、すごくよかったよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010020,
    "speaker": "摩美々",
    "text": "そうですかぁ\r\nありがとうございますー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010020"
  },
  {
    "speaker": "先輩アイドル",
    "text": "どう？\r\n手応えはあった？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010030,
    "speaker": "摩美々",
    "text": "手応え……私はそういうの\r\nあんまり気にしてないですケド……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010030"
  },
  {
    "speaker": "先輩アイドル",
    "text": "ふふ、そっか……余裕の強気だね～\r\nさすがはアンティーカ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010040,
    "speaker": "摩美々",
    "text": "手応えとか、けっこう気にされてるんですかぁ？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010040"
  },
  {
    "speaker": "先輩アイドル",
    "text": "モチロンだよ！\r\n私はいつも、そんなことばっか考えてるかな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010050,
    "speaker": "摩美々",
    "text": "ふーん……\r\nじゃー、今日はどうだったんですかぁ？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010050"
  },
  {
    "speaker": "先輩アイドル",
    "text": "うん……\r\n今日は、自分の中ではけっこうよかったと思う",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "それなりにアピールもできたし、\r\nいいことも言えたから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "だから、テロップにしてもらえたらって……\r\nちょっと期待かな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010060,
    "speaker": "摩美々",
    "text": "……\r\nいろいろ考えてるんですねー",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010060"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi1",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00520",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "先輩アイドル",
    "text": "そりゃあ厳しい世界だからね\r\n必要ないアイドルは淘汰されていくわけだし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "だから、常に番組が……\r\n世間が欲しいものを提供することが大事だと思う────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010070,
    "speaker": "摩美々",
    "text": "……私は気にせず、\r\nやりたいように、やりたいですケドー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010070"
  },
  {
    "speaker": "先輩アイドル",
    "text": "ふふ……アンティーカはまだこれからが\r\n期待できるアイドルだからいいかもしれないけど──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00009",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "先輩アイドル",
    "text": "私がいる『ファンタジアガールズ』は\r\n昔の勢いがなくなってきちゃってるし……",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "003",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "speaker": "先輩アイドル",
    "text": "だから、今はまだいいかもしれないけど",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "摩美々ちゃんだって\r\n数少ない機会で結果を残しておかないと",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "そのうち、\r\n誰も見つけてくれなくなっちゃうかもよ～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi1",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2200
  },
  {
    "speaker": "先輩アイドル",
    "text": "ふふふ、なんてね！\r\nまぁ、私たちは隔週の固定ゲストだし、気楽にやっていこ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "先輩アイドル",
    "text": "じゃあ、次回もよろしくね\r\nお疲れ様～",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi1",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2005018010080,
    "speaker": "摩美々",
    "text": "お疲れ様でしたぁ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi1",
    "textCtrl": "p",
