    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、摩美々なりにマジックを楽しんでくれたら、\r\n視聴者も楽しめると思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうかな？\r\nたくさんの人が見る特番だし、いい機会になると思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005018010200,
    "speaker": "摩美々",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501801/2005018010200"
  },
