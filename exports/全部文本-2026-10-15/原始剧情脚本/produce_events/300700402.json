    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020240"
  },
  {
    "id": 3007004020250,
    "speaker": "結華",
    "text": "見せて見せてー。……ふんふん。おっけー",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020250"
  },
  {
    "id": 3007004020260,
    "speaker": "結華",
    "text": "何軒か回る必要ありそうだけど、多分揃うと思うよ\r\nあ、古本屋は使っても大丈夫？",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020260"
  },
  {
    "id": 3007004020270,
    "speaker": "霧子",
    "text": "う、うん……！\r\nありがとう。結華ちゃん……すごいな……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020270"
  },
  {
    "id": 3007004020280,
    "speaker": "恋鐘",
    "text": "うちも何軒でも付き合うけんね！\r\n張りきって探すば～い！",
