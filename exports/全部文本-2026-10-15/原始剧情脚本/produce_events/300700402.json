    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020400"
  },
  {
    "id": 3007004020410,
    "speaker": "結華",
    "text": "ふたりの心の中で止めといて～",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020410"
  },
  {
    "id": 3007004020420,
    "speaker": "恋鐘",
    "text": "なんをそんなに心配しとると？\r\n結華が選んだの、全部面白そうだったばい！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020420"
  },
  {
    "id": 3007004020430,
    "speaker": "霧子",
    "text": "う、うん……わたしもそう思う……",
    "charAnim1": "wait2",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charAnim3Loop": false,
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020430"
  },
  {
    "id": 3007004020440,
    "speaker": "結華",
    "text": "──そっか\r\nこがたんときりりんがそう言ってくれるなら充分だよ",
