    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020340"
  },
  {
    "id": 3007004020350,
    "speaker": "結華",
    "text": "ほんと？　なら良かった。……まぁ中身はともあれ、\r\nきりりんの優しさには感動しちゃうんじゃないかな？",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020350"
  },
  {
    "id": 3007004020360,
    "speaker": "結華",
    "text": "喜んでもらえるといいねぇ",
