    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020360"
  },
  {
    "id": 3007004020370,
    "speaker": "霧子",
    "text": "うん……！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020370"
  },
  {
    "id": 3007004020380,
    "speaker": "恋鐘",
    "text": "せっかくやし、霧子は感想聞いてこんといかんね！\r\nそれにうちらも読んでみたか！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020380"
  },
  {
    "id": 3007004020390,
    "speaker": "霧子",
    "text": "うん……\r\n待ってて、結華ちゃん……！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020390"
  },
  {
    "id": 3007004020400,
    "speaker": "結華",
    "text": "や、そんなお構いなく！\r\nもし酷評食らったら三峰のガラスのハートが割れちゃうから",
