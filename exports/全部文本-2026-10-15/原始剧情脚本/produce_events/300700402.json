    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700402/3007004020330"
  },
  {
    "id": 3007004020340,
    "speaker": "霧子",
    "text": "はやく……渡してあげたい\r\n入院で、不安そうな子がいて……",
