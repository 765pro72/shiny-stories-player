    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020060",
    "charAnim3Loop": false
  },
  {
    "id": 3007002020070,
    "speaker": "結華",
    "text": "霧子、今日もかわいいね",
    "charAnim1": "anger1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020070"
  },
  {
    "id": 3007002020080,
    "speaker": "霧子",
    "text": "……え、\r\nゆ、結華ちゃん……？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020080"
  },
  {
    "id": 3007002020090,
    "speaker": "結華",
    "text": "ふふ、顔を赤くしてどうしたんだい？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020090"
  },
  {
    "id": 3007002020100,
    "speaker": "結華",
    "text": "目を逸らさないでほしいな\r\n霧子の瞳は、すごく綺麗なんだから",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020100"
  },
  {
    "id": 3007002020110,
    "speaker": "霧子",
    "text": "……！\r\nえ……と、あの……",
