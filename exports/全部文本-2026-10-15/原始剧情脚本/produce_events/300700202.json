    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020120"
  },
  {
    "id": 3007002020130,
    "speaker": "咲耶",
    "text": "フフ、そんなに上等なものじゃないんだけれどね",
