    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020110"
  },
  {
    "id": 3007002020120,
    "speaker": "結華",
    "text": "ね？　こういうの、絶対様になるじゃん？\r\n憧れちゃうよねぇ",
