    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020130"
  },
  {
    "id": 3007002020140,
    "speaker": "咲耶",
    "text": "でも、さっきの結華はかっこよかったな",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020140"
  },
  {
    "id": 3007002020150,
    "speaker": "結華",
    "text": "本家にそう言われてもなぁ\r\nさくやんのほうがかっこいいもん",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020150"
  },
  {
    "id": 3007002020160,
    "speaker": "結華",
    "text": "三峰の背がもっと高かったら、\r\nさくやんくらいの身長だったら……！",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020160"
  },
  {
    "id": 3007002020170,
    "speaker": "結華",
    "text": "まず、もっとお姉さんな服が似合うようになるでしょー\r\n三峰の魅力に大人っぽさも足されちゃうかもしれないしー",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020170"
  },
  {
    "id": 3007002020180,
    "speaker": "結華",
    "text": "高いところのものも踏み台なしで取れちゃうから\r\n便利だろうし……",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700202/3007002020180"
  },
  {
    "id": 3007002020190,
    "speaker": "結華",
    "text": "満員電車で押しつぶされなかったりもするよね！　絶対！",
    "charAnim1": "anger2",
