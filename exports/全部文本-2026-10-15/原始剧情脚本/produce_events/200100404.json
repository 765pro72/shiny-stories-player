    },
    "bgm": "002",
    "bg": "00003"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "よし、今日の撮影は終わりだ\r\n真乃、お疲れ様",
    "textCtrl": "p"
  },
  {
    "id": 2001004040010,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はい、今日は屋外の撮影だったので楽しかったです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040010"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "じゃあ、今日はレッスンも仕事も終わりだから、\r\n早めに帰って休むといいよ",
    "textCtrl": "p"
  },
  {
    "id": 2001004040020,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はいっ\r\n……でもその",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100404/2001004040020"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ん？　どうしたんだ？",
    "textCtrl": "p"
  },
  {
    "id": 2001004040030,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "今日はとってもいいお天気なので、\r\nまだお日様の下にいて身体を動かしたくて……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100404/2001004040030"
  },
  {
    "id": 2001004040040,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "だから、まだ帰らずにお出かけしてもいいですか？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040040"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "そうか\r\n……うん、それくらいはいいんじゃないか",
    "textCtrl": "p"
  },
  {
    "id": 2001004040050,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ありがとうございます\r\nじゃあ、行きましょう",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040050"
  },
  {
    "textFrame": "off"
  },
  {
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "……ん？　俺もか？",
    "textCtrl": "p"
  },
  {
    "id": 2001004040060,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわ……\r\nそうでした、私ってば勝手に……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100404/2001004040060"
  },
  {
    "id": 2001004040070,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわわ……プロデューサーさんと一緒にいることが\r\n増えたから、つい勝手な思い込みを……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100404/2001004040070"
  },
  {
    "id": 2001004040080,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "いつも一緒にいるものだって思ってしまうなんて\r\n私ってば……私ってば……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100404/2001004040080"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、そういうことか\r\nじゃあ、これから一緒に出かけよう",
    "textCtrl": "p"
  },
  {
    "id": 2001004040090,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "え、いいんですか……\r\n本当はお忙しいんですよね？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100404/2001004040090"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "いつでもできる事務仕事だけだよ\r\nどこか行きたいところあるかな？",
    "textCtrl": "p",
    "charLabel": "mano"
  },
  {
    "id": 2001004040100,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ありがとうございますっ\r\nえっと、プロデューサーさんはどこがいいと思いますか？",
    "textCtrl": "l",
    "charLabel": "mano",
    "charAnim1": "hello",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040100"
  },
  {
    "select": "公園にしよう",
    "nextLabel": "1"
  },
  {
    "select": "ショッピングモールに\r\nしよう",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "デパートの屋上にしよう",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "公園にしよう"
  },
  {
    "textFrame": "off",
    "charLabel": "mano",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "waitType": "time",
    "waitTime": 2000,
    "bgEffect": "mask",
    "bg": "00013"
  },
  {
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "って思ったけど、歩くには距離があったかな",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 2001004040110,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "私なら平気です\r\nたくさんお散歩して、お日様から元気をもらえました",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040110"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "それならよかった\r\n……お、鳩が集まってきた",
    "textCtrl": "p",
    "se": "0097"
  },
  {
    "id": 2001004040120,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ふふ……こんにちは、鳩さんたち\r\nみんなも元気そうだね",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040120"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "じゃあ、鳩と一緒にあっちのベンチで休もうか",
    "textCtrl": "p"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
    }
  },
  {
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "effectLabel": "black",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    }
  },
  {
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "公園でのんびりするのもいいもんだな\r\n真乃がよく公園へ行くのもわかる気がする",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait"
  },
  {
    "id": 2001004040130,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "今日は特に、プロデューサーさんがいてくれて\r\n安らげます……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040130"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "そうなのか？\r\nなら、時々一緒に公園に来ようか？",
    "textCtrl": "p"
  },
  {
    "id": 2001004040140,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "本当ですか……\r\nとてもうれしいです……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040140"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "大丈夫か、真乃？\r\n眠そうな声してるけど",
    "textCtrl": "p",
    "charLabel": "mano"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "（おっと……）",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim2": "face_close"
  },
  {
    "id": 2001004040150,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "すう……すう……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad_s2",
    "voice": "produce_events/200100404/2001004040150"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "（寝てしまったか\r\nお疲れ様、真乃……）",
    "textCtrl": "p",
    "charLipAnim": "lip_smile_s"
  },
  {
    "nextLabel": "end"
  },
  {
    "label": "2",
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ショッピングモールにしよう"
  },
  {
    "textFrame": "off",
    "charLabel": "mano",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
