  {
    "id": 2001004040250,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "日当たりもいいし、風も気持ちいいですっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040250"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "そうだな",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "――お、舞台でヒーローショーが始まるみたいだ",
    "textCtrl": "p"
  },
  {
    "id": 2001004040260,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ふふ……子どもたち、みんな楽しそうです\r\nヒーローさんは大人気ですねっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040260"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "真乃だって子どもたちの人気者になれるさ",
    "textCtrl": "p"
  },
  {
    "id": 2001004040270,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわっ？\r\n私が……ですか？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100404/2001004040270"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "子どもたちは、\r\nヒーローだけじゃなくアイドルも好きだからね",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "真乃はどう？\r\n子どもの頃、アイドルは好きだった？",
    "textCtrl": "p"
  },
  {
    "id": 2001004040280,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "子どもの頃にみたアイドル……\r\nはい、キラキラふわふわしていて好きでしたっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100404/2001004040280"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
