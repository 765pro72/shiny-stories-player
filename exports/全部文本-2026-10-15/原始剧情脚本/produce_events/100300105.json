      "alpha": 0,
      "time": 450
    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "（めぐるはまた一歩成長した……。でも、まだもっと\r\n高みへと登らせてあげなくちゃな……！）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1003001050260,
    "label": "3",
    "speaker": "めぐる",
    "text": "うん……そうだね\r\nでも大丈夫だよ！",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charAnim3Loop": false,
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300105/1003001050260"
  },
  {
    "id": 1003001050270,
    "speaker": "めぐる",
    "text": "全部分かった上で決めたことだからね\r\nわたしはこの方法で、行けるとこまで行ってみる！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300105/1003001050270"
  },
  {
    "id": 1003001050280,
    "speaker": "めぐる",
    "text": "それに、プロデューサーも\r\nそばについててくれるんでしょ？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300105/1003001050280"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。もちろんそのつもりだ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1003001050290,
    "speaker": "めぐる",
    "text": "なら、絶対大丈夫！\r\n安心だよ！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300105/1003001050290"
  },
  {
    "id": 1003001050300,
    "speaker": "めぐる",
    "text": "あ、そろそろ本番の時間だ\r\nそれじゃあ、行ってくるね、プロデューサー！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300105/1003001050300"
  },
  {
    "charLabel": "meguru",
