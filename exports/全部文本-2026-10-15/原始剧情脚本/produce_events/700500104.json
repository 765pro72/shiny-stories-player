  {
    "speaker": "はづき",
    "text": "残念ですね……。一次審査を突破できたんですし、\r\nこの調子で、と思ったんですけど",
    "charAnim1": "sad1",
    "charLipAnim": "lip_sad",
    "charLabel": "hazuki",
    "textCtrl": "p",
