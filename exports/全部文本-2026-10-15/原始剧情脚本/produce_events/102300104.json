    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300104/1023001040040"
  },
  {
    "id": 1023001040050,
    "speaker": "雛菜",
    "text": "そしたらもっと頑張れるかも～～～♡",
