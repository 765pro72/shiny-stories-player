    "textFrame": "001",
    "voice": "produce_events/102300104/1023001040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "雛菜はひとりでアイドルをやっていくんじゃない\r\nもう少し周りを見て──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023001040100,
    "speaker": "雛菜",
    "text": "ん～～～……？",
