  {
    "speaker": "プロデューサー",
    "text": "ね……『姉ちゃん\r\n昨日の夜、お父さんたちと喧嘩してたでしょ？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012030020,
    "speaker": "夏葉",
    "text": "『え？　ああ……うん、そう\r\n大学を出ても、ここには戻らないって言ったの』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "『え…………？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012030030,
    "speaker": "夏葉",
    "text": "『卒業したら、海外に行こうと思ってるから\r\n……もしかしたらもう、戻らないかも』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030030"
  },
  {
    "textFrame": "off",
    "se": "0100",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……『え、嘘……！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012030040,
    "speaker": "夏葉",
    "text": "『あんたはどうするの？\r\nこの先も、ずーっとここにいるの？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "『え、でも……上京したいって言っても\r\n絶対反対されるし』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええと……\r\n『姉ちゃんが帰ってこないなら、余計に──』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012030050,
    "speaker": "夏葉",
    "text": "『……違うでしょ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030050"
  },
  {
    "id": 2013012030060,
    "speaker": "夏葉",
    "text": "『あんたはやりたいことも、勇気も無いから\r\nそうやって人のせいにしてるだけ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030060"
  },
  {
    "id": 2013012030070,
    "speaker": "夏葉",
    "text": "『……やめなよ、そういうの』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030070"
  },
