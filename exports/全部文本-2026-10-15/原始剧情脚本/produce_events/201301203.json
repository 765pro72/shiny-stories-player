    },
    "voice": "produce_events/201301203/2013012030120"
  },
  {
    "id": 2013012030130,
    "speaker": "夏葉",
    "text": "自分じゃない誰かになって、\r\nその子の考え方とか想いを理解して",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030130"
  },
  {
    "id": 2013012030140,
    "speaker": "夏葉",
    "text": "セリフはもちろんだけど、\r\n動きも……心まで、その子にならなきゃいけない",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……俺なんか、\r\n台本の文字を追うのだけでも精一杯だったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012030150,
    "speaker": "夏葉",
    "text": "ふふ……",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301203/2013012030150"
  },
  {
    "id": 2013012030160,
    "speaker": "夏葉",
    "text": "それに……例えばほら、\r\nさっき読んだところ",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
