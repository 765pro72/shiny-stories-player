  {
    "id": 2013012030120,
    "speaker": "夏葉",
    "text": "……お芝居って、やっぱり難しいわ",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
