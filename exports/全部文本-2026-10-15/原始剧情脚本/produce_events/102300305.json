    "voice": "produce_events/102300305/1023003050030"
  },
  {
    "speaker": "質問",
    "text": "──ありがとうございます\r\n今回、『恋』は見つかった？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1023003050040,
    "speaker": "雛菜",
    "text": "ん～\r\n見つかってないですね～！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300305/1023003050040"
  },
  {
    "speaker": "質問",
    "text": "──普段はどんな活動をしてるの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1023003050050,
    "speaker": "雛菜",
    "text": "高校生と、アイドル～！\r\nツイスタフォローしてね～！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
