    "text": "…………うん、そうだったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023003050200,
    "speaker": "雛菜",
    "text": "だからもし、これからまた同じようなことがあったら\r\nこれ見てこの時のこと思い出そうかなって",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300305/1023003050200"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "良い答えが\r\n出たもんな",
