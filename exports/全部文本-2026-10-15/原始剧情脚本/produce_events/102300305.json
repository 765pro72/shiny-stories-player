    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300305/1023003050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……そうなのか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
