  {
    "speaker": "摩美々の母",
    "text": "──ごめんね、摩美々ちゃん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "摩美々の母",
    "text": "クリスマスの日ね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "摩美々の母",
    "text": "ママ、\r\n一緒にパーティーできなくなっちゃった",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1005005010020,
    "speaker": "摩美々",
    "text": "え……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500501/1005005010020"
  },
  {
    "speaker": "摩美々の母",
    "text": "その代わり、プレゼントは\r\nたーっくさん用意しておくから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "摩美々の母",
    "text": "パパからもいっぱい預かってるのよ\r\nふふ、楽しみにしててね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "摩美々の母",
    "text": "あとは──\r\nそうだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "摩美々の母",
    "text": "クリスマスの日に食べたいものがあったら\r\nママに教えてね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "摩美々の母",
    "text": "一緒には食べられないけど、全部用意しておくから",
    "textCtrl": "p",
    "textFrame": "003"
  },
