  },
  {
    "id": 2001014030030,
    "speaker": "真乃",
    "text": "ほわ……",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "何を見てるんだ？\r\nよかったら教えてくれないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001014030040,
    "speaker": "真乃",
    "text": "……あ、あの……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030040"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s3",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2800
  },
  {
    "id": 2001014030050,
    "speaker": "真乃",
    "text": "先日の……\r\nプロモーションムービーを見ていました……",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "綺麗に撮ってもらってたもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001014030060,
    "speaker": "真乃",
    "text": "──……っ",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030060"
  },
  {
    "id": 2001014030070,
    "speaker": "真乃",
    "text": "……──そ、その\r\nありがとうございます……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030070"
  },
  {
    "id": 2001014030080,
    "speaker": "真乃",
    "text": "……実は、学校でも\r\n同じことを言ってもらえたんです",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ、そうなのか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001014030090,
    "speaker": "真乃",
    "text": "はい……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030090"
  },
  {
    "id": 2001014030100,
    "speaker": "真乃",
    "text": "その子は、違うクラスの子で……\r\nあまりお話をしたことはなかったんですけれど",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030100"
  },
  {
    "id": 2001014030110,
    "speaker": "真乃",
    "text": "あのブランドが、とっても好きで……\r\nプロモーションムービーで、私を見てくれたんだそうです",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030110"
  },
  {
    "id": 2001014030120,
    "speaker": "真乃",
    "text": "それで……学校で私を探して、\r\n『櫻木さん、綺麗だった！』って言いに来てくれて……っ",
    "charAnim1": "think",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうかぁ……！\r\n熱い子だなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001014030130,
    "speaker": "真乃",
    "text": "はい……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030130"
  },
  {
    "id": 2001014030140,
    "speaker": "真乃",
    "text": "こういうことは…… \r\n初めてで……っ",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030140"
  },
  {
    "id": 2001014030150,
    "speaker": "真乃",
    "text": "近くにいる人の……\r\n身近なものに関われたことが、うれしくて",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030150"
  },
  {
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 2001014030160,
    "speaker": "真乃",
    "text": "ファンのみなさんから応援していただいた時とは\r\nまた違った気持ちなんです",
    "charAnim2": "face_smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──よかったな、真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001014030170,
    "speaker": "真乃",
    "text": "はいっ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030170"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2001014030180,
    "speaker": "真乃",
    "text": "でも──……",
    "charAnim1": "wait3",
    "charAnim2": "face_smile3",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030180"
  },
  {
    "id": 2001014030190,
    "speaker": "真乃",
    "text": "その時はびっくりしてしまって、\r\nお礼しか言えなくて",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030190"
  },
  {
    "id": 2001014030200,
    "speaker": "真乃",
    "text": "……もっとお話ができたらよかったのに、って……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101403/2001014030200"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "──いいんじゃないか？\r\nそれは、次のステップって考えてみよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "今回真乃は、『ありがとうが言えた』\r\n次は『もう少しお話をする』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
