    }
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "――みんな、もう怖がらなくていい！\r\n私たちが、絶対に守るから！",
    "charCategory": "stand_costume",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030090010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bgm": "010",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200900311/2009003110050"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "――くらえっ正義の鉄拳！！",
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0110",
    "voice": "produce_events/200900311/2009003110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（セリフ回しもばっちりだし、お客さんのことも\r\nよく見てるな……さすがだ）",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0110"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "――困ったことがあったら、また呼んでくれ\r\n私たちはいつだって君たちの味方だ！",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0110",
