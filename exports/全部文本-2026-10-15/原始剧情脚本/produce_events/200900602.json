  {
    "speaker": "プロデューサー",
    "text": "あれ……？\r\n果穂。ホウキなんて持って何してるんだ？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
