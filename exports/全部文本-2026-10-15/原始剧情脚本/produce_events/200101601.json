    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010070"
  },
  {
    "id": 2001016010080,
    "speaker": "真乃",
    "text": "何か……\r\nまずかったでしょうか……っ",
    "charAnim1": "wait3",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ううん、そうじゃないよ\r\nごめんな、笑っちゃって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっとほっこりしたっていうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010090,
    "speaker": "真乃",
    "text": "……？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、ここ",
