      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0181",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "『最近一番楽しかったことは？』って質問さ、\r\nめぐると答えが一緒なんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『イルミネのみんなで遊園地に行ったこと』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010100,
    "speaker": "真乃",
    "text": "……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s3",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101601/2001016010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "おそろいだな、ってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010110,
    "speaker": "真乃",
    "text": "ほわ……",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010110"
  },
  {
    "id": 2001016010120,
    "speaker": "真乃",
    "text": "ふふ……\r\nおそろい……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010120"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2001016010130,
    "speaker": "真乃",
    "text": "……──あ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010130",
    "autoWaitTime": 1800
  },
  {
    "id": 2001016010140,
    "speaker": "真乃",
    "text": "こ、このままだと……\r\nめぐるちゃんに迷惑がかかったりするでしょうか……？",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010150,
    "speaker": "真乃",
    "text": "おんなじ答えじゃなくて\r\n違うお話を伝えたいから、って……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010150"
  },
  {
    "id": 2001016010160,
    "speaker": "真乃",
    "text": "めぐるちゃんの回答も\r\n修正が必要になったりは──……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……──？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "（今回の特集は、毎週ひとり載せてもらって\r\nイルミネで三週もらう形──……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（確かに、めぐるから読んでくれてるお客さんは\r\n『同じ話だ』と思うだろう）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……でも、むしろ仲良しエピソードって感じで\r\n微笑ましいんじゃないか……？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "（──……いや。灯織の答えも揃ってないと\r\n変に勘ぐられる可能性も……？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（灯織分のアンケートは再来週が締切だから\r\n答えが違っちゃうかもしれないし……──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010170,
    "speaker": "真乃",
    "text": "……あのっ、プロデューサーさん",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101601/2001016010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\nああ、悪い……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010180,
    "speaker": "真乃",
    "text": "──……一度提出したのに、すみません",
    "charAnim1": "wait2",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010180"
  },
  {
    "id": 2001016010190,
    "speaker": "真乃",
    "text": "この一問だけ、締切いっぱいまで\r\n考え直してきてもいいでしょうか……？",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010190"
  },
  {
    "id": 2001016010200,
    "speaker": "真乃",
    "text": "今週末に灯織ちゃんとめぐるちゃんと遊びに行く予定で、\r\nきっと、その時もとっても楽しいので……っ",
    "charAnim1": "shy2",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010200"
  },
  {
    "id": 2001016010210,
    "speaker": "真乃",
    "text": "それを待ってから、改めて答えを考えたいなって……──",
    "charAnim1": "sad2",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうしたら今度は\r\n灯織と回答がかぶっちゃうかもだな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010220,
    "speaker": "真乃",
    "text": "……っ",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああごめんっ、それが悪いって言いたいんじゃないんだ\r\nそんなに構えないでくれ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "l",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "select": "担当さんに\r\n確認してみるよ",
    "nextLabel": "1"
  },
  {
    "select": "どっちも\r\n用意しよう",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "……それにしても",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "答えがかぶってても大丈夫かどうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こっちだけで判断するんじゃなくて\r\n先方の希望を伺わなくちゃだもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010230,
    "speaker": "真乃",
    "text": "そ、そうですよね……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、心配な点を見つけてくれたことと\r\nその対応を考えてくれたこと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "どっちもすごく大切だ\r\n──ありがとうな、真乃！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010240,
    "speaker": "真乃",
    "text": "──……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010240",
    "autoWaitTime": 1700
  },
  {
    "id": 2001016010250,
    "speaker": "真乃",
    "text": "と、とんでもないです……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010250"
  },
  {
    "id": 2001016010260,
    "speaker": "真乃",
    "text": "すみません……ありがとうございます",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200101601/2001016010260",
    "autoWaitTime": 5700
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "どっちがいい、って言われても対応できるように\r\n答えをふたつ準備するんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "余裕を持って確認に出してくれたから、\r\n締切まではまだ日があるしな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010270,
    "speaker": "真乃",
    "text": "は、はい……っ\r\nわかりました……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……でも、そうか\r\n今週末もみんなでお出かけかぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "たくさん楽しんでおいでな\r\n……アンケートのことは、一旦忘れてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010280,
    "speaker": "真乃",
    "text": "……",
    "charAnim1": "wait2",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101601/2001016010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "答えのために過ごしたんじゃ、もったいないから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016010290,
