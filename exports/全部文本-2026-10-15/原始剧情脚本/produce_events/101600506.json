  {
    "speaker": "プロデューサー",
    "text": "（遅れちゃったけど……\r\n千雪、頑張ってくれてるな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "1444",
