  {
    "speaker": "プロデューサー",
    "text": "今日も撮影とドラマの打ち合わせ、疲れただろう\r\n寝ていて良いからな",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
  {
    "id": 1016005060150,
    "speaker": "千雪",
    "text": "お気遣いありがとうございます",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600506/1016005060150"
  },
  {
    "id": 1016005060160,
    "speaker": "千雪",
    "text": "でも、今通ってるこの街……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600506/1016005060160"
  },
  {
    "id": 1016005060170,
    "speaker": "千雪",
    "text": "前に働いていたお店があるところなんですよね\r\nお馴染みだった純喫茶や、立ち読みしてた書店があって……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "090",
    "voice": "produce_events/101600506/1016005060170"
  },
  {
    "id": 1016005060180,
    "speaker": "千雪",
    "text": "変わらないなぁって",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600506/1016005060180"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nじゃあ、少しゆっくり目で走ろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016005060190,
    "speaker": "千雪",
    "text": "ふふっ、嬉しい",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600506/1016005060190"
  },
  {
    "id": 1016005060200,
    "speaker": "千雪",
    "text": "もうこの街は、帰る場所じゃないんですけど……\r\nいつか改めて、お礼を言えたらなって",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600506/1016005060200"
  },
  {
    "id": 1016005060210,
    "speaker": "千雪",
    "text": "……店長さんにも、この街の人たちにも",
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
