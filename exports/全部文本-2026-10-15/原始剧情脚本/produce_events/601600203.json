  {
    "speaker": "プロデューサー",
    "text": "もう、ライブをやり切ったみたいな顔してるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016002030020,
    "speaker": "千雪",
    "text": "えっ！？\r\nそ、そんなこと、言わないでください～……",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
