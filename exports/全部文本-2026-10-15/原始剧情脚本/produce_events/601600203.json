    "voice": "produce_events/601600203/6016002030020"
  },
  {
    "id": 6016002030030,
    "speaker": "千雪",
    "text": "私、これからのステージ、\r\n楽しみにしてるんですから……！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、すまんすまん \r\n……ずいぶん満足そうな顔をしてると思ったからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6016002030040,
    "speaker": "千雪",
    "text": "そ、そうでしょうか……",
    "charAnim1": "shy1",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030040"
  },
  {
    "id": 6016002030050,
    "speaker": "千雪",
    "text": "……でも、もしかしたら\r\n気持ちが顔に出ちゃってたかもしれません",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030050"
  },
  {
    "id": 6016002030060,
    "speaker": "千雪",
    "text": "プロデューサーさんに見送ってもらって、\r\n甘奈ちゃんと甜花ちゃんが笑顔で隣を歩いてくれて──",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030060"
  },
  {
    "id": 6016002030070,
    "speaker": "千雪",
    "text": "夢みたいなステージで、\r\nファンのみなさんを笑顔に、って思いながら歌う",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030070"
  },
  {
    "id": 6016002030080,
    "speaker": "千雪",
    "text": "……こんなに素敵なことって、きっと、\r\nなかなかないですから",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601600203/6016002030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ、そうかもしれないな\r\nせっかくだ、思いっきり楽しんできてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
