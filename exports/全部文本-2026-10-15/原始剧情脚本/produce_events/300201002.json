  {
    "id": 3002010020010,
    "speaker": "灯織",
    "text": "……すごい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020010"
  },
  {
    "id": 3002010020020,
    "speaker": "真乃",
    "text": "うんっ\r\n……満天の星、とっても綺麗だねっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020020"
  },
  {
    "id": 3002010020030,
    "speaker": "灯織",
    "text": "……人がいないところで星を見てると、\r\n星空を独り占めしてるみたい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020030"
  },
  {
    "id": 3002010020040,
    "speaker": "めぐる",
    "text": "灯織ー？　独り占めはずるくない？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020040"
  },
  {
    "id": 3002010020050,
    "speaker": "真乃",
    "text": "そうだねっ\r\n３人占め……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020050"
  },
  {
    "id": 3002010020060,
    "speaker": "灯織",
    "text": "ふふっ\r\nうん……３人占め",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020060"
  },
  {
    "id": 3002010020070,
    "speaker": "めぐる",
    "text": "あっでもでも、お風呂もきっと紹介されるから……\r\n──お茶の間占めかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020070"
  },
  {
    "id": 3002010020080,
    "speaker": "灯織",
    "text": "お茶の間占め……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020080"
  },
  {
    "id": 3002010020090,
    "speaker": "真乃",
    "text": "なんだか楽しそう……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020090"
  },
  {
    "id": 3002010020100,
    "speaker": "めぐる",
    "text": "うん……\r\n都心からちょっとなのにこんなに空が見える……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020100"
  },
  {
    "id": 3002010020110,
    "speaker": "めぐる",
    "text": "いろんな人に、こんなところがあるよーって\r\n知ってもらいたいな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020110"
  },
  {
    "id": 3002010020120,
    "speaker": "灯織",
    "text": "……そうだね\r\nお風呂も気持ちいいし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020120"
  },
  {
    "id": 3002010020130,
    "speaker": "真乃",
    "text": "お外の寒さも気にならないくらい、\r\nお湯に浸かってるとぽかぽかするね……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020130"
  },
  {
    "id": 3002010020140,
    "speaker": "めぐる",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020140"
  },
  {
    "id": 3002010020150,
    "speaker": "真乃",
    "text": "……めぐるちゃん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020150"
  },
  {
    "id": 3002010020160,
    "speaker": "めぐる",
    "text": "……うん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020160"
  },
  {
    "id": 3002010020170,
    "speaker": "真乃",
    "text": "あの、眠かったり、するのかなって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020170"
  },
  {
    "id": 3002010020180,
    "speaker": "めぐる",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020180"
  },
  {
    "id": 3002010020190,
    "speaker": "灯織",
    "text": "もうそんな時間だっけ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020190"
  },
  {
    "id": 3002010020200,
    "speaker": "真乃",
    "text": "そんなに遅くないと思うんだけど……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020200"
  },
  {
    "id": 3002010020210,
    "speaker": "真乃",
    "text": "……お腹いっぱいで眠くなっちゃったのかも\r\nいつもよりたくさんごはん食べたって言ってたから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020210"
  },
  {
    "id": 3002010020220,
    "speaker": "灯織",
    "text": "確かに……\r\nはしゃいじゃって、私もちょっと食べすぎたな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020220"
  },
  {
    "id": 3002010020230,
    "speaker": "灯織",
    "text": "めぐるが完全に寝ちゃう前に、出よっか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300201002/3002010020230"
  },
