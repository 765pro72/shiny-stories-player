  },
  {
    "id": 2003017030020,
    "speaker": "めぐる",
    "text": "これ、全部もらっちゃっていいの！？",
    "charAnim1": "shy1",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいぞ\r\n『事務所のみなさんにもどうぞ』だそうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030030,
    "speaker": "めぐる",
    "text": "……もしかして、気を遣わせちゃったかな？",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030030"
  },
  {
    "id": 2003017030040,
    "speaker": "めぐる",
    "text": "全然そういうつもりじゃなかったんだけど……！",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうだろう……\r\n気遣いもあるかもしれないけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『あわよくば宣伝してもらえたらいいな』はあるかもなぁ\r\nめぐるだけじゃなくて他のみんなにもさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030050,
    "speaker": "めぐる",
    "text": "ステマってこと？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、これはならないと思うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "元々めぐるが商品のモデルをしていて、\r\n現品をたくさんもらったからみんなに配るってだけなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "企業から現品をもらって使ってますって言うなら\r\nむしろダイレクトマーケティングになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030060,
    "speaker": "めぐる",
    "text": "ダイマかー！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そもそも、宣伝してくれとは言われてないしなぁ\r\n自信があるからみんなにも使ってほしいんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030070,
    "speaker": "めぐる",
    "text": "なるほど……！",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030070"
  },
  {
    "id": 2003017030080,
    "speaker": "めぐる",
    "text": "じゃあじゃあ、『たくさんいただきました！』\r\n『分けました！』って言うだけなら大丈夫だよね？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\nご厚意だし、ありがたくいただこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030090,
    "speaker": "めぐる",
    "text": "はーい！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030090"
  },
  {
    "id": 2003017030100,
    "speaker": "めぐる",
    "text": "じゃあこれは『ご自由にどうぞ』しとくね\r\n『よかったら軽く宣伝もしてね！』って添えて！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、うん\r\n頼むな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっちはめぐるが買ってきたものだよな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030110,
    "speaker": "めぐる",
    "text": "うん！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030110"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textFrame": "off",
