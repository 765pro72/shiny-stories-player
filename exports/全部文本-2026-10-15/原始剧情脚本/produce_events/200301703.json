  },
  {
    "id": 2003017030130,
    "speaker": "めぐる",
    "text": "お試し！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "勉強熱心だなぁ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030140,
    "speaker": "めぐる",
    "text": "ほんとに全然わかんないからねー\r\nわからないままお仕事します！　は失礼過ぎると思うし……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるのその姿勢、本当にえらいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030150,
    "speaker": "めぐる",
    "text": "えへへっ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030150"
  },
  {
    "id": 2003017030160,
    "speaker": "めぐる",
    "text": "いい機会をもらったなー！　とも思ってるんだ\r\nこういうことがなければ、たぶんもっと先だったと思うの",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "先か",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2003017030170,
    "speaker": "めぐる",
    "text": "うん",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030170"
  },
  {
    "id": 2003017030180,
    "speaker": "めぐる",
    "text": "大学生とか大人になると\r\n『しないといけないもの』になってくるでしょ？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030180"
  },
  {
    "id": 2003017030190,
    "speaker": "めぐる",
    "text": "公式サイトとかツイスタとかも見たけど、\r\n大人の人って毎日これをしてるんだーって",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030190"
  },
  {
    "id": 2003017030200,
    "speaker": "めぐる",
    "text": "使い方とか順番とかもいろいろで\r\nすごいなって思って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030200"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "meguru",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2003017030210,
    "speaker": "めぐる",
    "text": "わたしね、こういうことがなかったらきっと\r\n大人になるまでやらなかっただろうなって",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030210"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる、運動量多くて代謝もいいしな\r\n肌トラブルの記憶もないし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003017030220,
    "speaker": "めぐる",
    "text": "そうなんだよね\r\n自分では必要なことって認識なくて……！",
    "charAnim1": "sad1",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030220"
  },
  {
    "id": 2003017030230,
    "speaker": "めぐる",
    "text": "でもでも、やっぱり\r\nどこかで始めるタイミングってくるから……────",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301703/2003017030230"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだよなぁ……────",
    "textCtrl": "p",
    "textFrame": "002"
