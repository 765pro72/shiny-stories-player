  {
    "id": 2003017030120,
    "speaker": "めぐる",
    "text": "お返事メールのリストになかったのを\r\nいろいろ買ってきてみた！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
