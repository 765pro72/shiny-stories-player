    "voice": "produce_events/200701403/2007014030210"
  },
  {
    "speaker": "プロデューサー",
    "text": "……言うと思った！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014030220,
    "speaker": "結華",
    "text": "だってほんとに頑張れるんだもん\r\nまだまだ元気！",
