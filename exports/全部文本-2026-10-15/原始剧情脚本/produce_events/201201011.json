    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201201011/2012010110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "『あけましておめでとうございます』\r\nってことが印刷してあるから、",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『あけましておめでとうございます！』ってのもなんだし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『今年もよろしくお願いします！』っていうのも、\r\nもう書いてあるだろ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012010110070,
    "speaker": "凛世",
    "text": "はい……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
