    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201201011/2012010110070"
  },
  {
    "id": 2012010110080,
    "speaker": "凛世",
    "text": "ふふ……\r\n凛世は……──",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201201011/2012010110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっ、凛世は？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012010110090,
    "speaker": "凛世",
    "text": "すべて……\r\n手書きにて……したためますゆえ……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201201011/2012010110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああっ、そうかぁ\r\nうーん……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012010110100,
