    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201201011/2012010110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "あと──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『いつも凛世の魅力を\r\n引き出してくださってありがとうございます』",
