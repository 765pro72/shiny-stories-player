  },
  {
    "speaker": "プロデューサー",
    "text": "いや、個人宛のやつは、年賀状に一筆入れたいんだけどさ\r\nうーん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一文だけ入れるの、難しいんだよなぁ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012010110060,
    "speaker": "凛世",
    "text": "年賀状を……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
