  {
    "speaker": "プロデューサー",
    "text": "……めぐる？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003002020020,
    "speaker": "めぐる",
    "text": "──あっ、プロデューサー！\r\nごめんね、ちょっとぼーっとしちゃってた……！",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……何か考えてたんじゃないのか？\r\nぼーっとしてるだけには、見えなかったけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003002020030,
    "speaker": "めぐる",
    "text": "わ、すごい……！　お見通しなんだ……！\r\n──あのね、感謝祭の本番のことを考えてたの",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020030"
  },
  {
    "id": 6003002020040,
    "speaker": "めぐる",
    "text": "リハーサルでこんなに楽しかったんだから、\r\n本番はきっと、もーっと楽しくなるんだろうなって……！",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな……確かに、それは間違いない\r\nだって、めぐるが楽しいステージにしてくれるんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003002020050,
    "speaker": "めぐる",
    "text": "えっ、わたし？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。めぐるはきっと自分も楽しみながら、\r\n俺たち見ている人もみんな楽しませてくれる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうパフォーマンスをしてくれるはずだ\r\nしかも、今日よりもっとすごいやつを。……違うか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003002020060,
    "speaker": "めぐる",
    "text": "……\r\nそっか……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020060"
  },
  {
    "id": 6003002020070,
    "speaker": "めぐる",
    "text": "プロデューサーは、そう思ってくれるんだね──\r\nそっかそっか……",
    "charAnim1": "smile2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300202/6003002020070"
  },
  {
    "id": 6003002020080,
    "speaker": "めぐる",
    "text": "──えへへ、もっちろんだよ！\r\n任せて、プロデューサー！",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
