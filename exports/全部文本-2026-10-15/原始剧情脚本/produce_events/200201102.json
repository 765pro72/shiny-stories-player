  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織って聞いたことない　わりと顔は好み』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『ネット配信にしてはキャスト豪華じゃね？\r\n風野灯織ちゃんって子だけわかんなかったわ　有名なん？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織は２８３プロのアイドルです！！\r\nとにかく顔がいいので見てくださいお願いします！！！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0280",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織（っていうらしい）の\r\n遊んでくれるよねがひどい。もっとあざとく言って』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『予告の子、風野灯織さん？\r\nなんか棒じゃなかった？　来週大丈夫かな？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『風野灯織……聞いたことある気がするな……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
