    "voice": "produce_events/201301011/2013010110160"
  },
  {
    "id": 2013010110170,
    "speaker": "夏葉",
    "text": "いつか、メンバーみんなと\r\nお酒を飲む日がくるのかしらね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110170"
  },
  {
    "id": 2013010110180,
    "speaker": "夏葉",
    "text": "私、乾杯なんてしたら\r\n感極まってしまうかもしれないわ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110180"
  },
  {
    "id": 2013010110190,
    "speaker": "夏葉",
    "text": "プロデューサーもそう思わない？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
