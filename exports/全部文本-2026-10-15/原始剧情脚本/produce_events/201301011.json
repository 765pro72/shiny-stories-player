      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201301011/2013010110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110100,
    "speaker": "夏葉",
    "text": "せっかく獲ったものだから\r\nアナタと一緒に味わいたいと思って",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいのか？\r\n俺もごちそうになっても",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110110,
    "speaker": "夏葉",
    "text": "ええ、もちろん！\r\nアナタがいなければこれはここに無い物だもの",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110110"
  },
  {
    "id": 2013010110120,
    "speaker": "夏葉",
    "text": "当たり前じゃない！",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110130,
    "speaker": "夏葉",
    "text": "だけど、みんなが知ったら羨ましがるわね\r\n『夏葉ちゃんたちだけで美味しいもの食べて』って",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、言いそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110140,
    "speaker": "夏葉",
    "text": "本当はみんなで一緒にとも思ったけれど\r\nメインがお酒だから",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110140"
  },
  {
    "id": 2013010110150,
    "speaker": "夏葉",
    "text": "今回は特別に\r\n……大人だけの秘密にしましょう！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "natsuha",
    "textFrame": "off",
