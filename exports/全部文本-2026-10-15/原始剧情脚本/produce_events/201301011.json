  {
    "id": 2013010110020,
    "speaker": "夏葉",
    "text": "今日はもう\r\n他に誰もいないのかしら？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、さっき\r\nみんな帰ったからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110030,
    "speaker": "夏葉",
    "text": "…………ふふっ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
