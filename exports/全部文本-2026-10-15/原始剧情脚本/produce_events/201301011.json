    "voice": "produce_events/201301011/2013010110030"
  },
  {
    "id": 2013010110040,
    "speaker": "夏葉",
    "text": "アナタ、\r\n今日は車で帰ったりしないわよね？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？\r\nああ、今日は電車で帰るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110050,
    "speaker": "夏葉",
    "text": "私も今日は電車で帰るの",
    "charAnim1": "hello",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110050"
  },
  {
    "id": 2013010110060,
    "speaker": "夏葉",
    "text": "──だから、ちょっと付き合わない？",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301011/2013010110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "え…………？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010110070,
    "speaker": "夏葉",
