      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201600511/2016005110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、いつの間に……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事の手伝いだけじゃなく、こんなことまで……\r\n本当にありがとうな、すごく助かったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110230,
    "speaker": "千雪",
    "text": "いえ、感謝というなら……こちらこそです",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110230"
  },
  {
    "id": 2016005110240,
    "speaker": "千雪",
    "text": "プロデューサーさんがこうして働いてくださるから……",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110240"
  },
  {
    "id": 2016005110250,
    "speaker": "千雪",
    "text": "私は背筋を伸ばして、\r\n私の活動をファンの方々に届けられるんです",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっか……そう感じてくれてるなら\r\n俺もプロデューサーとして、すごく嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110260,
    "speaker": "千雪",
    "text": "……ふふ、ありがとうございます",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
