  {
    "speaker": "プロデューサー",
    "text": "……ふぅ、一通り片付いたな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110220,
    "speaker": "千雪",
    "text": "お疲れ様です。お茶、どうぞ\r\n……それと、こちら差し入れです",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
