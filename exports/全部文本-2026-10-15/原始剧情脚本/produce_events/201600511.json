  {
    "id": 2016005110040,
    "speaker": "千雪",
    "text": "お疲れ様です、プロデューサーさ──",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
