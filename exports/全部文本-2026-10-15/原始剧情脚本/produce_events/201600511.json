  },
  {
    "speaker": "プロデューサー",
    "text": "すー……、すー……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110050,
    "speaker": "千雪",
    "text": "（プロデューサーさん、眠ってる……）",
    "charAnim1": "sad1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110050"
  },
  {
    "id": 2016005110060,
    "speaker": "千雪",
    "text": "毎日、私たちのために働いてもらってるんだもん\r\n本当に、お疲れですよね……",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、むにゃ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110070,
    "speaker": "千雪",
    "text": "……プロデューサーさん\r\nお隣、失礼しますね……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
