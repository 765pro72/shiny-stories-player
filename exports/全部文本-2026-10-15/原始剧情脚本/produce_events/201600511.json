  {
    "id": 2016005110090,
    "speaker": "千雪",
    "text": "…………",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad2_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110090"
  },
  {
    "id": 2016005110100,
    "speaker": "千雪",
    "text": "（そうだ、ブランケットか何か、かけるものを──）",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、んん……\r\nあれ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110110,
    "speaker": "千雪",
    "text": "あ、プロデューサーさん……！\r\n……お、おはようございます……",
    "charAnim1": "anger2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……千雪？\r\n今日はもう仕事なかったはずだよな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110120,
    "speaker": "千雪",
    "text": "あ、ええと、そうなんですけど……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ふわぁあ……\r\nそっか、なんか事務所に用事でもあったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110130,
    "speaker": "千雪",
    "text": "……そ、そんなところです……",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん、なんで書類が散らばって……\r\n……って、俺、いつの間にか寝ちゃってたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪、起こさないように静かにしてくれてたんだな\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110140,
    "speaker": "千雪",
    "text": "えっと……\r\n…………す、すみません、違うんですっ",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110140"
  },
  {
    "id": 2016005110150,
    "speaker": "千雪",
    "text": "起こさなかったのは……思わず……\r\n寝顔を観察してしまってたからなんです",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……誰の？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110160,
    "speaker": "千雪",
    "text": "プロデューサーさんの、ですよ……！",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺の、って……\r\nそんなことしても楽しくないだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110170,
    "speaker": "千雪",
    "text": "……い、いえ、楽しい、というか……\r\nすごく幸せそうな寝顔だったので、つい",
    "charAnim2": "face_surp",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110171,
    "speaker": "千雪＆プロデューサー",
    "text": "…………",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110171"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………というか\r\n幸せそうに寝てる場合じゃないんだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "明日にはもう、この仕事が待ってるんだし……\r\n早くこの資料、まとめてしまわないと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110180,
    "speaker": "千雪",
    "text": "……でしたらプロデューサーさん\r\n私にお手伝いさせてください……！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、ありがたいけど\r\nアイドルに手伝ってもらうわけにはいかないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110190,
    "speaker": "千雪",
    "text": "で、でも……時間も遅いですし\r\nそれに、ふたりでやったほうが早く終わります",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110190"
  },
  {
    "id": 2016005110200,
    "speaker": "千雪",
    "text": "だから……\r\n……ね？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600511/2016005110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "う、うーん……わかった\r\nじゃあこの資料の誤字脱字チェックを頼めるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005110210,
    "speaker": "千雪",
    "text": "はい、もちろんです\r\n任せてください……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
