    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『気をつけて！』だってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013020280,
    "speaker": "夏葉",
    "text": "ふふっ、可愛らしいわね",
