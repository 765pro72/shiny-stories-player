  },
  {
    "speaker": "プロデューサー",
    "text": "それはそれで楽しそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013020250,
    "speaker": "夏葉",
    "text": "そうね\r\nもちろん２８３プロのみんなにも",
