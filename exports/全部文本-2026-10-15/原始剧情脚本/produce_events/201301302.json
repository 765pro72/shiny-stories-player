    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301302/2013013020290"
  },
  {
    "id": 2013013020300,
    "speaker": "夏葉",
    "text": "一生懸命に込めた想いが\r\n伝わって欲しいと思うのも、本当よね",
