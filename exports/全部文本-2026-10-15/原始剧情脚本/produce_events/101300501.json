    "textFrame": "001",
    "voice": "produce_events/101300501/1013005010020"
  },
  {
    "speaker": "夏葉の母",
    "text": "よく知ってるわね！\r\n本で読んだのかしら",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1013005010030,
    "speaker": "夏葉",
    "text": "ふふっ、すごいでしょう！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300501/1013005010030"
  },
  {
    "speaker": "夏葉の兄",
    "text": "はは、どこの国も海でつながってるんだよ\r\nあたりまえだろ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1013005010040,
    "speaker": "夏葉",
    "text": "し、しってるわ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300501/1013005010040"
  },
  {
    "speaker": "夏葉の父",
    "text": "はは……\r\nふたりとも、よく勉強しているな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00373",
