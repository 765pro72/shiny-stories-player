    "charLipAnim": "lip_serious",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180100101/1801001010060"
  },
  {
    "id": 1801001010070,
    "speaker": "ルビー",
    "text": "苺プロ所属、ルビーです！\r\nこれからしばらくの間、お世話になります！",
