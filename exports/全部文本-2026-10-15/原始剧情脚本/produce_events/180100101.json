  },
  {
    "speaker": "プロデューサー",
    "text": "２８３プロダクションの打合せにお越しですよね\r\nお待ちしていました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1801001010060,
    "speaker": "ルビー",
    "text": "あっ、事務所の人ですか……！",
