    "textFrame": "001",
    "voice": "produce_events/180100101/1801001010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、こちらこそお世話になります",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile_s",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "詳しい話は事務所の中で……\r\nどうぞ、ご案内いたします",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
