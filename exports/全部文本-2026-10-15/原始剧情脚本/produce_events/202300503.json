  {
    "id": 2023005030260,
    "speaker": "雛菜",
    "text": "こんなにかわいいのにね～？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
