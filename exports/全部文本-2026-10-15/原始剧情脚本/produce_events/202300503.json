  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "このキャラクター、雛菜に教えてもらうまで\r\nよく知らなかったんだけど",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も最初は正直、\r\n少し変わったキャラクターだなと思ってた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005030270,
    "speaker": "雛菜",
    "text": "へ～\r\nこんなにかわいいのに～？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300503/2023005030270"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、ごめん\r\n実はそうなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だけどなんだか最近、\r\nわかってきた気がするよ",
    "charAnim2": "face_wait",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005030280,
    "speaker": "雛菜",
    "text": "やは～\r\nほんとに～？",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300503/2023005030280"
  },
