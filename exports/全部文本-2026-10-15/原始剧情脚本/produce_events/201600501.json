    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0218",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……こ、これは……\r\n弱い……そしてぬるい……",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "resume"
  },
  {
    "id": 2016005010110,
    "speaker": "千雪",
    "text": "……はい\r\nこの扇風機さん、とてもおとなしいみたいで……",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201600501/2016005010110"
  },
  {
    "id": 2016005010120,
    "speaker": "千雪",
    "text": "何か他に、涼む方法は……\r\n──あっ",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうした千雪？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010130,
    "speaker": "千雪",
    "text": "……あの、プロデューサーさん\r\nさっきのスイカ、お先にいただいちゃいませんか……？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ\r\n俺は構わないが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010140,
    "speaker": "千雪",
    "text": "本当はみんなで一緒に、って思ったんですけど……\r\nこのまま置いておくとぬるくなっちゃいますし",
    "charAnim2": "face_surp",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010140"
  },
  {
    "id": 2016005010150,
    "speaker": "千雪",
    "text": "それに、切っちゃえば冷蔵庫で冷やしておけますし",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\n……じゃあ、お言葉に甘えさせてもらうよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010160,
    "speaker": "千雪",
    "text": "はいっ\r\n……それと、もうひとつお願いがありまして……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "？\r\n俺に協力できることであれば──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
