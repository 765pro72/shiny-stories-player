[
  {
    "speaker": "プロデューサー",
    "text": "（朝から暑いな……\r\n早く事務所のクーラーで涼みたい……）",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00003",
    "bgm": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "──お、千雪じゃないか、おはよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010010,
    "speaker": "千雪",
    "text": "プロデューサーさん。おはようございます\r\n今日も暑い中お疲れ様です",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030160020",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/201600501/2016005010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪こそ早くからお疲れ様\r\n……しかし、今日は本当に暑いな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……というかそのスイカ、どうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010020,
    "speaker": "千雪",
    "text": "これはですね……さっき果物屋さんで買って来たんです\r\n事務所のみんなで食べようと思って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010020"
  },
  {
    "id": 2016005010030,
    "speaker": "千雪",
    "text": "大勢で食べるってお話をしたら、\r\nこんなに大きいのをくれたんですよ♪",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか\r\nあ、重いだろうから俺が持つよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010040,
    "speaker": "千雪",
    "text": "ありがとうございます\r\nでも、もうすぐ事務所なので大丈夫です",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……？\r\nこんな暑さだし、キツかったら無理せず言ってくれよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016005010050,
    "speaker": "千雪",
    "text": "はいっ\r\n事務所まであと少し、頑張りましょう……！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600501/2016005010050"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
