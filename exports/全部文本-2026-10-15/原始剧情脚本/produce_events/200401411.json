  },
  {
    "id": 2004014110110,
    "speaker": "恋鐘",
    "text": "『恋鐘、お仕事お疲れさま！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110110"
  },
  {
    "id": 2004014110120,
    "speaker": "恋鐘",
    "text": "『今、みんなで帰っとるとこ！\r\n山の端からお月様が昇ってきとってね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110120"
  },
  {
    "textFrame": "off",
    "se": "0280",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2004014110130,
    "speaker": "恋鐘",
    "text": "『うちらが歩くと、お月様がついてきとるとよー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110130"
  },
  {
    "id": 2004014110140,
    "speaker": "恋鐘",
    "text": "『恋鐘もここにおるみたいで、嬉しかねー！\r\nって、みんなで言うとったと！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110140"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2004014110150,
    "speaker": "恋鐘",
    "text": "──って！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401411/2004014110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……本当に、いい友達だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014110160,
    "speaker": "恋鐘",
    "text": "うん～！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110160"
  },
  {
    "id": 2004014110170,
    "speaker": "恋鐘",
    "text": "なんかね～、なんか……",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110170"
  },
  {
    "id": 2004014110180,
    "speaker": "恋鐘",
    "text": "うちがみんなのことを考えとる時に、\r\nみんなもうちのこと考えとってくれたとが嬉しくて……",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110180"
  },
  {
    "id": 2004014110190,
    "speaker": "恋鐘",
    "text": "胸がきゅ～ってなってしまったと",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014110200,
    "speaker": "恋鐘",
    "text": "プロデューサー？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああいや、このポスターのコピー、\r\n変えてもらってよかったな……って思ってたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前のも格好よかったけど、\r\n今のコピーの方が……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "色んな人を照らす光みたいな\r\n恋鐘に似合ってる気がする",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014110210,
    "speaker": "恋鐘",
    "text": "んん～～……\r\nプロデューサー、ほんとに……",
    "charAnim1": "sad1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110210"
  },
  {
    "id": 2004014110220,
    "speaker": "恋鐘",
    "text": "…………",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110220"
  },
  {
    "id": 2004014110230,
    "speaker": "恋鐘",
    "text": "ほんとに、\r\nうちのよかところ見つけるとが上手ばい～！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、恋鐘のプロデューサーだからな",
    "charAnim2": "face_wait",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014110240,
    "speaker": "恋鐘",
    "text": "……うん～",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401411/2004014110240"
  },
  {
    "id": 2004014110250,
    "speaker": "恋鐘",
    "text": "こいからもうち、頑張るけん\r\n誰よりも傍におって、見とってね！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
