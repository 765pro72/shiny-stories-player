    "textFrame": "001",
    "voice": "produce_events/300200701/3002007010200"
  },
  {
    "id": 3002007010210,
    "speaker": "めぐる",
    "text": "──みんな、どうだったかなー？\r\nうさぎさん、どんな気持ちだったと思う？",
