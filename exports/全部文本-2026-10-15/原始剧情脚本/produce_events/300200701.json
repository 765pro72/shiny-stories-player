    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300200701/3002007010180"
  },
  {
    "id": 3002007010190,
    "speaker": "めぐる",
    "text": "でも小さい子たちもいるから、たとえば……",
