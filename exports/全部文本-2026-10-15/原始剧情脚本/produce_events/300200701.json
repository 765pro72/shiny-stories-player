    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300200701/3002007010190"
  },
  {
    "id": 3002007010200,
    "speaker": "めぐる",
    "text": "うさぎさんが後悔するところまでは今みたいに読んで、\r\nその後──",
