    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "voice": "produce_events/300200701/3002007010170"
  },
  {
    "id": 3002007010180,
    "speaker": "めぐる",
    "text": "事故って嫌なものなんだってわかってもらわなきゃだから、\r\n怖いのも必要だと思う",
