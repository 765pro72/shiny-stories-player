      "time": 100
    },
    "voice": "produce_events/300200701/3002007010110"
  },
  {
    "id": 3002007010120,
    "speaker": "灯織",
    "text": "ど、どう……？\r\n気になるところは遠慮せずに、教えてほしい……！",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300200701/3002007010120"
  },
  {
    "id": 3002007010130,
    "speaker": "めぐる",
    "text": "うーん……\r\n灯織、怖い雰囲気はよく出てるんだけど……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300200701/3002007010130"
  },
  {
    "id": 3002007010140,
    "speaker": "めぐる",
    "text": "怖すぎるよー……！",
