  },
  {
    "charLabel": "hiori",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 3002007010170,
    "speaker": "めぐる",
    "text": "ううん、そうじゃなくて！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
