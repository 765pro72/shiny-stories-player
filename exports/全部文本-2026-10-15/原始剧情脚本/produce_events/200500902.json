      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200500902/2005009020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "今度、この雑誌で\r\n摩美々にモデルをお願い出来ないかって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005009020170,
    "speaker": "摩美々",
    "text": "え……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500902/2005009020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "今、連絡があったところなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前から雑誌のコンセプトに\r\n摩美々が合うんじゃないかって話が出てたらしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005009020180,
    "speaker": "摩美々",
    "text": "……そうなんですか",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500902/2005009020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "こうやって摩美々の個性を活かした仕事が来るのも\r\n摩美々が頑張っている証拠だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005009020190,
    "speaker": "摩美々",
    "text": "……そうですかねー",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500902/2005009020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "今まで摩美々を応援してきてくれたファンも\r\nもちろん喜んでくれるだろうし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "新しい仕事をきっかけに、これから\r\n摩美々を応援してくれるファンも増える",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "当たり前のことかもしれないけど\r\n……それがすごく嬉しくてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
