  {
    "speaker": "プロデューサー",
    "text": "摩美々、この雑誌好きだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005009020160,
    "speaker": "摩美々",
    "text": "あ、それ……\r\n最新号──……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
