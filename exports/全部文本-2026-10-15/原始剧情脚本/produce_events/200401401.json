  },
  {
    "id": 2004014010260,
    "speaker": "恋鐘",
    "text": "今のは戸締まりとは別たい！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
