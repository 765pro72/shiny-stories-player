    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは\r\nその言葉、さっきも聞いたぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
