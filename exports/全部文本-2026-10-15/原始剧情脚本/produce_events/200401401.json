      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401401/2004014010260"
  },
  {
    "id": 2004014010270,
    "speaker": "恋鐘",
    "text": "……うちにゆ～っくり、電話させてくれたこと\r\nわかってくれて、嬉しか～！　って思ったけん……",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\nなるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっきの恋鐘、優しい顔をしてたからさ\r\n……大事な友達とかか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014010280,
    "speaker": "恋鐘",
    "text": "うん～\r\n長崎の友達ばい",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010280"
  },
  {
    "id": 2004014010290,
    "speaker": "恋鐘",
    "text": "結婚式ば挙げるって話で……\r\nばり素敵な二人やったけん、うちも嬉しか～！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、恋鐘越しにそういう……\r\nあったかい空気、伝わってきたよ",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014010300,
    "speaker": "恋鐘",
    "text": "んふふ～、そうやろ？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010300"
  },
  {
    "id": 2004014010310,
    "speaker": "恋鐘",
    "text": "みんなもね、アンティーカのポスター送ったら\r\n勤めとるお店に貼ってくれたりとか……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401401/2004014010310"
  },
  {
    "id": 2004014010320,
    "speaker": "恋鐘",
    "text": "うちんこと、ばり応援してくれとるとよ！",
