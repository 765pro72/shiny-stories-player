    },
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1011003030270,
    "speaker": "樹里",
    "text": "…………\r\nどうしたらいいんだろうな",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100303/1011003030270"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
