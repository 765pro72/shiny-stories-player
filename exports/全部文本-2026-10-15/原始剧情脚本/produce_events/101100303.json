  {
    "id": 1011003030010,
    "speaker": "樹里",
    "text": "──えー……じゃあ、ここからは\r\n番組公式サイトとツイスタで募集させてもらった……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
