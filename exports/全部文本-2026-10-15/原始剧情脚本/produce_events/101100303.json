      "time": 100
    },
    "voice": "produce_events/101100303/1011003030010"
  },
  {
    "id": 1011003030020,
    "speaker": "樹里",
    "text": "『樹里の魅力』……っていうのを\r\nいくつか紹介していきたいと思う……んだけど",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100303/1011003030020"
  },
  {
    "id": 1011003030030,
    "speaker": "樹里",
    "text": "なんかこれ、自分で紹介するの\r\nすげー恥ずかしいやつだな……！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100303/1011003030030"
  },
  {
    "id": 1011003030040,
    "speaker": "樹里",
    "text": "──よし……！",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100303/1011003030040"
  },
  {
    "charAnim1": "wait",
    "charLabel": "juri",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
