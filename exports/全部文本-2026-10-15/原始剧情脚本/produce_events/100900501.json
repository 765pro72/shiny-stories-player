  {
    "speaker": "果穂の母",
    "text": "ねぇ、果穂\r\n今日まおちゃん来たじゃない？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010110,
    "speaker": "果穂",
    "text": "え？　うん",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900501/1009005010110"
  },
  {
    "speaker": "果穂の母",
    "text": "いつも思ってたんだけどね\r\nまおちゃんでもヒーローグッズしまっちゃうんだ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010120,
    "speaker": "果穂",
    "text": "んー……うん\r\nまおちゃん、あたしがヒーロー好きなの知ってるけど",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
