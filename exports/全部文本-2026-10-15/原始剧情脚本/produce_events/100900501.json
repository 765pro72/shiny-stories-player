  },
  {
    "speaker": "果穂の友人",
    "text": "あーあ！　テストなんてなくなっちゃえばいいのにー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の友人",
    "text": "あ！　そうだ、果穂ちゃん！\r\n今日遊ぼうよ！",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010050,
    "speaker": "果穂",
    "text": "え、でも復習は……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900501/1009005010050"
  },
  {
    "speaker": "果穂の友人",
    "text": "それは一緒にちょっとやって、それから遊ぶ！\r\nどう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010060,
    "speaker": "果穂",
    "text": "いいと思う！\r\nじゃあ、どっちかのおうちかな？",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900501/1009005010060"
  },
  {
    "speaker": "果穂の友人",
    "text": "今日は果穂ちゃんちがいいな！\r\nこの前うちだったし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010070,
    "speaker": "果穂",
    "text": "いいよー！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
