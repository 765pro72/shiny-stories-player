    "waitTime": 1500
  },
  {
    "speaker": "果穂の兄",
    "text": "ええ……\r\nなんかあんの……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の母",
    "text": "果穂なりに考えてるんだから尊重してあげて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "おう……\r\nあんだけ仲いいなら別にいい気もするけどなー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の母",
    "text": "それは果穂より長く生きてるから思うだけなんじゃない？\r\nお兄ちゃんが果穂くらいの時は何考えてた？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "俺ぇ？\r\nえー……うーん…………なんも考えてなかったかなー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "今考えるとちょっと強引なところあったかもしれん\r\n俺が好きなもの一緒に楽しもうやみたいな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の母",
    "text": "それもどうかと思うけど……\r\nまぁお兄ちゃんも友達に恵まれてるもんねぇ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "いぇーい\r\nほんとそこだけは誇れる",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の母",
    "text": "果穂もそこまで気にしなくてもって思うんだけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010140,
    "speaker": "果穂",
    "text": "お母さーん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900501/1009005010140"
  },
  {
    "speaker": "果穂の兄＆果穂の母",
    "text": "！",
    "textCtrl": "p",
    "textFrame": "003",
    "autoWaitTime": 300
  },
  {
    "id": 1009005010150,
    "speaker": "果穂",
    "text": "この回の録画取っておいていいー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900501/1009005010150"
  },
  {
    "speaker": "果穂の母",
    "text": "いいけどお兄ちゃんとも相談してねー",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "おっなになに、今回そんなに気にいったの\r\nジャスティスレッドがかっこよかったとか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の兄",
    "text": "ちょっとお兄ちゃんにも見せてよ",
    "textCtrl": "p",
    "textFrame": "003"
