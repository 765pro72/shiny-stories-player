  {
    "speaker": "果穂の兄",
    "text": "え、果穂そんな気遣いしてんの？\r\n小学生で？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "果穂の母",
    "text": "しーっ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
