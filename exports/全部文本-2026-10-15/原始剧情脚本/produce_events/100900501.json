  },
  {
    "id": 1009005010080,
    "speaker": "果穂",
    "text": "──あっ！　部屋片づけるからちょっと後にしてもいい？\r\n30分くらい！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
