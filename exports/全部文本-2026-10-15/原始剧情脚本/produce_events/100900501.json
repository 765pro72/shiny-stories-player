  {
    "speaker": "果穂の友人",
    "text": "来週のテスト、ゆううつだね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1009005010040,
    "speaker": "果穂",
    "text": "うん\r\n算数苦手だから、ちゃんとがんばんないと……",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
