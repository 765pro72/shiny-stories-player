    },
    "voice": "produce_events/202201101/2022011010120"
  },
  {
    "select": "くるしゅうないぞ",
    "nextLabel": "1"
  },
  {
    "select": "もちろんいいぞ！",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "承知つかまつった",
    "nextLabel": "3"
  },
  {
    "id": 2022011010130,
    "label": "1",
    "speaker": "小糸",
    "text": "えっ……？",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういうのはなりきりが大事だと思って\r\n言ってみたんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……信重っぽくなかったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010140,
    "speaker": "小糸",
    "text": "の、信重はお敬には優しく接しているって\r\n設定なので",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010140"
  },
  {
    "id": 2022011010150,
    "speaker": "小糸",
    "text": "……プロデューサーさんのはなんだか少し違う気が……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うっ、そ、そうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010160,
    "speaker": "小糸",
    "text": "ふふ、でも……偉そうなプロデューサーさん\r\n珍しいですよね",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010160"
  },
  {
    "id": 2022011010170,
    "speaker": "小糸",
    "text": "ちょっと、面白かったです……！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/202201101/2022011010170"
  },
  {
    "id": 2022011010180,
    "label": "2",
    "speaker": "小糸",
    "text": "は、はい、よろしくお願いします……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "えーと、俺が信重の部分を読めばいいんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010190,
    "speaker": "小糸",
    "text": "はい、えっと、まずは６ページ冒頭から\r\nなんですけど──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010190"
  },
  {
    "id": 2022011010200,
    "speaker": "小糸",
    "text": "……プロデューサーさんは台本とか\r\n声に出して読んだことあるんですか？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "なくはない\r\nでもあまり期待はしないでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "speaker": "プロデューサー",
    "text": "そう思ったら俺が相手役でいいのかとちょっと\r\n考えちゃうな、素人も素人だし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010210,
    "speaker": "小糸",
    "text": "ぷ、プロデューサーさんは演じなくても\r\n大丈夫だから、普通でいいと思いますよ……？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、そうだった、俺はあくまで小糸のサポートに\r\nなればいいんだもんな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、変に緊張しちゃったよ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010220,
    "speaker": "小糸",
    "text": "ふふ……！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/202201101/2022011010220"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "では、はじめますぞ、小糸姫！\r\n……なんてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010230,
    "speaker": "小糸",
    "text": "こ、小糸姫……\r\nぷ、プロデューサーさん、わたしはお敬ですよ……！",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうなんだけどさ。なんだか本当に戦国時代に\r\nいたような感じがするなと思って、小糸姫",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010240,
    "speaker": "小糸",
    "text": "小糸姫……お、お糸とか、ですかね\r\n呼び方……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだな\r\nきっと静かで、努力家な姫だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010250,
    "speaker": "小糸",
    "text": "…………じ、じゃあ",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010250"
  },
  {
    "id": 2022011010260,
    "speaker": "小糸",
    "text": "お糸は、一生懸命に勤めを果たします……！",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201101/2022011010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、その意気だ小糸……じゃなかった、お糸！\r\n……ん？　どっちだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011010270,
    "speaker": "小糸",
    "text": "ふふ……",
