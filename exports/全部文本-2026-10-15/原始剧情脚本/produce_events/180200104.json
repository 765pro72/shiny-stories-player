  },
  {
    "speaker": "プロデューサー",
    "text": "丸投げ……\r\nいやそうじゃなくて……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1802001040300,
    "speaker": "かな",
    "text": "あーあ、そういう人だとは思わなかったわ\r\nやっぱり他人を頼りにしちゃ駄目ね",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180200104/1802001040300"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうじゃなくて……！\r\n生き方を押し付けるわけにはいかないからさ",
    "charAnim2": "face_wait",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "kana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "かなの道はいろんなところに伸びていて……\r\n終わることはないんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1802001040310,
    "speaker": "かな",
    "text": "……必死か",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180200104/1802001040310"
  },
  {
    "id": 1802001040320,
    "speaker": "かな",
    "text": "冗談よ、ありがとう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180200104/1802001040320"
  },
  {
    "textFrame": "off",
