    "waitTime": 2000
  },
  {
    "id": 2015008110120,
    "speaker": "甜花",
    "text": "これ……国語のノートのすみっこと……\r\n歴史のノートのすみっこ……に、書いてある……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
