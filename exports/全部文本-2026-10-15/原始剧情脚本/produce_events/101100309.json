  {
    "id": 1011003090030,
    "speaker": "樹里",
    "text": "や、ほんと……\r\nここでみんなに良い報告ができて、すげー安心してる",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
