    },
    "voice": "produce_events/101100309/1011003090060"
  },
  {
    "id": 1011003090070,
    "speaker": "樹里",
    "text": "マジか！　ありがとなー！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100309/1011003090070"
  },
  {
    "id": 1011003090080,
    "speaker": "樹里",
    "text": "『樹里ちゃんがステージですごく楽しそうで\r\n特に最後にすっごくいい笑顔だったのが印象的でした』",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100309/1011003090080"
  },
  {
    "id": 1011003090090,
    "speaker": "樹里",
    "text": "『一歩一歩前に進んでいってひとつひとつ夢を\r\n叶えていく樹里ちゃんを見れて嬉しいです』",
    "charAnim1": "wait3",
