    },
    "voice": "produce_events/101100309/1011003090030"
  },
  {
    "id": 1011003090040,
    "speaker": "樹里",
    "text": "『G.R.A.D.』に関するお祝いのメッセージも\r\nたくさん送ってもらって、本当にありがとうございます",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100309/1011003090040"
  },
  {
    "id": 1011003090050,
    "speaker": "樹里",
    "text": "少しだけメッセージを紹介して\r\nお礼ができればと思います",
