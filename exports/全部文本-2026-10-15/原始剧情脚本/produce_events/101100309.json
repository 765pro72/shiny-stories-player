    "voice": "produce_events/101100309/1011003090140"
  },
  {
    "id": 1011003090150,
    "speaker": "樹里",
    "text": "みんなに、少しずつだけど恩返しできるように\r\nもっと頑張っていきたいなと思ってます",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100309/1011003090150"
  },
  {
    "id": 1011003090160,
    "speaker": "樹里",
    "text": "みんないつも、元気で、とか楽しくいるようにって\r\n言ってくれるんだけど、それはアタシだけじゃなくて",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
