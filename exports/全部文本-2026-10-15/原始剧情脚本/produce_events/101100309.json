    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100309/1011003090130"
  },
  {
    "id": 1011003090140,
    "speaker": "樹里",
    "text": "自分が色んな人に、すごく応援してもらってるんだって\r\n改めてわかって……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
