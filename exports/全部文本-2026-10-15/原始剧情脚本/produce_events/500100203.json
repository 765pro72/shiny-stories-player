  {
    "id": 5001002030010,
    "speaker": "真乃",
    "text": "──あのっ、自主練の件なんですけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030010"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、ごめんな……\r\nレッスン場使えなくて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 5001002030020,
    "speaker": "真乃",
    "text": "いえ……\r\nそれで、灯織ちゃんとめぐるちゃんと話して──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030020"
  },
  {
    "id": 5001002030030,
    "speaker": "真乃",
    "text": "空調工事をしている間は、\r\n公園で練習しようって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030030"
  },
  {
    "id": 5001002030040,
    "speaker": "真乃",
    "text": "……大丈夫でしょうか……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "──不便をかけてごめんな……\r\n公園で練習、了解だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "他の人の迷惑にならないようにだけ、気を付けて\r\nそれから──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 5001002030050,
    "speaker": "真乃",
    "text": "……？\r\nどうかしましたか……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……──あ、いや……練習、頑張ってな\r\n灯織とめぐるにも伝えておいてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 5001002030060,
    "speaker": "真乃",
    "text": "ありがとうございます、プロデューサーさん……\r\n──……それじゃあ、失礼します",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500100203/5001002030060"
