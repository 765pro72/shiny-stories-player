  {
    "id": 2014019030320,
    "speaker": "甘奈",
    "text": "……そう……だよね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401903/2014019030320"
  },
  {
    "id": 2014019030330,
    "speaker": "甘奈",
    "text": "（……いつだって、優しく、欲しい言葉を\r\nくれるんだね……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401903/2014019030330"
  },
  {
    "id": 2014019030340,
    "speaker": "甘奈",
    "text": "（でも、それなら……\r\n甘奈は……！）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401903/2014019030340"
  },
  {
    "textFrame": "off",
