    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020340"
  },
  {
    "id": 3003005020350,
    "speaker": "灯織",
    "text": "私も……料理、よくするから\r\nふたりに、食べてもらいたいんだ",
