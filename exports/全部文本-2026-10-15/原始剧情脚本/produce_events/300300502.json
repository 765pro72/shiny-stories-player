    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020350"
  },
  {
    "id": 3003005020360,
    "speaker": "真乃",
    "text": "えっ。お、お礼なんて大丈夫だよ！\r\n私たちがやりたかっただけだし……",
