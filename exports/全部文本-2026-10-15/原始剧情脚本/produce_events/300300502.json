    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020330"
  },
  {
    "id": 3003005020340,
    "speaker": "灯織",
    "text": "あの……よかったら……\r\n今度は私からもお礼をさせて",
