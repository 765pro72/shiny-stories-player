    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020410"
  },
  {
    "id": 3003005020420,
    "speaker": "灯織",
    "text": "……それとこれとは別の話\r\nほら、離れてってば",
