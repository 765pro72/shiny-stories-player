    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020400"
  },
  {
    "id": 3003005020410,
    "speaker": "めぐる",
    "text": "あれー？　今なら怒られないと思ったのにな～",
