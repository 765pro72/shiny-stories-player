    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020380"
  },
  {
    "id": 3003005020390,
    "speaker": "めぐる",
    "text": "……えへへっ、灯織、ありがとう！\r\n手料理、楽しみにしてるねっ",
