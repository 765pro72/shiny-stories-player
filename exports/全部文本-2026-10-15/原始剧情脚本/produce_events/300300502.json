    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020370"
  },
  {
    "id": 3003005020380,
    "speaker": "真乃",
    "text": "灯織ちゃん……！",
