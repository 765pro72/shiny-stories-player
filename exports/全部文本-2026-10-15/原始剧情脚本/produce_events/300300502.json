    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020430"
  },
  {
    "id": 3003005020440,
    "speaker": "めぐる",
    "text": "このやりとりも定番だもんねー！",
