    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020360"
  },
  {
    "id": 3003005020370,
    "speaker": "灯織",
    "text": "それは、私も同じ\r\n私も、ふたりにお礼がしたいの",
