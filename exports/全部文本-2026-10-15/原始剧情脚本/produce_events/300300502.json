    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020420"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait_s",
    "charLabel": "meguru"
  },
  {
    "id": 3003005020430,
    "speaker": "真乃",
    "text": "ふふっ\r\nなんだか、灯織ちゃんが帰ってきたって感じがする",
