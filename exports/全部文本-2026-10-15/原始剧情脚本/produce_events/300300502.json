    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300502/3003005020320"
  },
  {
    "id": 3003005020330,
    "speaker": "真乃",
    "text": "ほわ、良かったぁ……！",
