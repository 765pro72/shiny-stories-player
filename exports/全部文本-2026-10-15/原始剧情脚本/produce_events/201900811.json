      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201900811/2019008110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……わかった\r\nじゃあ車の中で話そう。外は寒いし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait1",
