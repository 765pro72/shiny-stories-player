  {
    "speaker": "off",
    "text": "──アイドルになろうと思ったきっかけは？",
    "textCtrl": "p",
    "textFrame": "003"
  },
{
   "speaker": "オフ",
   "textFrame": "off"
 },
  {
    "id": 1002004020120,
    "speaker": "off",
    "text": "──中学生の時の学園祭でアイドルを見て、\r\n私もあんなふうに輝きたいと思ったからです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020120"
  },
  {
    "speaker": "off",
    "text": "──好きなこと・好きなものは？",
    "textCtrl": "p",
    "textFrame": "003"
  },
{
   "speaker": "オフ",
   "textFrame": "off"
 },
  {
    "id": 1002004020130,
    "speaker": "off",
    "text": "──ありません",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……えっ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ええと……灯織……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020140,
    "speaker": "灯織",
    "text": "なんでしょうか",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100200402/1002004020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "この、好きなものについてなんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020150,
    "speaker": "灯織",
    "text": "ああ……書くことがなかったので",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020150"
  },
  {
    "id": 1002004020160,
    "speaker": "灯織",
    "text": "いけませんか？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当に全くないってことは、\r\nないんじゃないかと思うんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "よく食べるものとか、気に入ってるものとか……\r\n些細なことでいいんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020170,
    "speaker": "灯織",
    "text": "食事は偏らないようにしているので\r\n食べる頻度が高いものはありません",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020170"
  },
  {
    "id": 1002004020180,
    "speaker": "灯織",
    "text": "気に入るというのも、特に感じたことがないです",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……じゃあ、趣味の方ならどうだ？\r\n趣味って、好きなこととも言えるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020190,
    "speaker": "灯織",
    "text": "趣味は習慣として行っていることという意味で、\r\n好きという感情が動機ではないです",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうしたら、ジンクスは？\r\n前にちょっと好きって話してくれたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020200,
    "speaker": "灯織",
    "text": "ジンクスは、確かによく使いはしますが",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020200"
  },
  {
    "id": 1002004020210,
    "speaker": "灯織",
    "text": "他に言いようがなかったので、\r\nああいう表現になったに過ぎません",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうかぁ…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020220,
    "speaker": "灯織",
    "text": "……やはりダメでしょうか",
    "charAnim1": "wait3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、ダメってことはないんだけどな\r\n『好きなものがない』というのも情報だし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "プロフィールってさ、\r\n灯織のことを知りたくて見てるわけだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020230,
    "speaker": "灯織",
    "text": "……あまりよくないのはわかりました",
    "charAnim2": "face_close2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020230"
  },
  {
    "id": 1002004020240,
    "speaker": "灯織",
    "text": "でも、嘘はつきたくありません",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020240"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、無理して答えることじゃない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLabel": "hiori",
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1002004020250,
    "speaker": "灯織",
    "text": "そうですね、では……",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020250"
  },
  {
    "id": 1002004020260,
    "speaker": "灯織",
    "text": "『これから見つけていきたい』ならどうでしょうか\r\n問題ありますか？",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020260"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、いいんじゃないか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………うん、いいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『これから見つける』！",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織はさ、\r\nこれからアイドルとしてどんどん成長していく",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "その道中で、きっと色々見つけられるはずだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020270,
    "speaker": "灯織",
    "text": "そうでしょうか",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020270"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004020280,
    "speaker": "灯織",
    "text": "アイドルをやるうちに好きなものも見つかる、なんて\r\n虫が良すぎる気もしますが",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200402/1002004020280"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それは確かに\r\nでもさ、俺は信じてるよ",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
