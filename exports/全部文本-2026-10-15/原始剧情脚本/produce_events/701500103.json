      "order": 0
    },
    "bg": "00002",
    "bgm": "006"
  },
  {
    "id": 7015001030010,
    "speaker": "甜花",
    "text": "う、うん……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nあんまりうれしそうじゃないな？",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030020,
    "speaker": "甜花",
    "text": "あう……\r\nそんなこと、ない……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "何か、気になることでもあるのか？",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030030,
    "speaker": "甜花",
    "text": "ちがう、けど……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……でも何かあるなら言ってくれ\r\n甜花の気持ちは、聞いておきたいから",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030040,
    "speaker": "甜花",
    "text": "えっと……\r\nあ、あの……プロデューサーさん……",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030040"
  },
  {
    "id": 7015001030050,
    "speaker": "甜花",
    "text": "……これってすごいこと、なんだよね……？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろんだ！　あの『W.I.N.G.』で、\r\n甜花は二次予選に通過までしたんだからな",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030060,
    "speaker": "甜花",
    "text": "そっか……なんか……\r\nあんまり……実感、ない……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030060"
  },
  {
    "id": 7015001030070,
    "speaker": "甜花",
    "text": "予選、通過できたより……\r\nみんなに……迷惑かけなかったから……",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030070"
  },
  {
    "id": 7015001030080,
    "speaker": "甜花",
    "text": "そのことだけ……\r\nホッとしてる……",
    "charAnim1": "anger1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030080"
  },
  {
    "id": 7015001030090,
    "speaker": "甜花",
    "text": "甜花……\r\nいつも、迷惑かけちゃってるし……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな。俺たちは、\r\n甜花に迷惑をかけられてるなんて思ってないけど……",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "甜花は一歩ずつ、成長してきてるんだ\r\n予選もしっかりと通過してるんだし、もっと自信を持とう",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030100,
    "speaker": "甜花",
    "text": "うう……ごめんなさい……\r\n甜花……やっぱり……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030100"
  },
  {
    "id": 7015001030110,
    "speaker": "甜花",
    "text": "……あ……自信、持ててない……",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nまぁ、すぐには難しそうかな",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030120,
    "speaker": "甜花",
    "text": "うん……\r\nとにかく……あんまり、失敗しなくて良かった……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "それも甜花らしい喜び方なのかもな",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "予選を通過した実感も、きっとあとから湧いてくるよ",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030130,
    "speaker": "甜花",
    "text": "そう……なのかな……？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_shy",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nとにかく、今はおめでとう",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001030140,
    "speaker": "甜花",
    "text": "あ……ありがと……\r\nにへへ……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500103/7015001030140"
  },
