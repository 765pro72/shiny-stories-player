[
  {
    "speaker": "プロデューサー",
    "text": "第二審査も無事通過してたぞ\r\nおめでとう、甜花！",
    "charAnim1": "wait",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002",
