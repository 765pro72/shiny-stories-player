  },
  {
    "id": 3006004040320,
    "speaker": "咲耶",
    "text": "他人を思いやり\r\n痛みを理解できる優しい霧子にこそふさわしいと思うんだ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
