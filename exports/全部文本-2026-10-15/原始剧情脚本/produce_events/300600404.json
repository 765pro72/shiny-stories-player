    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600404/3006004040220"
  },
  {
    "id": 3006004040230,
    "speaker": "咲耶",
    "text": "せっかくなら、\r\nみんなのいいところを表したデザインにしたいと思ってね",
