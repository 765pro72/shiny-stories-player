  {
    "id": 2021006020120,
    "speaker": "円香",
    "text": "じゃ、目を閉じている理由は？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006020130,
    "speaker": "円香",
    "text": "さっきからずっと目を閉じてるでしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nそっちから見えてたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006020140,
    "speaker": "円香",
    "text": "衝立の隙間から",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっか、簡易シャワーだもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃ、俺の答えもつまり……\r\nそういうことだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006020150,
    "speaker": "円香",
    "text": "相変わらず紳士的なことで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "当然じゃないか\r\nというより…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "円香もよくない\r\nこんなところで引き止めないでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006020160,
    "speaker": "円香",
    "text": "なぜですか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……本当にわかっていないとは思わないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006020170,
    "speaker": "円香",
    "text": "……珍しい\r\nあなたが叱るなんて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100602/2021006020170"
  },
