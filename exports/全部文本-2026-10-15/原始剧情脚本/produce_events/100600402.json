    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1006004020150,
    "speaker": "咲耶",
    "text": "ワンマンライブのことをね、考えていたんだ",
    "charAnim1": "anger2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100600402/1006004020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020160,
    "speaker": "咲耶",
    "text": "練習をして、衣装の進捗に胸を躍らせて、\r\n曲や演出の意見を聞いてもらえたりもして",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020160"
  },
  {
    "id": 1006004020170,
    "speaker": "咲耶",
    "text": "すべての準備が、楽しくてたまらない",
    "charAnim2": "face_close3",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020170"
  },
  {
    "id": 1006004020180,
    "speaker": "咲耶",
    "text": "そして──こんなに楽しいことを、\r\nたくさんの人が応援してくれているんだな、と",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ──\r\nどこに行っても話が出るもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020190,
    "speaker": "咲耶",
    "text": "そう\r\n私たちへの期待を感じるんだ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020190"
  },
  {
    "id": 1006004020200,
    "speaker": "咲耶",
    "text": "必ず、応えなければって",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "──いやいや、咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は、今咲耶が受け取っている感情について\r\nもっといい言葉を知ってるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020210,
    "speaker": "咲耶",
    "text": "へぇ、本当かい？\r\nそれはぜひ教えてもらいたいな",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "──よし。いいか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶がファンの人たちから感じているのは──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "──『愛』だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "『期待』ももちろんある。でも、それと同じくらい\r\n『無理はしないで』って思いとか、『大好き』って思いとか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "たくさんあると思うんだ！\r\nだから全部ひっくるめて、『愛』",
    "textCtrl": "p",
    "textFrame": "002"
  },
