  {
    "speaker": "プロデューサー",
    "text": "──おお、咲耶\r\nここにいたんだな",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "005"
  },
  {
    "id": 1006004020090,
    "speaker": "咲耶",
    "text": "プロデューサー\r\nすまない、探させてしまったかい？",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "006",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/100600402/1006004020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ちょっとな\r\nそろそろ昼メシにしないか？　と思ったんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020100,
    "speaker": "咲耶",
    "text": "ああ──",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020100"
  },
  {
    "charAnim2": "face_close3",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1006004020110,
    "speaker": "咲耶",
    "text": "──もう少しだけ、待ってもらってもいいかな",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん？\r\nいいに決まってるだろ、いくらでも",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020120,
    "speaker": "咲耶",
    "text": "アナタのお腹は怒らない？",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "後でいっぱい食べ物を与えれば\r\n機嫌が取れるかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020130,
    "speaker": "咲耶",
    "text": "フフッ、そうか。それじゃあ、\r\nデザートに付き合ってくれ、というのはどうだろう？",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、バッチリ大人しくなった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006004020140,
    "speaker": "咲耶",
    "text": "フフフッ",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020140"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
