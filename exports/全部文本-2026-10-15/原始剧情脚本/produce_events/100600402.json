  },
  {
    "speaker": "プロデューサー",
    "text": "お世話になりました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "番組ディレクター",
    "text": "はい～、今日もありがとう～！\r\n──ってそうだ咲耶ちゃん！　２８３さん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "番組ディレクター",
    "text": "聞きましたよー！\r\nアンティーカちゃんたち、ワンマンやるんですよね？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "番組ディレクター",
    "text": "おめでとうって言わなきゃと思って！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1006004020020,
    "speaker": "咲耶",
    "text": "──……ありがとうございます",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600402/1006004020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おかげさまで……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "番組ディレクター",
    "text": "おかげさまで、なんてご謙遜を！\r\n私、今からもう楽しみと不安がすごいんですから！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "番組ディレクター",
    "text": "チケット争奪戦、勝ち残れるかな……！\r\nと……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいやそんな！\r\nよろしければ関係者席を──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "番組ディレクター",
    "text": "いやですよぅ、それじゃあ満足に\r\nコンサートライトも振れないじゃないですか！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "番組ディレクター",
    "text": "待っててねー咲耶ちゃん\r\n私絶対チケット取って緑振りまくるよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1006004020030,
    "speaker": "咲耶",
    "text": "フフ……！\r\nすごく楽しみです、私も絶対に見つけてみせますよ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100600402/1006004020030"
  },
  {
    "speaker": "番組ディレクター",
    "text": "わ、そのファンサ耐えられるかな……！？\r\n──頑張ってね、応援してるから！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1006004020040,
    "speaker": "咲耶",
    "text": "はい！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
