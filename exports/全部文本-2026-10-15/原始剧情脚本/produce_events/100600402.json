  },
  {
    "id": 1006004020080,
    "speaker": "咲耶",
    "text": "ありがとうございます",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
