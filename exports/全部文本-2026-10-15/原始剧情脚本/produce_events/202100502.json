  },
  {
    "speaker": "女子高生２",
    "text": "いや、思い出したんだけどさ\r\n昔、この子に言ったことあったの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生２",
    "text": "かわいいからアイドルになれそうだねって\r\nだけど、その時は興味ないって言ってたんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生２",
    "text": "誰彼構わず、媚びるのは好きじゃないって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生１",
    "text": "その言い方もどうって思うけどね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生２",
    "text": "ねー！　それなのに結局やってんじゃん！\r\n……って笑っちゃって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生１",
    "text": "やっぱ、スカウトとかされたら\r\nその気になっちゃったんじゃない？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生２",
    "text": "そうなのかな？　自分で応募したのかも",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生１",
    "text": "国民的美少女になりたいです！　って？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生２",
    "text": "アハハ、夢が大きすぎる\r\nやっぱかわいい子は違うわ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女子高生１",
    "text": "ほんと真似できないねー",
    "textCtrl": "p",
    "textFrame": "003"
  },
