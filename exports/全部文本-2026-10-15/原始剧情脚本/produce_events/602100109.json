  {
    "speaker": "プロデューサー",
    "text": "──円香……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090010,
    "speaker": "円香",
    "text": "……何か用ですか\r\nもう帰るところなんですが",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "021",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/602100109/6021001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "！　ああ、それは……すまん\r\nええと……じゃあ少しだけ──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090020,
    "speaker": "円香",
    "text": "ふふっ……",
    "charAnim1": "smile2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090020"
  },
  {
    "id": 6021001090030,
    "speaker": "円香",
    "text": "涙、ちゃんと拭いてきましたか",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……えっ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090040,
    "speaker": "円香",
    "text": "え？　まさか泣いてくれなかったんですか？",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　あ、ええと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090050,
    "speaker": "円香",
    "text": "あなたの情熱はこういう時こそ活用すべきですよね\r\n何やってるんですか？",
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "な、泣いてないとは……\r\n……その、恥ずかしいから内緒に……",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090060,
    "speaker": "円香",
    "text": "驚きです。直球勝負しか能がないあなたに\r\n恥なんて高等な感情が残っていたとは",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………一応は…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090070,
    "speaker": "円香",
    "text": "で、要件は？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "！　ああ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090071,
    "speaker": "円香＆プロデューサー",
    "text": "『優勝おめでとう！』",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090071"
  },
  {
    "id": 6021001090080,
    "speaker": "円香",
    "text": "…………それしかないですよね",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090080"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく……はは、カッコつかないなあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090090,
    "speaker": "円香",
    "text": "……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……素晴らしいステージだったよ\r\nまだ心臓がドキドキして、目頭が熱くて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ははっ、これじゃ\r\n涙を流しているのと変わらないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090100,
    "speaker": "円香",
    "text": "……とりあえず、ひとつ言っておきますが",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090100"
  },
  {
    "id": 6021001090110,
    "speaker": "円香",
    "text": "私の実力ではここまで来ることはできませんでした\r\nすべてあなたのおかげです",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090110"
  },
  {
    "id": 6021001090120,
    "speaker": "円香",
    "text": "本当にありがとうございました",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090120"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ……",
    "charAnim2": "face_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090130,
    "speaker": "円香",
    "text": "──わ、私だって……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090130"
  },
  {
    "id": 6021001090140,
    "speaker": "円香",
    "text": "嬉しくないわけじゃないんです……",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090140"
  },
  {
    "id": 6021001090150,
    "speaker": "円香",
    "text": "あからさまに喜ぶのも……\r\n……ってだけで……その……",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090150"
  },
  {
    "id": 6021001090160,
    "speaker": "円香",
    "text": "これでも……嬉しいんです……だから",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090160"
  },
  {
    "id": 6021001090170,
    "speaker": "円香",
    "text": "あ、ありがとうございます……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……とんでもない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あのな、円香\r\n優勝は間違いなく円香自身の実力だ",
    "charAnim2": "face_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分をたくさんたくさん……\r\nたーっくさん……褒めてやってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6021001090180,
    "speaker": "円香",
    "text": "…………",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/602100109/6021001090180"
  },
  {
    "id": 6021001090190,
    "speaker": "円香",
    "text": "はい、今日くらいは素直に聞いてあげます",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
