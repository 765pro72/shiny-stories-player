    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織……か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110160,
    "speaker": "灯織",
    "text": "はい、私ですけど……",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
