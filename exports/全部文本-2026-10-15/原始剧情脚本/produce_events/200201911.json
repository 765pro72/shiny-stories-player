  {
    "speaker": "プロデューサー",
    "text": "あれ？\r\nさっきまでのは……夢か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110170,
    "speaker": "灯織",
    "text": "大丈夫ですか？",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charAnim3": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110170"
  },
  {
    "id": 2002019110180,
    "speaker": "灯織",
    "text": "疲れているようですし、今日は早く家に帰って、\r\nしっかり睡眠をとってくださいね",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、大丈夫だよ\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっきまでの夢にさ、灯織が出てきたんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110190,
    "speaker": "灯織",
    "text": "ふふ、どんな夢だったんですか？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "えーと……あれ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "すごく大事な夢だったと思うんだけど\r\n何も思い出せない……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110200,
    "speaker": "灯織",
    "text": "……やっぱり働き過ぎですよ\r\nあまり無理はしないでくださいね",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110200"
  },
  {
    "id": 2002019110210,
    "speaker": "灯織",
    "text": "これからも、プロデューサーには\r\n一緒にいてもらわないといけないんですから",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
