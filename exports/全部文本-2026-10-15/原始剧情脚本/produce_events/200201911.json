  {
    "id": 2002019110140,
    "speaker": "灯織",
    "text": "……プロデューサー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110150,
    "speaker": "灯織",
    "text": "プロデューサー、\r\nこんなところで寝たら風邪をひきますよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110150"
  },
  {
