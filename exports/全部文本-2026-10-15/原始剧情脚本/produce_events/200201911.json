    "voice": "produce_events/200201911/2002019110010"
  },
  {
    "id": 2002019110020,
    "speaker": "灯織",
    "text": "ふふ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110020"
  },
  {
    "id": 2002019110030,
    "speaker": "灯織",
    "text": "──来週、楽しみにしてるね……っと",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "1346",
    "voice": "produce_events/200201911/2002019110030"
  },
  {
    "textFrame": "off",
    "bg": "00961",
    "bgEffect": "fade",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1400,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 200
  },
  {
    "id": 2002019110040,
    "speaker": "灯織",
    "text": "あっ、すみません\r\n真乃とめぐるとつい、盛り上がってしまって",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040020120",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "106",
    "voice": "produce_events/200201911/2002019110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、リラックスできているなら何よりだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういえば、イルミネのライブは\r\n来週からリハが始まるな",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110050,
    "speaker": "灯織",
    "text": "はい、振りもしっかり確認してありますし\r\n体力作りも完璧ですよ",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そこは心配してないけど、\r\n楽しみだなあって思ってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110060,
    "speaker": "灯織",
    "text": "そうですね\r\n１年に１回の大事なライブですし",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "今のイルミネは、個人の活動で\r\nそれぞれ力をつけているから",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "３人が集まると、毎年すごく成長を感じるんだよなあ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110070,
    "speaker": "灯織",
    "text": "ふふっ、期待を裏切らないように頑張ります",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110070"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "2119",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "textFrame": "off",
    "se": "2091",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ……？　珍しいな、灯織がスマホに\r\nそういうのつけてるの",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110080,
    "speaker": "灯織",
    "text": "あ……えっと、これは────",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201911/2002019110080"
  },
  {
    "id": 2002019110090,
    "speaker": "灯織",
    "text": "今日のラッキーアイテムが\r\n『キャラクター物のシール』だったので……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110100,
    "speaker": "灯織",
    "text": "今日はこれから大事な舞台のリハですし、\r\n気合いを入れたかったんです",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110100"
  },
  {
    "id": 2002019110110,
    "speaker": "灯織",
    "text": "……そろそろ占いチェックは卒業しようかなとは\r\n思っているんですが……もう習慣になっていて",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、そのままでいいんじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、俺は灯織のそういう変わらないところを\r\n見ると安心するよ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110120,
    "speaker": "灯織",
    "text": "安心……ですか？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺が気づかない間に、灯織がどんどん先に\r\n進んでいっちゃってるみたいにも感じてたからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺が昔から知ってる灯織だって思うと\r\nほっとするんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002019110130,
    "speaker": "灯織",
    "text": "そういう言い方はずるいですよ……\r\n占いチェックやめられないじゃないですか",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201911/2002019110130"
