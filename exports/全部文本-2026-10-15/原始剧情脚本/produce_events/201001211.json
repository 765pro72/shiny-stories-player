    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2010012110020,
    "speaker": "？？？",
    "text": "振り向いちゃダメですよ！\r\nわかっちゃいますから！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001211/2010012110020"
  },
  {
    "id": 2010012110030,
    "speaker": "？？？",
    "text": "さすがに目隠しはできないですからね\r\n届かないですし……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001211/2010012110030"
  },
  {
    "id": 2010012110040,
    "speaker": "？？？",
    "text": "──あ、今のヒント１です！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001211/2010012110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（振り向かなくたって、声でわかる）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010012110050,
    "speaker": "？？？",
    "text": "ヒント２、いりますか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001211/2010012110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いらないいらない\r\nさすがに外さないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "智代子だろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010012110060,
    "speaker": "？？？",
    "text": "ふふっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001211/2010012110060"
  },
  {
