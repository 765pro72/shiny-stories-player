    "waitTime": 400
  },
  {
    "id": 2010012110070,
    "speaker": "智代子",
    "text": "──正解です！　プロデューサーさん！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
