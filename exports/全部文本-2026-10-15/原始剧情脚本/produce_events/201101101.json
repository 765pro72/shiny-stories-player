    "textFrame": "001",
    "voice": "produce_events/201101101/2011011010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "音量を上げればいけるもんだぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011011010120,
    "speaker": "樹里",
    "text": "大丈夫か……？　それ……",
