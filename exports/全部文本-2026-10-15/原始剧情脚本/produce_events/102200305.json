    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102200305/1022003050250"
  },
  {
    "id": 1022003050260,
    "speaker": "小糸",
    "text": "オーディションだって、いつも\r\nプロデューサーさんが探して、持ってきてくれて",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050260"
  },
  {
    "id": 1022003050270,
    "speaker": "小糸",
    "text": "その他にも、すごく……\r\nたくさん、サポートしてくれてて",
    "charAnim1": "smile1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050270"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050280,
    "speaker": "小糸",
    "text": "なのにわたしは、\r\nなんとなく……なんのためでもない練習をして",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050280"
  },
  {
    "id": 1022003050290,
    "speaker": "小糸",
    "text": "わたしだって、『何か』のために頑張りたいのにって\r\n──……いつも",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050290"
  },
  {
    "id": 1022003050300,
    "speaker": "小糸",
    "text": "その『何か』が来てくれるのを\r\nただ、待ってるだけだったんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050300"
  },
  {
    "id": 1022003050310,
    "speaker": "小糸",
    "text": "……今までずっと、そうだったんです……",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050310"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1022003050320,
    "speaker": "小糸",
    "text": "だ、だけどもう、それじゃだめで\r\n自分で、考えていかなきゃいけないんだって……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050320"
  },
  {
    "id": 1022003050330,
    "speaker": "小糸",
    "text": "じ、自分と向き合って、できることも\r\n……できないことも、理解して",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050330"
  },
  {
    "id": 1022003050340,
    "speaker": "小糸",
    "text": "ど、どうやったらなりたいって思った目標に、\r\n……近づいていけるのか、考えていきたくて……！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050340"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうか\r\nそういうふうに、考えてくれたんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──うん\r\nそういうことならさ、小糸",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "一緒に考え\r\nさせてくれないか",
    "nextLabel": "1"
  },
  {
    "select": "やっぱり\r\nすごいよ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "それを二番目の\r\n課題にしよう",
    "nextLabel": "3"
  },
  {
    "id": 1022003050350,
    "label": "1",
