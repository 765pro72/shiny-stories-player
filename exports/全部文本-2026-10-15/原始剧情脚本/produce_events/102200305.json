      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102200305/1022003050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろん\r\nなんでも話してくれ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050110,
    "speaker": "小糸",
    "text": "…………そ、その……！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050110"
  },
  {
    "id": 1022003050120,
    "speaker": "小糸",
    "text": "ど、どんなアイドルになりたいか考えるのが\r\nわたしの、一番最初の課題だって",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050120"
  },
  {
    "id": 1022003050130,
    "speaker": "小糸",
    "text": "プロデューサーさんが言ったの、\r\n覚えてますか……？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、覚えてるよ\r\n最初、小糸が面接に来てくれた時だよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050140,
    "speaker": "小糸",
    "text": "は、はい……！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050140"
  },
  {
    "id": 1022003050150,
    "speaker": "小糸",
    "text": "それを言われてから、わたし……\r\nよく、考えてて",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、知ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸にアイドルとしての目標が見つかってよかったし、\r\nすごく嬉しく思ってるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050160,
    "speaker": "小糸",
    "text": "…………",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050160"
  },
  {
    "id": 1022003050170,
    "speaker": "小糸",
    "text": "で、でも……わたし\r\nどうなりたいかって、そればっかりで",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050170"
  },
  {
    "id": 1022003050180,
    "speaker": "小糸",
    "text": "どうやったらそうなれるのかって事……\r\nちゃんと考えられて、ませんでした",
    "charAnim1": "wait4",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050190,
    "speaker": "小糸",
    "text": "全然、地に足が着いてない……\r\nゆ、夢みたいな話だったんだって思って",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050190"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！\r\nそんなことはないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "すごく、良い目標だと思うし……\r\nきっと叶えられると、俺は思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050200,
    "speaker": "小糸",
    "text": "…………\r\nど、どうやってですか……？",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050200"
  },
  {
    "speaker": "プロデューサー",
    "text": "え…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050210,
    "speaker": "小糸",
    "text": "……特別な何かが、あるわけでも無くて",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050210"
  },
  {
    "id": 1022003050220,
    "speaker": "小糸",
    "text": "な、なのに……\r\n自分のだめなところを見せるのは、嫌で",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050220"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、それは……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050230,
    "speaker": "小糸",
    "text": "どうやったら、みんなに見てもらえるか……とか、\r\n応援してもらえるのかっていう……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050230"
  },
  {
    "id": 1022003050240,
    "speaker": "小糸",
    "text": "一番難しいことを、プロデューサーさんにばっかり\r\nお願いしちゃってたんだなって……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200305/1022003050240"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、それが俺の仕事で──…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "koito",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……俺が上手くやれてないから\r\n小糸に不安な想い、させちゃってるよな、ごめん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003050250,
    "speaker": "小糸",
    "text": "あ……えっと、そ、そうじゃなくて……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
