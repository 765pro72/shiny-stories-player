  },
  {
    "id": 1022003050100,
    "speaker": "小糸",
    "text": "ちょっとだけ、\r\n話、してもいいですか……？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
