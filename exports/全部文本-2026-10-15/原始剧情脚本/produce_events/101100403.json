    "textFrame": "001",
    "voice": "produce_events/101100403/1011004030040"
  },
  {
    "id": 1011004030050,
    "speaker": "樹里",
    "text": "えーと……\r\n大丈夫でしたか……？",
    "charAnim1": "wait1",
