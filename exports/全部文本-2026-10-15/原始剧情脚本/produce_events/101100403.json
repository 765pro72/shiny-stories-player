    "voice": "produce_events/101100403/1011004030030"
  },
  {
    "id": 1011004030040,
    "speaker": "樹里",
    "text": "ミニドラマとはいえ\r\nアタシ、こういう恋愛系？　の演技って慣れてなくて……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
