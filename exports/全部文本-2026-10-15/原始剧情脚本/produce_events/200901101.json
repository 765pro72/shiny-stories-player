    "textFrame": "001",
    "voice": "produce_events/200901101/2009011010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなんだな……！　そういえば、友達は？\r\nさっき一緒にいたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009011010160,
    "speaker": "果穂",
    "text": "プロデューサーさん、見てたんですかっ！",
