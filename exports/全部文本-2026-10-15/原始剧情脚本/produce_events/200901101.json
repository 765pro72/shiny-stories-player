  {
    "id": 2009011010140,
    "speaker": "果穂",
    "text": "お参りしてるプロデューサーさんが見えたので、\r\n直接言いたくて……えへへっ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
