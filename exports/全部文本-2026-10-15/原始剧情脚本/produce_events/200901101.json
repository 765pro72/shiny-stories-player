    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901101/2009011010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、あけましておめでとう！\r\n晴れ着似合ってるよ。いい柄だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009011010150,
    "speaker": "果穂",
    "text": "えへへっ、ありがとうございますっ！\r\nお母さんと選んだんです！",
