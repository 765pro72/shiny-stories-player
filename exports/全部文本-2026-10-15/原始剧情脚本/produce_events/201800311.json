    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800311/2018003110110"
  },
  {
    "id": 2018003110120,
    "speaker": "冬優子",
    "text": "でも、今聞きたいのはそういうのじゃない\r\nみんながふゆをどう思ったかとかじゃなくて……",
