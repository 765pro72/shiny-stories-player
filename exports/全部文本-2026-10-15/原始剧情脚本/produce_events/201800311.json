  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん、よかったぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018003110040,
    "speaker": "冬優子",
    "text": "ほんと？\r\n今日出てた他のアイドルの誰より！？",
    "charAnim1": "sad1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800311/2018003110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n間違いなく、冬優子が一番だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018003110050,
