  {
    "speaker": "プロデューサー",
    "text": "ソロステージお疲れ様\r\nずいぶんご機嫌だな",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018003110020,
    "speaker": "冬優子",
    "text": "だって今日のふゆ、絶好調なんだもん！\r\n最高のパフォーマンスができちゃった！",
    "charAnim1": "smile4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800311/2018003110020"
  },
  {
    "id": 2018003110030,
    "speaker": "冬優子",
    "text": "ね、どうだった？\r\nふゆのステージ！",
    "charAnim1": "anger2",
