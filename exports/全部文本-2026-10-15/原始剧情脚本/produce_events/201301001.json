  {
    "speaker": "プロデューサー",
    "text": "夏葉の得意分野を\r\n生かせるって感じがしてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010020,
    "speaker": "夏葉",
    "text": "そうね、新しいお仕事は\r\nなんだって楽しみだけれど",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……夏葉は仕事、\r\nほとんど断ったことないもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010030,
    "speaker": "夏葉",
    "text": "アナタが持ってきてくれる仕事だもの\r\n全部やる価値のあることでしょう？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう言ってもらえると\r\nプロデューサー冥利に尽きるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010040,
    "speaker": "夏葉",
    "text": "だけど、確かに今回は……\r\nいつもよりもっと特別かもしれないわ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010040"
  },
  {
    "id": 2013010010050,
    "speaker": "夏葉",
    "text": "……ふふっ\r\nとっても楽しみよ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "──だと思った",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今日の打ち合わせも、\r\n楽しんでいこう！",
