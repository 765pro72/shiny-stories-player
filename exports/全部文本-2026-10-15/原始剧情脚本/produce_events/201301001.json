    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、すまん\r\nいい仕事だと思ったんだが",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "先方があんな感じだとは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010160,
    "speaker": "夏葉",
    "text": "ふふ、そうね",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010160"
  },
  {
    "id": 2013010010170,
    "speaker": "夏葉",
    "text": "でも、いいじゃない\r\nその方が燃えるわ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
