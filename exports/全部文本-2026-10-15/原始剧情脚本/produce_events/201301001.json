    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2013010010190,
    "speaker": "夏葉",
    "text": "──なんて、少し大人気なかったかしら",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201301001/2013010010190"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "先方もびっくりするくらい\r\n堂々としてた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010200,
    "speaker": "夏葉",
    "text": "あんなふうに言い返して、\r\n子どもっぽかったかしら？",
    "charAnim1": "think",
    "charAnim2": "face_sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、そんなことは無いよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010210,
    "speaker": "夏葉",
    "text": "私、もう聞かなくてもわかるの\r\n『夏葉は上手くやれる』って",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010210"
  },
  {
    "id": 2013010010220,
    "speaker": "夏葉",
    "text": "アナタがそう言ってくれること",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010220"
  },
  {
    "id": 2013010010230,
    "speaker": "夏葉",
    "text": "だからいつだって、\r\n自信を持っていられるのよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201301001/2013010010230"
  },
  {
    "id": 2013010010240,
    "label": "3",
    "speaker": "夏葉",
    "text": "……ふふっ",
    "charAnim1": "surp1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010240"
  },
  {
    "id": 2013010010250,
    "speaker": "夏葉",
    "text": "隣のアナタの方がなんだか怒っている気がして\r\nかえって冷静になれたわ",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……？\r\nすまん、でもあんな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010260,
    "speaker": "夏葉",
    "text": "大丈夫、自信もあるの\r\nただ見せてあげればいいだけ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010260"
  },
  {
    "id": 2013010010270,
    "speaker": "夏葉",
