  },
  {
    "speaker": "プロデューサー",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013010010180,
    "speaker": "夏葉",
    "text": "言い返してしまうくらいには私、自信があるけど\r\n……アナタだってそうでしょう？",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301001/2013010010180"
  },
  {
    "charAnim1": "wait4",
