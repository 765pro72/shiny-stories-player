    "voice": "produce_events/301700502/3017005020170"
  },
  {
    "id": 3017005020180,
    "speaker": "愛依",
    "text": "あ、今日っていつもと違う特別な日だ、って……\r\nそんで雪も降ってたから、余計そう思ったのかも",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
