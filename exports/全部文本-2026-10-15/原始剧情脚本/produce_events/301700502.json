    "textFrame": "001",
    "voice": "produce_events/301700502/3017005020270"
  },
  {
    "id": 3017005020280,
    "speaker": "愛依",
    "text": "あー、へーきへーき\r\nうちん家、いっつもうるさいから！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301700502/3017005020280"
  },
  {
    "id": 3017005020290,
    "speaker": "愛依",
    "text": "みんな、『家にアイドルがいる！』とか言っちゃって！\r\nうちだってアイドルなんだけど～",
