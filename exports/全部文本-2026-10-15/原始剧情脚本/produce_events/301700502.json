    "textFrame": "001",
    "voice": "produce_events/301700502/3017005020180"
  },
  {
    "id": 3017005020190,
    "speaker": "愛依",
    "text": "寝る前……目が覚めたとき、\r\nどんな景色になってるんだろって思ったり……",
