  },
  {
    "speaker": "プロデューサー",
    "text": "音？　ああ……\r\nまたうるさかったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004060090,
    "speaker": "あさひ",
    "text": "大丈夫っす！\r\n何見てたっすか？",
