    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "『──普段はこんなにキュートだけど』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ライブではしびれるほどかっこいい！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『底知れない可能性がいっぱいのあさひちゃん\r\n今後の成長が楽しみ』──だって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004060100,
    "speaker": "あさひ",
    "text": "成長っすか？",
