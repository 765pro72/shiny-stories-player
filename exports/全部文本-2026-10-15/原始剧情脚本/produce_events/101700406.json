    "text": "そうだな、たとえば……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "また別の『新しいこと』をやってみたり",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017004060120,
    "speaker": "あさひ",
