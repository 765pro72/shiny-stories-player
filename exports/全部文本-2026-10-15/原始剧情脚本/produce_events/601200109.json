    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601200109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601200109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601200109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601200109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601200109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601200109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textFrame": "off",
    "bg": "00016",
    "bgEffect": "fade",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ついに『W.I.N.G.』で優勝か……\r\n初めて会ったときの約束、果たすことができたな",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "000"
  },
  {
    "id": 6012001090010,
    "speaker": "凛世",
    "text": "はい……\r\nプロデューサーさまには、感謝するばかりでございます",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "012",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "voice": "produce_events/601200109/6012001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090020,
    "speaker": "凛世",
    "text": "……",
    "charAnim2": "face_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "凛世？\r\n今日はどうしてそんなに離れてるんだ？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090030,
    "speaker": "凛世",
    "text": "それは……その……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "その？",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090040,
    "speaker": "凛世",
    "text": "先程の、ライブを思い出すと……\r\n痛いほどに、胸が高鳴るのです",
    "charAnim1": "smile3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090040"
  },
  {
    "id": 6012001090050,
    "speaker": "凛世",
    "text": "今……プロデューサーさまの、お傍へ寄ると……\r\n胸が、本当に、はり裂けてしまいそうで……",
    "charAnim1": "shy3",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……俺もまだあのライブの興奮が冷めてないよ\r\nよかったら、聞かせてくれないか",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090060,
    "speaker": "凛世",
    "text": "……？",
    "charAnim2": "face_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、えっと、今日の感想だよ\r\n今日あったいろいろな話を凛世の言葉で聞きたいんだ",
    "textFrame": "002"
  },
  {
    "id": 6012001090070,
    "speaker": "凛世",
    "text": "はい……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090070"
  },
  {
    "id": 6012001090080,
    "speaker": "凛世",
    "text": "……本日の舞台は、今までにないほど広く……",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090080"
  },
  {
    "id": 6012001090090,
    "speaker": "凛世",
    "text": "凛世は驚きとともに、恐ろしさを感じました……\r\n失敗すれば、すべて終わってしまうのではないかと……",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090090"
  },
  {
    "id": 6012001090100,
    "speaker": "凛世",
    "text": "けれど、舞台に立つと……\r\nみなさまが、凛世を、励ましてくださり……",
    "charAnim1": "shy3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090100"
  },
  {
    "id": 6012001090110,
    "speaker": "凛世",
    "text": "とても、素敵、でした……\r\nいつまでも、いつまでも、舞台に立っていたいような……",
    "charAnim1": "smile3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090110"
  },
  {
    "id": 6012001090120,
    "speaker": "凛世",
    "text": "そして、みなさまの想いに応えねばと思ううちに……\r\n恐ろしさは、いつしか消えておりました……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090120"
  },
  {
    "id": 6012001090130,
    "speaker": "凛世",
    "text": "ふと、見上げると……\r\nまるで星空のような光景が、眼前に……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090130"
  },
  {
    "id": 6012001090140,
    "speaker": "凛世",
    "text": "天の海に雲の波が立ち、\r\n月の舟が星の林に分け入っていく……",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090140"
  },
  {
    "id": 6012001090150,
    "speaker": "凛世",
    "text": "光が、歌に合わせて輝くさまは\r\nそれは美しく……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090150"
  },
  {
    "id": 6012001090160,
    "speaker": "凛世",
    "text": "歌が終わっても、輝きは増すばかり……",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090160"
  },
  {
    "id": 6012001090170,
    "speaker": "凛世",
    "text": "まばゆい光と、歓声に包まれ、凛世は……\r\nアイドルになってよかったと、心から思えたのです",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……すごくいい体験をしたんだな、凛世",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090180,
    "speaker": "凛世",
    "text": "はい……",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090180"
  },
  {
    "id": 6012001090190,
    "speaker": "凛世",
    "text": "プロデューサーさま……\r\n改めて、お礼を……言わせてください",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090190"
  },
  {
    "id": 6012001090200,
    "speaker": "凛世",
    "text": "お声掛けいただいたあの日から……\r\n凛世の世界は、ぱあっと、明るくなりました",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090200"
  },
  {
    "id": 6012001090210,
    "speaker": "凛世",
    "text": "本当に、感謝しております\r\nプロデューサーさま",
    "charAnim1": "shy3",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090210"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、俺は大したことはしてないよ",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も、凛世のおかげでここまでこれたんだ\r\n凛世と一緒に歩いてきたおかげで、見える世界が広がった",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺もあのとき、凛世に会えてよかった……\r\n……ありがとう",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090220,
    "speaker": "凛世",
    "text": "プロデューサーさま……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090220"
  },
  {
    "id": 6012001090230,
    "speaker": "凛世",
    "text": "貴方さまは、凛世にとって、\r\n何物にも代えがたきお方……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090230"
  },
  {
    "id": 6012001090240,
    "speaker": "凛世",
    "text": "ですので、どうか、これからずっと、ずっと……\r\n凛世をお傍に置いて、くださいませ",
    "charAnim1": "smile3",
    "charLipAnim": "lip_anger",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだ！\r\nもっともっと……いろんな経験をしていこう",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こちらこそよろしくな。凛世",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6012001090250,
    "speaker": "凛世",
    "text": "はい……！　ふつつかものですが\r\n末永く、お頼み申し上げます。プロデューサーさま",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601200109/6012001090250"
  },
  {
    "label": "end"
  }
]