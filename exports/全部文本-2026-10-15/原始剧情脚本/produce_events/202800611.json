  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、朝に送ったやつだよな？\r\nまだ見てなかったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2028006110030,
    "speaker": "はるき",
    "text": "はい\r\nプロデューサーさんと見たくて……！",
