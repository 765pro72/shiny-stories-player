    "charLipAnim": "lip_smile",
    "charLabel": "haruki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202800611/2028006110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……\r\nいいけど、実は俺は一度見てるんだが──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2028006110050,
