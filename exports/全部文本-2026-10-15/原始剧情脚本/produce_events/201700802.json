  {
    "id": 2017008020050,
    "speaker": "あさひ",
    "text": "お待たせっす、プロデューサーさん",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
