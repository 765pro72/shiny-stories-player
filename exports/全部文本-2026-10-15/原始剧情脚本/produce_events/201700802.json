  {
    "speaker": "プロデューサー",
    "text": "あ、あの、すみません\r\nちょっとよろしいでしょうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "主演俳優",
    "text": "あ、あなた、あさひちゃんの……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい。先程は芹沢が申し訳ありません\r\n後でしっかり言い聞かせますので……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "主演俳優",
    "text": "あ、あれね……わざわざありがとう\r\n私は気にしてないですし、そんなに叱らないであげてね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "主演俳優",
    "text": "あの年代の子って、いくら寝ても眠かったりするでしょ？\r\nただでさえ、あさひちゃんは仕事も学校もあるんだし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ありがとうございます……\r\nそんなふうに言っていただくなんて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
