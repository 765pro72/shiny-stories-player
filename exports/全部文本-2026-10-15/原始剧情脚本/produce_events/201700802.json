  },
  {
    "id": 2017008020230,
    "label": "3",
    "speaker": "あさひ",
    "text": "んー……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textCtrl": "p",
