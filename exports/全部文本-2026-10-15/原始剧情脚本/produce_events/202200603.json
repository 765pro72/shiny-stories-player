    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "100",
    "voice": "produce_events/202200603/2022006030010"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸、すごい集中してたな\r\n何回も呼んだんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030020,
    "speaker": "小糸",
    "text": "そ、そうだったんですか……？\r\nすみません……！",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、それはいいんだけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "道で集中しすぎるのはよくないよ\r\n危ないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030030,
    "speaker": "小糸",
    "text": "そ、そうですよね……！",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030030"
  },
  {
    "id": 2022006030040,
    "speaker": "小糸",
    "text": "もしこの単語が番組の試験に出たら……\r\nって思うと",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030040"
  },
  {
    "id": 2022006030050,
    "speaker": "小糸",
    "text": "ちょっとでも時間\r\n無駄にしたくないなって思っちゃって……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030060,
    "speaker": "小糸",
    "text": "信号待ちのところで単語覚えようと思って\r\n単語帳出したら、そのまま来ちゃいました",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030060"
  },
  {
    "id": 2022006030070,
    "speaker": "小糸",
    "text": "今度からは\r\nき、気を付けますね……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030070"
  },
  {
    "charAnim1": "wait",
    "charLabel": "koito",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00302",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……小糸",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "番組に向けて一生懸命取り組んでくれて\r\n嬉しいし、できる限り応援したいと思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん番組の試験に合格して\r\n出演できたらすごく、良いことだと思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だけど、無理してほしい訳じゃないんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00630",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 2022006030080,
    "speaker": "小糸",
    "text": "…………\r\nプロデューサーさん……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202200603/2022006030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "学校の勉強もあれば、レッスンもしてる中で\r\n時間を捻出するのも難しいだろうし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "少しの時間も無駄にしたくないって気持ちは\r\nすごくよくわかるんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで小糸に何かあったらきっと後悔する\r\n俺も、小糸も",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030090,
    "speaker": "小糸",
    "text": "…………",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030090"
  },
  {
    "id": 2022006030100,
    "speaker": "小糸",
    "text": "そう、ですよね",
    "charAnim1": "wait4",
    "charAnim2": "face_down",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030100"
  },
  {
    "id": 2022006030110,
    "speaker": "小糸",
    "text": "もし事故とかにあったら、\r\nプロデューサーさんにも迷惑かけちゃうし",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030110"
  },
  {
    "id": 2022006030120,
    "speaker": "小糸",
    "text": "番組の試験も、受けられないですもんね",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、それに────……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030130,
    "speaker": "小糸",
    "text": "でも、わたし！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030140,
    "speaker": "小糸",
    "text": "無理は、してないですよ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "え…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030150,
    "speaker": "小糸",
    "text": "今、すごく楽しいんです\r\nこうやって、勉強してるの",
    "charAnim1": "sad2",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030160,
    "speaker": "小糸",
    "text": "はい",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030160"
  },
  {
    "id": 2022006030170,
    "speaker": "小糸",
    "text": "……今までは、とにかくやらなきゃって\r\nそうしなきゃいけないんだって",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030170"
  },
  {
    "id": 2022006030180,
    "speaker": "小糸",
    "text": "何かに追われるみたいに\r\n参考書をめくってましたけど",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030180"
  },
  {
    "id": 2022006030190,
    "speaker": "小糸",
    "text": "今は本当に自分が\r\nやりたいって思ってやってるから",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030190"
  },
  {
    "id": 2022006030200,
    "speaker": "小糸",
    "text": "……だから、すごく楽しいんです",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nそれは、良いことだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030210,
    "speaker": "小糸",
    "text": "は、はい……！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030210"
  },
  {
    "id": 2022006030220,
    "speaker": "小糸",
    "text": "わたしも、自分がこんなふうに思えるなんて\r\n自分でも、少しびっくりしてるんです",
    "charAnim1": "shy1",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸にとって良い変化が生まれたなら\r\nそれはすごく嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006030230,
    "speaker": "小糸",
    "text": "学校の勉強とかも、自分のためになることだって\r\n前よりも思えるようになった気がして",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030230"
  },
  {
    "id": 2022006030240,
    "speaker": "小糸",
    "text": "試験以外で、具体的にどこで役に立つかは\r\nわかんないことも多いですけど……でも",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200603/2022006030240"
