  {
    "id": 2022006030010,
    "speaker": "小糸",
    "text": "──ぷ、プロデューサーさん……！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
