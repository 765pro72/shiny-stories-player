  {
    "speaker": "プロデューサー",
    "text": "休憩しよう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007040360,
    "label": "3",
    "speaker": "果穂",
    "text": "え！？\r\nで、でも──……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
