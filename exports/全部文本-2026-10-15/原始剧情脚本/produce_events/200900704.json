    "voice": "produce_events/200900704/2009007040330"
  },
  {
    "speaker": "プロデューサー",
    "text": "──よかった\r\n大丈夫そうだな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009007040340,
    "speaker": "果穂",
    "text": "はいっ！\r\nラッシー、スッゴく美味しいです！",
