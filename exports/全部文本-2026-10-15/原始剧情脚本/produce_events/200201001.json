    "waitType": "time",
    "waitTime": 400
  },
  {
    "id": 2002010010250,
    "speaker": "灯織",
    "text": "ただ、やっぱり性分なので……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201001/2002010010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "情報は大事だからな！\r\n持ってるかそうじゃないかで、全然違うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事にも必ず役に立つ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010010260,
    "speaker": "灯織",
    "text": "プロデューサー……\r\nありがとうございます",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織の情報だと、あと少しなんだろ？\r\nじゃあ、もうひとふんばりだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010010270,
    "speaker": "灯織",
    "text": "ふふ……はい",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010270"
  },
  {
    "id": 2002010010280,
    "speaker": "灯織",
    "text": "行きましょう……！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
