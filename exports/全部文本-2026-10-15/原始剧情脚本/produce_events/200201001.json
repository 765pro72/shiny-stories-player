  {
    "id": 2002010010290,
    "speaker": "灯織",
    "text": "なんだか、時間がゆっくり流れているような気がします",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010290"
  },
  {
    "id": 2002010010300,
    "speaker": "灯織",
    "text": "他にお客さんがいないので、\r\n色々な音も良く聞こえますし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010300"
  },
  {
    "textFrame": "off",
    "se": "0426",
    "waitType": "time",
    "waitTime": 5000
  },
  {
    "speaker": "プロデューサー",
    "text": "……本当だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと怖くなるくらい穏やかだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010010310,
    "speaker": "灯織",
    "text": "そうですね……でも──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010310"
  },
  {
    "id": 2002010010320,
    "speaker": "灯織",
    "text": "今日はただの下見ですから、\r\nこんな日があってもいいのではないでしょうか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201001/2002010010320"
  },
  {
    "speaker": "プロデューサー",
    "text": "……それもそうだな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかくだし、思いっきりゆっくりするか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010010330,
    "speaker": "灯織",
    "text": "はい……！",
    "textCtrl": "p",
