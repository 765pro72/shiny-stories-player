  },
  {
    "id": 7901001080020,
    "speaker": "はづき",
    "text": "私には、どうして彼女が参加できないのか\r\nちっともわかりません……！",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hazuki",
