  },
  {
    "id": 1014001020050,
    "speaker": "甘奈",
    "text": "みんなー！　今日は、よっろしくー！\r\n楽しんでいこうねー！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400102/1014001020050"
  },
  {
    "effectLabel": "black1",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 240
    }
  },
  {
