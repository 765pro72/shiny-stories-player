  },
  {
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "id": 1014001020060,
    "speaker": "甘奈",
    "text": "えへ、ありがとー！\r\n甘奈もみんなのこと、大好きだよー！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400102/1014001020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（甘奈、堂々としているな\r\nうん、お客さんにちゃんとレスもできている）",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（デビューしたてで、\r\nイベントにもまだ不慣れなはずなのに、すごいぞ）",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
