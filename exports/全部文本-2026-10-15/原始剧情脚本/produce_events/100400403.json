  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "悲しそうな話し方にしようとして、\r\n声が響いてない感じがしたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004004030140,
    "speaker": "恋鐘",
    "text": "響いてない……\r\nそうかもしれんね……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400403/1004004030140"
  },
  {
    "id": 1004004030150,
    "speaker": "恋鐘",
    "text": "うち、気持ちをこめるのに必死で\r\n発声のことまで気が回っとらんかった……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
