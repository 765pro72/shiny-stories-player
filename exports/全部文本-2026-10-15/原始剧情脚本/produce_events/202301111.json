    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202301111/2023011110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、なんとなくわかる気がするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023011110060,
    "speaker": "雛菜",
    "text": "コンセプトは……\r\n『Happy♡LUCKY♡charmmy』……なんだって～！",
