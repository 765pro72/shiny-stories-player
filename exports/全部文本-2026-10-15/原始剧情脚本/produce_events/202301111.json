    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202301111/2023011110040"
  },
  {
    "id": 2023011110050,
    "speaker": "雛菜",
    "text": "すっごくかわいいし、\r\n見てるだけでしあわせ～な気持ちになれる気がする～",
