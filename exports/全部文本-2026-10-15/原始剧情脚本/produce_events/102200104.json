    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040110"
  },
  {
    "id": 1022001040120,
    "speaker": "小糸",
    "text": "だから、これは頑張ってるうちに入りません\r\n……普通の、当たり前のことだから",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなこと……",
    "charAnim2": "face_wait",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
  {
    "id": 1022001040130,
    "speaker": "小糸",
    "text": "みんな、すごいんですよー\r\nダンスだって、ちょっとやったらすぐ覚えるし！",
