    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040150"
  },
  {
    "id": 1022001040160,
    "speaker": "小糸",
    "text": "みんなと一緒にいたいのに、\r\n一緒にいてもわたしだけいつも遅れてて",
