    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "008",
    "voice": "produce_events/102200104/1022001040130"
  },
  {
    "id": 1022001040140,
    "speaker": "小糸",
    "text": "……昔からそうでした\r\nみんな、なんでもできて……きっと、特別なんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040140"
  },
  {
    "id": 1022001040150,
    "speaker": "小糸",
    "text": "わたしもそうなりたくて…………\r\nいつも…………",
