    "charLipAnim": "lip_surp2",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040160"
  },
  {
    "id": 1022001040170,
    "speaker": "小糸",
    "text": "一緒にいるはずなのに、\r\nひとりぼっちになるんじゃないかって",
