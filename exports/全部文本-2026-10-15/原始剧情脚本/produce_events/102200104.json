    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 1022001040070,
    "speaker": "小糸",
    "text": "い、いえ！　わたしはよゆーですよ\r\n全然平気です！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか\r\nそれならいいんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸、すごく頑張ってるみたいだからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001040080,
    "speaker": "小糸",
    "text": "……別に普通ですよ、このくらい\r\nわたしにしてみれば、朝飯前って感じです！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、だけど心配はするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001040090,
    "speaker": "小糸",
    "text": "…………",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "もしかしたら小糸は、頑張ってるところ見られるの\r\nあまり好きじゃないのかもしれないけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、どのくらい小糸が頑張ってるか\r\n知っておきたいからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こっそりでもいいから、教えてもらえると嬉しいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001040100,
    "speaker": "小糸",
    "text": "………………\r\nわたし、頑張ってるって思いますか？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp2",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200104/1022001040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001040110,
    "speaker": "小糸",
    "text": "……だけど、わたしが頑張って\r\nようやく他のみんなの普通くらいです",
