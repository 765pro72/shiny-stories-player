    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400310/6014003100050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうやって注意ができるうちは、全然ダメじゃないだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014003100060,
    "speaker": "甘奈",
    "text": "また～～～～……！",
