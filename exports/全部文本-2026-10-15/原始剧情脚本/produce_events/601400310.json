  {
    "id": 6014003100020,
    "speaker": "甘奈",
    "text": "──ごめんなさい、プロデューサーさん\r\n甘奈、結果出せなかったや",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
