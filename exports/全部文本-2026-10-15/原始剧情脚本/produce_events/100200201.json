  },
  {
    "id": 1002002010160,
    "speaker": "灯織",
    "text": "だからきっと、みなさんがそれぞれ覚えている私より──\r\n成長している姿を、見せられるはずなんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200201/1002002010160"
