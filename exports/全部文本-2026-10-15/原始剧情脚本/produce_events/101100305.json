    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もっと自分のやってることを信じていい\r\nそれが難しいなら、ファンを信じてみればいい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050230,
    "speaker": "樹里",
    "text": "……うん、そうだよな",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
