    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050220"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里はちゃんと、アイドルだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "プロデューサーとしても、\r\nファンとしてもそう思う",
