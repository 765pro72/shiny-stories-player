  },
  {
    "select": "アイドル、\r\n楽しんでくれ",
    "nextLabel": "1"
  },
  {
    "select": "いつも、\r\n元気でいてくれ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "もっと\r\n自信を持ってくれ",
    "nextLabel": "3"
  },
  {
    "id": 1011003050180,
    "label": "1",
    "speaker": "樹里",
    "text": "え……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん、大変なこともたくさんあると思うよ\r\nこうやって迷うことだって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、アイドルっていう樹里が選んでくれた道が\r\n樹里にとって少しでも楽しいものだったら嬉しい",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは樹里のファンとしても\r\nプロデューサーとしても",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050190,
    "speaker": "樹里",
    "text": "……うん、そうだよな",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "4",
    "voice": "produce_events/101100305/1011003050190"
  },
  {
    "id": 1011003050200,
    "label": "2",
    "speaker": "樹里",
    "text": "え……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050200"
  },
  {
    "speaker": "プロデューサー",
    "text": "病気や怪我をしないように\r\nっていうのはもちろんそうなんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それだけじゃなくてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "迷ったり、悩んだりしたとき、\r\nひとりでいなくていいんだよ",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今までも、これからも",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050210,
    "speaker": "樹里",
    "text": "…………うん、そうだよな",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
