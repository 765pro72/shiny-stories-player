    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050300"
  },
  {
