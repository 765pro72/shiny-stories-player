    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050280"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050290,
    "speaker": "樹里",
    "text": "……だから、まずは『G.R.A.D.』で優勝したい",
