    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050270"
  },
  {
    "id": 1011003050280,
    "speaker": "樹里",
    "text": "そういうの、ずっと、一生さ\r\n当たり前だとは思いたくないし、思えねーから",
