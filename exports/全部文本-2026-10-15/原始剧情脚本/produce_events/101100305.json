    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里のプロデューサーだけど、\r\n樹里のファンでもあるからな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里のファンの気持ちは、\r\nよくわかってるつもりだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050170,
    "speaker": "樹里",
    "text": "……そーかよ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050170"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからさ、樹里",
