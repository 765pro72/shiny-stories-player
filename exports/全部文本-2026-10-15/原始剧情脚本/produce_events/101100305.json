    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050290"
  },
  {
    "id": 1011003050300,
    "speaker": "樹里",
    "text": "それで、サイッコーに笑いたい",
