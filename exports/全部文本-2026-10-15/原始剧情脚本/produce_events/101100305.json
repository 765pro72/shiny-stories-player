    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/101100305/1011003050090"
  },
  {
    "id": 1011003050100,
    "speaker": "樹里",
    "text": "……それだけ、\r\nアタシが心配させてるってことなのかな",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうじゃないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんな樹里のことが大切だから、\r\nそう書いてくれるんだ",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050110,
    "speaker": "樹里",
    "text": "……………",
    "charAnim1": "wait2",
