    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "008",
    "voice": "produce_events/101100305/1011003050110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ファンレターっていうのは、\r\n樹里へのお返しなんじゃないかと、思うけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050120,
    "speaker": "樹里",
    "text": "……どういうことだよ",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050120"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里は何かを返さなきゃって言うけど、\r\nファンの子も同じように思ってるんじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050130,
    "speaker": "樹里",
    "text": "え……？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050130"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里のパフォーマンスを見て、\r\n樹里の姿を見て、元気を貰って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから何かを返したいと思って、言葉をかけてくれたり、\r\n手紙を書いてくれたりするんじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050140,
    "speaker": "樹里",
    "text": "……そうなのかな",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050140"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからたぶん、\r\nもう樹里から、届いてるんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里が、アイドルとしてステージに立ってることで\r\nもう、きっと届いてるんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050150,
    "speaker": "樹里",
    "text": "なんで、そんなことわかるんだよ",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101100305/1011003050150"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そんなの決まってるだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺が、そうだからだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011003050160,
    "speaker": "樹里",
