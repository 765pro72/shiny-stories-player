    "charAnim2": "face_anger2",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100105/1021001050170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！　円香が望めば叶うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001050180,
    "speaker": "円香",
    "text": "そんな言葉に騙されない",
