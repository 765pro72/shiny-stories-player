    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100105/1021001050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、あとは気持ちだけなんだ\r\n円香の場合──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
