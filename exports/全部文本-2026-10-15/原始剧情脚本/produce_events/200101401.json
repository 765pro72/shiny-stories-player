    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101401/2001014010140"
  },
  {
    "id": 2001014010150,
    "speaker": "真乃",
    "text": "見てくださる方々に、たくさん\r\n素敵なお洋服だな、って思っていただけるように",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101401/2001014010150"
  },
  {
    "id": 2001014010160,
    "speaker": "真乃",
    "text": "いつもの私のままではいけないなって",
