    "nextLabel": "3"
  },
  {
    "id": 1019003040240,
    "label": "1",
    "speaker": "愛依",
    "text": "うん！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、いい返事だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040250,
    "speaker": "愛依",
    "text": "あ、プロデューサー\r\n今度は動画、撮ってくんない？",
    "charAnim1": "smile3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040250"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、構わないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040260,
    "speaker": "愛依",
    "text": "ステップ、ちゃんとできてるか\r\n見てみたいんだよね！",
    "charAnim1": "sad2",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040260"
  },
  {
    "id": 1019003040270,
    "speaker": "愛依",
    "text": "プロデューサーもなんか\r\n気付いたら、アドバイスよろしく！",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "produce_events/101900304/1019003040270"
  },
  {
    "id": 1019003040280,
    "label": "2",
    "speaker": "愛依",
    "text": "えっ、いやいや\r\nいいって！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040280"
  },
  {
    "speaker": "プロデューサー",
    "text": "だって、もう遅いし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040290,
    "speaker": "愛依",
    "text": "……でも、\r\nうち遠いしさ……！",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040290"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、知ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040300,
    "speaker": "愛依",
    "text": "──じゃあ、うん\r\nお願いしよっかな",
    "charAnim1": "smile3",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "join",
    "voice": "produce_events/101900304/1019003040300"
  },
  {
    "id": 1019003040310,
    "label": "3",
    "speaker": "愛依",
    "text": "えっ、\r\n何、なんの写真！？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040310"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんの……ってことはないけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依、すっきりしたいい顔してるからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040320,
    "speaker": "愛依",
    "text": "そ、そう……！？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900304/1019003040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうそう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003040330,
    "speaker": "愛依",
    "text": "じゃあ、プロデューサーも\r\n一緒に入ろうよ",
