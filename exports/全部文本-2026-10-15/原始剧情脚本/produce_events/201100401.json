    "charLipAnim": "lip_wait_s",
    "charLabel": "juri",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2011004010240,
    "speaker": "樹里",
    "text": "……ふっ\r\nなんだその顔！　あははは！",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃあ……変顔だからな\r\nほら、樹里もどうだ？",
    "charAnim2": "face_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004010250,
    "speaker": "樹里",
    "text": "や、アタシはやらねーって！\r\n……アンタに笑われたくねーし……",
    "charAnim1": "anger3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004010260,
    "speaker": "樹里",
    "text": "……\r\nそれにしても……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010260"
  },
  {
    "id": 2011004010270,
    "speaker": "樹里",
    "text": "さっきのアンタの……顔……\r\nぷ……ふふ……！",
    "charAnim1": "smile2",
    "charAnim2": "face_fear",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……そこまで気に入ってくれたなら\r\n俺も披露のし甲斐があったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……笑顔が必要になったら、俺の変顔を思い出すといい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004010280,
    "speaker": "樹里",
    "text": "……や、\r\nそれだと変な笑いになっちまうだろ！",
    "charAnim1": "wait3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010280"
  },
  {
    "id": 2011004010290,
    "speaker": "樹里",
    "text": "……まーでも\r\n楽しいことを思い出せば笑顔になるってのはあるかもなぁ",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010290"
  },
  {
    "id": 2011004010300,
    "speaker": "樹里",
    "text": "アドバイス……さんきゅー",
