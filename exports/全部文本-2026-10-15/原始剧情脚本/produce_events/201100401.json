    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100401/2011004010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "お！　いい感じじゃないか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004010180,
    "speaker": "樹里",
    "text": "そ、そうか……？",
