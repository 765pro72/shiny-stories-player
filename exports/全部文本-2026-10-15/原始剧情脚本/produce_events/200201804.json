  {
    "speaker": "SNSの書き込み",
    "text": "『灯織ちゃんかっこいいしかわいい～』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『知らない子だったけど\r\nこれから推しになっちゃうかも』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『今月号だけしかでないのかな？\r\nもっと見たい』",
