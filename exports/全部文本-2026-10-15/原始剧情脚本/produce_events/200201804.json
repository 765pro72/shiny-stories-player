  },
  {
    "textFrame": "off",
    "se": "1806",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『すっごいキレイな子でびっくりした～』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『え、まだ高校生なの！？\r\nすごい大人っぽい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの書き込み",
    "text": "『前にドラマで見たことあるけど\r\nまた雰囲気違ってイイ！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "（うん、灯織を知っている人にも\r\n知らなかった人にも届いてるみたいだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（この調子でもっと活躍の場を\r\n広げられるよう、俺も頑張らないと）",
    "textCtrl": "p",
    "textFrame": "002"
  },
