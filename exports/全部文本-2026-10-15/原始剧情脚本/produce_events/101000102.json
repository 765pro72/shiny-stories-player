    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000102/1010001020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。でも、食事のバランスには気をつけるんだぞ\r\nもし大変そうなら……",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001020100,
