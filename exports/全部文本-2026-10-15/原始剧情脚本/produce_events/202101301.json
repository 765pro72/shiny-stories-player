  },
  {
    "id": 2021013010100,
    "speaker": "円香",
    "text": "台本を読ませていただきましたが",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101301/2021013010100"
  },
  {
    "id": 2021013010110,
    "speaker": "円香",
    "text": "この役が私でないと表現できないかと言われたら\r\nそうではない気がして",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
