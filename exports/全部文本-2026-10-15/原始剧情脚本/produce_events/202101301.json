    "textFrame": "001",
    "voice": "produce_events/202101301/2021013010110"
  },
  {
    "speaker": "映画監督",
    "text": "……表現するだけなら確かにいるだろうけど\r\nそれだけではダメなんだ",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "fade_out"
  },
  {
