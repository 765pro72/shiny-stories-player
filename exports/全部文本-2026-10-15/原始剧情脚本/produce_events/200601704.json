    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601704/2006017040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、照れることないだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "桜の下の咲耶も、駄菓子屋さんで無邪気に遊ぶ咲耶も\r\nどの咲耶も魅力的に映ってたし",
    "textCtrl": "p",
    "textFrame": "002"
  },
