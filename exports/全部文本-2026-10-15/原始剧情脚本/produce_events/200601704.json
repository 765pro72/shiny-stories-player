    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601704/2006017040180"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、そうなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006017040190,
    "speaker": "咲耶",
    "text": "うん。どうだろう、プロデューサー\r\n私と勝負しない？",
