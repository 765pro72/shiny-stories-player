    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことか……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "聞いてあげただけで\r\n力になれてると思う",
    "nextLabel": "1"
  },
  {
    "select": "ご両親の話を聞いて\r\n参考にするとか",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "何事もそうなんだけど",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "甘奈がそれだけ考えて\r\n聞いてあげたんだし、大丈夫じゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008020140,
    "speaker": "甘奈",
    "text": "うーん……そうかなぁ……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "その子のことを真剣に考えてなかったら\r\n今みたいに心配することもないと思うよ",
    "charAnim2": "face_sad",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、悩むってことは\r\n真面目に聞いてあげてた証拠だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008020150,
    "speaker": "甘奈",
    "text": "そっか……そういう考え方もあるね……",
