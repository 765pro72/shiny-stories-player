    "voice": "produce_events/201400802/2014008020040"
  },
  {
    "id": 2014008020050,
    "speaker": "甘奈",
    "text": "あっ！　プロデューサーさん！\r\nごめん、どうしたの？",
    "charAnim1": "surp1",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "次の仕事について話そうと思ったんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……何か考え事か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008020060,
    "speaker": "甘奈",
    "text": "あ！　大丈夫！　なんでもないから！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "それにしてはだいぶ悩んでる感じに見えたけど……",
    "charAnim2": "face_wait",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……甘奈さえよければ、話聞くぞ",
    "charLipAnim": "lip_surp_s",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "少し気持ちが軽くなるかもしれないし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008020070,
    "speaker": "甘奈",
    "text": "ありがと、じゃあ、ちょっとだけ\r\n聞いてもらうね",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020070"
  },
  {
    "id": 2014008020080,
    "speaker": "甘奈",
    "text": "友達が、クラスの男の子と付き合うことになって\r\n今度デートするんだって",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020080"
  },
  {
    "id": 2014008020090,
    "speaker": "甘奈",
    "text": "けど、そういうの初めてだから\r\nどうしたらいいかなって相談されて",
    "charAnim1": "shy1",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020090"
  },
  {
    "id": 2014008020100,
    "speaker": "甘奈",
    "text": "色々とお話、聞いたの",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020100"
  },
  {
    "id": 2014008020110,
    "speaker": "甘奈",
    "text": "甘奈、自分なりに考えて答えてはいたんだけど",
    "charAnim1": "sad2",
    "charAnim2": "face_trouble",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020110"
  },
  {
    "id": 2014008020120,
    "speaker": "甘奈",
    "text": "想像でしか話せてないから……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020120"
  },
  {
    "id": 2014008020130,
    "speaker": "甘奈",
    "text": "本当に力になれたかがちょっとだけ不安で",
