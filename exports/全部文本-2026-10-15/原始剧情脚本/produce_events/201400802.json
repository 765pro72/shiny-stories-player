    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020160"
  },
  {
    "id": 2014008020170,
    "speaker": "甘奈",
    "text": "うん……！　考えすぎるのはよくないねっ！",
