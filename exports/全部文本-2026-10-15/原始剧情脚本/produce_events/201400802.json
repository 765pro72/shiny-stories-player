    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400802/2014008020150"
  },
  {
    "id": 2014008020160,
    "speaker": "甘奈",
    "text": "それに、甘奈が悩んでたら\r\n友達まで不安になっちゃうかも……！",
