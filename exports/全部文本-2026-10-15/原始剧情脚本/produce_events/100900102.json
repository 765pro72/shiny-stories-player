    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009001020200,
    "speaker": "果穂",
    "text": "はいっ。あたし、プロデューサーさんと戦います！\r\nとぉっ！",
    "charAnim1": "anger1",
