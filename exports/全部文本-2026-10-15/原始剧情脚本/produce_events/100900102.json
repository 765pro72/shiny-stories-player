    "voice": "produce_events/100900102/1009001020200"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "ヒーローみたいになるには、\r\n毎日のレッスンは欠かせないぞ",
    "charAnim2": "face_wait",
