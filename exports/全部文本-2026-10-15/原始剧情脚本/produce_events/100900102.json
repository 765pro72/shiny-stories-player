    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900102/1009001020180"
  },
  {
    "id": 1009001020190,
    "speaker": "果穂",
    "text": "やっぱりアイドルとヒーローって\r\n似てるんですね！",
