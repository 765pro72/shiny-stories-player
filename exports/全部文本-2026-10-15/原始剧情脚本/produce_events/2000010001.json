  {
    "id": 20000100010020,
    "speaker": "智代子",
    "text": "た・だ・の？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
