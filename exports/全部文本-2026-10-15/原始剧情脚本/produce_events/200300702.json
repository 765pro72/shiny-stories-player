    "waitTime": 500
  },
  {
    "id": 2003007020300,
    "speaker": "めぐる",
    "text": "──ああっ、お料理もうできちゃうって！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300702/2003007020300"
  },
