    "charLipAnim": "lip_smile_s",
    "charLabel": "amana",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 2014020110070,
    "speaker": "甘奈",
    "text": "……やっぱり\r\nプロデューサーさんはすごいなぁ",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402011/2014020110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや\r\nちょっとしたことを話しただけで──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020110080,
    "speaker": "甘奈",
    "text": "ううん、そうじゃないの\r\n安心感がすごいなぁ、って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402011/2014020110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nなるほど……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020110090,
    "speaker": "甘奈",
    "text": "こうやって話してるだけで\r\n心を軽くしてくれる……",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
