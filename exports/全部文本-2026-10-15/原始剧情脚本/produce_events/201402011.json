  {
    "id": 2014020110040,
    "speaker": "甘奈",
    "text": "……まだまだ、だなぁ",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
