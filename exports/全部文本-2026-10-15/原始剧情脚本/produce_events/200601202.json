    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006012020050,
    "speaker": "咲耶",
    "text": "大好きなこの場所での写真を\r\nファンのみんなに届けられたらいいのかもしれない──",
    "charAnim1": "wait5",
    "charLipAnim": "lip_wait",
