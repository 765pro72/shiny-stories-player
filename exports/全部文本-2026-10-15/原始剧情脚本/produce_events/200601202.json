    "voice": "produce_events/200601202/2006012020050"
  },
  {
    "id": 2006012020060,
    "speaker": "咲耶",
    "text": "──と……\r\nそう思ったのだけれど……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
