  },
  {
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……イメージと違ったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006012020070,
    "speaker": "咲耶",
    "text": "そうじゃないんだ、ただ……",
    "charAnim3": "no",
    "charAnim3Loop": false,
