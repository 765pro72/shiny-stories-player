    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601202/2006012020070"
  },
  {
    "id": 2006012020080,
    "speaker": "咲耶",
    "text": "秋の海は、静かだから",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601202/2006012020080"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_shy2",
    "charLabel": "sakuya",
