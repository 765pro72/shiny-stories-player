    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050310"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、たくさん言ってくれ！\r\nみんな、きっとすごく喜ぶ",
