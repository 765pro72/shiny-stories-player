    "textFrame": "off",
    "nextLabel": "4"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "今までもたくさん考えてたと思うんだけど、\r\nそれよりももっともっとだ！",
    "textCtrl": "p",
