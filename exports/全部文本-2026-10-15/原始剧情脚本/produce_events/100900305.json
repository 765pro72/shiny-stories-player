    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050200"
  },
  {
    "id": 1009003050210,
    "speaker": "果穂",
    "text": "あたしが見てるみなさん、他の人が見てるみなさんと\r\n一緒だと思うんですけど……",
