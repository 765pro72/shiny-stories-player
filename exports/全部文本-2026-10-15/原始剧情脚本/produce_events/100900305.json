    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050210"
  },
  {
    "id": 1009003050220,
    "speaker": "果穂",
    "text": "ちがうんでしょうか……？",
