    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050050"
  },
  {
    "id": 1009003050060,
    "speaker": "果穂",
    "text": "楽屋あいさつのやり方とか\r\n楽屋が大部屋だった時の過ごし方とか……",
