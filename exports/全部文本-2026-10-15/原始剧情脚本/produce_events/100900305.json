    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050060"
  },
  {
    "id": 1009003050070,
    "speaker": "果穂",
    "text": "よく出てくる単語の意味を教えてくれたから、\r\n台本読みも、今はひとりでできます！",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050070"
  },
  {
    "id": 1009003050080,
    "speaker": "果穂",
    "text": "あっ……難しい漢字は、今も読めないんですけどっ",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050080"
  },
  {
    "id": 1009003050090,
    "speaker": "果穂",
    "text": "でもっ！\r\nお仕事で必要なことはみーんな、ひとりでできます！",
