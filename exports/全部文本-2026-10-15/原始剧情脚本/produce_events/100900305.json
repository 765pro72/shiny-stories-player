    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050090"
  },
  {
    "id": 1009003050100,
    "speaker": "果穂",
    "text": "全部全部ぜーんぶ、\r\n気付いたらできるようになってて──",
