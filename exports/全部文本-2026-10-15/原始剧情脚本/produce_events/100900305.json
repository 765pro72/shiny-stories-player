    "textFrame": "001",
    "voice": "produce_events/100900305/1009003050190"
  },
  {
    "speaker": "プロデューサー",
    "text": "あの写真は、『果穂が見ている光景』だからだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "放クラのメンバーにはさ、\r\n『果穂相手だから』見せる顔があるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009003050200,
    "speaker": "果穂",
    "text": "……？",
