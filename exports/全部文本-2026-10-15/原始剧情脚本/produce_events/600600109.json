    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600600109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600600109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600600109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600600109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600600109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600600109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off"
  },
  {
    "effectLabel": "black1",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
    }
  },
  {
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "charLabel": "hazuki",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    }
  },
  {
    "id": 6006001090010,
    "speaker": "咲耶",
    "text": "やぁ、プロデューサー\r\n私を迎えに来てくれたのかい？",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "006",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bg": "00016",
    "voice": "produce_events/600600109/6006001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、はづきさんがここにいるって\r\n教えてくれたからな",
    "charAnim2": "blank",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『伝えたいことがあるそうです』って言ってたけど……\r\nそうなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090020,
    "speaker": "咲耶",
    "text": "ああ、でも立ち話をするよりも、\r\nちょっと座ってゆっくり話したいな",
    "charAnim1": "wait2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……じゃあ、あそこのベンチにでも座るか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "effectLabel": "black2",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "effectLabel": "black2",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "……それで、改めて伝えたいことって、なんだ？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090030,
    "speaker": "咲耶",
    "text": "……",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090030"
  },
  {
    "id": 6006001090040,
    "speaker": "咲耶",
    "text": "プロデューサーは、私と出会った日のこと\r\n覚えているかい？",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだ\r\nあの日のことを、忘れることなんてできないさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090050,
    "speaker": "咲耶",
    "text": "フフ……あの頃の私は、今と少し違っただろう？",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったかな……？\r\nでも、今のほうがいい笑顔をするようになったかもな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090060,
    "speaker": "咲耶",
    "text": "フフ。それはきっと、\r\n私がアイドルになれたからだよ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090060"
  },
  {
    "id": 6006001090070,
    "speaker": "咲耶",
    "text": "……アイドルになる前の私は、\r\nモデルに疑問を持っていたんだ",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "疑問……？　どうしてだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090080,
    "speaker": "咲耶",
    "text": "モデルはトップに近づくほど、孤独に近づいていく",
    "charAnim1": "wait5",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090080"
  },
  {
    "id": 6006001090090,
    "speaker": "咲耶",
    "text": "その孤高さは美しくもあるが、\r\n私の肌には合わないと思っていた",
    "charAnim2": "no",
    "charLipAnim": "lip_anger",
    "charAnim2Loop": false,
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090090"
  },
  {
    "speaker": "プロデューサー",
    "text": "（確かに、咲耶に孤高は似合わないな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090100,
    "speaker": "咲耶",
    "text": "そんな中、アナタと出会えたんだ",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090100"
  },
  {
    "speaker": "プロデューサー",
    "text": "——それで、変わったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090110,
    "speaker": "咲耶",
    "text": "ああ、180度変わったよ。違う道へと踏み出せて……\r\nまさにプロデューサーとの出会いは、奇跡だった",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090110"
  },
  {
    "id": 6006001090120,
    "speaker": "咲耶",
    "text": "あの日、私を見つけてくれて本当にありがとう\r\nどれほど感謝してもし足りないくらいだよ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090120"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、俺も咲耶にあの時出会えて、\r\nアイドルになってくれて、本当に感謝している",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も奇跡だったって、思っているぞ",
    "charLipAnim": "lip_smile",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090130,
    "speaker": "咲耶",
    "text": "クス\r\n私たちはお互いに運が良かったんだな",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090140,
    "speaker": "咲耶",
    "text": "いや……私がアナタにプロデュースされて\r\nアイドルになるのは、運命だったのかもしれないな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090140"
  },
  {
    "id": 6006001090150,
    "speaker": "咲耶",
    "text": "だとしたら、神様も幸せな運命をくれたものだよ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そこまで言われると照れくさいな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090160,
    "speaker": "咲耶",
    "text": "フフ、本当のことさ",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090160"
  },
  {
    "id": 6006001090170,
    "speaker": "咲耶",
    "text": "アイドルになってから、私は本当に幸せだった……\r\nいや、今も幸せだ",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090180,
    "speaker": "咲耶",
    "text": "アイドルになってからは\r\nモデルの時に感じていた孤独を感じないんだ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090180"
  },
  {
    "id": 6006001090190,
    "speaker": "咲耶",
    "text": "むしろ、より多くの人たちと繋がっている気さえする……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。今はアンティーカのみんなもいるしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090200,
    "speaker": "咲耶",
    "text": "そう、仲間を見つけられたんだ！　と思うと、嬉しかったよ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090200"
  },
  {
    "id": 6006001090210,
    "speaker": "咲耶",
    "text": "でもね、\r\n私がここまでアイドルをがんばってこれたのは……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090210"
  },
  {
    "id": 6006001090220,
    "speaker": "咲耶",
    "text": "つらい時も、うれしい時も、\r\nいつもプロデューサーがいてくれたからだよ",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090220"
  },
  {
    "id": 6006001090230,
    "speaker": "咲耶",
    "text": "だから……\r\nねぇ、プロデューサー",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090230"
  },
  {
    "id": 6006001090240,
    "speaker": "咲耶",
    "text": "これからも、私の隣にいてくれるかい……？",
    "charAnim1": "sad2",
    "charAnim2": "no",
    "charLipAnim": "lip_smile",
    "charAnim2Loop": false,
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだ\r\nこれからもずっと、咲耶の傍にいるよ",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一緒にがんばって行こうな",
    "charAnim2": "face_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6006001090250,
    "speaker": "咲耶",
    "text": "……ありがとう",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090250"
  },
  {
    "id": 6006001090260,
    "speaker": "咲耶",
    "text": "アナタと一緒なら、どんなに高い場所へでも\r\n昇って行けそうな気がするよ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600600109/6006001090260"
  },
  {
