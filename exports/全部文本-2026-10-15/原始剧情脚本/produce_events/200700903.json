  },
  {
    "textFrame": "off"
  },
  {
    "id": 2007009030260,
    "label": "2",
    "speaker": "結華",
    "text": "はーいはい了解でーす\r\nＰたんの作法に従うってば",
    "charAnim1": "anger1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700903/2007009030260"
  },
  {
    "id": 2007009030270,
    "speaker": "結華",
    "text": "三峰割と合わせるタイプなの、知ってるでしょー？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700903/2007009030270"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………前言撤回だ\r\n俺にも５本ぐらい寄越してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009030280,
    "speaker": "結華",
    "text": "えっ？",
    "charAnim1": "wait4",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700903/2007009030280"
  },
  {
    "speaker": "プロデューサー",
    "text": "今日は結華式でいこう\r\n……気が変わったから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009030290,
    "speaker": "結華",
    "text": "──……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700903/2007009030290"
  },
  {
    "id": 2007009030300,
    "speaker": "結華",
    "text": "あはっ、それはいらない気遣いってやつだよ！\r\nプロデューサー！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
