    "waitTime": 1500
  },
  {
    "id": 2007009030040,
    "speaker": "結華",
    "text": "……って、Ｐたん？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700903/2007009030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "──あっ、すまん！\r\nちょっと気になるものがあって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009030050,
    "speaker": "結華",
