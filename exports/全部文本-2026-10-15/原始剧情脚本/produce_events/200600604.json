    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600604/2006006040090"
  },
  {
    "id": 2006006040100,
    "speaker": "咲耶",
    "text": "カットが入った瞬間、\r\nシャッターが切られていたみたいでね",
