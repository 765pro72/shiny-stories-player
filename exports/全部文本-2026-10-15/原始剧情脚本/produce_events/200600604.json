    "textFrame": "001",
    "voice": "produce_events/200600604/2006006040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "予想外の表情……？\r\nいつもの咲耶と変わりなかったはずだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "sad2",
