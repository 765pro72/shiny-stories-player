  {
    "id": 2018007040010,
    "speaker": "冬優子",
    "text": "気付いたのは中学ぐらいだったかしら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040010"
  },
  {
    "id": 2018007040020,
    "speaker": "冬優子",
    "text": "いくら売られた喧嘩だからって、\r\nふゆのまんま買ってたら──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040020"
  },
  {
    "id": 2018007040030,
    "speaker": "冬優子",
    "text": "ふゆの方が悪者みたいになっちゃうんだなってこと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040030"
  },
  {
    "id": 2018007040040,
    "speaker": "冬優子",
    "text": "……味方を作りたいんだったら、\r\nふゆじゃなくて、『ふゆ』の方が適任なんだなってこと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040040"
  },
  {
    "id": 2018007040050,
    "speaker": "冬優子",
    "text": "……何度かあったの\r\nそういうことが",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040050"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2018007040060,
    "speaker": "冬優子",
    "text": "……だから、次の場所では\r\nもっとしっかりやらなくちゃって思った",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800704/2018007040060"
  },
  {
