    "textFrame": "001",
    "voice": "produce_events/201101011/2011010110020"
  },
  {
    "id": 2011010110030,
    "speaker": "樹里",
    "text": "久しぶりにパキッてしたくなっただけだから",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101011/2011010110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、じゃあいただくよ",
