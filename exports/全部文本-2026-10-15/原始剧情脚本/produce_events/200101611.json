  {
    "id": 2001016110060,
    "speaker": "真乃",
    "text": "灯織ちゃんの特集も、めぐるちゃんの特集も\r\n読んでいてどきどきしました……っ",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
