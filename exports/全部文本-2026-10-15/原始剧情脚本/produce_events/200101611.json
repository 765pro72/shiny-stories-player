    "voice": "produce_events/200101611/2001016110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016110070,
    "speaker": "真乃",
    "text": "まず、写真が素敵です……っ\r\nふたりとも、とっても綺麗で……──",
    "charAnim1": "anger3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101611/2001016110070"
  },
  {
    "id": 2001016110080,
    "speaker": "真乃",
    "text": "やっぱり、灯織ちゃんもめぐるちゃんも\r\nすごいなって……っ",
