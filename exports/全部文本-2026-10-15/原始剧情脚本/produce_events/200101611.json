  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001016110110,
    "speaker": "真乃",
    "text": "あの、それから……\r\n私について答えてくれているところもあったので……",
