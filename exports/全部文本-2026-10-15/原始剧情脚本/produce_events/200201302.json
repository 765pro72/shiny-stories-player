    "text": "（生き物もいっぱい）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020190"
  },
  {
    "id": 2002013020200,
    "speaker": "灯織",
    "text": "（ああ、これ撮りたいなあ）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020200"
  },
  {
    "id": 2002013020210,
    "speaker": "灯織",
    "text": "（でも……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020210"
  },
  {
    "id": 2002013020220,
    "speaker": "灯織",
    "text": "（スマホ、海に入れるのはさすがにダメだよね）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020220"
  },
  {
    "id": 2002013020230,
    "speaker": "灯織",
    "text": "（どうにか残せたらいいのに）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020230"
  },
  {
    "id": 2002013020240,
