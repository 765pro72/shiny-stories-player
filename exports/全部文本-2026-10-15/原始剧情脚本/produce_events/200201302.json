  {
    "speaker": "スタッフ",
    "text": "灯織ちゃーん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ",
    "text": "お疲れ様！　灯織ちゃん分はおしまい！\r\n他が終わるまでは空き時間になります！！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "003",
    "charType": "idols",
    "charId": "1040020070",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "スタッフ",
    "text": "休むも遊ぶも自由だよ～\r\n帰りもみんなでロケバスだからね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002013020040,
    "speaker": "灯織",
    "text": "え……いいんですか……？\r\nみなさんお仕事しているのに……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020040"
  },
  {
    "speaker": "スタッフ",
    "text": "いいよいいよ～\r\n灯織ちゃんめっちゃ頑張ってくれたもん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002013020050,
    "speaker": "灯織",
    "text": "ありがとうございます\r\nじゃあ、うちのプロデューサーにも話をしてきます……！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020050"
  },
  {
    "speaker": "スタッフ",
    "text": "はーい！\r\n……あ、そうだ。これも灯織ちゃんに教えておくね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002013020060,
    "speaker": "灯織",
    "text": "……？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201302/2002013020060"
  },
  {
    "speaker": "スタッフ",
    "text": "実は……────",
    "textCtrl": "p",
    "textFrame": "003",
    "autoWaitTime": 1500
  },
