    "text": "……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401802/2014018020051"
  },
  {
    "speaker": "バーテンダー",
    "text": "あの人、ああなると、もう聞きませんから\r\nこちらとしても飲んでいってくださると助かります",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
