    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "バーテンダー",
    "text": "こちらのおふたりに、お酒を\r\nご用意するということで、よろしいですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "カメラマン",
    "text": "うん！　お願いね！\r\nそれじゃ、私は次があるから、またね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0854",
