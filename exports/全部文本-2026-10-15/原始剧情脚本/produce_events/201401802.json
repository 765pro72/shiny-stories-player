  {
    "speaker": "プロデューサー",
    "text": "そうだな……\r\n……では、一杯だけいただいていきます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "バーテンダー",
    "text": "ありがとうございます\r\n何にいたしましょうか",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp2_s",
