    "textFrame": "001",
    "voice": "produce_events/200200403/2002004030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、少し視点を変えて見てみよう",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002004030080,
