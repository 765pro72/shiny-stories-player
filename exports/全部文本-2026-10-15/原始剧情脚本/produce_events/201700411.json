    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "買い物とかか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017004110040,
    "speaker": "あさひ",
    "text": "違うっすよ～、景色が見たいんす！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "景色……あぁ、そういえばさっきも\r\nずっと窓の外見てたな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今日、天気いいしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017004110050,
    "speaker": "あさひ",
    "text": "そっす！　だからいつも行かないところまで行って\r\nもっと景色が見たいんすよ！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110050"
  },
  {
    "id": 2017004110060,
    "speaker": "あさひ",
    "text": "面白いもの、見れるっすかね～♪",
