    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いい景色が見られたら今度話聞かせてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017004110070,
    "speaker": "あさひ",
    "text": "ッ……今度？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？　ああ、今度時間があるときに──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017004110080,
    "speaker": "あさひ",
    "text": "そんな必要ないっすよ\r\nプロデューサーさんも行くんすから",
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700411/2017004110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おぉ、そうか……ちょっと待ってくれるか",
    "textCtrl": "p",
    "textFrame": "002"
  },
