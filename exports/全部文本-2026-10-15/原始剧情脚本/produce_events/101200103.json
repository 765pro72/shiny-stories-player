  {
    "id": 1012001030020,
    "speaker": "凛世",
    "text": "……プロデューサーさま",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
