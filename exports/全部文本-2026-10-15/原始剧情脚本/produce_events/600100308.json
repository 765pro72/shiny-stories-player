    "voice": "produce_events/600100308/6001003080030"
  },
  {
    "id": 6001003080040,
    "speaker": "真乃",
    "text": "……優勝、できたなんて夢みたいです……っ",
    "charAnim1": "sad1",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
