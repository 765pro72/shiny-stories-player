    "textFrame": "001",
    "voice": "produce_events/101600403/1016004030110"
  },
  {
    "id": 1016004030120,
    "speaker": "千雪",
    "text": "ふふっ……\r\n私、何か行いがよかったのかなぁ",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
