    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600403/1016004030040"
  },
  {
    "id": 1016004030050,
    "speaker": "千雪",
    "text": "……こういう、綺麗に晴れた夕方の\r\nこういう……街を見渡せるような場所で",
