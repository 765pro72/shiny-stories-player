    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600403/1016004030250"
  },
  {
    "id": 1016004030260,
    "speaker": "千雪",
    "text": "無線は便利ですけど、\r\nちょっと味気ないよなあって思ってただけで……",
