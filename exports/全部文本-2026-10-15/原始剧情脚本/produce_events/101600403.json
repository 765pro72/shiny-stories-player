    "textFrame": "001",
    "voice": "produce_events/101600403/1016004030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、そうか",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だったら、俺もちょっとした気紛れで休憩に来て、\r\n千雪と会えたのは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "行いがよかったからなのかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004030130,
    "speaker": "千雪",
    "text": "ふふっ……！\r\nなんだか光栄です",
