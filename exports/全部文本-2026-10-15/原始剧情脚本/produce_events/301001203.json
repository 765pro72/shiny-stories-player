    "waitTime": 1500
  },
  {
    "speaker": "ペットショップの店員",
    "text": "ほんとにごめんね～\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3010012030060,
    "speaker": "智代子",
    "text": "いえいえ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
