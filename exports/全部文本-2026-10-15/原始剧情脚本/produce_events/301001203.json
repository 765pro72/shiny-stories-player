    "voice": "produce_events/301001203/3010012030060"
  },
  {
    "speaker": "ペットショップの店員",
    "text": "なんかうちの店、みんなに助けてもらってばっかりだなぁ\r\n先週もさ、新人の子が商品の山崩しちゃって",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3010012030070,
    "speaker": "智代子",
    "text": "えっ、はい……！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301001203/3010012030070"
  },
  {
    "speaker": "ペットショップの店員",
    "text": "そしたらたまたま通りかかった樹里ちゃんが\r\n直すの手伝ってくれたって言ってた",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ペットショップの店員",
    "text": "お世話になりっぱなしだよね～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3010012030080,
    "speaker": "智代子",
    "text": "あはは、そうだったんですね……！",
    "charAnim1": "wait2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301001203/3010012030080"
  },
  {
    "speaker": "ペットショップの店員",
    "text": "智代子ちゃん、樹里ちゃんに会ったら言っておいて\r\n当店一同、感謝してます～って",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ペットショップの店員",
    "text": "もちろん智代子ちゃんにもだけどね",
    "charAnim2": "face_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3010012030090,
    "speaker": "智代子",
    "text": "ふふ、ありがとうございますっ\r\n伝言も、了解しました！",
