    "voice": "produce_events/201900902/2019009020110"
  },
  {
    "id": 2019009020120,
    "speaker": "愛依",
    "text": "あくまでも自分！\r\nなんだよね～",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020120"
  },
  {
    "id": 2019009020130,
    "speaker": "愛依",
    "text": "緊張して口数が少なくなったうちが、\r\nそのままなんとかしてる、的な",
