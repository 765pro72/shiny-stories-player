    "autoWaitTime": 1500
  },
  {
    "id": 2019009020050,
    "speaker": "愛依",
    "text": "──と……\r\nまだまだ、気を抜くとダメなんだよね",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "意識ができるようになっただけ\r\n成長じゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "減点する回数もだいぶ減ってきてるし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020060,
    "speaker": "愛依",
    "text": "サンキュ……\r\nじゃあ、ちょっと気抜いていい？",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、いいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020070,
    "speaker": "愛依",
    "text": "……",
