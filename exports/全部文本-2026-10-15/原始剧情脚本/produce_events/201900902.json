  },
  {
    "speaker": "プロデューサー",
    "text": "愛依的に、いつものクールキャラとは\r\nやっぱり全然違う感じなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020100,
    "speaker": "愛依",
    "text": "うちの中では違うかな～",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020100"
  },
  {
    "id": 2019009020110,
    "speaker": "愛依",
    "text": "ステージのうちはさ～……\r\nなんて言うか……",
    "charAnim1": "smile3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
