    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "イメトレの続きならここでやっていいぞ\r\nしばらく誰も来ないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020190,
    "speaker": "愛依",
    "text": "お、マジで？\r\nラッキー♪",
