  {
    "speaker": "プロデューサー",
    "text": "やっぱり、かなり気を張ってないとなんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020090,
    "speaker": "愛依",
    "text": "だね～",
    "charAnim1": "wait2",
