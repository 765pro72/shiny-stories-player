    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020130"
  },
  {
    "id": 2019009020140,
    "speaker": "愛依",
    "text": "けどほら、\r\n今回は完全に別人で",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020140"
  },
  {
    "id": 2019009020150,
    "speaker": "愛依",
    "text": "うちからしたら\r\nちょーわかんない人になるから",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020150"
  },
  {
    "id": 2019009020160,
    "speaker": "愛依",
    "text": "むずい！",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020170,
    "speaker": "愛依",
    "text": "ま！　でもだからって無理～！\r\nとかは考えないけどさ！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900902/2019009020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう言ってくれると、頼もしいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019009020180,
    "speaker": "愛依",
    "text": "よっし！　休憩終わり～！\r\nもうひと頑張りするわ！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
