  {
    "speaker": "制作会社ディレクター",
    "text": "────杜野凛世さん、ですか",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00625",
    "bgEffect": "fade",
    "bgm": "100",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "はい\r\nぜひお力になれるかと",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0220"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "……あ、思い出した\r\n見たことありますよ、この子",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！\r\n本当ですか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "ええ、最近出てたでしょう\r\nええと、何のＣＭだったかな……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、例の──！\r\nご覧いただけていましたか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "はは、まあね\r\nうちもＣＭはいくつか手掛けさせていただいておりますし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00224",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "……でも、そうでしたか\r\nあの子、２８３さんの子だったんですね",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1105"
  },
  {
    "speaker": "プロデューサー",
    "text": "と、おっしゃりますと？",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0220"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "いえね、少し気になってたんですよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "控えめで慎ましい印象なのに、\r\n目を引かれる存在感があって……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "なんというか、心の琴線に触れる子ですよね……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "────！\r\nありがとうございます……！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0730"
  },
  {
    "speaker": "制作会社ディレクター",
    "text": "ははっ\r\n２８３さん、急にテンションが上がりましたね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あ、はは……\r\nすみません、つい……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 5000
  },
