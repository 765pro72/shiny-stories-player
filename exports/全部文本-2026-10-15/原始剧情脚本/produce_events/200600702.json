      "x": 1000,
      "alpha": 0,
      "time": 1000
    },
    "waitType": "effect"
  },
  {
    "charLabel": "sakuya",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
