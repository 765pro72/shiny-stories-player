  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶ひとりか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006007020010,
    "speaker": "咲耶",
    "text": "おや、プロデューサー\r\n挨拶まわりは、もういいのかい？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030060030",
    "charPosition": {
