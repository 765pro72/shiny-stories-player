    "waitTime": 1500
  },
  {
    "id": 3006013010050,
    "speaker": "off",
    "text": "うちのクリスマスパーティーは\r\nクリスマスに一番近い休みの日",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/300601301/3006013010050"
  },
  {
    "id": 3006013010060,
    "speaker": "off",
    "text": "イブのイブか、もっと前\r\nお父さんはよく謝っていたけれど",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/300601301/3006013010060"
  },
  {
    "id": 3006013010070,
    "speaker": "off",
    "text": "不満なんてまったくなかった",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/300601301/3006013010070"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "id": 3006013010080,
    "speaker": "off",
    "text": "一緒に飾り付けをして\r\n一緒にケーキとごちそうを食べて",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/300601301/3006013010080"
  },
  {
    "id": 3006013010090,
    "speaker": "off",
