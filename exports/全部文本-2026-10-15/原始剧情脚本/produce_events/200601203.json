  },
  {
    "speaker": "プロデューサー",
    "text": "かっこ悪いところも見せちゃったし\r\nはは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006012030090,
    "speaker": "咲耶",
    "text": "何を言うのかと思ったら\r\nそんなふうには思っていないよ、私は",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
