    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601203/2006012030200"
  },
  {
    "id": 2006012030210,
    "speaker": "咲耶",
    "text": "それに、しくじりだなんて──\r\n私はとても……胸があたたかくなっているんだ",
    "charAnim1": "wait5",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601203/2006012030210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006012030220,
    "speaker": "咲耶",
    "text": "アナタがそうやって私を想ってくれていたこと、\r\n普段とは違った、可愛らしい一面を見せてくれたこと──",
