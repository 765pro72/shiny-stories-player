    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601203/2006012030180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと探してみてたんだけど──\r\nまぁあんまりピンと来るものはなかったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "さらっとアドバイスとかできたらよかったんだけどな、\r\nそう上手くはいかなかったよ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006012030190,
