  {
    "speaker": "プロデューサー",
    "text": "うん、全体的によくできた企画書だと思うよ\r\n千雪のやりたいことも、はっきりと伝わってくる",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "046"
  },
  {
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
