  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016019110110,
    "speaker": "千雪",
    "text": "それを……わかった上で\r\n私は……",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601911/2016019110110"
  },
  {
    "id": 2016019110120,
    "speaker": "千雪",
    "text": "抗ってみたい、って、強く思ってます",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601911/2016019110120"
  },
  {
    "id": 2016019110130,
    "speaker": "千雪",
    "text": "ずっと『今が一番輝いている』って\r\nいう状態を続けるんだ、って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601911/2016019110130"
  },
  {
    "charAnim1": "wait4",
