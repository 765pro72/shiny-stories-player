    "bgEffect": "fade",
    "se": "1940",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 600
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "気になったのは、衣装と\r\n挑戦していきたい曲の方向性だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前回のアーティスト活動に使った衣装──\r\n今も着ているその服だけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分でも言っていた通り\r\n千雪の個性を全面に出したものだったよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016019110040,
    "speaker": "千雪",
    "text": "はい、その通りです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601911/2016019110040"
  },
  {
    "textFrame": "off",
    "bg": "00623",
    "bgEffect": "fade",
