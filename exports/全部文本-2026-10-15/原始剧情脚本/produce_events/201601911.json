    "waitTime": 700,
    "bgEffectTime": 700
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "今回のも、そういったものを\r\n打ち出してきているって、俺は感じた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016019110050,
    "speaker": "千雪",
    "text": "……",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
