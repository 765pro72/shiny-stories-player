  {
    "id": 2016019110090,
    "speaker": "千雪",
    "text": "当時のあの人と今の私は\r\n同じ年になりました",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "107",
    "voice": "produce_events/201601911/2016019110090"
  },
  {
    "id": 2016019110100,
    "speaker": "千雪",
    "text": "だからこそ、その重みが……\r\n今の私には、あの時よりよくわかるんです",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
