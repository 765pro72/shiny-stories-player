    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……──俺も、嬉しい\r\n結華と、そういうことがちゃんとできたら",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一個一個……ちゃんとすり合わせていけたら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010030230,
    "speaker": "結華",
    "text": "うん\r\nやっていこう、プロデューサー",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030230"
  },
  {
    "id": 2007010030240,
    "speaker": "結華",
    "text": "だから変な気遣いはな～し",
