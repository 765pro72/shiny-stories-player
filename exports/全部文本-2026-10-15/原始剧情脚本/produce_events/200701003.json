    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030270"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010030280,
    "speaker": "結華",
    "text": "言えること、全部\r\n今は言えないことも──もし言えるようになったら、全部",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030280"
  },
  {
    "id": 2007010030290,
    "speaker": "結華",
    "text": "ちゃんとわかり合いたいから、言うって決めた",
    "charAnim1": "wait4",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030290"
  },
  {
    "id": 2007010030300,
    "speaker": "結華",
    "text": "──それ以外の、責めるような意味はないので！\r\n今回みたいに、変な後ろめたさを見出されても困ります！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030300"
  },
  {
    "id": 2007010030310,
    "speaker": "結華",
    "text": "──ね？",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030310"
  },
