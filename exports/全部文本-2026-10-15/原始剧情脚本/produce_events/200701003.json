    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030170"
  },
  {
    "id": 2007010030180,
    "speaker": "結華",
    "text": "……何があっても\r\nこうやって、すり合わせればいいんだなって",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030180"
  },
  {
    "id": 2007010030190,
    "speaker": "結華",
    "text": "そういうことが、できるんだなって",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030190"
  },
  {
    "id": 2007010030200,
    "speaker": "結華",
    "text": "実感できて、嬉しかった\r\n──だからプロデューサーも、気にしないでよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030200"
  },
  {
    "id": 2007010030210,
    "speaker": "結華",
    "text": "お互い納得し合ったら、\r\nそれでおっけー、そこでおしまい！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030210"
  },
  {
    "id": 2007010030220,
    "speaker": "結華",
    "text": "そうでしょう？　──……ね？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "結華…………",
