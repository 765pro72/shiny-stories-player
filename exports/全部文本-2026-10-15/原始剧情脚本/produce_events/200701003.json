    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "はーー……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010030320,
    "speaker": "結華",
    "text": "ええっ！？\r\n今度は何？　なんのため息！？",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701003/2007010030320"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、すまん……──！\r\n今のでなんか、すごく安心して……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……悪いな、こんなで……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010030330,
