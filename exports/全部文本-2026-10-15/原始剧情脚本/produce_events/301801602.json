  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3018016020480,
    "speaker": "あさひ",
    "text": "はいっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020480"
  },
  {
