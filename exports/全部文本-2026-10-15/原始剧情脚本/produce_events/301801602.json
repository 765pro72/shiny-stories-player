    "bgEffectTime": 1000,
    "fgEffectTime": 700
  },
  {
    "id": 3018016020250,
    "speaker": "off",
    "text": "『腹ごしらえをしたあとは\r\n町の中をぐるっと散策することにしました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020250"
  },
  {
    "id": 3018016020260,
    "speaker": "off",
    "text": "『ふたりで景色を満喫しながら\r\n歩いていると…………』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020260"
  },
