    "waitType": "time",
    "waitTime": 1300,
    "bgEffectTime": 500
  },
  {
    "id": 3018016020490,
    "speaker": "off",
    "text": "『帰り際に、あさひちゃんとパシャリ！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020490"
  },
  {
    "id": 3018016020500,
    "speaker": "off",
    "text": "『観光用の顔出しパネルで撮りました！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020500"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2300
  },
  {
    "id": 3018016020550,
    "speaker": "off",
    "text": "『※あさひちゃんの提案です』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020550"
  },
  {
    "id": 3018016020510,
    "speaker": "冬優子",
    "text": "……なんなのよ、これ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020510"
  },
  {
    "id": 3018016020520,
    "speaker": "あさひ",
    "text": "面白くないっすか？",
