  },
  {
    "id": 3018016020440,
    "speaker": "off",
    "text": "『楽しい旅行は、時間が経つのが\r\n本当にあっという間……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020440"
  },
  {
    "id": 3018016020450,
    "speaker": "off",
    "text": "『お土産屋さんから出た頃には\r\nもう帰る予定の時間になっていました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020450"
  },
  {
    "textFrame": "off",
    "bg": "00158",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 3018016020460,
    "speaker": "off",
    "text": "『すごく楽しかったので\r\n写真を撮るのをすっかり忘れてしまっていました　汗』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020460"
  },
  {
    "id": 3018016020470,
    "speaker": "冬優子",
    "text": "ほら……！\r\nさっさと来る",
    "textCtrl": "p",
    "textFrame": "001",
