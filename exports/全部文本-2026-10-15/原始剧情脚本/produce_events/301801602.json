  },
  {
    "id": 3018016020350,
    "speaker": "off",
    "text": "『それから、石畳を歩いていくと……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020350"
  },
  {
    "textFrame": "off",
    "se": "0775",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 3018016020360,
    "speaker": "off",
    "text": "『待っていたのは、とってもカワイイ子猫！\r\nあさひちゃんの提案で、この子についていくと────』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020360"
  },
  {
    "textFrame": "off",
    "se": "1766",
    "waitType": "time",
    "waitTime": 3300
  },
  {
    "id": 3018016020370,
    "speaker": "冬優子",
    "text": "何よ、この猫……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020370"
  },
  {
    "textFrame": "off",
    "se": "1767",
    "waitType": "time",
    "waitTime": 3300
  },
  {
    "id": 3018016020380,
    "speaker": "あさひ",
    "text": "おー……\r\nこれが噂の猫の集会ってやつっすね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020380"
  },
  {
    "id": 3018016020390,
    "speaker": "off",
    "text": "『たくさんの猫が、ふゆたちを出迎えてくれました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020390"
  },
  {
    "textFrame": "off",
    "se": "0201",
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "id": 3018016020400,
    "speaker": "冬優子",
    "text": "なんなの、こいつ……！\r\nふゆのこと睨んでない！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020400"
  },
  {
    "id": 3018016020410,
    "speaker": "あさひ",
    "text": "あははっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020410"
  },
  {
    "id": 3018016020420,
    "speaker": "off",
    "text": "『たくさんの猫と触れ合えたので\r\nとっても心が温まりました♡』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020420"
  },
  {
    "id": 3018016020430,
    "speaker": "off",
    "text": "『それから──────』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020430"
  },
  {
