  {
    "id": 3018016020270,
    "speaker": "off",
    "text": "『現地の小学生の男の子たちが\r\n元気いっぱい遊んでいました！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020270"
  },
  {
    "speaker": "現地の子ども１",
    "text": "オラァ、いけいけいけ！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1713"
  },
  {
    "speaker": "現地の子ども２",
    "text": "っざけんな！　ヴォエェェェ！\r\nズルだ、ズル！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1714"
  },
  {
    "id": 3018016020280,
    "speaker": "冬優子",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020280"
  },
  {
    "id": 3018016020290,
    "speaker": "off",
    "text": "『みんなはベーゴマに夢中みたいで\r\n遊びといっても、勝負は真剣そのもの……！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020290"
  },
  {
    "id": 3018016020300,
    "speaker": "あさひ",
    "text": "ねぇ！\r\nみんな何やってるの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020300"
  },
  {
    "id": 3018016020310,
    "speaker": "冬優子",
    "text": "ちょっ……\r\nあさひちゃん！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020310"
  },
  {
    "id": 3018016020320,
    "speaker": "off",
    "text": "『あさひちゃんの提案で、\r\nふゆたちも一緒に遊ぶことになりました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020320"
  },
  {
    "id": 3018016020330,
    "speaker": "あさひ",
    "text": "よっ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020330"
  },
  {
    "textFrame": "off",
    "se": "1713",
    "waitType": "time",
    "waitTime": 3300
  },
  {
    "textFrame": "off",
    "se": "1714",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "speaker": "現地の子ども１",
    "text": "やべぇ！\r\nこの姉ちゃん、強ぇ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3018016020340,
    "speaker": "off",
    "text": "『なかなかない機会なので\r\nたまにはこんな交流もいいのかなって＾＾』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020340"
  },
