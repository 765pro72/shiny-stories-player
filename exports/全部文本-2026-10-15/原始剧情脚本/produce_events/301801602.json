  {
    "id": 3018016020010,
    "speaker": "off",
    "text": "…………はぁ\r\n…………",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 4500,
    "voice": "produce_events/301801602/3018016020010"
  },
  {
    "id": 3018016020020,
    "speaker": "off",
    "text": "『黛冬優子 presents\r\nストレイライトの日帰り旅行レポート♡』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020020"
  },
  {
    "textFrame": "off",
    "bgm": "132",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3018016020030,
    "speaker": "off",
    "text": "『こんにちは\r\nレポート担当のふゆです！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020030"
  },
  {
    "id": 3018016020040,
    "speaker": "off",
    "text": "『ツイスタでお知らせした通り、先日ナント！\r\nあさひちゃんとふたりで日帰り旅行に行ってきました！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020040"
  },
  {
    "id": 3018016020050,
    "speaker": "off",
    "text": "『愛依ちゃんがお仕事で行けなくなっちゃったのは\r\nすごく残念だったけど…………』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020050"
  },
  {
    "id": 3018016020060,
    "speaker": "off",
    "text": "『ファンのみんなにも、ふゆたちの思い出を\r\n一緒に楽しんでもらえたら嬉しいな＾＾』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020060"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 500,
    "fgEffectTime": 300
  },
  {
    "id": 3018016020070,
    "speaker": "off",
    "text": "『今回の旅行で向かった先は……\r\n────！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020070"
  },
  {
    "textFrame": "off",
    "bg": "00087",
    "fg": "004741",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "waitType": "time",
    "waitTime": 1200,
    "bgEffectTime": 700,
    "fgEffectTime": 500
  },
  {
    "id": 3018016020080,
    "speaker": "off",
    "text": "『レトロで風情ある町並みがとっても素敵で\r\nずっと行ってみたいなーって思っていた場所です』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020080"
  },
  {
    "id": 3018016020090,
    "speaker": "off",
    "text": "『ゆったり穏やかな時間を満喫できるかも！？\r\nふゆたちの胸は期待でいっぱいでした』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020090"
  },
  {
    "textFrame": "off",
    "bg": "00548",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 3018016020100,
    "speaker": "off",
    "text": "『駅を出ると……目の前に広がる素敵な景色に大興奮！\r\n思わず声が大きくなっちゃいました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020100"
  },
  {
    "id": 3018016020110,
    "speaker": "冬優子",
    "text": "あさひ！\r\n勝手にうろちょろしない！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020110"
  },
  {
    "id": 3018016020120,
    "speaker": "off",
    "text": "『駅前の広場では、大道芸人さんが\r\n素敵なパフォーマンスでふゆたちを出迎えてくれました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020120"
  },
  {
    "id": 3018016020130,
    "speaker": "冬優子",
    "text": "……いつまで見てんのよ\r\n行くわよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020130"
  },
  {
    "id": 3018016020140,
    "speaker": "あさひ",
    "text": "えー……\r\nもうちょっと見たいっす～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020140"
  },
  {
    "id": 3018016020150,
    "speaker": "off",
    "text": "『あさひちゃんの提案で\r\nしばらくパフォーマンスを堪能しました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020150"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 500,
    "fgEffectTime": 300
  },
  {
    "textFrame": "off",
    "bg": "00554",
    "fg": "004741",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000,
    "fgEffectTime": 700
  },
  {
    "id": 3018016020160,
    "speaker": "off",
    "text": "『────には、とっても素敵な和菓子カフェがあるそうで\r\n観光客の間でも、名物スポットとして人気みたいです』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020160"
  },
  {
    "id": 3018016020170,
    "speaker": "off",
    "text": "『最初はそこでランチにしようかなって思っていたけど\r\nそこでとっておきのサプライズが……！？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020170"
  },
  {
    "id": 3018016020180,
    "speaker": "あさひ",
    "text": "五平餅っていうやつみたいっす！\r\n冬優子ちゃんの分も買っといたっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020180"
  },
  {
    "id": 3018016020190,
    "speaker": "off",
    "text": "『あさひちゃんが五平餅を買ってきてくれたので\r\n外で食べ歩きすることにしました』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020190"
  },
  {
    "id": 3018016020200,
    "speaker": "あさひ",
    "text": "ん～～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301801602/3018016020200"
  },
  {
    "id": 3018016020210,
    "speaker": "off",
    "text": "『予定していたお店には行かなかったけど\r\nこういうのも旅行の醍醐味だよね？』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020210"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 3018016020220,
    "speaker": "off",
    "text": "『ちなみに！　予定していたカフェの名物は\r\nなんといってもフルーツ大福！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020220"
  },
  {
    "id": 3018016020230,
    "speaker": "off",
    "text": "『イチゴ、キウイ、みかん、パイナップル\r\nそれにメロンもあるんだって！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020230"
  },
  {
    "id": 3018016020240,
    "speaker": "off",
    "text": "『とっても評判で美味しそうなので\r\nまた行く機会があったら行ってみたいです♡』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301801602/3018016020240"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "fg": "fade_out",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 500,
    "fgEffectTime": 300
  },
