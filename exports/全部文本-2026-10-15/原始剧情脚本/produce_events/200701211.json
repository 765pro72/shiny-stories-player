    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701211/2007012110290"
  },
  {
    "id": 2007012110300,
    "speaker": "結華",
    "text": "もし、あの状況に今の三峰がいたら\r\nプロデューサーに逆スカウト仕掛けるなっていうさ",
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701211/2007012110300"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……そうか",
    "charAnim2": "face_wait",
