    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701211/2007012110260"
  },
  {
    "id": 2007012110270,
    "speaker": "結華",
    "text": "──みたいな？",
