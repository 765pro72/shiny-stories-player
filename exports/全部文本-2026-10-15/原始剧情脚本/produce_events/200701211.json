    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、じゃあ……──\r\n『そこまで言ってもらえるなら』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007012110310,
    "speaker": "結華",
    "text": "うわ、再現やめてよ",
