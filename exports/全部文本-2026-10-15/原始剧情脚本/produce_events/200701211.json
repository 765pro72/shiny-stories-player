    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701211/2007012110250"
  },
  {
    "id": 2007012110260,
    "speaker": "結華",
    "text": "本気であなたに、\r\nプロデューサーになってもらいたいんです",
