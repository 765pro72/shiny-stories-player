    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701111/2007011110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は今見終わったとこだよ。ほらあれ、\r\nちょっと前に公開したアクション映画なんだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007011110030,
    "speaker": "結華",
    "text": "えっ！\r\nもしかしてこれ！？",
    "charAnim1": "surp1",
