  },
  {
    "speaker": "プロデューサー",
    "text": "おっ……おおっ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──あれ、灯織？",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "002"
  },
  {
    "id": 2002009110040,
    "speaker": "灯織",
    "text": "はい、私です",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはよう……いつの間に来てたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110050,
    "speaker": "灯織",
    "text": "おはようございます",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110050"
  },
  {
    "id": 2002009110060,
    "speaker": "灯織",
    "text": "えっと……来たのは１時間くらい前です",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そんなにか\r\nごめん、気付かなくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "来たタイミングで声かけてくれたらよかったのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110070,
    "speaker": "灯織",
    "text": "すごく集中してたので、邪魔になるのでは、と……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110070"
  },
  {
    "id": 2002009110080,
    "speaker": "灯織",
    "text": "プロデューサー、いつから仕事を……？\r\n休憩とか……そもそもお昼って食べましたか？",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110080"
  },
  {
    "id": 2002009110090,
    "speaker": "灯織",
    "text": "もうおやつ時ですよ",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……えっ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110100,
    "speaker": "灯織",
    "text": "まさか、気付いてなかったんですか？",
    "charAnim1": "think",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、最後に確認した時はまだ昼前で……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110110,
    "speaker": "灯織",
    "text": "もう……",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110110"
  },
  {
    "id": 2002009110120,
    "speaker": "灯織",
    "text": "プロデューサーは、アイドルの心配をする前に\r\n自分の心配をしてください",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな……\r\nこれじゃあ人のことを言えない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "休憩するよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110130,
    "speaker": "灯織",
    "text": "……ちゃんと何か食べてくださいね？",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110130"
  },
  {
    "id": 2002009110140,
    "speaker": "灯織",
    "text": "コーヒーばかりじゃ胃が荒れてしまうので",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな、ちゃんと食べるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110150,
    "speaker": "灯織",
    "text": "プロデューサー……",
    "charAnim1": "wait",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110150"
  },
  {
    "id": 2002009110160,
    "speaker": "灯織",
    "text": "食べたいものはありませんか？\r\n夜に響かないように軽くになりますけど",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110160"
  },
  {
    "id": 2002009110170,
    "speaker": "灯織",
    "text": "よければ何か作ります",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110170"
  },
  {
    "id": 2002009110180,
    "speaker": "灯織",
    "text": "実は……私も少しお腹が空いてて……\r\nご一緒させてください",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、いいのか？\r\nじゃあ、ありがたく──……あ、いや",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織もお腹が空いてるのに、任せっぱなしはダメだよな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も手伝うよ",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110190,
    "speaker": "灯織",
    "text": "えっいえ、そんなこと気にしないでください",
    "charAnim1": "shy3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200911/2002009110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、手持無沙汰だと仕事しそうだし……な？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002009110200,
    "speaker": "灯織",
    "text": "じゃあ……その、一緒に作ってください",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
