      "time": 100
    },
    "voice": "produce_events/201200811/2012008110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……凛世？　おお！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
