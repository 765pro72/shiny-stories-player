  {
    "id": 2012008110050,
    "speaker": "凛世",
    "text": "…………あ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200811/2012008110050"
  },
  {
    "id": 2012008110060,
    "speaker": "凛世",
    "text": "プロデューサーさま……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
