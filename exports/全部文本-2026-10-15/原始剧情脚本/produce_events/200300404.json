    "charLabel": "meguru",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200300404/2003004040260"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "それ以外に何があるんだ？",
    "textCtrl": "p"
  },
  {
    "id": 2003004040270,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "じゃあ、わたしのほうが、\r\n絶対、プロデューサーを特別に思ってるよ！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200300404/2003004040270"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "いや、そんなことはない！\r\n俺のほうが……",
    "textCtrl": "p",
    "charLabel": "meguru"
  },
  {
    "id": 2003004040280,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "そんなことあるよっ！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200300404/2003004040280"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "いーや、俺のほうがめぐるのことをよく考えてるよ",
    "textCtrl": "p"
  },
  {
    "id": 2003004040290,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "……えへへ！　じゃあ、分かった！　これからも\r\nわたしのことを大事にしてね、プロデューサー！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200300404/2003004040290"
  },
  {
