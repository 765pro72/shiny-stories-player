  },
  {
    "id": 2003004040210,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "プロデューサーは、プロデューサーだったんだ",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "voice": "produce_events/200300404/2003004040210"
  },
  {
    "id": 2003004040220,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "先生でも、友達でもなくて……\r\nプロデューサーは、プロデューサーなんだ……！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200300404/2003004040220"
  },
  {
    "id": 2003004040230,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "えへへ！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200300404/2003004040230"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "……めぐる？\r\nどうかしたのか？",
    "textCtrl": "p"
  },
  {
    "id": 2003004040240,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "ううん！\r\nなんでもないよっ！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim2": "face_smile",
    "charAnim3Loop": false,
    "charAnim3": "no",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200300404/2003004040240"
  },
  {
    "id": 2003004040250,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "これからもよろしくね、\r\nわたしのプロデューサー！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200300404/2003004040250"
  },
  {
    "nextLabel": "end"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "俺にとっても、めぐるは\r\n特別な存在だよ",
    "textCtrl": "p",
    "charLabel": "meguru"
  },
  {
    "label": "2",
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "なんて言ったって、\r\n大事な担当アイドルだからな",
    "textCtrl": "p"
  },
  {
    "id": 2003004040260,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "……それだけ？",
