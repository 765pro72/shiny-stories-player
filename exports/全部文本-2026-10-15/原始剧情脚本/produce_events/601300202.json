    "voice": "produce_events/601300202/6013002020030"
  },
  {
    "id": 6013002020040,
    "speaker": "夏葉",
    "text": "──さぁ、すぐに帰ってレッスンを始めなくちゃ！\r\n本番までに完璧に仕上げる必要があるもの！",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
