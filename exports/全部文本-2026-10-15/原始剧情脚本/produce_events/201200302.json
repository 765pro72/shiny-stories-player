[
  {
    "speaker": "プロデューサー",
    "text": "まいったなぁ……こんなに急に降り出すなんて",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00016",
    "bgm": "008"
  },
  {
    "id": 2012003020010,
    "speaker": "凛世",
    "text": "しばらく、雨宿りでしょうか……",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
