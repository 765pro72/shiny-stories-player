  {
    "id": 2004015110020,
    "speaker": "恋鐘",
    "text": "ふぇ……\r\nこうやって大画面で見ると、うちじゃなかみたい……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
