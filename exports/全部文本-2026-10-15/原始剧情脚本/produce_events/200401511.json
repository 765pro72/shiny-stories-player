      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200401511/2004015110020"
  },
  {
    "id": 2004015110030,
    "speaker": "恋鐘",
    "text": "……実際～この子はこの子で\r\nうちはうち、なんやけど……！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401511/2004015110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、すごく板についてるんじゃないか",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "アンティーカのみんなにも、\r\n評判よかっただろう？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004015110040,
    "speaker": "恋鐘",
    "text": "うん、みんなにば～り褒められてしまったと～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401511/2004015110040"
  },
  {
    "id": 2004015110050,
    "speaker": "恋鐘",
    "text": "地元の友達も、\r\nうちのお芝居にびっくりしとったし……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401511/2004015110050"
  },
  {
    "id": 2004015110060,
    "speaker": "恋鐘",
    "text": "ばってん\r\nなしてそいがわかっとったと？　プロデューサー",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401511/2004015110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘の強さって、なんでもやってみる、理解しようとする、\r\n受け入れるってところだと思うんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
