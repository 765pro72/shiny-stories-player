    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010480"
  },
  {
    "id": 3008005010490,
    "speaker": "霧子",
    "text": "……恋鐘ちゃん……？",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010490"
  },
  {
    "id": 3008005010500,
    "speaker": "恋鐘",
    "text": "うち、自分のことば～っかりでいっぱいいっぱいやけん\r\nもっとがんばらんば、魚に嫌われる！",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010500"
  },
  {
    "id": 3008005010510,
    "speaker": "霧子",
    "text": "こ、恋鐘ちゃんを、嫌いな人なんて……\r\nい……いないんじゃないかな……！",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010510"
  },
  {
