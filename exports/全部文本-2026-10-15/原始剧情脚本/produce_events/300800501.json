    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010160"
  },
  {
    "id": 3008005010170,
    "speaker": "霧子",
    "text": "でも……恋鐘ちゃん……\r\nその赤い金魚さんの柄……とっても似合うと思う……！",
    "charAnim1": "wait3",
