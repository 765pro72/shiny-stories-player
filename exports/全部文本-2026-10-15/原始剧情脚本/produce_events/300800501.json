    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010120"
  },
  {
    "id": 3008005010130,
    "speaker": "霧子",
    "text": "ふふっ……恋鐘ちゃん……\r\nじゃあ恋鐘ちゃんの方は……ちゃぷん、かなぁ……",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010130"
  },
  {
    "id": 3008005010140,
    "speaker": "恋鐘",
    "text": "うちのは何十匹も描いてあるけん、\r\nきっとみ～んなで跳ねるやろうね！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010140"
  },
  {
    "id": 3008005010150,
    "speaker": "恋鐘",
    "text": "はぁ～……見れば見るほどば～りかわいかね～！\r\n……ほんとにこん浴衣、着てよかと～？",
    "charAnim1": "shy2",
