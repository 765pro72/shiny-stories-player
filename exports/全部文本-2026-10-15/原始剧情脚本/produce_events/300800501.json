    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010150"
  },
  {
    "id": 3008005010160,
    "speaker": "霧子",
    "text": "うん……！\r\nわたしの丈だから……ちょっと短いかもだけど……",
