    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010170"
  },
  {
    "id": 3008005010180,
    "speaker": "恋鐘",
    "text": "んふふ～、霧子の出目金も元気いっぱいやけん、\r\nきっと着たら楽しかよ！",
