    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010450"
  },
  {
    "id": 3008005010460,
    "speaker": "恋鐘",
    "text": "うちもちょっと前に見つけたとよ！\r\nはぁ～……かわいか魚、飼ってみたか～",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300800501/3008005010460"
  },
  {
    "id": 3008005010470,
    "speaker": "霧子",
    "text": "あ……\r\n恋鐘ちゃん……寮だもんね……",
