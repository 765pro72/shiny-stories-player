    "waitTime": 2000
  },
  {
    "speaker": "観客",
    "text": "……頑張れー！\r\n……声を聞かせてー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1015001040110,
    "speaker": "甜花",
    "text": "今、甜花のこと……",
