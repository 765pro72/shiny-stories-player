    "textFrame": "001",
    "voice": "produce_events/202200602/2022006020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸はこっちの『芸能人チーム』の方だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022006020110,
    "speaker": "小糸",
    "text": "げ、『芸能人チーム』……！",
