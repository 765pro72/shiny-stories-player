    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200602/2022006020030"
  },
  {
    "id": 2022006020040,
    "speaker": "小糸",
    "text": "……これに出場するってことですか？",
    "charAnim1": "sad1",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200602/2022006020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだ！　地上波の番組だし\r\nもしも出られればそれだけですごいことだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
