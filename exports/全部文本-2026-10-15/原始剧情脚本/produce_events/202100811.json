  {
    "id": 2021008110010,
    "speaker": "円香",
    "text": "はい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110010"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021008110020,
    "speaker": "円香",
    "text": "……はい、お疲れ様です",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110020"
  },
  {
    "id": 2021008110030,
    "speaker": "円香",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "autoWaitTime": 1500
  },
  {
    "textFrame": "off",
    "bg": "00394",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1600
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "今、ちょっと大丈夫か？\r\n外出中……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110040,
    "speaker": "円香",
    "text": "『まあ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、じゃあ手短に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ショップ販促用のサインを\r\nちょっと急ぎでお願いしたくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "悪いんだけど明日明後日くらいで\r\n事務所に寄れるタイミングはあるかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110050,
    "speaker": "円香",
    "text": "『……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110050"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021008110060,
    "speaker": "円香",
    "text": "『……明日の放課後、行きます』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……！\r\nありがとう、助かるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110070,
    "speaker": "円香",
    "text": "『はい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110070"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021008110080,
    "speaker": "円香",
    "text": "『……それだけですか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、取り急ぎ確認したかったのはそれだけ────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、そうだ\r\nあと…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "円香",
    "text": "『………………』",
    "textCtrl": "p",
    "textFrame": "001",
    "autoWaitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "昨日、取引先からケーキをいただいたんだ\r\n冷蔵庫にあるからよかったら食べてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110100,
    "speaker": "円香",
    "text": "『わかりました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "有名なスイーツ店の季節限定品らしくてさ\r\n俺も３つほど食べたけどすっごく美味しいんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110110,
    "speaker": "円香",
    "text": "『…………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2021008110120,
    "speaker": "円香",
    "text": "『３つは食べすぎでは』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや！　別にひとり占めしたわけじゃない\r\nかなりたくさんいただいて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だから、円香もよかったら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110130,
    "speaker": "円香",
    "text": "『……わかりました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 2021008110140,
    "speaker": "円香",
    "text": "『もういいですか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、うん\r\nそうだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、いや────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "円香",
    "text": "『……………………』",
    "textCtrl": "p",
    "textFrame": "001",
    "autoWaitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──あの後、番組プロデューサーから\r\nちゃんと連絡をもらったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110160,
    "speaker": "円香",
    "text": "『そうでしたか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "ひとまずこちらで話を進めておく",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110170,
    "speaker": "円香",
    "text": "『はい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "必要なところで円香に確認を入れるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110180,
    "speaker": "円香",
    "text": "『別にいいですよ、あなたの判断で』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……わかった\r\nじゃあ何か決まった時にはちゃんと報告するから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110190,
    "speaker": "円香",
    "text": "『……何、その自己アピール』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110190"
  },
  {
    "id": 2021008110200,
    "speaker": "円香",
    "text": "『そういうのはもうわかっています』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110200"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "id": 2021008110210,
    "speaker": "円香",
    "text": "『でも、まあ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110210"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 2021008110220,
    "speaker": "円香",
    "text": "『プロデューサーのことは少し心配なので』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110220"
  },
  {
    "id": 2021008110230,
    "speaker": "円香",
    "text": "『今回は、何か決める前に私にも声をかけてください』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……\r\nうん、わかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、ああ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110240,
    "speaker": "円香",
    "text": "『……何』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110240"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、仕方ないとはいえ、\r\nプロデューサーって呼び名はわかりにくいなと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一瞬、俺のことかと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110250,
    "speaker": "円香",
    "text": "『……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110250"
  },
  {
    "id": 2021008110260,
    "speaker": "円香",
    "text": "『そう呼ばれたいんですか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110260"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、いや……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110270,
    "speaker": "円香",
    "text": "『自分だけが、そう呼ばれたいと』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110270"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いやいやいや\r\nそういう意味じゃない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021008110280,
    "speaker": "円香",
    "text": "『………………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110280"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……別にどんな呼び方でも、\r\n円香に呼ばれた時はちゃんとわかるから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫だ、本当に気にしないでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2021008110290,
    "speaker": "円香",
    "text": "『そうですか。ではそうします』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110290"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "id": 2021008110300,
    "speaker": "円香",
    "text": "『残念でしたね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110300"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2021008110310,
    "speaker": "円香",
    "text": "本当、ダメな人",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100811/2021008110310"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "label": "end",
    "textFrame": "off"
  }
