  },
  {
    "id": 1023004030220,
    "speaker": "雛菜",
    "text": "──あ！　そっか！　そういうこと？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_serious",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102300403/1023004030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004030230,
    "speaker": "雛菜",
    "text": "もしかしてプロデューサーって、\r\n昔アイドルしてたの？",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300403/1023004030230"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや……！\r\nしてないよ、俺は！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんでそうなるんだ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004030240,
    "speaker": "雛菜",
    "text": "なんだ～\r\nしてないのか～……",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300403/1023004030240"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hinana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "se": "0220",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1023004030250,
    "speaker": "雛菜",
    "text": "ね、プロデューサー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300403/1023004030250"
  },
  {
    "id": 1023004030260,
    "speaker": "雛菜",
    "text": "雛菜もいつかは高校生でも\r\nアイドルでもない雛菜になるでしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300403/1023004030260"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023004030270,
    "speaker": "雛菜",
    "text": "その時、雛菜って何になると思う？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300403/1023004030270"
  },
