    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2007009010030,
    "speaker": "結華",
    "text": "……え～……？",
    "charAnim2": "face_jito",
    "charAnim4": "blank",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだ、ご不満か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010040,
    "speaker": "結華",
    "text": "そりゃあご不満ですけど～？",
    "charAnim1": "wait3",
    "charAnim2": "face_close5",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010040"
  },
  {
    "id": 2007009010050,
    "speaker": "結華",
    "text": "はーやだやだ！\r\nもっと慌てるＰたんが見られるかと思ってたのに",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010050"
  },
  {
    "id": 2007009010060,
    "speaker": "結華",
    "text": "しれっと乗ってきちゃってさぁ",
    "charAnim1": "wait2",
    "charAnim2": "face_close5",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは\r\nからかわれる可能性は考えてたからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010070,
    "speaker": "結華",
    "text": "面白くな～い！\r\nその『わかってます』って感じ、すごいムカつく～～！",
    "charAnim1": "anger2",
    "charAnim2": "face_jito",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "『わかってます』なんて、そんな\r\n買いかぶりすぎだよ、俺なんてまだまだだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もっと結華のことを知らなくちゃと思ってる\r\nだからいろんな一面を見せてほしいんだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010080,
    "speaker": "結華",
    "text": "ほらもう！",
    "charAnim1": "sad1",
    "charAnim2": "face_close5",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010080"
  },
  {
    "id": 2007009010090,
    "speaker": "結華",
    "text": "そうやって隙あらば情報取ってこうとする感じも\r\nほんといけ好かないー！",
    "charAnim2": "face_jito",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "っふは……！\r\nしょうがないだろ、誰のプロデューサーだと思ってるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010100,
    "speaker": "結華",
    "text": "ひねくれてて性格が悪くてめんどくさい三峰のＰたんは、\r\nこれぐらいじゃないと務まらないって？",
    "charAnim1": "sad2",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "残念、大ハズレ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつだってアイドルに真剣な結華のプロデューサーを\r\n任せてもらってるんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺だってできる限り優秀じゃなくちゃって話だよ",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010110,
    "speaker": "結華",
    "text": "まったこのプロデューサーは……",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "その反応なら、今日の俺は合格点か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010120,
    "speaker": "結華",
    "text": "知らなーい！",
    "charAnim1": "wait3",
    "charAnim2": "face_close5",
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010120"
  },
  {
    "id": 2007009010130,
    "speaker": "結華",
    "text": "三峰、さっきのクイズも不正解しちゃうような\r\n出来の悪い子なので？",
    "charAnim2": "face_jito",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_jito",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010130"
  },
  {
    "id": 2007009010140,
    "speaker": "結華",
    "text": "プロデューサーの評価なんてとてもとても！\r\n畏れ多くてできませんの……",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは困ったな……\r\n俺は何より、結華からの合格点が欲しいんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010141,
    "speaker": "結華＆プロデューサー",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010141"
  },
  {
    "id": 2007009010142,
    "speaker": "結華＆プロデューサー",
    "text": "……っふ、あはははは……！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010142"
  },
  {
    "id": 2007009010150,
    "speaker": "結華",
    "text": "あーっ、もう白々しい……！\r\nふふっ……！",
    "charAnim1": "surp3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったくだ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0329",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "──……はい、結華。水\r\n喉が渇く前に水分補給、で頼む",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010160,
    "speaker": "結華",
    "text": "お。ありがとうプロデューサー\r\nじゃあ三峰からもお返ししなきゃだね",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200700901/2007009010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010170,
    "speaker": "結華",
    "text": "三峰の荷物預かってもらってるでしょ\r\nあの中に、ちっちゃい巾着があるから",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010170"
  },
  {
    "id": 2007009010180,
    "speaker": "結華",
    "text": "中の塩飴持ってって",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "塩飴……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010190,
    "speaker": "結華",
    "text": "──水分補給だけして、\r\n塩分を摂り忘れることのないように",
    "charAnim1": "sad2",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "うっ……！\r\nごもっともだな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off"
  },
  {
    "id": 2007009010191,
    "speaker": "結華＆プロデューサー",
    "text": "……っふふふ……！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010191"
  },
  {
    "speaker": "プロデューサー",
    "text": "さすが結華は用意がいい",
    "charAnim2": "face_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010200,
    "speaker": "結華",
    "text": "身近に気遣い上手がいるものでぇ\r\nずーっと見てたら似てきちゃったのかも",
    "charAnim1": "shy1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど、実は俺もなんだ\r\nまわりをよく見てくれてるところ、尊敬してる人がいてさ",
    "charAnim2": "face_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009010201,
    "speaker": "結華＆プロデューサー",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010201"
  },
  {
    "speaker": "スタッフ",
    "text": "そろそろ撮影再開しまーす！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2007009010210,
    "speaker": "結華",
    "text": "──おっと！\r\nじゃあもう行かなくちゃだ",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010210"
  },
  {
