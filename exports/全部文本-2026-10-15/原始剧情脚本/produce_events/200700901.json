  {
    "id": 2007009010020,
    "speaker": "結華",
    "text": "後ろ……日焼け止め、塗り直してほしいんだけど──\r\n……ね、ダメ？",
    "charAnim1": "shy1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいぞ\r\nそれじゃあ髪を上げてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2800
  },
