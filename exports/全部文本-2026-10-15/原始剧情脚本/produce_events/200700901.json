    "waitTime": 2500
  },
  {
    "id": 2007009010220,
    "speaker": "結華",
    "text": "……────、っはぁ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700901/2007009010220"
  },
  {
    "id": 2007009010230,
    "speaker": "結華",
    "text": "ごちそうさま、ありがとう！\r\nいってくるね！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
