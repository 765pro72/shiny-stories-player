    "charAnim2": "face_sad",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100502/2001005020130"
  },
  {
    "id": 2001005020140,
