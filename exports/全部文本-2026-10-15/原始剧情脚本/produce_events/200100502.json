    "voice": "produce_events/200100502/2001005020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "？\r\nどうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001005020040,
    "speaker": "真乃",
    "text": "あ、いえ\r\nとっても美味しそうな匂いがしたので……",
