    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100502/2001005020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん～、言われてみたら確かに……\r\nこの辺りは、ご飯屋さんが多いんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
