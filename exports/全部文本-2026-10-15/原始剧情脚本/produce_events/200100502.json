    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100502/2001005020090"
  },
  {
    "id": 2001005020100,
    "speaker": "真乃",
    "text": "……あのっプロデューサーさん\r\n私、実はお腹ぺこぺこで……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100502/2001005020100"
  },
  {
    "id": 2001005020110,
    "speaker": "真乃",
    "text": "良かったら、一緒にご飯食べに行きませんか……？",
