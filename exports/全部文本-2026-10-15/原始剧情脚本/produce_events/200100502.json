    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100502/2001005020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょうど俺もそう言おうと思ってたんだ\r\nじゃあ、いい匂いがしてきたお店に入ろうか",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "textFrame": "off"
  },
  {
    "id": 2001005020120,
    "label": "2",
    "speaker": "真乃",
    "text": "えっ？　いえっ\r\n無理してたわけじゃないんです……",
