    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800702/2018007020070"
  },
  {
    "id": 2018007020080,
    "speaker": "冬優子",
    "text": "まぁ、母親が一番、『謙遜するふゆちゃん可愛い～！』\r\nって盛り上がってたみたいだけど",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800702/2018007020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018007020090,
    "speaker": "冬優子",
    "text": "……ちなみに今のは父親情報",
