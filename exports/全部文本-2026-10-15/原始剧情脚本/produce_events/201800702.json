  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　じゃあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "写真とあわせて紹介する予定の\r\n幼少期のエピソードだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もらってるもので大丈夫だ\r\n本番のトークも頑張ってな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018007020050,
    "speaker": "冬優子",
    "text": "トーゼン",
