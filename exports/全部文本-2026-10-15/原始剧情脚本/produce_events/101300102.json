[
  {
    "speaker": "プロデューサー",
    "text": "よし、そろそろ行こうか\r\nもう準備はできてるな？",
    "charAnim1": "wait2",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "013",
