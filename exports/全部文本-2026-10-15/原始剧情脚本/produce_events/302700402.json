  {
    "id": 3027004020240,
    "speaker": "羽那",
    "text": "あたしとはるきちゃんは\r\nソロで活動してるけど──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020240"
  },
  {
    "id": 3027004020250,
    "speaker": "羽那",
    "text": "２８３の先輩たちみたいに、\r\nユニットを組むことはないの？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020250"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hana",
    "textFrame": "off",
