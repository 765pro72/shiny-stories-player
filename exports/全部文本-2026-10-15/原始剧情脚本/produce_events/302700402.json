  },
  {
    "id": 3027004020070,
    "speaker": "はるき",
    "text": "『うんうん……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020070"
  },
  {
    "id": 3027004020080,
    "speaker": "羽那",
    "text": "それで、場所を聞くために\r\nスタッフさんだと思って話しかけた人が",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020080"
  },
  {
    "id": 3027004020090,
    "speaker": "羽那",
    "text": "全然関係ない人だったみたいで、\r\n怒られちゃったのーっ",
    "charAnim1": "think",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020090"
  },
  {
    "id": 3027004020100,
    "speaker": "はるき",
    "text": "『ええっ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020100"
  },
  {
    "id": 3027004020110,
    "speaker": "はるき",
    "text": "『それは運が悪かったねぇ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020110"
  },
  {
    "id": 3027004020120,
    "speaker": "羽那",
    "text": "うん……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_surp",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020120"
  },
  {
    "id": 3027004020130,
    "speaker": "はるき",
    "text": "『ひとりだとそういうトラブルがあった時に\r\n誰かを頼れないから、大変だよねぇ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020130"
  },
  {
    "id": 3027004020140,
    "speaker": "羽那",
    "text": "ねーっ",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020140"
  },
  {
    "id": 3027004020150,
    "speaker": "羽那",
    "text": "はるきちゃんが一緒だったら\r\nはるきちゃんのこと、頼ってたのに……",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_surp",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020150"
  },
  {
    "id": 3027004020160,
    "speaker": "はるき",
    "text": "『わ、わたし……？\r\n頼りになるのかなぁ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020160"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hana",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1600
  },
  {
    "id": 3027004020170,
    "speaker": "はるき",
    "text": "『──でもわたしも、今ここに羽那ちゃんが\r\nいてくれたらなぁって思うこと、たくさんあるよ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020170"
  },
  {
    "id": 3027004020180,
    "speaker": "はるき",
    "text": "『そうしたらクリスマスのイベントの時みたいに\r\nいろんなこと、乗り越えられると思うから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020180"
  },
  {
    "id": 3027004020190,
    "speaker": "はるき",
    "text": "『あの時は、先輩たちの力の方を\r\n借りてたかもしれないけど……！』",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302700402/3027004020190"
  },
  {
    "id": 3027004020200,
