  {
    "id": 3027004020060,
    "speaker": "羽那",
    "text": "今日、初めてのスタジオだったんだけど\r\n控室の場所がわからなくなっちゃって",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
