      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "008"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織が誰かに輝きを届けて、\r\nその輝きを見た誰かが、また輝きを届けようと頑張ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002003050150,
    "speaker": "灯織",
    "text": "誰かに追いかけてもらえるようなことは、\r\nまだまだ全然、できてないと思うんですけど……",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050150"
  },
  {
    "id": 1002003050160,
    "speaker": "灯織",
    "text": "でも、すごく……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050160"
  },
  {
    "id": 1002003050170,
    "speaker": "灯織",
