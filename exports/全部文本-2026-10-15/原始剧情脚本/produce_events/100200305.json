  {
    "id": 1002003050090,
    "speaker": "灯織",
    "text": "『灯織ちゃん』\r\n『初めてお手紙を書きました』──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050090"
  },
  {
    "id": 1002003050100,
    "speaker": "灯織",
    "text": "『どうしても伝えたいことがあって』\r\n『この前、灯織ちゃんが出ている番組を見ました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050100"
  },
  {
    "id": 1002003050110,
    "speaker": "灯織",
    "text": "『可愛くて、真剣で、まじめで、ストイックで、\r\nきらきらしてて、とってもとっても眩しくて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050110"
  },
  {
    "id": 1002003050120,
    "speaker": "灯織",
    "text": "『私、灯織ちゃんが大好き』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050120"
  },
  {
    "id": 1002003050130,
    "speaker": "灯織",
    "text": "『灯織ちゃんみたいなアイドルになりたいって思いました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050130"
  },
  {
    "id": 1002003050140,
    "speaker": "灯織",
    "text": "『今、歌とダンスを習っています』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200305/1002003050140"
  },
  {
