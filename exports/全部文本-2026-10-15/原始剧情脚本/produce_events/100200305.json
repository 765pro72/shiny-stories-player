  {
    "speaker": "プロデューサー",
    "text": "灯織がアイドルを目指そうと思った時みたいに、\r\n今の灯織は、誰かの目標になってるんだな",
    "charAnim1": "wait",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
