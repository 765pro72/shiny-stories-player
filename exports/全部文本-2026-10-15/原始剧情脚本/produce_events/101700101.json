  },
  {
    "id": 1017001010030,
    "speaker": "？？？",
    "text": "──っと……うん、決まった！",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700101/1017001010030"
