    }
  },
  {
    "speaker": "プロデューサー",
    "text": "君、ちょっといいかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017001010040,
    "speaker": "？？？",
    "text": "？　わたしっすか？",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
