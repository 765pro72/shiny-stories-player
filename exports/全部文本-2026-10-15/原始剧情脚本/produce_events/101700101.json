  },
  {
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "ふぅ……\r\n少し休憩するか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（さすがにそう簡単に、\r\nピンとくる子は見つからないよなぁ……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あのモニターに映ってるCM、最近よく見るなぁ\r\n人気のアイドルだけあって、歌もダンスも本格的だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017001010010,
    "speaker": "？？？",
    "text": "よっ……ほっ……っと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700101/1017001010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし……そろそろ行こう──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "smile1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textFrame": "off",
