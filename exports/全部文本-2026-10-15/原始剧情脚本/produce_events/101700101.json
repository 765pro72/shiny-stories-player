  },
  {
    "id": 1017001010020,
    "speaker": "？？？",
    "text": "──ここは……こう？──",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101700101/1017001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あの子、さっきから踊ってるな……\r\nん？　でもあのダンス……！）",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002",
