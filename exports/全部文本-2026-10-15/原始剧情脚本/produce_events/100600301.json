    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600301/1006003010160"
  },
  {
    "id": 1006003010170,
    "speaker": "咲耶",
    "text": "それが、ファンのみんなに見られながらのものなら\r\nなおさらだ",
