    "voice": "produce_events/100600301/1006003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、あ、大丈夫だぞ？\r\n俺ひとりでも充分──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003010100,
