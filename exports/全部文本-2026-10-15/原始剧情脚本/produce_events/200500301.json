      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "id": 2005003010030,
    "speaker": "摩美々",
    "text": "レッスン……、そういえばそうでしたねー、\r\nすっかり忘れてましたぁ",
    "charAnim1": "surp2",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030050010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200500301/2005003010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "忘れてた……？\r\nじゃあ特に何かあったわけじゃないのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010040,
    "speaker": "摩美々",
    "text": "何か、ですかぁ？\r\nフツーでしたよー。特にやりたいことなかったですしー",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、電話に出なかったのは？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010050,
    "speaker": "摩美々",
    "text": "えー？　あっ、気がつきませんでしたぁ\r\n携帯もずっと鞄の中に入れっぱなしでしたしー",
    "charAnim1": "smile2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々……\r\nどれだけ心配して、探し回ったと思ってるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010060,
    "speaker": "摩美々",
    "text": "そういえばぁ、珍しく汗だくですねー",
    "charAnim1": "smile1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010060"
  },
  {
    "id": 2005003010070,
    "speaker": "摩美々",
    "text": "そんなに私のこと\r\n心配で探してくれてたんですかぁ？",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "当たり前だろ\r\n摩美々の身に何かあったのかと思ったんだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……とにかく、これからは\r\nちゃんと携帯を確認するようにしてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そして、レッスンに来れない時は\r\nちゃんと連絡すること、いいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010080,
    "speaker": "摩美々",
    "text": "でもー、\r\n忘れたらしょうがないじゃないですかぁ",
    "charAnim1": "wait2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "これは摩美々のための約束でもあるんだ\r\n絶対に守ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010090,
    "speaker": "摩美々",
    "text": "はぁい。わかりましたぁ\r\n今度からは気をつけますねー",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、もうこんな時間か……\r\n今日はもう帰ろう──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010100,
    "speaker": "摩美々",
    "text": "……プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、なんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010110,
    "speaker": "摩美々",
    "text": "……プロデューサーは\r\nどうしてそこまでしてくれるんですかぁ？",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010110"
  },
  {
    "id": 2005003010120,
    "speaker": "摩美々",
    "text": "どこにいるかもわからない私のために、\r\n汗だくになって必死に探してくれたりー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010120"
  },
  {
    "id": 2005003010130,
    "speaker": "摩美々",
    "text": "私のこと、\r\n心配してくれたりするじゃないですかぁ",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010130"
  },
  {
    "id": 2005003010140,
    "speaker": "摩美々",
    "text": "家族でもないのに、\r\nなんでそこまで……？",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなの決まってるだろ\r\n俺が、摩美々のプロデューサーだからだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010150,
    "speaker": "摩美々",
    "text": "それだけですかぁ？",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほかに理由なんていらないだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010160,
    "speaker": "摩美々",
    "text": "そう、ですかぁ……",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010160"
  },
  {
    "id": 2005003010170,
    "speaker": "摩美々",
    "text": "……あの、今日のことは、\r\nその……ごめんなさい",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ\r\nわかってくれればいいんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（摩美々が謝るなんて……\r\n反省してくれているんだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010180,
    "speaker": "摩美々",
    "text": "あ、よかったらこれ、\r\nどーぞ",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "缶ジュースか？\r\nでもこれ、開いてるぞ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010190,
    "speaker": "摩美々",
    "text": "私の飲みかけジュースですー\r\nお詫びにあげますねー",
    "charAnim1": "wait1",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "おいおい、飲みかけって……",
    "charAnim2": "blank",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010200,
    "speaker": "摩美々",
    "text": "残念ながらぁ、\r\n中身は入ってませんケドー",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……からかったな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010210,
    "speaker": "摩美々",
    "text": "ふふー、\r\nプロデューサーの困ってる顔おもしろいですねー",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく……\r\n本当に反省してるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010220,
    "speaker": "摩美々",
    "text": "してますよー？\r\nすっごく反省してるんですからぁ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010220"
  },
  {
    "id": 2005003010230,
    "speaker": "摩美々",
    "text": "それより早く帰りましょー\r\n置いてっちゃいますよー？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010230"
  },
