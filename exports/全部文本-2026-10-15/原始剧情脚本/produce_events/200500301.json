  {
    "id": 2005003010010,
    "speaker": "摩美々",
    "text": "あれー、プロデューサー？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "こ、ここにいたのか！\r\nはぁ……とりあえず、無事で良かった……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005003010020,
    "speaker": "摩美々",
    "text": "どうしたんですかぁ？\r\nなんだかすごく慌ててたみたいですケド",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500301/2005003010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうしたって……摩美々がレッスンにも来ないし、\r\n連絡もつかないから探してたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "effectLabel": "white2",
    "effectTarget": {
      "type": "rect",
