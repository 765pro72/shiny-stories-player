  },
  {
    "id": 7015001070010,
    "speaker": "甜花",
    "text": "ま……待ってた、よ……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_shy2",
    "charLabel": "tenka",
    "textCtrl": "p",
