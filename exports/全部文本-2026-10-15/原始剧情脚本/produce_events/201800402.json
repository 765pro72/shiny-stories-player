    "textFrame": "001",
    "voice": "produce_events/201800402/2018004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も同意見、だからかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018004020220,
    "speaker": "冬優子",
    "text": "へ？",
    "charAnim1": "surp3",
    "charAnim2": "face_surp",
