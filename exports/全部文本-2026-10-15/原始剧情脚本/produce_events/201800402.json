  },
  {
    "textFrame": "off"
  },
  {
    "id": 2018004020180,
    "label": "2",
    "speaker": "冬優子",
    "text": "…………\r\nったく、わかってないわよね",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "fuyuko",
