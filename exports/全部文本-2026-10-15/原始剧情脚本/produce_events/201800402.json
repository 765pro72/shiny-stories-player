    },
    "voice": "produce_events/201800402/2018004020100"
  },
  {
    "id": 2018004020110,
    "speaker": "冬優子",
    "text": "ほら、あんたも見てみなさいよ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
