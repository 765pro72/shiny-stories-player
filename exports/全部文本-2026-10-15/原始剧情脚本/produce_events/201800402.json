    "voice": "produce_events/201800402/2018004020180"
  },
  {
    "id": 2018004020190,
    "speaker": "冬優子",
    "text": "ふゆはかっこいいんじゃなくて、\r\n可愛いの！　そこのとこ考えてよね",
    "charAnim1": "anger3",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800402/2018004020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……『可愛いもかっこいいもこなす冬優子ちゃん、\r\n本当にかっこいいって思います』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ストレイライトの冬優子ちゃん、\r\nすっごくかっこよかった！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018004020200,
    "speaker": "冬優子",
    "text": "………………っ！",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800402/2018004020200"
  },
  {
    "id": 2018004020210,
    "speaker": "冬優子",
    "text": "バカ！　なんでかっこいいの方ばっか言うのよ！",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "fuyuko",
