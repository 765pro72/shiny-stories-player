  {
    "speaker": "プロデューサー",
    "text": "ただいまー、\r\n……はぁ……今日も一日頑張ったなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "kogane",
    "charType": "idols",
    "charId": "1040040010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
