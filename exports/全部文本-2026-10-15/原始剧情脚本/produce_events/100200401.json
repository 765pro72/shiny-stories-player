    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004010170,
    "speaker": "灯織",
    "text": "ワンマンライブ……なんですよね",
