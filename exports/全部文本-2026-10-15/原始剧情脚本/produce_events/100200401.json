    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、ここか\r\nなるほど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……前にさ、ファンや２８３のみんな、\r\nステージに立つことって言ってただろ？",
    "charAnim2": "face_sad",
    "charAnim4": "eye_front",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004010120,
    "speaker": "灯織",
    "text": "ええ、まぁ……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "それを書くのはダメか？\r\n俺はすごくいい答えだと思ってるんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004010130,
    "speaker": "灯織",
    "text": "確かに、好きなものではあるのですが……",
