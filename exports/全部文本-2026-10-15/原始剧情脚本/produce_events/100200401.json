    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010220"
  },
  {
    "id": 1002004010230,
    "speaker": "灯織",
    "text": "そう思うんですけど、\r\nただの私が好きだと思うこと、自分でもわからなくて",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010230"
  },
