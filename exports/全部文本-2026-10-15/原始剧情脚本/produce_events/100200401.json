    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010170"
  },
  {
    "id": 1002004010180,
    "speaker": "灯織",
    "text": "私たちだけしかいないステージを\r\n見に来てくれる人たち……なんですよね……",
