    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010200"
  },
  {
    "id": 1002004010210,
