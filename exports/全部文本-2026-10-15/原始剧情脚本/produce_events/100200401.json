    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010130"
  },
  {
    "id": 1002004010140,
    "speaker": "灯織",
    "text": "でも、もしこれがパンフレットに書いてあったら\r\nあまりにビジネス的に見えませんか？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010140"
  },
  {
    "id": 1002004010150,
    "speaker": "灯織",
    "text": "本心なのは間違いないんですけど、\r\n私がこう答えると、好感度アップみたいな……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004010160,
    "speaker": "灯織",
    "text": "それに……",
    "charAnim2": "face_close",
