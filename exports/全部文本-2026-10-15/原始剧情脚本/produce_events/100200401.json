    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200401/1002004010180"
  },
  {
    "id": 1002004010190,
    "speaker": "灯織",
    "text": "それって……自分で言うのもなんなんですけど\r\n私たちのこと、好きでいてくださって",
