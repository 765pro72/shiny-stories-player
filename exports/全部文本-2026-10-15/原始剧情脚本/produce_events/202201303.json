    "speaker": "老婦",
    "text": "あら、何かしら",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022013030090,
    "speaker": "小糸",
    "text": "ずっと住んでた家をお店に……って思ったのは\r\nな、なんでなのかなって……",
