  },
  {
    "id": 2022013030100,
    "speaker": "小糸",
    "text": "あ……！\r\nこ、答えたくないことだったら大丈夫なので……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
