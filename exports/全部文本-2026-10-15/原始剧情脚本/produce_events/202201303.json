  {
    "speaker": "老婦",
    "text": "あら、まぁ！　素敵なお嬢さんねぇ\r\nこんにちは",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022013030060,
    "speaker": "小糸",
    "text": "えっと……こ、こんにちは……",
