    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201303/2022013030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "本日はお世話になります",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "老婦",
    "text": "こちらこそ、お世話になります\r\n……ごめんなさいね、お洋服の確認をしてたんでしょう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2022013030070,
    "speaker": "小糸",
    "text": "あ……\r\nだ、だいたい終わってたので……！",
    "charAnim1": "wait2",
