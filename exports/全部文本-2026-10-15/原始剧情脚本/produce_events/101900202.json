    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900202/1019002020170"
  },
  {
    "id": 1019002020180,
    "speaker": "愛依",
    "text": "──あれ、何言ってんだろうち！？\r\nえ、えーと、言いたいのは、なんつーの……？",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
