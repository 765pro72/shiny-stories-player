    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900202/1019002020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019002020160,
    "speaker": "愛依",
    "text": "プロデューサーがいなかったら、今のうちはいなくて……",
