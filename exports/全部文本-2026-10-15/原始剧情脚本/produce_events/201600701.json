    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "002",
    "voice": "produce_events/201600701/2016007010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、すごくいいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "きっと、読んでくれた人の記憶に残るんじゃないかな",
    "charAnim2": "face_surp",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007010050,
    "speaker": "千雪",
    "text": "あ……\r\nありがとうございます……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "けど、千雪は\r\n親指姫をこんなふうに読んでたんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007010060,
    "speaker": "千雪",
    "text": "……？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……俺なんかは\r\n小さいお姫様の話、くらいにしか思ってなかったから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007010070,
    "speaker": "千雪",
    "text": "いえ、そんな……",
    "charAnim1": "shy1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010070"
  },
  {
    "id": 2016007010080,
    "speaker": "千雪",
    "text": "受け取り方は人それぞれですし……\r\nそこが物語のいいところですから",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは\r\nありがとうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、好きな本のコラムに\r\n親指姫の絵本を選ぶなんてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪らしいけど……\r\n何か、選んだ理由はあるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007010090,
    "speaker": "千雪",
    "text": "……はい\r\n弟が小さなころ、絵本の読み聞かせをしていたので",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007010100,
    "speaker": "千雪",
    "text": "……でも、それだけじゃなくて",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010100"
  },
  {
    "id": 2016007010110,
    "speaker": "千雪",
    "text": "昔から好きなんです\r\n絵本とか……そういった、物語が",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010110"
  },
  {
    "id": 2016007010120,
    "speaker": "千雪",
    "text": "物語のヒロインを見ていると……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600701/2016007010120"
  },
  {
    "id": 2016007010130,
    "speaker": "千雪",
    "text": "自分もきっと、\r\n何かになれるんじゃないかって思って",
