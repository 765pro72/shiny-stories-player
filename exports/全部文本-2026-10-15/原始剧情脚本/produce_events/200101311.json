    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "お花見楽しかったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013110030,
    "speaker": "真乃",
    "text": "はい……っ\r\nとっても……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101311/2001013110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん。それは何よりだ\r\nさっそく見せてもらうよ、どれどれ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、\r\nみんなライブの次の日とは思えないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "写真から元気で楽しそうなのが伝わってくるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00344",
    "bgEffect": "fade",
    "se": "0454",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、お弁当美味そうだなあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013110040,
    "speaker": "真乃",
    "text": "ふふ、はい……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110040"
  },
  {
    "id": 2001013110050,
    "speaker": "真乃",
    "text": "灯織ちゃんが、可愛いお花の巻きずしを\r\nたくさん作ってきてくれました……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110050"
  },
  {
    "id": 2001013110060,
    "speaker": "真乃",
    "text": "食べるのがもったいないくらいだったんですけれど、\r\nとっても、美味しくて……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、みんな美味そうに頬張ってるもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2001013110070,
    "speaker": "真乃",
    "text": "こっちの飲み物は、めぐるちゃんが教えてくれた\r\nジュースの混ぜ合わせで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110070"
  },
  {
    "id": 2001013110080,
    "speaker": "真乃",
    "text": "色もきれいで、美味しくて……\r\nみんなで作るのがとっても楽しかったです……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "se": "0454",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "………………\r\nうん、どの写真もよく撮れてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この、空から桜を見下ろしてるみたいに見えるの\r\nいいよなあ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013110090,
    "speaker": "真乃",
    "text": "……プロデューサーさんが、\r\nいろいろ教えてくださったおかげです",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101311/2001013110090"
  },
  {
    "id": 2001013110100,
    "speaker": "真乃",
    "text": "お借りした本も、とっても楽しくて\r\nあっという間に読み終わっていました",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、俺は大したことしてないけど……\r\n本、役に立ったならよかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いっぱい撮ってきてくれて、ありがとうな真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
