    "voice": "produce_events/200101311/2001013110110"
  },
  {
    "id": 2001013110120,
    "speaker": "真乃",
    "text": "えっと、シジュウカラさんが落とした\r\nお花ではあるんですけれど……",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
