    "voice": "produce_events/200101311/2001013110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、そうだったのか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013110140,
    "speaker": "真乃",
    "text": "本当は、鳥さんがお花を降らせた瞬間を\r\n撮りたかったんですけれど、上手く撮れなくて",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101311/2001013110140"
  },
  {
    "id": 2001013110150,
    "speaker": "真乃",
    "text": "でも、ちょっとでも写真に残したいなって思って\r\nこれを……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
