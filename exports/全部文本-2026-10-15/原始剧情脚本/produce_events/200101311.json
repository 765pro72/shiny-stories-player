    "voice": "produce_events/200101311/2001013110010"
  },
  {
    "id": 2001013110020,
    "speaker": "真乃",
    "text": "アルバムにまとめられたらって思ったんです",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
