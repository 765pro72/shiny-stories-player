    "waitTime": 2500
  },
  {
    "id": 2001013110010,
    "speaker": "真乃",
    "text": "……は、はい\r\n気付いたら、思った以上に写真を撮っていて……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
