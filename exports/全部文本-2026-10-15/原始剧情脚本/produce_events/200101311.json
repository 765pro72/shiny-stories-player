  {
    "id": 2001013110130,
    "speaker": "真乃",
    "text": "……前にプロデューサーさんにご一緒いただいた\r\n桜並木で撮ったものなんです",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
