    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ささやかだけど\r\nこの前のお礼になればって思ってたから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014009110090,
