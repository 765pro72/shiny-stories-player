  {
    "id": 1022003020050,
    "speaker": "小糸",
    "text": "──…………はぁ……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
