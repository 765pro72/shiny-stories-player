  {
    "speaker": "プロデューサー",
    "text": "よく撮れてるだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020200,
    "speaker": "小糸",
    "text": "…………\r\nあ、あの、プロデューサーさん",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
