    "speaker": "小糸",
    "text": "それって、わたしが──……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020210"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 600
