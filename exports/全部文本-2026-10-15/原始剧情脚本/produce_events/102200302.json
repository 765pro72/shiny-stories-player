    "text": "着替えてきますね",
    "charAnim1": "wait4",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "……え？　お、おう",
