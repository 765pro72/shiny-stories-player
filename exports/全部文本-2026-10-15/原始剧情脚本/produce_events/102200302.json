    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1022003020220,
    "speaker": "小糸",
    "text": "い、いえ……\r\nわたしはやっぱり、よくわからないので",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020220"
  },
  {
    "id": 1022003020230,
    "speaker": "小糸",
    "text": "プロデューサーさんが、良いと思うように\r\nやってください",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020230"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いいのか？\r\n小糸、もし何か──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020240,
    "speaker": "小糸",
    "text": "──わたし\r\n……今日はもう上がろうと思うので",
    "charAnim1": "sad2",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
