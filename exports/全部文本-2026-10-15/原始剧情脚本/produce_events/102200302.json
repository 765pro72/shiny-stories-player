  {
    "speaker": "プロデューサー",
    "text": "──小糸、自主練お疲れ\r\nほら、ちゃんと水分摂らないとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020040,
    "speaker": "小糸",
    "text": "プロデューサーさん……\r\nありがとうございます",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
