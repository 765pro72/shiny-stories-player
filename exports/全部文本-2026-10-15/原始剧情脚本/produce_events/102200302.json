      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102200302/1022003020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "他にも何か必要な物があったら、\r\nなんでも言ってくれよ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020060,
    "speaker": "小糸",
    "text": "でも、もう充分\r\n色々してもらってますよ……！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020060"
  },
  {
    "id": 1022003020070,
    "speaker": "小糸",
    "text": "こうやって遅くまで付き合ってもらってますし、\r\n送り迎えとかも……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "言っただろ？\r\n今まで以上にしっかりサポートしていくつもりだって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020080,
    "speaker": "小糸",
    "text": "……！\r\nも、もう……！",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020080"
  },
  {
    "id": 1022003020090,
    "speaker": "小糸",
    "text": "な、なんかわたしよりも\r\n気合入ってるんじゃないですか……！？",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、すまん\r\n小糸のために何かできないかって色々考えちゃってな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一緒に、頑張りたいって思ってるからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020100,
    "speaker": "小糸",
    "text": "…………\r\nプロデューサーさん……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020100"
  },
  {
    "charAnim1": "wait",
    "charLabel": "koito",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0884",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──それで、小糸\r\nひとつ提案があるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020110,
    "speaker": "小糸",
    "text": "……？\r\nなんですか？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102200302/1022003020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "『G.R.A.D.』に出てるアイドルって\r\n結構SNSを使った自己アピールをしてるんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "例えば──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim4": "eye_right",
    "charLabel": "koito",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "se": "0272",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、こういう感じでさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020120,
    "speaker": "小糸",
    "text": "…………",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102200302/1022003020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸はこういう、自分から発信みたいなこと\r\n今までしてこなかったけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これを機にやってみるのはどうかと思ってるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020130,
    "speaker": "小糸",
    "text": "あ……\r\nや、やっぱりそういうの、必要なんですかね……？",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020130"
  },
  {
    "id": 1022003020140,
    "speaker": "小糸",
    "text": "わたし、あんまりやったことが無くて……\r\nう、上手く、できるといいんですけど……",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸の負担になるといけないから\r\nもしよかったら今回は、俺が更新していこうかと思ってて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020150,
    "speaker": "小糸",
    "text": "……プロデューサーさんが、ですか……？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん小糸が伝えたいことがあれば\r\nそれも載せたいと思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だけど『G.R.A.D.』のための練習もしながら\r\n慣れないことをしていくの、大変だろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020160,
    "speaker": "小糸",
    "text": "は、はい……\r\nちょっと、難しそうですけど",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020160"
  },
  {
    "id": 1022003020170,
    "speaker": "小糸",
    "text": "……でも、必要なこと、なら──……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、だから小糸が今日みたいに\r\n頑張って練習してるところを、写真とか動画に収めてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それを『G.R.A.D.』まで、\r\nリアルタイムに伝えていきたいんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020180,
    "speaker": "小糸",
    "text": "え…………",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/102200302/1022003020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸の頑張りをみんなに知ってほしいし、\r\nそうすればみんなもっと応援したくなると思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "実際、俺もそうだしさ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022003020190,
    "speaker": "小糸",
    "text": "あ…………えっと",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200302/1022003020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっき練習してたところも動画と……\r\nほら、写真も撮ったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
