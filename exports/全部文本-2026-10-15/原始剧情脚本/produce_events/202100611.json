    "waitTime": 400
  },
  {
    "id": 2021006110020,
    "speaker": "円香",
    "text": "むきになるということは、\r\n事実だと証明しているようなもの",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "021",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "073",
    "voice": "produce_events/202100611/2021006110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "むきになんてなってないさ\r\n断じて──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110030,
    "speaker": "円香",
    "text": "耳まで真っ赤でしたが",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうだったか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110040,
    "speaker": "円香",
    "text": "こっちは水着を着ていたのに、\r\nひとりで意識していたとか",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110040"
  },
  {
    "id": 2021006110050,
    "speaker": "円香",
    "text": "中学生レベル",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "大人として当然の配慮だろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110060,
    "speaker": "円香",
    "text": "その上、説教まで",
    "charAnim1": "wait2",
    "charAnim2": "face_close4",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや……それは……",
    "charAnim2": "face_serious",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく……\r\nはは……敵わないな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110070,
    "speaker": "円香",
    "text": "…………",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110070"
  },
  {
    "id": 2021006110080,
    "speaker": "円香",
    "text": "隙を見せるからです",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110080"
  },
  {
    "id": 2021006110090,
    "speaker": "円香",
    "text": "……一瞬の隙を見せるから",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110100,
    "speaker": "円香",
    "text": "恥ずかしく思っているのだと知られたら終わり",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110100"
  },
  {
    "id": 2021006110110,
    "speaker": "円香",
    "text": "その後、取り繕っても無駄",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……\r\n俺はどうすればよかったんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021006110120,
    "speaker": "円香",
    "text": "事も無げにしていたら、\r\n良かったんじゃないですか？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202100611/2021006110120"
  },
  {
    "id": 2021006110130,
    "speaker": "円香",
    "text": "何事も、撥ねつけるくらいなら受け入れる方が楽",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
