    "textFrame": "001",
    "voice": "produce_events/100300301/1003003010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫、わかってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1003003010240,
    "speaker": "めぐる",
    "text": "ふふっ、そっか……！",
