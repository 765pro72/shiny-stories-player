  {
    "speaker": "プロデューサー",
    "text": "ああ、なるほど。あの台詞調の歌詞を\r\n言ってほしいってリクエストされてたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006016110100,
    "speaker": "咲耶",
    "text": "うん\r\n耳元で囁いてほしいっていうオーダーでね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
