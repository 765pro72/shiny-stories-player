      "time": 100
    },
    "voice": "produce_events/200601611/2006016110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "やっぱり咲耶だったんだな\r\nこの行列",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006016110040,
    "speaker": "咲耶",
    "text": "フフ、みんなに見つかってしまってね\r\nリクエストに応えていたんだ",
    "charAnim1": "think",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601611/2006016110040"
  },
  {
    "id": 2006016110050,
    "speaker": "咲耶",
    "text": "どう？\r\nアナタも並んでみる？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601611/2006016110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうしたいところだけど\r\nもうそろそろ向かわないと、仕事に間に合わないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006016110060,
    "speaker": "咲耶",
    "text": "おっと、そうか……",
