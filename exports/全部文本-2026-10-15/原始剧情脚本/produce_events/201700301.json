  {
    "id": 2017003010220,
    "label": "3",
    "speaker": "あさひ",
    "text": "？　事務所に何かあるんすか？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp",
