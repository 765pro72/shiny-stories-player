  },
  {
    "speaker": "プロデューサー",
    "text": "あさひ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010020,
    "speaker": "あさひ",
    "text": "？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charAnim4": "blank",
    "charLipAnim": "lip_serious_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010020"
  },
  {
    "id": 2017003010030,
    "speaker": "あさひ",
    "text": "あれ、プロデューサーさんじゃないっすか！\r\nこんなところで何してるんす？",
    "charAnim1": "anger2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は仕事の帰りだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010040,
    "speaker": "あさひ",
    "text": "なーんだ、そうだったんすね！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "それよりも、あさひが何をしてたか気になるんだが……",
    "charAnim2": "face_wait",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010050,
    "speaker": "あさひ",
    "text": "わたしっすか？\r\nわたしは何か楽しいことがないか探してたんすよ！",
    "charAnim1": "smile2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010050"
  },
  {
    "id": 2017003010060,
    "speaker": "あさひ",
    "text": "それで、公園にマジシャンがいるって聞いたんで\r\n行こうと思ってたんす！",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "それで色々な人に話を聞いたりしてたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010070,
    "speaker": "あさひ",
    "text": "はいっす！　楽しいこと探しの基本は\r\n情報を集めるところからなんす！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かにそれで、楽しいことは見つかるかもしれないが\r\nあまり知らない人に話しかけたらダメだぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010080,
    "speaker": "あさひ",
    "text": "？　どういうことっすか？",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "世の中は良い人ばかりじゃないからな\r\n危ない目に遭わないとも限らないんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010090,
    "speaker": "あさひ",
    "text": "あはは、何言ってるんすか、プロデューサーさん\r\n今までそんなことなかったっすよ～？",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "それはあさひの運がよかったからだ\r\n何かあってからじゃ、遅いんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010100,
    "speaker": "あさひ",
    "text": "うーん……わかったっす～",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく……\r\nそれで、今からマジシャンを探しに行くんだよな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017003010110,
    "speaker": "あさひ",
    "text": "そうっす！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700301/2017003010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺もついていこう\r\nあさひひとりじゃちょっと不安だしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
