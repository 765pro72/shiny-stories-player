  },
  {
    "id": 6023003100040,
    "speaker": "雛菜",
    "text": "ステージも楽しかったし～、\r\nトレーナーさんとの練習も、夜の海で練習したのとかも",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
