  {
    "speaker": "美琴の父",
    "text": "──おかえりなさい、美琴",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "美琴の父",
    "text": "ずいぶん久しぶりだね\r\n前にコンサートを見に行った時以来かな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020080,
    "speaker": "美琴",
    "text": "……うん\r\nそうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020080"
  },
  {
    "speaker": "美琴の母",
    "text": "具合は大丈夫なの？\r\n美琴が戻ってくるなんてよっぽどなんでしょう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020090,
    "speaker": "美琴",
    "text": "ううん\r\n少し咳が出るだけ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020090"
  },
  {
    "textFrame": "off",
    "bg": "00225",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "美琴の母",
    "text": "そうなの？\r\nそういえば昔も少し咳を拗らせたことがあったね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "美琴の母",
    "text": "すごく小さい頃だけど",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020100,
    "speaker": "美琴",
    "text": "……そうだった？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020100"
  },
  {
    "speaker": "美琴の母",
    "text": "うん、寒暖差のせいだって\r\nしばらくして良くなってからはちっとも出なかったけど",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020110,
    "speaker": "美琴",
    "text": "…………\r\nそうなんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020110"
  },
  {
    "textFrame": "off",
    "bg": "00508",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "美琴の父",
    "text": "そういえば美琴は新しい家になってから\r\n初めて来るんじゃないか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020120,
    "speaker": "美琴",
    "text": "え……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020120"
  },
  {
    "speaker": "美琴の母",
    "text": "そうよ、お家建て替えるって言った時も\r\n戻ってこなかったから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "美琴の母",
    "text": "いくつか荷物も送ったでしょ？\r\n美琴の部屋を片付けた時に捨てないでって言ってた物",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020130,
    "speaker": "美琴",
    "text": "ああ……うん\r\nそうだったかも",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020130"
  },
  {
    "speaker": "美琴の母",
    "text": "もう……\r\n綺麗になったから楽しみにしてて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1025003020140,
    "speaker": "美琴",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500302/1025003020140"
  },
