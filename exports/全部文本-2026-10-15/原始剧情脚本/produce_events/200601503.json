  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶、咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030030,
    "speaker": "咲耶",
    "text": "……？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "無理しなくていいぞ\r\n眠かったら寝てほしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030040,
    "speaker": "咲耶",
    "text": "……フフ",
    "charAnim1": "anger1",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030040"
  },
  {
    "id": 2006015030050,
    "speaker": "咲耶",
    "text": "つれないことを言わないでほしいな、プロデューサー",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030050"
  },
  {
    "id": 2006015030060,
    "speaker": "咲耶",
    "text": "……私が、起きていたいんだよ……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030070,
    "speaker": "咲耶",
    "text": "ああ……",
    "charAnim1": "smile2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030070"
  },
  {
    "id": 2006015030080,
    "speaker": "咲耶",
    "text": "今日はたくさん予定があって……\r\n……私がそうだったということは、アナタだって同じで……",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030080"
  },
  {
    "id": 2006015030090,
    "speaker": "咲耶",
    "text": "私たちは……一緒に……\r\n今日の仕事を乗り越えた……",
    "charAnim1": "wait2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030090"
  },
  {
    "id": 2006015030100,
    "speaker": "咲耶",
    "text": "それなのに……\r\n私だけ眠ってしまっては……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ほら、やっぱり",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶が起きていたいんじゃなくて\r\n俺を気遣おうとしてくれてるだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030110,
    "speaker": "咲耶",
    "text": "ううん……",
    "charAnim2": "face_shy2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030110"
  },
  {
    "id": 2006015030120,
    "speaker": "咲耶",
    "text": "……違うんだ、アナタとの時間が惜しい……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030120"
  },
  {
    "id": 2006015030130,
    "speaker": "咲耶",
    "text": "起きていられるなら、その方が────",
    "charAnim1": "anger2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……じゃあ、ちょっと意地悪言おうかなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030140,
    "speaker": "咲耶",
    "text": "……？",
    "charAnim1": "sad2",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "運転中、乗ってる人に起きててほしいって思う\r\nドライバーの他に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030150,
    "speaker": "咲耶",
    "text": "ああ……",
    "charAnim2": "face_shy3",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分の運転で寝てもらえるなら嬉しいって思う\r\nドライバーもいるって言うよなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030160,
    "speaker": "咲耶",
    "text": "……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charAnim3": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "安心してもらえてる感じがするとか、\r\n運転が上手いって言ってもらえてる感じがするとか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういう理由でさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030170,
    "speaker": "咲耶",
    "text": "……プロデューサーは……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、どっちだと思う？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030180,
    "speaker": "咲耶",
    "text": "……",
    "charAnim1": "wink",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030180"
  },
  {
    "id": 2006015030190,
    "speaker": "咲耶",
    "text": "……本当は違っていても……\r\n今は……後者だって……言うと思う……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030190"
  },
  {
    "speaker": "プロデューサー",
    "text": "っふふ、そうか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そこまでわかってるなら、\r\n甘えてくれると嬉しいんだけどなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015030200,
    "speaker": "咲耶",
    "text": "ずるい人だ……──",
    "charAnim1": "smile1",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030200"
  },
  {
    "id": 2006015030210,
    "speaker": "咲耶",
    "text": "私はこんなに、抗おうとしているのに……",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601503/2006015030210"
