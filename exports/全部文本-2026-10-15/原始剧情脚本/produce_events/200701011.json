  },
  {
    "speaker": "プロデューサー",
    "text": "ぶっ……！",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110130,
    "speaker": "結華",
    "text": "あっ、ウケた！　じゃあこれだ！\r\nこれに決定～",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、もー……！　なんで宇宙……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110140,
    "speaker": "結華",
    "text": "ふふふ～！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110140"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──よし！\r\nじゃあここからは真面目にやってくぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110150,
    "speaker": "結華",
    "text": "はーい",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "まず、ひとつ動画を見てほしいんだ\r\n今URL送るから──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
