  {
    "id": 2007010110160,
    "speaker": "結華",
    "text": "それでねー、その好きな小説がさ、\r\n文庫化の記念にって、雑誌にだけ番外編を載せてたんだよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "bgm": "056",
    "voice": "produce_events/200701011/2007010110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110170,
    "speaker": "結華",
    "text": "三峰、文庫になってしばらくしてから読んだからさ、\r\n雑誌の方知らなくて、読めてなかったの",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110170"
  },
  {
    "id": 2007010110180,
    "speaker": "結華",
    "text": "あああもっと早く知ってたら──！\r\nって、すごく悔しかったんだけど",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110180"
  },
  {
    "id": 2007010110190,
    "speaker": "結華",
    "text": "──でもよく考えたら、\r\n大学の図書館にバックナンバーあるなと思って",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、確かに！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "無事読めたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110200,
    "speaker": "結華",
    "text": "うん！\r\nあんなに大学に感謝したのは初めてだね",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、こらこら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110210,
    "speaker": "結華",
    "text": "ふふ……！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110210"
  },
  {
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2007010110220,
    "speaker": "結華",
    "text": "ねぇプロデューサー、楽しいねぇ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110230,
    "speaker": "結華",
    "text": "……でも、そろそろ時間かねぇ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110230"
  },
  {
    "id": 2007010110240,
    "speaker": "結華",
    "text": "三峰の背景のせいで全然ピンとこないと思うけど！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、そうだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、この辺で終わりにしとくか",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007010110250,
    "speaker": "結華",
    "text": "──うん",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110250"
  },
  {
    "id": 2007010110260,
    "speaker": "結華",
    "text": "またね、プロデューサー",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701011/2007010110260"
  },
  {
