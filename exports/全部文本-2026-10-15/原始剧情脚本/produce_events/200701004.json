    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701004/2007010040020"
  },
  {
    "id": 2007010040030,
    "speaker": "結華",
    "text": "──でもそれ、\r\nヒロインちゃんに対しても言ってませんか～？",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701004/2007010040030"
  },
  {
    "speaker": "ドラマのスタッフ",
    "text": "ええっ、言ってませんよ！\r\n一番は三峰さんです、信じてください！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2007010040040,
    "speaker": "結華",
