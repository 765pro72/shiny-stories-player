    "voice": "produce_events/201000704/2010007040070"
  },
  {
    "id": 2010007040080,
    "speaker": "智代子",
    "text": "それから──ふたりとも？　３時のおやつには\r\nこの黒猫印のお菓子をよろしくね！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
