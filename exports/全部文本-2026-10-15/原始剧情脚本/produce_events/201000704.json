  {
    "id": 2010007040020,
    "speaker": "智代子",
    "text": "お菓子いっぱいあるから、焦らなくても大丈夫だよ\r\nどれがいい？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000704/2010007040020"
  },
  {
    "id": 2010007040030,
    "speaker": "智代子",
    "text": "クッキーとキャンディとマシュマロと──",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000704/2010007040030"
  },
  {
    "speaker": "男の子＆女の子",
    "text": "チョコ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2010007040040,
    "speaker": "智代子",
    "text": "んんーっ……！\r\nチョコアイドル冥利に尽きる……！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000704/2010007040040"
  },
  {
    "id": 2010007040050,
    "speaker": "智代子",
    "text": "おっけー！　そしたら──はい！\r\nカボチャとお化けのチョコをプレゼント～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000704/2010007040050"
  },
  {
    "speaker": "男の子＆女の子",
    "text": "わぁ……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2010007040060,
    "speaker": "智代子",
    "text": "仲良く食べてね！\r\n──ふたりが一年、元気に過ごせますように！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000704/2010007040060"
  },
  {
    "speaker": "男の子",
    "text": "ありがとうチョコちゃん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女の子",
    "text": "ありがとう！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2010007040070,
    "speaker": "智代子",
    "text": "どういたしまして！",
