    "voice": "produce_events/201100904/2011009040080"
  },
  {
    "id": 2011009040090,
    "speaker": "樹里",
    "text": "──けど、どのお守りがいいんだろうな……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100904/2011009040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "樹里の願いがこもったものなら\r\nどれでもいいと思うぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011009040100,
    "speaker": "樹里",
    "text": "そうかぁ……？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
