    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "──あ、今日現場で先生に会ったよ、ダンスの\r\nいい調子だってな！　ここのところ立ち会えなくてすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1012003020290,
    "speaker": "凛世",
    "text": "い、いえ……\r\nとんでもございません……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charAnim3": "no",
    "charAnim3Loop": false,
