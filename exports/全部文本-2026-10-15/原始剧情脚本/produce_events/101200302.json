    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1012003020040,
    "speaker": "凛世",
    "text": "──\r\n『あ』……",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020040"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "あははっ！　もうー\r\nそっちの役じゃないでしょー！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
