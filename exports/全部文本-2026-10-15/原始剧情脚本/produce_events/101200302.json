  {
    "speaker": "ダンストレーナー",
    "text": "みーぎ、ひだり\r\nトトトン、パパパン！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0167"
  },
  {
    "id": 1012003020010,
    "speaker": "凛世",
    "text": "みーぎ……ひだり……\r\nとととん……ぱぱぱん……",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0167",
    "voice": "produce_events/101200302/1012003020010"
  },
  {
    "speaker": "ダンストレーナー",
    "text": "──オーケーいい感じ！\r\n今日はここまでかなー！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1012003020020,
    "speaker": "凛世",
    "text": "＿りがとうございます……\r\n来週もよろしく……お願いいたします……",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
