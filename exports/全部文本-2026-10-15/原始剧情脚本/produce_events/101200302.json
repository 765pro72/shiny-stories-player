  {
    "id": 1012003020050,
    "speaker": "凛世＆ダンストレーナー",
    "text": "ふふっ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020050"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 1012003020060,
    "speaker": "凛世",
    "text": "『あ』……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020060"
  },
  {
    "textFrame": "off",
    "waitType": "time",
