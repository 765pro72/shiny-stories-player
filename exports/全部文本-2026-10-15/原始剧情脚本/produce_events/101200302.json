  },
  {
    "id": 1012003020220,
    "speaker": "凛世",
    "text": "……\r\n『あ』……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
