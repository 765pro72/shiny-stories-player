  },
  {
    "textFrame": "off",
    "bg": "00318",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1012003020070,
    "speaker": "凛世",
    "text": "彼女は、博士のことを\r\nとてもとても愛していた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020070"
  },
  {
    "id": 1012003020080,
    "speaker": "凛世",
    "text": "それはまだ\r\n彼女が《ふたり》になってしまう前のこと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020080"
  },
  {
    "id": 1012003020090,
    "speaker": "凛世",
    "text": "身寄りのない自分を\r\n博士は下働きとして拾ってくれた",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/101200302/1012003020090"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "bg": "00014",
