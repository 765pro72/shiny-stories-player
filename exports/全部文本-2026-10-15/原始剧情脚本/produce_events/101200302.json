    "voice": "produce_events/101200302/1012003020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、おかえり\r\n──今の『ただいま』だろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1012003020230,
    "speaker": "凛世",
    "text": "『あ』……！",
    "charAnim1": "wait3",
