    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1012003020260,
    "speaker": "凛世",
    "text": "薄暗く狭い施設と\r\n湿気た住み込み部屋しか知らない彼女にとって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020260"
  },
  {
    "textFrame": "off",
    "bg": "00002",
