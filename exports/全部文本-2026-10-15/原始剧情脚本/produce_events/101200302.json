  },
  {
    "id": 1012003020240,
    "speaker": "凛世",
    "text": "時折台所にやってきては、\r\n博士は彼女にいろんな話を聞かせた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020240"
  },
  {
    "id": 1012003020250,
    "speaker": "凛世",
    "text": "街の噂話、科学の話、\r\n海の向こうの話……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020250"
  },
  {
    "textFrame": "off",
    "bg": "00002",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "はははっ、それは『はい』かな\r\nよーし、わかるぞ！",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
