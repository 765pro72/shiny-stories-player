    "waitTime": 2500
  },
  {
    "textFrame": "off",
    "se": "0121",
    "waitType": "time",
    "waitTime": 1850
  },
  {
    "speaker": "ダンストレーナー",
    "text": "それじゃーもう一回！\r\nみーぎ、ひだり──！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1012003020100,
    "speaker": "凛世",
    "text": "みーぎ……ひだり……──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020100"
  },
  {
    "textFrame": "off",
    "bg": "00318",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1012003020110,
    "speaker": "凛世",
    "text": "もちろん、身分も将来もある彼に\r\n自分などが釣り合うわけもない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020110"
  },
  {
    "id": 1012003020120,
    "speaker": "凛世",
    "text": "せめて恩に報いようと\r\n彼女は心を尽くして奉公した",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020120"
  },
  {
    "id": 1012003020130,
    "speaker": "凛世",
    "text": "博士のためならば、\r\n博士の役に立つならば────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101200302/1012003020130"
  },
  {
    "textFrame": "off",
    "bg": "00014",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "ダンストレーナー",
    "text": "──ふふふっ\r\nなんかほんとに、AIとかアンドロイドとかそういうのみたい",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1012003020140,
    "speaker": "凛世",
    "text": "……？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
