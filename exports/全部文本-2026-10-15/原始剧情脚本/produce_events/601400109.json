    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601400109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601400109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601400109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601400109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601400109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601400109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "bgEffect": "fade",
    "bg": "00002",
    "waitType": "effect",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "お疲れ！　甘奈、優勝本当におめでとう！",
    "charAnim1": "wait",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "014",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 6014001090030,
    "speaker": "甘奈",
    "text": "……あのね、プロデューサーさん",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　どうしたんだ？",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090040,
    "speaker": "甘奈",
    "text": "今、ちょっといいかな？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ、大丈夫だ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090050,
    "speaker": "甘奈",
    "text": "甘奈ね、甜花ちゃんのかわいさをみんなに\r\n知って欲しいからアイドル始めたじゃん？",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "オーディションのとき、そう言っていたな",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090060,
    "speaker": "甘奈",
    "text": "でね……これは今まで内緒にしてたけど……ホントはね",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090060"
  },
  {
    "id": 6014001090070,
    "speaker": "甘奈",
    "text": "甘奈、アイドルを始めても、ちゃんとできるなんて\r\n思ってなかった……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090070"
  },
  {
    "id": 6014001090080,
    "speaker": "甘奈",
    "text": "甘奈自身がアイドルになりたい\r\nってわけじゃなかったんだよね……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……薄々、気づいていたよ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "日々の仕事は楽しそうだったが……\r\n楽しい放課後、みたいなところがあった",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090090,
    "speaker": "甘奈",
    "text": "さすがプロデューサーさん\r\nなんでもお見通しって感じだね",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090090"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも……甘奈は今、違う気持ちでアイドルしてるよな",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090100,
    "speaker": "甘奈",
    "text": "うん。今はアイドルになって良かったって、\r\n心の底から思ってるんだよ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090100"
  },
  {
    "id": 6014001090110,
    "speaker": "甘奈",
    "text": "アイドルになったから、成長できたと思うんだ\r\n甜花ちゃんも一緒にね",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090110"
  },
  {
    "id": 6014001090120,
    "speaker": "甘奈",
    "text": "こうして甘奈が甜花ちゃんと一緒にいられるのも、\r\nプロデューサーさんがアイドルにしてくれたからだよ",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090120"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺はプロデューサーとしてのサポートしかしていないよ\r\n成長できたのは、甘奈が努力したからだ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090130,
    "speaker": "甘奈",
    "text": "えへへ、ありがとう",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090130"
  },
  {
    "id": 6014001090140,
    "speaker": "甘奈",
    "text": "あ、そうそう！　あとね、最近\r\n甜花ちゃんのかわいさが伝わるようになってきたでしょ？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、甜花も人気が出てきたもんな",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090150,
    "speaker": "甘奈",
    "text": "でもね、\r\n甜花ちゃんの魅力はまだまだこんなもんじゃないんだー",
    "charAnim1": "shy1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090150"
  },
  {
    "id": 6014001090160,
    "speaker": "甘奈",
    "text": "そのことを……１番知っていたのは甘奈のはずなのに、\r\nうっかり忘れてた時期があったみたい",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090160"
  },
  {
    "id": 6014001090170,
    "speaker": "甘奈",
    "text": "それでね、甘奈……\r\n甜花ちゃんに負けたくなくなっちゃったんだ",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈、\r\n……その気持ち、大切にしよう",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈と甜花が切磋琢磨していけば、\r\n双子座よりも輝けるアイドルになれるさ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090180,
    "speaker": "甘奈",
    "text": "双子座より輝くアイドルかぁ……！\r\nえへ、甘奈と甜花ちゃんにぴったりかも",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090180"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからのふたりの努力次第だぞ\r\nがんばっていこうな！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090190,
    "speaker": "甘奈",
    "text": "もち！　がんばるよー",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090190"
  },
  {
    "id": 6014001090200,
    "speaker": "甘奈",
    "text": "えへへ……プロデューサーさんは、\r\n甘奈と甜花ちゃんのこと、ずっと傍で見てきてくれたよね",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090200"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ、そりゃあプロデューサーだからな！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6014001090210,
    "speaker": "甘奈",
    "text": "改めて言うの、\r\nちょっと照れちゃうけど……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090210"
  },
  {
    "id": 6014001090220,
    "speaker": "甘奈",
    "text": "これからも、甘奈たちのこと\r\n……よろしくお願いします",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400109/6014001090220"
  },
  {
    "label": "end"
  }
]