    "waitType": "time",
    "waitTime": 5000
  },
  {
    "id": 2001011030050,
    "speaker": "真乃",
    "text": "──ほわ……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030050"
  },
  {
    "textFrame": "off",
    "bg": "00144",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nどうしたんだ、真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030060,
    "speaker": "真乃",
    "text": "あ……\r\nえっと、その……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
