    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、こんなに晴れてるのにそれはないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030020,
    "speaker": "真乃",
    "text": "ほわ……\r\n……そうですね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030020"
  },
  {
    "id": 2001011030030,
    "speaker": "真乃",
    "text": "お天気、とってもいいです……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、太陽も高くなってきて暑いくらいだ──\r\n……撮影、午前中に終わってよかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030040,
    "speaker": "真乃",
    "text": "ふふ……はい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030040"
  },
  {
    "textFrame": "off"
  },
  {
