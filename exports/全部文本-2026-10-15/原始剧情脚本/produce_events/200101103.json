      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101103/2001011030060"
  },
  {
    "id": 2001011030070,
    "speaker": "真乃",
    "text": "……私も、少しポツってきたような気がして──",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、真乃もか……\r\nやっぱり通り雨でも降るのか──？",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
