    "waitTime": 4000
  },
  {
    "id": 2001011030080,
    "speaker": "真乃",
    "text": "……あっ、プロデューサーさん\r\n見てください……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101103/2001011030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん……お、おお！\r\nここ、仕掛け噴水があったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっきの『雨』の正体はこれだったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030090,
    "speaker": "真乃",
    "text": "はい、そうみたいです……っ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030090"
  },
  {
    "id": 2001011030100,
    "speaker": "真乃",
    "text": "……ふふ、遊んでる子たちもたくさん\r\nとっても楽しそうです……",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──よし！\r\n俺もちょっとだけ遊んでいこうかな！",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030110,
    "speaker": "真乃",
    "text": "……！　ぷ、プロデューサーさん……\r\nで、でも──",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "この後、急ぎの予定も無いし、\r\nちょっとくらい寄り道したって大丈夫",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textFrame": "off",
    "se": "0329",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "今日の俺は準備万端だからな……\r\nほら──タオル！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030120,
    "speaker": "真乃",
    "text": "ほわ……っ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030120"
  },
  {
    "id": 2001011030130,
    "speaker": "真乃",
    "text": "……ふふ\r\nそうだったんですね……",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、おう！　……真乃も一緒にどうだ？\r\nきっと涼しくて気持ちいいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030140,
    "speaker": "真乃",
    "text": "わ、私、ですか……っ",
    "charAnim1": "shy1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030140"
  },
  {
    "id": 2001011030150,
    "speaker": "真乃",
    "text": "……い、いいんでしょうか……\r\nその……高校生にもなって……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　うん、いいんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……いくつだったとしてもさ、\r\nやっちゃいけないなんてこときっとなくて",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "やりたいって思ったり、考えてること\r\n大事にしたっていいって、俺はそう思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030160,
    "speaker": "真乃",
    "text": "プロデューサーさん……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101103/2001011030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……いや、でもこれは俺の考えだから\r\n無理に付き合わせたいわけじゃなくて──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011030170,
    "speaker": "真乃",
    "text": "い、いえっ\r\n……私も、私も水遊び……したいです……っ",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
