      "time": 100
    },
    "voice": "produce_events/200101103/2001011030010"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、いや……\r\nなんかポツってきたような気がしてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "雨でも降るのかなって──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
