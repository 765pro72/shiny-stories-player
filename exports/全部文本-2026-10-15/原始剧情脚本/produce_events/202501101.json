    "textFrame": "001",
    "voice": "produce_events/202501101/2025011010070"
  },
  {
    "id": 2025011010080,
    "speaker": "美琴",
    "text": "ごめんね、結婚式行けなくて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501101/2025011010080"
  },
  {
    "speaker": "友人",
    "text": "『あー、いいっていいって！\r\n全然ダメ元だったからー！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "友人",
    "text": "『……っていうか、今電話大丈夫？\r\n移動中とか？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2025011010090,
    "speaker": "美琴",
    "text": "大丈夫\r\n久しぶりに声を聞けて嬉しい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501101/2025011010090"
  },
  {
    "speaker": "友人",
    "text": "『ほんと？　よかったー』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "友人",
    "text": "『いや、実はさ……\r\nちょっとお願いしたいことがあって────』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "友人",
    "text": "『無理そうなら全然断ってもらっていいんだけど、\r\n結婚式用のメッセージとか、もらえたり……するかなぁ？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
