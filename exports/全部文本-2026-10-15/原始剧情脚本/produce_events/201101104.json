  {
    "id": 2011011040020,
    "speaker": "樹里",
    "text": "──よし",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
