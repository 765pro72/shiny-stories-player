  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、どうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004002020020,
    "speaker": "恋鐘",
    "text": "ん～\r\nプロデューサー",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400202/1004002020020"
  },
  {
    "id": 1004002020030,
    "speaker": "恋鐘",
    "text": "また、海……\r\n行きたか～",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400202/1004002020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "海？　……川じゃダメか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004002020040,
    "speaker": "恋鐘",
    "text": "う～み～！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400202/1004002020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなに都合よく海の仕事なんてないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004002020050,
    "speaker": "恋鐘",
    "text": "し……仕事でなくても……\r\nよかとやけど……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_shy",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400202/1004002020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "何言ってるんだ\r\n多忙な恋鐘さんは、スケジュールを見てくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004002020060,
    "speaker": "恋鐘",
    "text": "い、忙しかけど\r\nがんばっとるもん～！",
    "charAnim1": "smile4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400202/1004002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、知ってる\r\n──恋鐘は、すごく頑張ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "集まるのだって難しいくらい、\r\n恋鐘も、みんなも……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
