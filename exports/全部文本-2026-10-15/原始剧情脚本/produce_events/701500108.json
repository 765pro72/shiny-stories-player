  {
    "speaker": "プロデューサー",
    "text": "甜花……あのな、最終審査なんだが……\r\n落選だったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001080010,
    "speaker": "甜花",
    "text": "……え……不合格……\r\n……そ、そんな……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
