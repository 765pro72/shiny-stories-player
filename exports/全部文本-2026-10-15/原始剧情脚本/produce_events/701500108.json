    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500108/7015001080020"
  },
  {
    "id": 7015001080030,
    "speaker": "甜花",
    "text": "あの……こんなこと思っていいのか、わかんないけど……\r\nでも……やっぱり悔しい……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701500108/7015001080030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……甜花は成長したな",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7015001080040,
    "speaker": "甜花",
    "text": "え……どうして……？\r\n甜花……予選、落ちたのに……",
