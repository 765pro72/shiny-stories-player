    "waitTime": 1000
  },
  {
    "speaker": "SNSの投稿",
    "text": "『みんな若くない？』\r\n『今も若いじゃん～？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの投稿",
    "text": "『二重サプライズした回ね！\r\n面白かったなー先生の動揺っぷりとか』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
