    "waitTime": 1000
  },
  {
    "speaker": "SNSの投稿",
    "text": "『この頃果穂ちゃん小６だし若いのはそう　物理』\r\n『小学生！？！？　なんですか！？！？？！　は？？！？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
