  },
  {
    "textFrame": "off",
    "se": "0280",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "SNSの投稿",
    "text": "『インパクトあったもん、今でも小学生に見ちゃう時ある。\r\nそしてふとした時に『大人になったなぁ』ってなる。』",
    "textCtrl": "p",
    "textFrame": "003"
