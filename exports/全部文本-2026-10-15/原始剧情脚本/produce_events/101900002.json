  },
  {
    "speaker": "プロデューサー",
    "text": "？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019001010040,
    "speaker": "？？？",
    "text": "かばんの中身、めっちゃ落ちてるけど？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900002/1019001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ！　本当だ……\r\n片づけないとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019001010050,
    "speaker": "？？？",
    "text": "これもお兄さんの？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900002/1019001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、それも俺のだ\r\n手伝ってくれてありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019001010060,
    "speaker": "？？？",
    "text": "いーって、いーって！\r\n困った時はなんとかっていうじゃん？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile2",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900002/1019001010060"
  },
  {
    "id": 1019001010070,
    "speaker": "？？？",
    "text": "でも、お兄さん\r\nあんましぼーっとしてたらダメっしょ～？",
