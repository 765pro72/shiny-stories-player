  },
  {
    "speaker": "プロデューサー",
    "text": "ごめん！　君、ケガはない？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019001010020,
    "speaker": "？？？",
    "text": "そんなに慌てなくていーよ\r\nうちは全然へーき",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
