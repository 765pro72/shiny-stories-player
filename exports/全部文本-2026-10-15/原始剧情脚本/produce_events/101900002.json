    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900002/1019001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "それなら、よかったよ\r\nけど、本当にごめん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019001010030,
    "speaker": "？？？",
    "text": "ちょ、そんな謝んなくていーって\r\nつか、それよかそっちの方がヤバくない？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
