    "voice": "produce_events/201400502/2014005020020"
  },
  {
    "id": 2014005020021,
    "speaker": "甘奈",
    "text": "——あっ！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400502/2014005020021"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、どうした？",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014005020030,
    "speaker": "甘奈",
    "text": "あれ、甜花ちゃんだよ、プロデューサーさん……！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400502/2014005020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、甜花……？",
    "charAnim2": "face_smile2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "おぉ！　甜花と……それから甘奈のポスターか！\r\nこの間作ってもらったものだな",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLabel": "amana",
