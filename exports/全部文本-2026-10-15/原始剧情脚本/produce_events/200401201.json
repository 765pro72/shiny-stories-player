    "voice": "produce_events/200401201/2004012010270"
  },
  {
    "id": 2004012010280,
    "speaker": "恋鐘",
    "text": "プロデューサーが背中ば押してくれたけん、\r\nこがんまるまるしたさんまの手に入ったばい……！",
    "charAnim1": "smile3",
    "charAnim2": "face_smile",
