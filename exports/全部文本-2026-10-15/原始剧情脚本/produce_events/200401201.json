  },
  {
    "id": 2004012010320,
    "speaker": "恋鐘",
    "text": "うちもアンティーカのみんなと、\r\nプロデューサーが一緒やったら、なんでも楽しかけん！",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
