[
  {
    "speaker": "プロデューサー",
    "text": "千雪、心の準備は大丈夫か？",
    "charAnim1": "wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002",
