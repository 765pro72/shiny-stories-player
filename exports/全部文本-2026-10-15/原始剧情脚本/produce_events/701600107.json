      "order": 0
    },
    "bg": "00002",
    "bgm": "006"
  },
  {
    "id": 7016001070010,
    "speaker": "千雪",
    "text": "はい……すごくドキドキしていますけど……\r\nいつまでも、こうしているわけにもいきませんし",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070010"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな。それじゃあ、言うぞ",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070020,
    "speaker": "千雪",
    "text": "……！",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070020"
  },
  {
    "speaker": "プロデューサー",
    "text": "通過だ。『W.I.N.G.』に出られるぞ！\r\nやったな、千雪！",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070030,
    "speaker": "千雪",
    "text": "わぁ……プロデューサーさん……！\r\nありがとうございます",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070030"
  },
  {
    "id": 7016001070040,
    "speaker": "千雪",
    "text": "ファンのみなさんと、プロデューサーさんに、\r\n心から感謝します",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、随分、落ち着いてるみたいだな\r\nさすがの貫禄だ",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070050,
    "speaker": "千雪",
    "text": "い、いえ、すごく戸惑ってます\r\n本当のことかな……って",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070050",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "全然そうは見えないな",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070060,
    "speaker": "千雪",
    "text": "ふふ、それは多分……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070060"
  },
  {
    "id": 7016001070070,
    "speaker": "千雪",
    "text": "『W.I.N.G.』に出ることが\r\nアイドルの最終目的じゃないって、わかってるからです",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070070"
  },
  {
    "id": 7016001070080,
    "speaker": "千雪",
    "text": "アイドルは、人のためにいろんなことができるって\r\n私にも、人のためにいろんなことができるって",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070080"
  },
  {
    "id": 7016001070090,
    "speaker": "千雪",
    "text": "今日まで、たくさんたくさん、\r\n教わってきました",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070090"
  },
  {
    "id": 7016001070100,
    "speaker": "千雪",
    "text": "だから、これからも……\r\nやらなきゃいけないことは、同じなんです",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070100",
    "charAnim3Loop": false
  },
  {
    "id": 7016001070110,
    "speaker": "千雪",
    "text": "私はこの道を、選びましたから",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん。さすが千雪だな\r\n俺も……ひたすらサポートするのみだ",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070120,
    "speaker": "千雪",
    "text": "な、何かとても偉そうなことを\r\n言ってしまいましたけど……！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070120"
  },
  {
    "id": 7016001070130,
    "speaker": "千雪",
    "text": "そのことを言い訳にしたりはしませんから",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070130"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪……",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7016001070140,
    "speaker": "千雪",
    "text": "『W.I.N.G.』も勝ちます！\r\n頂けるものは、頂いちゃわないと……♪",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701600107/7016001070140"
  },
  {
    "id": 7016001070150,
    "speaker": "千雪",
    "text": "だから、これからもよろしくお願いします\r\nプロデューサーさん",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
