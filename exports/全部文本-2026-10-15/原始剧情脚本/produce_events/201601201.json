      "time": 100
    },
    "bgm": "006",
    "voice": "produce_events/201601201/2016012010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ\r\n千雪は饅頭も可愛がるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010080,
    "speaker": "千雪",
    "text": "だって、このちょっと丸くてぽてっとしたところとか\r\n可愛いと思いません？",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かに、ちょっと可愛いかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010090,
    "speaker": "千雪",
    "text": "ふふっ\r\nいただきます……！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いただきます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010100,
    "speaker": "千雪",
    "text": "あっ……プロデューサーさん、ほら",
