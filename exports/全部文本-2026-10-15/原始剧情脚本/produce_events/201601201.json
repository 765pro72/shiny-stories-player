    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "饅頭まで可愛がるとことかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010140,
