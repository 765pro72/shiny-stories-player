  {
    "id": 2016012010010,
    "speaker": "千雪",
    "text": "お茶、淹れますね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ？\r\nいいよ、今レッスンから帰ってきたばかりなのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010020,
    "speaker": "千雪",
    "text": "今日はダンスのキレがいいって\r\n先生に褒められちゃったんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010020"
  },
  {
    "id": 2016012010030,
    "speaker": "千雪",
    "text": "だから、絶好調なんですよ♪",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010030"
  },
  {
    "id": 2016012010040,
    "speaker": "千雪",
    "text": "それに、私も飲むので……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、絶好調な千雪にお願いしようかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010050,
    "speaker": "千雪",
    "text": "はい……！　ちょっと待っててくださいね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nそうだ、じゃあ、何かお茶請け……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00351",
    "bgEffect": "fade",
    "bgEffectTime": 2000,
    "waitType": "time",
    "waitTime": 3500
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……そうだなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪、温泉饅頭ともみじ饅頭、どっちがいい？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010060,
    "speaker": "千雪",
    "text": "もみじ饅頭……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、わかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
