    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010100"
  },
  {
    "id": 2016012010110,
    "speaker": "千雪",
    "text": "ほら、窓の外も紅葉ですよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当だ……綺麗だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010120,
    "speaker": "千雪",
    "text": "紅葉を見ながらもみじ饅頭を食べるって\r\nなんかすごく贅沢な気分……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601201/2016012010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\nそんなこと、考えたこともなかったけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういう千雪の感性は大事にしないとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016012010130,
    "speaker": "千雪",
    "text": "私の感性……ですか……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
