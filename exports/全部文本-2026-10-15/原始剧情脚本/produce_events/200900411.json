[
  {
    "speaker": "プロデューサー",
    "text": "（さて、果穂はどこに……？）",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00013",
    "bgm": "016"
  },
  {
    "id": 2009004110010,
    "speaker": "果穂",
    "text": "次はあたしがおにだねっ\r\nよーし……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040090010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200900411/2009004110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ああ、いたいた\r\n楽しそうに遊んでるな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110020,
    "speaker": "果穂",
    "text": "待て～！\r\n──あ、プロデューサーさんっ！",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110020"
  },
  {
    "id": 2009004110030,
    "speaker": "果穂",
    "text": "じゃあみんな、\r\nあたし、お仕事行ってくる！　またねー！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110030"
  },
  {
    "charLabel": "kaho",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0118",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2009004110040,
    "speaker": "果穂",
    "text": "おはようございますっ！\r\nあたし、今日も頑張りますっ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200900411/2009004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。でも時間に余裕はあるから\r\nまだ遊んでて大丈夫だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110050,
    "speaker": "果穂",
    "text": "いえ！\r\nプロデューサーさん、お仕事に行きましょうっ！",
    "charAnim1": "think",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　もっと友達と遊びたかったんじゃないのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110060,
    "speaker": "果穂",
    "text": "今日はもう、たくさん遊びましたっ！\r\n今は、お仕事がしたいです！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、それは良いな。いっぱい遊べて、仕事にも気合十分……\r\nうん、果穂らしいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "たくさん遊んだって言ってたけど、何をしてたんだ？",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110070,
    "speaker": "果穂",
    "text": "えっと、最初はジャングルジムに登りました！\r\nあたし、登るの速いんです！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "へえ、得意なんだな\r\n高いところは怖くないのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110080,
    "speaker": "果穂",
    "text": "はいっ。全然へっちゃらですっ！",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110080"
  },
  {
    "id": 2009004110090,
    "speaker": "果穂",
    "text": "あとは、おにごっこもしたんですけど……\r\n足が速い人に、すぐつかまっちゃいましたっ",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "（良かった。忙しくなっても、仕事の合間に\r\n友達と楽しく遊べているみたいだ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういえば、さっき果穂の友達のもちらっと見えたけど……\r\n今の小学生はランドセルがカラフルだよなあ",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お店にもたくさんの色が並んでるのをよく見かけるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110100,
    "speaker": "果穂",
    "text": "はい！　みんな、ランドセルの色がちがいますっ！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110100"
  },
  {
    "id": 2009004110110,
    "speaker": "果穂",
    "text": "自分の好きな色を、みんな選ぶんです！",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、それで果穂もそのランドセルを選んだんだな\r\nよく似合ってるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110120,
    "speaker": "果穂",
    "text": "ありがとうございます！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110120"
  },
  {
    "id": 2009004110130,
    "speaker": "果穂",
    "text": "お店には、ヒーローみたいに色んな色があって……",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110130"
  },
  {
    "id": 2009004110140,
    "speaker": "果穂",
    "text": "好きな色を選んで良いよってお父さんとお母さんに言われて\r\n……それであたし、この色を選んだんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか。すぐに黄色を選んだのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110150,
    "speaker": "果穂",
    "text": "いえ、赤もピンクもあって\r\nスッゴく悩んじゃいました……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110150"
  },
  {
    "id": 2009004110160,
    "speaker": "果穂",
    "text": "でも、ちょうど選びに行く日に観た『ジャスティスV』で\r\nジャスティスイエローがスッゴくスッゴくカッコよくて……",
    "charAnim2": "face_anger",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110160"
  },
  {
    "id": 2009004110170,
    "speaker": "果穂",
    "text": "──だから、黄色を選びましたっ！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ\r\n果穂らしい選び方だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、そのランドセルで大正解だったな",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110180,
    "speaker": "果穂",
    "text": "はいっ！\r\nあたし、このランドセルが大好きです！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110180"
  },
  {
    "textFrame": "off",
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
    },
    "waitType": "effect"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "kaho"
  },
  {
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "bg": "00001",
