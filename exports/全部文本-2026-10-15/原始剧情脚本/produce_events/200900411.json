      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "id": 2009004110190,
    "speaker": "果穂",
    "text": "さあプロデューサーさん、\r\nあたしたちの秘密基地に到着です！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、仕事も頑張ろうな\r\n本当に果穂は、いつでも気合十分だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110200,
    "speaker": "果穂",
    "text": "えへへっ\r\nあたし、もっともっとお仕事頑張りたいです",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110200"
  },
  {
    "id": 2009004110210,
    "speaker": "果穂",
    "text": "『W.I.N.G.』で優勝できた時、スッゴくうれしかったです\r\nでも、それで終わりじゃありません！",
    "charAnim2": "face_serious",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110210"
  },
  {
    "id": 2009004110220,
    "speaker": "果穂",
    "text": "もっとカッコよくなって、\r\nみんなをもっと笑顔にするって決めましたから！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110220"
  },
  {
    "id": 2009004110230,
    "speaker": "果穂",
    "text": "正義の味方は、ずっと成長していくもの！\r\n立ち止まってちゃいけませんっ",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、その意気だ！\r\n本当に果穂は頼もしくなったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110240,
    "speaker": "果穂",
    "text": "えへへ……\r\nプロデューサーさんのおかげです！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110240"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、俺の……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110250,
    "speaker": "果穂",
    "text": "はい！　プロデューサーさんがいるから、\r\nあたしは立ち止まらずに進めるんです！",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110250"
  },
  {
    "id": 2009004110260,
    "speaker": "果穂",
    "text": "プロデューサーさんとなら、\r\nもっともっとスッゴいアイドルになれるって思います！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110260"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂……そんなふうに思ってくれてたのか\r\n……なんだか、俺もやる気がみなぎってきたぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし！\r\nまずは今日の仕事、一緒に頑張ろう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004110270,
    "speaker": "果穂",
    "text": "プロデューサーさんと、このランドセルと一緒に……\r\n今日もいーっぱい、頑張ります！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110270"
  },
  {
    "id": 2009004110280,
    "speaker": "果穂",
    "text": "ヒーローアイドル小宮果穂、出動です！\r\nえへへっ",
    "charAnim1": "hero",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900411/2009004110280"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]