      "time": 100
    },
    "voice": "produce_events/202800603/2028006030060"
  },
  {
    "speaker": "友人",
    "text": "そうなんだ？　\r\n雑なアイディア出しでいいなら手伝うけど──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2028006030070,
    "speaker": "はるき",
