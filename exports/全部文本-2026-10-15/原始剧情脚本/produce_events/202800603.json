  {
    "id": 2028006030050,
    "speaker": "はるき",
    "text": "おかげで課題の必要点数足りそう\r\n付き合ってくれてありがとね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202800603/2028006030050"
  },
  {
    "speaker": "友人",
    "text": "いいよ、別に\r\n私もよく協力してもらってるし",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "textFrame": "off",
    "bg": "00349",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "友人",
    "text": "あんた、描くときいつもすっごい集中してるのに\r\n他のこと考えるなんて珍しいね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2028006030060,
    "speaker": "はるき",
    "text": "うん……アイディアがね……\r\nいくつも出してはいるんだけどしっくりくるのがなくて……",
