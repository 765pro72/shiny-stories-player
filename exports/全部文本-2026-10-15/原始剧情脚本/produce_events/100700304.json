    "textFrame": "001",
    "voice": "produce_events/100700304/1007003040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "申し訳ない……！\r\n強硬手段しかないと思って……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007003040130,
    "speaker": "結華",
