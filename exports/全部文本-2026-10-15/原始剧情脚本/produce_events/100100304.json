  {
    "id": 1001003040010,
    "speaker": "真乃",
    "text": "──みなさんこんにちは……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
