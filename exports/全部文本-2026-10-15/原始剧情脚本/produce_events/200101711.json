  },
  {
    "id": 2001017110070,
    "speaker": "真乃",
    "text": "『あ、あの……メッセ……っ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110070"
  },
  {
    "id": 2001017110080,
    "speaker": "真乃",
    "text": "『メッセージを、ありがとうございました……っ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110080"
  },
  {
    "id": 2001017110090,
    "speaker": "真乃",
    "text": "『リアルタイム……でしたよね……？\r\nお時間を割いていただいて……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは\r\n俺は楽しく見てただけだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに今日は事務所で仕事だったしさ\r\n何も大変なこととかはなかったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、そんなに恐縮しないでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001017110100,
    "speaker": "真乃",
    "text": "『……はい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……──あ\r\nそうだ、今ってカメラつけられる場所か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001017110110,
    "speaker": "真乃",
    "text": "『……？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "よかったら、直接言わせてほしいんだ\r\n感想",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001017110120,
    "speaker": "真乃",
    "text": "『ほわ……っ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101711/2001017110120"
  },
  {
    "id": 2001017110130,
