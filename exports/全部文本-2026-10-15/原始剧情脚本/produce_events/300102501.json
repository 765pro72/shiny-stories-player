    "voice": "produce_events/300102501/3001025010340"
  },
  {
    "id": 3001025010350,
    "speaker": "真乃",
    "text": "鳥さんの羽みたいな、ふわふわであったかいデザインの\r\nドレスがあったらいいな……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
