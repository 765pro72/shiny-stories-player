    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300102501/3001025010350"
  },
  {
    "id": 3001025010360,
    "speaker": "めぐる",
    "text": "『わぁ、それすっごくいいね！\r\n真乃が着てるところ見たいなー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300102501/3001025010360"
  },
  {
    "id": 3001025010370,
    "speaker": "灯織",
    "text": "『ふふ、真乃らしいね……\r\n自分だったらか……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300102501/3001025010370"
  },
  {
    "id": 3001025010380,
    "speaker": "灯織",
    "text": "『ウエディングドレスって、色々な型があるけど……\r\n私はシンプルなデザインがいいかも』",
