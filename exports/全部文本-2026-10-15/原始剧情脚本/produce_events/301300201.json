    "voice": "produce_events/301300201/3013002010010",
    "charCategory": "stand_fix"
  },
  {
    "id": 3013002010020,
    "speaker": "夏葉",
    "text": "そうね……私は色々な分野を学びたいから……\r\n経済、経営、会計……あと統計学なんかもやってるわ",
    "charAnim1": "think",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010020"
  },
  {
    "id": 3013002010030,
    "speaker": "智代子",
    "text": "む、難しそうってことだけはわかる……",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_surp",
    "charAnim3Loop": false,
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010030"
  },
  {
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kaho",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3013002010040,
    "speaker": "夏葉",
    "text": "……果穂？\r\nどうしたの？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010040"
  },
  {
    "id": 3013002010050,
    "speaker": "果穂",
    "text": "わわっ……夏葉さん、ちょこ先輩、ごめんなさいっ",
    "charAnim1": "shy1",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010050"
  },
  {
    "id": 3013002010060,
    "speaker": "果穂",
    "text": "む、難しそうなお話してると思って……\r\nじゃましちゃダメだって思ったんですけど……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010060"
  },
  {
    "id": 3013002010070,
    "speaker": "果穂",
    "text": "あたし、気になっちゃって……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010070"
  },
  {
    "id": 3013002010080,
    "speaker": "夏葉",
    "text": "ふふっ、別に大丈夫よ。気にすることはないわ果穂",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010080"
  },
  {
    "id": 3013002010090,
    "speaker": "智代子",
    "text": "おお～、夏葉ちゃん、なんだか大人の余裕って感じ\r\nこれが素敵な女性……！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010090"
  },
  {
    "id": 3013002010100,
    "speaker": "果穂",
    "text": "ホントですっ、夏葉さん、優しくってステキですっ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010100"
  },
  {
    "id": 3013002010110,
    "speaker": "智代子",
    "text": "どうしたら夏葉ちゃんみたいな余裕が出せるんだろ……\r\n夏葉ちゃん、心がけてることとか、ある？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010110"
  },
  {
    "id": 3013002010120,
    "speaker": "夏葉",
    "text": "別に、普通よ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010120"
  },
  {
    "id": 3013002010130,
    "speaker": "智代子",
    "text": "普通……！？　私の知ってる普通と違う……！",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_surp",
    "charAnim3Loop": false,
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010130"
  },
  {
    "id": 3013002010140,
    "speaker": "果穂",
    "text": "夏葉さんみたいになるのは、難しそうです……",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charAnim3": "no",
    "charLipAnim": "lip_anger",
    "charAnim3Loop": false,
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010140"
  },
  {
    "id": 3013002010150,
    "speaker": "智代子",
    "text": "……あ！　だったら、夏葉ちゃんの私生活を\r\n探ればいいのかな！？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010150"
  },
  {
    "id": 3013002010160,
    "speaker": "夏葉",
    "text": "特別なことはしてないわよ、みんなといるときと変わらず\r\nレッスンしたり、トレーニングしたりね",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010160"
  },
  {
    "id": 3013002010170,
    "speaker": "夏葉",
    "text": "他には……",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010170"
  },
  {
    "id": 3013002010180,
    "speaker": "智代子",
    "text": "……もしかして、忙しくって\r\nあんまりお休み取れてなかったりしない？",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010180"
  },
  {
    "id": 3013002010190,
    "speaker": "夏葉",
    "text": "そんなことはないわよ。ただ、常に予定を入れて\r\n色々と経験できるよう、意識はしてるわね",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010190"
  },
  {
    "id": 3013002010200,
    "speaker": "果穂",
    "text": "わぁー！\r\n夏葉さん、カッコいいですっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010200"
  },
  {
    "id": 3013002010210,
    "speaker": "智代子",
    "text": "夏葉ちゃんみたいにすごい人でも、\r\nそういうこと考えるんだね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010210"
  },
  {
    "id": 3013002010220,
    "speaker": "智代子",
    "text": "……いや、そういう夏葉ちゃんだからこそ、\r\nここまですごい人になれたのかな……？",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010220"
  },
  {
    "id": 3013002010230,
    "speaker": "智代子",
    "text": "自立した大人の女性、憧れちゃうなぁ……！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charAnim3Loop": false,
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010230"
  },
  {
    "id": 3013002010240,
    "speaker": "果穂",
    "text": "大人の……女性……\r\nはっ！　夏葉さんは、車の運転もできるんですか？！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010240"
  },
  {
    "id": 3013002010250,
    "speaker": "夏葉",
    "text": "ええ、できるわよ\r\n自分の車で走るのは楽しいし、いい気分転換になるわ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010250"
  },
  {
    "id": 3013002010260,
    "speaker": "果穂",
    "text": "スゴいです！　夏葉さんの運転、いつか見てみたいです！\r\nきっと、ドラマみたいにスゴい運転を……！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010260"
  },
  {
    "id": 3013002010270,
    "speaker": "智代子",
    "text": "しかも自分の車だもんね……！\r\n愛車ってヤツだよ、果穂……！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010270"
  },
  {
    "id": 3013002010280,
    "speaker": "果穂",
    "text": "あいしゃ……！？\r\nスゴすぎて想像できないです……！",
    "charAnim1": "surp1",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010280"
  },
  {
    "id": 3013002010290,
    "speaker": "智代子",
    "text": "大人の女性といえば、あとは……忙しいから、\r\nお風呂は朝にシャワーで手早く！　とか？",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300201/3013002010290"
  },
  {
    "id": 3013002010300,
    "speaker": "果穂",
    "text": "な、なるほど……それも大人っぽいです！",
