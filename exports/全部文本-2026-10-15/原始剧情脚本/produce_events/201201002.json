    "voice": "produce_events/201201002/2012010020360"
  },
  {
    "speaker": "プロデューサー",
    "text": "具合でも悪いのか？\r\nちょっと、ぼんやりしてるみたいだ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012010020370,
    "speaker": "凛世",
    "text": "……いえ……あの……──",
