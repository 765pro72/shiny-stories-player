  {
    "id": 3001019020440,
    "speaker": "めぐる",
    "text": "窓も意外と汚れてるねー！\r\nみるみる綺麗になって楽しくなっちゃう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020440"
  },
  {
    "id": 3001019020450,
    "speaker": "真乃",
    "text": "風が吹くと、小さな汚れも飛んでくるのかな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020450"
  },
  {
    "id": 3001019020460,
    "speaker": "灯織",
    "text": "かもしれないね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020460"
  },
  {
    "id": 3001019020470,
    "speaker": "灯織",
    "text": "今も、真乃が掃いたそばから落ち葉が降ってくるし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020470"
  },
  {
    "id": 3001019020480,
    "speaker": "めぐる",
    "text": "それはもう仕方ない！\r\n秋だもん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020480"
  },
  {
    "id": 3001019020490,
    "speaker": "真乃",
    "text": "ふふっ\r\nうん、そうだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020490"
  },
  {
    "id": 3001019020500,
    "speaker": "真乃",
    "text": "集められるだけ……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020500"
  },
  {
    "id": 3001019020510,
    "speaker": "めぐる",
    "text": "うんうん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020510"
  },
  {
    "id": 3001019020520,
    "speaker": "めぐる",
    "text": "あっそうだ\r\nベランダ中の落ち葉集めたら、お芋焼けるかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020520"
  },
  {
    "id": 3001019020530,
    "speaker": "灯織",
    "text": "さすがに無理だよ\r\n量が足りないし、場所もないし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020530"
  },
  {
    "id": 3001019020540,
    "speaker": "真乃",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020540"
  },
  {
    "id": 3001019020550,
    "speaker": "真乃",
    "text": "代わりに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020550"
  },
  {
    "id": 3001019020560,
    "speaker": "めぐる",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020560"
  },
  {
    "id": 3001019020570,
    "speaker": "真乃",
    "text": "お芋のおやつを探しに行くのはどうかな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020570"
  },
  {
    "id": 3001019020580,
    "speaker": "真乃",
    "text": "この前焼き芋を食べたみたいに、\r\n打ち合わせが終わったら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020580"
  },
  {
    "id": 3001019020590,
    "speaker": "めぐる",
    "text": "さんせーい！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020590"
  },
  {
    "id": 3001019020600,
    "speaker": "灯織",
    "text": "じゃあ、早く終わらせないとね\r\n打ち合わせが始まるまでには",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020600"
  },
  {
    "id": 3001019020610,
    "speaker": "真乃",
    "text": "うんっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300101902/3001019020610"
  },
