  {
    "id": 3015002010040,
    "speaker": "千雪",
    "text": "甜花ちゃん",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010040"
  },
  {
    "id": 3015002010050,
    "speaker": "甜花",
    "text": "ひゃっ……！\r\nえ……え……？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010050"
  },
  {
    "id": 3015002010060,
    "speaker": "千雪",
    "text": "あ、ごめんね\r\n驚かせちゃったかな",
    "charAnim1": "sad1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010060"
  },
  {
    "id": 3015002010070,
    "speaker": "甜花",
    "text": "あ……ち、千雪さん……\r\nううん……大丈夫……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010070"
  },
  {
    "id": 3015002010080,
    "speaker": "千雪",
    "text": "ふふ、お休みの日に会えるなんて嬉しい♪\r\n甜花ちゃんもお出かけなの？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010080"
  },
  {
    "id": 3015002010090,
    "speaker": "甜花",
    "text": "うん……\r\n新しく、ゲームが出て……それを買いたくて……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010090"
  },
  {
    "id": 3015002010100,
    "speaker": "甜花",
    "text": "こういうとき……いつもなーちゃんに、\r\n来てもらうんだけど……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010100"
  },
  {
    "id": 3015002010110,
    "speaker": "甜花",
    "text": "ひとりでも……外に出られるように、ならなきゃ……\r\nって、思って……",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010110"
  },
  {
    "id": 3015002010120,
    "speaker": "千雪",
    "text": "ふふ、甜花ちゃんは偉いわね♪\r\nそれで今は、お買い物帰り？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010120"
  },
  {
    "id": 3015002010130,
    "speaker": "甜花",
    "text": "まだ、買ってない……お店の近く、来たんだけど……\r\n人……いっぱいで……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010130"
  },
  {
    "id": 3015002010140,
    "speaker": "甜花",
    "text": "どうしようって……なってた……",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010140"
  },
  {
    "id": 3015002010150,
    "speaker": "甜花",
    "text": "甜花、やっぱり……\r\nひとりじゃ……なんも、できない……",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy2",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010150"
  },
  {
    "id": 3015002010160,
    "speaker": "千雪",
    "text": "……よかったら、私もついていってもいい？",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010160"
  },
  {
    "id": 3015002010170,
    "speaker": "甜花",
    "text": "えっ……？",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_surp",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010170"
  },
  {
    "id": 3015002010180,
    "speaker": "千雪",
    "text": "甜花ちゃんが嫌じゃなければだけど……\r\n甜花ちゃんが好きなゲーム、私も見てみたいなぁ",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301500201/3015002010180"
  },
  {
    "id": 3015002010190,
    "speaker": "甜花",
    "text": "千雪さん……\r\nえ……えっと……一緒に来てほしい、です……",
