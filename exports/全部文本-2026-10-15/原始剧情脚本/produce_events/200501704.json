  {
    "id": 2005017040050,
    "speaker": "摩美々",
    "text": "あ────",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
