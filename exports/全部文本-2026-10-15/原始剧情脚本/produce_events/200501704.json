    "waitTime": 500
  },
  {
    "speaker": "女性ファン",
    "text": "ライブの時はかっこいいし、ダウナーな時もあれば\r\n楽しそうな時もあって──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女性ファン",
    "text": "そのギャップが\r\nたまらないんですよ～！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0454"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "（ん？\r\nどこかで聞いたような……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "女性ファン",
    "text": "先日も\r\nお手紙を送らせていただいたんですけど……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
