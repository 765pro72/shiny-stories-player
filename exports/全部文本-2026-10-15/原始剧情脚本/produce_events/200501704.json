    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "speaker": "女性ファン",
    "text": "えっと……こちらはもしかして……\r\nプロデューサーさん……ですかね？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつも田中を応援していただき、ありがとうございます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "女性ファン",
    "text": "そ、そんな……\r\nこちらこそ、いつも元気をもらってます！",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0328"
  },
  {
    "textFrame": "off",
    "bg": "00479",
