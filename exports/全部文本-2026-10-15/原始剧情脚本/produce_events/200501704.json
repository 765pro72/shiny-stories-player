    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2005017040070,
    "speaker": "摩美々",
    "text": "や……心当たりないし、\r\nテキトーにやってるだけなんでー",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200501704/2005017040070"
  },
  {
    "speaker": "女性ファン",
    "text": "そ、そうですか……\r\nナチュラルでやられてるんですね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女性ファン",
