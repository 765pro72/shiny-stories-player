  {
    "speaker": "店員",
    "text": "あれ、はるきちゃん？　だよね\r\n今こっちなんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2028008020030,
    "speaker": "はるき",
    "text": "ふふ、お久しぶりです……！\r\n散歩の休憩で寄らせてもらいました",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
