      "time": 100
    },
    "voice": "produce_events/102300309/1023003090140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、すごく良い答えが\r\n見つかったと思うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023003090150,
    "speaker": "雛菜",
    "text": "だよね～\r\n雛菜もそう思うな～…………",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
