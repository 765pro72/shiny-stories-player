    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300802/2013008020080"
  },
  {
    "id": 2013008020090,
    "speaker": "夏葉",
    "text": "みんなを、がっかりさせないかって",
