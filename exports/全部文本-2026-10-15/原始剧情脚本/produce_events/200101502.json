    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101502/2001015020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "（やっぱり真乃はしっかりしてるな……！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうかぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "他に欲しい資料があったり、悩むところがあったりしたら\r\n遠慮なく聞いてくれよ",
    "charAnim2": "face_shy",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういうのは本職だし！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001015020080,
    "speaker": "真乃",
    "text": "ふふ\r\nはい、ありがとうございます……っ",
