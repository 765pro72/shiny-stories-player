  },
  {
    "id": 2001015020060,
    "speaker": "真乃",
    "text": "えぇっと……はい\r\nなんとか……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101502/2001015020060"
  },
  {
    "id": 2001015020070,
    "speaker": "真乃",
    "text": "これまでのお仕事で頂いた企画書を参考にして……\r\n見よう見まねではあるんですけれど……っ",
    "charAnim1": "shy2",
    "charAnim2": "blank",
