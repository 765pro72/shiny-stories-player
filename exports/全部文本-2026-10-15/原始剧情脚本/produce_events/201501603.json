    "voice": "produce_events/201501603/2015016030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……期待に応えられなくてすまん……\r\n今ここにお菓子はないな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015016030150,
    "speaker": "甜花",
    "text": "あうぅ……\r\nそっか……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait2",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
