    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501603/2015016030120"
  },
  {
    "id": 2015016030130,
    "speaker": "甜花",
    "text": "美味しいお菓子に……\r\nなるかな、って……",
    "charLipAnim": "lip_smile",
    "charLabel": "tenka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201501603/2015016030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ──\r\nなるほど……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015016030140,
    "speaker": "甜花",
    "text": "ちなみに、今は……\r\n甜花、どら焼きの気分……！",
    "charAnim1": "anger1",
