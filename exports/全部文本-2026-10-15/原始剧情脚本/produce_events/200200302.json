      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "charAnim1": "wait",
    "charLabel": "hiori",
    "charType": "idols",
    "charId": "1030020010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
