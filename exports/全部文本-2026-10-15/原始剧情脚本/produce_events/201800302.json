    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "009",
    "voice": "produce_events/201800302/2018003020130"
  },
  {
    "id": 2018003020140,
    "speaker": "冬優子",
    "text": "ちょうどたまたま、仕事の日だったし？\r\n便利だったってだけよ！",
    "charAnim1": "anger1",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_anger",
