  {
    "id": 1002005060230,
    "speaker": "灯織",
    "text": "14年間、一度もアイドルを目指そうと思ったことがなくて\r\nだから、ボイトレもレッスンも受けたことがなくて",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
