  },
  {
    "id": 1002005060240,
    "speaker": "灯織",
    "text": "本当に、どこにでもいるただの子どもだったと思うんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060240"
  },
  {
    "id": 1002005060250,
    "speaker": "灯織",
    "text": "……子どもなのは今も変わらないですけど",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060250"
  },
  {
    "id": 1002005060260,
    "speaker": "灯織",
    "text": "だからこそ、どうしてプロデューサーは\r\n私をイルミネの風野灯織にしてくれたんだろう？　って",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060260"
  },
  {
    "id": 1002005060270,
    "speaker": "灯織",
    "text": "聞いてみたくて",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060270"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nそれが今だったんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002005060280,
    "speaker": "灯織",
    "text": "はい、たぶん\r\n差し支えなければ、伺ってもいいでしょうか",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060280"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、いいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
