    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/100200506/1002005060180"
  },
  {
    "id": 1002005060190,
    "speaker": "灯織",
    "text": "でも、２８３プロに応募した時、\r\n私にその確信はありませんでした",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060190"
  },
  {
    "id": 1002005060200,
    "speaker": "灯織",
    "text": "ほとんど衝動みたいなもので……\r\nでも、何日経っても治まらなかったんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060200"
  },
  {
    "id": 1002005060210,
    "speaker": "灯織",
    "text": "自分なりに色々と考えた末に申し込みましたし、\r\nそれをよくやったと思えど後悔はしていません",
    "charAnim1": "smile3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060210"
  },
  {
    "id": 1002005060220,
    "speaker": "灯織",
    "text": "ただ、それって私側から見た話で……\r\n２８３プロ……プロデューサーはどうだったんだろう？　と",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200506/1002005060220"
  },
  {
