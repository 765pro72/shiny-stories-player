  {
    "id": 1002005060180,
    "speaker": "灯織",
    "text": "私の『アイドルになりたい』という気持ちは、\r\n今でこそ揺るがなくて、確かなものだとわかります",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "002",
