  {
    "speaker": "プロデューサー",
    "text": "灯織",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110020,
    "speaker": "灯織",
    "text": "……プロデューサー",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "もうそろそろだな\r\n水でも飲むか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110030,
    "speaker": "灯織",
    "text": "いえ……今は大丈夫です",
    "charAnim2": "face_serious",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか\r\n脱水を起こすこともあるから、水分補給はこまめにな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110040,
    "speaker": "灯織",
    "text": "はい",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110040"
  },
  {
    "id": 2002010110050,
    "speaker": "灯織",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110050"
  },
  {
    "id": 2002010110060,
    "speaker": "灯織",
    "text": "あの、プロデューサー\r\n念のため確認してもいいですか？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110070,
    "speaker": "灯織",
    "text": "ありがとうございます……！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110070"
  },
  {
    "id": 2002010110080,
    "speaker": "灯織",
    "text": "お菓子はただ配布するのではなく、\r\n『トリック・オア・トリート』と言ってくれた子に渡すこと",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110080"
  },
  {
    "id": 2002010110090,
    "speaker": "灯織",
    "text": "イベントの趣旨を知らない子に\r\nハロウィンの呪文について誘導してあげるのは可能",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110090"
  },
  {
    "id": 2002010110100,
    "speaker": "灯織",
    "text": "お菓子がなくなった場合は\r\nスタッフさんに声をかければ補充していただける……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう。困ったことがあったら、\r\nお菓子を補充するふりをして戻ってくれば大丈夫だからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110110,
    "speaker": "灯織",
    "text": "そう、ですよね",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110110"
  },
  {
    "id": 2002010110120,
    "speaker": "灯織",
    "text": "……",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_a",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201011/2002010110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "いけるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002010110130,
    "speaker": "灯織",
    "text": "……はい\r\n着替えてきますね",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
