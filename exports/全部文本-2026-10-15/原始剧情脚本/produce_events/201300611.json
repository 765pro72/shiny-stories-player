    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "off",
    "voice": "produce_events/201300611/2013006110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは、ラジオの…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、そうだな",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "006"
  },
  {
    "speaker": "プロデューサー",
    "text": "叶えたいと思うよ",
    "charAnim2": "face_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……叶うまで、続けよう",
    "charLipAnim": "lip_wait_s",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim2": "face_close",
    "charLabel": "natsuha",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2013006110210,
    "speaker": "夏葉",
    "text": "ええ、そうね\r\n続けるわ、当たり前じゃない……！",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
