    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110220"
  },
  {
    "id": 2013006110230,
    "speaker": "夏葉",
    "text": "……私たちの夢は、同じ場所にあるんだから",
