    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110240"
  },
  {
    "id": 2013006110250,
    "speaker": "夏葉",
    "text": "完璧なルートで、目的地まで連れて行ってあげるわ！",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "……たまに遠回りすることもあるみたいだけどな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110260,
    "speaker": "夏葉",
    "text": "いいのよ、それでも",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110260"
  },
  {
    "id": 2013006110270,
    "speaker": "夏葉",
    "text": "回り道にも付き合ってくれて、\r\n間違っている時は教えてくれて……",
    "charAnim1": "shy2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110270"
  },
  {
    "id": 2013006110280,
