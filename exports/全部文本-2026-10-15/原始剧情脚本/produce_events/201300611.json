    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "頼むぞ\r\n夏葉がいなきゃ叶わない夢だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110240,
    "speaker": "夏葉",
    "text": "うふふっ、任せてちょうだい！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
