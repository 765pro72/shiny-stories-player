    "voice": "produce_events/201300611/2013006110120"
  },
  {
    "id": 2013006110130,
    "speaker": "夏葉",
    "text": "だったら、反対回りに乗ってもちゃんと到着するわよ",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは、そうなんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110140,
    "speaker": "夏葉",
    "text": "それにこっちの方がたくさん話が出来るわ！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あははっ\r\nああ、確かにそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110150,
    "speaker": "夏葉",
    "text": "うふふ、ええ！　そうでしょう？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110150"
  },
  {
    "id": 2013006110160,
    "speaker": "夏葉",
    "text": "私、プロデューサーに訊きたいことがたくさんあるのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　なんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110170,
    "speaker": "夏葉",
    "text": "例えば、そうね……\r\n『好きな食べ物は？』とか",
    "charAnim1": "shy2",
    "charAnim2": "face_anger1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110170"
  },
  {
    "id": 2013006110180,
    "speaker": "夏葉",
    "text": "後は……『休日の過ごし方は？』とか",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "それはこの間\r\n夏葉が雑誌で訊かれた質問だろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013006110190,
    "speaker": "夏葉",
    "text": "……バレたわね\r\nふふ、それじゃあ……",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300611/2013006110190"
  },
  {
    "id": 2013006110200,
    "speaker": "夏葉",
    "text": "──『夢は、叶うと思いますか？』",
