      "easing": "easeInQuart"
    }
  },
  {
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "（打ち合わせ、長引いたな……もうバスもないし……\r\n仕方ない、歩いて帰るか）",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00016"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……結華、あれから無理してないといいんだけど……）",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ん？　こんな時間に女の子ひとりで危ないな……\r\n……あれは……ダンスの練習か……？）",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（声かけとかないと……って、結華！？）",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040080,
    "speaker": "結華",
    "text": "はぁっ、はぁっ……もう１回ッ……！",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "007",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/100700104/1007001040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと待て",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040090,
    "speaker": "結華",
    "text": "うげ、プロデューサー！？\r\n……なんでこんなところに……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺のことよりも、結華だよ\r\n女の子がこんな時間にひとりでいたら危ないだろ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、無理はしないって約束したと思ったんだが",
    "charAnim2": "face_sad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040100,
    "speaker": "結華",
    "text": "……おっきなイベントの前なんだし、\r\n練習に熱が入っちゃうのは普通のことでしょ～",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040100"
  },
  {
    "id": 1007001040110,
    "speaker": "結華",
    "text": "プロデューサーなら、アイドルが真剣に\r\n仕事に打ち込んでることを褒めるところじゃない？",
    "charAnim1": "shy1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "普段ならもちろん褒める\r\nでもいつもの結華なら、こんな無茶な練習はしないだろ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040120,
    "speaker": "結華",
    "text": "……もう、そんな怖い顔しないでって\r\nほら、夜の公園で自主練とかアイドルっぽいでしょ？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040120"
  },
  {
    "id": 1007001040130,
    "speaker": "結華",
    "text": "危ないことしたのはごめんなさいだけど、\r\nこういうの昔から憧れてたんだって",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040130"
  },
  {
    "id": 1007001040140,
    "speaker": "結華",
    "text": "……心配かけてごめんね？　プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040150,
    "speaker": "結華",
    "text": "……はぁ……頑固だね\r\nこういう時ばっか譲らないんだ？　容赦ないなぁ……",
    "charAnim1": "sad1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040150"
  },
  {
    "id": 1007001040160,
    "speaker": "結華",
    "text": "わかったよ、話すよ",
    "charAnim1": "wait2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040160"
  },
  {
    "id": 1007001040170,
    "speaker": "結華",
    "text": "……三峰って、省エネ系でしょ？\r\nそれにアイドル始めたのだってドルオタきっかけだし",
    "charAnim1": "wait1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040170"
  },
  {
    "id": 1007001040180,
    "speaker": "結華",
    "text": "だから、みんなが頑張ってるのを見てると、\r\nひとりだけこんな感じでいいのかなって思ったりもするわけ",
    "charAnim1": "shy2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040180"
  },
  {
    "id": 1007001040190,
    "speaker": "結華",
    "text": "そういうこと考えてるのも精神衛生上良くないからさ？\r\nとりあえず練習しとけ、みたいに思ってね？",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040190"
  },
  {
    "id": 1007001040200,
    "speaker": "結華",
    "text": "そういう思いつきみたいなものだから、\r\nあんまり気にしないでほしいわけですよ",
    "charAnim1": "sad1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040200"
  },
  {
    "select": "それは真剣な証拠だ",
    "nextLabel": "1"
  },
  {
    "select": "気にするよ",
    "nextLabel": "2"
  },
  {
    "charLabel": "yuika",
    "textCtrl": "cm",
    "select": "結華だって\r\n頑張ってるだろ",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "アイドルに対してちゃんと向き合ってるから\r\nそこまで悩んだりしてるんだよ",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、思いつきだなんて言うのはやめてくれ\r\n結華の真剣な気持ちを、結華が否定したらダメだ",
    "charAnim2": "face_cry",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040210,
    "speaker": "結華",
    "text": "……三峰のこと、買いかぶりすぎじゃない？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことはない。結華が真面目に努力してるのは\r\nすぐ近くで見てきた俺が保証できる",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040220,
    "speaker": "結華",
    "text": "…………",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040220"
  },
  {
    "speaker": "プロデューサー",
    "text": "このままじゃ良くないと思うから現状を変えたくなるし\r\n変えたいって思うから苦しくなるんだ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうやってもがいてる人は、立派な人だよ",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040230,
    "speaker": "結華",
    "text": "……ふーん",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger_s2",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040230"
  },
  {
    "id": 1007001040240,
    "speaker": "結華",
    "text": "まっ、そんな重い話じゃないから、いいんだけどね",
    "charAnim1": "shy2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040240"
  },
  {
    "id": 1007001040250,
    "speaker": "結華",
    "text": "……けど、心配してくれたことには、一応お礼言っとくよ\r\nありがとう、プロデューサー",
    "charAnim1": "sad2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/100700104/1007001040250"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "俺は結華のプロデューサーなんだから\r\n気にするに決まってるだろ",
    "charAnim2": "face_sad",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040260,
    "speaker": "結華",
    "text": "……でもさ、Ｐたんには他にも\r\n気にかけないといけないことがあるはずでしょ？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040260"
  },
  {
    "id": 1007001040270,
    "speaker": "結華",
    "text": "三峰のことまで気にしてたら\r\nさすがのＰたんも、身がもたないよー？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040270"
  },
  {
    "speaker": "プロデューサー",
    "text": "身がもたなくても関係ない\r\n担当してるアイドルの無理を見過ごすよりよっぽどいい",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040280,
    "speaker": "結華",
    "text": "……おお？　今日はずいぶんグイグイ来るね",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040280"
  },
  {
    "speaker": "プロデューサー",
    "text": "それだけ重要なことだとわかってもらえると\r\n嬉しいんだけどな",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040290,
    "speaker": "結華",
    "text": "…………",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040290"
  },
  {
    "id": 1007001040300,
    "speaker": "結華",
    "text": "……まー、そこまで言うなら\r\n今度からはプロデューサーにも相談することにするよ",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700104/1007001040300"
  },
  {
    "speaker": "プロデューサー",
    "text": "……本当か？",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007001040310,
    "speaker": "結華",
    "text": "守る気なかったらそもそも言わないって",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
