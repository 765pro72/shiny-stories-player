    "voice": "produce_events/100700104/1007001040320"
  },
  {
    "id": 1007001040330,
    "speaker": "結華",
    "text": "…………ごめんねプロデューサー、ありがとう",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
