    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500200202/5002002020400"
  },
  {
    "id": 5002002020410,
    "speaker": "結華",
    "text": "『ふたりを待っていたかったけれど、\r\n状況を考えてみんなで少しばかり進めておいたよ』",
