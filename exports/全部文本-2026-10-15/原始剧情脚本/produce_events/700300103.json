[
  {
    "id": 7003001030010,
    "speaker": "めぐる",
    "text": "あっ、プロデューサー！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "003",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bg": "00002",
    "bgm": "000",
    "voice": "produce_events/700300103/7003001030010"
  },
  {
    "id": 7003001030020,
    "speaker": "めぐる",
    "text": "審査の結果が出たんだよね！\r\nどうだったのっ！？",
    "charAnim1": "anger2",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "おめでとう、二次審査も無事突破したぞ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030030,
    "speaker": "めぐる",
    "text": "わーい！\r\nえっへへー、やったー！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "最近は、かなり頑張ってたもんなぁ\r\nレッスンも仕事も……",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030040,
    "speaker": "めぐる",
    "text": "でもどれも楽しかったから\r\n「努力」って感じはしなかったよ！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、さすがはめぐるだな\r\n……そうだ、ご褒美に今度休みでも取ろうか？",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030050,
    "speaker": "めぐる",
    "text": "ううん、大丈夫！",
    "charAnim1": "no",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charAnim1Loop": false,
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？\r\n無理はしなくてもいいんだぞ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030060,
    "speaker": "めぐる",
    "text": "心配してくれてありがとう\r\n……でも、本当に無理してるわけじゃないんだ",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030060"
  },
  {
    "id": 7003001030070,
    "speaker": "めぐる",
    "text": "わたしね、もっとレッスンとかいっぱい頑張って、\r\n早くすごいアイドルになりたいの！",
    "charAnim1": "anger1",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030070"
  },
  {
    "id": 7003001030080,
    "speaker": "めぐる",
    "text": "だから今はお休みはいらないよ！",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030080"
  },
  {
    "id": 7003001030090,
    "speaker": "めぐる",
    "text": "あっ、そうだ！　ご褒美だったらわたしじゃなくて、\r\nプロデューサーがお休みをとってほしいな！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺が？\r\nそんなことしても、めぐるは休めないじゃないか",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030100,
    "speaker": "めぐる",
    "text": "違う違う、プロデューサーとお休みを合わせて、\r\n一緒に遊びに行きたいの！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "プロデューサーがアイドルと遊ぶのはなぁ……",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030110,
    "speaker": "めぐる",
    "text": "ねっ、ねっ！　お願い！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030120,
    "speaker": "めぐる",
    "text": "あ、じゃあ、目立たない場所だったらどう？\r\n映画館とか！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030120"
  },
  {
    "id": 7003001030130,
    "speaker": "めぐる",
    "text": "事務所の中でもいいからっ！　ねっ！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……俺の休みが、めぐるのためになるならいいか）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、じゃあ休みをとるよ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001030140,
    "speaker": "めぐる",
    "text": "わー！　ありがとう！\r\nえへへー、なにして遊ぼうかなー！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300103/7003001030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "（はは……。こういうところは、まだまだ\r\nアイドルとしての自覚が足りてないみたいだけど）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……でも、\r\nこういう無邪気さが、めぐるの魅力でもある）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（めぐるのためになることだったら、\r\nどんなことでもとことん付き合ってやらなくちゃな！）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "end"
  }
]