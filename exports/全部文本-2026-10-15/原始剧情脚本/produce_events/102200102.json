  },
  {
    "charAnim1": "wait",
    "charLabel": "koito",
    "textFrame": "off",
    "nextLabel": "end"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "みんなのためにも、もちろん小糸のためにも",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "わからないこととか、不安なこととか\r\nなんでも聞いてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001020230,
    "speaker": "小糸",
    "text": "…………！\r\nあの……わ、わたし…………",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200102/1022001020230"
  },
  {
    "id": 1022001020240,
    "speaker": "小糸",
    "text": "わたし、そんなの無いですよー！",
    "charAnim1": "shy1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200102/1022001020240"
  },
  {
