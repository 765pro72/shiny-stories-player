    "charAnim2": "face_anger1",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500105/1025001050120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……それも、間違ってはいないと思うよ\r\nそういう魅力も確かに存在すると思う、でも──……",
    "charAnim2": "face_anger1",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001050130,
