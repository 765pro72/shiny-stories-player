    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500105/1025001050110"
  },
  {
    "id": 1025001050120,
    "speaker": "美琴",
    "text": "見た目が良くて、個性があって、\r\nキャラが立ってて、推せればいいんだって",
