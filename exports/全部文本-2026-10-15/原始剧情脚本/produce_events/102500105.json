    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500105/1025001050080"
  },
  {
    "id": 1025001050090,
    "speaker": "美琴",
    "text": "……だけどいつも、それじゃダメだった",
