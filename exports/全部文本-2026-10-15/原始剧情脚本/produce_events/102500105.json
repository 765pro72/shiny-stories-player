    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500105/1025001050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんな──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001050110,
    "speaker": "美琴",
    "text": "完璧じゃない方が応援したくなるし\r\n歌えなくても踊れなくても、どんな振る舞いをしてたって",
