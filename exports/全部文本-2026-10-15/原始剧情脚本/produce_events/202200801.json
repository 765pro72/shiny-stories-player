    "textFrame": "001",
    "voice": "produce_events/202200801/2022008010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、それにしようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022008010140,
