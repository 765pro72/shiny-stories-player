    "textFrame": "001",
    "voice": "produce_events/202200801/2022008010080"
  },
  {
    "id": 2022008010090,
    "speaker": "小糸",
    "text": "で、でも『ふくまる』って、音はちょっと\r\nとぼけた感じがしないかなって……",
