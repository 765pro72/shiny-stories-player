    "textFrame": "001",
    "voice": "produce_events/202200801/2022008010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "『福』も『丸』も良い字だし\r\n縁起がいいっていうか、幸せなイメージというかさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸に合ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022008010080,
    "speaker": "小糸",
    "text": "……！\r\nそ、そうですかね……？",
