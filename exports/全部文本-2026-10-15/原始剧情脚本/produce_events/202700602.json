    "textFrame": "001",
    "voice": "produce_events/202700602/2027006020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。イメージキャラクターといっても、ポスターやCMを\r\n撮影するくらいだからあまり力まなくて大丈夫だぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2027006020050,
    "speaker": "羽那",
    "text": "そっかーっ",
    "charAnim1": "wait5",
    "charAnim2": "blank",
