  },
  {
    "speaker": "プロデューサー",
    "text": "あ、すまん、いただくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008010200,
    "speaker": "あさひ",
    "text": "あはは、ポテト、山盛りっす！\r\n……あっ、これ……あれみたいっすね",
