  {
    "id": 2017008010100,
    "speaker": "あさひ",
    "text": "はむっ……むぐむぐ……\r\nあっ、ポテト、プロデューサーさんもどうっすか？",
    "charAnim1": "surp4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
