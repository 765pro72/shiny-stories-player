    "textFrame": "001",
    "voice": "produce_events/201700801/2017008010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……トレーナーさんから聞いたけど、あさひ、\r\nどっか調子おかしいのか？",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008010040,
    "speaker": "あさひ",
    "text": "え？　\r\nさっきバッチリって……",
