    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201700801/2017008010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれって？",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008010210,
    "speaker": "あさひ",
    "text": "将棋くずしっす！\r\nやるっすよ、プロデューサーさん",
