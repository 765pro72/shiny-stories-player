  {
    "id": 2014010010120,
    "speaker": "甘奈",
    "text": "──っていう訳でね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010120"
  },
  {
    "id": 2014010010130,
    "speaker": "甘奈",
    "text": "公園でこの子と遊んでたら\r\n懐かれちゃったの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010130"
  },
  {
    "id": 2014010010140,
    "speaker": "甘奈",
    "text": "連れてきちゃダメだってわかっては\r\nいたんだけどね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010140"
  },
  {
    "id": 2014010010150,
    "speaker": "甘奈",
    "text": "今日雨が降るって話だったから\r\nほっとけなくて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010150"
  },
  {
    "textFrame": "off",
    "se": "0776",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "一時的なら、気にしなくて大丈夫だぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈のことだ\r\nちゃんと何か考えてるだろうし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014010010160,
    "speaker": "甘奈",
    "text": "プロデューサーさん……\r\nありがと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "けど、その子\r\nこの後どうするんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014010010170,
    "speaker": "甘奈",
    "text": "残念だけど、うちだと飼えないから、\r\n飼い主さん探し、しようと思ってるよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "あてはあるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014010010180,
    "speaker": "甘奈",
    "text": "まずは友達に聞いてみる\r\n飼いたい子、いるかもだからね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010180"
  },
  {
    "id": 2014010010190,
    "speaker": "甘奈",
    "text": "それと、ネットも使おうと思ってるよ\r\nいくつかちゃんとしたサイト、見つけたから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちゃんと調べたんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014010010200,
    "speaker": "甘奈",
    "text": "うん、こういうのはしっかりやらないとだもん\r\n命を預かるんだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "協力できることがあったら言ってくれ\r\n手伝うよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014010010210,
    "speaker": "甘奈",
    "text": "ありがと、プロデューサーさん！\r\n何かあったら、お願いするね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401001/2014010010210"
  },
