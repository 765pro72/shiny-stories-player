    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900303/1009003030080"
  },
  {
    "id": 1009003030090,
    "speaker": "果穂",
    "text": "あたしが出られる番組、どんなのがあるんですか？",
