  {
    "speaker": "プロデューサー",
    "text": "いや、ありがとうはこっちの台詞だよ\r\n買い出し、付き合ってくれて助かる",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003008110020,
    "speaker": "めぐる",
    "text": "お礼はずーっと言ってくれてたから大丈夫！",
