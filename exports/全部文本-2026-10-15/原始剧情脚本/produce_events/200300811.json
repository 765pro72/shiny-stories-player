    "textFrame": "001",
    "voice": "produce_events/200300811/2003008110020"
  },
  {
    "id": 2003008110030,
    "speaker": "めぐる",
    "text": "それに、報酬だってちゃんともらったもん\r\nジュース、美味しいよ！",
