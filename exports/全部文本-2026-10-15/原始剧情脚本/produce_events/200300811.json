    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300811/2003008110030"
  },
  {
    "id": 2003008110040,
    "speaker": "めぐる",
    "text": "あとは郵便局と薬局だよね\r\n休憩したらどんどん行こうっ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
