    "charLabel": "fuyuko",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018004110150,
    "speaker": "冬優子",
    "text": "……でもさ、いざふゆがそうやって、\r\n色んな大変なことをしてもらう側の立場になると……",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800411/2018004110150"
  },
  {
    "id": 2018004110160,
    "speaker": "冬優子",
    "text": "──ほんとにふゆに、\r\nそんな価値があるのかなって、思っちゃう",
