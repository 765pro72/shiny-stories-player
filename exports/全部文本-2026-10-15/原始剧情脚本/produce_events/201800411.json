    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、この映画、もうすぐ公開か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018004110040,
    "speaker": "冬優子",
    "text": "あ、これ、ふゆもちょっと気になってるのよね",
    "charAnim1": "surp3",
