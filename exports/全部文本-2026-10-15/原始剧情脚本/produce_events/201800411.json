    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800411/2018004110170"
  },
  {
    "id": 2018004110180,
    "speaker": "冬優子",
    "text": "……それでふゆを見て、\r\n苦労は無駄じゃなかったって、そう思ってもらえてるのかな",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800411/2018004110180"
  },
  {
    "id": 2018004110190,
    "speaker": "冬優子",
    "text": "こんなにいっぱい、楽しいものがある中で……",
