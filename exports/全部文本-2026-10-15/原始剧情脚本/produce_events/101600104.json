    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001040120,
    "speaker": "千雪",
    "text": "私、頑張ってるつもりで、どっちつかずだったんですね\r\nステージが……こんなにびりびりするものだったなんて",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600104/1016001040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪、これからも──\r\nいや……この後の本番、頑張ろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪の全部、俺もしっかり見てるからな",
    "charAnim2": "face_wait",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001040130,
