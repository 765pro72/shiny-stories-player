  {
    "speaker": "プロデューサー",
    "text": "よし、千雪。コンディションはばっちりだと思う\r\n今日は、思いっきりやろうな",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00008"
  },
  {
    "id": 1016001040100,
    "speaker": "千雪",
    "text": "はい、プロデューサーさん\r\n私、すごく、すごく緊張して……",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
