  },
  {
    "id": 1016001040110,
    "speaker": "千雪",
    "text": "でも、わくわくしてます\r\nこんな感じ、初めて……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
