  {
    "id": 1016001040020,
    "speaker": "千雪",
    "text": "プロデューサーさん、今回のこと\r\n本当に、申し訳ありませんでした",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
