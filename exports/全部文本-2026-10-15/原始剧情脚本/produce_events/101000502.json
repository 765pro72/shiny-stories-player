    "voice": "produce_events/101000502/1010005020140"
  },
  {
    "speaker": "あすみ",
    "text": "──……！\r\nそっか、ふふ……！　うん……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "あすみ",
    "text": "チョコちゃんが言うと、そうなんだなって感じがする……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1010005020150,
    "speaker": "智代子",
    "text": "だってそうだもん！　どーんとしよう、お祝い！\r\nあっ、追加で何か頼む？",
