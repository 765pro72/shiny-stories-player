    "textFrame": "001",
    "voice": "produce_events/200401911/2004019110140"
  },
  {
    "speaker": "女優",
    "text": "ひとことで言えば映画の共演者なんですが……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女優",
    "text": "現場で色々話して、知っていくうちに────\r\n私、彼女のファンになってしまったんです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "女優",
    "text": "今回ゲストに呼んでいただいたので\r\n喜び勇んで来てしまいました",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004019110150,
    "speaker": "恋鐘",
    "text": "ふぇ……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
