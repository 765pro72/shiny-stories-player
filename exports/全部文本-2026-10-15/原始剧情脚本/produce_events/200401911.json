    "voice": "produce_events/200401911/2004019110130"
  },
  {
    "speaker": "女優",
    "text": "はじめまして\r\n今日はロケにご一緒させていただきます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "司会",
    "text": "おぉ～！　なになに～\r\n恋鐘ちゃんとはどういう関係の方？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004019110140,
    "speaker": "恋鐘",
    "text": "こん前の映画で共……",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
