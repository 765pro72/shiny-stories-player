  {
    "id": 2004019110130,
    "speaker": "恋鐘",
    "text": "今日は特別なゲストに来てもらったばい～！",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
