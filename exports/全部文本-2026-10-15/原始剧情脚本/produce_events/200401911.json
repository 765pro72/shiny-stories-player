    "textFrame": "001",
    "voice": "produce_events/200401911/2004019110160"
  },
  {
    "id": 2004019110170,
    "speaker": "恋鐘",
    "text": "そい、褒めとると！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401911/2004019110170"
  },
  {
    "speaker": "女優",
    "text": "ふふっ\r\n最上級に褒めてるわよ？",
    "textCtrl": "p",
    "textFrame": "003"
