  {
    "speaker": "雑誌ライター",
    "text": "こういうお店は来たことありますか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002017040020,
    "speaker": "灯織",
    "text": "絵本屋さんというのは初めてだと思います",
