    "voice": "produce_events/200201704/2002017040130"
  },
  {
    "speaker": "雑誌ライター",
    "text": "素敵な思い出ですね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002017040140,
    "speaker": "灯織",
    "text": "素敵……\r\nそうなんでしょうか",
