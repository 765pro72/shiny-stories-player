    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201704/2002017040140"
  },
  {
    "id": 2002017040150,
    "speaker": "灯織",
    "text": "日中散々読んだのに、夜にもまた読んでって言うから\r\n母は結構飽きていたようにも思います",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201704/2002017040150"
  },
  {
    "id": 2002017040160,
    "speaker": "灯織",
    "text": "あまりに私がこればかり選ぶから、\r\nたまに帰ってきたばかりの父が駆り出されたりして",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
