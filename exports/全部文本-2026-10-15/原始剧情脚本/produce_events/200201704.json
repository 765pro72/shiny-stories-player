    "textFrame": "001",
    "voice": "produce_events/200201704/2002017040040"
  },
  {
    "speaker": "雑誌ライター",
    "text": "ふふ、いえ！\r\nいいですね、『絵本の中にいるみたい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "雑誌ライター",
    "text": "では、風野さんの小さい頃についてお話聞かせてください\r\nどんな絵本を読まれていましたか？",
    "charAnim2": "face_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002017040050,
    "speaker": "灯織",
    "text": "そうですね……",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201704/2002017040050"
  },
  {
    "id": 2002017040060,
    "speaker": "灯織",
    "text": "図鑑とかにはあまり興味がなくて、\r\n動物が主人公の絵本を読んでいたように思います",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201704/2002017040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（えっ！\r\n灯織、そんな小さい頃の記憶があるのか……！？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017040070,
    "speaker": "灯織",
    "text": "小学校に入るかくらいの頃なので、\r\nあまりはっきり覚えてはいないんですけど……",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
