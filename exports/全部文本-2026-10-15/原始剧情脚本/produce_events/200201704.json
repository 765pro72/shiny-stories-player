  },
  {
    "id": 2002017040030,
    "speaker": "灯織",
    "text": "……すごいですよね\r\nちょっとおとぎ話みたいな雰囲気で……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
