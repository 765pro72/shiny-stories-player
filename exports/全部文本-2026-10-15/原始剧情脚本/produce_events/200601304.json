  {
    "id": 2006013040260,
    "label": "1",
    "speaker": "咲耶",
    "text": "ああ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040260"
  },
  {
    "id": 2006013040270,
    "speaker": "咲耶",
    "text": "おやすみ、いい夢を\r\n──この後また仕事をしたりしてはダメだからね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040270"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、善処するよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040280,
    "speaker": "咲耶",
    "text": "……まったく\r\n信用ならない返事だな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040280"
  },
  {
    "textFrame": "off",
    "nextLabel": "end",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 2000,
    "waitType": "time",
    "waitTime": 4000
  },
  {
    "id": 2006013040290,
    "label": "2",
    "speaker": "咲耶",
    "text": "アナタこそ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040290"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は十分だよ。美味しく一服させてもらって\r\n一休みもできたことだし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040300,
    "speaker": "咲耶",
    "text": "おやおや",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040300"
  },
  {
    "id": 2006013040310,
    "speaker": "咲耶",
    "text": "私はオーバーワークを手伝いたかったんじゃないよ？\r\n眠気覚ましの一杯だとは、思わないでもらいたいな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040310"
  },
  {
    "textFrame": "off",
    "nextLabel": "end",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 2000,
    "waitType": "time",
    "waitTime": 4000
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "お邪魔しました",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040320,
    "speaker": "咲耶",
    "text": "フフ、たいしたおかまいもできませんで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "とんでもない\r\n──じゃあ、また明日な",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040330,
    "speaker": "咲耶",
    "text": "そうだね、また明日",
