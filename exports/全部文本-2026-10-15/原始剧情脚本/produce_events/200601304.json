  {
    "speaker": "プロデューサー",
    "text": "──おお、こんばんは咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040020,
    "speaker": "咲耶",
    "text": "プロデューサー！？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040020"
  },
  {
    "id": 2006013040030,
    "speaker": "咲耶",
    "text": "あ、いや……こ、こんばんは\r\nその──",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040030"
  },
  {
    "id": 2006013040040,
    "speaker": "咲耶",
    "text": "どうして……ここに……？",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040040"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務まわりでちょっと用があって\r\nこんなに遅くなるはずじゃなかったんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040050,
    "speaker": "咲耶",
    "text": "そ、そうなんだね──",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040050"
  },
  {
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "1278",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "se": "1548",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶は──\r\n……この時間からどこか行くわけじゃないよな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そのつもりなら\r\n俺ももう帰りだし、ついて──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040060,
    "speaker": "咲耶",
    "text": "ああ、違うよ\r\n食堂に用があって──",
    "charAnim1": "wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601304/2006013040060"
  },
  {
    "id": 2006013040070,
    "speaker": "咲耶",
    "text": "……あー……",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040070"
  },
  {
    "id": 2006013040080,
    "speaker": "咲耶",
    "text": "……すまないね、プロデューサー\r\nこんな格好で……",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "？",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2006013040090,
    "speaker": "咲耶",
    "text": "人が来るとは思っていなかったから……",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？？\r\nどういう意味だ？　別にどこも変じゃないけど……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charAnim4": "blank",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2300
  },
  {
    "id": 2006013040100,
    "speaker": "咲耶",
    "text": "ええと……\r\n……もう、あとは寝るだけの格好だから……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040100"
  },
  {
    "id": 2006013040110,
    "speaker": "咲耶",
    "text": "客人を迎えるには相応しくなかったかな、と……",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──あっ！？\r\nその格好、パジャマなのか！？",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0327"
  },
  {
    "charAnim1": "anger2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、それは俺がすまん！！\r\n配慮に欠けてた──！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_shy2",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 200,
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "全然普通の服だと思ってたよ！\r\n最近のパジャマっておしゃれなんだな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ってこれはどうでもいい、ごめん\r\nもう見てないから……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040120,
    "speaker": "咲耶",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040120"
  },
  {
    "id": 2006013040130,
    "speaker": "咲耶",
    "text": "……フフッ\r\n気を遣ってくれてありがとう、プロデューサー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040130"
  },
  {
    "id": 2006013040140,
    "speaker": "咲耶",
    "text": "でもそのままだと\r\nアナタは一歩もそこから動けないんじゃないかな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっ……そう……\r\nいや、壁伝いにどうにか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040150,
    "speaker": "咲耶",
    "text": "フフフッ、もう……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040150"
  },
  {
    "textFrame": "off",
    "se": "0888",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006013040160,
    "speaker": "咲耶",
    "text": "……アナタにとって見苦しくないのなら\r\n私も構わないんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040160"
  },
  {
    "id": 2006013040170,
    "speaker": "咲耶",
    "text": "目を開けてほしい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 1500
  },
  {
    "id": 2006013040180,
    "speaker": "咲耶",
    "text": "こんな時間まで仕事を頑張っているプロデューサーに\r\n労いのお茶ぐらい振る舞わせてほしいな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040180"
  },
  {
    "id": 2006013040190,
    "speaker": "咲耶",
    "text": "ね？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……う……俺こそ気を遣わせてごめんな……\r\n開けるぞ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040200,
    "speaker": "咲耶",
    "text": "ああ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040200"
  },
  {
    "textFrame": "off",
    "bg": "00439",
    "bgEffect": "fade",
    "bgEffectTime": 500,
    "waitType": "time",
    "waitTime": 600
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgEffectTime": 500,
    "waitType": "time",
    "waitTime": 600
  },
  {
    "textFrame": "off",
    "bg": "00439",
    "bgEffect": "fade",
    "bgEffectTime": 500,
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 2006013040210,
    "speaker": "咲耶",
    "text": "ごめんね\r\n先に私が変な反応をしてしまったから",
    "charAnim1": "shy2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601304/2006013040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいやいや、咲耶は悪くない\r\n完全に俺が考えなしだったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013040220,
    "speaker": "咲耶",
    "text": "では、お互い様ということにしよう",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040220"
  },
  {
    "id": 2006013040230,
    "speaker": "咲耶",
    "text": "──さぁ\r\n知っているだろうけれど、食堂はこちらだ",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040230"
  },
  {
    "id": 2006013040240,
    "speaker": "咲耶",
    "text": "コーヒーと紅茶、今のアナタはどちらがお好みかな？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601304/2006013040240"
  },
