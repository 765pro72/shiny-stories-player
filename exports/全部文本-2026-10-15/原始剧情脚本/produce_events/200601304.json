  },
  {
    "select": "じゃあ、おやすみ",
    "nextLabel": "1"
  },
  {
    "select": "ゆっくり休んでくれ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "遅い時間なのに\r\nありがとう",
    "nextLabel": "3"
