  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "……田中、自身のイメージですか──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "雑誌スタッフ",
    "text": "摩美々ちゃんといえばこれ！\r\nみたいな、一言でバーンと……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "そうですね……\r\nすみません",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんというか、言葉にするのが難しくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "雑誌スタッフ",
    "text": "あはは！\r\n全然大丈夫ですよ……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑誌スタッフ",
    "text": "ずっと見守ってきている大切なアイドルですもん\r\n一言で表すなんて、難しい質問でしたよね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……すみません\r\n──田中とも、話してみますね",
    "textCtrl": "p",
    "textFrame": "002"
  },
