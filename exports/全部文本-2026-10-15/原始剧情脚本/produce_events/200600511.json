    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "お、咲耶……\r\n……と、学校の友達かな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002",
    "charAnim2Loop": false,
    "charType": "characters",
    "charId": "006",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 2006005110020,
    "speaker": "咲耶",
    "text": "ああ。可愛い子だろう？\r\nレッスンの時間まで、一緒にお喋りをしてたんだ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか\r\n悪いな、楽しんでたところを邪魔して",
    "charAnim2": "face_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005110030,
    "speaker": "咲耶",
    "text": "フフ、気にしないでくれ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110030"
  },
  {
    "id": 2006005110031,
    "speaker": "咲耶",
    "text": "……ああ、キミにも紹介するよ。彼は私の、そうだね──",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "voice": "produce_events/200600511/2006005110031"
  },
  {
    "id": 2006005110040,
    "speaker": "咲耶",
    "text": "『特別な人』、だよ",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110040"
  },
  {
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おいおい咲耶……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（なんで急にそんな冗談……\r\n……って、友達はあまり驚いていないようだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（咲耶のことだから、この手の言い方は日常茶飯事なのか？\r\n……もうふたりで話に花を咲かせてるし）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005110050,
    "speaker": "咲耶",
    "text": "おっと、もうこんな時間だ\r\n楽しい時間はすぐに過ぎてしまうね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110050"
  },
  {
    "id": 2006005110060,
    "speaker": "咲耶",
    "text": "フフ、そうだね\r\nまた明日、学校で会おう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110060"
  },
  {
    "textFrame": "off",
    "se": "0243",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2006005110070,
    "speaker": "咲耶",
    "text": "待たせてごめんね\r\nじゃあ行こうか、プロデューサー",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200600511/2006005110070"
  },
  {
