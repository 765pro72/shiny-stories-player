    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006005110210,
    "speaker": "咲耶",
    "text": "──ああ、そう言えばひとつだけ\r\n言い忘れたことがあったよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006005110220,
    "speaker": "咲耶",
    "text": "私の『大切な人』はたくさんいるけど……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110220"
  },
  {
    "id": 2006005110230,
    "speaker": "咲耶",
    "text": "『特別な人』なんて人に紹介したのは、\r\nアナタが初めてだよ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶、それは……",
    "charAnim2": "face_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005110240,
    "speaker": "咲耶",
    "text": "フフ。これ以上を言う気はないさ\r\n……では、行ってくるよ",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600511/2006005110240"
  },
  {
    "id": 2006005110250,
    "speaker": "咲耶",
    "text": "私の、『特別な人』",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
