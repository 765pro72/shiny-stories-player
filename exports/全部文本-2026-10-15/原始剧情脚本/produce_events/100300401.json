    "se": "0454",
    "autoWaitTime": 1200
  },
  {
    "id": 1003004010020,
    "speaker": "めぐる",
    "text": "ライブ！　っていうか顔合わせ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
