      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100300401/1003004010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる、全員に挨拶する勢いだったもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1003004010030,
    "speaker": "めぐる",
    "text": "えへへっ",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010030"
  },
  {
    "id": 1003004010040,
    "speaker": "めぐる",
    "text": "演出さん、衣装さん、音響さん、照明さん……\r\n他にも、わたしが知らないポジションもきっとあって",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010040"
  },
  {
    "id": 1003004010050,
    "speaker": "めぐる",
    "text": "ほんとにほんとにたくさんの人に支えてもらって\r\nワンマンができるんだなって",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010050"
  },
  {
    "id": 1003004010060,
    "speaker": "めぐる",
    "text": "そう思ったら、居ても立ってもいられなくなっちゃって！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010060"
  },
  {
    "id": 1003004010070,
    "speaker": "めぐる",
    "text": "考えなくちゃいけないこととか、\r\nやったことない曲数のレッスンとか……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010070"
  },
  {
    "id": 1003004010080,
    "speaker": "めぐる",
    "text": "色々『やりきれるかな！？　大丈夫かな！？』って\r\nちょっとだけ不安になったりもするけど",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100300401/1003004010080"
  },
