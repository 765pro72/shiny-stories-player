    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタッフ２",
    "text": "もうっ、だから言ったじゃないですか、\r\nふゆちゃ──じゃない！　黛さんに任せたら安心だって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018009020020,
