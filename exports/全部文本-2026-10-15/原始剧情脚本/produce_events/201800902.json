    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800902/2018009020050"
  },
  {
    "speaker": "スタッフ２",
    "text": "……！\r\nなんて神対応……っ……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018009020060,
    "speaker": "冬優子",
    "text": "あさひちゃんも愛依ちゃんも喜ぶと思います\r\n素敵なスタッフさんのお土産話、できちゃいました",
