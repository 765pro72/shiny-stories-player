    "textFrame": "001",
    "voice": "produce_events/201800902/2018009020020"
  },
  {
    "speaker": "スタッフ２",
    "text": "そしてすみません黛さん、お名前……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018009020030,
    "speaker": "冬優子",
    "text": "大丈夫ですよ\r\n『ふゆちゃん』って呼んでもらえるのも、嬉しいです♡",
    "charAnim1": "wait3",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800902/2018009020030"
  },
  {
    "speaker": "スタッフ１",
    "text": "すみません、馴れ馴れしくて\r\nこいつ、ストレイライトさんのファンなんですよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018009020040,
    "speaker": "冬優子",
    "text": "わぁっ、そうなんですね……！",
