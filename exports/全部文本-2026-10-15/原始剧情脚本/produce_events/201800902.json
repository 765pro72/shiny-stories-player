    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201800902/2018009020040"
  },
  {
    "id": 2018009020050,
    "speaker": "冬優子",
    "text": "じゃあふゆも馴れ馴れしくしちゃおうかなぁ……\r\nいつも応援、ありがとう♡",
