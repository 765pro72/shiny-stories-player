    "waitType": "time",
    "waitTime": 3500
  },
  {
    "id": 3021007030140,
    "speaker": "円香",
    "text": "……\r\nやっぱり一本じゃ無理",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030140"
  },
  {
    "id": 3021007030150,
    "speaker": "円香",
    "text": "行くよ、もう一軒。コンビニ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030150"
  },
  {
    "id": 3021007030160,
    "speaker": "雛菜",
    "text": "ん～\r\nこのあたりにコンビニあった～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030160"
  },
  {
    "id": 3021007030170,
    "speaker": "円香",
    "text": "無いの？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030170"
  },
  {
    "id": 3021007030180,
    "speaker": "雛菜",
    "text": "うん～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030180"
  },
  {
    "textFrame": "off",
