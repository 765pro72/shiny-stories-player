    "waitTime": 600
  },
  {
    "id": 3021007030190,
    "speaker": "雛菜",
    "text": "じゃあ止むまで、雨宿りする～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030190"
  },
  {
    "id": 3021007030200,
    "speaker": "円香",
    "text": "どこで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030200"
  },
  {
    "id": 3021007030210,
    "speaker": "雛菜",
    "text": "そのへんのビルの下とか～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030210"
  },
  {
    "id": 3021007030220,
    "speaker": "円香",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030220"
  },
  {
    "id": 3021007030230,
    "speaker": "円香",
    "text": "じゃあ、そうすれば\r\n私は傘で帰る",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030230"
  },
  {
    "id": 3021007030240,
    "speaker": "雛菜",
    "text": "へ～！？",
