    "voice": "produce_events/302100703/3021007030010"
  },
  {
    "id": 3021007030020,
    "speaker": "円香",
    "text": "……何",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030020"
  },
  {
    "id": 3021007030030,
    "speaker": "雛菜",
    "text": "傘\r\n雛菜が持つ～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030030"
  },
  {
    "id": 3021007030040,
    "speaker": "円香",
    "text": "いい\r\n雛菜、真ん中で持たないから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030040"
  },
  {
    "id": 3021007030050,
    "speaker": "雛菜",
    "text": "へ～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030050"
  },
  {
    "id": 3021007030060,
    "speaker": "円香",
    "text": "雛菜が持ってた時、\r\n肩、っていうか８割濡れた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030060"
  },
  {
    "id": 3021007030070,
    "speaker": "雛菜",
    "text": "ん～\r\nそうだった～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030070"
  },
  {
    "id": 3021007030080,
    "speaker": "円香",
    "text": "そうだった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030080"
  },
  {
    "textFrame": "off",
    "se": "0247b",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 400
  },
  {
    "id": 3021007030090,
    "speaker": "雛菜",
    "text": "……だけど\r\n円香先輩もちゃんと持ててないでしょ～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030090"
  },
  {
    "id": 3021007030100,
    "speaker": "円香",
    "text": "なんで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030100"
  },
  {
    "id": 3021007030110,
    "speaker": "雛菜",
    "text": "傘、\r\n雛菜の頭に当たってるんですけど～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030110"
  },
  {
    "id": 3021007030120,
    "speaker": "円香",
    "text": "頭、下げれば",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030120"
  },
  {
    "id": 3021007030130,
    "speaker": "雛菜",
    "text": "へ～……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030130"
  },
  {
    "textFrame": "off",
    "se": "0247b",
