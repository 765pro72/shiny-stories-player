    "waitTime": 600
  },
  {
    "id": 3021007030420,
    "speaker": "円香",
    "text": "……後日、利子つけて請求するから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030420"
  },
  {
    "id": 3021007030430,
    "speaker": "雛菜",
    "text": "利子～～～？\r\n円香先輩、悪徳金融～……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030430"
  },
  {
    "id": 3021007030440,
    "speaker": "円香",
    "text": "雛菜が自分勝手な理由で逃げてもいいようにね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030440"
  },
  {
    "id": 3021007030450,
    "speaker": "雛菜",
    "text": "何それ～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030450"
  },
  {
    "id": 3021007030460,
    "speaker": "円香",
    "text": "たとえば交換日記\r\n毎日交換するとは決まってないって止めてた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030460"
  },
  {
    "id": 3021007030470,
    "speaker": "雛菜",
    "text": "へ～？\r\nそうだっけ～……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100703/3021007030470"
  },
