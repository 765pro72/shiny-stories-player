  },
  {
    "speaker": "プロデューサー",
    "text": "（…………うーん、やっぱり\r\n知らない曲が、いっぱい……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "（……お、この曲は知ってるぞ\r\n懐かしいな──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
