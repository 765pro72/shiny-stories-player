  {
    "id": 2004014020080,
    "speaker": "恋鐘",
    "text": "んふふ～、見んねプロデューサー！\r\n『都会の月』ばい～！",
    "charAnim1": "smile4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
