  {
    "speaker": "プロデューサー",
    "text": "……恋鐘、決めたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004014020120,
    "speaker": "恋鐘",
    "text": "うん！\r\n……こい！　長崎地鶏の親子丼～！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
