  },
  {
    "speaker": "広報担当スタッフ",
    "text": "もっとすごくなりますよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "撮影当日はオープン時と同じく、天球儀や月球儀を模した\r\nフローティングライトを浮かべる予定なので",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004014020020,
    "speaker": "恋鐘",
    "text": "よかね～！\r\nばりロマンチックばい！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401402/2004014020020"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "ふふ、ありがとうございます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "ナイトプールのキャッチコピーを、\r\n『今宵、都会の月に逢いに来て』とする予定でして",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004014020030,
    "speaker": "恋鐘",
    "text": "都会の月……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401402/2004014020030"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "はい！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close2",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "『都会の月』は月球が浮かぶ水面に、\r\n本物の月が映り込むプールを指すだけでなく──",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "0220"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "このプールでの素敵な出会いや、同行者の新たな一面……\r\nそういったものも含んでいます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004014020040,
    "speaker": "恋鐘",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401402/2004014020040"
  },
  {
    "id": 2004014020050,
    "speaker": "恋鐘",
    "text": "わくわくしながらプールに来て、\r\nドキドキしたり、はっとしたり～、って感じやろか～？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401402/2004014020050"
  },
  {
    "id": 2004014020060,
    "speaker": "恋鐘",
    "text": "こがん綺麗かプールで泳いどったら、\r\n絶対そがん気分になるばい～！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401402/2004014020060"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "ふふ、月岡さんに太鼓判を押していただいて\r\n私も安心いたしました",
    "charAnim2": "face_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "広報担当スタッフ",
    "text": "撮影当日もよろしくお願い申し上げます……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004014020070,
    "speaker": "恋鐘",
    "text": "はい……！\r\nうちに任せとってください……！！",
