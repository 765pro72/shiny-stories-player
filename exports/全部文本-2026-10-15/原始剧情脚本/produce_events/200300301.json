  {
    "id": 2003003010020,
    "speaker": "めぐる",
    "text": "お待たせ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010020"
  },
  {
    "id": 2003003010030,
    "speaker": "めぐる",
    "text": "えへへー、見て見て！\r\nプロデューサーがいるからポップコーン大盛にしちゃった！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010030"
  },
  {
    "id": 2003003010040,
    "speaker": "めぐる",
    "text": "始まったら、一緒に食べようね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "悪いな、めぐる。買いに行ってもらっちゃって\r\nいくらだった？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003003010050,
    "speaker": "めぐる",
    "text": "わぁ！？　お財布しまってプロデューサー！\r\nこれはね、お礼だからいいの！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "お礼？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003003010060,
    "speaker": "めぐる",
    "text": "そう！\r\n急に付き合ってくれてありがとう、のお礼！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010060"
  },
  {
    "id": 2003003010070,
    "speaker": "めぐる",
    "text": "だから気にしないで！\r\nじゃないとわたし、一緒に映画見れなくなっちゃう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんな、気を遣ってくれなくていいのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、ありがとな\r\nせっかくだから、ごちそうになるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003003010080,
    "speaker": "めぐる",
    "text": "良かったぁ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010080"
  },
  {
    "id": 2003003010090,
    "speaker": "めぐる",
    "text": "──うん！　どんどん食べて！　遠慮なくどうぞだよ！\r\nきっと、甘くて美味しいから！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010090"
  },
  {
    "textFrame": "off",
    "se": "0314",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "場内アナウンス",
    "text": "15時30分開始の──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2003003010100,
    "speaker": "めぐる",
    "text": "あ。入場、始まったみたい\r\n──行こっ、プロデューサー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300301/2003003010100"
  },
  {
    "textFrame": "off",
    "effectLabel": "white1",
