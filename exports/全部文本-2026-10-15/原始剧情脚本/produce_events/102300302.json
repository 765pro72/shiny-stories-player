      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/102300302/1023003020080"
  },
  {
    "id": 1023003020090,
    "speaker": "雛菜",
    "text": "今日も頑張った雛菜に\r\nご褒美の差し入れ募集中です～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300302/1023003020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……うん\r\nご褒美……ってほどのものはないけど",
    "charAnim2": "face_wait",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hinana",
    "textFrame": "off",
