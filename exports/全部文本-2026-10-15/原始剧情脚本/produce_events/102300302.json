  },
  {
    "speaker": "男子高生アイドル",
    "text": "──……雛菜ちゃんは今回、どうして参加したの？\r\n迷ったりしなかった？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1023003020050,
    "speaker": "雛菜",
    "text": "…………？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
