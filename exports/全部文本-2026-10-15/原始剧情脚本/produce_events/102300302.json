  {
    "speaker": "男子高生アイドル",
    "text": "──台本とか無しで、\r\n本当にいきなり始まるんだね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1023003020010,
    "speaker": "雛菜",
    "text": "…………！\r\nあ、えっと～……？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
