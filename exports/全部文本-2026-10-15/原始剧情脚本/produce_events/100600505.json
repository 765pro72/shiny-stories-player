    },
    "voice": "produce_events/100600505/1006005050100"
  },
  {
    "id": 1006005050110,
    "speaker": "咲耶",
    "text": "モデルになるよって言ってから……３年も経っていない\r\n心変わりが早すぎるかな",
    "charAnim1": "sad1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050110"
  },
  {
    "id": 1006005050120,
    "speaker": "咲耶",
    "text": "…………でもね\r\nあのままでいたら、寂しくてたまらなくなりそうだった",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050120"
  },
  {
    "id": 1006005050130,
    "speaker": "咲耶",
    "text": "私は欲張りだから",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050130"
  },
  {
    "id": 1006005050140,
    "speaker": "咲耶",
    "text": "もっとたくさんの人たちと、まだ知らない人たちと、\r\n出会って、繋がって、親しくなりたくて──",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050140"
  },
  {
    "id": 1006005050150,
    "speaker": "咲耶",
    "text": "そんな時に、プロデューサーが声をかけてくれた",
    "charAnim1": "wait1",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050150"
  },
  {
    "id": 1006005050160,
    "speaker": "咲耶",
    "text": "とてもいい人なんだよ！",
    "charAnim1": "surp1",
    "charAnim2": "face_surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050160"
  },
  {
    "id": 1006005050170,
    "speaker": "咲耶",
    "text": "仕事の合間に私のレッスンを見に来てくれたり、\r\n送迎とかも、こちらが恐縮するくらいマメに対応してくれて",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050170"
  },
  {
    "id": 1006005050180,
    "speaker": "咲耶",
    "text": "おじいちゃんとおばあちゃんも\r\n素敵な方だねって言っていたし",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050180"
  },
  {
    "id": 1006005050190,
    "speaker": "咲耶",
    "text": "うちに挨拶に来てくれた時は、お父さんたちに\r\nお線香もあげてくれて──ってこれは知ってるか",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050190"
  },
  {
    "id": 1006005050200,
    "speaker": "咲耶",
    "text": "とにかく熱心で、まっすぐで",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050200"
  },
  {
    "id": 1006005050210,
    "speaker": "咲耶",
    "text": "……私の気持ちを大切にしてくれる人なんだ",
