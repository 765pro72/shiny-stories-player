    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600505/1006005050210"
  },
  {
    "id": 1006005050220,
    "speaker": "咲耶",
    "text": "それにね……『どれだけたくさんの私を\r\n世の中に届けられるんだろう』って──",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
