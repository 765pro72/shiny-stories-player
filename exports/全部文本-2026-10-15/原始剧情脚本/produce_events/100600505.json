  {
    "id": 1006005050100,
    "speaker": "咲耶",
    "text": "……私ね、アイドルになることにしたんだ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
