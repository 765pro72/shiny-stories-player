    "bgEffect": "mask"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……有栖川夏葉さん、か。いいところの\r\nお嬢様みたいだけど、いったいどんな子だろう……）",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0121"
  },
  {
    "id": 1013001010010,
    "speaker": "夏葉",
