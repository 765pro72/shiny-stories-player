    }
  },
  {
    "id": 1013001010020,
    "speaker": "夏葉",
    "text": "アナタが私のプロデューサーね？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、君が有――",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010030,
    "speaker": "夏葉",
    "text": "いい？　目指すならトップだけよ！",
    "charAnim2": "face_anger1",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……え、えーっと？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010040,
    "speaker": "夏葉",
    "text": "あら、何を呆けているのかしら\r\n当然のことでしょう！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010040"
  },
  {
    "id": 1013001010050,
    "speaker": "夏葉",
    "text": "アイドルだろうとなんだろうと、\r\n世界一以外の目標はありえないわ！",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010050"
  },
  {
    "id": 1013001010060,
    "speaker": "夏葉",
    "text": "アナタも私のプロデューサーなら\r\nそのつもりでいなさい！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……わかった。じゃあ、そのために\r\nどうすればいいか、一緒に考えていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010070,
    "speaker": "夏葉",
    "text": "いいえ、その必要はないわ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "どういうことだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010080,
    "speaker": "夏葉",
    "text": "アイドルのプロデュースならアナタのほうが\r\n経験があるかもしれないけど",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010080"
  },
  {
    "id": 1013001010090,
    "speaker": "夏葉",
    "text": "有栖川夏葉のプロデュースなら私のほうが\r\n経験が長いというだけの話よ",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010090"
  },
  {
    "id": 1013001010100,
    "speaker": "夏葉",
    "text": "だからアナタは何も考えなくていいの\r\n全部私に任せておきなさい",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……さすがにそういうわけにもいかないけど、\r\n君の意見はできるだけ取り入れていくことにしよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それと、君には『放課後クライマックスガールズ』という\r\n五人組ユニットで活動してもらうことになっているが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010110,
    "speaker": "夏葉",
    "text": "別にいいわよ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010110"
  },
  {
    "id": 1013001010120,
    "speaker": "夏葉",
    "text": "ソロだろうとユニットだろうと、\r\n私がトップを目指すことには変わりないもの",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nじゃあ、これからよろしく頼むよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013001010130,
    "speaker": "夏葉",
    "text": "ええ\r\nしっかり私についてきなさい、プロデューサー",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300002/1013001010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……清楚なお嬢様を想像してたけど、\r\nかなり芯の強い女の子なんだな）",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、この個性をなるべく活かしていけるよう\r\n頑張ってプロデュースしていこう）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "end"
  }
