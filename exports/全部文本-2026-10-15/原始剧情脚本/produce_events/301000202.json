    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020130"
  },
  {
    "id": 3010002020140,
    "speaker": "凛世",
    "text": "はい……ありがとうございます……",
