    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020070"
  },
  {
    "id": 3010002020080,
    "speaker": "夏葉",
    "text": "凛世はどうする？　一緒に来るなら、\r\nアナタに似合う服も探してみたいと思ってるんだけど！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020080"
  },
  {
    "id": 3010002020090,
    "speaker": "智代子",
    "text": "そうだよ！　凛世ちゃんも一緒にお買い物行こう？\r\nきっと楽しいよ～",
