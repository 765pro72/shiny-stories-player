    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020150"
  },
  {
    "id": 3010002020160,
    "speaker": "凛世",
    "text": "お誘いいただいて遊ぶ……ということが……\r\nあまりなかったものですから……",
