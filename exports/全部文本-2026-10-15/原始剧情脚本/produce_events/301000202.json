    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020060"
  },
  {
    "id": 3010002020070,
    "speaker": "智代子",
    "text": "やったーありがとう！　頼りにしてます夏葉先生！",
