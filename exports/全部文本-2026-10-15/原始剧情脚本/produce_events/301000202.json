    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301000202/3010002020140"
  },
  {
    "id": 3010002020150,
    "speaker": "凛世",
    "text": "洋服には……興味があります……\r\nただ……",
