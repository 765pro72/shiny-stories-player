    "voice": "produce_events/200201902/2002019020120"
  },
  {
    "id": 2002019020130,
    "speaker": "灯織",
    "text": "プロデューサーが私にこれまでしてきてくれたように、\r\n私も事務所の後輩たちを支えていきたいんです",
    "textCtrl": "p",
    "textFrame": "001",
