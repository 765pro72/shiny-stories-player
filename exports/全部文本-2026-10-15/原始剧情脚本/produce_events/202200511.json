    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、そうじゃなくて……",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "002"
  },
