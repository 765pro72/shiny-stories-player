  },
  {
    "id": 2022005110070,
    "speaker": "小糸",
    "text": "な、なんかきょろきょろしてますけど……",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110070"
  },
  {
    "id": 2022005110080,
    "speaker": "小糸",
    "text": "あ、そっか……\r\nお、お手洗いなら確か──",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charAnim4": "eye_right",
