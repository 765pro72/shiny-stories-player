  {
    "id": 2022005110130,
    "speaker": "小糸",
    "text": "……『──13歳、かつて子役として活躍\r\n現在はモデルとしても活動中』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110130"
  },
  {
    "id": 2022005110140,
    "speaker": "小糸",
    "text": "『子役の頃からずっと小さな目標をいくつも立てて、\r\nひとつずつクリアしていくようにしています』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110140"
  },
  {
    "id": 2022005110150,
    "speaker": "小糸",
    "text": "『モデルとしての活動もその連続\r\nもちろん、演技のレッスンも続けています』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110150"
  },
  {
    "id": 2022005110160,
    "speaker": "小糸",
    "text": "『いつか世代を代表する女優になる』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110160"
  },
  {
    "id": 2022005110170,
    "speaker": "小糸",
    "text": "『今は大きな目標ですが、それも\r\nいつか小さな目標のひとつになると思っています』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110170"
  },
  {
    "id": 2022005110180,
    "speaker": "小糸",
    "text": "『だからこれは、\r\n神様にお願いする必要は無さそうですね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だそうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005110190,
    "speaker": "小糸",
    "text": "──なんだ…………",
    "charAnim1": "wait4",
