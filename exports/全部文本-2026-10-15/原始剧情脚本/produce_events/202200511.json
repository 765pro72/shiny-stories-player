      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202200511/2022005110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだけどさ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005110030,
    "speaker": "小糸",
    "text": "そ、そんなんじゃ\r\nわたし、先に行っちゃいますよ……！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……小糸、体力づくりの\r\n結果が出てきたみたいだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005110040,
    "speaker": "小糸",
    "text": "えっへん！\r\nこのくらいよゆーですよ！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110040"
  },
  {
    "id": 2022005110050,
    "speaker": "小糸",
    "text": "ほら、あと10段で到着です！\r\nもう見えてますよ……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200511/2022005110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おう……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
