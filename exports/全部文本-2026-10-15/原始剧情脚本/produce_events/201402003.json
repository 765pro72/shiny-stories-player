    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201402003/2014020030190"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "必要なことだけど\r\nしすぎると、自信がなくなっちゃうからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020030200,
    "speaker": "甘奈",
    "text": "……\r\nそういう考え方もあるんだね……",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030200"
  },
  {
    "id": 2014020030210,
    "speaker": "甘奈",
    "text": "ん……？　でも\r\nプロデューサーさん、さっき……",
