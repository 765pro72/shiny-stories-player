  {
    "id": 2014020030070,
    "speaker": "甘奈",
    "text": "じゃあ、ひとつめの質問！",
    "charAnim1": "wait3",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
