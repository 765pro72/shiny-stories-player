    },
    "voice": "produce_events/201402003/2014020030070"
  },
  {
    "id": 2014020030080,
    "speaker": "甘奈",
    "text": "プロデューサーさんは、いつも活き活きと仕事をしてて\r\nすごく輝いてると思うんだけど──",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030080"
  },
  {
    "textFrame": "off",
    "se": "1106",
    "waitType": "time",
    "waitTime": 700
  },
  {
    "speaker": "プロデューサー",
    "text": "──ちょ、ちょっと待ってくれ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020030090,
    "speaker": "甘奈",
    "text": "……？\r\nどうしたの？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっきのもだが\r\n少しほめ過ぎだ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "さすがに過大評価じゃ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020030100,
    "speaker": "甘奈",
    "text": "ううん、そんなことないよっ",
    "charAnim1": "wait4",
    "charAnim2": "face_anger",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "1953",
    "voice": "produce_events/201402003/2014020030100"
  },
  {
    "id": 2014020030110,
    "speaker": "甘奈",
    "text": "プロデューサーさんは、いつだって甘奈たちと\r\n真剣に向き合ってくれるし",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030110"
  },
  {
    "id": 2014020030120,
    "speaker": "甘奈",
    "text": "必要な時は、ちゃんと意見をくれる\r\nすごくしっかりした人だもん！",
    "charAnim1": "surp1",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030120"
  },
  {
    "id": 2014020030130,
    "speaker": "甘奈",
    "text": "そんな人が、輝いてないわけないと思う！",
    "charAnim1": "smile2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nはは、そっか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、その評価はありがたく\r\nいただいておくよ、ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait3",
