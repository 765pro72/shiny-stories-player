    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030220"
  },
  {
    "id": 2014020030230,
    "speaker": "甘奈",
    "text": "プロデューサーさんの良い所なら\r\nまだまだ言えるよ？",
