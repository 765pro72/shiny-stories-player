    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030180"
  },
  {
    "id": 2014020030190,
    "speaker": "甘奈",
    "text": "プロデューサーさん、ありがと……！\r\nめっちゃ勇気もらえたよ",
