    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201402003/2014020030230"
  },
  {
    "speaker": "プロデューサー",
    "text": "……じゃあ、へこむことがあった時に\r\n聞かせてもらうよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020030240,
    "speaker": "甘奈",
    "text": "えへへ、任せてっ！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201402003/2014020030240"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "はは、楽しくなってきたな、って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014020030250,
    "speaker": "甘奈",
