    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202111/2002021110070"
  },
  {
    "id": 2002021110080,
    "speaker": "灯織",
    "text": "練習の時、プロデューサーが言ってくれたことが\r\nすごくしっくりくるなって思いました",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
