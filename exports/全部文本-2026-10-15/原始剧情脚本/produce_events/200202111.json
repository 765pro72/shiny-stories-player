  {
    "id": 2002021110090,
    "speaker": "灯織",
    "text": "それでも、何気ない言葉が\r\n私にはすごく響きました",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202111/2002021110090"
  },
  {
    "id": 2002021110100,
    "speaker": "灯織",
    "text": "『頼ったり、甘えたりはもちろん、心配かけたり、\r\nかけられたりする』関係……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202111/2002021110100"
  },
  {
    "id": 2002021110110,
    "speaker": "灯織",
    "text": "とても素敵だなって、今は思ってます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200202111/2002021110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、俺もそう思うよ",
    "textCtrl": "p",
    "textFrame": "002"
