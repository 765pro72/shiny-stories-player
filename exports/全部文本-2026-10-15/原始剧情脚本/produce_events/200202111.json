    "se": "1522",
    "waitType": "time",
    "waitTime": 1900
  },
  {
    "speaker": "プロデューサー",
    "text": "こっちもしっかり書いてくれて……\r\nうん、ばっちりだな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002021110060,
    "speaker": "灯織",
    "text": "──その原稿の質問コーナーにも『理想の結婚生活は？』\r\nというのがあったんです",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
