  {
    "speaker": "プロデューサー",
    "text": "……すまん、やっぱり驚かせちゃったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020030,
    "speaker": "真乃",
    "text": "プロデューサーさん……っ\r\nお疲れさまですっ",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃もお疲れ様\r\nどうした？　今日はお休みだったよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
