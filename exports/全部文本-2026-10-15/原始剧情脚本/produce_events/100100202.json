  },
  {
    "charAnim4": "eye_left",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 1001002020040,
    "speaker": "真乃",
    "text": "そのっ……私、プロデューサーさんに差し入れを、\r\nって思って……たい焼きを持ってきたんです……けど……",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020040"
  },
  {
    "id": 1001002020050,
    "speaker": "真乃",
    "text": "公園に、鳩さんがたくさんいたので……\r\n少し、寄ってしまって……",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020050"
  },
  {
    "id": 1001002020060,
    "speaker": "真乃",
    "text": "……",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか\r\n差し入れなんてごめんな、気を遣わせて──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020070,
    "speaker": "真乃",
    "text": "ち、違うんですっ……",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020070"
  },
  {
    "id": 1001002020080,
    "speaker": "真乃",
    "text": "たい焼きは、応援の気持ち……なので……\r\n私からも、お渡しできたら、って……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "それ、リハーサルの時にも言ってたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ありがとう、嬉しいよ",
    "charAnim2": "face_surp",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020090,
    "speaker": "真乃",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……公園のステージは、今日も大盛況だったな\r\nやっぱり、最初から真乃の声に惹かれてた子たちは違う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020100,
    "speaker": "真乃",
    "text": "ふふっ……",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020100"
  },
  {
    "id": 1001002020110,
    "speaker": "真乃",
    "text": "ここで歌っていると、\r\n鳩さんたちはよく聞きに来てくれます",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020110"
  },
  {
    "id": 1001002020120,
    "speaker": "真乃",
    "text": "……こうしていると、なんだか……\r\n私、前と変わっていないみたいです",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……『アイドルになってみる気はない？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020130,
    "speaker": "真乃",
    "text": "えっ……？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "『アイドルになって、\r\n今までとは違う世界を見てみないか？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020140,
    "speaker": "真乃",
    "text": "プロデューサーさん……？\r\n私、もう──",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020140"
  },
  {
    "id": 1001002020150,
    "speaker": "真乃",
    "text": "！\r\nあ……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "──返事、聞かせてもらってもいいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020160,
    "speaker": "真乃",
    "text": "はい……\r\nあの……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020160"
  },
  {
    "id": 1001002020170,
    "speaker": "真乃",
    "text": "お気持ちはうれしいです……でも\r\n私はもう、イルミネーションスターズの櫻木真乃なんです",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020170"
  },
  {
    "id": 1001002020180,
    "speaker": "真乃",
    "text": "だから──……\r\n新しくアイドルになることはできません",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020180"
  },
  {
    "id": 1001002020190,
    "speaker": "真乃",
    "text": "灯織ちゃんと、めぐるちゃんの隣で……\r\nアイドルをやっていますから……っ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100202/1001002020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "──それは残念",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ってことで、スカウトの人は退散だ\r\n今度は真乃のプロデューサーとして言わせてくれ",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうふうに思っててくれてありがとう、真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001002020200,
    "speaker": "真乃",
    "text": "いえ──",
    "charAnim1": "wait3",
