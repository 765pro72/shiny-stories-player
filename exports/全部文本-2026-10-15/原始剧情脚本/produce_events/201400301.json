[
  {
    "speaker": "プロデューサー",
    "text": "（ん？　甘奈だ\r\nもうレッスンは終わったはずだけど）",
    "charAnim1": "wait",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002",
