  },
  {
    "id": 2014003010170,
    "speaker": "甘奈",
    "text": "えへへ、違うよ～\r\n甘奈じゃなくて、甜花ちゃんにどうかなって聞いたの☆",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そういう意味だったのか\r\n今までずっと甘奈の服のことだと思ってたよ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことなら……そうだな……\r\nこれなら甜花にも似合うと思うぞ！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014003010180,
    "speaker": "甘奈",
    "text": "だよねっ☆\r\n甜花ちゃんがこれ着たら絶対かわいーよ～",
    "charAnim1": "anger1",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010180"
  },
  {
    "id": 2014003010190,
    "speaker": "甘奈",
    "text": "まぁ、甜花ちゃんは何でも似合っちゃうんだけどね☆",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "しかし、甘奈は雑誌を見るときでも\r\n甜花のことを考えているんだな",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014003010200,
    "speaker": "甘奈",
    "text": "えへへ、そうだね\r\nついつい甜花ちゃんのことばっかり考えちゃう",
    "charAnim1": "shy1",
    "charLipAnim": "lip_smile2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010200"
  },
  {
    "id": 2014003010210,
    "speaker": "甘奈",
    "text": "だからさっきのは不意打ちだったかも",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "さっき……\r\nああ、間違えたことか",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014003010220,
    "speaker": "甘奈",
    "text": "うん、甘奈に似合いそうだって",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなに驚かせるつもりはなかったんだけどな",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014003010230,
    "speaker": "甘奈",
    "text": "うーん\r\nびっくりしたって言うより……",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010230"
  },
  {
    "id": 2014003010240,
    "speaker": "甘奈",
    "text": "嬉しかったかも",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、そうか",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014003010250,
    "speaker": "甘奈",
    "text": "さ、さーて\r\nそろそろ甘奈帰るねっ！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_sad",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400301/2014003010250"
  },
  {
    "id": 2014003010260,
    "speaker": "甘奈",
    "text": "バイバーイ、プロデューサーさん☆",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
