    "textFrame": "001",
    "voice": "produce_events/200400511/2004005110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、そうだったのか！\r\n……悪いな、かえって──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004005110260,
    "speaker": "恋鐘",
    "text": "う、ううん！　ううん！\r\nほんとに、嬉しかったとよ",
