  },
  {
    "id": 5005002030360,
    "speaker": "愛依",
    "text": "いやいやまだまだだし！\r\nあさひちゃんに比べたら月と…………ニッポン、みたいな！",
    "charAnim1": "serious",
    "charAnim2": "face_sad",
