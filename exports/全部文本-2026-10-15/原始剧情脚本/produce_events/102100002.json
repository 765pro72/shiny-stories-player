  {
    "id": 1021001010010,
    "speaker": "？？？",
    "text": "──あの、すみません",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
