  {
    "id": 1021001010020,
    "speaker": "？？？",
    "text": "２８３プロダクションの方でしょうか？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100002/1021001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええ、そうです\r\n……失礼ですがあなたは……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001010030,
    "speaker": "？？？",
    "text": "急にすみません\r\n私、アイドルに興味があるんです",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100002/1021001010030"
  },
  {
    "id": 1021001010040,
    "speaker": "？？？",
    "text": "よかったらお話を伺えないでしょうか？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100002/1021001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まっすぐで、綺麗な瞳だ……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかりました\r\n事務所にご案内しますね、どうぞ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001010050,
    "speaker": "？？？",
    "text": "事務所の中は……ちょっと",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charAnim4": "eye_right",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100002/1021001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021001010060,
    "speaker": "？？？",
    "text": "軽くお話が聞ければ十分ですので\r\n近くの喫茶店では……いかがでしょう？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100002/1021001010060"
  },
