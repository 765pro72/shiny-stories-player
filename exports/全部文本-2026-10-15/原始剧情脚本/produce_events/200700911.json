    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700911/2007009110130"
  },
  {
    "id": 2007009110140,
    "speaker": "結華",
    "text": "今の流れでそんなことが言いたいわけないじゃん",
