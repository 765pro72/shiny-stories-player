    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700911/2007009110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、すまんすまん……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
