    "voice": "produce_events/200700911/2007009110140"
  },
  {
    "id": 2007009110150,
    "speaker": "結華",
    "text": "嬉しいなぁって思ったんだよ\r\nプロデューサーにとってもそうだったんだなぁって",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
