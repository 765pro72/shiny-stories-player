    "voice": "produce_events/200700911/2007009110030"
  },
  {
    "id": 2007009110040,
    "speaker": "結華",
    "text": "Ｐたんとだったら、どこで何食べても美味しいご飯だもん",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700911/2007009110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\n常日頃焼肉を要求してくる人間の言葉とは思えない……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009110050,
    "speaker": "結華",
    "text": "こら～？\r\n人がフォローしてんのにどういうことだ～？",
