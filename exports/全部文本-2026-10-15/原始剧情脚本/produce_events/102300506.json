    "charLabel": "hinana",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "女子生徒３",
    "text": "応援は正直、まだできないけど……\r\nアイドル、続けてほしいって思う。これからも",
    "textCtrl": "p",
    "textFrame": "003"
  },
