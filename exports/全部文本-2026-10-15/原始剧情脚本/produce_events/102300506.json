  {
    "speaker": "女子生徒３",
    "text": "あれ、私のことなんだ\r\n友達の話なんかじゃなくて、私のこと",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait1",
