    "textFrame": "001",
    "voice": "produce_events/200600801/2006008010210"
  },
  {
    "id": 2006008010220,
    "speaker": "咲耶",
    "text": "そして私は……どこにいても、どんなアナタでも、\r\n迷わずにその手を取るだろう",
