    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600801/2006008010230"
  },
  {
    "id": 2006008010240,
    "speaker": "咲耶",
    "text": "そして私は、何度だって\r\nアナタに連れて行ってもらう",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
