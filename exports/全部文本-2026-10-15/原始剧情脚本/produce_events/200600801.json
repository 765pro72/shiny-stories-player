    "textFrame": "001",
    "voice": "produce_events/200600801/2006008010280"
  },
  {
    "id": 2006008010290,
    "speaker": "咲耶",
    "text": "世界が変わっても、アナタは私を\r\n何度だって見付けてくれる",
