    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600801/2006008010170"
  },
  {
    "id": 2006008010180,
    "speaker": "咲耶",
