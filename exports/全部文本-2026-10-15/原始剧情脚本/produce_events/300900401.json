    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010280"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "ですよねっ！　昔、友達とやった\r\nヒーローごっこ、楽しかったなぁ……！",
