    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010370"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "それと、凛世さんは冷静ちんちゃく？　な感じが、\r\n悪の組織の大幹部にピッタリです！",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010380"
  },
  {
    "id": null,
    "speaker": "凛世",
