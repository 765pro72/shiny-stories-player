  {
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile_s",
    "charLabel": "rinze"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "それにアルファは、変身した後のアクションも、\r\nスッゴくカッコいいんですよ！",
