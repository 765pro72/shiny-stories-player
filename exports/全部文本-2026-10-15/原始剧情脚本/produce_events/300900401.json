  },
  {
    "id": null,
    "speaker": "樹里",
    "text": "へー\r\nほんとおまえ、ヒーローのこと好きだよな",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010080"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "はい！　ヒーローってスッゴくカッコいいんです！\r\nほら、こんな感じで……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
