    "voice": "produce_events/300900401/3009004010090"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "「うけてみろ！　ジャスティーンソード！」\r\n……とか！",
    "charAnim1": "smile1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
