    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010260"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "こう、すっと来て、バッとなって、\r\nえいっ、って敵をやっつけちゃうんです！",
