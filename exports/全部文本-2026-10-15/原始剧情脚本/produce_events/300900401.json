    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010400"
  },
  {
    "id": null,
    "speaker": "樹里",
    "text": "まぁ、参謀みたいなもんかな\r\n大物で、いつも落ち着いてて……",
