    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900401/3009004010390"
  },
  {
    "id": null,
    "speaker": "凛世",
    "text": "樹里さん、それはどういうものなのでしょう？",
