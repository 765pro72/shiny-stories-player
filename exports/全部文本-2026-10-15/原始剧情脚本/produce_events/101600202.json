    },
    "bg": "00011",
    "bgm": "041"
  },
  {
    "id": 1016002020010,
    "speaker": "千雪",
    "text": "え……？",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、さすがにいちごミルクを毎日飲むわけには\r\nいかなかったからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お茶の方だったら、好きなもの──\r\n幸せの括りに入れられるかなと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020020,
    "speaker": "千雪",
    "text": "わぁ……！　ふふっ",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020020"
  },
  {
    "id": 1016002020030,
    "speaker": "千雪",
    "text": "それなら、『マロウのハーブティー』ですよ、 \r\nプロデューサーさん",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "『マロウのハーブティー』……\r\n『マロウ』……『マロウ』な……覚えるぞ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020040,
    "speaker": "千雪",
    "text": "……はいっ",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020040"
  },
  {
    "id": 1016002020050,
    "speaker": "千雪",
    "text": "…………",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad2_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020050"
  },
  {
    "id": 1016002020060,
    "speaker": "千雪",
    "text": "……あの、ええと……\r\n……この間の続き、なんですけど……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020070,
    "speaker": "千雪",
    "text": "……プロデューサーさんから見る、今の私は……\r\nどうでしょうか……？",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、それは──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020080,
    "speaker": "千雪",
    "text": "……い、いえ……その\r\nあの時……私のことは、教えてもらえなかったので……",
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020080"
  },
  {
    "id": 1016002020090,
    "speaker": "千雪",
    "text": "……よければ\r\n聞いてみたいなぁ、なんて……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういえば、そうだったか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "chiyuki",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "（──出会った時から、千雪が変わったかどうか……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（笑顔はもちろん、変わらない……\r\n仕事に対しての姿勢も、ずっと真摯で……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020100,
    "speaker": "千雪",
    "text": "……答えにくいでしょうか……？",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600202/1016002020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、いや、そういうわけじゃなくて……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……千雪はさ、大事な、芯の部分は\r\n変わらずいてくれる人だって思ってるから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "どこが変わったっていうと、その──…… \r\n説明が難しいんだけど……",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪の夢は叶いつつあって……\r\nそのことがきっと、千雪にとっての大きな変化なんだと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そう、思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020110,
    "speaker": "千雪",
    "text": "わ……そんなふうに、考えてくださってたんですね\r\n……ありがとうございます",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020110"
  },
  {
    "id": 1016002020120,
    "speaker": "千雪",
    "text": "…………",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020120"
  },
  {
    "id": 1016002020130,
    "speaker": "千雪",
    "text": "──私、この感謝祭で\r\nまた夢が叶ったんです",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020130"
  },
  {
    "id": 1016002020140,
    "speaker": "千雪",
    "text": "アルストロメリアとして、より大きな舞台に立てたこと、\r\nお客さんに直接感謝の気持ちを伝えられたこと……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020140"
  },
  {
    "id": 1016002020150,
    "speaker": "千雪",
    "text": "そして、わかったことがあって……\r\n……ハッピーエンドの、先には──",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "──新しい夢、か……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020160,
    "speaker": "千雪",
    "text": "……！\r\nはい……！",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020160"
  },
  {
    "id": 1016002020170,
    "speaker": "千雪",
    "text": "……だから、今の私には\r\nもうたくさんの新しい夢が生まれてるんです",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020170"
  },
  {
    "id": 1016002020180,
    "speaker": "千雪",
    "text": "もっともっと大きなステージとか……\r\nアルストロメリアとして経験する未来",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020180"
  },
  {
    "id": 1016002020190,
    "speaker": "千雪",
    "text": "それから、プロデューサーさんと一緒に\r\nマロウのハーブティーを飲むこと",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、そうか\r\nそれなら、俺はさ",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからも、新しい夢を叶える──\r\n千雪が変わっていくための、手伝いをさせてほしいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002020200,
    "speaker": "千雪",
    "text": "……はいっ\r\nもちろんです、プロデューサーさん",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600202/1016002020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nそれじゃあ、さしあたっては……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "99999",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "──すみません、\r\nマロウのハーブティーを、ふたつ──……",
    "textCtrl": "p",
