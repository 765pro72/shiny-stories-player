[
  {
    "speaker": "プロデューサー",
    "text": "──なんて言ったっけな、あの……\r\n『色の変わるお茶』……",
    "charAnim1": "wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002",
