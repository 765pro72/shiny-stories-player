  {
    "id": 1013005020160,
    "speaker": "夏葉",
    "text": "……こんにちは\r\nアナタも課題？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
