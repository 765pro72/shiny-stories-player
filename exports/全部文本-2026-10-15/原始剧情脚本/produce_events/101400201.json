[
  {
    "id": 1014002010010,
    "speaker": "甘奈",
    "text": "──コーヒー、お待たせしました☆\r\nブラックで良いんだよねー？",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
