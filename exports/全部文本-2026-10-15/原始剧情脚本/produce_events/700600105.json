[
  {
    "speaker": "プロデューサー",
    "text": "咲耶\r\nちょっといいかな？",
    "charAnim1": "wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "006",
    "charPosition": {
