[
  {
    "id": 7016001050010,
    "speaker": "千雪",
    "text": "プロデューサーさん\r\n三次審査の結果、どうでしたか……？",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
