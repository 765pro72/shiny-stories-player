  {
    "speaker": "プロデューサー",
    "text": "ただいま戻りました……──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00371",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "なんてな、誰もいないのに──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2001011110010,
    "speaker": "真乃",
    "text": "……プロデューサーさん……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110010"
  },
  {
    "textFrame": "off",
    "bg": "00060",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2001011110020,
    "speaker": "真乃",
    "text": "お疲れさまです\r\nおかえりなさいです……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040010050",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200101111/2001011110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれ、真乃……はは、いたのか\r\nどうしたんだ、電気も点けずに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110030,
    "speaker": "真乃",
    "text": "あっ……す、すみません\r\n今日は、お星様が綺麗だなって……",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110030"
  },
  {
    "id": 2001011110040,
    "speaker": "真乃",
    "text": "……その、電気を消した方が\r\nよく見えるような気がして……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな──",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110050,
    "speaker": "真乃",
    "text": "あのっ、勝手にすみません\r\nすぐ電気点けますね──",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、いや、いいんだ真乃\r\nせっかくだしさ、俺も見てみようかな、星",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110060,
    "speaker": "真乃",
    "text": "……ほわ……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃のとなり、いいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110070,
    "speaker": "真乃",
    "text": "あっ、は、はいっ\r\nもちろんです……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110070"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00342",
    "bgEffect": "fade",
    "se": "0220",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "bgm": "0052",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "──おお！　すごい星空だ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110080,
    "speaker": "真乃",
    "text": "はい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……本当に綺麗だな\r\n──はは、代わり映えしないコメントだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110090,
    "speaker": "真乃",
    "text": "……ふふ、いえ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110090"
  },
  {
    "id": 2001011110100,
    "speaker": "真乃",
    "text": "とっても、綺麗な星空です……っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00060",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110110,
    "speaker": "真乃",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110110"
  },
  {
    "textFrame": "off",
    "bg": "00371",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2001011110120,
    "speaker": "真乃",
    "text": "……昔、落ち込んだりしたとき",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110130,
    "speaker": "真乃",
    "text": "こうやって、星空を見上げて\r\n元気をもらっていました……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110130"
  },
  {
    "textFrame": "off",
    "bg": "00342",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2001011110140,
    "speaker": "真乃",
    "text": "お星様のまたたきを見ていると\r\n大丈夫だよってお話をしてくれているように思えて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110140"
  },
  {
    "id": 2001011110150,
    "speaker": "真乃",
    "text": "それが心地よくて……心強くて……\r\n私は、いつも励まされていました",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110150"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2001011110160,
    "speaker": "真乃",
    "text": "……私も、誰かにとってそうあれたらって……\r\nそんなアイドルになりたいって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110160"
  },
  {
    "id": 2001011110170,
    "speaker": "真乃",
    "text": "そう、思います……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110180,
    "speaker": "真乃",
    "text": "……まだまだ遠いかもしれませんけれど……\r\nいつか、きっと……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110180"
  },
  {
    "textFrame": "off",
    "bg": "00060",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃なら、必ずなれるよ\r\n……それに真乃はもう──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mano",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "──…………",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……真乃が心の底から望むことなら\r\n俺も一緒に頑張るよ。……真乃がそう思えるように",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110190,
    "speaker": "真乃",
    "text": "プロデューサーさん……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110190"
  },
  {
    "id": 2001011110200,
    "speaker": "真乃",
    "text": "私も、プロデューサーさんが\r\n一緒だと、とってもうれしいです……",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、よかった",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "焦らず、一歩ずつでも……\r\n理想に近づけたって思えるように進んでいこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110210,
    "speaker": "真乃",
    "text": "はいっ\r\n精一杯頑張ります……っ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん。──さて、気合も入れたところで\r\n今日はもう遅いから、そろそろ帰ろうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110220,
    "speaker": "真乃",
    "text": "ほわ……もうこんな時間……っ\r\nす、すみません、付き合わせてしまって……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、気にしないでくれ\r\n綺麗な星が見れてよかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "車出そうと思うけど、真乃はもう行けるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110230,
    "speaker": "真乃",
    "text": "は、はいっ\r\n荷物はまとめてあるので、すぐに行けますっ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101111/2001011110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、じゃあ行こうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001011110240,
    "speaker": "真乃",
    "text": "はい……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
