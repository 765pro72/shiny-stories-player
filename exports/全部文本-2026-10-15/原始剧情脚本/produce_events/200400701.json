    "voiceKeep": true
  },
  {
    "id": 2004007010120,
    "speaker": "恋鐘",
    "text": "そ、そいやったら、あの……──",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "id": 2004007010130,
    "speaker": "恋鐘",
    "text": "あの……うち…………\r\n…………どっか、行きたか……",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400701/2004007010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？　……どっか、って……\r\n──帰るんじゃなくって？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004007010140,
    "speaker": "恋鐘",
    "text": "うん～……！　ど、どこでもよかけん、どっか──\r\nぐ～～～ん！　って行きたか……！",
    "charAnim1": "smile2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400701/2004007010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ぐ～ん………………\r\nはははっ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait5",
