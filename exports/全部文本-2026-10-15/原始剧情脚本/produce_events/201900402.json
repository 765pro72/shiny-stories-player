    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900402/2019004020110"
  },
  {
    "id": 2019004020120,
    "speaker": "愛依",
    "text": "あ、うちが飲んでるこれもタピ入った\r\nミルクティーだし",
