    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900402/2019004020100"
  },
  {
    "id": 2019004020110,
    "speaker": "愛依",
    "text": "ん～……　なんとかティーって言ってたし、\r\nお茶的な？",
