    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900402/2019004020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n愛依はどういう意味だと思う？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019004020100,
    "speaker": "愛依",
    "text": "え～！\r\nわかんないから聞いてんのに～",
