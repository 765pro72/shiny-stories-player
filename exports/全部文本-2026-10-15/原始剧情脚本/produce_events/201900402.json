    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900402/2019004020120"
  },
  {
    "id": 2019004020130,
