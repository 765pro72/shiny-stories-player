    }
  },
  {
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 1901001010170,
    "speaker": "はづき",
    "text": "おはようございます、プロデューサーさん\r\nあの子、今日から来てくれてますよ",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textFrame": "003",
    "voice": "produce_events/100800101/1901001010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "はづきさん、おはようございます\r\nあの子……ですか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1901001010180,
    "speaker": "はづき",
    "text": "ふふ、はい。しばらく応接室で作業してもらってますから、\r\n会いに行ってあげてくださいね",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/100800101/1901001010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "は、はい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（えーと、今日からか……誰のことだろう？）",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "（……あれ、ドアがちょっと開いてる）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……と──！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "textFrame": "off"
  },
  {
    "bgEffect": "mask",
    "bg": "00006",
    "waitType": "effect"
  },
  {
    "charAnim1": "wait1",
    "charLabel": "kiriko",
    "charType": "characters",
    "charId": "008",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 1008001010010,
    "speaker": "？？？",
    "text": "ん……と",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010010"
  },
  {
    "id": 1008001010020,
    "speaker": "？？？",
    "text": "……できました……！\r\n……ふふ、包帯、いつもより上手く巻けたかも……♪",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010020"
  },
  {
    "id": 1008001010030,
    "speaker": "？？？",
    "text": "……あっ……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……あ、いかん\r\nつい見惚れてしまった……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、ノックもしないですまない\r\n俺は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010040,
    "speaker": "？？？",
    "text": "プ、プロデューサー……さん……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　ああ……そうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（そう、この子は……忘れもしない──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "幽谷霧子さんだね\r\nオーディションのとき以来だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010050,
    "speaker": "霧子",
    "text": "……！\r\nわたしの名前、覚えていてくれたんですね……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、よく覚えてるよ\r\n来てくれてうれしい。これからよろしくな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010060,
    "speaker": "霧子",
    "text": "は、はい……！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（さっきは引き込まれるような雰囲気があったけど、\r\nこうしてみると、すごく控え目なんだよな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ところで、包帯を巻いてたみたいだけど、\r\n腕、ケガしてるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010070,
    "speaker": "霧子",
    "text": "……いえ、あの……",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010070"
  },
  {
    "id": 1008001010080,
    "speaker": "霧子",
    "text": "……ち、ちょっとぶつけてしまって",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……心配だな\r\n念のためだ、医者に診てもらおうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010090,
    "speaker": "霧子",
    "text": "い、いえ、大したケガじゃないので……\r\n本当に大丈夫です……！",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……？\r\nわかった。でも経過は伝えてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010100,
    "speaker": "霧子",
    "text": "は、はい……！",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010100"
  },
  {
    "id": 1008001010110,
    "speaker": "霧子",
    "text": "あの……\r\nあ、ありがとうございます……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、あんまり緊張しないで\r\n俺も急に邪魔して悪かったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それにしても、\r\n包帯を巻くの、上手なんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001010120,
    "speaker": "霧子",
    "text": "はい……！",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010120"
  },
  {
    "id": 1008001010130,
    "speaker": "霧子",
    "text": "その……\r\nこうしてると、落ち着くんです",
    "charAnim1": "shy1",
    "charLipAnim": "lip_wait",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800101/1008001010130"
  },
  {
    "id": 1008001010140,
    "speaker": "霧子",
