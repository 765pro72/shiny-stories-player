    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600104/1006001040130"
  },
  {
    "id": 1006001040140,
    "speaker": "咲耶",
    "text": "アナタは、いつも優しいね……",
    "charAnim2": "face_close",
