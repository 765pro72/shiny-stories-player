    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600104/1006001040100"
  },
  {
    "id": 1006001040110,
    "speaker": "咲耶",
    "text": "体調管理ができていないせいで\r\n仕事に穴をあけてしまった……",
