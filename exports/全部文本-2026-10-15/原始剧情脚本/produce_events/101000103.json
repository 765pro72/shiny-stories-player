    }
  },
  {
    "id": 1010001030190,
    "speaker": "智代子",
    "text": "あ、プロデューサーさん！\r\nお疲れ様です！　聞いてください！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000103/1010001030190"
  },
  {
    "id": 1010001030200,
    "speaker": "智代子",
    "text": "さっき、司会の人に褒めてもらえたんです！\r\n話しやすくて良かったって……えへへ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000103/1010001030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。俺から見てもすごく良かったと思うよ\r\nよく頑張ったな",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001030210,
    "speaker": "智代子",
    "text": "はい！　ありがとうございます！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000103/1010001030210"
  },
  {
    "speaker": "プロデューサー",
    "text": "（智代子の魅力はチョコアイドルだけじゃない……\r\nもっと、良さを引き出せるように頑張ろう！）",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "speaker": "プロデューサー",
    "text": "楽しくやろう！",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001030220,
    "label": "2",
    "speaker": "智代子",
    "text": "楽しく、ですか……？\r\nでも、せっかくのチャンスですし、お仕事ですし……",
    "charAnim1": "surp2",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000103/1010001030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事なのはもちろんだけど\r\nまずは智代子自身が楽しんでないと、見る側も楽しめないよ",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001030230,
    "speaker": "智代子",
    "text": "楽しむ心を忘れちゃいけないんですね……！\r\nわかりました、肝に銘じます！",
