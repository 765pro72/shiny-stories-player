  {
    "speaker": "プロデューサー",
    "text": "三次審査……通過だ\r\nおめでとう、霧子！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7008001050010,
    "speaker": "霧子",
    "text": "通過……ですか……",
