  },
  {
    "speaker": "番組ディレクター",
    "text": "無難だと思われましたか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004018010090,
    "speaker": "恋鐘",
    "text": "！？\r\nそがんことはなかです～",
