  {
    "select": "必ず伝わるよ",
    "nextLabel": "1"
  },
  {
    "select": "かっこいい武器の\r\n使い方を見せてくれ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "楽しみにしてるぞ、\r\nチョコアイドル",
