    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000304/1010003040260"
  },
  {
    "id": 1010003040270,
    "speaker": "智代子",
    "text": "でも、見に来てくれる人たちの笑顔は損なわないで",
