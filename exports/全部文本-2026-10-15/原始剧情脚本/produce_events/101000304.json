    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000304/1010003040200"
  },
  {
    "id": 1010003040210,
    "speaker": "智代子",
    "text": "途中、迷走して手放しそうになったことも\r\nありましたけど……",
