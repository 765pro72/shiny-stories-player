    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000304/1010003040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nああ、そうだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010003040250,
    "speaker": "智代子",
    "text": "私が本気でも、きちんと伝えるのって──\r\n理解してもらうのって、難しいんだなぁって。改めて",
