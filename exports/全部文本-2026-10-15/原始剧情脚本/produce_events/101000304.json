    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000304/1010003040230"
  },
  {
    "id": 1010003040240,
    "speaker": "智代子",
    "text": "……でも、やっぱり、この間みたいなこともありますし",
