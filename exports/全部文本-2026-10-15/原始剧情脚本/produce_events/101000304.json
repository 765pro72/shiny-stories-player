    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000304/1010003040250"
  },
  {
    "id": 1010003040260,
    "speaker": "智代子",
    "text": "……──だから、まずは『G.R.A.D.』で、\r\n伝えたいことをこれまで以上に意識して",
