[
  {
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textFrame": "off",
    "charType": "idols",
    "charId": "1030070010",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bg": "00013",
    "bgm": "027",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 2007003110010,
    "speaker": "結華",
    "text": "ふんふふ～ん♪\r\n次の仕事は何かなーどこかなー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ずいぶん楽しそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110020,
    "speaker": "結華",
    "text": "まあね！　やっぱアイドルやってると、\r\nたくさんワクワクすることがあるからさ",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110020"
  },
  {
    "id": 2007003110030,
    "speaker": "結華",
    "text": "いろんなアイドルにも会えるし、セット見るのも楽しいし！\r\nもうほんと役得って感じで美味しいよね～",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに、自分の仕事だってワクワクするもんな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110040,
    "speaker": "結華",
    "text": "うんうん、そう──って、えっ？",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110040"
  },
  {
    "id": 2007003110050,
    "speaker": "結華",
    "text": "えっ！　えっ！？　なんで……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "見てればわかるさ、いつも楽しそうに仕事してるんだから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あれは外から眺めて楽しんでるんじゃなくて、\r\n自分のこととして経験を積んでる人の顔だったよ、結華",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110060,
    "speaker": "結華",
    "text": "な、なにそれ……！？　私そんな顔してた……！？",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、してた\r\nプロデューサーの目、あまりナメない方がいいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……それにしても、そんなに驚くなんて珍しいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110070,
    "speaker": "結華",
    "text": "……い、いやいや！",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110070"
  },
  {
    "id": 2007003110080,
    "speaker": "結華",
    "text": "今のは、わざと当てさせてあげたっていうか、\r\n当てられるようにしてあげただけなんだからね！？",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はいはい、わかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110090,
    "speaker": "結華",
    "text": "なっ……！　その、余裕そうなお兄さんの佇まい、\r\n気に入らないぞ……！？",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110090"
  },
  {
    "id": 2007003110100,
    "speaker": "結華",
    "text": "……おほんっ！",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110100"
  },
  {
    "id": 2007003110110,
    "speaker": "結華",
    "text": "そんなことより！\r\nプロデューサーってば、もっと緊張感をもってだね……！",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110110"
  },
  {
    "id": 2007003110120,
    "speaker": "結華",
    "text": "『W.I.N.G.』に優勝したからって、浮かれてばっかりじゃ\r\nいられないんだからね？　わかってます？",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな……もっとたくさんの人に結華のことを\r\n知ってもらいたいから、これからも頑張らないとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110130,
    "speaker": "結華",
    "text": "くっ、ダメだ……！　何言っても響かない──",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110130"
  },
  {
    "id": 2007003110140,
    "speaker": "結華",
    "text": "……あっ、そうだ",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうした？　反撃の糸口は掴めたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110150,
    "speaker": "結華",
    "text": "ううん、そんなことじゃなくて\r\n言おう言おうと思ってすっかり忘れてたことがあったんだよ",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110150"
  },
  {
    "id": 2007003110160,
    "speaker": "結華",
    "text": "──ねぇ、プロデューサー",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110160"
  },
  {
    "id": 2007003110170,
    "speaker": "結華",
    "text": "『W.I.N.G.』で優勝するなんて、\r\nひとりじゃ無理だったと思います",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110170"
  },
  {
    "id": 2007003110180,
    "speaker": "結華",
    "text": "ここまで支えてくれて、本当にありがとうございました\r\n……私のプロデューサーがあなたで、本当に良かった",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110180"
  },
  {
    "id": 2007003110190,
    "speaker": "結華",
    "text": "スカウトしてもらった日、あそこで雨宿りしてた自分を\r\n褒めてあげたいくらい",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110190"
  },
  {
    "id": 2007003110200,
    "speaker": "結華",
    "text": "それくらい、あなたと出会えたことは、\r\n私にとっての幸運です",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110200"
  },
  {
    "id": 2007003110210,
    "speaker": "結華",
    "text": "プロデューサー、ありがとう\r\nそしてこれからも、よろしくお願いします",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "……え？　……あ、ああ、えっと……\r\nこちらこそ、よろしくお願いします……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110220,
    "speaker": "結華",
    "text": "……ぷっ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110220"
  },
  {
    "id": 2007003110230,
    "speaker": "結華",
    "text": "……あははっ！　Ｐたん、その反応ほんと最高だよー！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110230"
  },
  {
    "id": 2007003110240,
    "speaker": "結華",
    "text": "ビックリした？\r\nいつもと違う三峰に、ビックリしちゃいました？",
    "charAnim1": "shy2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110240"
  },
  {
    "id": 2007003110250,
    "speaker": "結華",
    "text": "さっき三峰をからかったお返しでーす\r\nいやぁ、思う存分受け取ってくれて本当に嬉しいよ",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "珍しいこと言うと思ったら……\r\nいつも通り、からかわれただけってことか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110260,
    "speaker": "結華",
    "text": "からかったなんてそんなそんな！　滅相もない！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110260"
  },
  {
    "id": 2007003110270,
    "speaker": "結華",
    "text": "……でも、プロデューサーってば\r\n目がまんまるになってて面白かったね？",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110270"
  },
  {
    "speaker": "プロデューサー",
    "text": "まったく……その元気で今日の仕事も頼むぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110280,
    "speaker": "結華",
    "text": "おっけー、了解です！　みんなにも三峰のテンションを\r\nおすそ分けしてあげましょう！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110280"
  },
  {
    "id": 2007003110290,
    "speaker": "結華",
    "text": "……あ、でもさ\r\nさっきのはちゃんと、本音だからね？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110290"
  },
  {
    "speaker": "プロデューサー",
    "text": "……え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003110300,
    "speaker": "結華",
    "text": "おっとプロデューサー！　そんなことより急がないと！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110300"
  },
  {
    "id": 2007003110310,
    "speaker": "結華",
    "text": "次のお仕事が三峰たちを待ってるんだよ？\r\nほら、早く早く！",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110310"
  },
  {
    "id": 2007003110320,
    "speaker": "結華",
    "text": "じゃないと、三峰が置いてっちゃうからね！",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700311/2007003110320"
  },
  {
    "label": "end"
  }
]