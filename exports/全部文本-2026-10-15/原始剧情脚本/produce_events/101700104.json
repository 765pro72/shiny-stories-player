    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1017001040020,
    "speaker": "あさひ",
    "text": "あ、プロデューサーさん！\r\nお疲れさまっす！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "017",
    "charPosition": {
      "x": 568,
      "y": 640,
