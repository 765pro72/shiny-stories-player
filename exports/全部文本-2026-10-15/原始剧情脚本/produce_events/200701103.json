  {
    "id": 2007011030010,
    "speaker": "結華",
    "text": "お仕事中でしたか～",
    "charAnim1": "wait3",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_bad",
    "charLabel": "yuika",
    "textCtrl": "p",
