    }
  },
  {
    "stillCtrl": "off"
  },
  {
    "id": 2007003010160,
    "speaker": "結華",
    "text": "おや？　プロデューサーもこれ気に入っちゃった？\r\nかけてみちゃう？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700301/2007003010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、俺はいいよ",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007003010170,
    "speaker": "結華",
    "text": "あらら、ざーんねん。おそろいにできると思ったのになぁ",
    "charAnim1": "sad1",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700301/2007003010170"
  },
  {
    "id": 2007003010180,
    "speaker": "結華",
    "text": "……あっ、じゃあそっちのメガネは？\r\nなかなか似合いそうじゃない？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700301/2007003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、ちょっと、待ってくれ結華……！",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
