  },
  {
    "id": 6802001090190,
    "speaker": "かな",
    "text": "支えてくれた人たちや、推してくれたファンのためにも……\r\nこれからもっともっと、頑張っていくつもり",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
