  {
    "speaker": "プロデューサー",
    "text": "探したよ\r\nこんなところにいたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6802001090030,
    "speaker": "かな",
    "text": "ちょっと、なんでくるのよ！？",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
