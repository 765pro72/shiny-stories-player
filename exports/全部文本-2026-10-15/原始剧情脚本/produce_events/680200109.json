  {
    "id": 6802001090060,
    "speaker": "かな",
    "text": "うぅ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090060"
  },
  {
    "id": 6802001090070,
    "speaker": "かな",
    "text": "ほらぁ、もー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "す……すまん……！\r\n気が利かなくて……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6802001090080,
    "speaker": "かな",
    "text": "ち、違うわよ……！\r\n責めてるんじゃなくて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090080"
  },
  {
    "id": 6802001090090,
    "speaker": "かな",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090090"
  },
  {
    "textFrame": "off",
    "bg": "00789",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 6802001090100,
    "speaker": "かな",
    "text": "私、これまでずっと『子役の有馬かな』だった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090100"
  },
  {
    "id": 6802001090110,
    "speaker": "かな",
    "text": "成長した私に価値はなくて、\r\nネットでは終わった人扱いされて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090110"
  },
  {
    "id": 6802001090120,
    "speaker": "かな",
    "text": "仕事もないのに、稽古だけは続けて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090120"
  },
  {
    "id": 6802001090130,
    "speaker": "かな",
    "text": "何度も引退って言葉が頭を過って──……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090130"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6802001090140,
    "speaker": "かな",
    "text": "失敗なんて慣れてるけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090140"
  },
  {
    "id": 6802001090150,
    "speaker": "かな",
    "text": "やっぱり……やっぱり辛かったから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090150"
  },
  {
    "id": 6802001090160,
    "speaker": "かな",
    "text": "今の私が、ようやくひとつ認められたんだって思うと、\r\nなんかいろいろ、込み上げてきて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680200109/6802001090160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
