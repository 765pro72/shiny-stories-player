  {
    "id": 6003001070010,
    "speaker": "めぐる",
    "text": "違う……\r\nもっとこう……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……めぐる",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001070020,
    "speaker": "めぐる",
    "text": "……あ、プロデューサー\r\nえへへ。負けちゃったねー",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070020"
  },
  {
    "id": 6003001070030,
    "speaker": "めぐる",
    "text": "……ごめんね\r\n期待に応えられなくて……",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070030"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺のほうこそ、すまない\r\nもっとめぐるの力になってやれたら……",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001070040,
    "speaker": "めぐる",
    "text": "……お互い、謝るのは禁止にしよっか",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070040"
  },
  {
    "id": 6003001070050,
    "speaker": "めぐる",
    "text": "……ダメだったんだよね……やっぱり、悔しいな",
    "charAnim1": "sad2",
    "charAnim2": "no",
    "charAnim2Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070050"
  },
  {
    "id": 6003001070060,
    "speaker": "めぐる",
    "text": "でもね\r\nわたし……それ以上に、すっごく楽しかったんだ",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070060"
  },
  {
    "speaker": "プロデューサー",
    "text": "だったらもう一度チャレンジしよう！\r\n次のステージでも、めぐるならやれるはずだ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6003001070070,
    "speaker": "めぐる",
    "text": "プロデューサー……\r\nありがとう！　約束だよっ！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600300107/6003001070070"
  },
  {
    "id": 6003001070080,
    "speaker": "めぐる",
