    "waitTime": 1500
  },
  {
    "id": 2003013110150,
    "speaker": "めぐる",
    "text": "えへへ……\r\nやっぱり誇大広告",
    "charAnim1": "shy2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200301311/2003013110150"
  },
  {
    "textFrame": "off",
