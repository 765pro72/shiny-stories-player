  {
    "id": 2003013110060,
    "speaker": "めぐる",
    "text": "面白かったー！\r\n結局最初から最後までしっかり見ちゃったよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
