      "alpha": 1,
      "time": 100
    },
    "bgm": "005",
    "se": "0327",
    "voice": "produce_events/200301311/2003013110060"
  },
  {
    "id": 2003013110070,
    "speaker": "めぐる",
    "text": "わたしがやったみたいな企画、\r\n他の人もやってたんだね",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110070"
  },
  {
    "id": 2003013110080,
    "speaker": "めぐる",
    "text": "遊園地のきぐるみでドッキリとか\r\nちびっこに大人気で楽しそうだったなー！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分のところの感想は？　どうだった？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003013110090,
    "speaker": "めぐる",
    "text": "プロデューサーが言ってたとおり、\r\nいいところだけ使ってもらっちゃった感じだったね！",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110090"
  },
  {
    "id": 2003013110100,
    "speaker": "めぐる",
    "text": "なんだっけ……\r\n誇大広告？　みたいな？",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "独特な言い回しだな……？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003013110110,
    "speaker": "めぐる",
    "text": "語彙力……！",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110110"
  },
  {
    "id": 2003013110120,
    "speaker": "めぐる",
    "text": "なんて言ったらいいのかな……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110120"
  },
  {
    "id": 2003013110130,
    "speaker": "めぐる",
    "text": "やっぱり、たった１日研修したくらいじゃ\r\n全然他のメイドさんみたいにはなれなかったし",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110130"
  },
  {
    "id": 2003013110140,
    "speaker": "めぐる",
    "text": "収録中色々失敗もしたのに\r\n編集でばりばりできるよー！　みたいな感じになってて──",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301311/2003013110140"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textFrame": "off",
