    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030060"
  },
  {
    "id": 2013008030070,
    "speaker": "夏葉",
    "text": "それからちょっと……\r\n聞いてほしいことがあるの",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？　なんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030080,
    "speaker": "夏葉",
    "text": "………………\r\nこの間の、撮影の時",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030080"
  },
  {
    "id": 2013008030090,
    "speaker": "夏葉",
    "text": "プロデューサーは\r\n『気にすることない』って言ってくれたじゃない",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ、そうだったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030100,
    "speaker": "夏葉",
    "text": "──だけどやっぱり、私には無理みたい",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030110,
    "speaker": "夏葉",
    "text": "私、やっぱり\r\nたったひとりのことだって、諦めたくないの",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030110"
  },
  {
    "id": 2013008030120,
    "speaker": "夏葉",
    "text": "私のことを見てくれた人、\r\n応援してくれた人……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030120"
  },
  {
    "id": 2013008030130,
    "speaker": "夏葉",
    "text": "……それから、\r\n私を見てがっかりしてしまった人がいたとして",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030130"
  },
  {
    "id": 2013008030140,
    "speaker": "夏葉",
    "text": "いつかは、その全員を笑顔にしたい",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n夏葉、でも──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030150,
    "speaker": "夏葉",
    "text": "もちろん、それがどんなに大変かわかるわ",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030150"
  },
  {
    "id": 2013008030160,
    "speaker": "夏葉",
    "text": "私だって普通の人間だもの\r\n落ち込んだり、傷ついたりしないわけじゃない",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030160"
  },
  {
    "id": 2013008030170,
    "speaker": "夏葉",
    "text": "だけどね、だけど…………",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030170"
  },
  {
    "id": 2013008030180,
    "speaker": "夏葉",
    "text": "そのために私、今よりもっと強くなって、\r\nずっと良いアイドル……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030180"
  },
  {
    "id": 2013008030190,
    "speaker": "夏葉",
    "text": "ずっと良い……有栖川夏葉になりたい\r\nそう思うのよ",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030190"
  },
  {
    "id": 2013008030200,
    "speaker": "夏葉",
    "text": "──無理だって……\r\n子どもみたいだって、笑うかしら？",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そんなわけ、ないだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030210,
    "speaker": "夏葉",
    "text": "ふふっ、そうよね\r\n私も大丈夫って、確信があるの",
