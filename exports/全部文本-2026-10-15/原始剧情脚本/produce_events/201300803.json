    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030210"
  },
  {
    "id": 2013008030220,
    "speaker": "夏葉",
    "text": "……だって、アナタと一緒なんだもの",
    "charAnim1": "touch",
    "charAnim2": "face_smile2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300803/2013008030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………\r\n………ごめんな、夏葉",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013008030230,
    "speaker": "夏葉",
    "text": "……？",
