    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/202300701/2023007010330"
  },
  {
    "select": "……なりたい！",
    "nextLabel": "1"
  },
  {
    "select": "なりたくないかな",
