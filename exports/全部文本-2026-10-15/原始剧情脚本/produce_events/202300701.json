    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300701/2023007010310"
  },
  {
    "id": 2023007010320,
    "speaker": "雛菜",
    "text": "ま、だからって\r\n雛菜が変わるわけじゃないんだけど～",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300701/2023007010320"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023007010330,
    "speaker": "雛菜",
    "text": "ね、プロデューサーも\r\n雛菜みたいになりたいって思う～？",
