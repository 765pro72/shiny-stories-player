  {
    "speaker": "スタッフ",
    "text": "あ……！\r\n２８３さん！　おはようございます……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはようございます！\r\n本日はよろしくお願いします",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023006020030,
    "speaker": "雛菜",
    "text": "市川雛菜です\r\nよろしくお願いします～",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
