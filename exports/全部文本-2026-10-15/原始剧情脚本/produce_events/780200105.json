  {
    "speaker": "プロデューサー",
    "text": "いま連絡が来て……\r\nやったな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7802001050020,
    "speaker": "かな",
    "text": "すごい……",
    "charAnim1": "wait2",
