  {
    "id": 3010020010370,
    "speaker": "店内放送",
    "text": "『なんと、コラボ期間中の店内放送のお時間を、\r\n放クラがちょこっと頂いちゃいました！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010370"
  },
  {
    "id": 3010020010380,
    "speaker": "店内放送",
    "text": "『事前に店員さんから頂いたお便りを\r\n読んでいきたいと思います』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010380"
  },
  {
    "id": 3010020010390,
    "speaker": "店内放送",
    "text": "『短い時間ではございますが…… \r\n共に……お楽しみください……』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010390"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 3010020010400,
    "speaker": "店内放送",
    "text": "『ではさっそく一通目──\r\n投稿ネーム・シフトと放送期間がかぶらないさんから』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010400"
  },
  {
    "id": 3010020010410,
    "speaker": "店内放送",
    "text": "『！　ど、どこかで聞けてたらいいけど──』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010410"
  },
  {
    "id": 3010020010420,
    "speaker": "店内放送",
    "text": "『そうね……！\r\nええと、放クラのみなさんこんにちは』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010420"
  },
  {
    "id": 3010020010421,
    "speaker": "店内放送",
    "text": "『こんにちは！』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010421"
  },
  {
    "id": 3010020010430,
    "speaker": "店内放送",
    "text": "『僕は長年このコンビニでバイトをしており、\r\n放クラの大ファンでもあります』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010430"
  },
  {
    "id": 3010020010440,
    "speaker": "店内放送",
    "text": "『恐らく世界で一番コラボにわいたのに、放送時期は\r\n学校が忙しくて全然シフトを入れられていません』",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010440"
  },
  {
    "id": 3010020010450,
    "speaker": "店内放送",
    "text": "『ワンチャン聞けないんじゃないかと、\r\nうっすら最悪の可能性が漂っています』──",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/301002001/3010020010450"
  },
