  {
    "id": 2004011010070,
    "speaker": "恋鐘",
    "text": "──エッセイ……？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
