    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401101/2004011010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、ファッション誌での\r\n短期連載エッセイのオファーだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "仮タイトルは、\r\n『月岡恋鐘の恋日記』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "日記のような感じで、毎月恋鐘の\r\n好きなものやハマってるものを紹介していくって企画だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004011010080,
    "speaker": "恋鐘",
    "text": "そいは、楽しそうやね～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010080"
  },
  {
    "id": 2004011010090,
    "speaker": "恋鐘",
    "text": "……ばってん",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010090"
  },
  {
    "id": 2004011010100,
    "speaker": "恋鐘",
    "text": "うち、エッセイなんて書いたことなか……！",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010100"
  },
  {
    "id": 2004011010110,
    "speaker": "恋鐘",
    "text": "学生の時も、机よりも台所に向かってる\r\n時間の方が長かったとよ……！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは\r\nきっと、そういうところもよかったんだろうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004011010120,
    "speaker": "恋鐘",
    "text": "……？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……編集部の人たちはさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘のパワフルさとか、キュートさに惹かれて\r\nオファーしたって言ってくれたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004011010130,
    "speaker": "恋鐘",
    "text": "ふぇ……！",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "きっと、今までにないようなものを\r\n書いてくれるだろうって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "エッセイだからって、\r\nあえて堅苦しくする必要はないし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘らしいものが読みたいってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004011010140,
    "speaker": "恋鐘",
    "text": "……！",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401101/2004011010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに俺も、きっと恋鐘なら\r\n面白いものが書けると思ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……どうだ？\r\n挑戦してみないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004011010150,
