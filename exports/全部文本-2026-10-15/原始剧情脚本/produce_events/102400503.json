  {
    "speaker": "販売員",
    "text": "いらっしゃいませー\r\n何かお探しですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1024005030010,
    "speaker": "にちか",
    "text": "はい！\r\nランニング用の靴、買いに来たんですけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102400503/1024005030010"
  },
  {
    "speaker": "販売員",
    "text": "あ、そうなんですね……！\r\n部活とかで使う感じですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1024005030020,
    "speaker": "にちか",
    "text": "あ、いえ……",
