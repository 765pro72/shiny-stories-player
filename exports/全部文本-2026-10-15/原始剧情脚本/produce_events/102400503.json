    "bgEffectTime": 1000
  },
  {
    "id": 1024005030030,
    "speaker": "にちか",
    "text": "その────\r\n私ちょっと芸能関係の仕事をする……予定で",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
