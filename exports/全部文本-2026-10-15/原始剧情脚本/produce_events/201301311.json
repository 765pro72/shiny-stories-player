    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301311/2013013110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、バレンタインだってことは\r\nわかってるけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013110110,
    "speaker": "夏葉",
    "text": "ふふっ、それならいいのよ",
