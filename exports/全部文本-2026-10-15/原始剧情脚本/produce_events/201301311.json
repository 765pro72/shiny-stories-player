  },
  {
    "speaker": "プロデューサー",
    "text": "でも、待たせちゃったみたいだし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013110140,
    "speaker": "夏葉",
    "text": "いいのよ",
