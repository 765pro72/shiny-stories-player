    "voice": "produce_events/200400604/2004006040340"
  },
  {
    "id": 2004006040350,
    "speaker": "恋鐘",
    "text": "…………えへへ、うち、\r\nダメって言われたことば～っかり、やっとるね……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
