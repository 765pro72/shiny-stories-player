  {
    "id": 2015008020010,
    "speaker": "甜花",
    "text": "『甜花の好きなものは、スタジオの近くにある\r\nソフトクリーム屋さんのソフトクリームです』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500802/2015008020010"
  },
  {
    "id": 2015008020020,
    "speaker": "甜花",
    "text": "『お仕事が終わった後、なーちゃんと千雪さんと一緒に\r\n食べに行きます』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500802/2015008020020"
  },
  {
    "id": 2015008020030,
    "speaker": "甜花",
    "text": "『ミルクは優しい味がして美味しくて、\r\nチョコはちょっと大人の味で美味しいです』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500802/2015008020030"
  },
  {
    "id": 2015008020040,
    "speaker": "甜花",
    "text": "『甜花たちの秘密のお店だったけど、\r\nみんなに教えちゃったからみんなの秘密のお店です』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500802/2015008020040"
  },
  {
    "id": 2015008020050,
    "speaker": "甜花",
    "text": "『また食べたいなって思いました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500802/2015008020050"
  },
  {
