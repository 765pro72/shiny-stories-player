[
  {
    "id": 6902001070010,
    "speaker": "社長",
    "text": "お前、担当アイドルのことをどう思っている？",
    "charAnim1": "wait",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "charType": "sub_characters",
    "charId": "staff",
