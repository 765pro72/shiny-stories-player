    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101203/2021012030280"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっとありきたりだったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021012030290,
    "speaker": "円香",
    "text": "……部屋に戻ります",
    "charAnim1": "shy2",
    "charAnim2": "face_close4",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101203/2021012030290"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、ゆっくり休んでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021012030300,
    "speaker": "円香",
    "text": "明日、ロビーに集合でしたよね\r\n……それでは",
    "charAnim1": "sigh",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101203/2021012030300"
  },
  {
    "charAnim1": "wait",
    "charLabel": "madoka",
