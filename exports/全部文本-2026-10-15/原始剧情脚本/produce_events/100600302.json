  },
  {
    "id": 1006003020150,
    "speaker": "咲耶",
    "text": "アナタはプロデューサーとして、\r\nやるべき仕事をしただけだ",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020150"
  },
  {
    "id": 1006003020160,
    "speaker": "咲耶",
    "text": "けれど、それを理解したうえでひとつワガママを言いたい\r\n……その手紙を、読ませてほしい",
    "charAnim1": "wait4",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020160"
