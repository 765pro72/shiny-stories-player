    "voice": "produce_events/100600302/1006003020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\n……ちゃんと、隠せてなかったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003020110,
    "speaker": "咲耶",
    "text": "フフ、誤魔化さないのはアナタらしいね",
