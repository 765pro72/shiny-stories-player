    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020250"
  },
  {
    "id": 1006003020260,
    "speaker": "咲耶",
    "text": "……もうひとつ重ねて、ありがとう。プロデューサー",
