    "voice": "produce_events/100600302/1006003020220"
  },
  {
    "id": 1006003020230,
    "speaker": "咲耶",
    "text": "可愛い衣装を着てライブをしたり\r\n今日なんて、漁村に突撃食レポがオンエアされたところだ",
    "charAnim1": "wait5",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020230"
  },
