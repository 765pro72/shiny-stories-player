    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003020270,
    "speaker": "咲耶",
    "text": "…………私がこうなるとわかっていたから、\r\n手紙を隠してくれたんだろう？",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
