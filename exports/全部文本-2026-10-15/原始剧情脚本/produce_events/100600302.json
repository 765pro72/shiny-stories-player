    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020110"
  },
  {
    "id": 1006003020120,
    "speaker": "咲耶",
    "text": "……その封筒に、覚えがあったんだ",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020120"
  },
  {
    "id": 1006003020130,
    "speaker": "咲耶",
    "text": "…………私がモデルだった頃、\r\nよく手紙をくれた子がいつも使っていたものだったから",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
