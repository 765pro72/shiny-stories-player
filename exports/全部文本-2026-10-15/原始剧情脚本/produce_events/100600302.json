    "textFrame": "001",
    "voice": "produce_events/100600302/1006003020090"
  },
  {
    "id": 1006003020100,
    "speaker": "咲耶",
    "text": "…………プロデューサー、その手紙は……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
