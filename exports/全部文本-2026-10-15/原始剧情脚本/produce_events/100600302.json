    "speaker": "プロデューサー",
    "text": "ああ、いい仕事だったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006003020240,
    "speaker": "咲耶",
    "text": "……フフ、ありがとう",
