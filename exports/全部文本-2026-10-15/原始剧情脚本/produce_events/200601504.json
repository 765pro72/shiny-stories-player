    },
    "voice": "produce_events/200601504/2006015040060"
  },
  {
    "id": 2006015040070,
    "speaker": "咲耶",
    "text": "電話はもういいの？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……なぁ咲耶\r\n何かいいこと、あったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015040080,
    "speaker": "咲耶",
    "text": "え？\r\n……フフ、また顔に出ていたかな",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "それもあるし──\r\n咲耶のこういう雰囲気には覚えがある",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ファンの人たちに関することで\r\n何か嬉しいことがあった！　──どうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2006015040090,
    "speaker": "咲耶",
    "text": "当たり",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040090"
  },
  {
    "id": 2006015040100,
    "speaker": "咲耶",
    "text": "感想をね、読んでいたんだ\r\n今はミニドラマの予告についてのものが多くて──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっか！\r\n──喜んでもらえてるもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015040110,
    "speaker": "咲耶",
    "text": "うん",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040110"
  },
  {
    "id": 2006015040120,
    "speaker": "咲耶",
    "text": "ファンのみんなが私に求めてくれているものが、\r\nその通りの形で届いているんだと──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040120"
  },
  {
    "id": 2006015040130,
    "speaker": "咲耶",
    "text": "実感できる瞬間は、\r\n何度味わってもたまらない",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040130"
  },
  {
    "id": 2006015040140,
    "speaker": "咲耶",
    "text": "それこそ、少しの空き時間でも\r\n覗いてみたくなってしまうほどには",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ファンのために頑張る咲耶なんだからさ、\r\nファンの言葉で元気をもらっても",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自分の気持ちが届いて、咲耶の元気の源になるなら\r\nファンの人たちだって嬉しいはずだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺がそうだし！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015040150,
    "speaker": "咲耶",
    "text": "……！　そうだね────",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040150"
  },
  {
    "id": 2006015040160,
    "speaker": "咲耶",
    "text": "──それなら私も、また還元しよう",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040160"
  },
  {
    "id": 2006015040170,
    "speaker": "咲耶",
    "text": "みんなが支えてくれた私で、\r\nみんなが望んでくれる私を見せ続ける",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040170"
  },
  {
    "id": 2006015040180,
    "speaker": "咲耶",
    "text": "大切なファンのみんなのために",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015040190,
    "speaker": "咲耶",
    "text": "──さて、ではまずは第一歩\r\n今日の仕事に向かおうか",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601504/2006015040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっとそうだった、\r\n悪いな電話のせいで待たせて……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "行こう、咲耶！",
    "textCtrl": "p",
    "textFrame": "002"
  },
