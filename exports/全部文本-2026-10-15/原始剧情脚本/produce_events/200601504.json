  {
    "speaker": "プロデューサー",
    "text": "──すまん咲耶、待たせたな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006015040060,
    "speaker": "咲耶",
    "text": "ううん",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040060090",
    "charPosition": {
      "x": 568,
