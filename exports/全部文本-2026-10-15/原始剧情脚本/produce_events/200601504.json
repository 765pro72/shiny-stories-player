  {
    "speaker": "SNSの投稿",
    "text": "『咲耶ちゃんのいいところが詰まってる』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの投稿",
    "text": "『刺激強すぎてちょっと気を失ってた』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "SNSの投稿",
    "text": "『シンプルに健康にいいけど、\r\n見終わったあとの動悸息切れがやばい』",
    "textCtrl": "p",
    "textFrame": "003"
  },
