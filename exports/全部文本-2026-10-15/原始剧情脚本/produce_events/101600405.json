  },
  {
    "id": 1016004050010,
    "speaker": "千雪",
    "text": "#利きアルスト　#恋したときのアルスト",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050010"
  },
  {
    "id": 1016004050020,
    "speaker": "千雪",
    "text": "#雨の夕方に聴くアルスト\r\n#流星群に似合うアルスト",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050020"
  },
  {
    "id": 1016004050030,
    "speaker": "千雪",
    "text": "よかった……\r\nみんな、いっぱいプレイリストを投稿してくれてる……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪が作ったプレイリストの\r\n再生数も上々って知らせも受けてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "音楽ライターさんや、前に共演した女優さんに\r\n作ってもらったプレイリストも評判いいみたいだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "fg": "fade_out",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1300,
    "bgEffectTime": 1300,
    "fgEffectTime": 1300
  },
  {
    "textFrame": "off",
    "fg": "off",
    "waitType": "time",
    "waitTime": 500,
    "bgEffectTime": 1300
  },
  {
    "id": 1016004050040,
    "speaker": "千雪",
    "text": "……本当にありがとうございます、プロデューサーさん",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101600405/1016004050040"
  },
  {
    "id": 1016004050050,
    "speaker": "千雪",
    "text": "聴いた人、それぞれのアルストロメリアを\r\n咲かせてほしい――",
    "charAnim1": "sad1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050050"
  },
  {
    "id": 1016004050060,
    "speaker": "千雪",
    "text": "そんなわがままを大事にしてくださって",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050060"
  },
  {
    "id": 1016004050070,
    "speaker": "千雪",
    "text": "おかげで、私が見たかったものが\r\nこんな風に広がっていて……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050070"
  },
  {
    "id": 1016004050080,
    "speaker": "千雪",
    "text": "上手く言葉にできなくて、もどかしいんですけど……",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050080"
  },
  {
    "id": 1016004050090,
    "speaker": "千雪",
    "text": "胸の奥にふわふわ、きらきらしたものが\r\nたくさん降りつもるような……幸せな気分です",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ\r\n俺が、良い仕事できたとしたなら……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは千雪が、\r\n色々なことを気づかせてくれたおかげだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050100,
    "speaker": "千雪",
    "text": "……そうなんです？",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nそれぞれの世界を大事にしたい、否定したくない……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "同時に、誰かの世界を分かち合うことも楽しいし、\r\n実像とは違う夢を見ることだって、悪くない……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger2_s",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "全部、千雪から教えてもらったことだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050110,
    "speaker": "千雪",
    "text": "……そんな──",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050110"
  },
  {
    "id": 1016004050120,
    "speaker": "千雪",
    "text": "もう……\r\nプロデューサーさんは、優しすぎます……！",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050120"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ、そうか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺はむしろ、千雪にはもっと\r\n甘えてほしいくらいだと思ってるんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ライブ本番に、満開の花を咲かせることができるのは\r\n千雪たちだけだからな",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺がやれるのは、当日に向けて準備を整えることだけだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050130,
    "speaker": "千雪",
    "text": "……そんな……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600405/1016004050130"
  },
  {
    "id": 1016004050140,
    "speaker": "千雪",
    "text": "……だけど、プロデューサーさんが\r\nどんな光――どんな花が見られるんだろう、って",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050140"
  },
  {
    "id": 1016004050150,
    "speaker": "千雪",
    "text": "わくわくしながら走ってくださってるの、\r\n感じています",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050150"
  },
  {
    "id": 1016004050160,
    "speaker": "千雪",
    "text": "──だから、私もそれに応えないと",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "プレッシャーか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050170,
    "speaker": "千雪",
    "text": "……いいえ",
    "charAnim2": "face_close2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050170"
  },
  {
    "id": 1016004050180,
    "speaker": "千雪",
    "text": "プロデューサーさんにも、私たちのライブ、\r\n楽しみにしていて欲しいな、って思います",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いい顔だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "楽しみにしてるよ、千雪",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050190,
    "speaker": "千雪",
    "text": "ふふっ……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050190"
  },
  {
    "id": 1016004050200,
    "speaker": "千雪",
    "text": "そうだ、ひとつ甘えてしまってもかまいませんか？",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nなんでも言ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050210,
    "speaker": "千雪",
    "text": "ありがとうございます",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050210"
  },
  {
    "id": 1016004050220,
    "speaker": "千雪",
    "text": "プロデューサーさんに、アルストロメリアのリストを\r\n作ってもらえたら嬉しいんですが……どうでしょう？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050220"
  },
  {
    "id": 1016004050230,
    "speaker": "千雪",
    "text": "誰よりも近くにいてくださるプロデューサーさんには、\r\nどんなアルストロメリアが見えているのか……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050230"
  },
  {
    "id": 1016004050240,
    "speaker": "千雪",
    "text": "知りたくなってしまって",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050240"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nもちろん、構わないが……",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なんだか緊張するな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050250,
    "speaker": "千雪",
    "text": "ええ……？\r\nどうして緊張するんです？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050250"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、なんていうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、本棚を見せるようなものだし、\r\n第一こう、生々しいだろ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger2_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1016004050260,
    "speaker": "千雪",
    "text": "もうっ……\r\nプロデューサーさん……？",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050260"
  },
  {
    "id": 1016004050270,
    "speaker": "千雪",
    "text": "私のお話を覚えててくれるのは嬉しいけど、\r\nそんな風に使うのは反則です……！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050270"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまんすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちゃんと考えておくから許してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004050280,
    "speaker": "千雪",
    "text": "はい、ありがとうございます",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050280"
  },
  {
    "id": 1016004050290,
    "speaker": "千雪",
    "text": "楽しみにしていますね……！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600405/1016004050290"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]