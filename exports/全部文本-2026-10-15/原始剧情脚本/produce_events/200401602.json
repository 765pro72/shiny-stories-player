      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "ええ、そういう切ないクリスマスソングになります",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "しかし今、コーラスからつなぐ部分から、\r\n曲調を少し明るめにするか、しっとりと歌い上げるか……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "ちょっと悩んでおりまして",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textFrame": "off",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2300
  },
  {
    "charAnim1": "wait",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "コーラスを歌う月岡さんのお話も聞きたいと思いまして、\r\nこの場をセッティングさせていただきました",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "月岡さんはこの歌詞の女の子、どう思った……？\r\n叶わない恋って、辛いよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "もっとも、月岡さんだったら自分が好きな相手が\r\n振り向かないなんて経験はないかな……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020130,
    "speaker": "恋鐘",
    "text": "ふぇ！？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401602/2004016020130"
  },
  {
    "id": 2004016020140,
    "speaker": "恋鐘",
    "text": "そ、そがんことはなかです～……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0220",
