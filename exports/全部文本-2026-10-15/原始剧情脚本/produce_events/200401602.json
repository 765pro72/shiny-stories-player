    },
    "voice": "produce_events/200401602/2004016020200"
  },
  {
    "id": 2004016020210,
    "speaker": "恋鐘",
    "text": "ちゃんと考えてお答えさせていただきたかけん、\r\n改めて、お返事させてもらってもよかですか？",
