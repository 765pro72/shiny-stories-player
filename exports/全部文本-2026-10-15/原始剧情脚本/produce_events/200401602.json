  {
    "id": 2004016020100,
    "speaker": "恋鐘",
    "text": "うちの歌う女の子は、曲の主人公の男性に\r\n片想いばしとるとですね……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401602/2004016020100"
  },
  {
    "id": 2004016020110,
    "speaker": "恋鐘",
    "text": "ばってん、男性の方も違う女性に、\r\n叶わん片想いばしとって……",
    "charAnim1": "wait4",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401602/2004016020110"
  },
  {
    "id": 2004016020120,
    "speaker": "恋鐘",
    "text": "ふぇ……",
    "charAnim1": "wait5",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
