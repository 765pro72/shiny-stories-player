  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "どうもこんにちは、月岡さん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "今回は、コーラスとPV撮影に\r\n参加していただけるとのことで、嬉しいです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "僕はバンドのギターと、作詞作曲を担当しております",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "俺はボーカル兼、バンドのリーダーをしてます\r\n今回はよろしくね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020070,
    "speaker": "恋鐘",
    "text": "よろしくお願いします～\r\nうちのやれること、頑張りますけん！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200401602/2004016020070"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "ありがとうございます\r\n飲み物飲んで、どうぞ楽になさってくださいね",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "──今回月岡さんにお願いするのはこちらの曲で……\r\n歌詞を先行して作ったものになります",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020080,
    "speaker": "恋鐘",
    "text": "ありがとうございます……！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
