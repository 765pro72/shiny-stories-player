  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "もしかして、\r\n現在進行形で叶わない恋をしているとか……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020150,
    "speaker": "恋鐘",
    "text": "恋……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401602/2004016020150"
  },
  {
    "id": 2004016020160,
    "speaker": "恋鐘",
    "text": "そもそも恋がどがんもんか、\r\nうちにはようわからんところのあるけん──",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401602/2004016020160"
  },
  {
    "id": 2004016020170,
    "speaker": "恋鐘",
    "text": "！\r\nありますから…………",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401602/2004016020170"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "でも、愛はわかるよね……？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020180,
    "speaker": "恋鐘",
    "text": "えっと……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401602/2004016020180"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "ふふ、僕たちね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "歌声はもちろんだけど、月岡さんの出演したドラマや\r\nバラエティを見て、この仕事を依頼しようと思ったんです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "特に先日の、海沿いの地方に出向いての食リポ\r\nすごく良いよなって、メンバーみんなで話してまして",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "……あの時月岡さん、愛情について話してたよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボーカル兼リーダー",
    "text": "新曲にコーラスを作って、こういう子に歌ってもらったら\r\nきっとぐっと締まるんじゃないかなって話になって",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ギタリスト兼作曲担当",
    "text": "月岡さんならどんな気持ちでこれを歌うのか、\r\n聞かせてもらえたら嬉しいんだけど",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016020190,
    "speaker": "恋鐘",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad_s",
    "charLabel": "kogane",
    "textCtrl": "p",
