[
  {
    "charType": "characters",
    "charId": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "textFrame": "001",
    "speaker": "off",
    "charLabel": "mano",
    "charAnim1": "wait",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bgm": "006",
    "bg": "00002"
  },
  {
    "id": 7001001050010,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "あ、あの……プロデューサーさん\r\n審査の結果は……どうでしたか？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/700100105/7001001050010"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "やったぞ、真乃！\r\nおめでとう、三次審査通過だ！",
    "textCtrl": "p"
  },
  {
    "id": 7001001050020,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "三次審査、通過……\r\nはぁぁ……よ、よかったぁー",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050020"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、本当によかったよ\r\nけど、真乃から結果を聞きにくるなんて珍しいな",
    "textCtrl": "p"
  },
  {
    "id": 7001001050030,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はい……結果が今日に出るって聞いて\r\nずっとそわそわしてました",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050030"
  },
  {
    "id": 7001001050040,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "楽しみなような怖いような……早く結果を知りたくて\r\nずーっとプロデューサーさんが来るのを待ってましたっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050040"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "よかったな、\r\nこれで『W.I.N.G.』が見えてきた",
    "textCtrl": "p"
  },
  {
    "id": 7001001050050,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はいっ、でも実はまだ……\r\n『W.I.N.G.』出場が近づいてきたっていう実感がなくて",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050050"
  },
  {
    "id": 7001001050060,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "今はアイドルとしての毎日がすごく楽しいんです\r\nまだ道は続いてるんだなって、まず安心しちゃいました",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050060"
  },
  {
    "id": 7001001050070,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "アイドルでいられるのが、この日常が続くのが\r\nこんなにもうれしいだなんて……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050070"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "真乃が心からアイドルをしていたい、という想いが\r\nこの結果に繋がったんだよ",
    "textCtrl": "p"
  },
  {
    "id": 7001001050080,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はい！　ありがとうございますっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050080"
  },
  {
    "id": 7001001050090,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "こんなにうれしかったことも……\r\n楽しかったことも、今までなかったです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "no",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050090"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "そうか、でもこれからは\r\nもっとうれしいことがたくさん起きるぞ",
    "textCtrl": "p"
  },
  {
    "id": 7001001050100,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわ？\r\n今よりもっと……？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/700100105/7001001050100"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、真乃はこれから次の予選も突破して\r\n『W.I.N.G.』で優勝するんだからな！",
    "textCtrl": "p"
  },
  {
    "id": 7001001050110,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "私が『W.I.N.G.』で優勝……！？\r\nそ、そんな夢みたいな……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "voice": "produce_events/700100105/7001001050110"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "いや、優勝はそんなに遠い目標なんかじゃないぞ\r\nあとひとつで本選出場なんだからな！",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "真乃ならやれるって、俺は信じてる\r\nきっとファンのみんなもな！",
    "textCtrl": "p"
  },
  {
    "id": 7001001050120,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわわ……プロデューサーさんにそう言ってもらえると\r\n本当にできちゃう気がしてきますっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050120"
  },
  {
    "id": 7001001050130,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "そうですよね……みなさんのためにも、\r\n出場するだけではなく……その先も目指して……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/700100105/7001001050130"
  },
  {
    "id": 7001001050140,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "『W.I.N.G.』の舞台で輝けるアイドルになれるよう、\r\nこれからも頑張ります！",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050140"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、俺も精一杯サポートするぞ！",
    "textCtrl": "p"
  },
  {
    "id": 7001001050150,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はいっ、これからも頼りにしてますね、\r\nプロデューサーさんっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100105/7001001050150"
  },
  {
    "label": "end"
  }
]