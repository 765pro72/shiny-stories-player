  {
    "id": 2025005040020,
    "speaker": "美琴",
    "text": "…………もしかして\r\n差し入れでもしに来てくれた？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
