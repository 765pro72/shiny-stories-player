    "waitTime": 1500
  },
  {
    "id": 2025005040050,
    "speaker": "美琴",
    "text": "あ……はちみつレモンだ",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202500504/2025005040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、それ甘すぎなくて飲みやすいんだ\r\n喉にもいいんじゃないかと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040060,
    "speaker": "美琴",
    "text": "そうだね\r\n……まだ温かい",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、タクシー捕まえるか\r\nそこの通りならすぐ──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040070,
    "speaker": "美琴",
    "text": "あ、ううん\r\n大丈夫",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040070"
  },
  {
    "id": 2025005040080,
    "speaker": "美琴",
    "text": "今日は歩いて帰ろうと思って",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、ここからか？\r\n結構距離、あるんじゃないか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040090,
    "speaker": "美琴",
    "text": "うん\r\nだけど歩けない距離でもないし",
    "charAnim1": "think2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも結構寒いぞ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040100,
    "speaker": "美琴",
    "text": "歩いてれば暖かくなるよ\r\nそれに──……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040100"
  },
  {
    "id": 2025005040110,
    "speaker": "美琴",
    "text": "温かいはちみつレモンのドリンクも\r\n貰ったし",
    "charAnim1": "think1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だけど、夜は危ないだろ\r\nひとりで遅い時間に出歩くのは──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040120,
    "speaker": "美琴",
    "text": "…………？\r\nひとりじゃないでしょ",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040120"
  },
  {
    "id": 2025005040130,
    "speaker": "美琴",
    "text": "プロデューサーがいるから",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040130"
  },
  {
    "speaker": "プロデューサー",
