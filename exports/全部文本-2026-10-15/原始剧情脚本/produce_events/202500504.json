  },
  {
    "speaker": "プロデューサー",
    "text": "え……ああ\r\nそうなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも今日は、もう終わりか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040030,
    "speaker": "美琴",
    "text": "うん\r\nこの時間までしか、場所取れなくて",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nそれじゃ、これ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "帰りながらでも、飲んでくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025005040040,
    "speaker": "美琴",
    "text": "……ありがとう\r\nドリンク？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500504/2025005040040"
  },
  {
    "charAnim1": "wait",
