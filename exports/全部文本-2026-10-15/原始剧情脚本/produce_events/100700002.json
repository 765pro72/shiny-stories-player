  {
    "id": 1007001010010,
    "speaker": "？？？",
    "text": "ひゃーっ、雨とか聞いてないってー！",
    "charAnim1": "surp1",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
