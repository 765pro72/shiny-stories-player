  },
  {
    "id": 2019006110070,
    "speaker": "愛依",
    "text": "なんか目ぇ充血してるし、ちょっと顔色も悪くない？\r\n一夜漬けした子って、そんな顔するよね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110070"
  },
  {
    "id": 2019006110080,
    "speaker": "愛依",
    "text": "もう終わったんでしょ？\r\n時間、余裕あるんだったらさ──",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
