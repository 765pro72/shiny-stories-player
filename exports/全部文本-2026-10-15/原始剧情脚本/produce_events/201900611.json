  {
    "id": 2019006110170,
    "speaker": "愛依",
    "text": "充血してる時は\r\n目をあったかいもので覆うといいんだって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110170"
  },
  {
    "id": 2019006110180,
    "speaker": "愛依",
    "text": "あったかいタオルとかないから、\r\nうちの手になっちゃうんだけどさ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\nありがとう……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019006110190,
    "speaker": "愛依",
    "text": "お礼なんて言わない\r\nうちが無理やりさせてもらったんだし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110190"
  },
  {
    "id": 2019006110200,
    "speaker": "愛依",
    "text": "うち、寝かしつけるのちょー得意だから、\r\nプロデューサーもどんどん寝ちゃってね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019006110210,
    "speaker": "愛依",
    "text": "…………\r\n……………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110210"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2019006110220,
    "speaker": "愛依",
    "text": "……………………プロデューサー、\r\nいつもお仕事大変なのに、ありがと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110220"
  },
  {
    "id": 2019006110230,
    "speaker": "愛依",
    "text": "プロデューサーのお陰でうち、\r\n毎日すっごく楽しいんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110230"
  },
  {
    "id": 2019006110240,
    "speaker": "愛依",
    "text": "アイドルになる前……\r\nどんな毎日だったか、もう思い出せないくらい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110240"
  },
  {
    "id": 2019006110250,
    "speaker": "愛依",
    "text": "思い出せないけど……\r\nみんなで、遊んで、騒いで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110250"
  },
  {
    "id": 2019006110260,
    "speaker": "愛依",
    "text": "楽しかったけど……\r\nでも、テキトーな毎日だった気がする……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110260"
  },
  {
    "id": 2019006110270,
    "speaker": "愛依",
    "text": "今は……テキトーじゃ、やっていけなくて……\r\n大変なことばっかで……ほんとに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110270"
  },
  {
    "id": 2019006110280,
    "speaker": "愛依",
    "text": "ほんとに、楽しいんだ……\r\nあさひちゃんがいて……冬優子ちゃんがいて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110280"
  },
  {
    "id": 2019006110290,
    "speaker": "愛依",
    "text": "……そんで、プロデューサーがいて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110290"
  },
  {
    "id": 2019006110300,
    "speaker": "愛依",
    "text": "仕事して……頑張って……\r\nみんなで、笑って……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110300"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2019006110310,
    "speaker": "愛依",
    "text": "…………こないだね、友達と話……したんだ\r\n今のうちのこと。なんでキャラ、作ってんのか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110310"
  },
  {
    "id": 2019006110320,
    "speaker": "愛依",
    "text": "全部納得してくれたってワケじゃないけど……\r\n……でも、うちが言うことだからって、信じてくれた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110320"
  },
  {
    "id": 2019006110330,
    "speaker": "愛依",
    "text": "そんで、これからのうちを見て……\r\nほんとにこれでいいのか……確かめるって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110330"
  },
  {
    "id": 2019006110340,
    "speaker": "愛依",
    "text": "だからうちは……\r\nこれからも………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110340"
  },
  {
    "id": 2019006110350,
    "speaker": "愛依",
    "text": "……………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110350"
  },
  {
    "id": 2019006110360,
    "speaker": "愛依",
    "text": "…………これからも……\r\nよろしく、プロデューサー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110360"
  },
  {
    "id": 2019006110370,
    "speaker": "愛依",
    "text": "…………でも……\r\nううん……だから……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110370"
  },
  {
    "id": 2019006110380,
    "speaker": "愛依",
    "text": "今は、ちょっとだけ……\r\nゆっくり休んでね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900611/2019006110380"
  },
