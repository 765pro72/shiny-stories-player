  },
  {
    "id": 2019006110090,
    "speaker": "愛依",
    "text": "そこのソファでちょっと休んでくとかする？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
