  {
    "id": 2013011010200,
    "speaker": "夏葉",
    "text": "『──有栖川夏葉、\r\n新コスメシリーズのイメージキャラクターに』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301101/2013011010200"
  },
  {
    "id": 2013011010210,
    "speaker": "夏葉",
    "text": "『彼女のひたむきな熱こそが\r\nいつかすべてに、魔法をかける──』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301101/2013011010210"
  },
  {
    "id": 2013011010220,
    "speaker": "夏葉",
    "text": "──……",
