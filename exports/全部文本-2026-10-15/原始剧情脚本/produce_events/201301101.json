  {
    "speaker": "プロデューサー",
    "text": "今日は特に、大人っぽくてかっこいいな\r\n『すべてに、魔法をかける』ぐらい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013011010010,
    "speaker": "夏葉",
    "text": "うふふ\r\nありがとう、プロデューサー",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
