    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201200411/2012004110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "……む、昔の人は、大変だなぁ……",
    "charAnim2": "s",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2012004110120,
    "speaker": "凛世",
    "text": "ふふ……\r\n今では……考えられません……",
