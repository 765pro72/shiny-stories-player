    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "017",
    "voice": "produce_events/201200411/2012004110080"
  },
  {
    "id": 2012004110090,
    "speaker": "凛世",
    "text": "しかし……身分の違うふたりが会えるのは……\r\n１日につき……お線香１本分が燃える時間のみ……",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200411/2012004110090"
  },
  {
    "id": 2012004110100,
    "speaker": "凛世",
    "text": "大店の若旦那である男は……\r\n毎日……相手のもとへ通いました……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "rinze",
