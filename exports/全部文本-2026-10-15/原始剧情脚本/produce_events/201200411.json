    "waitTime": 2000,
    "bgEffect": "fade"
  },
  {
    "id": 2012004110110,
    "speaker": "凛世",
    "text": "しかし、身分違いの相手と交流することを親族は嫌い……\r\n男を……家に閉じ込めてしまいます……",
    "charAnim1": "shy3",
    "charAnim2": "face_anger",
