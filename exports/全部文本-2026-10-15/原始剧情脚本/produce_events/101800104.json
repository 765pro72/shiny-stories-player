    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800104/1018001040190"
  },
  {
    "id": 1018001040200,
    "speaker": "冬優子",
    "text": "でも、あんたに言われた言葉を思い出して\r\n……逃げるのはやめた",
