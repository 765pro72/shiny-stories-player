    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1022003030280,
    "speaker": "小糸",
    "text": "『………………\r\nそれって、今じゃないとだめなんでしょうか？』",
