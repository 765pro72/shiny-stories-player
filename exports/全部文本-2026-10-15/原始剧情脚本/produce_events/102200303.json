    "voice": "produce_events/102200303/1022003030150"
  },
  {
    "speaker": "トレーナー",
    "text": "うん、だからくれぐれも無理しないように\r\nよく見ててくれって言われてるの",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1022003030160,
    "speaker": "小糸",
    "text": "え…………",
