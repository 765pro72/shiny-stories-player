    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200511/2002005110240"
  },
  {
    "id": 2002005110250,
    "speaker": "灯織",
    "text": "プロデューサー……これから先もずっと……\r\n私のことを支えてくれますか……？",
