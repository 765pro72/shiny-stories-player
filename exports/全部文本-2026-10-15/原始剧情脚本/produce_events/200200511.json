    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200511/2002005110230"
  },
  {
    "id": 2002005110240,
    "speaker": "灯織",
    "text": "……",
    "charAnim4": "eye_front",
    "charAnim2": "face_cry",
