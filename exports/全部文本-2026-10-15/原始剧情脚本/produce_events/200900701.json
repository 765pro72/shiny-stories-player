      "time": 100
    },
    "voice": "produce_events/200900701/2009007010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "日替わり定食とお子様ランチをお願いします\r\nあと、ドリンクバーを２つ、付けてください",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "店員",
    "text": "はい！\r\n──ご注文を繰り返します",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店員",
    "text": "日替わり定食１つ、お子様ランチ１つ\r\nドリンクバー２つ……以上でよろしいでしょうか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009007010080,
    "speaker": "果穂",
    "text": "……",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
