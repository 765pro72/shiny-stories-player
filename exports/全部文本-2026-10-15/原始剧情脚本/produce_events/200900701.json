    "voice": "produce_events/200900701/2009007010090"
  },
  {
    "speaker": "店員",
    "text": "──放クラの果穂ちゃん……ですよね？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009007010100,
    "speaker": "果穂",
    "text": "！？\r\nはっ、はいっ！　あたし、小宮果穂ですっ！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900701/2009007010100"
  },
  {
    "speaker": "店員",
    "text": "やっぱり……！\r\n私、放クラと果穂ちゃんの大ファンなんですっ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店員",
    "text": "あのっ、握手してもらってもいいですか！？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009007010110,
    "speaker": "果穂",
    "text": "わぁ……！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "r",
    "textFrame": "001",
    "voice": "produce_events/200900701/2009007010110",
    "voiceKeep": true
  },
  {
    "speaker": "果穂",
    "text": "はいっ！　どうぞ！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "店員",
    "text": "……わ……う、嬉しいっ\r\nありがとうございます……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店員",
    "text": "果穂ちゃんのこと、ずっと応援してます！\r\nお仕事、頑張ってくださいね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2009007010120,
    "speaker": "果穂",
    "text": "ありがとうございます！　がんばりますっ！\r\nお姉さんも！　お仕事がんばってください……っ！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900701/2009007010120"
  },
  {
    "speaker": "店員",
    "text": "っ……はいっ……！　ありがとうございます！\r\nそれじゃあ……あっ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店員",
    "text": "──それでは、失礼いたします！",
    "textCtrl": "p",
    "textFrame": "003"
  },
