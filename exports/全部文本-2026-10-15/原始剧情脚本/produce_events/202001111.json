  },
  {
    "speaker": "プロデューサー",
    "text": "何が食べたい？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2020011110020,
    "speaker": "透",
    "text": "んー……\r\nサンマーメン",
