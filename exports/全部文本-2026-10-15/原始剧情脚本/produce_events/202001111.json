    "textFrame": "001",
    "voice": "produce_events/202001111/2020011110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、この間食べたやつか\r\nあの田舎の駅で",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "toru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
