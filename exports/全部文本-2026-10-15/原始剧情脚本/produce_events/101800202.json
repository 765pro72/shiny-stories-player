  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\n今日はこれで終わりだから、一旦事務所に帰るか",
    "charLipAnim": "lip_sad_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018002020030,
    "speaker": "冬優子",
    "text": "はいはい、じゃあ駐車場に……",
