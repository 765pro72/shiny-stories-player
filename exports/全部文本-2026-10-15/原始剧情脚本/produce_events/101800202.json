    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800202/1018002020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………まったく、仕方ないな",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018002020150,
