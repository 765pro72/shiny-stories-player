  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018002020090,
    "speaker": "冬優子",
    "text": "コーヒーに罪はないし\r\nこれはこれで、もらってあげるけど……",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
