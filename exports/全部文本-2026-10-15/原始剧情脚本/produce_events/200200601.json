    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200601/2002006010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな、俺も気を付けないと──\r\nうわっ！",
