    },
    "voice": "produce_events/200101302/2001013020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……すまない\r\nちょっとお節介だったかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020120,
    "speaker": "真乃",
    "text": "い、いえ……っ\r\nその……うれしいです……っ",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020120"
  },
  {
    "id": 2001013020130,
    "speaker": "真乃",
    "text": "あの時、ちょっと話したことだったのに、\r\nこんなにいろいろ教えていただいて……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020130"
  },
  {
    "id": 2001013020140,
    "speaker": "真乃",
    "text": "本までお借りしちゃっていいんでしょうか",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、全然構わないよ\r\n返すのはいつでもいいから、ゆっくり見てくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2001013020150,
    "speaker": "真乃",
    "text": "……ありがとうございます\r\nそれじゃあ、お借りしますね",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020150"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
