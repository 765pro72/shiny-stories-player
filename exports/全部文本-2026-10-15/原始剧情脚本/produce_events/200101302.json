  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "何に注目するのか、何を撮りたいのか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう強く意識すると、\r\nその気持ちまで写真に写るんだそうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020210,
    "speaker": "真乃",
    "text": "何を撮りたいのか……",
