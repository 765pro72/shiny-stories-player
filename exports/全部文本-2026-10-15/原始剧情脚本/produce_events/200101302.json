    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 2001013020220,
    "speaker": "真乃",
    "text": "……今までは目に映るものをきれいだなって\r\nそのまま撮ろうとしていたかもしれません……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん、そういう撮り方をしてもいいって思うよ\r\nでも、ピンとこないときは試してみてもいいなってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020230,
    "speaker": "真乃",
    "text": "心が動いたものを……どう伝えるか……",
