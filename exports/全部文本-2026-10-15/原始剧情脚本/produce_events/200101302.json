    "waitTime": 2500
  },
  {
    "id": 2001013020090,
    "speaker": "真乃",
    "text": "は、はい、きれいなピンク色がいつもくすんでしまって\r\nなんだかぼんやりした写真になってしまうんです……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、俺もちょっと気になって調べてみたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "カメラの機能で明るさを調整したりとか\r\n色々あるようだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大事なのは写したいものをよく見て\r\n自分が何に心が動いたかを写真に込めること",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020100,
    "speaker": "真乃",
    "text": "何に心が動いたかを……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "スキル的なことは一旦おいといて\r\n写す対象との向き合い方を意識するのもいいと思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "……なんて、実はほとんどこの本の受け売りなんだ\r\nよかったら、真乃も読んでみないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
