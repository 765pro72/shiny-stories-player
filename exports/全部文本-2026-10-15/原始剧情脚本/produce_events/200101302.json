    "waitTime": 2500
  },
  {
    "id": 2001013020160,
    "speaker": "真乃",
    "text": "わぁ……きれいな写真\r\n撮り方のコツもたくさん……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101302/2001013020160"
  },
  {
    "id": 2001013020170,
    "speaker": "真乃",
    "text": "……どれを参考にしたらいいか\r\nちょっと迷っちゃいそうです",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、同感だ\r\n俺も最初は戸惑ったんだけど……",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "素敵だなと思える写真を探して、\r\nそのテクニックを試してみるのもいいのかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "例えば──",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "『目線を意識してみる』",
    "nextLabel": "1"
  },
  {
    "select": "『どこに注目するか』",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "『違うものを\r\n撮ってみる』かな",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "──とか、面白いなって思ったんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mano",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "この、地面の近くで撮った写真とか\r\n写ってる景色が大きく壮大に見えたりしてさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと、こびとになったみたいな気がしないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020180,
    "speaker": "真乃",
    "text": "ふふ……\r\nはい、こびとさんになった気分になります",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200101302/2001013020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "こんな感じで、自分の目の高さからずらしてみるだけで\r\n面白い目を引く写真になることもあるんだって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020190,
    "speaker": "真乃",
    "text": "自分の目の高さから、ずらして……\r\n鳥さんの目線みたいに上から撮ってみる、とかもでしょうか",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、スマホで撮ってると結構無意識に\r\nやってたりすることもあるけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それを意識的に、どんな写真に収めたいかを\r\n考えたりするのもいいんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020200,
    "speaker": "真乃",
    "text": "そうですね……っ\r\n次、写真を撮る時に意識してやってみます……っ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
