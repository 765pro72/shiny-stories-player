  },
  {
    "id": 2001013020110,
    "speaker": "真乃",
    "text": "ほわ……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
