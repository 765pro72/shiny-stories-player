    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020070"
  },
  {
    "id": 2001013020080,
    "speaker": "真乃",
    "text": "お花見はまだなのに、\r\nいっぱい桜を楽しめてるなって……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101302/2001013020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "春でいっぱいか……うん、いいんじゃないか、\r\nきっと当日はもっと楽しめるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……──そういえば真乃、\r\n桜が上手く撮れないって話してたよな",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
