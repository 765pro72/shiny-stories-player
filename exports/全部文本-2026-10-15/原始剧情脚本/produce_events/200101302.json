    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001013020060,
    "speaker": "真乃",
    "text": "あ……えっと、その\r\n前にも、桜味のものを口にしたなって思って……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
