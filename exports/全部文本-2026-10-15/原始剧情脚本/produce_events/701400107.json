[
  {
    "speaker": "プロデューサー",
    "text": "甘奈、ちょっといいか？\r\n『W.I.N.G.』のことなんだが……",
    "charAnim1": "wait",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "014",
    "charPosition": {
