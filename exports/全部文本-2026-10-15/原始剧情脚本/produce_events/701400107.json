      "y": 640,
      "order": 0
    },
    "bg": "00002",
    "bgm": "006"
  },
  {
    "id": 7014001070010,
    "speaker": "甘奈",
    "text": "どーだったの……？",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070010"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈は『W.I.N.G.』に……",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "出場が決定した！\r\nおめでとう！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070020,
    "speaker": "甘奈",
    "text": "……え？\r\nホント？　よかった……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070020"
  },
  {
    "speaker": "プロデューサー",
    "text": "『W.I.N.G.』の舞台に立てるんだぞ\r\nやったな、甘奈！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070030,
    "speaker": "甘奈",
    "text": "うん！\r\nこれも、プロデューサーさんのおかげだよね",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070030"
  },
  {
    "id": 7014001070040,
    "speaker": "甘奈",
    "text": "ここまで連れてきてくれて\r\nありがとー！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070040"
  },
  {
    "speaker": "プロデューサー",
    "text": "おいおい気が早いぞ\r\nまだ終わったわけじゃないんだ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070050,
    "speaker": "甘奈",
    "text": "えへへへ、わかってるよ～",
    "charAnim1": "shy1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070050"
  },
  {
    "id": 7014001070060,
    "speaker": "甘奈",
    "text": "わかってるけど\r\n今どうしてもお礼が言いたかったんだー",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070060"
  },
  {
    "id": 7014001070070,
    "speaker": "甘奈",
    "text": "だってここまでこられたのは\r\nプロデューサーさんが甘奈を変えてくれたからだもん",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070070"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺はそんな大層なことはしてないよ\r\n甘奈が変わったのなら、それは甘奈の努力があったからだ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070080,
    "speaker": "甘奈",
    "text": "そんなことないと思うんだけどなー\r\nでも、そう言ってくれてうれしい☆",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070080"
  },
  {
    "speaker": "プロデューサー",
    "text": "甘奈、ここまで来たら優勝目指して突っ走ろう！",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070090,
    "speaker": "甘奈",
    "text": "うん！　みんながすっごく楽しめるように\r\nアイドルとして『W.I.N.G.』を盛り上げていくね！",
    "charAnim1": "anger1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070090"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなを楽しませるには、まず甘奈も楽しまないとな！\r\nそうすればきっと結果もついてくるさ",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7014001070100,
    "speaker": "甘奈",
    "text": "えへ、\r\nプロデューサーさん、めっちゃいいこと言うじゃん☆",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070100"
  },
  {
    "id": 7014001070110,
    "speaker": "甘奈",
    "text": "甘奈、思いっきり楽しんでくるね！",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070110"
  },
  {
    "id": 7014001070120,
    "speaker": "甘奈",
    "text": "プロデューサーさんのために、みんなのために……\r\nぜったいサイコーのステージにしてみせるからっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701400107/7014001070120"
  },
  {
    "label": "end"
  }
]