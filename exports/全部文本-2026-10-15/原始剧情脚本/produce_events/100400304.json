    "voice": "produce_events/100400304/1004003040130"
  },
  {
    "id": 1004003040140,
    "speaker": "恋鐘",
    "text": "ううん、あの\r\nプロデューサー、聞いてくれる？",
    "charAnim1": "wait4",
