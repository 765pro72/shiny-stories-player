  {
    "speaker": "プロデューサー",
    "text": "──だけど、今\r\nそれだけじゃなくなろうとしてるんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003040350,
    "speaker": "恋鐘",
