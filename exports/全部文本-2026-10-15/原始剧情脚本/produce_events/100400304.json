    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040250"
  },
  {
    "id": 1004003040260,
    "speaker": "恋鐘",
    "text": "……だからこそ、うちがアンティーカとか、\r\n事務所の看板に泥を塗るわけにはいかんって……",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040260"
  },
  {
    "id": 1004003040270,
    "speaker": "恋鐘",
    "text": "ほんとは、みんなが\r\n誇れるようなアイドルになりたかけど……",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040270"
  },
  {
    "id": 1004003040280,
    "speaker": "恋鐘",
    "text": "全然上手くいかん練習しながら、\r\n色んなこと思い出しとったらわからんようになって──……",
