    "voice": "produce_events/100400304/1004003040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003040150,
    "speaker": "恋鐘",
    "text": "…………この間、\r\n『G.R.A.D.』の予選があったやろ？",
    "charAnim1": "sad2",
