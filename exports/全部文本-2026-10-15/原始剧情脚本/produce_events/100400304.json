    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040240"
  },
  {
    "id": 1004003040250,
    "speaker": "恋鐘",
    "text": "プロデューサーがそがん言ってくれんかったら、\r\nうちはここまでこれんかったばい",
