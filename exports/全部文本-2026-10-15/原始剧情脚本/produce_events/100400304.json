    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040190"
  },
  {
    "id": 1004003040200,
    "speaker": "恋鐘",
    "text": "……うち、誤魔化すのばっかり上手くなって\r\nほんとの意味で、ちゃんと成長できとるとかなって",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400304/1004003040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなこと……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004003040210,
    "speaker": "恋鐘",
    "text": "アイドルはじめた頃は、なんでもできるつもりで……\r\nでもやってみたら、できんことばっかりで",
    "charAnim1": "smile2",
