  },
  {
    "id": 1024004020020,
    "speaker": "off",
    "text": "一緒に……\r\nたぶん今は、一緒に……目指してる……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102400402/1024004020020"
  },
  {
    "id": 1024004020030,
    "speaker": "off",
