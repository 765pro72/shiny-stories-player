  {
    "speaker": "プロデューサー",
    "text": "……ショートケーキ、チョコケーキ、\r\nチーズケーキ……色々あるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あさひはどれが食べたい？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 3017022010020,
    "speaker": "あさひ",
    "text": "全部じゃダメっすか？",
