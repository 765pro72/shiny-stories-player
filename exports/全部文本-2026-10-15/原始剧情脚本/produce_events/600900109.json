      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/600900109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/600900109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "off",
    "bgEffect": "mask",
    "bg": "00002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂……はいないのか？\r\nどこに行ったんだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bgEffect": "mask",
    "bg": "00004",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 6009001090010,
    "speaker": "果穂",
    "text": "……",
    "charAnim1": "wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "009",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/600900109/6009001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっ、空なんか眺めてどうした……事務所の前だからって、\r\n夜遅くに一人で出歩いたら危ないぞ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090020,
    "speaker": "果穂",
    "text": "わわっ、プロデューサーさんっ！？　すみません！\r\nちょっとぼーっとしてました",
    "charAnim1": "surp2",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "何見てたんだ、星か？",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090030,
    "speaker": "果穂",
    "text": "はいっ！　なんかこう……\r\nいつもよりきれいに見えて！",
    "charAnim1": "wait4",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん、きれいな星空だ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090040,
    "speaker": "果穂",
    "text": "それで、なんだかエンディングって\r\n感じがするなーって思ってたんですっ",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090040"
  },
  {
    "id": 6009001090050,
    "speaker": "果穂",
    "text": "あの『W.I.N.G.』で優勝もできましたしっ！",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは。たしかにな",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090060,
    "speaker": "果穂",
    "text": "ですよねっ\r\nそれに、こうやって星がいっぱいの空を見てると……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090060"
  },
  {
    "id": 6009001090070,
    "speaker": "果穂",
    "text": "優勝するまでお世話になった人たちの名前も、\r\n見える気がします！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "この空にか？",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090080,
    "speaker": "果穂",
    "text": "はいっ！　番組の終わりに、エンディングテーマと一緒に\r\nスタッフさんの名前が出てくるみたいに……",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090080"
  },
  {
    "id": 6009001090090,
    "speaker": "果穂",
    "text": "お父さん、お母さん、お兄ちゃん、マメ丸、友達のみんな、\r\nユニットのみんな……はづきさんに社長さん",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090090"
  },
  {
    "id": 6009001090100,
    "speaker": "果穂",
    "text": "それで最後に、いっちばんおっきい字で、\r\nプロデューサーさん、です！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090100"
  },
  {
    "id": 6009001090110,
    "speaker": "果穂",
    "text": "えへへっ！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090110"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは。それはうれしいけど、俺が一番でいいのか？",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090120,
    "speaker": "果穂",
    "text": "はい！　プロデューサーさんには、\r\nいっぱい助けてもらいましたからっ",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090120"
  },
  {
    "id": 6009001090130,
    "speaker": "果穂",
    "text": "あの、プロデューサーさん！\r\n本当にありがとうございました！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090130"
  },
  {
    "id": 6009001090140,
    "speaker": "果穂",
    "text": "あたし、プロデューサーさんのおかげで、\r\n優勝できましたっ",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことはないよ\r\n果穂が頑張ったから、優勝できたんだ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090150,
    "speaker": "果穂",
    "text": "いえっ！　あたしとプロデューサーさんは、\r\nチームですから！　チームの勝利なんです！",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090150"
  },
  {
    "id": 6009001090160,
    "speaker": "果穂",
    "text": "ヒーローも一人で勝てるわけじゃなくて、\r\n仲間の助けが必要ですからっ",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090160"
  },
  {
    "id": 6009001090170,
    "speaker": "果穂",
    "text": "一緒に戦ってきた仲間の協力を忘れたらダメです",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……ヒーローアイドル・小宮果穂を助けられたなら、\r\n俺も光栄だよ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090180,
    "speaker": "果穂",
    "text": "えへへ！　……こういう話をしてると、\r\nやっぱり最終回みたいですねっ！",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090180"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだな\r\nでも、まだ終わりじゃないぞ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090190,
    "speaker": "果穂",
    "text": "今日お家に帰って眠ったらまた明日が始まって……\r\nあたしたちのお話は続いていくんですよね",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。これからも……いや、これまで以上に、\r\nアイドルとして忙しくなるだろうな",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090200,
    "speaker": "果穂",
    "text": "いっぱいお仕事をして、もっといろんな人が\r\nあたしを見てくれるようになるんですね……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090200"
  },
  {
    "id": 6009001090210,
    "speaker": "果穂",
    "text": "ヒーローを見て、あたしが元気をもらうみたいに、\r\nあたしも、もっとたくさんの人を元気にできるんですよね！",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、俺たちの戦いはこんなところで終わらない\r\nまだまだ続くぞ！",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6009001090220,
    "speaker": "果穂",
    "text": "やったー！\r\nあたし、スゴくカッコいいアイドルを目指して頑張ります！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090220"
  },
  {
    "id": 6009001090230,
    "speaker": "果穂",
    "text": "だから、これからもよろしくお願いしますっ\r\nプロデューサーさん！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600900109/6009001090230"
  },
  {
    "label": "end"
  }
]