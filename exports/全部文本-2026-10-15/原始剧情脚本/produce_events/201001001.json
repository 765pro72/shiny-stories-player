    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001001/2010010010240"
  },
  {
    "id": 2010010010250,
    "speaker": "智代子",
    "text": "食べ終わってから、みんなで『集中しすぎ！』って",
