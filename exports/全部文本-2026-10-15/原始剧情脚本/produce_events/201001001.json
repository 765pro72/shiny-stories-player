  },
  {
    "speaker": "プロデューサー",
    "text": "あはは、わかるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "無言だけど団らんって感じっていうか──",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "無言になってても大丈夫っていう\r\n安心感があるからこその無言っていうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010010010260,
    "speaker": "智代子",
    "text": "あーっ、確かに！\r\nそんな感じです！",
