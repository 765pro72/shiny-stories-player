    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701101/2007011010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いらないことはないだろ\r\nまぁ書くのが大変だってのは同意するけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
