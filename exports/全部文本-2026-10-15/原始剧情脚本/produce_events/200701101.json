    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701101/2007011010050"
  },
  {
    "id": 2007011010060,
    "speaker": "結華",
    "text": "履歴書もそうだけどさぁ、\r\n絶対長所の欄いらないでしょ",
