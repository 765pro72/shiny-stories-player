      "time": 100
    },
    "voice": "produce_events/201700804/2017008040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "メイドならそんなものだと思うけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008040070,
    "speaker": "あさひ",
    "text": "ダンス中、邪魔になりそうっす",
