  },
  {
    "speaker": "プロデューサー",
    "text": "あさひ、今は足、痛くないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008040080,
    "speaker": "あさひ",
    "text": "そうっすね、……たぶん",
