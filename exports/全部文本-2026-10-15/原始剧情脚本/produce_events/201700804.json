  {
    "speaker": "プロデューサー",
    "text": "すまん……頑張ったつもりなんだが\r\nセリフは大丈夫そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008040050,
    "speaker": "あさひ",
    "text": "そうっすねぇ……",
