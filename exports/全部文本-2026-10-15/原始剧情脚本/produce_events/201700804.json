  },
  {
    "speaker": "プロデューサー",
    "text": "衣装、暑いのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2017008040060,
    "speaker": "あさひ",
    "text": "いや……\r\nスカート、思ったより長いっす",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
