    "id": 1005003030010,
    "speaker": "摩美々",
    "text": "──２８３プロダクションの田中摩美々ですー\r\nよろしくお願いしますー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
