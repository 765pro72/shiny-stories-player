  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1005003030060,
    "speaker": "摩美々",
    "text": "……この変な文章は\r\nアイドルのキャッチコピーですか？",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100500303/1005003030060"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mamimi",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "off",
    "text": "『スマイル100%☆国民的クラスメイト』\r\n『昨日よりも今日　今日よりも明日　日・々・進・化』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうみたいだ\r\nはは……なかなか個性的だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030070,
    "speaker": "摩美々",
    "text": "……ねぇ、プロデューサー",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100500303/1005003030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030080,
    "speaker": "摩美々",
    "text": "私にもキャッチコピー、つけてみてくださいよー",
    "charAnim1": "play",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500303/1005003030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ！？\r\nお、おう。そうだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030090,
    "speaker": "摩美々",
    "text": "…………",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500303/1005003030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……こ、\r\n『個性派ファッションマスター・まみみ』──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030100,
    "speaker": "摩美々",
    "text": "チェンジで",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500303/1005003030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "うっ……\r\nせ、せめてもう少し時間があれば……",
    "charAnim2": "face_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030110,
    "speaker": "摩美々",
    "text": "ふふー\r\n時間切れです、もういいですよー",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500303/1005003030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030120,
    "speaker": "摩美々",
    "text": "ファッションマスターって……\r\nふふ……",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500303/1005003030120"
  },
  {
    "charAnim1": "wait",
    "charLabel": "mamimi",
    "textFrame": "off",
