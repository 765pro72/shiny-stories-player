      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………\r\n──コピーじゃないけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "自己紹介も、俺が考えることだってできなくはない\r\nだけど、俺はそれよりも、摩美々が伝えたいこと──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『摩美々が、どうしたいか』を優先したい。摩美々の\r\nアイドルに対する思いを、みんなに伝えてほしいんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030130,
    "speaker": "摩美々",
    "text": "……１週間コーディネートも組まなきゃなのに\r\n考えること、増やさないでくださいー",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100500303/1005003030130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それは確かに……\r\nすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だけど、よかったら考えてみてくれ",
    "charAnim2": "face_wait",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003030140,
    "speaker": "摩美々",
    "text": "…………\r\nまぁ、気が向いたらぁ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
