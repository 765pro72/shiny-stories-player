    "voiceKeep": true
  },
  {
    "speaker": "羽那",
    "text": "夜遅くに『今すぐ会いに来て』って言ったら、来てくれる？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hana",
    "textCtrl": "l",
    "textFrame": "001"
  },
  {
    "select": "もちろん！",
