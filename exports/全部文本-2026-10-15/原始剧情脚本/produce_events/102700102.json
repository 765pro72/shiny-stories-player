    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "スタッフ",
    "text": "だけど、そこまで２８３さんを惹きつける何かが\r\n羽那ちゃんにはあったんですねぇ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……──",
    "textCtrl": "p",
