  {
    "speaker": "プロデューサー",
    "text": "それじゃあ、質問とかはないか？\r\nなんでも──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、はは\r\nなんでもって言いすぎか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1027001020020,
    "speaker": "羽那",
    "text": "ふふっ──！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102700102/1027001020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だけど、なんだって伝えてほしいんだ\r\n羽那が思ってることとか、言いたいこととか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1027001020030,
    "speaker": "羽那",
    "text": "──うん",
