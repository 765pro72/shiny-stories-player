    "text": "……！　おう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1027001020050,
    "speaker": "羽那",
    "text": "プロデューサーって、何をする人なの？",
    "charAnim1": "wait2",
