  {
    "speaker": "監督",
    "text": "──はい、カット\r\n風野さんの撮影以上となります！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "撮影スタッフ",
    "text": "お疲れ様でした！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002018110010,
    "speaker": "灯織",
    "text": "あの……すみません",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040020110",
    "charPosition": {
      "x": 568,
