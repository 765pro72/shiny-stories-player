      "time": 100
    },
    "voice": "produce_events/200201811/2002018110010"
  },
  {
    "id": 2002018110020,
    "speaker": "灯織",
    "text": "今のところ、もう１テイクだけ\r\nお願いできないでしょうか？",
    "charAnim1": "sad3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201811/2002018110020"
  },
  {
    "speaker": "撮影スタッフ",
    "text": "うん、時間もあるし大丈夫だよ\r\nじゃあ、さっきの立ち位置からお願いね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002018110030,
    "speaker": "灯織",
    "text": "はい！\r\nありがとうございます。よろしくお願いします……！",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201811/2002018110030"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "bg": "00912",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "撮影スタッフ",
    "text": "今のテイクよかったよ～灯織ちゃん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002018110040,
    "speaker": "灯織",
    "text": "そうですか……！\r\nよかったです",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201811/2002018110040"
  },
  {
    "speaker": "監督",
    "text": "うん、撮り直した方を使おう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "監督",
    "text": "こだわってくれてありがとね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2002018110050,
    "speaker": "灯織",
    "text": "いえ、こちらこそ──\r\nありがとうございました！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201811/2002018110050"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
