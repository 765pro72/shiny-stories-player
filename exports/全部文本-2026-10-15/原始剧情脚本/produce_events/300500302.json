      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 3005003020150,
    "speaker": "結華",
    "text": "うん？　これもまたすごいねぇ\r\nダメージ加工レベル100みたいになってる",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
