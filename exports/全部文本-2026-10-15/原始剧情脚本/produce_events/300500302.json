    }
  },
  {
    "id": 3005003020180,
    "speaker": "摩美々",
    "text": "これもいい感じー\r\nさっきのと合わせるといいかもー",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
