    },
    "voice": "produce_events/300500302/3005003020200"
  },
  {
    "id": 3005003020210,
    "speaker": "摩美々",
    "text": "別にいいけど、どうしたのー？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
