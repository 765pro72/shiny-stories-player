    "voice": "produce_events/300500302/3005003020180"
  },
  {
    "id": 3005003020190,
    "speaker": "摩美々",
    "text": "三峰の服はカラフルだねー\r\nだけど、ここにキレを足したいかもー",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500302/3005003020190"
  },
  {
    "charLabel": "mamimi",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 3005003020200,
    "speaker": "結華",
    "text": "ねぇねぇまみみん！　\r\nちょっとまみみんの服着てみてもいい？",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 310,
