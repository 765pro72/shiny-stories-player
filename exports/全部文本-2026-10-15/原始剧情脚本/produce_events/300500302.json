    "voice": "produce_events/300500302/3005003020150"
  },
  {
    "id": 3005003020160,
    "speaker": "結華",
    "text": "これもすごくまみみんって感じ",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500302/3005003020160"
  },
  {
    "id": 3005003020170,
    "speaker": "結華",
    "text": "あー待って、こっちとこれ合わせたらすごく……\r\nおおお、いいんじゃないです！？",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
