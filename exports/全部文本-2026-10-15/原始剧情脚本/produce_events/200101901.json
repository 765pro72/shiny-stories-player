  },
  {
    "id": 2001019010230,
    "speaker": "真乃",
    "text": "……えっと……\r\n本当に、いいんでしょうか……？",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101901/2001019010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、遠慮はいらない",
