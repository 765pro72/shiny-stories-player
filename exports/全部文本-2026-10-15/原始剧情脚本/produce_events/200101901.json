  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "せっかくだから、なんでも食べたいものを\r\n言ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001019010220,
    "speaker": "真乃",
    "text": "ほわ……",
