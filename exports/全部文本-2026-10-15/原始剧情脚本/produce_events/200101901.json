  },
  {
    "id": 2001019010160,
    "speaker": "真乃",
    "text": "……それでは……また、何かしらの形で\r\nお返しさせてください",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
