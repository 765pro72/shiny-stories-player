    "textFrame": "001",
    "voice": "produce_events/200101901/2001019010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、ランチの時に話そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
