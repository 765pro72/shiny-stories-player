      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/202501001/2025010010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、よかった……\r\nその本は参考書か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010040,
    "speaker": "美琴",
    "text": "うん。一緒に出るアイドルの子が\r\nすごくよかったからって勧めてくれた本なの",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010040"
  },
  {
    "id": 2025010010050,
    "speaker": "美琴",
    "text": "私も別のものを買ってはいたんだけど、\r\nこの本の方がわかりやすくて……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010050"
  },
  {
    "id": 2025010010060,
    "speaker": "美琴",
    "text": "有名モデルのアドバイスや、\r\nキャットウォークを歩く時の心情まで書いてあるし",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010060"
  },
  {
    "id": 2025010010070,
    "speaker": "美琴",
    "text": "これを中心にやってみようかなって",
    "charAnim1": "think1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……いいものを勧めてもらったんだな\r\n美琴がやりやすいならそれが一番だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010080,
    "speaker": "美琴",
    "text": "やりやすい……うん、それもあるんだけど",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010080"
  },
  {
    "id": 2025010010090,
    "speaker": "美琴",
    "text": "今度のテーマに沿っているなって思って",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "今度のテーマ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010100,
    "speaker": "美琴",
    "text": "……協力、だって",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010100"
  },
  {
    "id": 2025010010110,
    "speaker": "美琴",
    "text": "デザイナーさん自身がそうやって成功できたから",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010110"
  },
  {
    "id": 2025010010120,
    "speaker": "美琴",
    "text": "出演者にも、大事にしてもらいたいみたい",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……それで美琴は早速そのアイドルからの\r\n協力をもらったわけだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010130,
    "speaker": "美琴",
    "text": "うん",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010130"
  },
  {
    "id": 2025010010140,
    "speaker": "美琴",
    "text": "でも私は何も返せていないから\r\n協力とは言えないんじゃないかって……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010140"
  },
  {
    "id": 2025010010150,
    "speaker": "美琴",
    "text": "……",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger1_s",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、でも俺は何かをすることだけが\r\n協力だとは思わないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010160,
    "speaker": "美琴",
    "text": "……どういうこと？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "その本を勧めてくれたアイドルの子もきっと\r\n実際に美琴が買って読んでくれてるってこと……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうのを知ったら、嬉しいと思うんだ\r\n勧めてよかったなってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "勧めて嬉しい気持ちと、勧められて嬉しい気持ち\r\nこれも立派な協力の形だと思うんだ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1_s",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ひとりじゃ勧めることも、勧めてもらうことも\r\nできないだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010170,
    "speaker": "美琴",
    "text": "……そういうことでいいのかな",
    "charAnim1": "think1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202501001/2025010010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "答えはショーの成功で理解できると思うよ\r\n今すぐ答えを出そうとしなくてもいいさ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1_s",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それにまだ先は長いんだ、美琴がその子に\r\nしてあげられることもあるかもしれないし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010180,
    "speaker": "美琴",
    "text": "うん、そうだね……わかった",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
