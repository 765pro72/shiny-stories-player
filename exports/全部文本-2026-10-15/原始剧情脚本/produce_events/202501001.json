    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "どうだ美琴、ファッションショーの練習\r\nはかどってるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025010010030,
    "speaker": "美琴",
    "text": "うん、難しいけど……なんとか\r\n形になってきていると思う",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "3000250030",
    "charPosition": {
      "x": 568,
