    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900901/2009009010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだよな──\r\n俺も一緒に見てもいいかな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009009010070,
