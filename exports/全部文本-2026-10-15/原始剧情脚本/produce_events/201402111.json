    "waitType": "time",
    "waitTime": 1700
  },
  {
    "speaker": "プロデューサー",
    "text": "常に人を思いやろうとするのは、甘奈の素敵な部分だと思う\r\nけど今は、それが愛花との間に壁を作ってる気がするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
