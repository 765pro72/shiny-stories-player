    "voice": "produce_events/200401601/2004016010120"
  },
  {
    "speaker": "店長",
    "text": "いやあ、光栄です\r\nそれに──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "次の撮影もおありだから、召しあがるのは\r\n一口だけかなと思ったんですが……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "店長",
    "text": "全部綺麗に食べきっていただいて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2004016010130,
    "speaker": "恋鐘",
    "text": "店員さんが愛情こめて作ってくれたうまかもん、\r\n全部食べんば～！　ってだけです～……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200401601/2004016010130"
  },
  {
    "id": 2004016010140,
    "speaker": "恋鐘",
    "text": "最高のもん出したか気持ち、ばり伝わってきましたけん\r\nうちもそいに応えたかですし",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
