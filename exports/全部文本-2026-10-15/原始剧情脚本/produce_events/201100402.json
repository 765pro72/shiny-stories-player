    "charLipAnim": "lip_anger",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201100402/2011004020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、一緒に作るか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011004020050,
    "speaker": "樹里",
    "text": "そういう意味じゃねーよ！\r\n……ガラじゃねーって言ってんだ",
