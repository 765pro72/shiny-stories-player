    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200411/2022004110090"
  },
  {
    "id": 2022004110100,
    "speaker": "小糸",
    "text": "メイクさんのあの……\r\n宝箱みたいなのから",
