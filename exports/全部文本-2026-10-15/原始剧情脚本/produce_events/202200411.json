    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200411/2022004110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "撮影の現場、\r\n初めて来た時は俺も驚いたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こういうふうになってるんだなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022004110080,
    "speaker": "小糸",
    "text": "そ、そうですよね……！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200411/2022004110080"
  },
  {
    "id": 2022004110090,
    "speaker": "小糸",
    "text": "わ、わたしメイクルームでも\r\nびっくりしちゃいました……！",
