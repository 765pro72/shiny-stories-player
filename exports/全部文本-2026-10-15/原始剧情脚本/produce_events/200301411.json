  {
    "id": 2003014110010,
    "speaker": "めぐる",
    "text": "…………ふふ",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
