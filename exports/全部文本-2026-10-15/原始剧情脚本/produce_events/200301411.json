    },
    "voice": "produce_events/200301411/2003014110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……友達か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110020,
    "speaker": "めぐる",
    "text": "うん！　そう！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110020"
  },
  {
    "id": 2003014110030,
    "speaker": "めぐる",
    "text": "わかる？",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるは友達相手の時、特に嬉しそうな顔をするから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110040,
    "speaker": "めぐる",
    "text": "そんなにー！？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110040"
  },
  {
    "id": 2003014110050,
    "speaker": "めぐる",
    "text": "なんかちょっと恥ずかしいな……！",
    "charAnim1": "wait2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　仲良しだなと思うだけだよ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110060,
    "speaker": "めぐる",
    "text": "えっ！　仲良しに見える！？",
    "charAnim1": "shy1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、違うのか\r\nさっきからちょくちょく連絡きてるから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110070,
    "speaker": "めぐる",
    "text": "ううん！　違わない！\r\nっていうか……",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110070"
  },
  {
    "id": 2003014110080,
    "speaker": "めぐる",
    "text": "他の人から見ても\r\n仲良いなって思ってもらえたら、すごーく嬉しいなぁ！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110080"
  },
  {
    "id": 2003014110090,
    "speaker": "めぐる",
    "text": "相手、海のイベントで代理した子だから！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ！？\r\n連絡先交換してたのか……！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0454"
  },
  {
    "id": 2003014110100,
    "speaker": "めぐる",
    "text": "実はね！　してました！\r\nえへへっ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110100"
  },
  {
    "id": 2003014110110,
    "speaker": "めぐる",
    "text": "連絡先ゲットしちゃったんだー！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ！\r\nどんな話してるんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "やっぱりこの前のイベントの話？",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110120,
    "speaker": "めぐる",
    "text": "それもした！",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110120"
  },
  {
    "id": 2003014110130,
    "speaker": "めぐる",
    "text": "もうもう、ずっと『ごめんね』と『ありがとう』って\r\n伝えてくれるから、お腹いっぱいだよー！　って",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "本人に非はなかったのにな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110140,
    "speaker": "めぐる",
    "text": "そうなの！　だから余計に、\r\nそんなに気にしなくていいよ！　って思っちゃって",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110140"
  },
  {
    "id": 2003014110150,
    "speaker": "めぐる",
    "text": "最後のほう、ちょっと漫才みたいになっちゃった！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、なんかイメージできるよ",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110160,
    "speaker": "めぐる",
    "text": "えへへっ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110160"
  },
  {
    "id": 2003014110170,
    "speaker": "めぐる",
    "text": "あとはねぇ、また一緒にお仕事しようねとか\r\n今度遊びに行こうよとか",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110170"
  },
  {
    "id": 2003014110180,
    "speaker": "めぐる",
    "text": "美味しかったロケ弁の話とか、\r\nおすすめの差し入れの話とか、ほんとなんでもするの",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110180"
  },
  {
    "id": 2003014110190,
    "speaker": "めぐる",
    "text": "一緒に写真撮ってツイスタに上げたい！　とかも\r\nどっちのファンも驚かせたくて！",
    "charAnim1": "touch",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……\r\nみんなはリハのエピソード知らないもんなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんでそこのふたりがピンポイントで仲良いんだ？\r\nってなるのか",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110200,
    "speaker": "めぐる",
    "text": "そう！\r\nだからどこかでこの話もしたいなぁって！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301411/2003014110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "いい友達ができたな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003014110210,
    "speaker": "めぐる",
    "text": "うん！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
