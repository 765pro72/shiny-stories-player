  {
    "speaker": "ドラマスタッフ",
    "text": "────このドラマにはどんな気持ちで挑みましたか？",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
