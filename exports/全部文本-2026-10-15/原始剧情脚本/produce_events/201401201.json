  {
    "speaker": "プロデューサー",
    "text": "あっ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010240,
    "speaker": "甘奈",
    "text": "お！　何か出てきたっ？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
