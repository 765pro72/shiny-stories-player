    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、大丈夫だぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010040,
    "speaker": "甘奈",
    "text": "？　あれ、プロデューサーさん\r\n今日はコート着てないんだね",
