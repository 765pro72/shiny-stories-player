  },
  {
    "id": 2014012010230,
    "label": "2",
    "speaker": "甘奈",
    "text": "え～、絶対あると思うけどな～",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
