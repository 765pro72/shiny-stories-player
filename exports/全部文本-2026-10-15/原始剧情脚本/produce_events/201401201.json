    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "これは\r\n俺が事務所に入ってすぐの出来事でな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010200,
    "speaker": "甘奈",
    "text": "うんうん！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "とある双子の素敵なアイドルが\r\n面接を受けに来て……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010210,
    "speaker": "甘奈",
    "text": "……\r\nプロデューサーさん、それ、甘奈たちのこと……？",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010210"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、バレたか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010220,
    "speaker": "甘奈",
    "text": "もう、そういうごまかし方はずるいよ～！",
    "charAnim1": "anger1",
