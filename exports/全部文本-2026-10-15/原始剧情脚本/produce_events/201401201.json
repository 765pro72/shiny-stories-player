    },
    "voice": "produce_events/201401201/2014012010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやでもこれは夏の話か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010250,
    "speaker": "甘奈",
    "text": "え～、何々！　気になるよ～！",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010250"
  },
  {
    "id": 2014012010260,
    "speaker": "甘奈",
    "text": "もう春とか桜、関係なくてもいいから教えて～！",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201401201/2014012010260"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "俺の家の近くに公園があるんだけどな\r\nそこにかなり綺麗な桜が１本だけ咲いてるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010270,
    "speaker": "甘奈",
    "text": "へ～！　そんなにすごいなら\r\nちょっと見てみたいかも！　写真とかある？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "……見ない方がいいぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010280,
    "speaker": "甘奈",
    "text": "？　どうして？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201401201/2014012010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "人によってはな『見える』んだよ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014012010290,
    "speaker": "甘奈",
    "text": "えっ……？　それって……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
