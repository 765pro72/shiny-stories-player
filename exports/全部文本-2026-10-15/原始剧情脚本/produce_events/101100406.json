    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1011004060040,
    "speaker": "樹里",
    "text": "──アタシさ、この時『人生のターニングポイント』を\r\n聞かれて、上手く答えられなかったんだよな",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
