    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030320"
  },
  {
    "id": 3018004030330,
    "speaker": "冬優子",
    "text": "はいはい\r\n……じゃ、撮るわよ──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030330"
  },
  {
    "textFrame": "off",
    "effectLabel": "white",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "ffffff"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 1000,
      "easing": "easeOutQuart"
    },
    "waitType": "effect"
  },
  {
    "se": "0131",
    "waitType": "time",
    "waitTime": 1500,
    "stillType": "support_idols",
    "stillId": "2040180010"
  },
  {
    "effectLabel": "white",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018004030340,
    "speaker": "あさひ",
    "text": "おお……",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "005",
    "voice": "produce_events/301800403/3018004030340"
  },
  {
    "id": 3018004030350,
    "speaker": "愛依",
    "text": "すごくね！？　こういう系初めて着たんだけど！\r\nあれ、うち案外イケてる！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030350"
  },
  {
    "id": 3018004030360,
    "speaker": "冬優子",
    "text": "ふたりとも、完全に素じゃない\r\nこんな写真アップできないわよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030360"
  },
  {
    "id": 3018004030370,
    "speaker": "愛依",
    "text": "あ、そかそか……\r\nクールにクールに……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030370"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3018004030380,
    "speaker": "愛依",
    "text": "……やっぱ無理だって～！！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030380"
  },
  {
    "id": 3018004030390,
    "speaker": "冬優子",
    "text": "ったく……\r\nでも、ま、そうでしょうね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030390"
  },
  {
    "id": 3018004030400,
    "speaker": "冬優子",
    "text": "あんたたち、\r\n黙って動かず何もせず口も開かなければ可愛いんだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030400"
  },
  {
    "id": 3018004030410,
    "speaker": "冬優子",
    "text": "たまにはその顔、有効活用させなさいよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030410"
  },
  {
    "id": 3018004030420,
    "speaker": "あさひ",
    "text": "こんなちゃんと化粧したの\r\n仕事以外だと初めてっす～……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030420"
  },
  {
    "id": 3018004030430,
    "speaker": "愛依",
    "text": "そう！　メイクも冬優子ちゃん流でいつもと違うし！\r\nこのいいカンジのチーク、何使ってたっけ……！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030430"
  },
  {
    "id": 3018004030440,
    "speaker": "冬優子",
    "text": "どうしてもって言うなら、後で教えてあげてもいいけど？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030440"
  },
  {
    "id": 3018004030450,
    "speaker": "愛依",
    "text": "マジー！？　神！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030450"
  },
  {
    "id": 3018004030460,
    "speaker": "あさひ",
    "text": "でもこれ動きにくいっすね\r\n何かあっても走れないっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030460"
  },
  {
    "id": 3018004030470,
    "speaker": "冬優子",
    "text": "走らなくていい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030470"
  },
  {
    "id": 3018004030480,
    "speaker": "愛依",
    "text": "あさひちゃんあさひちゃん、\r\n後で一緒にツーショ撮ろ～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030480"
  },
  {
    "id": 3018004030490,
    "speaker": "愛依",
    "text": "もちろん、冬優子ちゃんも！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030490"
  },
  {
    "id": 3018004030500,
    "speaker": "冬優子",
    "text": "はいはい、仕方ないわね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030500"
  },
  {
    "id": 3018004030510,
    "speaker": "あさひ",
    "text": "このリボン、ぴらぴらしてて邪魔なんで、\r\n引っ張ってみていっすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030510"
  },
  {
    "id": 3018004030520,
    "speaker": "冬優子",
    "text": "したらどうなるかわかってるでしょうね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030520"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3018004030530,
    "speaker": "冬優子",
    "text": "……ほんと、口開くとせっかく可愛くしたのが台無し\r\nあんたたち、しばらく何も喋らないで",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030530"
  },
  {
    "id": 3018004030540,
    "speaker": "冬優子",
    "text": "（……って言っても無駄か）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030540"
  },
  {
    "id": 3018004030550,
    "speaker": "冬優子",
    "text": "（でも、写真にやかましさは写らないし……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030550"
  },
  {
    "id": 3018004030560,
    "speaker": "冬優子",
    "text": "……うん、悪くない、わね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800403/3018004030560"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]