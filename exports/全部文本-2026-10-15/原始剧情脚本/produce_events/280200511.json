  {
    "id": 2802005110170,
    "speaker": "かな",
    "text": "あなた相手にこういうのは下策だったわね\r\nこっちが無駄に恥ずかしくさせられて終わるのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charAnim3": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kana",
