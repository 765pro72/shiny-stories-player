  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "──本番、楽しみにしてるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "素敵な作品に仕上がると思う\r\nそれできっと、かなへの注目度ももっと高まる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2802005110070,
    "speaker": "かな",
    "text": "そう？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280200511/2802005110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！\r\nかなを推してる俺が言うんだから間違いない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "Ｂ小町の動画も見てるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "毎回面白いし、アイドルコンテンツに携わる人間としても\r\n学んでばかりだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2802005110080,
    "speaker": "かな",
    "text": "ありがと",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280200511/2802005110080"
  },
  {
    "textFrame": "off",
    "bg": "01123",
    "fg": "011231",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "waitType": "time",
