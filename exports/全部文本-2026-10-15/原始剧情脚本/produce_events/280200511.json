  {
    "id": 2802005110010,
    "speaker": "かな",
    "text": "今日は付き合ってくれてありがとう",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1048020020",
    "charPosition": {
