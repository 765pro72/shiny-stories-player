  {
    "id": 1022003010060,
    "speaker": "小糸",
    "text": "あ……あれ、\r\nプロデューサーさん……？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
