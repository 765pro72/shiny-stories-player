[
  {
    "id": 6011001030010,
    "speaker": "樹里",
    "text": "よし、勝ったぞ、プロデュ－サ－！\r\nちゃんと見ててくれたよな？",
    "charCategory": "stand_costume",
    "charAnim1": "surp1",
