  {
    "speaker": "プロデューサー",
    "text": "あさひ、一次審査の結果が──",
    "charAnim2": "face_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7017001010030,
    "speaker": "あさひ",
    "text": "──あ、ちょうどよかったっす、プロデューサーさん！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
