    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701700101/7017001010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかった、見せてみてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7017001010110,
