    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2003011030260,
    "speaker": "めぐる",
    "text": "本当だ……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200301103/2003011030260"
  },
  {
    "id": 2003011030270,
    "speaker": "めぐる",
    "text": "じゃあじゃあ、撮影に影響しないけど当てはまるもの\r\n他にもあるかもしれない……！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301103/2003011030270"
  },
  {
    "id": 2003011030280,
    "speaker": "めぐる",
    "text": "わたし、新しいものと青いものも探してみる！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301103/2003011030280"
  },
  {
    "textFrame": "off",
    "nextLabel": "end"
  },
  {
    "textFrame": "off"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "新品ならなんでもいいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011030290,
    "speaker": "めぐる",
    "text": "そうみたい！\r\n基本的には白いものだって",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301103/2003011030290"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、ちょうどいいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011030300,
    "speaker": "めぐる",
    "text": "えっ、何かある……？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301103/2003011030300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、この前試着したろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003011030310,
    "speaker": "めぐる",
    "text": "あっ！　あー！　ドレス！\r\n本当だ……あれ、新しいものを用意してもらってる……！",
    "charAnim1": "surp1",
