      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 3017024040090,
    "speaker": "あさひ",
    "text": "へー、そうなんすね",
    "charAnim1": "wait1",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
