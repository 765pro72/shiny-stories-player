  {
    "id": 3017024040020,
    "speaker": "あさひ",
    "text": "あ、プロデューサーさん！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
