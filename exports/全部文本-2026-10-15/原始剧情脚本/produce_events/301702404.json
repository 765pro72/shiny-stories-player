  },
  {
    "speaker": "プロデューサー",
    "text": "おお、模様が動いている",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 3017024040070,
    "speaker": "あさひ",
    "text": "わたしが手に持ってるスティックが\r\n磁石なんすよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301702404/3017024040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "へえ、そうなのか──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 3017024040080,
    "speaker": "あさひ",
    "text": "あ、動いちゃダメっす！",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
