  {
    "speaker": "インタビュアー",
    "text": "──今回のコンセプトは\r\n『かっこいいイルミネーションスターズ』でした",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3003012030360,
    "speaker": "めぐる",
    "text": "『最初にかっこいいイルミネでってお話をいただいた時、\r\n真乃と灯織とうんうん悩んじゃって』",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030360"
  },
  {
    "id": 3003012030370,
    "speaker": "灯織",
    "text": "『そもそもかっこいいって具体的に何？　って\r\n思わず聞いてしまいました』",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030370"
  },
  {
    "id": 3003012030380,
    "speaker": "真乃",
    "text": "『主観の話だから、\r\nこれっていうのは難しいねって３人でお話しました』",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030380"
  },
  {
    "id": 3003012030390,
    "speaker": "真乃",
    "text": "『そしたら、\r\nめぐるちゃんが研究しようって言ってくれたんです』",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030390"
  },
  {
    "id": 3003012030400,
    "speaker": "灯織",
    "text": "『それで打ち合わせの後に、めぐるの家に集まりました』",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030400"
  },
  {
    "id": 3003012030410,
    "speaker": "めぐる",
    "text": "『第１回イルミネ討論会！』",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030410"
  },
  {
    "id": 3003012030420,
    "speaker": "灯織",
    "text": "『それ、本当に使うの？』",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030420"
  },
  {
    "id": 3003012030430,
    "speaker": "めぐる",
    "text": "『第２回があるかもしれないし！』",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030430"
  },
  {
    "id": 3003012030440,
    "speaker": "真乃",
    "text": "『そうだねっ』",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030440"
  },
  {
    "id": 3003012030450,
    "speaker": "灯織",
    "text": "『ええ……やるかな』",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030450"
  },
  {
    "id": 3003012030460,
    "speaker": "めぐる",
    "text": "『やるよ！　だってきっとまた悩むもん\r\nなので、どこかで第２回が開催されます！』",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030460"
  },
  {
    "speaker": "インタビュアー",
    "text": "──開催されたら教えてください！\r\n誰かのおうちに集まるのはよくあるんですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3003012030470,
    "speaker": "灯織",
    "text": "『そうですね。ちょくちょく誰かの家に集まります』",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030470"
  },
  {
    "id": 3003012030480,
    "speaker": "真乃",
    "text": "『一番最近の集まりが討論会だったんですけれど……\r\n結構脱線しちゃいました』",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030480"
  },
  {
    "id": 3003012030490,
    "speaker": "めぐる",
    "text": "『３人でいると楽しくなっちゃって！』",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300301203/3003012030490"
  },
