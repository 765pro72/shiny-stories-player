  },
  {
    "speaker": "プロデューサー",
    "text": "ここから事務所までだぞ\r\nほらもう『２８３』って窓の文字が見えてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005010260,
    "speaker": "小糸",
    "text": "す、スーツだし……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200501/2022005010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "最近少し運動不足だけど──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005010270,
    "speaker": "小糸",
    "text": "に、荷物だってあるのに……！",
