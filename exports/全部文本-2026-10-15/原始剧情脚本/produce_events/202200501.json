  {
    "id": 2022005010070,
    "speaker": "小糸",
    "text": "……！\r\nぷ、プロデューサー、さん……！",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
