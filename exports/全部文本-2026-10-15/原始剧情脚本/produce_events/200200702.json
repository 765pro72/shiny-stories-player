    "textFrame": "001",
    "voice": "produce_events/200200702/2002007020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……\r\nせめて勢いが弱くならないと、難しいかもな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002007020030,
