  {
    "speaker": "プロデューサー",
    "text": "悪いな、車回せなくて\r\n疲れてるのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002015020010,
    "speaker": "灯織",
    "text": "いえ\r\nそれを言うならプロデューサーもですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040020080",
    "charPosition": {
