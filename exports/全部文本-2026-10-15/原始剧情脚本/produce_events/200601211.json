  {
    "id": 2006012110050,
    "speaker": "咲耶",
    "text": "！",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
