    "textFrame": "001",
    "voice": "produce_events/100100303/1001003030120"
  },
  {
    "id": 1001003030130,
    "speaker": "真乃",
    "text": "でも、私……この日のために予定を空けたこと\r\n言わなきゃいけなかったのに、伝えられなくて……",
    "charAnim1": "wait_return_L",
    "charLipAnim": "lip_sad",
