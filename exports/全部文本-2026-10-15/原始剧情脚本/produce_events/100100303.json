    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "057",
    "voice": "produce_events/100100303/1001003030110"
  },
  {
    "id": 1001003030120,
    "speaker": "真乃",
    "text": "私は、レッスンとかお仕事で忙しいだろうからって……\r\n気を遣って言ってくれたんです……",
