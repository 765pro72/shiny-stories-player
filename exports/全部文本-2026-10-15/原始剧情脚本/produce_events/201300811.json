      "time": 100
    },
    "voice": "produce_events/201300811/2013008110130"
  },
  {
    "id": 2013008110140,
    "speaker": "夏葉",
    "text": "プロデューサーは私に甘くて、\r\nそれから心配性だけど",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300811/2013008110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そういうことにしておくか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "natsuha",
    "textFrame": "off",
