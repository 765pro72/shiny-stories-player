  {
    "id": 2013008110130,
    "speaker": "夏葉",
    "text": "私から見て……",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
