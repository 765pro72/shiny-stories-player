  {
    "id": 2004021020200,
    "speaker": "恋鐘",
    "text": "『……私が何に怒ってるかわかってる？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "『……うーん\r\nあ、さっき勝手におやつ食べちゃったこと？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004021020210,
    "speaker": "恋鐘",
    "text": "『違う～～～～！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020210"
  },
  {
