  },
  {
    "id": 2004021020220,
    "speaker": "恋鐘",
    "text": "『さっき学食で、女の子見てたでしょ？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020220"
  },
  {
    "id": 2004021020230,
    "speaker": "恋鐘",
    "text": "『あんなにじっと見て……\r\n絶対、あの子のこと可愛いって思ってたよね！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020230"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ええっ、そんなことないよ！　誤解だって』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004021020240,
    "speaker": "恋鐘",
    "text": "『ほんとに～～？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020240"
  },
  {
    "speaker": "プロデューサー",
    "text": "『本当！』",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 800
  },
  {
    "id": 2004021020250,
    "speaker": "恋鐘",
    "text": "『むぅ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ごめんって！　そんなにむくれないでくれよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ほら、学食でなんかおごるから！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2004021020260,
    "speaker": "恋鐘",
    "text": "『なんかちゃんと謝ってない……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200402102/2004021020260"
  },
  {
    "id": 2004021020270,
    "speaker": "恋鐘",
    "text": "『私のこと好きならもっといいもの奢って！\r\nパフェとかケーキとか』",
