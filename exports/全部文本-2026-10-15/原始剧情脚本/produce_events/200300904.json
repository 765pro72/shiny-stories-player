    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040040"
  },
  {
    "speaker": "プロデューサー",
    "text": "め、めぐる……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009040050,
    "speaker": "めぐる",
    "text": "なーんてね",
