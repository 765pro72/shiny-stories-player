    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040030"
  },
  {
    "id": 2003009040040,
    "speaker": "めぐる",
    "text": "お休みの日まで、お仕事のこと考えたらいけないんだー",
