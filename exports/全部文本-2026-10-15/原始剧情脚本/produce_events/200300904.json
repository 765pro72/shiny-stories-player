    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040100"
  },
  {
    "id": 2003009040110,
    "speaker": "めぐる",
    "text": "そりゃもちろん、プロデューサーの家族とか、\r\n友達とかの方が断然長いんだけど……！",
