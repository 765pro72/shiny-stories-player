    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040120"
  },
  {
    "id": 2003009040130,
    "speaker": "めぐる",
    "text": "まぁ、気がするだけなんだけど……！",
