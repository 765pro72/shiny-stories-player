    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040020"
  },
  {
    "id": 2003009040030,
    "speaker": "めぐる",
    "text": "それに、『本当はオフ』なのはプロデューサーも、でしょ？",
