    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040110"
  },
  {
    "id": 2003009040120,
    "speaker": "めぐる",
    "text": "こんなこと考えてるんじゃないかなっていうの、\r\nなんとなーく、想像できるようになってきた気がする",
