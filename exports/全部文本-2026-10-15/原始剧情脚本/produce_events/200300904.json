    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040060"
  },
  {
    "id": 2003009040070,
    "speaker": "めぐる",
    "text": "しかも、昨日の夜辺りに、急に！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、お見通しだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009040080,
    "speaker": "めぐる",
    "text": "当たった？　やったー！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "エスパーかなってくらい、\r\nドンピシャに当てられちゃったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009040090,
    "speaker": "めぐる",
    "text": "それは言い過ぎかなーっ！",
