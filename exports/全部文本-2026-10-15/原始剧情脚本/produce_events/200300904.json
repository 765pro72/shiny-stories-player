    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040160"
  },
  {
    "id": 2003009040170,
    "speaker": "めぐる",
    "text": "じゃあサクサク始めよう！\r\nホースとかバケツないけど、水は使わないの？",
