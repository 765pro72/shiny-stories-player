    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040090"
  },
  {
    "id": 2003009040100,
    "speaker": "めぐる",
    "text": "──だってね、結構一緒にいるんだよ、わたしたち",
