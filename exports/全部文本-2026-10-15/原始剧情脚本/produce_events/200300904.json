    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300904/2003009040050"
  },
  {
    "id": 2003009040060,
    "speaker": "めぐる",
    "text": "そうだなー、『新年は気持ちよく迎えたいよな！』\r\n──とか、考えたんじゃない？",
