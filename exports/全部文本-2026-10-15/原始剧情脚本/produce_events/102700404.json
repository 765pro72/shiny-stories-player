    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102700404/1027004040090"
  },
  {
    "speaker": "女優",
    "text": "へー！　羽那ちゃんってケンカとかするんだ、意外！\r\n友達？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1027004040100,
    "speaker": "羽那",
    "text": "……事務所の人で",
