    "waitTime": 2400
  },
  {
    "speaker": "タレント",
    "text": "『いや、だって買うならこのなかでいちばん\r\nかわいいのがいいじゃないですか～！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "タレント",
