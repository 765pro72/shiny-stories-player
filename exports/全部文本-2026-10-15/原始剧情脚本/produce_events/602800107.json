    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/602800107/6901001070020"
  },
  {
    "id": 6902001070030,
    "speaker": "社長",
    "text": "……うるさいぞ。とにかく、\r\nそういうことなら私から言うことはない",
