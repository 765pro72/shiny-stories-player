  },
  {
    "speaker": "プロデューサー",
    "text": "……たしかに負けてしまいましたけど、\r\n彼女こそが最高のアイドルだと思っています",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001070020,
