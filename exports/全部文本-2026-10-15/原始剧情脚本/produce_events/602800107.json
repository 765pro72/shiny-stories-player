    "voice": "produce_events/602800107/6902001070020"
  },
  {
    "id": 6901001070010,
    "speaker": "はづき",
    "text": "ふふ\r\n社長が聞きたかった言葉、そのまま出てきましたね",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/602800107/6901001070010"
  },
  {
    "id": 6901001070020,
    "speaker": "はづき",
    "text": "もし違う言葉が出てきたら、\r\n説教してやるって言って聞かなかったのに",
