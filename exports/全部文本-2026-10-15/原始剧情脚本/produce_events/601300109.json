      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 6901001090010,
    "speaker": "はづき",
    "text": "プロデューサーさん！\r\n『W.I.N.G.』優勝、本当におめでとうございます！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090010"
  },
  {
    "id": 6901001090020,
    "speaker": "はづき",
    "text": "私も会場で見てたんですけど、\r\n発表の瞬間、思わず大声を出しちゃいましたよ！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090020"
  },
  {
    "id": 6901001090030,
    "speaker": "はづき",
    "text": "今もまだ興奮しちゃってて、\r\n今日はもう眠れそうにありません！",
    "charAnim1": "wait2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとうございます、はづきさん！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090010,
    "speaker": "社長",
    "text": "本当によくやった\r\n期待以上の結果を出してくれたな",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601300109/6902001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長も……ありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6901001090040,
    "speaker": "はづき",
    "text": "ふふ。私と社長も会場に来てましたけど、\r\nすごかったですよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090040"
  },
  {
    "id": 6901001090050,
    "speaker": "はづき",
    "text": "優勝したってわかった瞬間、社長が泣いてしまって……\r\nステージをほとんど見れていませんでしたから",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090050"
  },
  {
    "id": 6902001090020,
    "speaker": "社長",
    "text": "こ、こら！\r\n彼の前でそういうことを言うな！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601300109/6902001090020"
  },
  {
    "id": 6901001090060,
    "speaker": "はづき",
    "text": "それだけ優勝したのを\r\n喜んでたってことじゃないですか",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090060"
  },
  {
    "id": 6902001090030,
    "speaker": "社長",
    "text": "そ、それはそうだが……",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601300109/6902001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、本当にありがとうございます！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090040,
    "speaker": "社長",
    "text": "……とにかく。もっと礼を言うべき相手、\r\nいや、祝うべき相手がいるんじゃないか",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601300109/6902001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうですね\r\n今日の主役は、他でもない彼女ですから",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6902001090050,
    "speaker": "社長",
    "text": "なら、私たちのことは気にせず\r\n早く行ってこい",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "004",
    "voice": "produce_events/601300109/6902001090050"
  },
  {
    "id": 6901001090070,
    "speaker": "はづき",
    "text": "彼女のこと、いっぱい\r\n褒めてあげてくださいねー！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601300109/6901001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はい！　もちろんです！",
    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "off",
    "charLabel": "hazuki",
    "textFrame": "off",
    "bg": "00002",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 2000,
    "bgEffect": "mask"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏葉、本当によくやったな\r\n大活躍だったぞ！",
    "charAnim1": "wait2",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
    "charId": "013",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bgm": "020"
  },
  {
    "id": 6013001090010,
    "speaker": "夏葉",
    "text": "そうね……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090010"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだ？　うれしくないのか？\r\n大きなことを成し遂げるのは、夏葉の夢だったんだろ？",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090020,
    "speaker": "夏葉",
    "text": "いいえ、小さいわ！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか。ここでは満足しないってことだな？",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090030,
    "speaker": "夏葉",
    "text": "違うの、そうじゃなくて……",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090030"
  },
  {
    "id": 6013001090040,
    "speaker": "夏葉",
    "text": "スケールが大きいとか小さいとか、そういうことに\r\nこだわっていた自分が小さかったって気づいたのよ！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090040"
  },
  {
    "id": 6013001090050,
    "speaker": "夏葉",
    "text": "だって、プロデューサーも見たでしょう？\r\n会場にいたみんなの顔！",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090050"
  },
  {
    "id": 6013001090060,
    "speaker": "夏葉",
    "text": "すごくキラキラしてたわ……\r\nアイドルも、ファンも、スタッフも、みんな……！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090060"
  },
  {
    "id": 6013001090070,
    "speaker": "夏葉",
    "text": "アイドルって、あんなふうに\r\nみんなをキラキラさせることができるのね……！",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090070"
  },
  {
    "id": 6013001090080,
    "speaker": "夏葉",
    "text": "それだけで、もう充分にスケールが大きいじゃない！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090080"
  },
  {
    "id": 6013001090090,
    "speaker": "夏葉",
    "text": "私は今になって、やっとそのことに気づけたのよ",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090090"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、夢は叶ったってことか？",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090100,
    "speaker": "夏葉",
    "text": "…………",
    "charAnim1": "think",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090100"
  },
  {
    "id": 6013001090110,
    "speaker": "夏葉",
    "text": "……そうね、夢は叶ったのかもしれないわね",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090110"
  },
  {
    "id": 6013001090120,
    "speaker": "夏葉",
    "text": "今日のライブは大きいことだったって\r\n私はアイドルとしての誇りに誓って言えるもの",
    "charLipAnim": "lip_wait",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか。しかし意外だな\r\n俺はてっきり――",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090130,
    "speaker": "夏葉",
    "text": "もちろん、トップを目指すのは変わらないわよ！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090130"
  },
  {
    "id": 6013001090140,
    "speaker": "夏葉",
    "text": "大きいことを成し遂げたいって夢も持ち続けるわ！",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090140"
  },
  {
    "id": 6013001090150,
    "speaker": "夏葉",
    "text": "だって、私はまだまだ立ち止まりたくないもの",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090150"
  },
  {
    "id": 6013001090160,
    "speaker": "夏葉",
    "text": "だから、もっともっとって、\r\n次の大きいことを目指していくのよ！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090160"
  },
  {
    "id": 6013001090170,
    "speaker": "夏葉",
    "text": "そしていつかトップアイドルとして、\r\n世界一の偉業を成し遂げてみせるわ！",
    "charAnim1": "anger1",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……この前、本番を想定したレッスンを\r\n見せてもらったのを思い出すな）",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あれは今日の光景のようにも思えていたけど\r\n本当はもっと未来の光景なのかもしれない）",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな。俺は夏葉が誰よりも頑張ってるのを\r\nずっと見てきた。君ならきっとその夢を叶えられるよ",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090180,
    "speaker": "夏葉",
    "text": "……プロデューサー？\r\nアナタはいったい何を言ってるのかしら？",
    "charAnim1": "surp1",
    "charLipAnim": "lip_surp",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090180"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、だから夏葉ならできるって",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090190,
    "speaker": "夏葉",
    "text": "違うでしょ……",
    "charAnim1": "surp2",
    "charLipAnim": "lip_surp",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090190"
  },
  {
    "id": 6013001090200,
    "speaker": "夏葉",
    "text": "私とアナタでやるのよ、プロデューサー！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだったな。あんまり夏葉が\r\n大きくなったもんだから、つい忘れていたよ",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090210,
    "speaker": "夏葉",
    "text": "もう、私をここまで頑張って\r\n支えてくれたのはアナタなのよ？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090210"
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、俺はプロデューサーとして\r\n当然のことをしてきただけだぞ？",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090220,
    "speaker": "夏葉",
    "text": "それでもよ\r\n今まで、本当にありがとう",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090220"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう言われると、プロデューサー冥利に尽きるな\r\nこちらこそ、今までありがとう",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6013001090230,
    "speaker": "夏葉",
    "text": "うふふ、こんなふうに、成し遂げたことへの\r\n感慨に浸り合うのもいいものね……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090230"
  },
  {
    "id": 6013001090240,
    "speaker": "夏葉",
    "text": "でも、振り返る時間はもうおしまいにしましょう\r\nまだまだ私たちはこれからなんだから！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090240"
  },
  {
    "id": 6013001090250,
    "speaker": "夏葉",
    "text": "また前を向いて、一緒に突き進んでいくわよ！\r\n世界一のトップアイドルを目指して！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "nathuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601300109/6013001090250"
  },
  {
    "label": "end"
  }
]