    "voice": "produce_events/200300511/2003005110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当だ、今夜は空が澄んでるなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110030,
    "speaker": "めぐる",
    "text": "きらきらがいっぱいだー！",
