    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110030"
  },
  {
    "id": 2003005110040,
    "speaker": "めぐる",
    "text": "えへへ、わたしたちみたいだねっ",
