    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "イルミネーションスターズ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110050,
    "speaker": "めぐる",
    "text": "そうっ！　えへへっ……",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110050"
  },
  {
    "id": 2003005110060,
    "speaker": "めぐる",
    "text": "この公園で初めてプロデューサーに会ったんだよっ\r\n覚えてる？",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、めぐるがバスケしていたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110070,
    "speaker": "めぐる",
    "text": "それでプロデューサーが、\r\n怪しいものじゃないよーって！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "う……そんなこと言ったかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110080,
    "speaker": "めぐる",
    "text": "言ってたよー！",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110080"
  },
  {
    "id": 2003005110090,
    "speaker": "めぐる",
    "text": "ねえねえ、出会った時に比べて今のわたしはどう？\r\nかっこよくなったー？",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ！　驚くほど成長してる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110100,
    "speaker": "めぐる",
    "text": "えへへっ、やったー！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110100"
  },
  {
    "id": 2003005110110,
    "speaker": "めぐる",
    "text": "あの日までね、いつプロデューサーに\r\n会えるんだろうって毎日ワクワクしてたんだよっ",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110110"
  },
  {
    "id": 2003005110120,
    "speaker": "めぐる",
    "text": "それで、この公園でスーツの人を見つけて……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110120"
  },
  {
    "id": 2003005110130,
    "speaker": "めぐる",
    "text": "わたしのプロデューサーだ！\r\n……って、ビビッと来た時には走りだしてた！",
    "charAnim1": "anger1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110130"
  },
  {
    "id": 2003005110140,
    "speaker": "めぐる",
    "text": "ほんとに嬉しくって……！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110140"
  },
  {
    "id": 2003005110150,
    "speaker": "めぐる",
    "text": "わたし、すっごくはしゃいでたでしょ？",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300511/2003005110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……いつもとそんなに変わらないかも……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003005110160,
    "speaker": "めぐる",
    "text": "わ、わたしっていつもそんなっ！？",
