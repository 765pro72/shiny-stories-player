    "text": "プロデューサー",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010120"
  },
  {
    "id": 1002003010130,
    "speaker": "灯織",
    "text": "私、『G.R.A.D.』に出たいです",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織も、『今はなんでもやりたい』？",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002003010140,
    "speaker": "灯織",
    "text": "はい",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010140"
  },
  {
    "id": 1002003010150,
    "speaker": "灯織",
    "text": "真乃とめぐるが頑張っているのに、\r\n私が頑張らなかったら、ふたりに合わせる顔がありません",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010150"
  },
  {
    "id": 1002003010160,
    "speaker": "灯織",
    "text": "それに……\r\nこれはプロデューサーが持ってきてくださった仕事です",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010160"
  },
  {
    "id": 1002003010170,
    "speaker": "灯織",
    "text": "私のために持ってきてくださった仕事を──",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010170"
  },
  {
    "id": 1002003010180,
    "speaker": "灯織",
    "text": "やらない理由も、ありません",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、わかった\r\nエントリーしておくな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ただ、体は資本だからな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "体調には気を遣いすぎるくらい、気を付けること！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002003010190,
    "speaker": "灯織",
    "text": "……はい！\r\nありがとうございます、プロデューサー",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200301/1002003010190"
  },
  {
    "id": 1002003010200,
    "speaker": "灯織",
    "text": "自己管理をしっかりしつつ、\r\n勝ち抜けるように頑張りますね",
    "charAnim1": "surp1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
