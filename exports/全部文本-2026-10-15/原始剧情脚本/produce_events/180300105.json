  {
    "id": 1803001050160,
    "speaker": "MEMちょ",
    "text": "最初に見たのがアイドルの私で",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300105/1803001050160"
  },
  {
    "id": 1803001050170,
    "speaker": "MEMちょ",
    "text": "その私を見て好きになったって言ってもらえるの、\r\n嬉しくて──！",
