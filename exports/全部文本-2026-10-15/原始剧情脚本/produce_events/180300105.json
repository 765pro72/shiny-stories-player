    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300105/1803001050170"
  },
  {
    "id": 1803001050180,
