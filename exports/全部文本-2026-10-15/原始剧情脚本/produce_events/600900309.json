  },
  {
    "id": 6009003090050,
    "speaker": "果穂",
    "text": "あたし、もしかしたら勝てるかもって思ったんです……！\r\n『もしかしたら』って思っちゃったから…………",
    "charAnim1": "think",
    "charAnim2": "face_sad",
