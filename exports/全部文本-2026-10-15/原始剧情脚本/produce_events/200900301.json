  },
  {
    "stillType": "idols",
    "stillId": "1030090010"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "マメ丸は、あたしの家で飼ってる柴犬なんです",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900301/2009003010120"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "本っ当にかわいいんですよっ\r\n元気いっぱいで、人懐っこくて……",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900301/2009003010130"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "マメ丸とは、小さいころからずっと一緒なんです！",
    "charAnim1": "wait4",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900301/2009003010140"
  },
  {
    "effectLabel": "white2",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "ffffff"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 1000,
      "easing": "easeOutQuart"
    }
  },
  {
    "waitType": "time",
