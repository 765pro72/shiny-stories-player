    }
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "えへへ。なんだか、とっても集中できました！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900301/2009003010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、よく頑張ったな。おかげで撮影も早めに\r\n切り上げられたし……一旦、事務所に戻ろうか",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "はいっ！",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900301/2009003010020"
  },
  {
    "speaker": "off",
    "charLabel": "kaho",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "x": 200,
      "alpha": 0,
