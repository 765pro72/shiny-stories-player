    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2007014010340,
    "speaker": "結華",
    "text": "『もしもーし？　お疲れお疲れ、今大丈夫？\r\n……うん、ふふ。ありがと！』",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010340"
  },
  {
    "id": 2007014010350,
    "speaker": "結華",
    "text": "『特に用事はないんだけどさぁ……\r\n声が聞きたくなっちゃった的な？』",
    "charAnim1": "wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010350"
  },
  {
    "id": 2007014010360,
    "speaker": "結華",
    "text": "『えへへ、珍しいでしょ。知ってる\r\nたまにはこういう三峰も出てくるわけですよ』",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010360"
  },
  {
    "id": 2007014010370,
    "speaker": "結華",
    "text": "『まぁ、当然誰にでもってわけじゃないけど\r\n──それは知ってくれてるでしょ？』",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010370"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2007014010380,
    "speaker": "結華",
    "text": "『……うん。元気出た。そっちも何かあったら──\r\nや、何もなくても。遠慮なく甘えてくれていいからね』",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010380"
  },
  {
    "id": 2007014010390,
    "speaker": "結華",
    "text": "『じゃ、明日も頑張ります！\r\nそっちもファイトだよ！　ばいばーい！』",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010390"
  },
  {
    "charAnim1": "wait",
    "charLabel": "yuika",
    "textFrame": "off",
