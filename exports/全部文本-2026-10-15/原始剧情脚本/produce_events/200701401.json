  {
    "speaker": "企画書",
    "text": "『販促キャンペーン制作物：電話風メッセージ動画』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "企画書",
    "text": "『疲労回復アイテムであるホットアイマスクにちなみ、\r\n日々の疲れを癒すような内容』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "企画書",
    "text": "『ファンの満足度を高めるため、\r\n恋人からの電話のような雰囲気にて』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\n最初は、『こんばんは、お仕事お疲れ様』とか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010080,
    "speaker": "結華",
    "text": "え？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
