    "waitTime": 2500
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "メッセージ聞くだけで満足しそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010290,
    "speaker": "結華",
    "text": "それは裏側を知ってるＰたん限定の感想です～",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、確かに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010300,
    "speaker": "結華",
    "text": "三峰は恋人、三峰は恋人……\r\n恋人を癒す、恋人を癒す……",
    "charAnim1": "sad1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010300"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいの浮かびそうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010310,
    "speaker": "結華",
    "text": "……なんかこの流れだと\r\n三峰の思う対恋人モードを晒すみたいでちょっとやだね",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010310"
  },
  {
    "id": 2007014010320,
    "speaker": "結華",
    "text": "聞いてくれた人もそう思うんだろうなぁ……",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_shy_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010320"
  },
  {
    "speaker": "プロデューサー",
    "text": "……\r\nそういう恥ずかしさもあるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010330,
    "speaker": "結華",
    "text": "あくまで作りものですから\r\nＰたんはそこんとこ、肝に銘じて確認するように",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010330"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
