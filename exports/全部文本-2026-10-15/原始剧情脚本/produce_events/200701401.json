      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200701401/2007014010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "メッセージの内容……のつもりなんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010090,
    "speaker": "結華",
    "text": "ああ！\r\nふふっ、ぶぶー",
    "charAnim1": "think",
    "charAnim2": "face_bad",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "──って、そりゃそうか\r\nこれくらいは言われなくても思いついてるよな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010100,
    "speaker": "結華",
    "text": "ぶぶー",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010100",
    "autoWaitTime": 1100
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010110,
    "speaker": "結華",
    "text": "三峰は内容にダメ出しをしています",
    "charAnim1": "wait3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010110"
  },
  {
    "id": 2007014010120,
    "speaker": "結華",
    "text": "『こんばんは』\r\nお客さんが夜以外に聞いたらどうする？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2007014010130,
    "speaker": "結華",
    "text": "『お仕事お疲れ様』\r\nバイトがあるかもだけど、弾かれちゃう学生さんもいるよね",
    "charAnim1": "sad1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010130"
  },
  {
    "id": 2007014010140,
    "speaker": "結華",
    "text": "かと言って～？　シチュエーションを限定する文言を\r\n避けまくると、非常に薄味な仕上がりになる",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010140"
  },
  {
    "id": 2007014010150,
    "speaker": "結華",
    "text": "塩梅が難しいわけですよ……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なるほど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010160,
    "speaker": "結華",
    "text": "もともとはこういうの、聞く側だったじゃん？\r\nどれだけ元気もらえるかわかってるから、手は抜けないよね",
    "charAnim1": "wait2",
    "charAnim2": "face_close6",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile_s",
    "charLabel": "yuika",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "そういう経験が\r\nあるからこそ",
    "nextLabel": "1"
  },
  {
    "select": "……それだけ\r\n考えてくれてたら",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "どういうのが\r\n嬉しかった？",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "結華のメッセージは、みんなに刺さりそうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010170,
    "speaker": "結華",
    "text": "はいプレッシャー",
    "charAnim1": "shy2",
    "charAnim2": "face_close6",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010170"
  },
  {
    "id": 2007014010180,
    "speaker": "結華",
    "text": "言われて嬉しいことは……まぁ、想像しやすいかもだけど\r\n実際それだけじゃないじゃん？",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010180"
  },
  {
    "id": 2007014010190,
    "speaker": "結華",
    "text": "正直こっちサイドに来るまで知らなかったよね\r\nなんていうかこう……企業側への配慮というか",
    "charAnim1": "sad2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010190"
  },
  {
    "id": 2007014010200,
    "speaker": "結華",
    "text": "今回は別に言われてないけど……\r\n商品推した方がいいのかな？　みたいな葛藤",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200701401/2007014010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……まぁ、そこも塩梅は難しいよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それこそ一番冷めるところだろうし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007014010210,
    "speaker": "結華",
    "text": "それー",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
