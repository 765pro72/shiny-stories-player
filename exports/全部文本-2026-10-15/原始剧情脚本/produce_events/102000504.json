    "waitTime": 1500
  },
  {
    "id": 1020005040010,
    "speaker": "透",
    "text": "あ……私\r\n昨日、バス停で",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040010"
  },
  {
    "textFrame": "off",
    "bg": "00087",
    "fg": "003981",
    "bgEffect": "fade",
    "fgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000,
    "fgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "『ああ、あの時の！\r\nえ、もしかして、アイドルになる気に──』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1020005040020,
    "speaker": "透",
    "text": "や、話したくて\r\nよくわかんなかったから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "『あ、そうだよな……うん\r\nわからないことがあれば、なんでも聞いてくれ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1020005040030,
    "speaker": "透",
    "text": "うん\r\nあのさ──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040030"
  },
  {
    "id": 1020005040040,
    "speaker": "透",
    "text": "プロデューサーって、何？\r\n何する人？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040040"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "fg": "fade_out",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000,
    "fgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "fg": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "簡単に言っちゃうと、アイドルをプロデュースする人\r\nってことなんだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "たとえば、その子をどういう方向で売り出そうかとか\r\nこの企画なら楽しんでやってくれるんじゃないかとか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうのを考えたり、テレビ局や制作会社への\r\n挨拶回りとか、営業もするし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00224",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "あとは、ダンスやボーカルレッスンの予定を立てたり\r\n仕事の立ち合いをしたり",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "現場への送迎も\r\nできる限り俺がやってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1020005040050,
    "speaker": "透",
    "text": "『へぇ、忙しいね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そう見えるかもしれないけど\r\nやりたくてやってるんだ、俺が",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなが望む空に羽ばたけるなら\r\nそのためにできること、何だってしたいって思ってるから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00446",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 1020005040060,
    "speaker": "透",
    "text": "望む、空……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040060"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1020005040070,
    "speaker": "透",
    "text": "そっか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ああ\r\nすごくやりがいのある仕事だよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "って、なんだか俺のことばっかり喋っちゃったな\r\n他に質問があれば何でも──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1020005040080,
    "speaker": "透",
    "text": "『大丈夫\r\nわかったから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000504/1020005040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、ならよかった",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "textCtrl": "cm",
    "select": "返事は急がないよ\r\nゆっくり考えてくれ",
    "nextLabel": "1"
  },
  {
