    "textFrame": "001",
    "voice": "produce_events/201501104/2015011040030"
  },
  {
    "speaker": "プロデューサー",
    "text": "色んなお店があるからな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011040040,
    "speaker": "甜花",
    "text": "な、なるほど……！",
