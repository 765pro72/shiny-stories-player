    "textFrame": "001",
    "voice": "produce_events/201501104/2015011040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011040080,
    "speaker": "甜花",
    "text": "あ、その……！\r\nご飯、やなんじゃなくて、その……",
