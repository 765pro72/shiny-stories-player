  {
    "id": null,
    "speaker": "プロデューサー",
    "text": "──……やっぱり、この時間は人が多いな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015011040030,
    "speaker": "甜花",
    "text": "みんな……どこ、行くんだろ……\r\nいっぱい……",
