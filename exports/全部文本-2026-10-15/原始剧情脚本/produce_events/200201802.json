  {
    "speaker": "大学生１",
    "text": "あっ、このイメージモデルの子\r\n最近よく見るよね～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "大学生２",
    "text": "ああ、アイドルの子だよね",
    "textCtrl": "p",
