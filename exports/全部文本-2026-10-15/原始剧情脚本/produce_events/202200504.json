    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040310"
  },
  {
    "id": 2022005040320,
    "speaker": "小糸",
    "text": "わたし、今もずっと\r\n気が付かなかったかもしれません",
