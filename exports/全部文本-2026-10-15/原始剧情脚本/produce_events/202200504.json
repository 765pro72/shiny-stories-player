    "waitTime": 1200
  },
  {
    "id": 2022005040100,
    "speaker": "小糸",
    "text": "……む、昔子役で出てたドラマとかも\r\n観たりしたんですけど",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
