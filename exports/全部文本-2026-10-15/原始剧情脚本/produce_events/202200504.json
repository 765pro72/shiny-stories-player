  {
    "speaker": "プロデューサー",
    "text": "これだろ？\r\n多分順番通りに並んでると思うけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005040060,
    "speaker": "小糸",
    "text": "あ、ありがとうございます……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
