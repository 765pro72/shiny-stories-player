    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040330"
  },
  {
    "id": 2022005040340,
    "speaker": "小糸",
    "text": "……ありがとうございます、プロデューサーさん",
