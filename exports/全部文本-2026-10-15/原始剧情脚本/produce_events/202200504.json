      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202200504/2022005040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、結構重たいから\r\nしまう時また声掛けてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……だけど、\r\n小糸いつもこの雑誌読んでたか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005040070,
    "speaker": "小糸",
    "text": "あ……\r\nい、いえあの……",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040070"
  },
  {
    "id": 2022005040080,
    "speaker": "小糸",
    "text": "この間、着物で……一緒に撮影した子\r\n調べたらこの雑誌に出てるって",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうか\r\nこの雑誌だったか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005040090,
    "speaker": "小糸",
    "text": "そ、そうなんです\r\n……み、見てみたくて",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\n俺も少し、見てみようかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charLabel": "koito",
