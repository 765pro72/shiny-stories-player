    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか\r\nよく、考えてくれたんだな",
    "charAnim2": "face_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022005040150,
    "speaker": "小糸",
    "text": "は、はい……\r\nそれで、あの子は……どうなんだろうって",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040150"
  },
  {
    "id": 2022005040160,
    "speaker": "小糸",
    "text": "………………",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_serious_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200504/2022005040160"
  },
  {
    "id": 2022005040170,
    "speaker": "小糸",
    "text": "わ、わたしがそんなの知って\r\nどうするんだって感じなんですけど……！",
