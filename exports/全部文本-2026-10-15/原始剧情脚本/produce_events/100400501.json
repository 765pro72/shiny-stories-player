    "textFrame": "001",
    "voice": "produce_events/100400501/1004005010110"
  },
  {
    "speaker": "恋鐘の父",
    "text": "いっちょ前に照れとらんで、向こうで宿題でもせんね！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1004005010120,
    "speaker": "幼い恋鐘",
    "text": "宿題は後でやるけん大丈夫！\r\nお母ちゃんの皿洗いも手伝わんといかんし～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400501/1004005010120"
  },
  {
    "id": 1004005010130,
    "speaker": "幼い恋鐘",
    "text": "あ、ご飯と味噌汁ば持ってくるばい～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400501/1004005010130"
