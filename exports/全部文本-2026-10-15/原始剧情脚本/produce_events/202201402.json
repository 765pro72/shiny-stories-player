  },
  {
    "id": 2022014020040,
    "speaker": "小糸",
    "text": "（お友達と旅行の人に、お仕事の人、\r\nあっちの人は帰省とか……？）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201402/2022014020040"
  },
  {
    "id": 2022014020050,
    "speaker": "小糸",
    "text": "（あ、高校生くらいの子もいる……）",
