  {
    "speaker": "プロデューサー",
    "text": "──だから、湿度が100パーセントになっても\r\n事務所が水の中になるわけじゃないんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010220,
    "speaker": "果穂",
    "text": "なるほど……！\r\nそうだったんですねっ！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当はもう少し大きくなってから勉強することだけど\r\n果穂は一足先に学んじゃったな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010230,
    "speaker": "果穂",
    "text": "はい！　プロデューサーさんのおかげで\r\nあたし、またひとつ成長できました！",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010230"
  },
  {
    "id": 2009006010240,
    "speaker": "果穂",
    "text": "プロデューサーさんはやっぱりスゴいです！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
