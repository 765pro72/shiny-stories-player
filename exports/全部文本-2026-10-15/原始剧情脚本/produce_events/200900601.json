  },
  {
    "textFrame": "off"
  },
  {
    "id": 2009006010250,
    "label": "3",
    "speaker": "果穂",
    "text": "事務所がプールに……！\r\nスゴいですっ！",
    "charAnim1": "sad2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010250"
  },
  {
    "id": 2009006010260,
    "speaker": "果穂",
    "text": "水着を持ってこなくちゃですね！！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010260"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\n……だけど、不思議なことがないか？",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010270,
    "speaker": "果穂",
    "text": "不思議なこと……？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010270"
  },
  {
    "id": 2009006010280,
    "speaker": "果穂",
    "text": "……あっ！\r\n今も60パーセントなのに、水がどこにもありません！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010280"
  },
  {
    "speaker": "プロデューサー",
    "text": "その謎の答えは……\r\n図書館にあるかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010290,
    "speaker": "果穂",
    "text": "！\r\n図書館にはいっぱい本がありますもんね！",
    "charAnim1": "think",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことだ\r\n……さて、今日の仕事はこれで終わりだ",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、果穂の疑問の答えを探しに、\r\n一緒に図書館探検に行かないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010300,
    "speaker": "果穂",
    "text": "わぁっ……！\r\nいいんですか！？",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900601/2009006010300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006010310,
    "speaker": "果穂",
    "text": "わーいっ！\r\nプロデューサーさんと一緒に図書館探検、楽しみですっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
