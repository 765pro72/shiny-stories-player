    "textFrame": "001",
    "voice": "produce_events/102200002/1022001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "福丸さん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001010050,
    "speaker": "小糸",
    "text": "…………み、みんなと……\r\n一緒に………………",
    "charAnim1": "sad2",
