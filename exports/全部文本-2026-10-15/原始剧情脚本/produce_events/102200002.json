    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200002/1022001010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、その中で君自身は\r\nどんなアイドルになりたい？",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
  {
    "id": 1022001010090,
    "speaker": "小糸",
