    "charAnim4": "blank",
    "charLipAnim": "lip_surp2",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200002/1022001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうか\r\n君の幼馴染も２８３プロに所属してくれたんだったね",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "幼馴染同士、仲がいいなあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001010060,
    "speaker": "小糸",
    "text": "…………！",
    "charAnim1": "surp3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200002/1022001010060"
  },
  {
    "id": 1022001010070,
    "speaker": "小糸",
    "text": "わ、わかりますか……？\r\nそうなんです……！　すごく仲良しなんです……！",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200002/1022001010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、うん、わかるよ\r\nみんな一緒に活動していけたらいいユニットになりそうだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022001010080,
    "speaker": "小糸",
    "text": "えへへ……そうなんです……！",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
