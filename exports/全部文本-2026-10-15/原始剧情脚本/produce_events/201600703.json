    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600703/2016007030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……その場合、千雪は何になるんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007030060,
    "speaker": "千雪",
    "text": "ああっ、私は……\r\nええと…………？",
