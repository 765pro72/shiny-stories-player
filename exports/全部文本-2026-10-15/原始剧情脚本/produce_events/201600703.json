    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600703/2016007030040"
  },
  {
    "id": 2016007030050,
    "speaker": "千雪",
    "text": "湖に咲く花の精になった、\r\n甘奈ちゃんと甜花ちゃん……",
