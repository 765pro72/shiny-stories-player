    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600703/2016007030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……けどさ、\r\nそういうのはどんどん伝えていった方がいいよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "監督さん、\r\nみんなでイメージを作っていきたいって言ってただろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016007030070,
