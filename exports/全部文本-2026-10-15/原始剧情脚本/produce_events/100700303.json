  {
    "id": 1007003030010,
    "speaker": "結華",
    "text": "……大学まで迎えに来てくれてどうも",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
