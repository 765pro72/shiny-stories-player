    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々らしいけど、新しい\r\nそんな感じがするよ",
    "charAnim2": "face_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003090030,
