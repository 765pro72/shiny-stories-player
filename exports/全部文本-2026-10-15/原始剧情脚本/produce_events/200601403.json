  },
  {
    "speaker": "プロデューサー",
    "text": "で、奥の手洗い場の水道がひとつ壊れたらしくて──\r\n向かって右端のがダメだそうだから気を付けてな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030020,
    "speaker": "咲耶",
    "text": "ああ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "あと言っておかなきゃなことは────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030030,
    "speaker": "咲耶",
    "text": "……？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、差し入れ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっちのテントに軽食を用意してくださってるそうだから\r\nお腹が空いてるようだったら覗いてみてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "咲耶から何かあるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030040,
    "speaker": "咲耶",
    "text": "そうだね……では",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030040"
  },
  {
