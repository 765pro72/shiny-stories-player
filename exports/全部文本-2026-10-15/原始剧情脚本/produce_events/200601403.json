      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 2006014030050,
    "speaker": "咲耶",
    "text": "──失礼",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030050"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "……！？\r\n俺の手がどうかしたか……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030060,
    "speaker": "咲耶",
    "text": "すまない、汚れがついているように見えたのだけれど──",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601403/2006014030060"
  },
  {
    "id": 2006014030070,
    "speaker": "咲耶",
    "text": "────『15時以降　電話』",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\nははは……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030080,
    "speaker": "咲耶",
    "text": "おやおや、フフ\r\nこのメモだったんだね",
    "charAnim1": "anger2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030080"
  },
  {
    "id": 2006014030090,
    "speaker": "咲耶",
    "text": "見間違えてしまったようだ\r\n申し訳ない",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや……全然……！\r\nありがとう、気にかけてくれて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……で、ちょっと恥ずかしいな……！\r\nこういうのバレちゃうと……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030100,
    "speaker": "咲耶",
    "text": "フフッ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030100"
  },
  {
    "id": 2006014030110,
    "speaker": "咲耶",
    "text": "懐かしいな\r\n私もこうして手にメモをしていたことがあるよ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほんとか？\r\nよかった──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030120,
    "speaker": "咲耶",
    "text": "ああ\r\n小学生の頃だったかな",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……フォローかと思ったら攻撃だった……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030130,
    "speaker": "咲耶",
    "text": "フフフッ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030130"
  },
  {
    "id": 2006014030140,
    "speaker": "咲耶",
    "text": "そんなに大事な用事なのかい？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、うん。咲耶の──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030150,
    "speaker": "咲耶",
    "text": "……",
    "charAnim1": "shy2",
    "charAnim2": "face_shy3",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030150"
  },
  {
    "speaker": "プロデューサー",
    "text": "来週の金曜か再来週の月曜\r\nどっちかに仕事が入るって話、してただろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "その連絡が15時までに来るってことだったから\r\n来てなかったらつつかなきゃと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030160,
    "speaker": "咲耶",
    "text": "──それは",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "早く予定がわかった方がいいかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "スケジュールが空くようだったら、金土日で\r\nおじいちゃんおばあちゃんの家に泊まりたいんだもんな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030170,
    "speaker": "咲耶",
    "text": "……ああ、やっぱり私のためか──\r\nからかっておいてこれでは、なんとも……",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、ちょっとしたお返しだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺の、忘れるわけにはいかない大事な用事！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030180,
    "speaker": "咲耶",
    "text": "からかってすまない\r\nありがとう、プロデューサー",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030180"
  },
  {
    "speaker": "プロデューサー",
    "text": "あっ、いや！",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "とんでもない！",
    "nextLabel": "1"
  },
  {
    "select": "そこまで\r\nじゃない……！",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "こ、こちらこそ……",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "社会人としてこんなとこにメモするのはどうなんだってのは\r\n大前提だし……！　人と会う職業でもあるし……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030190,
    "speaker": "咲耶",
    "text": "……",
    "charAnim1": "anger2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601403/2006014030190"
  },
  {
    "speaker": "プロデューサー",
    "text": "今後は気を付ける",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あと、俺こそ意地悪しちゃってごめんな、咲耶",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006014030200,
    "speaker": "咲耶",
    "text": "それこそ、とんでもない",
