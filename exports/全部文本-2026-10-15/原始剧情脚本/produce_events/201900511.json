    "textFrame": "002"
  },
  {
    "id": 2019005110020,
    "speaker": "愛依",
    "text": "ほーら！　あそこの本屋だって！",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900511/2019005110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "お……あの雑誌\r\nこの間の海の写真が載ってるやつだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019005110030,
    "speaker": "愛依",
    "text": "ちょい買ってきていい？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900511/2019005110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろんだ\r\nちょうどいいし、俺も自分用に買っていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019005110040,
    "speaker": "愛依",
    "text": "サンキュ！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900511/2019005110040"
  },
  {
