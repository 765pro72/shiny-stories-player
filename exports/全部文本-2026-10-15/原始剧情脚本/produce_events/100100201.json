  },
  {
    "id": 1001002010130,
    "speaker": "真乃",
    "text": "ちょっとでも……アイドルの私を信じてくれた気持ちに、\r\n応えられたのかなって思えるから……",
    "textCtrl": "p",
    "textFrame": "001",
