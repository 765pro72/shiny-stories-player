  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "おー、けっこう上がってきたなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "あっちにも山が……\r\nこう見ると、やっぱり緑が多いな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2018015040010,
    "speaker": "冬優子",
    "text": "……で？\r\nどうしたのよ、急に",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、うん……\r\nせっかく来たんだし、観覧車くらいと思ってさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……もしかしたら冬優子も\r\nちょっとは気になってたんじゃないかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040020,
    "speaker": "冬優子",
    "text": "はあ……？\r\nあんた……誰かと勘違いしてんじゃないの",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは……まぁ、撤収まで時間あるし\r\nスタッフさんも好きにしてていいって言ってくれたから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040030,
    "speaker": "冬優子",
    "text": "…………ま、いいけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040030"
  },
  {
    "textFrame": "off",
    "bg": "00075",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "……人気、出るといいな\r\n冬優子も頑張ってくれたし、きっと────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040040,
    "speaker": "冬優子",
    "text": "…………\r\nそんな簡単な話じゃないわよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040040"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……手応えなかったのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040050,
    "speaker": "冬優子",
    "text": "その逆……やれることはやったわよ\r\n……やれること全部",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040050"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2018015040060,
    "speaker": "冬優子",
    "text": "けど…………だから……────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040060"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgm": "0000",
    "se": "2184",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "id": 2018015040061,
    "speaker": "冬優子",
    "text": "────！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040061"
  },
  {
    "textFrame": "off",
    "bg": "00508",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 300
  },
  {
    "speaker": "プロデューサー",
    "text": "ゴンドラ…………止まった……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0657",
    "waitType": "time",
    "waitTime": 2600
  },
  {
    "speaker": "車内スピーカー",
    "text": "『……ご心配……て……ません\r\n復旧…………らく…………さい……』",
    "textCtrl": "p",
    "textFrame": "003",
    "se": "1706"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "あー、ちょっとかかりそうだな\r\n……すまん、冬優子",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040070,
    "speaker": "冬優子",
    "text": "……いいって\r\n古い設備なら、こういうこともあるでしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201801504/2018015040070"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2018015040080,
    "speaker": "冬優子",
    "text": "いつかは止まるんだから…………\r\n流れには勝てないのよ……なんだって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 1000
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
    "bgm": "062",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 300
  },
  {
    "id": 2018015040090,
    "speaker": "冬優子",
    "text": "……今が今じゃなくなって\r\n好きだって言ってくれてた人がいなくなって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040090"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018015040100,
    "speaker": "冬優子",
    "text": "こうやって思い出してくれる人が\r\nたまに来てくれるだけのものになって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040100"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 2018015040110,
    "speaker": "冬優子",
    "text": "……飾っておくわけにもいかないしね\r\n絵画とか────映画みたいに",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018015040120,
    "speaker": "冬優子",
    "text": "……そういう場所に今いるってこと\r\nいくら園長さんが頑張ったって、いつかは────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040120"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 4500
  },
  {
    "textFrame": "off",
    "bg": "00508",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "id": 2018015040130,
    "speaker": "冬優子",
    "text": "────……なーんて……ふふっ\r\n……ごめん、ちょっと疲れたのかも…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "……そんなに頼りないものなんだろうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018015040140,
    "speaker": "冬優子",
    "text": "……は？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、いや……\r\nそこまで悲観する必要あるのかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040150,
    "speaker": "冬優子",
    "text": "……あんたがそうでも\r\n新しい遊園地ができたら、みんなそっちに行くでしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040150"
  },
  {
    "id": 2018015040160,
    "speaker": "冬優子",
    "text": "今じゃないものに、それほど価値なんてないのよ\r\nお客さんにとっては……あんなに楽しんでくれたくせにね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040160"
  },
  {
    "id": 2018015040170,
    "speaker": "冬優子",
    "text": "あの時楽しかったって言ってもらっても\r\nそれはもう、今じゃないんだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040170"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうだな、そういう人はたくさん────\r\nいや……そういう人がほとんどなんだろうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040180,
    "speaker": "冬優子",
    "text": "……変わらないものなんてないんだから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040180"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018015040190,
    "speaker": "冬優子",
    "text": "…………そうして誰もいなくなって────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "それでも、ひとりだけいるかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2018015040200,
    "speaker": "冬優子",
    "text": "…………え？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "偶然、この観覧車の整備士さんに話しかけられてさ\r\n開業以来、ずっとメンテナンスをされてる方なんだが……",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "103"
  },
  {
    "speaker": "プロデューサー",
    "text": "最初の客には、最期の客である権利と義務があるんだって\r\n俺の顔にご飯粒を飛ばしながら、熱く語ってたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2018015040210,
    "speaker": "冬優子",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "たとえ閉園しても整備を辞める気はさらさらないって\r\n……観覧車が回ることをやめようとしないかぎり",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "その人にとっては、きっと永遠みたいなものよりも\r\n長い長い今を生きてるのかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2018015040220,
    "speaker": "冬優子",
    "text": "……………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040220"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 2018015040230,
    "speaker": "冬優子",
    "text": "────何それ\r\n急に言い出したかと思えば…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040230"
  },
  {
    "id": 2018015040240,
    "speaker": "冬優子",
    "text": "結局、閉園自体はしちゃってるじゃない\r\n……答えになってないと思うけど？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801504/2018015040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……そうだな\r\n言葉で冬優子を説得するのは、俺には難しいかもしれない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、いい関係だなって思ったんだ\r\nコインの表と裏みたいなさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
