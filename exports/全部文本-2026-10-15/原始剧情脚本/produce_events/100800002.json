    "textFrame": "002"
  },
  {
    "id": 1901001010180,
    "speaker": "はづき",
    "text": "ふふ、はい。しばらく応接室で作業してもらってますから、\r\n会いに行ってあげてくださいね",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
