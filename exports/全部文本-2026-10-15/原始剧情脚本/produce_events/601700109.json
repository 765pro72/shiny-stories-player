    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "あさひ！　ここにいたのか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090020,
    "speaker": "あさひ",
    "text": "！　……プロデューサーさん\r\nお疲れさまっす！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "017",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/601700109/6017001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あさひ、探したぞ\r\nどうしてこんなところに？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090030,
    "speaker": "あさひ",
    "text": "なんかわかるんじゃないかって思ったんすよ\r\nここに来たら",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090030"
  },
  {
    "speaker": "プロデューサー",
    "text": "わかる……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090040,
    "speaker": "あさひ",
    "text": "はいっす、アイドルがどうして特別なのか～とか\r\n今楽しいのってなんでなのか～とか……",
    "charAnim1": "think1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090040"
  },
  {
    "id": 6017001090050,
    "speaker": "あさひ",
    "text": "その理由がっす",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090050"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……その理由は見つかったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090060,
    "speaker": "あさひ",
    "text": "あはは、見つからなかったっす！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか\r\nそれは残念──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090070,
    "speaker": "あさひ",
    "text": "──さっきまでは……すけどね",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090070"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090080,
    "speaker": "あさひ",
    "text": "今わかったっす\r\n……プロデューサーさんの顔を見たら",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090080"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺の？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090090,
    "speaker": "あさひ",
    "text": "そっす　\r\n……今までわたし、色んな楽しいこと、探してたっす",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090090"
  },
  {
    "id": 6017001090100,
    "speaker": "あさひ",
    "text": "でも、ひとりぼっちで",
    "charAnim1": "sad1",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090100"
  },
  {
    "id": 6017001090110,
    "speaker": "あさひ",
    "text": "……",
    "charLipAnim": "lip_sad_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090110"
  },
  {
    "id": 6017001090120,
    "speaker": "あさひ",
    "text": "けど、アイドルは違うっす！\r\n……プロデューサーさんが、いつも側にいるっす",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090120"
  },
  {
    "id": 6017001090130,
    "speaker": "あさひ",
    "text": "それって、すっごく楽しいっす",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……なら安心してくれ\r\n俺はいつまでもあさひと一緒にいるからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090140,
    "speaker": "あさひ",
    "text": "ありがとっす！",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "asahi",
    "textCtrl": "r",
    "voiceKeep": true,
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090140"
  },
  {
    "text": "……でも、それだけなのかな",
    "charAnim1": "think1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090150,
    "speaker": "あさひ",
    "text": "……きっと、もっと、特別な何かが……",
    "charAnim1": "wait3",
    "charLipAnim": "lip_surp",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090150"
  },
  {
    "id": 6017001090160,
    "speaker": "あさひ",
    "text": "……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad_s",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090160"
  },
  {
    "id": 6017001090170,
    "speaker": "あさひ",
    "text": "……うん、今はわかんないっす！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601700109/6017001090170"
  },
  {
    "speaker": "プロデューサー",
    "text": "あさひはまだアイドルとして羽ばたき始めたばかりなんだ\r\nそれをこれから、一緒に探してこうじゃないか",
    "charAnim2": "blank",
    "charLabel": "asahi",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6017001090180,
