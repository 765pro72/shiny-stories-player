    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500703/2025007030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……美琴は？",
