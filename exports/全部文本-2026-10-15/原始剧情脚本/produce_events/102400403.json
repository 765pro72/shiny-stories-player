  {
    "speaker": "子ども１",
    "text": "シーズのことも、にちかちゃんのことも、\r\nこれからも応援してます……！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1024004030270,
    "speaker": "にちか",
    "text": "はは、ありがとうございます……！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "nichika",
