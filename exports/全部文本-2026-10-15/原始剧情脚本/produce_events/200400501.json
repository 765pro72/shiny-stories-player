    "textFrame": "001",
    "voice": "produce_events/200400501/2004005010130"
  },
  {
    "id": 2004005010140,
    "speaker": "恋鐘",
    "text": "なんか、そうやってプロデューサーがカメラ覗いとると……\r\nやっぱり……恥ずかしか……！",
