    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400501/2004005010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "よかった\r\nよーし、じゃあまず１枚──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004005010120,
    "speaker": "恋鐘",
    "text": "ちょ、ちょっと待って……！",
