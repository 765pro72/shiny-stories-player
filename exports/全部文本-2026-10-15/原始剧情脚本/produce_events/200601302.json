    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2006013020210,
    "speaker": "咲耶",
    "text": "──帰りの駅の人気の駅弁は\r\nこのランキングらしいよ？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200601302/2006013020210"
  },
  {
    "charAnim1": "wink",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "nextLabel": "end",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2006013020220,
    "label": "3",
    "speaker": "咲耶",
    "text": "ああ\r\n私は腹の虫の機嫌を優先してしまってね",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601302/2006013020220"
  },
  {
    "id": 2006013020230,
    "speaker": "咲耶",
    "text": "通年いただける、がっつりめの海鮮弁当が\r\nお昼のお供さ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601302/2006013020230"
  },
  {
    "id": 2006013020240,
    "speaker": "咲耶",
    "text": "ウニ、イクラ、エビの並びには抗えなかった──",
    "charAnim1": "think",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601302/2006013020240"
  },
  {
    "speaker": "プロデューサー",
    "text": "そっちも美味しそうだよな！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013020250,
    "speaker": "咲耶",
    "text": "よければ最初の一口をどうだい？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601302/2006013020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "ええっ\r\nそれは悪いだろ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006013020260,
    "speaker": "咲耶",
    "text": "もちろん、アナタのお弁当から\r\n秋をおすそわけしてほしい、というのが交換条件さ",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
