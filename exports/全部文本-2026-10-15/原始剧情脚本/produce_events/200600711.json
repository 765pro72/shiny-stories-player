    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600711/2006007110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん、どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006007110040,
    "speaker": "咲耶",
    "text": "大丈夫、すぐに終わるよ",
