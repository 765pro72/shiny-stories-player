  {
    "id": 2018017010010,
    "speaker": "冬優子",
    "text": "ふゆが、ですか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801701/2018017010010"
  },
  {
    "speaker": "雑誌編集者",
    "text": "以前、お聞きしたことがあるんですが\r\n黛さんって、服飾デザインを学ばれてましたよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018017010020,
    "speaker": "冬優子",
    "text": "あ、はい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201801701/2018017010020"
  },
  {
    "textFrame": "off",
    "bg": "00011",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "speaker": "雑誌編集者",
    "text": "ご興味あれば、ぜひ黛さんご自身に\r\n水着のデザインをお願いしたいなって思ったんです",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2018017010021,
    "speaker": "冬優子＆プロデューサー",
    "text": "……………",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "fuyuko",
