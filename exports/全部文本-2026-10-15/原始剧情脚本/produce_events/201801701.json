      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201801701/2018017010021"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
