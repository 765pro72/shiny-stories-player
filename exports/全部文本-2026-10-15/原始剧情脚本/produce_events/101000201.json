  },
  {
    "speaker": "プロデューサー",
    "text": "お疲れ様",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010002010040,
    "speaker": "智代子",
    "text": "お疲れ様ですっ、プロデューサーさん！",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010040"
  },
  {
    "id": 1010002010050,
    "speaker": "智代子",
    "text": "はぁ……！　ほんとに、こんなに幸せなお仕事が\r\nあっていいんでしょうか……！",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010050"
  },
  {
    "id": 1010002010060,
    "speaker": "智代子",
    "text": "さっきのスイーツも、今まで食べた中で\r\n一番なんじゃってくらい美味しくて……！",
    "charAnim1": "touch",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それはよかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "智代子のそういう顔が見たいからこそ、\r\nオファーをもらえているんだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、幸せだって堂々と仕事にしていいんだ\r\n自信を持ってやらないとな",
    "charAnim1": "wait2",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010002010070,
    "speaker": "智代子",
    "text": "──\r\nそっか、えへへ……！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010070"
  },
  {
    "id": 1010002010080,
    "speaker": "智代子",
    "text": "そういうことならもちろん、はいっ！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010080"
  },
  {
    "id": 1010002010090,
    "speaker": "智代子",
    "text": "──でも、やっぱり、\r\nプロデューサーさんのおかげでもありますから",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010090"
  },
  {
    "id": 1010002010100,
    "speaker": "智代子",
    "text": "一緒にチョコアイドルの路線を\r\nしっかり作ってこれてよかったです……！",
