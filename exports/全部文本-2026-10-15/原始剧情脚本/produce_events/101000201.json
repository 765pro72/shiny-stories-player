    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010100"
  },
  {
    "id": 1010002010110,
    "speaker": "智代子",
    "text": "──とかまで言っちゃうのは、\r\nちょっと現金すぎますかね……？",
    "charAnim1": "think",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101000201/1010002010110"
  },
  {
