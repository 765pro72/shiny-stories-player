  {
    "speaker": "プロデューサー",
    "text": "……それ、記者の人に言われたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023012010240,
    "speaker": "雛菜",
    "text": "うん～\r\n雛菜、褒められたのかな～？",
