  },
  {
    "id": 1002004060030,
    "speaker": "灯織",
    "text": "時間ぴったりでしたね",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060030"
  },
  {
    "id": 1002004060040,
    "speaker": "灯織",
    "text": "席、座ってください",
