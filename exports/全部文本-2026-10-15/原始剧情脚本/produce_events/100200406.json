    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100200406/1002004060050"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………えっ？　俺の？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060060,
    "speaker": "灯織",
    "text": "そうですよ\r\nさっき『今から戻る』って連絡くれたじゃないですか",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060060"
  },
  {
    "id": 1002004060070,
    "speaker": "灯織",
    "text": "お昼がまだだ──って",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、したけど……\r\nそういうつもりじゃなかったのに",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060080,
    "speaker": "灯織",
    "text": "わかってますよ\r\nだからこれは、私がしたくてしたことです",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060080"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060090,
    "speaker": "灯織",
    "text": "プロデューサー、\r\nものすごく腑に落ちないって顔をしています",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060090"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060100,
    "speaker": "灯織",
    "text": "この前、コーヒーと料理の話をしましたよね",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060100"
  },
  {
    "speaker": "プロデューサー",
    "text": "唐突だな……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060110,
    "speaker": "灯織",
    "text": "ふふ\r\n関係するので、聞いてください",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060110"
  },
  {
    "id": 1002004060120,
    "speaker": "灯織",
    "text": "今気付いても遅いんですけど──",
    "charAnim1": "surp2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060120"
  },
  {
    "id": 1002004060130,
    "speaker": "灯織",
    "text": "わかったんです、私が好きなこと",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060130"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当か！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0327"
  },
  {
    "id": 1002004060140,
    "speaker": "灯織",
    "text": "……ものすごく勢いがありましたね",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そりゃあそうだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど、この前言ってた続きって\r\nこのことなんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060150,
    "speaker": "灯織",
    "text": "はい",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060150"
  },
  {
    "id": 1002004060160,
    "speaker": "灯織",
    "text": "…………",
    "charAnim2": "face_close",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060160"
  },
  {
    "id": 1002004060170,
    "speaker": "灯織",
    "text": "プロデューサーと同じものを頼んだ日がありましたよね\r\nクラブサンドと、ホットコーヒー",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060170"
  },
  {
    "id": 1002004060180,
    "speaker": "灯織",
    "text": "あの時、どうして一緒のものにしたのかなって思ったんです\r\n飲めるけど、コーヒーが好きなわけではないのに",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060180"
  },
  {
    "id": 1002004060190,
    "speaker": "灯織",
    "text": "ただ、コーヒーは……\r\n私にとっては、団らんのキーアイテムなんです",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060190"
  },
  {
    "id": 1002004060200,
    "speaker": "灯織",
    "text": "だから、つい困った時に頼んでしまうんですよね",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002004060210,
    "speaker": "灯織",
    "text": "料理も似たような感じなんですけど、\r\nでも、こっちは違います",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060210"
  },
  {
    "id": 1002004060220,
    "speaker": "灯織",
    "text": "最初こそ、必要に駆られてでしたけど\r\n今は…………──",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060220"
  },
  {
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1002004060230,
    "speaker": "灯織",
    "text": "今は、誰かのために作りたいから、\r\n食べてほしい人たちがいるから、作るんです",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060230"
  },
  {
    "id": 1002004060240,
    "speaker": "灯織",
    "text": "私が作ったものを喜んでくれる人がいて、\r\n食べてくれて、それが嬉しいから……！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060240"
  },
  {
    "id": 1002004060250,
    "speaker": "灯織",
    "text": "そういう、喜んでくれるかなって思いながら作ったり\r\nリクエストしてもらって作ったりすること",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060250"
  },
  {
    "id": 1002004060260,
    "speaker": "灯織",
    "text": "本当に、全然苦じゃないなって\r\nむしろ楽しくて、進んでやっている自分がいて",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060260"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2300
  },
  {
    "id": 1002004060270,
    "speaker": "灯織",
    "text": "私、料理するの結構好きなんだなって────",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060270"
  },
  {
    "id": 1002004060280,
    "speaker": "灯織",
    "text": "本当、気付くのが遅すぎましたね\r\nこんなに簡単なこと、もっと早く気付いていたら……",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200406/1002004060280"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなことないさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織が好きなこと、これからみんなに伝えていけばいいんだ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
