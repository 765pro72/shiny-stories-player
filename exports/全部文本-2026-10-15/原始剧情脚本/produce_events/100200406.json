    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "なぁ灯織\r\n俺さ、今ものすごく親子丼が食べたい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
