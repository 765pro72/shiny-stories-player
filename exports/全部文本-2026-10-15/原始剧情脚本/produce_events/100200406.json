  {
    "id": 1002004060050,
    "speaker": "灯織",
    "text": "どうぞ",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
