    "waitTime": 500
  },
  {
    "speaker": "神主",
    "text": "境内の掃除をしてもらう他にも、理由があるんです\r\nこちらは大人の事情ではありますが",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "神主",
    "text": "子どもたちに、頼っていい場所と大人を知ってもらう……\r\n地域で子どもたちを守ろうという取り組みの一環で──",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "fg": "fade_out",
    "bgEffect": "fade",
