  {
    "id": 3012007030370,
    "speaker": "果穂",
    "text": "海風も気持ちいいです！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030370"
  },
  {
    "id": 3012007030380,
    "speaker": "夏葉",
    "text": "トレーニングを終えたという達成感も\r\n一因なんじゃないかしら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030380"
  },
  {
    "id": 3012007030390,
    "speaker": "凛世",
    "text": "ふふ……\r\nですが……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030390"
  },
  {
    "id": 3012007030400,
    "speaker": "凛世",
    "text": "夏は……\r\nまだまだ続きましょう……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030400"
  },
  {
    "id": 3012007030410,
    "speaker": "智代子",
    "text": "暑さ寒さも～ってやつだよね！\r\n少なくとも９月までは暑い──！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030410"
  },
  {
    "id": 3012007030420,
    "speaker": "樹里",
    "text": "チョコ、それってもっと続いてほしいって意味か？\r\nそれとも早く終われって？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030420"
  },
  {
    "id": 3012007030430,
    "speaker": "智代子",
    "text": "実は悩んでるんだよね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030430"
  },
  {
    "id": 3012007030440,
    "speaker": "智代子",
    "text": "トレーニング中は暑くって大変だけど、\r\nアイスとかスイカとかが美味しいのは夏だし……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030440"
  },
  {
    "id": 3012007030450,
    "speaker": "樹里",
    "text": "ブレねぇな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030450"
  },
  {
    "id": 3012007030460,
    "speaker": "果穂",
    "text": "スイカ……！\r\n今日の朝ご飯にも出るでしょうか……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030460"
  },
  {
    "id": 3012007030470,
    "speaker": "夏葉",
    "text": "昨日頂いたの、美味しかったものね！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030470"
  },
  {
    "id": 3012007030480,
    "speaker": "果穂",
    "text": "はいっ！\r\nあたしは、『今日もスイカが食べられる』にかけます！",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "fade_out",
    "voice": "produce_events/301200703/3012007030480"
  },
  {
    "id": 3012007030490,
    "speaker": "夏葉",
    "text": "あら、困ったわ\r\n私もそっちに賭けたいもの",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0002",
    "se": "0417",
    "voice": "produce_events/301200703/3012007030490"
  },
  {
    "id": 3012007030500,
    "speaker": "果穂",
    "text": "凛世さん！\r\n凛世さんはどう思いますか！？",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0417",
    "voice": "produce_events/301200703/3012007030500"
  },
  {
    "id": 3012007030510,
    "speaker": "凛世",
    "text": "困りました……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030510"
  },
  {
    "id": 3012007030520,
    "speaker": "凛世",
    "text": "凛世も……\r\n同じ側に……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030520"
  },
  {
    "id": 3012007030530,
    "speaker": "智代子",
    "text": "私もっ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030530"
  },
  {
    "id": 3012007030540,
    "speaker": "樹里",
    "text": "アタシもだな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030540"
  },
  {
    "id": 3012007030550,
    "speaker": "凛世",
    "text": "ふふ……では……\r\nあとは神様が決めること……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030550"
  },
  {
    "id": 3012007030560,
    "speaker": "凛世",
    "text": "トレーニングを頑張り……\r\n未来を……引き寄せましょう……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030560"
  },
  {
    "id": 3012007030570,
    "speaker": "凛世",
    "text": "スイカを頂く……未来を……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200703/3012007030570"
  },
