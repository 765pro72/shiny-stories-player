    "textFrame": "001",
    "voice": "produce_events/180300103/1803001030060"
  },
  {
    "speaker": "トレーナー",
    "text": "あはは！\r\nそういうところも応援してくれるのがファンなわけだし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1803001030070,
    "speaker": "MEMちょ",
    "text": "ひ、否定してもらえない……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300103/1803001030070"
  },
