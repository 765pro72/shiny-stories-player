  },
  {
    "textFrame": "off",
    "nextLabel": "end"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001030200,
    "label": "2",
    "speaker": "MEMちょ",
    "text": "なんのお礼？",
    "charAnim1": "wait4",
    "charAnim2": "face_surp",
