    "voice": "produce_events/180300103/1803001030210"
  },
  {
    "id": 1803001030220,
    "speaker": "MEMちょ",
    "text": "プロデューサー、私のことなのに\r\n私より『痛い』って顔してるんだもん",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300103/1803001030220"
  },
  {
    "id": 1803001030230,
    "speaker": "MEMちょ",
    "text": "そんな人が持ってるより、私が持ってる方が\r\n双方ダメージが少ないってね！　合理的な判断だよ！",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
