  {
    "id": 1013004060010,
    "speaker": "夏葉",
    "text": "──みんな、もうすぐ着くそうよ\r\n注文はそれからにしましょうか",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
