    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101300406/1013004060010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 1013004060020,
    "speaker": "夏葉",
    "text": "ふふっ、どうしたの？\r\nそんなにキョロキョロして",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300406/1013004060020"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなで久しぶりにファミレスに行きたい\r\nってことだったから、来たけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "やっぱり５人集まったら目立ちそうだなって……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013004060030,
    "speaker": "夏葉",
    "text": "あら、そうかしら？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
