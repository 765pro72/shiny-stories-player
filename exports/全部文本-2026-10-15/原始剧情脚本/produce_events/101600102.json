[
  {
    "speaker": "プロデューサー",
    "text": "（そろそろ約束の時間だな）",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00003",
    "bgm": "003"
  },
  {
    "id": 1016001020010,
    "speaker": "千雪",
    "text": "はあっ……はあっ……\r\nプロデューサーさん、お待たせしました～！",
    "charAnim1": "anger1",
    "charLipAnim": "lip_anger",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "voice": "produce_events/101600102/1016001020010"
  },
  {
    "id": 1016001020020,
    "speaker": "千雪",
    "text": "すみません\r\n雑貨屋のお仕事が、少し長引いてしまって……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020020",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫、時間通りだよ\r\nお疲れさま",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それじゃあ、今からはこっちに集中してくれ\r\nごめんな……休憩もあんまりないままで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020030,
    "speaker": "千雪",
    "text": "いいえ、頑張りますね～！\r\n今日のお仕事は、挨拶まわり……ですよね？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "うちの事務所が関わってるイベントがあるから、\r\nそこへ行って主催者に挨拶をしよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020040,
    "speaker": "千雪",
    "text": "はい\r\n……私にちゃんとできるでしょうか",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020040",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫、千雪にならできるさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あまり難しく考えずに\r\nイベントの雰囲気を楽しんでもらいたいなって思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（アイドルのことをよく知らない千雪には、\r\nステージを見てもらうのが一番だしな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020050,
    "speaker": "千雪",
    "text": "わ、わかりました",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020050"
  },
  {
    "charLabel": "chiyuki",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "effectLabel": "black",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
    }
  },
  {
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "effectLabel": "black",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    }
  },
  {
    "charLabel": "chiyuki",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 1016001020060,
    "speaker": "千雪",
    "text": "桑山千雪といいます、新人のアイドルです\r\nどうぞよろしくお願いします",
    "charAnim1": "shy1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "016",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "bg": "00012",
    "voice": "produce_events/101600102/1016001020060"
  },
  {
    "speaker": "イベント主催者",
    "text": "おお～っそのスマイル、いいねぇ！　グッドグッド～！\r\nイベント、楽しんでいっちゃって～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016001020070,
    "speaker": "千雪",
    "text": "は、はい\r\nありがとうございます～",
    "charAnim2": "face_surp",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020070",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "（千雪にはやっぱり、何かがあるんだよな\r\n緊張はしてるけど、ちゃんと笑顔で挨拶できてる）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪、お疲れさま\r\nよく挨拶できてたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020080,
    "speaker": "千雪",
    "text": "ありがとうございます\r\nそう言ってもらえると安心します",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020080"
  },
  {
    "id": 1016001020090,
    "speaker": "千雪",
    "text": "なんだか、少し恥ずかしいですけど……\r\n褒めていただいて、嬉しいな……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪の笑顔を気に入ってくれたんだ\r\nよし、ステージを見に行こうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "effectLabel": "black1",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "waitType": "time",
    "waitTime": 800
  },
  {
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 240
    }
  },
  {
    "id": 1016001020100,
    "speaker": "千雪",
    "text": "……わぁ",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうだ？\r\nアイドルイベントは初めてだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020110,
    "speaker": "千雪",
    "text": "想像以上でした……\r\nアイドルの頑張る姿って、あんなに魅力的なんですね",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪も、アイドルだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020120,
    "speaker": "千雪",
    "text": "……そう、言えるかどうか",
    "charAnim2": "face_sad",
    "charAnim3": "no",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020120",
    "charAnim3Loop": false
  },
  {
    "id": 1016001020130,
    "speaker": "千雪",
    "text": "さっきのステージ、\r\n観客の方もスタッフさんたちも、みんな楽しそうで……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020130"
  },
  {
    "id": 1016001020140,
    "speaker": "千雪",
    "text": "私も、あんな風にたくさんの人を\r\n笑顔にできるのかなって……ちょっと不安です",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は、できるって思ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020150,
    "speaker": "千雪",
    "text": "……プロデューサーさん",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020150"
  },
  {
    "id": 1016001020160,
    "speaker": "千雪",
    "text": "ふふ、はい……\r\nじゃあ、もっとアイドル活動に時間をかけなきゃです",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よかった……いい刺激に、なったのかな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは嬉しいよ\r\nじゃあ、さしあたっては……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "営業に\r\n力を入れてみよう",
    "nextLabel": "1"
  },
  {
    "select": "仕事を丁寧にこなそう",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "レッスンが大事だ",
    "nextLabel": "3"
  },
  {
    "speaker": "プロデューサー",
    "text": "営業に力を入れてみよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "今日みたいに、挨拶回りをするのも手だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "業界の人たちに知ってもらえれば、\r\n自然と仕事ももらえるようになる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020170,
    "speaker": "千雪",
    "text": "はい\r\nまずは顔と名前を覚えてもらうってことですね",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、いろんな人に、\r\n千雪の笑顔を知ってほしいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020180,
    "speaker": "千雪",
    "text": "まあ、そんな……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020180"
  },
  {
    "id": 1016001020190,
    "speaker": "千雪",
    "text": "でも、笑顔を知ってもらうお仕事って考えると\r\n……とっても素敵ですね",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n頑張っていこうな",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事を丁寧にこなしていこう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "きれいごとに聞こえるかもしれないけど、\r\n仕事に大きいも小さいもない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020200,
    "speaker": "千雪",
    "text": "そうですね……いただいたお仕事には\r\nきちんと向き合わなきゃ",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020200"
  },
  {
    "id": 1016001020210,
    "speaker": "千雪",
    "text": "そんな風に言ってくださるプロデューサーさんで\r\n……よかったです",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020210",
    "charAnim3Loop": false
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、千雪のいいところを\r\nみんなにちゃんと見てもらおうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020220,
    "speaker": "千雪",
    "text": "はい……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/101600102/1016001020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "レッスンが大事だと思う",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "基礎があれば、どんな仕事にも自信が持てるからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020230,
    "speaker": "千雪",
    "text": "そうですね。では早速……\r\nこの後、お付き合いいただいてもかまいませんか？",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020230"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、いいぞ\r\nけど……レッスン室が取れてないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020240,
    "speaker": "千雪",
    "text": "では……トレーニングです！\r\nプロデューサーさん、河原を走りましょう！",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600102/1016001020240"
  },
  {
    "id": 1016001020250,
    "speaker": "プロデューサー",
    "text": "よ、よし……\r\nとことん付き合うぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（千雪の笑顔には、ついその気にさせられるな……！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪のその笑顔、たくさんの人に届けような",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016001020260,
    "speaker": "千雪",
    "text": "は、はい……！\r\n頑張ります、プロデューサーさん！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/101600102/1016001020260"
  },
  {
    "label": "end"
  }
]