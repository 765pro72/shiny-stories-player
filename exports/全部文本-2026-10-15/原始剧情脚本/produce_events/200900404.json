  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……お、色んな形があるんだな\r\nいただきます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004040100,
    "speaker": "果穂",
    "text": "はいっ！　めしあがれ、です！",
