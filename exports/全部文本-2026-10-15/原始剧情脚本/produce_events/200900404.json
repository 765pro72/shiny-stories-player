    "voice": "produce_events/200900404/2009004040060"
  },
  {
    "id": 2009004040070,
    "speaker": "果穂",
    "text": "これ……\r\nプロデューサーさん、食べてくださいっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
