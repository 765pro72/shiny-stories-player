    "textFrame": "001",
    "voice": "produce_events/200900404/2009004040070"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、果穂が作ったのか！\r\nありがとう、いただくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかくだから……そこの公園で食べていこうか\r\n夕日が綺麗だし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
