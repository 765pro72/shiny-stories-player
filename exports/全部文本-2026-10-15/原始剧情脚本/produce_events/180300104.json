    "waitTime": 1400
  },
  {
    "id": 1803001040140,
    "speaker": "MEMちょ",
    "text": "（こ、この人！　わざとだーーーー！？\r\n私たちのことなのにわざと遠回しに言ってる！）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040140"
  },
  {
    "id": 1803001040150,
    "speaker": "MEMちょ",
    "text": "（嘘ぉ、ちょっとやり口がこっぱずかしくない！？）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "っふふ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040160,
    "speaker": "MEMちょ",
    "text": "（あっヤバ、気づいたの気づかれた！）",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mem",
    "textCtrl": "p",
