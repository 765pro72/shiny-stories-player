    "se": "0220",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "──MEMちょは、どう思う？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
