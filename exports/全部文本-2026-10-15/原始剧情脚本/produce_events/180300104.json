    "waitTime": 500
  },
  {
    "id": 1803001040180,
    "speaker": "MEMちょ",
    "text": "『俺』？\r\n『プロデュース』？",
    "charAnim1": "surp2",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "bgm": "127",
    "voice": "produce_events/180300104/1803001040180"
  },
  {
    "speaker": "プロデューサー",
    "text": "間違った\r\nプロデュースじゃなくて『一緒に仕事』だろうな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040190,
    "speaker": "MEMちょ",
    "text": "ふーん……？\r\n──まぁいいや！",
    "charAnim1": "wait1",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040190"
  },
  {
    "id": 1803001040200,
    "speaker": "MEMちょ",
    "text": "私も、私の話っていうか一般論しか話せないけど！\r\nそういうの、嬉しいんじゃないかな～？　って思うよぉ",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！　そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040210,
    "speaker": "MEMちょ",
    "text": "……ただ、そんなに心配しなくていいよーっていうのも\r\n思うかな？",
