  {
    "id": 1803001040100,
    "speaker": "MEMちょ",
    "text": "うんうん",
    "charAnim1": "wait",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/180300104/1803001040100"
  },
  {
    "speaker": "プロデューサー",
    "text": "その人が一緒に仕事をしている──\r\n業務上のパートナーって言ったらいいのかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういう相手との関係というか、\r\n踏み込んでいいラインについて迷ってるみたいで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040110,
    "speaker": "MEMちょ",
    "text": "うん──",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ある出来事があって──\r\nその件についての本音を聞きたいらしいんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "一緒に働き始めたばかりだから……そう聞くことが、\r\n逆に相手の負担になるかもって考えてるそうなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040120,
    "speaker": "MEMちょ",
    "text": "……うん……？",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/180300104/1803001040120"
  },
  {
    "id": 1803001040130,
    "speaker": "MEMちょ",
    "text": "（……あれ？　これ……\r\nいやいやいや、自意識過剰……？）",
    "charAnim2": "face_shy",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_sad_s",
    "charLabel": "mem",
    "textCtrl": "p",
