    "se": "0220",
    "voice": "produce_events/180300104/1803001040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "──笑ってすまん、続けるな？",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_anger2",
    "charAnim4": "eye_front",
