  },
  {
    "speaker": "プロデューサー",
    "text": "そうじゃなくて！　……このあと、相談に乗ってほしいんだ\r\nよければ、MEMちょのアドバイスが欲しい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040050,
    "speaker": "MEMちょ",
    "text": "お、おお……？\r\nそりゃあ全然、私で手伝えることは手伝うけど──",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
