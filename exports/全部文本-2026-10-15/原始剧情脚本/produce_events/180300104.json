  {
    "speaker": "プロデューサー",
    "text": "お疲れ様、MEMちょ\r\n──少し、いいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1803001040040,
    "speaker": "MEMちょ",
    "text": "うんお疲れ様～！\r\n──ってアレ！？　今のステージなんかやばかった！？",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
