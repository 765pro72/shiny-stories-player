    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201200601/2012006010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫大丈夫\r\nもうちょっと……見てような…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
