    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 20000090010150,
    "speaker": "果穂",
    "text": "はいっ\r\nお仕事がんばってください！",
    "charAnim1": "smile2",
