  {
    "speaker": "プロデューサー",
    "text": "お、果穂。おはよう\r\nマメ丸の散歩中かな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 20000090010020,
    "speaker": "果穂",
    "text": "そうですっ\r\nおはようございますー！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charAnim3": "off",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
