  {
    "textFrame": "off",
    "se": "2768",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょ、ちょっと待ってくれ\r\nそんなにいっぱいは悪いよ。果穂の分がなくなる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 20000090010130,
    "speaker": "果穂",
    "text": "大丈夫です！\r\nおうちにいっぱいありますっ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/2000009001/20000090010130"
  },
  {
    "textFrame": "off",
