  {
    "id": 1006003030040,
    "speaker": "咲耶",
    "text": "あ、ああ、すまない。ぼーっとしてしまってたよ",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
