  {
    "speaker": "プロデューサー",
    "text": "……自分では見えないから、なんとも言えないな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008020160,
    "speaker": "果穂",
    "text": "あたしとおそろいで、カッコいいです……！\r\nこれで仮装はばっちりですねっ！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
