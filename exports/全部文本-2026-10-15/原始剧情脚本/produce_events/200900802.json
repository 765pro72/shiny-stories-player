    "voice": "produce_events/200900802/2009008020020"
  },
  {
    "id": 2009008020030,
    "speaker": "果穂",
    "text": "──おかしをくれなきゃ、イタズラします……っ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "んんっ！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょ、ちょっと待ってくれ\r\nハロウィンには早くないか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008020040,
    "speaker": "果穂",
    "text": "ちょっと早いかもしれません！\r\nでも、縦割り班では今日がハロウィンの日なんです！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "縦割り……？　ああ、学校の……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009008020050,
    "speaker": "果穂",
    "text": "はいっ！\r\n低学年の子たちをおうちまで送りながら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020050"
  },
  {
    "id": 2009008020060,
    "speaker": "果穂",
    "text": "みんなのお母さんに、たくさんたくさん、\r\nたーっくさん！　おかしをもらって帰ってきました！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020060"
  },
  {
    "id": 2009008020070,
    "speaker": "果穂",
    "text": "なので……プロデューサーさん……！\r\nおかしくださいっ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020070"
  },
