    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900802/2009008020090"
  },
  {
    "id": 2009008020100,
    "speaker": "果穂",
    "text": "じゃあ、おかしをもらえなかったので、\r\nイタズラします！",
