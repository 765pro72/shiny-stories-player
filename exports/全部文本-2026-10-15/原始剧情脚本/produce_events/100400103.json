    }
  },
  {
    "id": 1004001030240,
    "speaker": "恋鐘",
    "text": "はぁ……はぁ……みんな拍手ありがと～！\r\nダンス頑張った甲斐があったばい～！",
    "charCategory": "stand_costume",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
