      "x": 568,
      "y": 640,
      "order": 0
    },
    "bg": "00012",
    "se": "0110",
    "voice": "produce_events/100400103/1004001030200"
  },
  {
    "id": 1004001030210,
    "speaker": "恋鐘",
    "text": "いったー……！\r\nお尻、おもいっきり打ったっちゃー！",
    "charAnim1": "sad1",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400103/1004001030210"
  },
  {
    "id": 1004001030220,
    "speaker": "恋鐘",
    "text": "あ、うん！　みんなありがとー！　うち平気ばいー！\r\nでも……みんな、笑いすぎっちゃー！！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100400103/1004001030220"
  },
  {
    "speaker": "プロデューサー",
    "text": "（最後の最後で転ぶとは……\r\nでもファンにはとてもウケたみたいだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（それに歌の方は集中したおかげで\r\nいつも以上に元気で伸びやかな声がでていた）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（いい歌声だったぞ、恋鐘）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "speaker": "プロデューサー",
    "text": "ダンスに気合をいれよう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "かっこいいダンスを踊れば、恋鐘の可愛さとのギャップで\r\n絶対盛り上がるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1004001030230,
    "speaker": "恋鐘",
    "text": "かっこいいダンス……なるほど～！\r\nうちに、ドーンとまかせとって～！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
