    }
  },
  {
    "id": 1004001030200,
    "speaker": "恋鐘",
    "text": "……みんな、うちのソロ曲どうやったー？　え？　最高？\r\nんふふ、ありがとー！　じゃあ次は――うわっ！！",
    "charCategory": "stand_costume",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
