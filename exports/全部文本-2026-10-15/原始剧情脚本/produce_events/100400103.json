  },
  {
    "id": 1004001030270,
    "speaker": "恋鐘",
    "text": "……ん！　もうこんな時間たい！\r\nというわけで、うちの時間はこれでおしまい！",
    "charCategory": "stand_costume",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
