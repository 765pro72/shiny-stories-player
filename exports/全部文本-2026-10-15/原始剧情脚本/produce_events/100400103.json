    "voice": "produce_events/100400103/1004001030270"
  },
  {
    "id": 1004001030280,
    "speaker": "恋鐘",
    "text": "今日はうちの話いっぱい聞いてくれてありがと～！　\r\nうれしかったばい！",
    "charLipAnim": "lip_smile",
