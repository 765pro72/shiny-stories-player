  {
    "speaker": "プロデューサー",
    "text": "『確認と写真ありがとうな\r\nまだ寝なくて平気か？』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002013110370,
    "speaker": "灯織",
    "text": "『大丈夫ですよ\r\nそんなに遅い時間でもないですし』",
    "charAnim1": "smile2",
