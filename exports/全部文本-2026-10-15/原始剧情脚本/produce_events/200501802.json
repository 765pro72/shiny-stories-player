    "textFrame": "001",
    "voice": "produce_events/200501802/2005018020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、そうだな\r\nちょっと待ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
