    "textFrame": "002",
    "se": "2397"
  },
  {
    "id": 2005018020080,
    "speaker": "摩美々",
    "text": "500円玉でお願いしますー\r\n小さいとやりにくいんで……できれば２枚欲しいですねー",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
