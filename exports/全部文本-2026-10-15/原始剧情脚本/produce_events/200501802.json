    "textFrame": "001",
    "voice": "produce_events/200501802/2005018020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうか……ちょっと待ってくれ\r\nじゃあこれ……500円玉２枚だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
