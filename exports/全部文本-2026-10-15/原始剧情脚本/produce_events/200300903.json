    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "次に止まったら、はどうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009030160,
    "speaker": "めぐる",
