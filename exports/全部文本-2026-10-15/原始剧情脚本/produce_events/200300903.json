  },
  {
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "meguru",
    "textFrame": "off",
    "se": "0134",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、友達も速いな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009030070,
    "speaker": "めぐる",
    "text": "えへへっ、会話始めると止まらないんだ！\r\n一回会っただけじゃ、全然話し足りなくて……！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300903/2003009030070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あれ、向こうは今夜中なんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009030080,
    "speaker": "めぐる",
    "text": "あっまだ日本にいるんだよ！\r\nあと一週間くらいだったかな",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300903/2003009030080"
  },
  {
    "id": 2003009030090,
    "speaker": "めぐる",
    "text": "時間足りなかったから、こっちにいるうちに\r\nもう一回遊ぼう！　って話してたの！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300903/2003009030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな、じゃあ早く返信してあげないと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009030100,
    "speaker": "めぐる",
    "text": "そっか……！　プロデューサー、ちょっとごめんね！",
