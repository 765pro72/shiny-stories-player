  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと今は難しいかな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003009030140,
    "speaker": "めぐる",
    "text": "そうだった……！\r\n運転中によそ見はダメだよね……っ！",
