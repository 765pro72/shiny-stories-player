    },
    "bg": "00017",
    "bgm": "008",
    "voice": "produce_events/200100411/2001004110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "起きたか、真乃",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110020,
    "speaker": "真乃",
    "text": "プロデューサーさん……？\r\nあれ、私……",
    "charAnim1": "wait2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110020"
  },
  {
    "id": 2001004110030,
    "speaker": "真乃",
    "text": "ほわわっ！\r\nす、すみません……いつのまにか寝ちゃってて……",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、公園に来てからそんなに時間は経ってないよ",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110040,
    "speaker": "真乃",
    "text": "そうですか？\r\nよかったです……いえ、よくないですけど……",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "『W.I.N.G.』で優勝してから、ほとんど休みがなかったもんな\r\n疲れてしまうのも無理はないよ",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110050,
    "speaker": "真乃",
    "text": "そうですね……\r\n息抜きに公園に来ても、うとうとすることが多くって",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110050"
  },
  {
    "id": 2001004110060,
    "speaker": "真乃",
    "text": "鳩さんともそれほど遊べなかったり……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110060"
  },
  {
    "id": 2001004110070,
    "speaker": "真乃",
    "text": "でもそれで、アイドルが嫌になるってことはないんです\r\nどちらかと言うと……なんて言うんでしょう？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "no",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110070"
  },
  {
    "id": 2001004110080,
    "speaker": "真乃",
    "text": "充実……そう私、充実しています\r\n毎日が楽しいんです",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、いいことだね",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110090,
    "speaker": "真乃",
    "text": "はい、ありがとうございます",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110090"
  },
  {
    "id": 2001004110100,
    "speaker": "真乃",
    "text": "……さっきまで私、夢を見てました",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　どんな夢？",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110110,
    "speaker": "真乃",
    "text": "えっと……私が、ライブに出る夢です",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110110"
  },
  {
    "id": 2001004110120,
    "speaker": "真乃",
    "text": "灯織ちゃんやめぐるちゃんと、おっきなステージに立って\r\nすごく遠くまでお客さんがいて……みんな笑顔でした",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか\r\nいい夢だったんだな",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110130,
    "speaker": "真乃",
    "text": "……はい\r\nでも――",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110130"
  },
  {
    "id": 2001004110140,
    "speaker": "真乃",
    "text": "私が、あんなに大きなステージに立つ日が……\r\n来るんでしょうか……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "まだまだ遠くのことだと思ってるみたいだな\r\nそんなことはないさ",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃はたくさんの夢を叶えてきただろ？\r\nアイドルになる時に抱いた夢",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110150,
    "speaker": "真乃",
    "text": "はい\r\nもっと他の人と仲良くなれたらって思ってました……",
    "charAnim2": "face_wait",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110150"
  },
  {
    "id": 2001004110160,
    "speaker": "真乃",
    "text": "そしたら、お友達ができました",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110160"
  },
  {
    "id": 2001004110170,
    "speaker": "真乃",
    "text": "もっと自分に自信が持てるようになりたかったんです",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110170"
  },
  {
    "id": 2001004110180,
    "speaker": "真乃",
    "text": "今でも相変わらずほわほわしてますけど……\r\n私は大丈夫なんだって、思えるようになりました",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110180"
  },
  {
    "id": 2001004110190,
    "speaker": "真乃",
    "text": "まだまだですけど……\r\n私、少しは変わることができたかなって……",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "少しどころじゃないさ\r\n真乃は、ぐんぐん成長しているよ",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110200,
    "speaker": "真乃",
    "text": "……そうなんですか？",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "アイドルになってから、\r\n『W.I.N.G.』で優勝するって夢もできたね",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それも、真乃は叶えることができた",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃はいくつも夢を叶えてきたんだ\r\nまた新しい夢を持ってみるのも、いいんじゃないかな？",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110210,
    "speaker": "真乃",
    "text": "今までの夢が叶ったのは……\r\nプロデューサーさんがいてくれたからです",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110210"
  },
  {
    "id": 2001004110220,
    "speaker": "真乃",
    "text": "プロデューサーさん……\r\nこれからも、私と一緒にいてください",
    "charAnim1": "anger2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0107",
    "voice": "produce_events/200100411/2001004110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、当然そのつもりだよ\r\n一緒に夢を叶えていこう",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001004110230,
    "speaker": "真乃",
    "text": "はい\r\n次の夢も、その次の夢も",
    "charAnim2": "face_smile",
    "charAnim3Loop": false,
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110230"
  },
  {
    "id": 2001004110240,
    "speaker": "真乃",
    "text": "ずっとプロデューサーさんと一緒に\r\n叶えていきたいです……",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100411/2001004110240"
  },
  {
    "label": "end"
  }
]