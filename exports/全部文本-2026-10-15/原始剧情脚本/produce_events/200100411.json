[
  {
    "id": 2001004110010,
    "speaker": "真乃",
    "text": "……ん",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040010010",
    "charPosition": {
