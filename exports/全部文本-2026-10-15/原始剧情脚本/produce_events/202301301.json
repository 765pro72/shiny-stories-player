    "waitTime": 1500
  },
  {
    "id": 2023013010270,
    "speaker": "雛菜",
    "text": "……でも、雛菜ちょっとびっくりしたかも\r\nいつもと逆のこと言われたから",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "099",
    "voice": "produce_events/202301301/2023013010270"
  },
  {
    "id": 2023013010280,
    "speaker": "雛菜",
    "text": "『楽しそうでいいね～』って、よく言われるのにな～",
