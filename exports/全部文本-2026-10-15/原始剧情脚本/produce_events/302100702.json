    "waitTime": 1500
  },
  {
    "id": 3021007020250,
    "speaker": "小糸",
    "text": "……今日は外部の人がいない打ち合わせだから、\r\n遅れても大丈夫だよって",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020250"
  },
  {
    "id": 3021007020260,
    "speaker": "雛菜",
    "text": "へ～～～！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020260"
  },
  {
    "id": 3021007020270,
    "speaker": "小糸",
    "text": "雨が弱まってからゆっくりおいで……だって……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020270"
  },
  {
    "id": 3021007020280,
    "speaker": "円香",
    "text": "弱まらないんだけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020280"
  },
  {
    "id": 3021007020290,
    "speaker": "透",
    "text": "じゃ、待つか",
