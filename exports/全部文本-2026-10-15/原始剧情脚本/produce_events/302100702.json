  {
    "id": 3021007020010,
    "speaker": "小糸",
    "text": "『雨がとても強く』──……",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0461",
    "voice": "produce_events/302100702/3021007020010"
  },
  {
    "id": 3021007020020,
    "speaker": "円香",
    "text": "交通機関の乱れが予想されるため",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020020"
  },
  {
    "id": 3021007020030,
    "speaker": "小糸",
    "text": "『交通機関の乱れが予想されるため\r\n本日の打ち合わせには遅れる見込みです』",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0461",
    "voice": "produce_events/302100702/3021007020030"
  },
  {
    "id": 3021007020040,
    "speaker": "透",
    "text": "いいね\r\n社会人。小糸ちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020040"
  },
  {
    "id": 3021007020050,
    "speaker": "円香",
    "text": "ご了承ください",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020050"
  },
  {
    "id": 3021007020060,
    "speaker": "小糸",
    "text": "『ご了承ください』……こ、これでいいかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0330",
    "voice": "produce_events/302100702/3021007020060"
  },
  {
    "id": 3021007020070,
    "speaker": "円香",
    "text": "オッケー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020070"
  },
  {
    "id": 3021007020080,
    "speaker": "透",
    "text": "ゴー",
    "textCtrl": "p",
    "textFrame": "001",
