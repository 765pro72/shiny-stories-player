  {
    "id": 3021007020090,
    "speaker": "雛菜",
    "text": "終わった～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020090"
  },
  {
    "id": 3021007020100,
    "speaker": "円香",
    "text": "まだ返信待ち",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020100"
  },
  {
    "id": 3021007020110,
    "speaker": "雛菜",
    "text": "じゃあ何する～？\r\n暇じゃない～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020110"
  },
  {
    "id": 3021007020120,
    "speaker": "円香",
    "text": "まだだって言ってるでしょ\r\nすぐに来いってことになるかもしれない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020120"
  },
  {
    "id": 3021007020130,
    "speaker": "雛菜",
    "text": "へ～？\r\nこんな雨なのに～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020130"
  },
  {
    "id": 3021007020140,
    "speaker": "円香",
    "text": "仕事だから",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020140"
  },
  {
    "id": 3021007020150,
    "speaker": "小糸",
    "text": "そ、それか\r\n迎えに来てくれるかも……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020150"
  },
  {
    "id": 3021007020160,
    "speaker": "円香",
    "text": "……ああ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020160"
  },
  {
    "id": 3021007020170,
    "speaker": "雛菜",
    "text": "じゃあ迎えに来てくれるまでは\r\n何する～？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020170"
  },
  {
    "id": 3021007020180,
    "speaker": "透",
    "text": "ダメ？　打ち合わせ\r\n学校じゃ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020180"
  },
  {
    "id": 3021007020190,
    "speaker": "雛菜",
    "text": "あ～、それいい～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020190"
  },
  {
    "id": 3021007020200,
    "speaker": "円香",
    "text": "部外者でしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020200"
  },
  {
    "id": 3021007020210,
    "speaker": "透",
    "text": "え？\r\nあー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020210"
  },
  {
    "id": 3021007020220,
    "speaker": "透",
    "text": "やばいの？\r\n保護者じゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020220"
  },
  {
    "id": 3021007020230,
    "speaker": "円香",
    "text": "保護者、じゃない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020230"
  },
  {
    "textFrame": "off",
    "se": "0134",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3021007020240,
    "speaker": "小糸",
    "text": "あ……！\r\nプロデューサーさんから返事……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100702/3021007020240"
  },
