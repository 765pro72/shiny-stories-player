    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701800107/7018001070080"
  },
  {
    "id": 7018001070090,
    "speaker": "冬優子",
    "text": "だから今、参加できるだけで\r\nみっともなく騒がないでよね",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701800107/7018001070090"
  },
  {
    "speaker": "プロデューサー",
