  },
  {
    "id": 7003001010010,
    "speaker": "めぐる",
    "text": "ほんとに！？",
    "charAnim1": "surp1",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当だ！　めぐるの努力が実ったんだ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001010020,
    "speaker": "めぐる",
    "text": "わーい！　やったー！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "よくやったな！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001010030,
    "speaker": "めぐる",
    "text": "えへへー！　でも、通過できたのは\r\nプロデューサーのおかげだよ！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010030"
  },
  {
    "id": 7003001010040,
    "speaker": "めぐる",
    "text": "なんにもわからないわたしと一緒に、\r\n一から頑張ってくれたんだもん！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、俺は大したことしてないよ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_a",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるの持っている魅力が周りに伝わったからこその\r\n結果だろう",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001010050,
    "speaker": "めぐる",
    "text": "魅力なんて大げさだよー！",
    "charAnim1": "no",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "大げさなことを言ってるつもりはない\r\nめぐるはきっと、すごいアイドルになれるはずだ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001010060,
    "speaker": "めぐる",
    "text": "ほんとうに？\r\nそんなに褒められると照れちゃうなぁ……！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐるをずっと近くで見てる\r\n俺が言うんだから、間違いないさ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7003001010070,
    "speaker": "めぐる",
    "text": "えへへ……\r\n熱いね、プロデューサー！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010070"
  },
  {
    "id": 7003001010080,
    "speaker": "めぐる",
    "text": "こんなに応援してもらえて、\r\nわたしすっごく嬉しいよ！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010080"
  },
  {
    "id": 7003001010090,
    "speaker": "めぐる",
    "text": "プロデューサーが言うみたいな、\r\nすごいアイドルになれるのかはまだわからないけど……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010090"
  },
  {
    "id": 7003001010100,
    "speaker": "めぐる",
    "text": "プロデューサーがわたしに、\r\nいっぱい期待してくれてるってことはわかったから",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010100"
  },
  {
    "id": 7003001010110,
    "speaker": "めぐる",
    "text": "全力で頑張るよ！\r\n期待には応えたいしね！",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010110"
  },
  {
    "id": 7003001010120,
    "speaker": "めぐる",
    "text": "だからこれからもよろしく、プロデューサー！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/700300101/7003001010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、こちらこそよろしく頼む！",
    "charLabel": "meguru",
    "textCtrl": "p",
