  {
    "id": 3021011010080,
    "speaker": "円香",
    "text": "見える世界に\r\n美しいものはなかった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010080"
  },
  {
    "id": 3021011010090,
    "speaker": "円香",
    "text": "みんながきれいだという、\r\n花も、星も、虹も",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010090"
  },
  {
    "id": 3021011010100,
    "speaker": "円香",
    "text": "大したものとは思えなかった",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010100"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3021011010110,
    "speaker": "円香",
    "text": "物心ついた時から、そう思っていた",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010110"
  },
  {
    "textFrame": "off",
    "bg": "00432",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "ボイストレーナー",
    "text": "────ずっと探していたでしょう？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3021011010120,
    "speaker": "円香",
    "text": "そう……だったでしょうか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010120"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "樋口さんの中には歌い方の答えがあった\r\nでも引き出し方だけがわからなくて────",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "それを探してた\r\n歌いながら、ずっと",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3021011010130,
    "speaker": "円香",
    "text": "……………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3021011010140,
    "speaker": "円香",
    "text": "そうですね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010140"
  },
  {
    "id": 3021011010150,
    "speaker": "円香",
    "text": "すみません、先生に教えてもらっていたのに、\r\nなかなか……正しい歌い方ができなくて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010150"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3021011010160,
    "speaker": "円香",
    "text": "何か、もっと……\r\n正しい音があるように思っていて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010160"
  },
  {
    "id": 3021011010170,
    "speaker": "円香",
    "text": "歌が持っているあるべきかたちというか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010170"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3021011010180,
    "speaker": "円香",
    "text": "いや、なんだろ……\r\nすみません、よくわからないことを言いました",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010180"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "……ううん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "ボイストレーナー",
    "text": "……その『あるべきかたち』は、\r\n歌が持っているものではないかもね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "ボイストレーナー",
    "text": "あなたの、ここ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3021011010190,
    "speaker": "円香",
    "text": "ここ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010190"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "そう、あなたが胸の奥に持っているもの\r\nあなた自身のかたち",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "魂……のようなものと言ってもいいのかも",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "0454",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "ボイストレーナー",
    "text": "大事にしなさい",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "いつか、あなたの正解を歌える日が来る",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ボイストレーナー",
    "text": "それまで頑張って\r\n…………歌い続けてね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3021011010200,
    "speaker": "円香",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010200"
  },
