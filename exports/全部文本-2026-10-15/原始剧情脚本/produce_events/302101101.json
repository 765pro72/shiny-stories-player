    "text": "『幸せな夢の中にずっと、とは思わない？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3021011010220,
    "speaker": "インタビュー記事",
    "text": "『そうですね』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302101101/3021011010220"
  },
  {
