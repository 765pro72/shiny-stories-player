  {
    "id": 3018009020040,
    "speaker": "あさひ",
    "text": "…………眠れないっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020040"
  },
  {
    "textFrame": "off",
    "bgm": "0000",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018009020050,
    "speaker": "冬優子",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020050"
  },
  {
    "id": 3018009020060,
    "speaker": "あさひ",
    "text": "眠れないっす、冬優子ちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0089",
    "voice": "produce_events/301800902/3018009020060"
  },
  {
    "id": 3018009020070,
    "speaker": "冬優子",
    "text": "………………寝るのよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020070"
  },
  {
    "id": 3018009020080,
    "speaker": "あさひ",
    "text": "眠れないっす！\r\n頑張ってるんすけど、全然だめっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020080"
  },
  {
    "id": 3018009020090,
    "speaker": "あさひ",
    "text": "どうやったら眠れるっすか？\r\n冬優子ちゃん、眠るっていつもどうやってるっすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020090"
  },
  {
    "id": 3018009020100,
    "speaker": "冬優子",
    "text": "あーもーうっさい……！\r\nまず静かにしなさい、愛依まで起きる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020100"
  },
  {
    "id": 3018009020110,
    "speaker": "あさひ",
    "text": "！\r\nはいっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 3018009020120,
    "speaker": "冬優子",
    "text": "……よし",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020120"
  },
  {
    "id": 3018009020130,
    "speaker": "冬優子",
    "text": "じゃあ次は目を閉じる\r\nそれからふゆがいいって言うまでしゃべらない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020130"
  },
  {
    "id": 3018009020140,
    "speaker": "あさひ",
    "text": "はいっす\r\n……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020140"
  },
  {
    "id": 3018009020150,
    "speaker": "冬優子",
    "text": "あとは何も考えずにゆっくり息を吸って吐く\r\nこれの繰り返し",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020150"
  },
  {
    "id": 3018009020160,
    "speaker": "冬優子",
    "text": "そしたらそのうち眠れるはずよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020160"
  },
  {
    "id": 3018009020170,
    "speaker": "あさひ",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020170"
  },
  {
    "id": 3018009020180,
    "speaker": "冬優子",
    "text": "……\r\nじゃ、おやすみ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020180"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018009020190,
    "speaker": "あさひ",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020190"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018009020200,
    "speaker": "あさひ",
    "text": "…………冬優子ちゃん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020200"
  },
  {
    "id": 3018009020210,
    "speaker": "冬優子",
    "text": "いいって言うまでしゃべらない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020210"
  },
  {
    "id": 3018009020220,
    "speaker": "あさひ",
    "text": "でも、わかんなくなってきたっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020220"
  },
  {
    "id": 3018009020230,
    "speaker": "冬優子",
    "text": "はぁ？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020230"
  },
  {
    "id": 3018009020240,
    "speaker": "あさひ",
    "text": "ゆっくり息するって思ったら\r\nそのこと考えちゃうっす",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020240"
  },
  {
    "id": 3018009020250,
    "speaker": "あさひ",
    "text": "『吸ってー……吐いてー……』っていうのは\r\n考えてても大丈夫っすか？　だめっすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020250"
  },
  {
    "id": 3018009020260,
    "speaker": "冬優子",
    "text": "ちょっ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020260"
  },
  {
    "id": 3018009020270,
    "speaker": "あさひ",
    "text": "だめだったらこの方法は無理っす\r\n別のやり方を教えてほしいっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020270"
  },
  {
    "id": 3018009020280,
    "speaker": "あさひ",
    "text": "しゃべれないのも困るっす\r\nこれで合ってるかの確認ができないっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020280"
  },
  {
    "id": 3018009020290,
    "speaker": "冬優子",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020290"
  },
  {
    "id": 3018009020300,
    "speaker": "あさひ",
    "text": "冬優子ちゃん？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020300"
  },
  {
    "id": 3018009020310,
    "speaker": "冬優子",
    "text": "……ふゆにばっか頼ってくんじゃないわよ\r\nあんたも自分でどうにかしようって姿勢を見せなさい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020310"
  },
  {
    "id": 3018009020320,
    "speaker": "あさひ",
    "text": "自分でできなかったから\r\n冬優子ちゃんに聞いてるっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020320"
  },
  {
    "id": 3018009020330,
    "speaker": "冬優子",
    "text": "だからって\r\nふゆがそれに付き合ってやる義理はないのよ……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020330"
  },
  {
    "id": 3018009020340,
    "speaker": "愛依",
    "text": "んー……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020340"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018009020350,
    "speaker": "冬優子",
    "text": "！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020350"
  },
  {
    "id": 3018009020360,
    "speaker": "あさひ",
    "text": "愛依ちゃん、起きたっすかね？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020360"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3018009020370,
    "speaker": "愛依",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020370"
  },
  {
    "id": 3018009020380,
    "speaker": "冬優子",
    "text": "……よかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020380"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 3018009020390,
    "speaker": "冬優子",
    "text": "……何も考えないのが無理っていうなら\r\n羊でも数えてれば？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020390"
  },
  {
    "id": 3018009020400,
    "speaker": "冬優子",
    "text": "こういう時の王道でしょ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020400"
  },
  {
    "id": 3018009020410,
    "speaker": "あさひ",
    "text": "……なんで羊を数えると眠れるんすか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020410"
  },
  {
    "id": 3018009020420,
    "speaker": "冬優子",
    "text": "はぁ……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020420"
  },
  {
    "id": 3018009020430,
    "speaker": "あさひ",
    "text": "数を数えるのがいいんすかね？\r\nそれなら羊じゃなくても──",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020430"
  },
  {
    "id": 3018009020440,
    "speaker": "冬優子",
    "text": "羊なのは数が増えても可愛いから！\r\nだんだんもふもふしてきたら寝たくもなるでしょ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020440"
  },
  {
    "id": 3018009020450,
    "speaker": "あさひ",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020450"
  },
  {
    "id": 3018009020460,
    "speaker": "冬優子",
    "text": "……じゃあ仮に、『ふゆがひとり、ふゆがふたり』って\r\n増えてったらどう思う？　眠れる？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020460"
  },
  {
    "id": 3018009020470,
    "speaker": "あさひ",
    "text": "眠れないっす！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020470"
  },
  {
    "id": 3018009020480,
    "speaker": "冬優子",
    "text": "そういうことよ、だから無害な羊なの\r\n──……って今のやりとりもムカつくけど……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020480"
  },
  {
    "id": 3018009020490,
    "speaker": "あさひ",
    "text": "……？\r\nあ、なんで数を数えるのかはわかってないっすよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020490"
  },
  {
    "id": 3018009020500,
    "speaker": "冬優子",
    "text": "うっさいわね……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020500"
  },
  {
    "id": 3018009020510,
    "speaker": "冬優子",
    "text": "じゃあそれはふゆが調べるから、\r\nあんたはもう数え始めてて！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020510"
  },
  {
    "id": 3018009020520,
    "speaker": "あさひ",
    "text": "はいっす\r\n……羊が１匹……羊が２匹……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020520"
  },
  {
    "id": 3018009020530,
    "speaker": "冬優子",
    "text": "……っとに……\r\nなんでふゆがこんな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301800902/3018009020530"
  },
