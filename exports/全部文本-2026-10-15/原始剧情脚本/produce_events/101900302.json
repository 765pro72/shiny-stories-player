  {
    "speaker": "愛依の友人",
    "text": "──愛依",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019003020190,
    "speaker": "愛依",
    "text": "おお、何なに～\r\nどしたん～？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "019",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/101900302/1019003020190"
  },
  {
    "speaker": "愛依の友人",
    "text": "愛依のツイスタ、見たよ\r\nオーディション番組、出るらしいね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019003020200,
    "speaker": "愛依",
    "text": "あ……、うん！\r\nそうなんだ！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020200"
  },
  {
    "speaker": "愛依の友人",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の友人",
    "text": "やっぱり愛依、無理してるように見える",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019003020210,
    "speaker": "愛依",
    "text": "え……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020210"
  },
  {
    "id": 1019003020220,
    "speaker": "愛依",
    "text": "いやいや、\r\nマジでそんなことないし──……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020220"
  },
  {
    "speaker": "愛依の友人",
    "text": "私たちと居る時の愛依のほうが、いい笑顔なのに",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019003020230,
    "speaker": "愛依",
    "text": "だから……\r\nそれは……！",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020230"
  },
  {
    "speaker": "愛依の友人",
    "text": "──そもそもこんなふうにオーディションで\r\n順位を付けられるの、嫌じゃないの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1019003020240,
    "speaker": "愛依",
    "text": "…………！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020240"
  },
  {
    "speaker": "愛依の友人",
    "text": "順位が上だったら嬉しい？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の友人",
    "text": "……それじゃあ、下だったら？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "愛依の友人",
