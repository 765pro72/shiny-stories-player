  },
  {
    "id": 1019003020030,
    "speaker": "愛依",
    "text": "……──はぁ～……！",
    "charAnim1": "sad2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "056",
    "voice": "produce_events/101900302/1019003020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依、どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大きい溜息が聞こえたけど……\r\n何かあったか？",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020040,
    "speaker": "愛依",
    "text": "アハハ～、違うって\r\nプロデューサー",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020040"
  },
  {
    "id": 1019003020050,
    "speaker": "愛依",
    "text": "なんていうか、\r\nほっと一息？　的な？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020050"
  },
  {
    "id": 1019003020060,
    "speaker": "愛依",
    "text": "いいカンジにクールなのが撮れたからさ～",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020070,
    "speaker": "愛依",
    "text": "この後今日の分のツイスタ\r\n更新しようと思って！",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020070"
  },
  {
    "id": 1019003020080,
    "speaker": "愛依",
    "text": "『G.R.A.D.』のPR\r\nしっかりやりたいし！",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、『G.R.A.D.』出場を発表してから\r\n更新、頑張ってるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依のSNSをフォローしてくれてる人、\r\nかなり増えたんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020090,
    "speaker": "愛依",
    "text": "そうなんだよね～！",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020090"
  },
  {
    "id": 1019003020100,
    "speaker": "愛依",
    "text": "やっぱ『G.R.A.D.』ってそんだけ\r\nすごいオーディションなんだね！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020100"
  },
  {
    "id": 1019003020110,
    "speaker": "愛依",
    "text": "うちのことも、ストレイライトのことも\r\n知ってもらうチャンスだし",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020110"
  },
  {
    "id": 1019003020120,
    "speaker": "愛依",
    "text": "頑張らないと！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "……もちろん番組効果もあると思うけどさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなが愛依に注目してくれてるのは\r\nたぶん、それだけじゃなくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依のプロモーション能力がどんどん上がっていって\r\n愛依の魅力をアピールできてるからだと思うよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020130,
    "speaker": "愛依",
    "text": "……！\r\nそう、かな……！",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、だから自信を持って\r\nこれからもこの調子でいこう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020140,
    "speaker": "愛依",
    "text": "うん！\r\nサンキュ！　プロデューサー",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020140"
  },
  {
    "id": 1019003020150,
    "speaker": "愛依",
    "text": "……きっと、冬優子ちゃんに色々\r\n教えてもらったおかげだね",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020160,
    "speaker": "愛依",
    "text": "あっ、この間あさひちゃんが撮ってくれた写真も\r\nちょーかっこよく撮れててさ",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020160"
  },
  {
    "id": 1019003020170,
    "speaker": "愛依",
    "text": "ファンのみんなにすっごい褒められたし！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003020180,
    "speaker": "愛依",
    "text": "やっぱふたりはすごいよね～……！",
    "charAnim1": "smile3",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900302/1019003020180"
  },
