[
  {
    "textFrame": "off",
    "bg": "00001",
    "bgm": "081"
  },
  {
    "id": 1001004010010,
    "speaker": "真乃",
    "text": "『ライブのお知らせ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010010"
  },
  {
    "id": 1001004010020,
    "speaker": "真乃",
    "text": "『この度、イルミネーションスターズで\r\nワンマンライブを開催できることになりました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010020"
  },
  {
    "id": 1001004010030,
    "speaker": "真乃",
    "text": "『応援してくださるファンのみなさんと\r\nいっぱいいっぱい楽しい時間をすごせたらなって思います』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010030"
  },
  {
    "id": 1001004010040,
    "speaker": "真乃",
    "text": "『#ライブ告知 #イルミネーションスターズ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010040"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "ツイスタでライブの告知か\r\nうん、投稿して問題ないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010050,
    "speaker": "真乃",
    "text": "……見ていただいてありがとうございます",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/100100401/1001004010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、真乃も\r\n告知しようって思ってくれてありがとう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "強制するつもりはないけど\r\nこういうのやっぱりファンは嬉しいものだからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ここ最近、真乃が積極的に投稿してくれてるの\r\nありがたいなって思ってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010060,
    "speaker": "真乃",
    "text": "ほわ……",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010060"
  },
  {
    "id": 1001004010070,
    "speaker": "真乃",
    "text": "あ、あんまり他のみなさんみたいに\r\nちゃんとできているか自信はないんですけれど……",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "十分だよ、フォロワーだって増えてきてるしさ\r\n真乃の思うように、真乃のペースで続けてくれたらいい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "他にも何か、真乃から話はあるか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010080,
    "speaker": "真乃",
    "text": "いえ……っ\r\n今日はこれだけです……っ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、ありがとう\r\nじゃあ、俺からもいいかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "真乃に仕事のことで相談があって",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010090,
    "speaker": "真乃",
    "text": "はい……っ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "動物バラエティ番組から\r\n真乃にオファーが来ているんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "飼育体験をしながら、\r\n生き物のリポートをするっていうコーナーで",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今回、花鳥園でのリポートを\r\n真乃にやってほしいって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010100,
    "speaker": "真乃",
    "text": "ほわぁ……花鳥園でリポート……",
    "charAnim1": "smile3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ワンマンライブも控えてて、レッスンだ打ち合わせだって\r\n立て込んでる中だけど、どうだろうか",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろん、ワンマンに集中する……\r\nという意味で今回は断ることもできる",
    "charAnim2": "face_wait",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも、もし真乃がやりたいって思うなら\r\n俺はサポートを惜しまないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad_s2",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1001004010110,
    "speaker": "真乃",
    "text": "……わ、私、その……\r\nやって、みたいです",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010110"
  },
  {
    "id": 1001004010120,
    "speaker": "真乃",
    "text": "……鳥さんとのお仕事なので\r\nやりたいなっていう気持ちも大きいんですけれど……",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010120"
  },
  {
    "id": 1001004010130,
    "speaker": "真乃",
    "text": "いろんなお仕事を通して\r\nファンのみなさんとちょっとでもつながれたら……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010130"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──よし、わかった\r\nじゃあ、受ける方向で返事をしておくよ",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0454"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "これからますます忙しくなるな\r\nスケジュール調整は任せてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "頑張ろうな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001004010140,
    "speaker": "真乃",
    "text": "……はい……っ\r\n精一杯、頑張ります……っ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010140"
  },
  {
    "id": 1001004010150,
    "speaker": "真乃",
    "text": "ワンマンライブも、リポートのお仕事も……っ\r\nだから……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010150"
  },
  {
    "charAnim2": "face_close",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1001004010160,
    "speaker": "真乃",
    "text": "だから、プロデューサーさん\r\n私のこと、見守っていてくれますか……？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100401/1001004010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\nもちろんだよ、真乃",
    "textCtrl": "p",
    "textFrame": "002"
  },
