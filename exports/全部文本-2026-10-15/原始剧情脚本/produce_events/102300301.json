  {
    "id": 1023003010020,
    "speaker": "雛菜",
    "text": "ほんとに修学旅行みたいだね～",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
