  },
  {
    "id": 1023003010160,
    "speaker": "雛菜",
    "text": "──あ、あそこじゃない？\r\n集合場所！",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/102300301/1023003010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお、ほんとだ\r\nスタッフさんたち、もう準備始めてるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023003010170,
    "speaker": "雛菜",
    "text": "あは～\r\nじゃあ雛菜たちも早く行かなきゃ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300301/1023003010170"
  },
  {
    "charAnim1": "wait",
    "charLabel": "hinana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0247",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、おい\r\n雛菜待ってくれ、走らなくても……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1023003010180,
    "speaker": "雛菜",
    "text": "プロデューサー！\r\nはやく～～～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102300301/1023003010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おう……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
