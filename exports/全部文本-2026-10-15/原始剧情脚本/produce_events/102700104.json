  {
    "speaker": "イベントスタッフ",
    "text": "──羽那ちゃん、美しいですよねぇ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "イベントスタッフ",
    "text": "見た目はもちろんなんですけど、\r\nそれだけじゃなくて──心が！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "──！",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "100",
    "se": "0454",
    "autoWaitTime": 800
  },
  {
    "speaker": "イベントスタッフ",
    "text": "リハーサルを拝見して、少しお話しただけですけど……\r\n素直で純粋な子なんだなって伝わってきます",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "──はは…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう……ですかね\r\n……ありがとうございます",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00465",
