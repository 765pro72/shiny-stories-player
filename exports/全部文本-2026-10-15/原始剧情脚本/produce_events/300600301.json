  },
  {
    "id": 3006003010400,
    "speaker": "咲耶",
    "text": "え……？\r\nどうしたんだい、急に",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
