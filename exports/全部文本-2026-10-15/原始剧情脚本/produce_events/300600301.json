  {
    "id": 3006003010070,
    "speaker": "結華",
    "text": "あれ？　さくやんも雨宿り？\r\n三峰も仲間に入れてー？",
    "charAnim1": "surp3",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
