      "type": "from",
      "x": 200,
      "alpha": 0,
      "time": 700
    },
    "voice": "produce_events/300600301/3006003010070"
  },
  {
    "id": 3006003010080,
    "speaker": "咲耶",
    "text": "結華じゃないか\r\nもちろんだよ。どうぞ、こちらへ",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010080"
  },
  {
    "id": 3006003010090,
    "speaker": "結華",
    "text": "やっぱり降ってきちゃったねー\r\n事務所に着くまでは大丈夫かと思ったんだけど",
    "charAnim1": "sad1",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010090"
  },
  {
    "id": 3006003010100,
    "speaker": "咲耶",
    "text": "服が濡れてしまっているよ\r\nこれで早めに拭いた方がいい",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010100"
  },
  {
    "id": 3006003010110,
    "speaker": "結華",
    "text": "わ、ありがとう！\r\nちょうどハンカチ忘れちゃってたから助かったよ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010110"
  },
  {
    "id": 3006003010120,
    "speaker": "結華",
    "text": "でもさくやんは？　……って全然濡れてないね",
    "charAnim1": "surp1",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010120"
  },
  {
    "id": 3006003010130,
    "speaker": "咲耶",
    "text": "ああ。雨が降り始めて、すぐここに来たからね\r\nハンカチを使うほどは濡れなかったのさ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010130"
  },
  {
    "id": 3006003010140,
    "speaker": "結華",
    "text": "そっかそっか、なら良かった！\r\n……でも、さくやんが雨宿りなんてちょっと意外かも",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010140"
  },
  {
    "id": 3006003010150,
    "speaker": "咲耶",
    "text": "フフ。どうしてそう思うんだい？",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010150"
  },
  {
    "id": 3006003010160,
    "speaker": "結華",
    "text": "だってさくやん、毎朝天気予報見て、\r\n傘とかちゃんと持って出そうなイメージだったし",
    "charAnim1": "wait4",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010160"
  },
  {
    "id": 3006003010170,
    "speaker": "咲耶",
    "text": "そうだね……\r\nまあ、イメージ通りじゃないことも、たまにはあるさ",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010170"
  },
  {
    "id": 3006003010180,
    "speaker": "結華",
    "text": "んー……？\r\n……おっけーおっけー、そういうことにしとこっか！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010180"
  },
  {
    "id": 3006003010190,
    "speaker": "結華",
    "text": "たまには、のんびり雨宿りもオツだもんね",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010190"
  },
  {
    "charAnim2": "blank",
    "charLabel": "yuika"
  },
  {
    "id": 3006003010200,
    "speaker": "咲耶",
    "text": "フフ、結華がそう言ってくれて嬉しいよ",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010200"
  },
  {
    "id": 3006003010210,
    "speaker": "咲耶",
    "text": "それに、こうやって雨宿りをしていると\r\nキミみたいな可愛い女の子に出会えることもあるから",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010210"
  },
  {
    "id": 3006003010220,
    "speaker": "結華",
    "text": "あはは、さくやんは上手いなぁ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010220"
  },
  {
    "id": 3006003010230,
    "speaker": "咲耶",
    "text": "クス。私は嘘をつかない主義だよ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010230"
  },
  {
    "id": 3006003010240,
    "speaker": "結華",
    "text": "やめてよー、王子に本気で来られたら\r\n三峰なんてすぐコロッといっちゃうよー",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010240"
  },
  {
    "id": 3006003010250,
    "speaker": "結華",
    "text": "雨よ！　早くあがってくださーい！\r\n三峰の心臓がもちませーん！",
    "charAnim1": "shy1",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010250"
  },
  {
    "id": 3006003010260,
    "speaker": "咲耶",
    "text": "フフ。この空模様では、まだまだ雨は止みそうにないよ？",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010260"
  },
  {
    "id": 3006003010270,
    "speaker": "結華",
    "text": "あちゃー、三峰大ピンチ？",
    "charAnim1": "anger2",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010270"
  },
  {
    "charAnim2": "blank",
    "charLabel": "sakuya"
  },
  {
    "id": 3006003010280,
    "speaker": "結華",
    "text": "……とかまぁ、冗談はさておき\r\n雨がやむまで、一緒にゆっくりしてこっか",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010280"
  },
  {
    "id": 3006003010290,
    "speaker": "結華",
    "text": "引き出し増やすために人間観察～とか、\r\nこういう時こそやってみてもいいかもだし！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600301/3006003010290"
  },
  {
    "id": 3006003010300,
    "speaker": "咲耶",
    "text": "ああ。そうだね\r\nこうしてのんびりできるのも、貴重なひとときだ",
    "charAnim2": "blank",
