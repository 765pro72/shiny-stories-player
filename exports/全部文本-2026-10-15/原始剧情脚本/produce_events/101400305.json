    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050340"
  },
  {
    "charAnim1": "wait",
    "charLabel": "amana",
    "textFrame": "off",
