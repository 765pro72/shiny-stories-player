  {
    "id": 1014003050150,
    "speaker": "甘奈",
    "text": "──プロデューサーさんに泣かされた日に",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050150"
  },
  {
    "speaker": "プロデューサー",
    "text": "！？\r\n泣かされたって、甘奈──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1014003050160,
    "speaker": "甘奈",
    "text": "えへへ、冗談だよー☆\r\n泣いたって言っても、安心して泣いたんだもん",
