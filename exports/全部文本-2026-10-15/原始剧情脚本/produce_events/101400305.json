    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050290"
  },
  {
    "id": 1014003050300,
    "speaker": "甘奈",
    "text": "『精一杯頑張ります』って言うだけじゃなくて……\r\n自信を持って、責任を持って、臨めるまで",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050300"
  },
  {
    "id": 1014003050310,
    "speaker": "甘奈",
    "text": "いい加減な感じじゃなくて、中途半端な感じじゃなくて──\r\nこれでいいのかなって、迷ったりしなくなるまで",
    "charAnim2": "face_close2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050310"
  },
  {
    "id": 1014003050320,
    "speaker": "甘奈",
    "text": "いつもよりもっともっと、頑張ったの",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050320"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ",
