    "charAnim1": "wait3",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_shy_s",
    "charLabel": "amana",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1014003050200,
    "speaker": "甘奈",
    "text": "そしたらね！\r\nあんなに避けてた死ぬ気が、急に眩しく見えて",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050200"
  },
  {
    "id": 1014003050210,
    "speaker": "甘奈",
    "text": "『ああ、ここが甘奈が死ぬ気で頑張るところなんだなぁ』\r\nって……思えちゃったの",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050210"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1014003050220,
    "speaker": "甘奈",
    "text": "甘奈は、甜花ちゃんと一緒にいたい\r\n千雪さんと一緒にいたい",
    "charAnim1": "shy1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050220"
  },
  {
    "id": 1014003050230,
    "speaker": "甘奈",
    "text": "……──プロデューサーさんと、一緒にいたい",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050230"
  },
  {
    "id": 1014003050240,
    "speaker": "甘奈",
    "text": "それを叶えるためには、アイドルでいなきゃいけない\r\n……それも、ただのアイドルじゃダメ",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050240"
  },
  {
    "id": 1014003050250,
    "speaker": "甘奈",
    "text": "どんどん進んでいく甜花ちゃんと、千雪さんに負けない──\r\n自分だけの魅力を持ったアイドルじゃなきゃいけない",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050250"
  },
  {
    "id": 1014003050260,
    "speaker": "甘奈",
    "text": "──『甘奈は、アルストロメリアでいたいから』",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050260"
  },
  {
    "id": 1014003050270,
    "speaker": "甘奈",
    "text": "甜花ちゃんと千雪さんに恥ずかしくないように、\r\n甘奈だけの得意分野を見付けるんだって",
    "charAnim1": "shy2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
