    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101400305/1014003050330"
  },
  {
    "id": 1014003050340,
    "speaker": "甘奈",
    "text": "──……それで、今、めーっちゃ緊張してるんだ\r\n話してないと落ち着かない",
