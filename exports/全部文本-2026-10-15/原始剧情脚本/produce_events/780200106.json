    "textFrame": "001",
    "voice": "produce_events/780200106/7802001060050"
  },
  {
    "id": 7802001060060,
    "speaker": "かな",
    "text": "頑張っても、上手くなっても、\r\nそれが必ずしも結果につながるわけじゃないのよね",
    "charAnim1": "wait3",
    "charAnim2": "face_sad2",
