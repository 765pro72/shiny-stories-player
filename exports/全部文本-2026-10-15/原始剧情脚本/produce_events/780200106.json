  },
  {
    "id": 7802001060050,
    "speaker": "かな",
    "text": "歌の実力は上がったはずなのに\r\n売り上げは下がる一方だったわ",
    "charAnim1": "smile2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_shy",
    "charLabel": "kana",
