    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301600201/3016002010120"
  },
  {
    "id": 3016002010130,
    "speaker": "千雪",
