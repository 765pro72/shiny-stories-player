  {
    "id": 1007005020110,
    "speaker": "結華",
    "text": "（いやー、別にいいでしょ）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020110"
  },
  {
    "id": 1007005020120,
    "speaker": "結華",
    "text": "（だってこんなチャンス、もう二度とないじゃん）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020120"
  },
  {
    "id": 1007005020130,
    "speaker": "結華",
    "text": "……本当にチャンスなわけ？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika2",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_fix",
    "charType": "characters",
    "charId": "007",
    "charPosition": {
      "x": 568,
