  {
    "id": 1007005020010,
    "speaker": "結華",
    "text": "……私が、アイドル……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020010"
  },
  {
    "id": 1007005020020,
    "speaker": "結華",
    "text": "いや、興味はめっちゃありますけど……\r\n……え？　ほんとに？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "本当です\r\n一緒にアイドル、目指してもらえませんか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1007005020030,
    "speaker": "結華",
    "text": "……そ、そこまで言ってもらえるなら……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020030"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1007005020040,
    "speaker": "結華",
    "text": "……三峰、結華です。これから、よろしくお願いします",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020040"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1007005020050,
    "speaker": "結華",
    "text": "──って、あ！\r\nいやちょっと今のは勢いで……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020050"
  },
  {
    "id": 1007005020060,
    "speaker": "結華",
    "text": "やりたい気持ちはめちゃめちゃあるんですけどっ\r\nできれば、詳細とか……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100700502/1007005020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろんです！\r\nご都合のいい時に改めて────",
    "textCtrl": "p",
    "textFrame": "002"
  },
