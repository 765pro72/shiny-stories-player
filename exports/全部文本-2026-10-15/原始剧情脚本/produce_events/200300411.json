      "time": 1000,
      "easing": "easeInQuart"
    }
  },
  {
    "waitType": "time",
    "waitTime": 750
  },
  {
    "id": 2003004110040,
    "speaker": "めぐる",
    "text": "……それでね、それでねっ！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110040"
  },
  {
    "id": 2003004110050,
    "speaker": "めぐる",
    "text": "学校で友だちと話してたら、\r\n休み時間が終わりそうになっちゃってね……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "（めぐるも楽しそうに話をしてるし、\r\n少しくらいなら付き合ってやるか）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110060,
    "speaker": "めぐる",
    "text": "あ、あとあと！\r\n事務所で聞いた話なんだけど……",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（少しくらいなら……）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110070,
    "speaker": "めぐる",
    "text": "こないだのお仕事で会った友だちから聞いた話だと、\r\nすっごく足が速いアイドルがいるらしくて……",
    "charAnim1": "anger2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "（少し……）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110080,
    "speaker": "めぐる",
    "text": "それでねっ……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "め、めぐる、ちょっといいか",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110090,
    "speaker": "めぐる",
    "text": "え？　どうしたの、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そろそろ仕事の話をだな……",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110100,
    "speaker": "めぐる",
    "text": "……あっ、そっか\r\nごめんね！",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、大丈夫だよ\r\nそれで新しい仕事なんだけど……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "effectLabel": "black1",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
