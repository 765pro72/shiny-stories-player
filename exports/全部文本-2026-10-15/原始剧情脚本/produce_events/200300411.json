  {
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "……って言う感じで進行していくんだ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110110,
    "speaker": "めぐる",
    "text": "うん、分かったよ！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110110"
  },
  {
    "id": 2003004110120,
    "speaker": "めぐる",
    "text": "……えへへ",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだ、急に笑い出したりして",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110130,
    "speaker": "めぐる",
    "text": "んー、えっとね",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110130"
  },
  {
    "id": 2003004110140,
    "speaker": "めぐる",
    "text": "こうやって、プロデューサーと話してるのが楽しくて！",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……おしゃべりが楽しいのもいいけど、\r\nもうめぐるも人気アイドルの一人なんだ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "応援してくれるファンのためにも、\r\n気を抜いちゃダメだぞ",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110150,
    "speaker": "めぐる",
    "text": "それはもちろんだよ！",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110150"
  },
  {
    "id": 2003004110160,
    "speaker": "めぐる",
    "text": "全力で応援してくれるみんなには\r\nわたしも全力で答えなきゃ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110160"
  },
  {
    "id": 2003004110170,
    "speaker": "めぐる",
    "text": "大好きなみんなのために、\r\nこれからもアイドルを全力で頑張るんだ！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110170"
  },
  {
    "id": 2003004110180,
    "speaker": "めぐる",
    "text": "……ね、プロデューサー",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110180"
  },
  {
    "id": 2003004110190,
    "speaker": "めぐる",
    "text": "わたしがアイドルを頑張れるのも、\r\nプロデューサーがいてくれるからなんだよ？",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110190"
  },
  {
    "id": 2003004110200,
    "speaker": "めぐる",
    "text": "だからね……",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110200"
  },
  {
    "id": 2003004110210,
    "speaker": "めぐる",
    "text": "これからもずーっと、わたしのそばにいてほしいな！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる……\r\nああ、もちろんだ！",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003004110220,
    "speaker": "めぐる",
    "text": "えへへー！　それじゃあ……",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_shy2",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0108",
    "voice": "produce_events/200300411/2003004110220"
  },
  {
    "id": 2003004110230,
    "speaker": "めぐる",
    "text": "指切りげんまん、だよっ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110230"
  },
  {
    "id": 2003004110240,
    "speaker": "めぐる",
    "text": "ゆーびきりげんまん、\r\n嘘ついたら針千本のーますっ",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200300411/2003004110240"
  },
  {
    "id": 2003004110250,
    "speaker": "めぐる",
    "text": "指切った！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
