    }
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "──あ、ほらあそこにいるの\r\n知り合いの番組ディレクターさんなんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "小糸、一緒に挨拶してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0403",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 1022003090050,
    "speaker": "小糸",
    "text": "あ、ちょっと……！\r\nま、待ってくださいプロデューサーさん……！",
