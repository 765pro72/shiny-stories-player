    "textFrame": "001",
    "voice": "produce_events/102200309/1022003090120"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、帰って\r\nこの次どうするか、考えようか",
    "textCtrl": "p",
    "textFrame": "002"
