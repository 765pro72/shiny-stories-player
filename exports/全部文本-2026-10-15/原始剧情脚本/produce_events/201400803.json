    "textFrame": "001",
    "voice": "produce_events/201400803/2014008030180"
  },
  {
    "id": 2014008030190,
    "speaker": "甘奈",
    "text": "なんと、甘奈の半分くらいの回数で取っちゃったんだよ～",
