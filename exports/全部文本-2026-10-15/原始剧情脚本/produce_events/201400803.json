    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400803/2014008030270"
  },
  {
    "id": 2014008030280,
    "speaker": "甘奈",
    "text": "どんなふうに話してたか、教えてほしいなっ！",
