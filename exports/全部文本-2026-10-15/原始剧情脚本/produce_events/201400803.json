  {
    "id": 2014008030100,
    "speaker": "甘奈",
    "text": "これ！　ふたりでゲームクリアした記念！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400803/2014008030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ、ふたりでゲームセンター行ったのか\r\n甘奈もゲームやるんだな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008030110,
    "speaker": "甘奈",
    "text": "うん！　けど、甘奈は上手じゃないから\r\nなかなか勝てなかったんだけど……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201400803/2014008030110"
  },
  {
    "id": 2014008030120,
    "speaker": "甘奈",
    "text": "この日は甜花ちゃんが考えてくれた作戦が決まって\r\n初めてふたりで勝つことができたんだ～！",
