    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008030140,
    "speaker": "甘奈",
    "text": "クレーンゲームで甜花ちゃんが取ってくれたんだよ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
