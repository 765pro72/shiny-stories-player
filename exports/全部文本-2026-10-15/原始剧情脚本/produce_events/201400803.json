    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400803/2014008030190"
  },
  {
    "id": 2014008030200,
    "speaker": "甘奈",
    "text": "それにね、集中してる時の甜花ちゃん\r\nめーっちゃかっこいいんだっ☆",
    "charAnim1": "shy1",
    "charAnim2": "face_joy",
    "charLipAnim": "lip_joy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400803/2014008030200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか……\r\n俺も、クレーンゲームしてる甜花、見たかったな",
    "charLipAnim": "lip_smile_s",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
