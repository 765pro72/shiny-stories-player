    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200500901/2005009010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "まあ、確かに\r\n摩美々は寒いの苦手だもんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2005009010110,
