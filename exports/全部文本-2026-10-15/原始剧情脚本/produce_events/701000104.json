  {
    "id": 7010001040010,
    "speaker": "智代子",
    "text": "落ちちゃったんですね……",
    "charAnim1": "sad2",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040010"
  },
  {
    "speaker": "プロデューサー",
    "text": "あぁ……残念だけど……",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7010001040020,
    "speaker": "智代子",
    "text": "……プロデューサーさん",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040020"
  },
  {
    "id": 7010001040030,
    "speaker": "智代子",
    "text": "テレビ収録の時、\r\nもっと上手にお話できてたら良かったんでしょうか……？",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040030"
  },
  {
    "id": 7010001040040,
    "speaker": "智代子",
    "text": "雑誌の写真撮影の時だって、\r\nいろんなポーズを研究できたかもしれないし……！",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charLipAnim": "lip_sad",
    "charAnim3Loop": false,
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040040"
  },
  {
    "id": 7010001040050,
    "speaker": "智代子",
    "text": "あとっ、ラジオやイベントでも、みんながもっと\r\n気持ちよく喋れるように、何かできてたかもしれません！",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040050"
  },
  {
    "id": 7010001040060,
    "speaker": "智代子",
    "text": "そうやって、もっと、頑張れていれば……\r\n結果、変わってたでしょうか……？",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/701000104/7010001040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……そうか、自分なりに改善点を探ろうとしているのか\r\n前向きな気持ちで良かった）",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──たしかに、やれることはまだたくさんある\r\n次はどうすればいいか、これから一緒に考えよう",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7010001040070,
    "speaker": "智代子",
    "text": "……はい！　よろしくお願いします！",
