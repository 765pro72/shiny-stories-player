    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2028006010120,
    "speaker": "はるき",
    "text": "──え？　制作……ですか？",
    "charAnim1": "wait4",
    "charLipAnim": "lip_surp",
    "charLabel": "haruki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202800601/2028006010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなんだ。はるきが今までいろいろやってきたこととか\r\n学校で美術を学んでいることとか知ってくれててな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もちろんプロの監督さんがついてくれるけど\r\n企画から参加してみないかって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2028006010130,
    "speaker": "はるき",
    "text": "すごい……！\r\nぜひやりたいです～！",
    "charAnim1": "smile1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "haruki",
    "textCtrl": "p",
    "textFrame": "001",
