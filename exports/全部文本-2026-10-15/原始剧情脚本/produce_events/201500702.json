    "textFrame": "001",
    "voice": "produce_events/201500702/2015007020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ああ……待たせてごめんな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015007020060,
    "speaker": "甜花",
    "text": "ううん……\r\nココア……甘くて、美味しかった……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500702/2015007020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それならよかった\r\n……そういえば、さっき……何か見てたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2015007020070,
    "speaker": "甜花",
    "text": "な、何……って……\r\nえっと、えっと……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201500702/2015007020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　どうしたんだ？",
