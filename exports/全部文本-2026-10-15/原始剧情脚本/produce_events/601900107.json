    "charLabel": "hazuki",
    "textCtrl": "p",
    "textFrame": "003",
    "voice": "produce_events/601900107/6901001070010"
  },
  {
    "id": 6901001070020,
    "speaker": "はづき",
    "text": "もし違う言葉が出てきたら、\r\n説教してやるって言って聞かなかったのに",
