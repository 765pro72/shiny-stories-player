  {
    "id": 2007009020270,
    "label": "1",
    "speaker": "結華",
    "text": "おまんじゅう……",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700902/2007009020270"
  },
  {
    "speaker": "プロデューサー",
    "text": "部屋に置いてあったやつ、美味しかったからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009020280,
    "speaker": "結華",
    "text": "──それは確かに！　三峰も思った！\r\n……えへへ、ありがとうプロデューサー",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700902/2007009020280"
  },
  {
    "id": 2007009020290,
    "speaker": "結華",
    "text": "お菓子のチョイスも、心意気も\r\n結構グッときましたよ？",
    "charAnim1": "wink",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700902/2007009020290"
  },
  {
    "textFrame": "off",
    "nextLabel": "end"
  },
  {
    "textFrame": "off"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "甘いものはありそうかなと思って……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2007009020300,
    "speaker": "結華",
    "text": "お～っ……！\r\nさすがの察し力……！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700902/2007009020300"
  },
  {
    "id": 2007009020310,
    "speaker": "結華",
    "text": "ありがたく頂戴します！\r\n絶対みんな喜ぶよ～！",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200700902/2007009020310"
  },
  {
    "id": 2007009020320,
    "speaker": "結華",
    "text": "──当然、三峰もですが\r\nふふっ、ありがとね！",
    "charAnim1": "wink",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
