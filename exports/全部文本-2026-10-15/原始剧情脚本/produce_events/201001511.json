    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201001511/2010015110280"
  },
  {
    "id": 2010015110290,
    "speaker": "智代子",
    "text": "こんな最高の日が終わっちゃうなんてもったいなくて、\r\nまだまだ足りないなぁとも思います……！",
