    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "se": "2393",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "マネージャー",
    "text": "うちでは美琴を……\r\nアイドルにしてあげられなかった……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
