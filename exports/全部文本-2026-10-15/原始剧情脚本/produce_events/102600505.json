  },
  {
    "id": 1026005050020,
    "speaker": "ルカ",
    "text": "しばらくの間だけだって……ッ……\r\n終わったらユニットでやれるって、約束──……っ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102600505/1026005050020"
  },
  {
    "speaker": "マネージャー",
    "text": "ごめんなさい……！",
