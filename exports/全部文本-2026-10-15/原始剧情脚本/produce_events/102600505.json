    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 1000
  },
  {
    "id": 1026005050030,
    "speaker": "ルカ",
    "text": "はァ……！？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102600505/1026005050030"
  },
  {
    "id": 1026005050040,
    "speaker": "ルカ",
