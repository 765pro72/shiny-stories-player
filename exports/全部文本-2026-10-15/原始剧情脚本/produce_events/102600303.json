    "waitTime": 1000
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『そんな、奪われるつらさがわかるあの子だからこそ\r\n私から何かを奪っていたんじゃないかって考えて……っ』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『──────っ………………\r\nごめんなさい…………』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "……すみません\r\nつらいことをお聞きしてしまって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『いえ……！　そうじゃないんです\r\nつらいのはあの子だから……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
