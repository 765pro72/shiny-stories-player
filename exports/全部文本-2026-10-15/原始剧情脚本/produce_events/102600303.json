  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『…………私はルカに何かを奪われたとは思っていません』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『でもあの子はそうは思っていない──……思えない\r\n優しくて、傷つきやすくて……自分に厳しい子なんです』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "ルカの元マネージャー",
    "text": "『………………自分のこと責めてるのかな……──\r\nごめんねルカ──違うの……』",
