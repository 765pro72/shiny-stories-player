  {
    "id": 2022013010190,
    "speaker": "小糸",
    "text": "（……流行が終わって、\r\n周りの人がそれを忘れちゃったとして）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201301/2022013010190"
  },
  {
    "id": 2022013010200,
    "speaker": "小糸",
    "text": "（それでも、自分がいいなと思ったものは\r\n持ち続けたいけど）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201301/2022013010200"
  },
  {
    "id": 2022013010210,
    "speaker": "小糸",
    "text": "（古いって言われちゃうことも、あるのかな……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201301/2022013010210"
  },
