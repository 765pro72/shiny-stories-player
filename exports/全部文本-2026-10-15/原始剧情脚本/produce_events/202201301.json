    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "新しいと感じたものはあるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022013010080,
    "speaker": "小糸",
    "text": "……え？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
