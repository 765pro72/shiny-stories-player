  },
  {
    "id": 2025007110100,
    "speaker": "美琴",
    "text": "あ……、そっか\r\n今日だったよね",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
