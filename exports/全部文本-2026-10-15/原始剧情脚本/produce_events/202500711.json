    "voice": "produce_events/202500711/2025007110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025007110210,
    "speaker": "美琴",
    "text": "『撮影の後、言っていたでしょ？\r\nただの悪い奴って訳じゃなくて……って』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……ああ\r\n確かに、言ったような……",
