  {
    "id": 2025007110150,
    "speaker": "美琴",
    "text": "『え……？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "この役のこと\r\nどう表現しようって考えてたのかなって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025007110160,
    "speaker": "美琴",
    "text": "『…………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110160"
  },
  {
    "id": 2025007110170,
    "speaker": "美琴",
    "text": "『……どうだろう\r\nあまり……よくわからなくて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110170"
  },
  {
    "id": 2025007110180,
    "speaker": "美琴",
    "text": "『役の……その人が\r\nどういう気持ちなのかとか、どういう人なのかとか』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110180"
  },
  {
    "id": 2025007110190,
    "speaker": "美琴",
    "text": "『……わからなくて』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "………………",
