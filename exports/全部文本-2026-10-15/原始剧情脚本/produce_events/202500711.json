      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202500711/2025007110100"
  },
  {
    "id": 2025007110110,
    "speaker": "美琴",
    "text": "まだ見れていなくて……\r\n今、タクシーなの",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110110"
  },
  {
    "id": 2025007110120,
    "speaker": "美琴",
    "text": "後でチェックするつもり",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "『そうか』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『……美琴、気にしてたみたいだからさ\r\nドラマの演技のこと』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025007110130,
    "speaker": "美琴",
    "text": "……それで、わざわざ連絡してくれたの？",
    "charAnim1": "think2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202500711/2025007110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ああ、うん』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『放送を見て、\r\nやっぱり良かったと思ったから』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『すごく印象に残る役になってたよ\r\n……それを、伝えておこうと思って』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2025007110140,
