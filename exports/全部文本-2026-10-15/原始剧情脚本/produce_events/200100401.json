      "order": 0
    },
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわ……\r\nプロデューサーさん？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200100401/2001004010010"
  },
  {
