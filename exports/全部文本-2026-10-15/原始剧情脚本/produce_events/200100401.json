    "waitTime": 1500,
    "se": "0097"
  },
  {
    "id": 2001004010020,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "あっ！\r\nもしかして、もうレッスンの時間ですか！？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100401/2001004010020"
  },
  {
    "id": 2001004010030,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "すみません\r\n鳩さんたちと遊ぶのに夢中になって……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100401/2001004010030"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "時間はまだ大丈夫だよ\r\n驚かせてごめんな",
    "textCtrl": "p"
  },
  {
    "id": 2001004010040,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "まだ大丈夫ですか\r\nほわ～よかったですっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010040"
  },
  {
    "id": 2001004010050,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "私、ぼんやりしているので\r\n気をつけないと本当に夢中になってしまうんです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100401/2001004010050"
  },
  {
    "id": 2001004010060,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "しっかりしないといけません\r\nむんっ！",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100401/2001004010060"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "お、そう言ってる間にも\r\n真乃の周りに……",
    "textCtrl": "p",
    "se": "0098"
  },
  {
    "id": 2001004010070,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわわ……\r\n鳩さんがいっぱい……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_trouble",
    "se": "0095",
    "voice": "produce_events/200100401/2001004010070"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "すごいな\r\n真乃がいるだけで、鳩が集まってくる",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "本当に鳥に好かれてるんだな",
    "textCtrl": "p"
  },
  {
    "id": 2001004010080,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はい、鳩さんとは仲良しで、\r\nつい時間を忘れて遊んでしまうんです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010080"
  },
  {
    "id": 2001004010090,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "でも、それをプロデューサーさんに見られるなんて……\r\nほわわわ……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "voice": "produce_events/200100401/2001004010090"
  },
  {
    "id": 2001004010100,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "あの……鳩さんたち、もう行くね\r\n明日も来るからまた遊ぼう？",
    "charLabel": "mano",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010100"
  },
  {
    "textFrame": "off",
    "charLabel": "mano",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "waitType": "effect",
    "bgEffect": "fade",
    "bg": "00003"
  },
  {
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charLabel": "mano",
    "charAnim1": "wait",
    "charAnim2": "face_shy",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 2001004010110,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわ……なんというか……\r\nさっきはお恥ずかしいところをお見せして……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100401/2001004010110"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "鳩のこと？\r\n別に恥ずかしいことはないと思うけど",
    "textCtrl": "p"
  },
  {
    "id": 2001004010120,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "鳩さんとのんびりお話して\r\n一緒にいるのはすごく楽しいんです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010120"
  },
  {
    "id": 2001004010130,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "でも、人から見ると\r\nのんびりしすぎに見えるかも……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100401/2001004010130"
  },
  {
    "id": 2001004010140,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "私、昔から抜けているというか……\r\nほわほわしているってよく言われるんです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/200100401/2001004010140"
  },
  {
    "id": 2001004010150,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "そんな私を変えたくて……\r\nアイドルになりました",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100401/2001004010150"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "……アイドルって、どういう仕事かわかるかな？",
    "textCtrl": "p"
  },
  {
    "id": 2001004010160,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわ？\r\n歌って踊って……？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/200100401/2001004010160"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "それから誰かに好かれるんだ\r\n俺はたった今、真乃が好かれてる光景を見たよ",
    "textCtrl": "p"
  },
  {
    "id": 2001004010170,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "鳩さん……に、ですか？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010170"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "うん、アイドルの素質十分だ",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "きっと君なら好きな自分になれるよ",
    "textCtrl": "p"
  },
  {
    "id": 2001004010180,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ありがとうございます\r\nそう言ってもらえると、うれしいですっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "hello",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010180"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "これから一緒に頑張ろう\r\n俺もしっかりプロデュースするからな",
    "textCtrl": "p"
  },
  {
    "id": 2001004010190,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はいっ\r\nじゃあ、そろそろレッスンの時間ですよね？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010190"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "えっ……あ、本当だ！\r\n俺が忘れてどうする！？"
  },
  {
    "id": 2001004010200,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "今日もレッスン、頑張りますね\r\nむんっ！",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/200100401/2001004010200"
  },
  {
    "label": "end"
  }
]