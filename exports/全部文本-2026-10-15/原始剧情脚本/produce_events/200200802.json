  },
  {
    "speaker": "プロデューサー",
    "text": "……やる気だな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008020210,
    "speaker": "灯織",
    "text": "ふふ……はい\r\nこのお仕事、いつも以上に頑張りたいんです",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200802/2002008020210"
  },
  {
    "id": 2002008020220,
    "speaker": "灯織",
    "text": "落ちてリタイアは絶対したくないですし、\r\nちゃんと攻略して、勝ちたいです……！",
