    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200802/2002008020190"
  },
  {
    "id": 2002008020200,
    "speaker": "灯織",
    "text": "でも、難しいほうが燃えます\r\n体幹が向上しているのも実感できましたし",
