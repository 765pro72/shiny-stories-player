    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200200802/2002008020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、すまん……\r\n周りのスタッフさんたちがぎょっとしてた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002008020140,
    "speaker": "灯織",
    "text": "……想像つきます\r\n遠くからも大きな声だなって思ったくらいですから",
