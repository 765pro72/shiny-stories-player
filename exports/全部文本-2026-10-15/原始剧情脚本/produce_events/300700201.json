  {
    "id": 3007002010190,
    "speaker": "結華",
    "text": "あらこがたん！　おはよう",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010190"
  },
  {
    "id": 3007002010200,
    "speaker": "摩美々",
    "text": "おはよー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010200"
  },
  {
    "id": 3007002010210,
    "speaker": "恋鐘",
    "text": "んふふー、ふたりと会えて嬉しかねぇ\r\n遠くからでも、結華と摩美々はすぐわかるったい！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010210"
  },
  {
    "id": 3007002010220,
    "speaker": "恋鐘",
    "text": "なんば言っても目立つけんね！\r\nそん個性的な服のおかげで、すぐ見つけられると！",
    "charAnim1": "smile4",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010220"
  },
  {
    "id": 3007002010230,
    "speaker": "恋鐘",
    "text": "オシャレさんには敵わんばい！",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010230"
  },
  {
    "charAnim1": "wait2",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "off"
  },
  {
    "charAnim1": "wait1",
