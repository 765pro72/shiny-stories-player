    "textFrame": "off"
  },
  {
    "id": 3007002010231,
    "speaker": "結華＆摩美々",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010231"
  },
  {
    "id": 3007002010240,
    "speaker": "結華",
    "text": "……っ、ふふ、あはは！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010240"
  },
  {
    "id": 3007002010250,
    "speaker": "摩美々",
    "text": "ふふ……",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010250"
  },
  {
    "id": 3007002010260,
    "speaker": "恋鐘",
    "text": "な、なんで笑いよると！？\r\nうち、なんか変なことば言うた！？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010260"
  },
  {
    "id": 3007002010270,
    "speaker": "結華",
    "text": "や、違うの違うの！　ごめんねこがたん",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010270"
  },
  {
    "id": 3007002010280,
    "speaker": "結華",
    "text": "みーんな同じこと思ってるんだなって思って！\r\nさっき三峰も、まみみんに同じこと言ったんだよね",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010280"
  },
  {
    "id": 3007002010290,
    "speaker": "摩美々",
    "text": "三峰もそうでしょって言おうとしてたのにー、\r\n恋鐘に取られちゃったからぁ、おかしくってー",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010290"
  },
  {
    "id": 3007002010300,
    "speaker": "恋鐘",
    "text": "ああ！　そがんことやったとね！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010300"
  },
  {
    "id": 3007002010310,
    "speaker": "恋鐘",
    "text": "んふふ、ということは、\r\nうちらアンティーカは一心同体ってことばい！？",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010310"
  },
  {
    "id": 3007002010320,
    "speaker": "結華",
    "text": "出た！　こがたんお得意の絆理論！\r\n……でも多分そういうこと！　かな！",
    "charAnim1": "shy1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010320"
  },
  {
    "id": 3007002010330,
    "speaker": "摩美々",
    "text": "えー……？　ふたりと一心同体なのは疲れそう―\r\n私は遠慮しときまぁす",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010330"
  },
  {
    "id": 3007002010340,
    "speaker": "恋鐘",
    "text": "そう言わんと！　摩美々も仲間に入るとよ！",
    "charAnim1": "anger1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010340"
  },
  {
    "id": 3007002010350,
    "speaker": "結華",
    "text": "そうそう！　一心同体の３人で仲良く事務所行こ？",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700201/3007002010350"
  },
  {
    "id": 3007002010360,
    "speaker": "摩美々",
    "text": "あーちょっと、引っ張らないでー……\r\n仲間でもなんでもいいから放してー……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
