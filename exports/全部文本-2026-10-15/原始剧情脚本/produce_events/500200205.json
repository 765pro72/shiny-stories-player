  {
    "id": 5002002050621,
    "speaker": "一同",
    "text": "…………！",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/500200205/5002002050621"
  },
  {
    "select": "みんなで\r\n支えあえるように",
    "nextLabel": "1"
  },
  {
    "select": "『仲間』に\r\nなれると思った",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "直感では\r\nあったけど……",
    "nextLabel": "3"
  },
  {
    "text": "★選択肢①【みんなで\r\n支えあえるように】",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなで支えあえるように",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "考えていることや、見えているものが、\r\nそれぞれ違っていたとしても",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お互いを信じて、\r\n────運命を切り開いていける",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "恋鐘、摩美々、咲耶、結華、霧子\r\nみんなを見て……そう感じたからなんだよ",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "branch"
  },
  {
    "text": "★選択肢②【『仲間』に\r\nなれると思った】",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "『仲間』になれると思った",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "がむしゃらに力を合わせることよりも\r\nお互いを信じて、背中を預けることの方が難しい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "でも……恋鐘、摩美々、咲耶、結華、霧子\r\nみんなはそれぞれ違った優しさや勇気を持っていたから……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この５人ならそれができる\r\nどんな荒波も乗り越えていける……そう思ったんだよ",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "branch"
  },
  {
    "text": "★選択肢③【直感では\r\nあったけど……】",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "直感ではあったけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "みんなを見ていると\r\n運命だったんじゃないかって気もするんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "実際、一生出会わなかったかもしれない５人が\r\nひとつの場所にいるって奇跡的なことじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "きっとみんなは──\r\n仲間になるべくしてなったんだ",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "branch"
  },
  {
    "id": 5002002050622,
    "label": "branch",
    "speaker": "一同",
    "text": "……………っ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/500200205/5002002050622"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから……アンティーカは\r\nここにいるみんなのための居場所なんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そのことを……忘れずに覚えていてほしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
