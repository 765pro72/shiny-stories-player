  {
    "id": 2022013040250,
    "speaker": "小糸",
    "text": "声、かけても逃げないんだ……\r\n本当に慣れてるんだね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201304/2022013040250"
  },
  {
    "id": 2022013040260,
    "speaker": "小糸",
    "text": "……あの、今日来たばっかりのわたしが言うのは\r\nちょっと変かも、だけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201304/2022013040260"
  },
  {
    "id": 2022013040270,
    "speaker": "小糸",
    "text": "みんなにとっても、ここがお家なら――",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202201304/2022013040270"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 2022013040280,
