  {
    "id": 2022013040010,
    "speaker": "小糸",
    "text": "…………！",
    "charAnim1": "smile1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile_s",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040220090",
    "charPosition": {
