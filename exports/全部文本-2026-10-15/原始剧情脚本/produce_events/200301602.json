    },
    "voice": "produce_events/200301602/2003016020010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！\r\nめぐる……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020020,
    "speaker": "めぐる",
    "text": "おはよう！　偶然だね！",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "044",
    "voice": "produce_events/200301602/2003016020020"
  },
  {
    "id": 2003016020030,
    "speaker": "めぐる",
    "text": "今日は外回りなの？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "おはようめぐる……！\r\nびっくりした……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は外回りだよ\r\nめぐるは……これから学校か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020040,
    "speaker": "めぐる",
    "text": "うん！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "平日の朝だもんなぁ\r\nお疲れ様",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "しかし、偶然にしてもすごくないか？\r\n同じ時間に乗るのはもちろん、車両も10以上あるのに",
    "charAnim2": "face_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020050,
    "speaker": "めぐる",
    "text": "えへへっ、本当にね！\r\nでも、実はね……？",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020050"
  },
  {
    "id": 2003016020060,
    "speaker": "めぐる",
    "text": "プロデューサーがいる！　と思って\r\nさっきの駅でちょっとだけ移動してきました……！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか\r\nめぐる、見つけるの上手いなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020070,
    "speaker": "めぐる",
    "text": "プロデューサー、身長高めだしね",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020070"
  },
  {
    "id": 2003016020080,
    "speaker": "めぐる",
    "text": "あとやっぱり、見知った人に目が行きやすい！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020080"
  },
  {
    "id": 2003016020090,
    "speaker": "めぐる",
    "text": "ライブとかイベントでも、\r\nいつも来てくれる人はすぐ見つけるし……！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "認識……なんだろう、\r\n解像度の高さみたいな感じなのかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっとわかる気がするよ\r\n俺も顔がわかるファンの人いるしな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020100,
    "speaker": "めぐる",
    "text": "でしょでしょ？",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020100"
  },
  {
    "id": 2003016020110,
    "speaker": "めぐる",
    "text": "真乃と灯織と待ち合わせする時も\r\nふたりのことならすぐ見つける自信あるよ！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301602/2003016020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "それはなかなかだな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003016020120,
    "speaker": "めぐる",
    "text": "えへへっ",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
