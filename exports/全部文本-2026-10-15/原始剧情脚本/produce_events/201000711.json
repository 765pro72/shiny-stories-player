    "charAnim2": "face_anger3",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000711/2010007110190"
  },
  {
    "id": 2010007110200,
