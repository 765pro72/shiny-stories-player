    "bgm": "010",
    "voice": "produce_events/201000711/2010007110060"
  },
  {
    "id": 2010007110070,
    "speaker": "智代子",
    "text": "え、えっと──これは、違うんです……！\r\nどうしても衝動を抑えられなかったと言いますか……！",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
