  },
  {
    "id": 2010007110220,
    "speaker": "智代子",
    "text": "……やっぱり、ちょっとおかしいですかね……？",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000711/2010007110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "──いや！\r\nなるほどな",
