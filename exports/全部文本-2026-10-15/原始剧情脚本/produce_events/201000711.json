    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000711/2010007110200"
  },
  {
    "id": 2010007110210,
    "speaker": "智代子",
    "text": "だから、トリート・アンド・トリート、って……\r\n言ってみたんですが……",
