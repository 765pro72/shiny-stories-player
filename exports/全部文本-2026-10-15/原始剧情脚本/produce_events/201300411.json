    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110220"
  },
  {
    "id": 2013004110230,
    "speaker": "夏葉",
    "text": "でも……アナタにはわがままを言って良いのね",
