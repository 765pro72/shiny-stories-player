    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "わ、わがままとは言ってないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110240,
    "speaker": "夏葉",
    "text": "あら、なんでもってそういう意味でしょ？\r\nせっかくだから叶えてもらうことにしましょう",
