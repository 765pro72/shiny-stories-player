  {
    "id": 2013004110020,
    "speaker": "夏葉",
    "text": "気付かなかったわ\r\nいつからいたの？",
    "charAnim1": "shy1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
