    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110190"
  },
  {
    "id": 2013004110200,
    "speaker": "夏葉",
    "text": "これからもずっと『今』が続くように\r\n私はもっともっと高みを目指さなくちゃ！",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110200"
  },
  {
    "id": 2013004110210,
    "speaker": "夏葉",
    "text": "海に来るのは、その決意表明なのよ！！",
