    "voice": "produce_events/201300411/2013004110020"
  },
  {
    "id": 2013004110030,
    "speaker": "夏葉",
    "text": "声をかけてくれたら良かったのに！",
    "charAnim2": "face_smile2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……\r\n珍しく真剣な顔に見えたからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110040,
    "speaker": "夏葉",
    "text": "珍しいだなんて失礼ね！\r\n私はいつだって大真面目よ！",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "すまんすまん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110050,
    "speaker": "夏葉",
    "text": "もう戻らないといけない時間かしら？",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫、少し様子を見に来ただけだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110060,
    "speaker": "夏葉",
    "text": "そう",
    "charAnim2": "face_serious",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110060"
  },
  {
    "id": 2013004110070,
    "speaker": "夏葉",
    "text": "ごめんなさいね\r\n急に車を回してもらって",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、これくらいはいつでも言ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110080,
    "speaker": "夏葉",
    "text": "ありがとう……",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110080"
  },
  {
    "id": 2013004110090,
    "speaker": "夏葉",
    "text": "私ね、海が好きなの",
    "charAnim1": "shy1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110090"
  },
  {
    "id": 2013004110100,
    "speaker": "夏葉",
    "text": "世界につながっているじゃない？",
    "charAnim2": "face_smile1",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110100"
  },
  {
    "id": 2013004110110,
    "speaker": "夏葉",
    "text": "未来が広がっている気がして……\r\nたまに見たくてたまらなくなるの",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110110"
  },
  {
    "id": 2013004110120,
    "speaker": "夏葉",
    "text": "私はここからどこにでも行ける──……",
    "charAnim1": "surp1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110120"
  },
  {
    "id": 2013004110130,
    "speaker": "夏葉",
    "text": "そう信じたくて……",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……何か俺にできることはないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110140,
    "speaker": "夏葉",
    "text": "え？",
    "charAnim1": "smile2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "困っていることがあるなら、\r\nなんでも言ってくれて良いんだからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004110150,
    "speaker": "夏葉",
    "text": "うふふっ……！",
    "charAnim1": "sad1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110150"
  },
  {
    "id": 2013004110160,
    "speaker": "夏葉",
    "text": "やだ、心配させちゃったかしら！\r\n私らしくなかった？",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110160"
  },
  {
    "id": 2013004110170,
    "speaker": "夏葉",
    "text": "大丈夫、いまのところ困ってないわ\r\nアナタがそばにいてくれているんだから",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110170"
  },
  {
    "id": 2013004110180,
    "speaker": "夏葉",
    "text": "……目の前に夢があって、\r\n大好きな仲間もファンのみんなもいてくれて",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300411/2013004110180"
  },
  {
    "id": 2013004110190,
    "speaker": "夏葉",
    "text": "今の私には幸せしかないもの",
