    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010240"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……\r\nそうなのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013010250,
    "speaker": "夏葉",
    "text": "ええ！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010250"
  },
  {
    "id": 2013013010260,
    "speaker": "夏葉",
    "text": "そうしたらきっと私の準備も\r\n無駄にはならないはずだから",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010260"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile_s",
    "charLabel": "natsuha",
    "textFrame": "off",
    "nextLabel": "end",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "お世話になってる人に\r\n感謝を伝えるチャンスでもあるし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013010270,
    "speaker": "夏葉",
    "text": "ええ、その通りよ！",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010270"
  },
  {
    "id": 2013013010280,
    "speaker": "夏葉",
    "text": "今は恋人同士に限らず\r\n職場や友人同士でチョコレートを渡すことも多いし",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010280"
  },
  {
    "id": 2013013010290,
    "speaker": "夏葉",
    "text": "渡すものも、チョコレートには\r\n限らないものね",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010290"
  },
  {
    "id": 2013013010300,
    "speaker": "夏葉",
    "text": "だからこそ、何を渡すか\r\n迷ってしまうけれど……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010300"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\n……夏葉だったらどんな物を貰ったら嬉しいかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013010310,
    "speaker": "夏葉",
    "text": "……そうね",
    "charAnim1": "think",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010310"
  },
  {
    "id": 2013013010320,
    "speaker": "夏葉",
    "text": "それがわかったら、私自身\r\n何をあげたらいいか、迷ったりしないかもしれないわね",
