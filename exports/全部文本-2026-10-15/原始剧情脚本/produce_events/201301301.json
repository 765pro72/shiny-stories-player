    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301301/2013013010220"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、\r\nそういう訳では無いんだけど……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013013010230,
    "speaker": "夏葉",
    "text": "まあ、でも……そうね",
