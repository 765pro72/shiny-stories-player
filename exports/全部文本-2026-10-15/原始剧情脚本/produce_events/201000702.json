    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000702/2010007020300"
  },
  {
    "id": 2010007020310,
    "speaker": "智代子",
    "text": "ありがとうございます……\r\nすみません、ご心配をおかけしまして……",
