    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201000702/2010007020290"
  },
  {
    "speaker": "プロデューサー",
    "text": "……すまん\r\nちょっと気になって様子を見に……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "気にしすぎてるんじゃ\r\nないかって",
    "nextLabel": "1"
  },
  {
    "select": "頑張りすぎは\r\nよくないぞ",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "……答えは\r\n見つかりそうか？",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "この間のこと、さ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2010007020300,
    "speaker": "智代子",
    "text": "えへへ……",
