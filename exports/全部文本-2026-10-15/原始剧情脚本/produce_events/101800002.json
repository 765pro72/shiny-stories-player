    "voice": "produce_events/101800002/1018001010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "（やっぱり、笑顔が可愛らしい子だ\r\nでも……今、一瞬見せた顔は……）",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018001010210,
