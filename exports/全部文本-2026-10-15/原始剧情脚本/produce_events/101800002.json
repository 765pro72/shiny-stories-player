  {
    "speaker": "プロデューサー",
    "text": "（うーん……『スカウトしてこい』って、\r\n色んなところを見て回ってるけど……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（あんまりピンと来る子がいないな……\r\n今日はいったん引き上げ……ん？）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018001010010,
    "speaker": "？？？",
    "text": "…………",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charAnim3": "mask_on",
    "charAnim4": "eye_right",
    "charLabel": "fuyuko",
