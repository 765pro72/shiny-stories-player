    "charLabel": "meguru",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "voice": "produce_events/300100202/3001002020090"
  },
  {
    "id": 3001002020100,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "お散歩が好きだから、あちこち見て回るの",
