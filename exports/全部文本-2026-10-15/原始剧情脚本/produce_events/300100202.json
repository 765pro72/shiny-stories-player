    "voice": "produce_events/300100202/3001002020010"
  },
  {
    "id": 3001002020020,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "うん、私もめぐるちゃんが誘ってくれて、うれしいっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/300100202/3001002020020"
  },
  {
    "id": 3001002020030,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "さーって、真乃\r\nどこへ行こうかー？",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/300100202/3001002020030"
  },
  {
    "id": 3001002020040,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "めぐるちゃんは\r\nどこか見たいお店とかある？",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/300100202/3001002020040"
  },
  {
    "id": 3001002020050,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "そうだな～、雑貨屋さんとか見たいかな",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/300100202/3001002020050"
  },
  {
    "id": 3001002020060,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "雑貨屋さんなら、この先にかわいいお店があるよ\r\n格好いいのがよかったら、あのお店とか……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/300100202/3001002020060"
  },
  {
    "id": 3001002020070,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "へぇっ、詳しいんだね！",
    "textCtrl": "p",
    "charLabel": "meguru",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "voice": "produce_events/300100202/3001002020070"
  },
  {
    "id": 3001002020080,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "うん、この辺はよく来るから",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/300100202/3001002020080"
  },
  {
    "id": 3001002020090,
    "textFrame": "001",
    "speaker": "めぐる",
    "text": "真乃って公園が好きってイメージだったけど\r\nこういうところも来るんだ？",
