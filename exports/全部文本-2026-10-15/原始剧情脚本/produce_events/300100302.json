    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020280"
  },
  {
    "id": 3001003020290,
    "speaker": "真乃",
    "text": "もちろんあるよ\r\nそこにはよく、お散歩に行くのっ",
    "charAnim1": "smile1",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020290"
  },
  {
    "id": 3001003020300,
    "speaker": "灯織",
    "text": "じゃあ、そこにしようよ\r\n真乃の好きな公園に行ってみたいから",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020300"
  },
  {
    "id": 3001003020310,
    "speaker": "真乃",
    "text": "いいの……？",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020310"
  },
  {
    "id": 3001003020320,
    "speaker": "灯織",
    "text": "うん、そこがいい",
    "charAnim3": "yes",
    "charLipAnim": "lip_smile",
    "charAnim3Loop": false,
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020320"
  },
  {
    "id": 3001003020330,
    "speaker": "真乃",
    "text": "（灯織ちゃんが、私の好きなところに\r\n行ってみたいって……ほわぁ～うれしいな）",
    "charAnim1": "smile3",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020330"
  },
  {
    "id": 3001003020340,
    "speaker": "灯織",
    "text": "そういえば、真乃、\r\nお弁当作って来るんだっけ？",
