  {
    "id": 3001003020020,
    "speaker": "真乃",
    "text": "お疲れ様……\r\nあ、あの……灯織ちゃん？",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020020"
  },
  {
    "id": 3001003020030,
    "speaker": "灯織",
    "text": "ん、どうしたの？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020030"
  },
  {
    "id": 3001003020040,
    "speaker": "真乃",
    "text": "プロデューサーさんに聞いたよ\r\n今度、同じ日にお休み取れたって",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020040"
  },
  {
    "id": 3001003020050,
    "speaker": "真乃",
    "text": "これでピクニック一緒に行けるね",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020050"
  },
  {
    "id": 3001003020060,
    "speaker": "灯織",
    "text": "うん、そうだね……",
    "charAnim1": "shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020060"
  },
  {
    "id": 3001003020070,
    "speaker": "真乃",
    "text": "……えっと、その",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020070"
  },
  {
    "id": 3001003020080,
    "speaker": "真乃",
    "text": "（無理矢理誘っちゃったけど、\r\n本当は行きたくないのかな……）",
    "charAnim1": "sad2",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020080"
  },
  {
    "id": 3001003020090,
    "speaker": "真乃",
    "text": "（どうしよう……何か言わなくっちゃ……\r\nこういう時、頭の中がまっしろになっちゃう……）",
    "charAnim1": "sad1",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020090"
  },
  {
    "id": 3001003020100,
    "speaker": "灯織",
    "text": "そうだ、真乃",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020100"
  },
  {
    "id": 3001003020110,
    "speaker": "真乃",
    "text": "……！　ど、どうしたの？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_trouble",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020110"
  },
  {
    "id": 3001003020120,
    "speaker": "灯織",
    "text": "ここに来るとき、通りかかった図書館で\r\n本を借りてきたの",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020120"
  },
  {
    "id": 3001003020130,
    "speaker": "灯織",
    "text": "この本なんだけど、見る？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020130"
  },
  {
    "id": 3001003020140,
    "speaker": "真乃",
    "text": "（お出かけ楽しいピクニック特集……？）",
    "charAnim1": "sad2",
    "charAnim2": "face_surp",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020140"
  },
  {
    "id": 3001003020150,
    "speaker": "真乃",
    "text": "これを、灯織ちゃんが……？",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020150"
  },
  {
    "id": 3001003020160,
    "speaker": "灯織",
    "text": "……そんなに変かな？",
    "charAnim1": "shy2",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020160"
  },
  {
    "id": 3001003020170,
    "speaker": "真乃",
    "text": "ううんううん！\r\n全然、変じゃないよっ",
    "charAnim2": "face_smile",
    "charAnim3": "no",
    "charLipAnim": "lip_smile",
    "charAnim3Loop": false,
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020170"
  },
  {
    "id": 3001003020180,
    "speaker": "灯織",
    "text": "一緒に行こうって言ってくれたから\r\n……要らなかった？",
    "charAnim1": "sad2",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020180"
  },
  {
    "id": 3001003020190,
    "speaker": "真乃",
    "text": "ううん、そんなことないよ\r\n一緒に見よう？",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020190"
  },
  {
    "id": 3001003020200,
    "speaker": "真乃",
    "text": "（ほわぁ、灯織ちゃんがピクニックの本を\r\n借りてきてくれるなんてっ）",
    "charAnim1": "smile3",
    "charAnim2": "face_shy",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020200"
  },
  {
    "id": 3001003020210,
    "speaker": "真乃",
    "text": "（メンバーとしてだけじゃなく、\r\n距離が近づいたみたい……うれしいなっ）",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "blank",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020210"
  },
  {
    "id": 3001003020220,
    "speaker": "真乃",
    "text": "あ、見て見て灯織ちゃん\r\nこの公園はね、鳥さんたちがたくさんいるんだよ",
    "charAnim1": "think",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020220"
  },
  {
    "id": 3001003020230,
    "speaker": "灯織",
    "text": "へぇ、そうだったんだ\r\n知らなかった……",
    "charAnim1": "surp1",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020230"
  },
  {
    "id": 3001003020240,
    "speaker": "真乃",
    "text": "あと、こっちの公園は、噴水もあって\r\nお花もたくさん咲いてるんだよ",
    "charAnim1": "sad1",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020240"
  },
  {
    "id": 3001003020250,
    "speaker": "真乃",
    "text": "それでこっちの公園はね──",
    "charAnim1": "surp1",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020250"
  },
  {
    "id": 3001003020260,
    "speaker": "灯織",
    "text": "ふふ、やっぱり真乃、公園には詳しいんだね",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020260"
  },
  {
    "id": 3001003020270,
    "speaker": "真乃",
    "text": "うんっこの雑誌に載ってる所は\r\nほとんど行ったことがあると思うよ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020270"
  },
  {
    "id": 3001003020280,
    "speaker": "灯織",
    "text": "そうなの？\r\nじゃあ、おすすめのところもあったりする？",
