    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020350"
  },
  {
    "id": 3001003020360,
    "speaker": "灯織",
    "text": "いや、私もお弁当作ろうかな……\r\nって思って",
