    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020360"
  },
  {
    "id": 3001003020370,
    "speaker": "灯織",
    "text": "だから、ふたりともお弁当作って来るってことで\r\n……いいでしょ？",
