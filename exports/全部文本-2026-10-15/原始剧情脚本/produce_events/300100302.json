    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300100302/3001003020340"
  },
  {
    "id": 3001003020350,
    "speaker": "真乃",
    "text": "作るよっ\r\n灯織ちゃんの分も作るからね",
