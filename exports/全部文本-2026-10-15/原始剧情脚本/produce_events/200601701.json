  },
  {
    "speaker": "咲耶の友達",
    "text": "公園着いたら、アスレチックで競争しよ！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006017010080,
    "speaker": "咲耶",
    "text": "うん！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010080"
  },
  {
    "speaker": "友達の父",
    "text": "咲耶ちゃん、帰りの時間どうする？　早い方がいいよね？\r\n親御さんも心配するだろうし",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006017010090,
    "speaker": "咲耶",
    "text": "あ、えと……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010090"
  },
  {
    "speaker": "咲耶の友達",
    "text": "えー、日が暮れるまで遊びたーい\r\n咲耶ちゃん、ダメ？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006017010100,
    "speaker": "咲耶",
    "text": "う、ううん！\r\n大丈夫……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010100"
  },
  {
    "speaker": "友達の父",
    "text": "そうかい？\r\nじゃあ、暗くなるまでだぞ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "咲耶の友達",
    "text": "はーい！\r\nいーっぱい遊ぼうね、咲耶ちゃん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006017010110,
    "speaker": "咲耶",
    "text": "……うん！",
    "textCtrl": "p",
    "textFrame": "001",
