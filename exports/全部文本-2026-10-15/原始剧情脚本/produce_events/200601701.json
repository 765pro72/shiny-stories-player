    "voice": "produce_events/200601701/2006017010130"
  },
  {
    "id": 2006017010140,
    "speaker": "咲耶",
    "text": "実は、今度の休みに\r\n地元の友達がこっちに遊びに来るんだ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ、それは楽しみだな",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
