  {
    "speaker": "プロデューサー",
    "text": "────咲耶の休み、\r\nもっと取ってあげられたらいいんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006017010150,
    "speaker": "咲耶",
    "text": "気にしないで\r\n仕事をする時間も、私にとっては楽しいひとときだよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？\r\nそれならいいんだけど……",
    "textCtrl": "p",
    "textFrame": "002"
  },
