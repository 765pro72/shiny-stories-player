  {
    "id": 2006017010040,
    "speaker": "咲耶",
    "text": "何回か、番組を見たことがあるんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601701/2006017010040"
  },
  {
    "speaker": "ディレクター",
    "text": "本当ですか？\r\nありがとうございます！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00493",
