    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、どういたしまして\r\n……今日はゆっくり休んでくれよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6803001090090,
