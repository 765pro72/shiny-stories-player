  },
  {
    "id": 6803001090080,
    "speaker": "MEMちょ",
    "text": "こちらこそ、遅くまで対応してもらって\r\nありがとうございましたぁ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
