    "charAnim1": "wait4",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mem",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "これからは客席からになるけど\r\nずっと、MEMちょのこと応援してる",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
