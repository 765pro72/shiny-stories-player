    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういうことだな！\r\nすまん、もうちょっと待っててくれ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
