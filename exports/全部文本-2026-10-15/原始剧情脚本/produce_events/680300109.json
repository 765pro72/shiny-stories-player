  {
    "id": 6803001090150,
    "speaker": "MEMちょ",
    "text": "夢を叶えてくれて、夢みたいな景色を見せてくれて、\r\nありがとうございました",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
