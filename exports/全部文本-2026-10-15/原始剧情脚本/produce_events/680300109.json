      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 6803001090010,
    "speaker": "MEMちょ",
    "text": "ぜーんぜん？\r\nめちゃくちゃ私に関係してるし",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090010"
  },
  {
    "id": 6803001090020,
    "speaker": "MEMちょ",
    "text": "２８３プロにも連絡来ちゃうんだねぇ\r\nすみません、ご面倒を……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいやいや！\r\n嬉しい悲鳴ってやつだよ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "対応については苺プロさんとも話しておくから\r\n安心してくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6803001090030,
    "speaker": "MEMちょ",
    "text": "ありがとう",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090030"
  },
  {
    "id": 6803001090040,
    "speaker": "MEMちょ",
    "text": "優勝なんて夢みたいと思ってたけど、\r\nなんか、急に現実的だぁ",
    "charAnim1": "sad1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "mem",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/680300109/6803001090040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、確かにな\r\n本人より俺の方が実感するのが早いかもしれない",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "fade_out"
