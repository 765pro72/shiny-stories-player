    "charAnim3Loop": false,
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020200"
  },
  {
    "id": 2013004020210,
    "speaker": "夏葉",
    "text": "どれも私らしくない……なぜかしら……",
