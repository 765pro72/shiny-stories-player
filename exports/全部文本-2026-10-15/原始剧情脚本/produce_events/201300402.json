      "time": 100
    },
    "voice": "produce_events/201300402/2013004020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、一眼レフを借りてきた",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020120,
    "speaker": "夏葉",
    "text": "上出来よ！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "それにしても綺麗な場所だな……\r\nここなら良い写真が撮れそうだ",
    "charAnim2": "face_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020130,
    "speaker": "夏葉",
    "text": "今日は近くで花火も上がるらしいのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020130"
  },
  {
    "id": 2013004020140,
    "speaker": "夏葉",
    "text": "素晴らしい画になるわ\r\n絶対、絶対よ……！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020140"
  },
  {
    "id": 2013004020150,
    "speaker": "夏葉",
    "text": "花火の時間までもう少しね\r\n準備するわよ！",
    "charAnim2": "face_smile2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
