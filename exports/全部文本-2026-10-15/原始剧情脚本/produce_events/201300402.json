    "voice": "produce_events/201300402/2013004020020"
  },
  {
    "id": 2013004020030,
    "speaker": "夏葉",
    "text": "水着だってずっとクローゼットの中じゃ\r\n輝きを失ってしまうわ！",
    "charAnim2": "face_serious",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あれ？　もしかして\r\nまだファンに水着をお披露目できてないのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020040,
    "speaker": "夏葉",
    "text": "そうなのよ！",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020040"
  },
  {
    "id": 2013004020050,
    "speaker": "夏葉",
    "text": "やっと久しぶりに晴れたのに、\r\n夕方まで予定があるなんて……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "せめて写真だけでも撮れたらな\r\nツイスタにアップできるんだが",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020060,
    "speaker": "夏葉",
    "text": "ええ……",
    "charAnim1": "wait4",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020060"
  },
  {
    "charAnim1": "anger1",
    "charAnim2": "face_serious",
    "charLabel": "natsuha",
    "textFrame": "off",
