    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "いつもの夏葉で良いと思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "大事なのは想像することだって、\r\n俺に教えてくれたじゃないか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ポーズとか目に見える形だけじゃなく",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏葉が今いちばん想いを届けたい相手を\r\n心に思い浮かべてみるんだ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
