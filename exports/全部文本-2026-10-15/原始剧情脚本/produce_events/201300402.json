    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "（良い写真だと思うんだけど、\r\n夏葉は納得できないみたいだな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020220,
    "speaker": "夏葉",
    "text": "ねぇ、あと何分！？\r\nもう時間になるわよね……！？",
    "charAnim1": "anger2",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_anger",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "……１回、深呼吸して落ち着こう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013004020230,
    "speaker": "夏葉",
    "text": "そんな気休め──……",
