      "time": 350
    },
    "waitType": "time",
    "waitTime": 750
  },
  {
    "id": 2013004020070,
    "speaker": "夏葉",
    "text": "こうなったら水着でダンスレッスン？\r\n水着でトレーニングはアリかしら？",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "う、うーん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLabel": "natsuha",
    "textFrame": "off",
    "se": "0242",
    "charEffect": {
      "type": "to",
      "x": -100,
      "alpha": 1,
      "time": 350
    },
    "waitType": "time",
    "waitTime": 750
  },
  {
    "id": 2013004020080,
    "speaker": "夏葉",
    "text": "はぁ……今日はモルディブの海にいるつもりで、\r\nポージングを考えるくらいしかできないわね……",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "(窓に張り付いてしまったぞ……)",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0242",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 2013004020090,
    "speaker": "夏葉",
    "text": "……夜なら大丈夫なのよ\r\nでも夜じゃ何も見えないし……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020090"
  },
  {
    "id": 2013004020100,
    "speaker": "夏葉",
    "text": "……待って、そういえば……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300402/2013004020100"
  },
