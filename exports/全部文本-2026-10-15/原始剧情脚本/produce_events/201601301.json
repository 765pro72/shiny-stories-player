    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010040"
  },
  {
    "id": 2016013010050,
    "speaker": "千雪",
    "text": "しとしと、ぽつぽつ、ぱらぱら、ざあざあ……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010050"
  },
  {
    "id": 2016013010060,
    "speaker": "千雪",
    "text": "……なんていうんだろう\r\n音にまぎれて針を運んでたら────",
