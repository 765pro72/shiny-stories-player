  {
    "textFrame": "off"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "わかりあってる、って思っててもさ\r\n独りよがりだったりしないか、気をつけないとさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010280,
    "speaker": "千雪",
    "text": "そうですね",
