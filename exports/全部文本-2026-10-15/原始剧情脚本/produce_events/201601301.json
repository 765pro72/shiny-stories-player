    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010220"
  },
  {
    "id": 2016013010230,
    "speaker": "千雪",
    "text": "そういうご夫婦だったら、きっと",
