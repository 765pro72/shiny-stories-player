    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010280"
  },
  {
    "id": 2016013010290,
    "speaker": "千雪",
    "text": "お醤油が欲しいっていうのが\r\n視線と表情でわかったとしても……",
