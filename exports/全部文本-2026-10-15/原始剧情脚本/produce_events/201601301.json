    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010240,
    "speaker": "千雪",
    "text": "ええ……\r\n今の私には想像つきませんけど……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010240"
  },
  {
    "id": 2016013010250,
    "speaker": "千雪",
    "text": "好きな人と長く一緒にいたら、\r\n境界があいまいになっていくのかも……",
