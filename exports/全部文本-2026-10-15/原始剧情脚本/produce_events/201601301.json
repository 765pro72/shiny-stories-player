    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、集中してるっていうのとは、\r\nちょっと違うのかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2016013010080,
    "speaker": "千雪",
    "text": "雨の音と、針と指、そこに触れる生地……\r\nそれで全部",
    "charAnim1": "wait2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010080"
  },
  {
    "id": 2016013010090,
    "speaker": "千雪",
    "text": "……そんな感覚、なんですけど",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\nなんとなくわかる気もするよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "静かで気持ちいいもんな\r\nこういう、しとしとした雨は────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
