    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010060"
  },
  {
    "id": 2016013010070,
    "speaker": "千雪",
    "text": "窓の外の世界と、\r\nふんわりつながっていくような気がして",
