    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ、そう言われるとな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010030,
    "speaker": "千雪",
    "text": "ふふっ、いいんです\r\nこういう雨の日に縫い物をするの、私ちょっと好きですから",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010030"
  },
