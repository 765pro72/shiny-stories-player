  },
  {
    "id": 2016013010110,
    "speaker": "千雪",
    "text": "急に強くなっちゃいましたね、雨……！",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010110"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、おう……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "全然、しとしとしてない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010111,
    "speaker": "千雪＆プロデューサー",
    "text": "────はははっ……！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010111"
  },
  {
    "speaker": "プロデューサー",
    "text": "それにしても、ひどい降りだ……",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これじゃ、\r\nゆっくり縫い物するって雰囲気でもなくなるよな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010120,
    "speaker": "千雪",
    "text": "ええ……",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010120"
  },
  {
    "id": 2016013010130,
    "speaker": "千雪",
    "text": "だってこの雨、\r\n言葉で表すなら『ざあざあ』を通り越して……",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なんて言ったらいいのかな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010140,
    "speaker": "千雪",
    "text": "ざんざん、ざぶざぶ……？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ごうごう、じゃんじゃん……\r\n違うな、確かこういう時の擬音は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010141,
    "speaker": "千雪＆プロデューサー",
    "text": "どしゃどしゃ……？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010141"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっ、綺麗にハモったな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010150,
    "speaker": "千雪",
    "text": "ふふっ\r\nハッピー・アイスクリーム……！",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！\r\nええと────？",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010160,
    "speaker": "千雪",
    "text": "ご存じないです？\r\n言葉がかぶっちゃった時に、こんなふうに言うの",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010160"
  },
  {
    "id": 2016013010170,
    "speaker": "千雪",
    "text": "『ハッピー・アイスクリーム』って先に言うと、\r\n相手はアイスクリームをおごらなきゃいけないんです",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ\r\nじゃあ今だったら……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010180,
    "speaker": "千雪",
    "text": "プロデューサーさんが先にそう言ったら、\r\n私がコンビニに走ることになります……！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "おっと、そうなのか\r\n知ってたらなぁ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010190,
    "speaker": "千雪",
    "text": "ふふっ、プロデューサーさん\r\nアイスクリーム、食べたいんです？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010190"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははは、いや冗談だよ\r\nでも負けるよりは、ぴったりのタイミングであいこがいいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait_s",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "id": 2016013010200,
    "speaker": "千雪",
    "text": "甘奈ちゃんとか甜花ちゃんだったら、\r\nぴったりの息で言えるのかも",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうかもなぁ\r\n長年連れ添ったご夫婦とかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016013010210,
    "speaker": "千雪",
    "text": "確かに……",
    "charAnim1": "surp1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201601301/2016013010210"
  },
  {
    "id": 2016013010220,
    "speaker": "千雪",
    "text": "わざわざ言葉にしなくても\r\nいいタイミングでお醤油を取ってあげられるような……",
