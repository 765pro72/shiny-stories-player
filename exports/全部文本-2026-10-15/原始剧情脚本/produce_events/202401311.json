  },
  {
    "id": 2024013110200,
    "speaker": "にちか",
    "text": "その……\r\n私、は……────",
    "charAnim1": "shy2",
    "charAnim2": "face_anger1",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、にちかはこの人とは違う\r\nにちかとは違う考えを持ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、一緒に理解していけたらって、思うよ",
    "charAnim1": "wait3",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2024013110210,
    "speaker": "にちか",
    "text": "いいです\r\n自分で考えますので",
    "charAnim1": "anger1",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、そっか……\r\nでも、いつでも力になるからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからも",
