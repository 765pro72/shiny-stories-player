    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "………\r\n『主演じゃないといや！』か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "言葉が人を縛り付ける時もあるけど、彼女はそれを糧にして\r\n自分を奮起させていたのかもしれないな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2024013110180,
    "speaker": "にちか",
    "text": "……────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110180"
