    },
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "id": 2024013110150,
    "speaker": "にちか",
    "text": "ちゃんと考えて辞めたと思うんですけどねー\r\nそれでも会いに来るとか正直、こわ……って感じですけど",
    "charLipAnim": "lip_wait",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "確かにな\r\nでも、少しだけ思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "マネージャーさんは彼女とずっと一緒にいて……\r\n辞める決断をした時もそばにいて────",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_surp_s",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "彼女の本心を見抜いていたんじゃないかな\r\n『まだここにいたい』って気持ちにさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2024013110160,
    "speaker": "にちか",
    "text": "そうかもですねー",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110160"
  },
  {
    "id": 2024013110170,
    "speaker": "にちか",
    "text": "なんかちょっとわかったかもです\r\nありがとうございますー",
    "charAnim1": "anger2",
    "charAnim2": "face_close3",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 1200
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_wait",
