    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "off",
    "text": "にちかは\r\n────に……なるぞーーーー…………！",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 4000
  },
  {
    "textFrame": "off",
