  {
    "id": 2024013110010,
    "speaker": "にちか",
    "text": "『ちょい役の仕事ばっかじゃいやよ！\r\n主演じゃないといや！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110010"
  },
  {
    "id": 2024013110020,
    "speaker": "にちか",
    "text": "『大きな役さえもらえれば、\r\n私の実力はわかってもらえるはずよ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110020"
  },
  {
    "id": 2024013110030,
    "speaker": "にちか",
    "text": "『生意気なこと言うなって？\r\n……言葉にしないとそれは実現しないのよ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202401311/2024013110030"
  },
