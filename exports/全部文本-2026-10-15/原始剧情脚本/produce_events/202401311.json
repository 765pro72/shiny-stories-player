  },
  {
    "id": 2024013110190,
    "speaker": "にちか",
    "text": "糧、とか……よくわからないですけど\r\n縛り付けてるわけでもないので──",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
