    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010080"
  },
  {
    "speaker": "プロデューサー",
    "text": "（……すごくいい匂いだ）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004003010090,
    "speaker": "恋鐘",
    "text": "プロデューサー、もう少しでできるけんね～\r\nもうちっと待っといてな～",
