    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、事務所にあったものだけで作ったとは思えない……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004003010130,
    "speaker": "恋鐘",
    "text": "んふふー♪　これくらい朝飯前たい！",
