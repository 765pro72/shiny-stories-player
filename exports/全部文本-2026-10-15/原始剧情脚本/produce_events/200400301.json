    "voice": "produce_events/200400301/2004003010010"
  },
  {
    "id": 2004003010020,
    "speaker": "恋鐘",
    "text": "おなか空いとーと？\r\nなら、うちがなにか作っちゃる！",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、適当に済ませるから大丈夫だよ\r\n恋鐘に悪いし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004003010030,
    "speaker": "恋鐘",
    "text": "そげんこと気にせんでよかよ～",
    "charAnim1": "anger2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010030"
  },
  {
    "id": 2004003010040,
    "speaker": "恋鐘",
    "text": "だってプロデューサー\r\n最近ちゃんとしたもん食べとらんやろ？",
    "charLipAnim": "lip_anger",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010040"
  },
  {
    "id": 2004003010050,
    "speaker": "恋鐘",
    "text": "身体ば壊されたら、うちもみんなも困るばい！",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん……それじゃ、せっかくだし作ってもらおうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004003010060,
    "speaker": "恋鐘",
    "text": "はーい！\r\nすぐ作るけん、ちょっと待っとって！",
