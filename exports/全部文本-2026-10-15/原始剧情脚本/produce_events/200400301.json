    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200400301/2004003010130"
  },
  {
    "id": 2004003010140,
    "speaker": "恋鐘",
    "text": "さあ、冷めないうちに食べてくれんね",
