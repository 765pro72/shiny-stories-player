    "voice": "produce_events/200400301/2004003010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "もうできるのか？　手際がいいんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2004003010100,
    "speaker": "恋鐘",
