  },
  {
    "speaker": "映画監督",
    "text": "それは、私の作品次第ではありますが\r\nそうなったら私も嬉しいですね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "プロデューサー",
    "text": "監督……\r\n良いご縁をいただいて、ありがとうございました",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002",
