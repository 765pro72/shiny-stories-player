      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "宣伝や舞台挨拶の打ち合わせなど……諸々\r\n引き続き精一杯やらせていただきます！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
