  {
    "id": 3021008010140,
    "speaker": "果穂",
    "text": "……円香さんは寒くないですか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010140"
  },
  {
    "id": 3021008010150,
    "speaker": "円香",
    "text": "大丈夫",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010150"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 3021008010160,
    "speaker": "果穂",
    "text": "あの……\r\n円香さんは屋上好きですか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010160"
  },
  {
    "id": 3021008010170,
    "speaker": "果穂",
    "text": "あっ、えっと\r\nたまにいるなって思って……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010170"
  },
  {
    "id": 3021008010180,
    "speaker": "円香",
    "text": "別に\r\nそういうわけじゃない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010180"
  },
  {
    "id": 3021008010190,
    "speaker": "果穂",
    "text": "そうですか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010190"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 3021008010200,
    "speaker": "果穂",
    "text": "あたしも、たまに屋上来るんですけど……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010200"
  },
  {
    "id": 3021008010210,
    "speaker": "果穂",
    "text": "でも、ちょっとさみしい気持ちになる時があって……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010210"
  },
  {
    "id": 3021008010220,
    "speaker": "円香",
    "text": "……そうなんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010220"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 3021008010230,
    "speaker": "果穂",
    "text": "ま、円香さん……！\r\nあの、あの……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010230"
  },
  {
    "id": 3021008010240,
    "speaker": "果穂",
    "text": "『ひとりでたそがれるのがお好きですか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010240"
  },
  {
    "id": 3021008010250,
    "speaker": "円香",
    "text": "……え？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010250"
  },
  {
    "id": 3021008010260,
    "speaker": "果穂",
    "text": "そうじゃなかったら、その……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010260"
  },
  {
    "id": 3021008010270,
    "speaker": "果穂",
    "text": "『ご一緒してもいいでしょうか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010270"
  },
  {
    "id": 3021008010280,
    "speaker": "円香",
    "text": "……何？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010280"
  },
  {
    "id": 3021008010290,
    "speaker": "円香",
    "text": "どこかのドラマみたいなセリフ\r\nどういう意味？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010290"
  },
  {
    "id": 3021008010300,
    "speaker": "果穂",
    "text": "あっ！　えっと……！\r\nたそがれは、考え事をするとか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010300"
  },
  {
    "label": "回想",
    "speaker": "円香",
    "text": "……………………",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "id": 3021008010320,
    "speaker": "円香",
    "text": "うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010320"
  },
  {
    "id": 3021008010330,
    "speaker": "果穂",
    "text": "ぼーっとする、みたいな……意味、で……？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010330"
  },
  {
    "id": 3021008010340,
    "speaker": "円香",
    "text": "そう",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302100801/3021008010340"
  },
