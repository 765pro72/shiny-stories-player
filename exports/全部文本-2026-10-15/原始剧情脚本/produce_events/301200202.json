    "textFrame": "001",
    "voice": "produce_events/301200202/3012002020190"
  },
  {
    "id": 3012002020200,
    "speaker": "凛世",
    "text": "樹里さん、果穂さん、おはようございます……\r\nはい……何でしょう……？",
    "charAnim1": "smile2",
