    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200202/3012002020370"
  },
  {
    "id": 3012002020380,
    "speaker": "果穂",
    "text": "それって……\r\n樹里ちゃんも、恋してるってことですか！？",
