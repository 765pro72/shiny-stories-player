    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200202/3012002020300"
  },
  {
    "id": 3012002020310,
    "speaker": "凛世",
    "text": "川の流れが徐々に大きくなっていく様子に見立てた……\r\nそうした歌でございます……",
