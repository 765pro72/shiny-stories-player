    "textFrame": "001",
    "voice": "produce_events/301200202/3012002020360"
  },
  {
    "id": 3012002020370,
    "speaker": "樹里",
    "text": "そ、そういうことだよ\r\n恋なんて、いつかは勝手に落ちちまうもんなんだ",
