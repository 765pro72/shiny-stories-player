    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301200202/3012002020380"
  },
  {
    "id": 3012002020390,
