    "textFrame": "001",
    "voice": "produce_events/200100902/2001009020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、もちろんだよ\r\n今度、時間があればCDショップにも行ってみるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
