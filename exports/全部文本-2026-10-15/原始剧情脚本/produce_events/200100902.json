    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100902/2001009020200"
  },
  {
    "id": 2001009020210,
    "speaker": "真乃",
    "text": "あの……プロデューサーさんの知っている曲を\r\nいくつか教えて頂いてもいいでしょうか……？",
