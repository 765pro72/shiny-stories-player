    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100902/2001009020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "んーそうだな……\r\n音楽の授業でいくつか聴いたりしたことはないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001009020180,
    "speaker": "真乃",
    "text": "授業で……──ほわっ、そういえばそうでしたっ",
