    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100902/2001009020080"
  },
  {
    "id": 2001009020090,
    "speaker": "真乃",
    "text": "──あのっ……よかったら、プロデューサーさんの\r\nおすすめの曲も教えて頂けませんか？",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200100902/2001009020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　俺のおすすめか……\r\nうーん……そうだな……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "やっぱり\r\nアイドルソングかな",
    "nextLabel": "1"
