  {
    "id": 2009010030020,
    "speaker": "果穂",
    "text": "ごめんなさいプロデューサーさん……っ",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger",
    "charLabel": "kaho",
