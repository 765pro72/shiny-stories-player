    "voice": "produce_events/200901003/2009010030020"
  },
  {
    "id": 2009010030030,
    "speaker": "果穂",
    "text": "あたし、いっぱい特訓したのに……！",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901003/2009010030030"
  },
  {
    "id": 2009010030040,
    "speaker": "果穂",
    "text": "したのに……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901003/2009010030040"
  },
  {
    "id": 2009010030050,
    "speaker": "果穂",
    "text": "紅茶をいれるの、上手にできません……",
    "charAnim1": "sad2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901003/2009010030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂、果穂\r\n大丈夫だ、絶対できる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "特訓した時と服が違うから、\r\n今はちょっと戸惑ってるだけだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009010030060,
    "speaker": "果穂",
    "text": "そうでしょうか……",
    "charAnim1": "shy2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901003/2009010030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "いっぱい頑張ったもんな\r\nだから、動きは体が覚えてるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "努力は果穂を裏切らない\r\n落ち着いていこう",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009010030070,
