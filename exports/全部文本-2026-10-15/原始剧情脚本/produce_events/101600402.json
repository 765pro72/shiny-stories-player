  {
    "id": 1016004020090,
    "speaker": "千雪",
    "text": "……ありがとうございます\r\nプロデューサーさん",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
