      "time": 100
    },
    "bgm": "070",
    "voice": "produce_events/101600402/1016004020090"
  },
  {
    "id": 1016004020100,
    "speaker": "千雪",
    "text": "リストのこと……",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、あまり乗り気じゃない気がしたからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "即決しなきゃならない案件でもなかったし、\r\n全然気にしないでくれていいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004020110,
    "speaker": "千雪",
    "text": "そう……でしたか",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020110"
  },
  {
    "id": 1016004020120,
    "speaker": "千雪",
    "text": "あまり乗り気じゃない――\r\nプロデューサーさんのおっしゃる通りです",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020120"
  },
  {
    "id": 1016004020130,
    "speaker": "千雪",
    "text": "できることがあったら何でもおっしゃってください、なんて\r\n言っておいて、気が引けるんですけど……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん\r\n……気が進まない理由、教えてもらえるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "chiyuki",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
