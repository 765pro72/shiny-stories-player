    "waitTime": 1700,
    "bgEffectTime": 1200
  },
  {
    "id": 1016004020140,
    "speaker": "千雪",
    "text": "はい……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020140"
  },
  {
    "id": 1016004020150,
    "speaker": "千雪",
    "text": "プレイリストって、どうやっても作った人の、\r\nらしさといいますか……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020150"
  },
  {
    "id": 1016004020160,
    "speaker": "千雪",
    "text": "個性が出てしまうと思うんです",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600402/1016004020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "前に、本棚に例えてくれたことがあったの、覚えてるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00463",
    "bgEffect": "fade",
    "waitType": "time",
