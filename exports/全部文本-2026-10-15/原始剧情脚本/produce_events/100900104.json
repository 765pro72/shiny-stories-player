  },
  {
    "speaker": "プロデューサー",
    "text": "果穂にお願いしたいってオファーだったから、\r\nヒーローに憧れるまっすぐな心が見込まれたんだろうな",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": null,
    "speaker": "果穂",
