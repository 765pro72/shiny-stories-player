  {
    "speaker": "プロデューサー",
    "text": "司会だけどな\r\n果穂はたくさん見てきたんじゃないか？",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "はいっ！　いろんなヒーローショーを見てきました！\r\nそのステージに立てるなんて……スゴいですっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
