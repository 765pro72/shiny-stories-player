    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300704/2013007040160"
  },
  {
    "id": 2013007040170,
    "speaker": "夏葉",
    "text": "研究に没頭する人だっているし、\r\nそれぞれが選んで、そうなっているのよ",
