    "voice": "produce_events/200401903/2004019030160"
  },
  {
    "id": 2004019030170,
    "speaker": "恋鐘",
    "text": "うちが苦手かとは仕方なか────\r\nばってん、ちゃんと知ってから苦手って言ってほしか！",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
