    "textFrame": "001",
    "voice": "produce_events/200401903/2004019030140"
  },
  {
    "id": 2004019030150,
    "speaker": "恋鐘",
    "text": "たくさんオーディションば受けたばってん、１個も\r\n受からんくて、こん方言ば直すようにって言われたり……",
    "charAnim1": "think",
    "charAnim2": "face_close2",
