[
  {
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "natsuha",
    "charType": "characters",
    "charId": "013",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "bg": "00049",
    "bgm": "041"
  },
  {
    "speaker": "プロデューサー",
    "text": "秘密基地とか、\r\n小さい頃、夏葉も作ったりしたのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020010,
    "speaker": "夏葉",
    "text": "いいえ、今回が初めてよ",
    "charAnim2": "face_smile1",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020010"
  },
  {
    "id": 1013002020020,
    "speaker": "夏葉",
    "text": "とても有意義な体験だった──……\r\n丸めて筒状にした段ボールって、あんなに強度が増すのね！",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020020"
  },
  {
    "id": 1013002020030,
    "speaker": "夏葉",
    "text": "人が乗っても崩れないなんて……\r\n椅子の脚にも使えそうだわ……",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "次の秘密基地にはお手製の椅子が登場かな\r\n……場所はどうするつもりだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020040,
    "speaker": "夏葉",
    "text": "うふふ、そうねぇ……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020040"
  },
  {
    "id": 1013002020050,
    "speaker": "夏葉",
    "text": "公園の土管の中、ジャングルジム、\r\nやっぱり段ボールの家……？",
    "charAnim1": "shy2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、結構調べたのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020060,
    "speaker": "夏葉",
    "text": "アナタは他に思いつく？",
    "charAnim1": "sad1",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……あっ、ツリーハウスとか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020070,
    "speaker": "夏葉",
    "text": "素敵じゃない！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020070"
  },
  {
    "id": 1013002020080,
    "speaker": "夏葉",
    "text": "それなら、相応しい木の選定から入らないとね\r\nここにあるかしら……",
    "charAnim1": "think",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "立派な木も多いし、見つかりそうだよな\r\n──こう、力強そうなやつ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020090,
    "speaker": "夏葉",
    "text": "力強そうなやつ──……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020090"
  },
  {
    "id": 1013002020100,
    "speaker": "夏葉",
    "text": "……ふふ",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "あー……\r\nでも、みんなに木登りは大変か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020110,
    "speaker": "夏葉",
    "text": "……あら、そうでもないんじゃないかしら",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020110"
  },
  {
    "id": 1013002020120,
    "speaker": "夏葉",
    "text": "木の上まで行ってみたこと、あるわよ\r\nもちろん、子どもの頃の話だけど",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……！\r\n夏葉もそういう遊びをしてたんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020130,
    "speaker": "夏葉",
    "text": "アナタの想像する子どもの私は、\r\n大人しいイメージなの？",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、そういうわけじゃないけど……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020140,
    "speaker": "夏葉",
    "text": "──あの時は、兄と一緒に登ったのよ\r\n服を汚して帰ったから、後でひどく叱られたわ",
    "charAnim1": "shy2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020140"
  },
  {
    "id": 1013002020150,
    "speaker": "夏葉",
    "text": "兄も、ちょうどさっきのプロデューサーみたいに\r\n力強そうな木がいいって言っていた",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうか……\r\n子どもの頃のお兄さんと一緒か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020160,
    "speaker": "夏葉",
    "text": "苦戦しながら、細い枝しかなくなるところまで行って──",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020160"
  },
  {
    "id": 1013002020170,
    "speaker": "夏葉",
    "text": "……そしたら、緑色が綺麗だった",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020170"
  },
  {
    "id": 1013002020180,
    "speaker": "夏葉",
    "text": "太陽の光が透けて、葉が明るくなっていて、\r\n上に上に、成長しようとしているんだって強く感じたの",
    "charAnim1": "think",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……それ、季節は夏だったんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020190,
    "speaker": "夏葉",
    "text": "うふふ、どうだったかしら",
    "charAnim1": "wait2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020190"
  },
  {
    "id": 1013002020200,
    "speaker": "夏葉",
    "text": "──それでね、下りる時に兄がちょっと足を滑らせて、\r\nそのまま下に落ちてしまったの",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "え！？　大丈夫だったのか！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020210,
    "speaker": "夏葉",
    "text": "ええ、ほぼ下り切ったようなところだったから\r\nふたりして驚いただけで、なんともなかったわ",
    "charAnim1": "wait4",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020210"
  },
  {
    "id": 1013002020220,
    "speaker": "夏葉",
    "text": "──だから、木登りなら問題ないの",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "……なるほど\r\nなら、ぜひ木の上に秘密基地を作りたいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……夏の葉の色も、確かめてみたいし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1013002020230,
    "speaker": "夏葉",
    "text": "あら\r\n……うふふ、いいじゃない",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020230"
  },
  {
    "id": 1013002020240,
    "speaker": "夏葉",
    "text": "──アナタ、木登りは得意なの？",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101300202/1013002020240"
  },
  {
    "label": "end",
    "textFrame": "off"
  }
]