  },
  {
    "id": 2022010020040,
    "speaker": "小糸",
    "text": "ぴゃ……！\r\nぷ、プロデューサーさん……！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
