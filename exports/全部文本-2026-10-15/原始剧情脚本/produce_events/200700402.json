  },
  {
    "id": 2007004020040,
    "speaker": "結華",
    "text": "ちょっ、待っ……！",
    "charAnim2": "face_shy",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
