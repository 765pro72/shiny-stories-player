  {
    "id": 3009002010020,
    "speaker": "智代子",
    "text": "大人の女性……大人の女性かぁ……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
