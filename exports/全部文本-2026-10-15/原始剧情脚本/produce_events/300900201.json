    "voice": "produce_events/300900201/3009002010020"
  },
  {
    "id": 3009002010030,
    "speaker": "凛世",
    "text": "……",
    "charAnim1": "anger2",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010030"
  },
  {
    "id": 3009002010040,
    "speaker": "果穂",
    "text": "あれ？　ちょこ先輩？　凛世さん？\r\n難しい顔して、どうしたんですか？",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010040"
  },
  {
    "id": 3009002010050,
    "speaker": "智代子",
    "text": "あ、果穂！　おはよう\r\n今はねー、ちょっと研究をしてたところなんだー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010050"
  },
  {
    "id": 3009002010060,
    "speaker": "果穂",
    "text": "研究っ？　研究ってなんのですか？\r\nえっと、大人の……女性……特集……？",
    "charAnim1": "surp2",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010060"
  },
  {
    "id": 3009002010070,
    "speaker": "智代子",
    "text": "そうそう！　ほらこれ、ちょうど雑誌の特集があってね\r\nもっと大人っぽくなったら新しい魅力も出るかなぁって！",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010070"
  },
  {
    "id": 3009002010080,
    "speaker": "果穂",
    "text": "大人っぽい魅力！\r\nなんだかカッコいいです！",
    "charAnim1": "anger2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010080"
  },
  {
    "id": 3009002010090,
    "speaker": "智代子",
    "text": "私もそう思って始めたんだけど……\r\nどうしたらいいかよくわからなくて……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010090"
  },
  {
    "id": 3009002010100,
    "speaker": "智代子",
    "text": "こうして凛世ちゃんにも協力を頼んでるわけです……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010100"
  },
  {
    "id": 3009002010110,
    "speaker": "凛世",
    "text": "お力になれず……申し訳ございません……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010110"
  },
  {
    "id": 3009002010120,
    "speaker": "智代子",
    "text": "わあぁ待ってよ凛世ちゃん謝らないで！\r\n一緒に考えてくれてるだけですっごく助かってるから！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010120"
  },
  {
    "id": 3009002010130,
    "speaker": "智代子",
    "text": "果穂も一緒にどうかな？\r\n大人っぽくなるための秘訣について、考えてくれない？",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010130"
  },
  {
    "id": 3009002010140,
    "speaker": "果穂",
    "text": "わぁっ、作戦会議、ですねっ！",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010140"
  },
  {
    "id": 3009002010150,
    "speaker": "果穂",
    "text": "わかりましたっ！\r\nヒーローみたいにズバッと解決できるように、頑張ります！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010150"
  },
  {
    "id": 3009002010160,
    "speaker": "果穂",
    "text": "それじゃあ、えーっと……あれ？\r\nでも、大人っぽいってどんな感じ……なんでしょう？",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010160"
  },
  {
    "id": 3009002010170,
    "speaker": "智代子",
    "text": "そう！　まずはそこからなんだよね！",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010170"
  },
  {
    "id": 3009002010180,
    "speaker": "凛世",
    "text": "難しい……お話です……",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010180"
  },
  {
    "id": 3009002010190,
    "speaker": "智代子",
    "text": "……あ！　でも、果穂はお姉さんに見えるよね\r\n凛世ちゃんもそう思わない？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010190"
  },
  {
    "id": 3009002010200,
    "speaker": "凛世",
    "text": "凛世と……\r\nお齢も変わらぬように……感じられます……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010200"
  },
  {
    "id": 3009002010210,
    "speaker": "果穂",
    "text": "そ、そんなことはっ\r\nあ、あたしは背が高いだけですよっ……えへへ",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010210"
  },
  {
    "id": 3009002010220,
    "speaker": "果穂",
    "text": "大人の人はなんでもできてカッコよくて……\r\nとにかくスッゴいんですっ！",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010220"
  },
  {
    "id": 3009002010230,
    "speaker": "智代子",
    "text": "たしかに、それもひとつの大人っぽさだよね",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010230"
  },
  {
    "id": 3009002010240,
    "speaker": "智代子",
    "text": "そうなると、私はまだまだなれそうにないかなぁ……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010240"
  },
  {
    "id": 3009002010250,
    "speaker": "凛世",
    "text": "ふふ……\r\n凛世も……同じでございます……",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010250"
  },
  {
    "id": 3009002010260,
    "speaker": "果穂",
    "text": "そんなことないです！\r\nちょこ先輩はいつも元気で優しくて……",
    "charAnim1": "surp2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010260"
  },
  {
    "id": 3009002010270,
    "speaker": "果穂",
    "text": "良いアイドルになるにはどうしたらいいかって、\r\n難しいことも考えててスゴいですっ！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010270"
  },
  {
    "id": 3009002010280,
    "speaker": "果穂",
    "text": "凛世さんはいつも落ち着いてて\r\nれーせーでカッコいいところがスゴいですっ！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010280"
  },
  {
    "id": 3009002010290,
    "speaker": "果穂",
    "text": "だからっ\r\nあたしにとっては、みんなとってもスゴいんです！",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010290"
  },
  {
    "id": 3009002010300,
    "speaker": "智代子",
    "text": "果穂……！\r\n果穂は優しいね、私今心があったかいよ……！",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_shy",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010300"
  },
  {
    "id": 3009002010310,
    "speaker": "智代子",
    "text": "そういうふうに言ってもらえるなら、\r\nもう少しこのままでも……いいのかな？",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010310"
  },
  {
    "id": 3009002010320,
    "speaker": "凛世",
    "text": "はい……果穂さんのおっしゃるような……\r\n凛世でいられたらと……",
    "charAnim1": "smile3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010320"
  },
  {
    "id": 3009002010330,
    "speaker": "果穂",
    "text": "はいっ！\r\nあたしは、今のちょこ先輩と凛世さんが大好きです！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010330"
  },
  {
    "id": 3009002010340,
    "speaker": "智代子",
    "text": "面と向かって言われると照れるなぁ\r\nでも、そうやって真っすぐなのが、果穂のスゴいとこだよね",
    "charAnim1": "wait4",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010340"
  },
  {
    "id": 3009002010350,
    "speaker": "凛世",
    "text": "ふふ……はい……",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010350"
  },
  {
    "id": 3009002010360,
    "speaker": "果穂",
    "text": "えへへ\r\nありがとうございますっ",
    "charAnim1": "shy2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010360"
  },
  {
    "id": 3009002010370,
    "speaker": "智代子",
    "text": "よーし、大人についての話は解決！\r\n喉乾かない？　みんなでお茶しようよっ",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010370"
  },
  {
    "id": 3009002010380,
    "speaker": "凛世",
    "text": "それでは……凛世が……\r\nお淹れしましょう……",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010380"
  },
  {
    "id": 3009002010390,
    "speaker": "果穂",
    "text": "わあっ、いいんですかっ！\r\n凛世さんのお茶、楽しみですっ！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300900201/3009002010390"
  },
