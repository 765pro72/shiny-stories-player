    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800104/1008001040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "大丈夫だ、俺に任せてくれ……\r\n……っと、よし",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001040070,
