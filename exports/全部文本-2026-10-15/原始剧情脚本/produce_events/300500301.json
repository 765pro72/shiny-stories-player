[
  {
    "id": 3005003010010,
    "speaker": "結華",
    "text": "まみみん！　次の仕事、二人だねぇ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
