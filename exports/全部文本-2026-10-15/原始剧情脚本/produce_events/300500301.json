    "charCategory": "stand_fix"
  },
  {
    "id": 3005003010020,
    "speaker": "摩美々",
    "text": "そーみたいだねー\r\nまぁ、よろしくー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1030050010",
    "charPosition": {
      "x": 310,
      "y": 640,
      "order": 1
    },
    "voice": "produce_events/300500301/3005003010020"
  },
  {
    "id": 3005003010030,
    "speaker": "結華",
    "text": "よろしくー\r\nちなみに番組のこと、何か聞いてる？",
    "charAnim1": "wait2",
    "charAnim2": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010030",
    "charAnim2Loop": false
  },
  {
    "id": 3005003010040,
    "speaker": "摩美々",
    "text": "んー？　何かあったっけー\r\nってなんか三峰うれしそー？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010040"
  },
  {
    "id": 3005003010050,
    "speaker": "結華",
    "text": "あはー、やっぱわかっちゃう？\r\nだってその仕事、私服で出てって言われたからさ！",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010050"
  },
  {
    "id": 3005003010060,
    "speaker": "結華",
    "text": "人気のファッション番組だし、今から楽しみで！",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010060"
  },
  {
    "id": 3005003010070,
    "speaker": "摩美々",
    "text": "あー、そーいえばぁ……\r\n新鮮だとは思うケド……それ以上にめんどーかもー",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010070"
  },
  {
    "id": 3005003010080,
    "speaker": "結華",
    "text": "えーっ、なんで？　どこが！？",
    "charAnim1": "surp1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010080"
  },
  {
    "id": 3005003010090,
    "speaker": "摩美々",
    "text": "私服ってところー\r\n新鮮だけどめんどーかなぁ",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010090"
  },
  {
    "id": 3005003010100,
    "speaker": "結華",
    "text": "そんなこと言わずにさぁ\r\n三峰、まみみんの服、攻めてて好きなんだよ",
    "charAnim1": "wait1",
    "charAnim2": "no",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010100",
    "charAnim2Loop": false
  },
  {
    "id": 3005003010110,
    "speaker": "結華",
    "text": "一緒に楽しく私服で出よー？\r\nまみみんのかっこいいとっておき、三峰に見せてー！",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010110"
  },
  {
    "id": 3005003010120,
    "speaker": "摩美々",
    "text": "そう言われてもー、\r\n服とかたくさんあるから選ぶのも大変なんだよー？",
    "charAnim1": "wait1",
    "charAnim2": "no",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010120",
    "charAnim2Loop": false
  },
  {
    "id": 3005003010130,
    "speaker": "摩美々",
    "text": "それに、衣装合わせのために\r\nいっぱい持って来なきゃいけないのはもっとめんどー",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010130"
  },
  {
    "id": 3005003010140,
    "speaker": "結華",
    "text": "あー……確かに、服持って事務所に\r\n集合しなきゃなのは、ねぇ……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010140"
  },
  {
    "id": 3005003010150,
    "speaker": "摩美々",
    "text": "そうだよー？\r\n荷物増えるだけだからねー",
    "charAnim1": "wait1",
    "charAnim2": "yes",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010150",
    "charAnim2Loop": false
  },
  {
    "id": 3005003010160,
    "speaker": "結華",
    "text": "……いや、でも待って！\r\nこれはむしろチャンスなんじゃないだろうか！",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010160"
  },
  {
    "id": 3005003010170,
    "speaker": "摩美々",
    "text": "チャンスー？\r\nどーゆーことー？",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010170"
  },
  {
    "id": 3005003010180,
    "speaker": "結華",
    "text": "三峰さ、まみみんのこと、\r\n一度コーディネートしてみたいと思ってたんだよね",
    "charAnim1": "anger1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010180"
  },
  {
    "id": 3005003010190,
    "speaker": "摩美々",
    "text": "私をー？\r\n三峰、そんなこと考えてたんだねー",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010190"
  },
  {
    "id": 3005003010200,
    "speaker": "結華",
    "text": "そう！　だから、たとえ荷物が重くても、\r\n着せ替えして遊ぶためだと思えば苦じゃないはず……！",
    "charAnim1": "wait1",
    "charAnim2": "yes",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010200",
    "charAnim2Loop": false
  },
  {
    "id": 3005003010210,
    "speaker": "結華",
    "text": "三峰はこのチャンスをゲットしたい！\r\nどうかな、まみみん！？",
    "charAnim1": "sad1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010210"
  },
  {
    "id": 3005003010220,
    "speaker": "摩美々",
    "text": "三峰が私をコーディネートかぁ……",
    "charAnim1": "smile1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010220"
  },
  {
    "id": 3005003010230,
    "speaker": "摩美々",
    "text": "まぁ……それは面白そうかもー",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010230"
  },
  {
    "id": 3005003010240,
    "speaker": "結華",
    "text": "おっ、好感触！　いいよいいよまみみん！",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010240"
  },
  {
    "id": 3005003010250,
    "speaker": "摩美々",
    "text": "ちょっと興味出たかもー\r\n……私も私でー……",
    "charAnim1": "wait2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010250"
  },
  {
    "id": 3005003010260,
    "speaker": "結華",
    "text": "ん？　あれどしたの？　やっぱやめるとかそういう？！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010260"
  },
  {
    "id": 3005003010270,
    "speaker": "摩美々",
    "text": "ふふー\r\nチャンスっていえば、私もそうかもーって思ったんだぁ",
    "charAnim1": "surp1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010270"
  },
  {
    "id": 3005003010280,
    "speaker": "摩美々",
    "text": "……実は前から三峰の服、気になってたんだよねー",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010280"
  },
  {
    "id": 3005003010290,
    "speaker": "摩美々",
    "text": "服のセンスとかぁ、合わせとかぁ\r\nけっこー見てたりするんだよー？",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010290"
  },
  {
    "id": 3005003010300,
    "speaker": "結華",
    "text": "おおっ、ほんとに？\r\n三峰のファッションに興味あったりする？",
    "charAnim1": "surp2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010300"
  },
  {
    "id": 3005003010310,
    "speaker": "摩美々",
    "text": "そうかもー",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010310"
  },
  {
    "id": 3005003010320,
    "speaker": "摩美々",
    "text": "三峰って個性的な格好が多いからぁ、\r\nけっこー私と服のセンス近いと思っててー",
    "charAnim1": "sad1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010320"
  },
  {
    "id": 3005003010330,
    "speaker": "摩美々",
    "text": "だから三峰がどーゆー服持ってくるのか、\r\nちょっと気にはなるかなぁ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010330"
  },
  {
    "id": 3005003010340,
    "speaker": "結華",
    "text": "なるほど、だったらなおさらラッキーなんじゃない？\r\nまみみん、三峰の服見放題だよ",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010340"
  },
  {
    "id": 3005003010350,
    "speaker": "結華",
    "text": "……あ、そうだ。ここまできたらさぁ、\r\nまみみんも三峰の服、コーディネートしてよ！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010350"
  },
  {
    "id": 3005003010360,
    "speaker": "摩美々",
    "text": "私も三峰の服、選んでいいってことー？",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010360"
  },
  {
    "id": 3005003010370,
    "speaker": "結華",
    "text": "そうそう！\r\nまみみんは三峰の！　三峰はまみみんの！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010370"
  },
  {
    "id": 3005003010380,
    "speaker": "結華",
    "text": "お互いのセンスで、お互いに着せたい服を選んだら\r\n面白そうじゃない？",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010380"
  },
  {
    "id": 3005003010390,
    "speaker": "結華",
    "text": "手持ちの服で、自分じゃ絶対思いつかないコーデが\r\n見れたりするかもしれないし！",
    "charAnim1": "shy2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010390"
  },
  {
    "id": 3005003010400,
    "speaker": "摩美々",
    "text": "確かにおもしろそーだねー、\r\n三峰のことコーディネートしてみたかったし、いいよー",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010400"
  },
  {
    "id": 3005003010410,
    "speaker": "摩美々",
    "text": "そしたら、私もちゃんと服持ってこなきゃだなぁ……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010410"
  },
  {
    "id": 3005003010420,
    "speaker": "摩美々",
    "text": "三峰のおかげで、\r\nちょっとやる気でたかもー",
    "charAnim1": "surp2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010420"
  },
  {
    "id": 3005003010430,
    "speaker": "摩美々",
    "text": "私服持ってくるのはやっぱりめんどーだけどー\r\n楽しみができたから頑張ろーかなぁ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010430"
  },
  {
    "id": 3005003010440,
    "speaker": "結華",
    "text": "やーった！　まみみん物分かりがいい！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010440"
  },
  {
    "id": 3005003010450,
    "speaker": "摩美々",
    "text": "三峰の服、楽しみにしてるからぁ",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010450"
  },
  {
    "id": 3005003010460,
    "speaker": "結華",
    "text": "三峰もだよ、当日よろしくね",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010460"
  },
  {
    "id": 3005003010470,
    "speaker": "摩美々",
    "text": "ふふー\r\n衣装合わせ、けっこー楽しみかもー",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300500301/3005003010470"
  },
  {
    "label": "end"
  }
]