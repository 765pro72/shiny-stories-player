    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600403/2016004030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n他に、お菓子とかも入ってるみたいだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait_s",
