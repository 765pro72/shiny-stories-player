    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600403/2016004030140"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……うーん、俺にも何か手伝えることがあったら\r\n遠慮せず言ってくれよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004030150,
