      "time": 100
    },
    "voice": "produce_events/101800402/1018004020060"
  },
  {
    "id": 1018004020070,
    "speaker": "冬優子",
    "text": "ふゆが準備の予定詰めたがるせいで\r\n送り迎え、いつもあんたにやらせちゃって……",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや？\r\nこれが俺の仕事だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "冬優子が気に病むことじゃない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020080,
    "speaker": "冬優子",
    "text": "──……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020080"
  },
  {
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1018004020090,
    "speaker": "冬優子",
    "text": "……ワンマンに来てくれるお客さんは、\r\nストレイライトのためだけに来てくれる人たちでしょう？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 1018004020100,
    "speaker": "冬優子",
    "text": "ふゆたちのためだけに、時間と、お金を使って、\r\nわざわざ会いに来てくれる人たちなのよ",
    "charAnim1": "smile1",
    "charAnim2": "face_close",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020100"
  },
  {
    "id": 1018004020110,
    "speaker": "冬優子",
    "text": "そんな人たちの期待を裏切るような真似──\r\n絶対にできないじゃない？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020120,
    "speaker": "冬優子",
    "text": "だから、今──\r\nできる準備を、やれるだけやっておかなくちゃって",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020120"
  },
  {
    "speaker": "プロデューサー",
    "text": "──うん\r\nわかってるつもりだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020130,
    "speaker": "冬優子",
    "text": "……ふふっ、そうね",
    "charAnim1": "wait5",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020130"
  },
  {
    "id": 1018004020140,
    "speaker": "冬優子",
    "text": "お人よしにも、こうやって──",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020140"
  },
  {
    "id": 1018004020150,
    "speaker": "冬優子",
    "text": "あんたがやらなくていいことにも、\r\n巻き込まれてるわけだしね？",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺としては、冬優子を支えることは、\r\nやらなくていいことには入ってないんだけどな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020160,
    "speaker": "冬優子",
    "text": "……",
    "charAnim1": "shrug2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020160",
    "autoWaitTime": 2300
  },
  {
    "id": 1018004020170,
    "speaker": "冬優子",
    "text": "あんたってほーんと世話焼き体質\r\n損しないように気を付けなさいよ？",
    "charAnim1": "wait4",
    "charAnim2": "face_jito",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "善処するよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020180,
    "speaker": "冬優子",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020180"
  },
  {
    "id": 1018004020190,
    "speaker": "冬優子",
    "text": "まぁ安心しなさい？　あんたの働きに対して、\r\nふゆはちゃんとご褒美を用意してるから",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、なんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020200,
    "speaker": "冬優子",
    "text": "──あんたも頑張ってくれた分\r\n最高のライブを約束するわ",
    "charAnim1": "anger3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020200"
  },
  {
    "id": 1018004020210,
    "speaker": "冬優子",
    "text": "どう？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "──ああ、十分すぎるぐらいのご褒美だ\r\n楽しみにしてるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
