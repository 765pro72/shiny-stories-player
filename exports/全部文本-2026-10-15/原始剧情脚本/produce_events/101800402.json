    "voice": "produce_events/101800402/1018004020230"
  },
  {
    "id": 1018004020240,
    "speaker": "冬優子",
    "text": "既存のファンに喜んでもらうのはもちろんだけど、\r\n新しいファンを呼び込む努力だってしていかなくちゃ",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020240"
  },
  {
    "id": 1018004020250,
    "speaker": "冬優子",
    "text": "歌番組なら大勢見るし、他アーティスト目当てだって、\r\nふゆに興味持ってもらうことも──……",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020250"
  },
  {
    "speaker": "プロデューサー",
    "text": "──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
