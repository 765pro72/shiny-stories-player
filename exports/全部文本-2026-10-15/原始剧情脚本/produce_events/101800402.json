    "bgEffect": "fade",
    "bgEffectTime": 600,
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1018004020040,
    "speaker": "冬優子",
    "text": "──！\r\n今日のラジオ、ワンマンの告知アリなのね？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020040"
  },
  {
    "id": 1018004020050,
    "speaker": "冬優子",
    "text": "やるじゃない、プロデューサー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800402/1018004020050"
  },
  {
