    "waitType": "time",
    "waitTime": 2500
  },
  {
    "id": 1018004020060,
    "speaker": "冬優子",
    "text": "……悪いわね",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
