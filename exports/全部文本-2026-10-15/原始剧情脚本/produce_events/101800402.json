  {
    "id": 1018004020220,
    "speaker": "冬優子",
    "text": "──オーディション？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
