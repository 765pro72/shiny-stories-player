    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101800402/1018004020220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n合格者には歌番組でのパフォーマンスの権利が与えられる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ユニット名義じゃなくて、\r\nソロでの参加になるんだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018004020230,
    "speaker": "冬優子",
    "text": "いいじゃない\r\nそれでも十分、宣伝になるはずだわ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
