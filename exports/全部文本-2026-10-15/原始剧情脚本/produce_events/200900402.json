    "textFrame": "001",
    "voice": "produce_events/200900402/2009004020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ……そうか、もうこんな時間か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "気づかなくてごめん\r\nそろそろ昼ごはんを食べようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004020060,
    "speaker": "果穂",
    "text": "わあ、いいんですかっ！？\r\nえへへ、どれにしようかな～",
