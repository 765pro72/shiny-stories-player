    "textFrame": "001",
    "voice": "produce_events/200900402/2009004020020"
  },
  {
    "speaker": "プロデューサー",
    "text": "無理はしない方がいい\r\n今日はここまでにして、もう帰ろうか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009004020030,
    "speaker": "果穂",
    "text": "ちがうんです、その……",
