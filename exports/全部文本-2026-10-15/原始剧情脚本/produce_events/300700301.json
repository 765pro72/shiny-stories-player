      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 3007003010600,
    "speaker": "結華",
    "text": "（……どうしよう、自覚なかった）",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
