      "y": 640,
      "order": 2
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "id": 3007003010500,
    "speaker": "結華",
    "text": "こがたんには敵わないねー",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 310,
      "y": 640,
      "order": 1
    },
    "voice": "produce_events/300700301/3007003010500",
    "charAnim3Loop": false
  },
  {
    "id": 3007003010510,
    "speaker": "恋鐘",
    "text": "それってもしかして……うちが最強って話たい？",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010510"
  },
  {
    "id": 3007003010520,
    "speaker": "結華",
    "text": "やだなぁ、そんなの聞くまでもないでしょ？\r\n自分でもわかってるくせに、こがたんってばほしがりさん",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010520"
  },
  {
    "id": 3007003010530,
    "speaker": "恋鐘",
    "text": "ふふー。やーっぱり、うちにアイドルさせたら\r\n右に出るもんはおらんとね！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010530"
  },
  {
    "id": 3007003010540,
    "speaker": "結華",
    "text": "そうそう、こがたんはきっと、ファンのみんなを\r\nまとめて元気にできちゃうすごいアイドルになれるよ",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010540"
  },
  {
    "id": 3007003010550,
    "speaker": "結華",
    "text": "一緒にいる三峰たちにだって\r\nパワーをくれるくらいなんだからさ",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010550"
  },
  {
    "id": 3007003010560,
    "speaker": "恋鐘",
    "text": "もっちろん！　うちはここから、長崎にも、世界にも、\r\nうちの姿で元気を届けていくんやからね！",
    "charAnim1": "smile4",
    "charAnim2": "face_doya",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010560"
  },
  {
    "id": 3007003010570,
    "speaker": "結華",
    "text": "あはは、すごい目標だ。いやぁほんと、\r\nアイドルしてるこがたんはいつでも楽しそうだよ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010570"
  },
  {
    "id": 3007003010580,
    "speaker": "恋鐘",
    "text": "でも、そう言うとる結華も、\r\nすっごく楽しそうにしてるとよ？　本気なんやね！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010580"
  },
  {
    "id": 3007003010590,
    "speaker": "結華",
    "text": "！",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_a",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
