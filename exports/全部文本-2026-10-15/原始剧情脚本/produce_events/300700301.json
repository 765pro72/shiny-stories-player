    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010610"
  },
  {
    "id": 3007003010620,
    "speaker": "結華",
    "text": "（……うーん……なんだか、不覚って感じ）",
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger_s",
    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300700301/3007003010620"
  },
  {
