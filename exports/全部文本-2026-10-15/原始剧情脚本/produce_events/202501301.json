    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202501301/2025013010060"
  },
  {
    "speaker": "監督",
    "text": "緋田さんはスターになっても変わらないですねぇ\r\nこの後はすぐにアメリカに帰るんですか？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile1_s",
