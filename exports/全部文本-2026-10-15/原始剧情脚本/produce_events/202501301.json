  },
  {
    "speaker": "監督",
    "text": "すみませんね、忙しいのに",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2025013010060,
    "speaker": "美琴",
    "text": "こちらこそ\r\n地元で仕事の機会をいただけて、嬉しいです",
