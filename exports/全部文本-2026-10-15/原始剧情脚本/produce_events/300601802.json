    "text": "それも面白いかもー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020110"
  },
  {
    "id": 3006018020120,
    "speaker": "霧子",
    "text": "どんなお店……\r\nあるかな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020120"
  },
  {
    "id": 3006018020130,
    "speaker": "咲耶",
