  {
    "id": 3006018020001,
    "speaker": "一同",
    "text": "ん～～～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020001"
  },
  {
    "id": 3006018020010,
    "speaker": "恋鐘",
    "text": "風の気持ちよか～～～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020010"
  },
  {
    "id": 3006018020020,
    "speaker": "霧子",
    "text": "ふふっ……\r\n楽しいね……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020020"
  },
  {
    "textFrame": "off",
    "bg": "00484",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1400,
    "bgEffectTime": 1400
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 3006018020030,
    "speaker": "結華",
    "text": "自力で風を切って走るのも最高ー！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020030"
  },
  {
    "id": 3006018020040,
    "speaker": "結華",
    "text": "……でも動いてるからお腹空いてきちゃった\r\nどっかでお昼にしなーい？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020040"
  },
  {
    "id": 3006018020050,
    "speaker": "咲耶",
    "text": "ああ、でも……\r\nこのコースは下調べをしていなくて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020050"
  },
  {
    "id": 3006018020060,
    "speaker": "咲耶",
    "text": "どこかにいいお店があるといいのだけれど────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020060"
  },
  {
    "id": 3006018020070,
    "speaker": "摩美々",
    "text": "まぁ、走ってれば何かあるでしょー",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020070"
  },
  {
    "id": 3006018020080,
    "speaker": "恋鐘",
    "text": "うん～！　成り行きに任せんね～？\r\nそいもきっと楽しかよ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020080"
  },
  {
    "id": 3006018020090,
    "speaker": "咲耶",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300601802/3006018020090"
  },
  {
    "textFrame": "off",
