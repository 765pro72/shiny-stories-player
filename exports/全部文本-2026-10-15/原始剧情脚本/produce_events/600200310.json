    },
    "voice": "produce_events/600200310/6002003100010"
  },
  {
    "id": 6002003100020,
    "speaker": "灯織",
    "text": "力不足どころか、身の程知らずという方が\r\n妥当だと思います",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100020"
  },
  {
    "id": 6002003100030,
    "speaker": "灯織",
    "text": "優勝を狙う、なんて\r\n一体どの口が言うんだろうって──",
    "charAnim1": "shy2",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100030"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんな悲しいこと言わないでくれ\r\n俺は全然思ってないよ",
    "charAnim1": "wait1",
    "charAnim2": "face_anger",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織は、自分に対して厳しすぎるなぁ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 6002003100040,
    "speaker": "灯織",
    "text": "ですが……！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100040"
  },
  {
    "id": 6002003100050,
    "speaker": "灯織",
    "text": "応援が少なかったのは、\r\n私が応援されるに値しなかったということだと思います",
    "charAnim1": "sad3",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100050"
  },
  {
    "id": 6002003100060,
    "speaker": "灯織",
    "text": "決勝前の自分が、いかに調子に乗っていたか",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100060"
  },
  {
    "id": 6002003100070,
    "speaker": "灯織",
    "text": "恥ずかしくて恥ずかしくて……",
    "charAnim1": "smile2",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_anger",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/600200310/6002003100070"
  },
  {
    "speaker": "プロデューサー",
    "text": "違うよ、灯織",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "灯織は決勝まで勝ち上がってきたんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "戦うだけの力が、ちゃんとあった",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今回は、色んな巡りあわせが悪かっただけ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それだけだから……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
