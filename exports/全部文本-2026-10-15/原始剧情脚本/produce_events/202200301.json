    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "この店の外観\r\nレトロな感じっていうか、雰囲気があるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022003010110,
