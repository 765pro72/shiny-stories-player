    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010150"
  },
  {
    "id": 2022003010160,
    "speaker": "小糸",
    "text": "ちょっと、見てただけですし……",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010160"
  },
  {
