    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ほら、パフェとか甘いものが多いけど\r\nグラタンとかサンドイッチもあるみたいだぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022003010150,
    "speaker": "小糸",
    "text": "い、いえ\r\nあの、大丈夫です",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
