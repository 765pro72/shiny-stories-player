    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/202200301/2022003010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺も\r\nどんな店なのか気になってきたからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょうど腹も減ってきたし……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022003010140,
    "speaker": "小糸",
    "text": "あ……\r\n……でも",
