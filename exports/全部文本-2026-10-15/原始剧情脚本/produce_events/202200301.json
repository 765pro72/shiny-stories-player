    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010170"
  },
  {
    "id": 2022003010180,
    "speaker": "小糸",
    "text": "ゆ、夕飯は家で食べるって\r\n言ってきちゃってて……",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010180"
  },
  {
    "id": 2022003010190,
    "speaker": "小糸",
    "text": "ご飯、食べられなくなったら\r\nだめなので……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202200301/2022003010190"
  },
  {
    "id": 2022003010200,
    "speaker": "小糸",
    "text": "………………",
