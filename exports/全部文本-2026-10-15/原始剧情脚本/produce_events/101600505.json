    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050260"
  },
  {
    "id": 1016005050270,
    "speaker": "千雪",
    "text": "大切なものを、大好きな世界を、\r\n悪役にしてたことも気付かなくて……",
    "charAnim1": "wait3",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050270"
  },
  {
    "charAnim1": "shy2",
    "charAnim2": "face_close",
