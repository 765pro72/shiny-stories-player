    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 1016005050230,
    "speaker": "千雪",
    "text": "……ごめんね、ごめんなさい",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
