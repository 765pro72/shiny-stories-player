  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "千雪の母",
    "text": "『その代わり、\r\n決めたら踏ん張ってくれるのが、うちの千雪』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "千雪の母",
    "text": "『アイドル、頑張んなさいよ！』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050190,
    "speaker": "千雪",
    "text": "うん……！！\r\nありがとね、お母さん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050190"
  },
