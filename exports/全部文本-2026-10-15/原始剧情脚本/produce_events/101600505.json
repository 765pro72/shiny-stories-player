  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "千雪の母",
    "text": "『そうよ、それにね』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "千雪の母",
    "text": "『やいやい言ったこともあったけど──\r\nもう大人なんだもの、私はアンタの判断を信じてる』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050170,
    "speaker": "千雪",
    "text": "！　お母さん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050170"
  },
  {
    "speaker": "千雪の母",
    "text": "『だいたいアンタは、私がどうこういったところで\r\n一度決めたら動かない子だったからね……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050180,
    "speaker": "千雪",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050180"
  },
  {
    "textFrame": "off",
    "bg": "00425",
