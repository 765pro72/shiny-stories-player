  {
    "speaker": "千雪の母",
    "text": "『あら、千雪\r\nどうしたの、この間電話で話したばっかりじゃない』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050100,
    "speaker": "千雪",
    "text": "えっとね、実は……\r\n雑貨屋さんを辞めることにして、それで……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050100"
  },
  {
    "speaker": "千雪の母",
    "text": "『そうなのね\r\n……それで、こっちに帰ってくるの？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050110,
    "speaker": "千雪",
    "text": "ううん\r\n…………あのね、私、アイドルになろうと思ってて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050110"
  },
  {
    "speaker": "千雪の母",
    "text": "『え？　何、聞き違い？\r\nアイドル……？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050120,
    "speaker": "千雪",
    "text": "大丈夫、アイドルよ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050120"
  },
  {
    "textFrame": "off",
    "bg": "00440",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 1016005050130,
    "speaker": "千雪",
    "text": "あの、でも、騙されたりはしてないの\r\nレッスンとか、もう受けてていくつか仕事もしてて……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050130"
  },
  {
    "speaker": "千雪の母",
    "text": "『……本当に本当なのね？\r\n驚いた、そういう話ならもっと早く教えなさいよ』",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "fade_out"
  },
  {
    "speaker": "千雪の母",
    "text": "『録画とかしたいじゃない！\r\n何、雑誌とかに出てたりとかもするの？』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050140,
    "speaker": "千雪",
    "text": "う、うん……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050140"
  },
  {
    "textFrame": "off",
    "bg": "00627",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 1016005050150,
    "speaker": "千雪",
    "text": "ごめん、反対されると思ってた……\r\nアイドルなんてやっていけるはずがないって……",
    "charAnim1": "shy1",
    "charAnim2": "face_sad",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600505/1016005050150"
  },
  {
    "speaker": "千雪の母",
    "text": "『そりゃ、キラキラしたイメージと違って\r\n実際になってみれば色々苦労はあるんだろうけど……』",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "千雪の母",
    "text": "『そんなのどんな仕事も同じでしょ』",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "003",
    "bgm": "071"
  },
  {
    "id": 1016005050160,
    "speaker": "千雪",
    "text": "……！\r\nそ、そうか……そうだよね",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050160"
  },
  {
    "charAnim1": "wait",
    "charLipAnim": "lip_wait_s",
