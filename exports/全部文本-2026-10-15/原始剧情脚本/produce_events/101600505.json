  },
  {
    "id": 1016005050200,
    "speaker": "千雪",
    "text": "ねえ、ハリネズミくん\r\nみんな、思ったより応援してくれるね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050200"
  },
  {
    "id": 1016005050210,
    "speaker": "千雪",
    "text": "私、『大人』になろうとし過ぎてたのかな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050210"
  },
  {
    "id": 1016005050220,
    "speaker": "千雪",
    "text": "お母さんは、大人って言ってくれたのに……\r\nおかしいね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050220"
  },
  {
    "textFrame": "off",
