  {
    "speaker": "雑貨店店主",
    "text": "千雪さんのことは、\r\nだいぶ手をかけて育てたつもりだったから……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "雑貨店店主",
    "text": "正直、残念だ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1016005050040,
    "speaker": "千雪",
