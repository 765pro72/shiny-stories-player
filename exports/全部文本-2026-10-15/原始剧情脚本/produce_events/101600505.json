    },
    "voice": "produce_events/101600505/1016005050230"
  },
  {
    "id": 1016005050240,
    "speaker": "千雪",
    "text": "あの小さな声はあなたでも、お母さんでもなくて\r\n怖がりで、背伸びしてる私だった……",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050240"
  },
  {
    "id": 1016005050250,
    "speaker": "千雪",
    "text": "世間の目、とか\r\nもっとちゃんとしなきゃ、とか……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600505/1016005050250"
  },
  {
    "id": 1016005050260,
    "speaker": "千雪",
    "text": "そんなことばっかり考えて──",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charAnim4": "blank",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
