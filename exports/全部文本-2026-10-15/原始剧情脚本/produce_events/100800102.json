    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020090"
  },
  {
    "id": 1008001020100,
    "speaker": "霧子",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
