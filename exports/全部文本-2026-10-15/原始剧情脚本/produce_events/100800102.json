    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほど……\r\nいろいろやってくれてるってことなんだな、きっと",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001020170,
    "speaker": "霧子",
    "text": "い、いえ……！",
    "charAnim1": "no",
    "charAnim2": "face_shy",
    "charAnim1Loop": false,
    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
