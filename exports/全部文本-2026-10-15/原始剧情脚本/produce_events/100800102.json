    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まただ、包帯のところをつかんで……）",
