    "charLipAnim": "lip_surp",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020110"
  },
  {
    "id": 1008001020120,
    "speaker": "霧子",
    "text": "みんなの足を引っ張ったりしたらって思うと、\r\nせめて……こんな形でも、みんなの役に立ちたくて……！",
