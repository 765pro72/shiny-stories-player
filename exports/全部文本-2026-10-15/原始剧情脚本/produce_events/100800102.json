    "charLipAnim": "lip_anger",
    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020080"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、それはさすがに考えすぎじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001020090,
    "speaker": "霧子",
    "text": "そ、そう……でしょうか",
