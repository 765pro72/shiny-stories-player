    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020170"
  },
  {
    "id": 1008001020180,
    "speaker": "霧子",
    "text": "でも、あんまり……\r\nそんなふうに言ってもらったこと……なくて……",
