    "charLabel": "kiriko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100800102/1008001020100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……どうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1008001020110,
    "speaker": "霧子",
    "text": "わ、わたし、自信がなくて……",
