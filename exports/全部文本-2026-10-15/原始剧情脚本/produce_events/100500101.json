    "voice": "produce_events/100500101/1005001010150"
  },
  {
    "id": 1005001010160,
    "speaker": "？？？",
    "text": "お兄さんといると面白そうなのでー、\r\nアイドルになってあげてもいいかなぁって思いましたぁ",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_smile",
