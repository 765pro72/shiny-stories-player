  },
  {
    "speaker": "プロデューサー",
    "text": "よ、よろしくお願いします……\r\nって、そうじゃなくて……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "どうして、ここに……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger1_s",
    "charLabel": "mikoto",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1025001010030,
    "speaker": "美琴",
    "text": "…………私、前に組んでいた\r\nユニットでの活動が終わって",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010030"
  },
  {
    "id": 1025001010040,
    "speaker": "美琴",
    "text": "それから所属していた事務所も退所して、\r\n新しい所属先を探していたの",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010040"
  },
  {
    "id": 1025001010050,
    "speaker": "美琴",
    "text": "だから、２８３プロの\r\nオーディションを受けたくて",
    "charAnim1": "surp3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010050"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ…………！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001010060,
    "speaker": "美琴",
    "text": "問い合わせたら\r\n事務所に呼んでもらえたから",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010060"
  },
  {
    "id": 1025001010070,
    "speaker": "美琴",
    "text": "ここでプロデューサーを待つようにって\r\n天井社長に言われたんだけど……",
    "charAnim1": "think2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010070"
  },
  {
    "id": 1025001010080,
    "speaker": "美琴",
    "text": "君がその、プロデューサー？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "mikoto",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010080"
  },
  {
