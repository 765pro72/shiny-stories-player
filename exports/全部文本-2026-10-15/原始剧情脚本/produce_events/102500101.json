  {
    "speaker": "プロデューサー",
    "text": "──失礼します",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00006",
    "bgEffect": "fade",
    "se": "0113",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "社長、会わせたい人がいるって\r\n一体──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1025001010010,
    "speaker": "？？？",
    "text": "天井社長なら外せない別件があるって\r\n事務所を出られたけど",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102500101/1025001010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "え…………\r\n君は確か……！",
