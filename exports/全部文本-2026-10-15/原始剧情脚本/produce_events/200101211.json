  {
    "speaker": "真乃",
    "text": "『お疲れさまです、プロデューサーさん\r\n見てくださってありがとうございます』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "005"
  },
  {
    "speaker": "真乃",
    "text": "『今日は出張の日だと思うんですけれど、\r\n大丈夫でしたでしょうか？』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "『おう、早めに空港に来てロビーの大きなテレビで見たよ\r\nたくさんの人が見てくれてて誇らしくなった』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "真乃",
    "text": "『わ、そうだったんですね』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "真乃",
    "text": "『収録の最中はとにかく夢中だったので……』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "『短い時間の中で情報をちゃんと伝えつつ、\r\nMCさんとのやり取りも、しっかりできてたって思うよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "真乃",
    "text": "『ありがとうございます\r\nそう言っていただけて、とってもうれしいです^^』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "真乃",
    "text": "『前もってイルミネーションを見に行けたので\r\n慌てずにお話しできたような気がします』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "真乃",
    "text": "『プロデューサーさんのおかげです』",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "『どういたしまして\r\nでも、それも真乃が行きたいって思ってくれたからだよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『だから、これからも\r\n行きたいとこでもなんでも、言ってくれな！』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "真乃",
    "text": "『はいっ\r\nありがとうございます』",
    "textCtrl": "p",
    "textFrame": "001"
  },
