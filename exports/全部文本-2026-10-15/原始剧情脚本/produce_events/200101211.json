  },
  {
    "id": 2001012110080,
    "speaker": "真乃",
    "text": "１時間に１度、イルミネーションの光が\r\n切り替わるタイミングです……っ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101211/2001012110080"
  },
  {
    "id": 2001012110090,
    "speaker": "真乃",
    "text": "まるで魔法がかけられたみたいで\r\nとっても素敵なんですっ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101211/2001012110090"
  },
  {
    "id": 2001012110100,
    "speaker": "真乃",
    "text": "よかったら、大切な人との思い出に、\r\nみなさんにもぜひ見に行っていただけたらと思いますっ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101211/2001012110100"
  },
  {
    "id": 2001012110110,
    "speaker": "真乃",
    "text": "期間限定ですので、お見逃しなくです……っ",
