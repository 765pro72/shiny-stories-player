  },
  {
    "id": 2001012110070,
    "speaker": "真乃",
    "text": "特におすすめなのは……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
