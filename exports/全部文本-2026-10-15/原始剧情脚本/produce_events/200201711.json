      "time": 100
    },
    "voice": "produce_events/200201711/2002017110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "そういえば、イルミネ結成時くらいの頃にって\r\n話してくれたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "夢って、あれだけじゃなかったのか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110020,
    "speaker": "灯織",
    "text": "そうですね",
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "どんな夢だったんだ？　楽しかったこととか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110030,
    "speaker": "灯織",
    "text": "いえ、逆です",
    "charAnim1": "surp2",
    "charAnim2": "face_serious",
    "charAnim3": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 600
  },
  {
    "id": 2002017110040,
    "speaker": "灯織",
    "text": "いいリアクションをありがとうございます",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110040"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_close",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "bgm": "fade_out"
  },
  {
    "textFrame": "off",
    "se": "1542",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2002017110050,
    "speaker": "灯織",
    "text": "まぁ、内容についてはすでに話したようなものなんですけど",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201711/2002017110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……？\r\nどういうことだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110060,
    "speaker": "灯織",
    "text": "会話メモの話をしたことがありますよね",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "089",
    "voice": "produce_events/200201711/2002017110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "覚えてるよ\r\n俺の好きなものの話も久しぶりにしたよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110070,
    "speaker": "灯織",
    "text": "ふふふ、はい",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110070"
  },
  {
    "id": 2002017110080,
    "speaker": "灯織",
    "text": "実はあれもなんです\r\nあの日は中学の頃のメモの夢を見て……",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110080"
  },
  {
    "id": 2002017110090,
    "speaker": "灯織",
    "text": "あとは……\r\nオーブンの予熱の話をした日もあったじゃないですか",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……俺がやらかしたやつな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110100,
    "speaker": "灯織",
    "text": "予熱くらいやらかしには入らないですよ",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110100"
  },
  {
    "id": 2002017110110,
    "speaker": "灯織",
    "text": "あの日も、小学校の頃に料理で失敗した夢を見ました\r\n起きた時に少しへこんで……",
    "charAnim1": "sad3",
    "charAnim2": "face_close2",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110110"
  },
  {
    "id": 2002017110120,
    "speaker": "灯織",
    "text": "だから、結構驚いたんですよ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110120"
  },
  {
    "id": 2002017110130,
    "speaker": "灯織",
    "text": "プロデューサーとのやりとりが\r\nなんだか『今は違うでしょ』って言われているみたいで",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110140,
    "speaker": "灯織",
    "text": "私は根がネガティブなので、\r\nよく過去やってしまったことを反芻してへこむんです",
    "charAnim1": "anger1",
    "charAnim2": "face_anger",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110140"
  },
  {
    "id": 2002017110150,
    "speaker": "灯織",
    "text": "そのたびに、色んな人から色んな言葉をかけてもらって",
    "charAnim1": "wait1",
    "charAnim2": "face_close2",
    "charAnim4": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110150"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hiori",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "bg": "00465",
    "bgEffect": "fade",
    "se": "0353",
    "waitType": "time",
    "waitTime": 2000,
    "bgEffectTime": 1000
  },
  {
    "id": 2002017110160,
    "speaker": "灯織",
    "text": "その言葉に納得もするしありがたさも感じます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110160"
  },
  {
    "id": 2002017110170,
    "speaker": "灯織",
    "text": "今回もそうですよね\r\nそうとは知らないまま、プロデューサーが言葉をくれて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110170"
  },
  {
    "id": 2002017110180,
    "speaker": "灯織",
    "text": "なのに、またきっと同じことを繰り返して\r\n落ち込むんです……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110180"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00296",
    "bgEffect": "fade",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500,
    "bgEffectTime": 800
  },
  {
    "id": 2002017110190,
    "speaker": "灯織",
    "text": "すみません、何か言葉をかけてほしい……\r\nみたいな空気を出してしまいました",
    "charAnim1": "smile1",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200201711/2002017110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110200,
    "speaker": "灯織",
    "text": "全然、そういう意味じゃなくて",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110200"
  },
  {
    "id": 2002017110210,
    "speaker": "灯織",
    "text": "なんて言えば……\r\n報告……というか……",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110210"
  },
  {
    "id": 2002017110220,
    "speaker": "灯織",
    "text": "今がいい方向に向かっているからこそ\r\n昔のことがことさら悪く思えてくるというか……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110220"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……それは、なんだかわかる気がするな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110230,
    "speaker": "灯織",
    "text": "……",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110230"
  },
  {
    "id": 2002017110240,
    "speaker": "灯織",
    "text": "でも、悪いことばかりでもなかったなって\r\n思ったんです",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110240"
  },
  {
    "speaker": "プロデューサー",
    "text": "もしかして……絵本か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110250,
    "speaker": "灯織",
    "text": "え、よくわかりましたね",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charAnim3": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110250"
  },
  {
    "speaker": "プロデューサー",
    "text": "最近した昔の話っていえば、\r\nあの仕事が印象深かったからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あの日も夢を見たのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002017110260,
    "speaker": "灯織",
    "text": "いいえ",
    "charAnim1": "wait",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201711/2002017110260"
  },
  {
    "id": 2002017110270,
    "speaker": "灯織",
    "text": "でも、悪いことばかり夢に見たのは、\r\nあの日のためだったのかなとは",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charAnim3": "blank",
