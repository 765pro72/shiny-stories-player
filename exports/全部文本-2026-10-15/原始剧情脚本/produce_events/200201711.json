  {
    "id": 2002017110010,
    "speaker": "灯織",
    "text": "最近、昔の夢をよく見るんです",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
