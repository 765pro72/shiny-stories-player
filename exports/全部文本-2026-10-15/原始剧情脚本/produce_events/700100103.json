[
  {
    "bgm": "024",
    "bg": "00002"
  },
  {
    "charType": "characters",
    "charId": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "真乃、やったぞ！\r\n二次審査も突破だ！",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait",
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "id": 7001001030010,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわわ……本当ですか、プロデューサーさんっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/700100103/7001001030010"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、間違いない\r\n正真正銘、櫻木真乃が二次審査通過だ！",
    "textCtrl": "p"
  },
  {
    "id": 7001001030020,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "……うれしいですっ\r\n二次審査まで通過するなんて……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030020"
  },
  {
    "id": 7001001030030,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "お母さんとお父さんに受かったって話さないと\r\nそれとピーちゃんにも？　あとは……ええっと……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait1",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/700100103/7001001030030"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "はは、うれしそうで何よりだ\r\n本当におめでとう。よくやったな！",
    "textCtrl": "p"
  },
  {
    "id": 7001001030040,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ありがとうございます、プロデューサーさんっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "hello",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030040"
  },
  {
    "id": 7001001030050,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "あ、でもすみません……\r\nちょっと舞い上がりすぎました",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "sad1",
    "charLipAnim": "lip_trouble",
    "voice": "produce_events/700100103/7001001030050"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "いいや、通過を素直に喜べるのはいいことだ\r\nアイドルとして成長してるってことだよ",
    "textCtrl": "p"
  },
  {
    "id": 7001001030060,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "そうだったんですねっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030060"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、真乃はどんどんアイドルらしくなってる\r\n実力がついて、ファンも着実に増えてるしな",
    "textCtrl": "p"
  },
  {
    "id": 7001001030070,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわぁ……プロデューサーさんにそう言ってもらえると\r\nすごくうれしいですっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030070"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、真乃はもっと自信を持っていいよ\r\nこの調子なら、次の審査も必ず通過できるからな",
    "textCtrl": "p"
  },
  {
    "id": 7001001030080,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "三次選考……審査はどんどん厳しくなるんですよね？\r\n私、通過できるのかな……",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "voice": "produce_events/700100103/7001001030080"
  },
  {
    "id": 7001001030090,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "ほわっ、だめだめっ\r\n私が今からこんなに弱気じゃいけませんね",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "surp2",
    "charLipAnim": "lip_anger",
    "voice": "produce_events/700100103/7001001030090"
  },
  {
    "id": 7001001030100,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "せっかくプロデューサーさんやファンのみなさんが\r\n応援してくれてるんですから",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030100"
  },
  {
    "id": 7001001030110,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "……私、いつも多くの方から勇気をもらってます",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030110"
  },
  {
    "id": 7001001030120,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "いつも勇気をくれるみなさんに\r\n私からも何かを届けたいです",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030120"
  },
  {
    "id": 7001001030130,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "私、もっともっと頑張りますねっ\r\n支えてくれるみなさんのためにも",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030130"
  },
  {
    "id": 7001001030140,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "それが……恩返しになると思いますから",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030140"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "ああ、その気持ちは、俺にもファンのみんなにも\r\n伝わってる",
    "textCtrl": "p"
  },
  {
    "textFrame": "002",
    "speaker": "プロデューサー",
    "text": "これからも一緒に頑張ろう、真乃",
    "textCtrl": "p"
  },
  {
    "id": 7001001030150,
    "textFrame": "001",
    "speaker": "真乃",
    "text": "はいっ　プロデューサーさんっ",
    "textCtrl": "p",
    "charLabel": "mano",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "voice": "produce_events/700100103/7001001030150"
  },
  {},
  {
    "label": "end"
  }
]