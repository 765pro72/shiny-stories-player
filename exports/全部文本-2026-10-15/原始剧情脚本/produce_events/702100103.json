  {
    "speaker": "プロデューサー",
    "text": "円香宛のファンレターだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030020,
    "speaker": "円香",
    "text": "え……",
    "charAnim1": "surp2",
    "charAnim2": "face_anger",
    "charAnim4": "eye_front",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030020"
  },
  {
    "speaker": "プロデューサー",
    "text": "円香を応援してくれる人が、\r\n少しずつ増えている証だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030030,
    "speaker": "円香",
    "text": "ずいぶんな物好きですね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……少し、読み上げてみようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『円香さんの歌声、とっても素敵です』\r\n『聞いていると私も頑張ろうって思えます』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030040,
    "speaker": "円香",
    "text": "私も？",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030040"
  },
  {
    "speaker": "プロデューサー",
    "text": "『ライブで円香さんを見ると元気が出ます』\r\n『生命力に溢れている気がして……』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030050,
    "speaker": "円香",
    "text": "生命力……？",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "『円香さんならトップアイドルも夢じゃ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030060,
    "speaker": "円香",
    "text": "ああ、はい……もういいです\r\nよくわかりました",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030060"
  },
  {
    "id": 7021001030070,
    "speaker": "円香",
    "text": "この業界にいる人って、\r\nアイドルも、スタッフも、ファンも──",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charAnim4": "eye_right",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030070"
  },
  {
    "id": 7021001030080,
    "speaker": "円香",
    "text": "みんなエネルギッシュですよね",
    "charAnim2": "face_wait",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺はそういうところが好きなんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030090,
    "speaker": "円香",
    "text": "でしょうね、あなたと同じ人種なんですから",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、円香は少し苦手そうだよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030100,
    "speaker": "円香",
    "text": "……まあ\r\n悪どい人種よりは、ほんの少しだけマシですね",
    "charAnim1": "shy1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030100"
  },
  {
    "speaker": "プロデューサー",
    "text": "おや……ありがとう、嬉しいよ",
    "charAnim2": "face_wait",
    "charAnim4": "eye_front",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7021001030110,
    "speaker": "円香",
    "text": "……今ほど失言を後悔したことはありません",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "madoka",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/702100103/7021001030110"
  },
  {
    "speaker": "プロデューサー",
    "text": "残りのファンレターはどうする？\r\n家で読むなら持って帰ってもいいぞ",
    "charAnim4": "eye_right",
