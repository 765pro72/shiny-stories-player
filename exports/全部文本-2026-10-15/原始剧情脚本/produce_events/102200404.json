    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1022004040280,
    "speaker": "小糸",
    "text": "ちゃんと、ずっといい子でいないとって……\r\nもっと、もっとやらなきゃって、思ってるうちに",
