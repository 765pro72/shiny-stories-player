    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200404/1022004040280"
  },
  {
    "id": 1022004040290,
    "speaker": "小糸",
    "text": "求められている通りでいないと\r\n……そこに居ちゃいけないような気がして",
    "charAnim1": "sad2",
    "charLipAnim": "lip_shy",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102200404/1022004040290"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022004040300,
    "speaker": "小糸",
    "text": "わ、わたし……同じようなことを言ってばっかりで\r\n昔から変わってないのかもしれないですね",
