    "textFrame": "001",
    "voice": "produce_events/102200404/1022004040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、『小糸０歳』って書いてある\r\nまだ生まれたばっかりって感じだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022004040170,
    "speaker": "小糸",
    "text": "ほ、ほんとだ……\r\n全然わたしっぽくないですね……",
