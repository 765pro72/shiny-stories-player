    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2500
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか？　目とか鼻とか\r\nなんとなく小糸だなって思うけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1022004040180,
    "speaker": "小糸",
    "text": "そ、そうですかね……？",
