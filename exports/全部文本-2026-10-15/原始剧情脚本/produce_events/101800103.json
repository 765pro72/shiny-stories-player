    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800103/1018001030080"
  },
  {
    "speaker": "カメラマン",
    "text": "……君は笑顔を作るのは上手いよ",
    "charAnim2": "face_sad",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
