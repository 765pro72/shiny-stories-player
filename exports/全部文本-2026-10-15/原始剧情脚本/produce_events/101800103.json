    "charAnim2": "face_anger",
    "charLipAnim": "lip_anger",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101800103/1018001030140"
  },
  {
    "id": 1018001030150,
    "speaker": "冬優子",
    "text": "ほんとの顔……ほんとの笑顔……\r\nそれのどこがいいの！",
