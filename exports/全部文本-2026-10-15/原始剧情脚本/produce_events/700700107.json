    "textFrame": "001",
    "voice": "produce_events/700700107/7007001070010"
  },
  {
    "speaker": "プロデューサー",
    "text": "……『W.I.N.G.』出場決定だ！　おめでとう、結華！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 7007001070020,
    "speaker": "結華",
    "text": "ほっ、ほんと！？　やったあ！！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile",
