  {
    "id": 2016004020030,
    "speaker": "千雪",
    "text": "見てください、プロデューサーさんっ\r\nステージクリアですよ！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "004",
    "voice": "produce_events/201600402/2016004020030"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、ありがとう……\r\n千雪のおかげだよ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020040,
    "speaker": "千雪",
    "text": "いえいえ、協力プレイですから……！",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020040"
  },
  {
    "speaker": "プロデューサー",
    "text": "……にしても……意外だなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020050,
    "speaker": "千雪",
    "text": "え？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……いや、\r\nこういうの、得意なんだなと思って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020060,
    "speaker": "千雪",
    "text": "……前に、お仕事でこのゲームセンターに来た時に\r\n甜花ちゃんに教えてもらったことがあって",
    "charAnim1": "surp1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020060"
  },
  {
    "id": 2016004020070,
    "speaker": "千雪",
    "text": "それが、すっごく楽しかったので……\r\nちょっとだけひとりで練習したんです",
    "charAnim2": "face_wait",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020070"
  },
  {
    "speaker": "プロデューサー",
    "text": "甜花仕込みだったか……\r\nどうりで俺よりも上手いわけだ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020080,
    "speaker": "千雪",
    "text": "ふふっ、そんなこと……",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020080"
  },
  {
    "id": 2016004020090,
    "speaker": "千雪",
    "text": "……私も最初の時は本当にだめだめだったんですけど\r\nコツを掴めば案外できちゃうものなんですよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020090"
  },
  {
    "speaker": "プロデューサー",
    "text": "コツ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020100,
    "speaker": "千雪",
    "text": "えっと……例えば──",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020100"
  },
  {
    "id": 2016004020110,
    "speaker": "千雪",
    "text": "脇をしめて、両目で対象を捉える",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "脇をしめて、両目で対象を……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020120,
    "speaker": "千雪",
    "text": "そうそう、そんな感じです！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020120"
  },
  {
    "id": 2016004020130,
    "speaker": "千雪",
    "text": "そして銃が安定したら……バーン！",
    "charAnim1": "wait3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "……バーン！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020140,
    "speaker": "千雪",
    "text": "リロードも忘れずに",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお\r\nなるほど……わかりやすいな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020150,
    "speaker": "千雪",
    "text": "ふふ\r\nぜんぶ甜花ちゃん先生の受け売りですけど",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "よし、次はいけそうな気がしてきたぞ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2016004020160,
    "speaker": "千雪",
