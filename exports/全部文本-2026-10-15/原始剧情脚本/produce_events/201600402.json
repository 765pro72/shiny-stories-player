    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020310"
  },
  {
    "id": 2016004020320,
    "speaker": "千雪",
    "text": "甜花ちゃんと一緒に遊んだ時、\r\n私も甜花ちゃんのこと、頼もしいなって思ったんです",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
