    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020320"
  },
  {
    "id": 2016004020330,
    "speaker": "千雪",
    "text": "だから……甜花ちゃんに教えてもらったこと、\r\nちゃんとできてたみたいで嬉しいです",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201600402/2016004020330"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだったのか\r\n……それなら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "せっかく千雪に教えてもらったんだ\r\n俺もちゃんとできるようになって、頼もしくならなきゃな！",
