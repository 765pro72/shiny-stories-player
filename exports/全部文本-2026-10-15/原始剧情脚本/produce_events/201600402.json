  {
    "id": 2016004020170,
    "speaker": "千雪",
    "text": "はぁ……\r\n楽しかった～……！",
    "charAnim1": "shy1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
