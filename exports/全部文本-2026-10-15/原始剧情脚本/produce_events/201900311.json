    },
    "bgm": "002",
    "voice": "produce_events/201900311/2019003110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依？　そんなに嬉しそうにして\r\n何かあったのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110020,
    "speaker": "愛依",
    "text": "ありもあり！\r\nこの前の課題なんとか通った的なカンジ！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "良かったな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110030,
    "speaker": "愛依",
    "text": "プロデューサーのおかげじゃん！\r\nマジサンキュね！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺はちょっと手を貸しただけで\r\n本当に頑張ったのは愛依の方だよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110040,
    "speaker": "愛依",
    "text": "いやいや、そんなことないって～\r\nうちひとりだったら、絶対に詰んでたし",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110040"
  },
  {
    "id": 2019003110050,
    "speaker": "愛依",
    "text": "わかんないとこ、スラスラ～って答えてくれたじゃん\r\nプロデューサーって、頭いいよね～",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、昔やったのをたまたま覚えてただけで……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110060,
    "speaker": "愛依",
    "text": "マジで！？　ずっと覚えてられんのってすごいじゃん！",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_shy",
    "charLabel": "ai",
    "textCtrl": "r",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110060",
    "voiceKeep": true
  },
  {
    "speaker": "愛依",
    "text": "うちなんて、昨日のことも忘れる時あるし～",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001"
  },
  {
    "speaker": "プロデューサー",
    "text": "んん……？　それで大丈夫なのか……？　\r\n家で復習とかやってるか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110070,
    "speaker": "愛依",
    "text": "あ～……そういうのは全然やったことないな～\r\nテストさえどうにかなればいいやってカンジだし",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "試してみたらどうだ？\r\n覚えてられるようになるかもしれないぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110080,
    "speaker": "愛依",
    "text": "え～\r\nやったこと、もう１回するんでしょ？",
    "charAnim1": "wait4",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうしないと\r\n人間なかなか覚えないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110090,
    "speaker": "愛依",
    "text": "同じこと何回もやるのなんて\r\nつらくな～い？",
    "charAnim1": "anger2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110090"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなこと言ってると\r\n前みたいに、また補習の山に囲まれることになるぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110100,
    "speaker": "愛依",
    "text": "うっ……！　あれだけはもう勘弁！\r\n絶対にやりたくないって！",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110100"
  },
  {
    "speaker": "プロデューサー",
    "text": "だったら、同じことにならないよう\r\n毎日少しずつでも勉強しなきゃな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110110,
    "speaker": "愛依",
    "text": "ん～……でも、うち\r\nそういうの苦手だし……",
    "charAnim1": "sad1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110110"
  },
  {
    "id": 2019003110120,
    "speaker": "愛依",
    "text": "……",
    "charAnim2": "face_close",
    "charLipAnim": "lip_serious_s",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110120"
  },
  {
    "id": 2019003110130,
    "speaker": "愛依",
    "text": "……いや、うち\r\nちょっと頑張ってみる",
    "charAnim1": "wait4",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "やっぱり課題まみれはもう嫌か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110140,
    "speaker": "愛依",
    "text": "アハハ……\r\nそれもあるけどね～……",
    "charAnim1": "smile2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110140"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？\r\n違うのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110150,
    "speaker": "愛依",
    "text": "アイドルの仕事、せっかく増えてきたのに\r\n課題のせいで断ることになったら、マジダサいもんね",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110150"
  },
  {
    "id": 2019003110160,
    "speaker": "愛依",
    "text": "うち、今はアイドルに夢中だから\r\n絶対に邪魔されたくないし",
    "charAnim1": "wait3",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "愛依……",
    "charAnim2": "face_smile2",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110170,
    "speaker": "愛依",
    "text": "……よし！　うち、決めた！　\r\n今から復習やる！",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile2",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、いいじゃないか！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110180,
    "speaker": "愛依",
    "text": "早くやった方が忘れないカンジすんじゃん？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
