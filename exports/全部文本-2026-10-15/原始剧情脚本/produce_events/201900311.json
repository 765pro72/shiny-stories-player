  },
  {
    "speaker": "プロデューサー",
    "text": "いい調子だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2019003110210,
    "speaker": "愛依",
    "text": "これなら余裕じゃん？",
    "charAnim1": "shy1",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_wait",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201900311/2019003110210"
  },
  {
    "id": 2019003110220,
    "speaker": "愛依",
    "text": "よっしゃ！　このまま復習なんか終わらせて\r\n明日からちょー遊ぶぞ～！",
    "charAnim1": "anger2",
    "charAnim2": "face_smile1",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
