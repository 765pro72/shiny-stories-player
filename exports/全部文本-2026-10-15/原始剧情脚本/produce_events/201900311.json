  {
    "id": 2019003110010,
    "speaker": "愛依",
    "text": "プロデューサー！\r\n聞いて聞いて～！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "ai",
    "textCtrl": "p",
    "textFrame": "001",
