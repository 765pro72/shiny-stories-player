  {
    "id": 2019003110200,
    "speaker": "愛依",
    "text": "……おぉ～！\r\nやったばっかだから、すげーわかる！",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile1",
