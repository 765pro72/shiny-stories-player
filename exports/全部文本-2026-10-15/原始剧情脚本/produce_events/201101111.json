    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011011110160,
    "speaker": "樹里",
    "text": "でも、なんつーか……\r\nだからこそ、ひとりでも頑張らなきゃって思って",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110160"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2011011110170,
    "speaker": "樹里",
    "text": "それで、アタシなりに自分ひとりで\r\nできることも、足りないことも少しは見えたつもり",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110170"
  },
  {
    "id": 2011011110180,
    "speaker": "樹里",
    "text": "だからそういうの、ちゃんと磨いて\r\nユニットに還元していきたいと思った",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110180"
  },
  {
    "id": 2011011110190,
    "speaker": "樹里",
    "text": "……だって、\r\nアタシたちは５人で放課後クライマックスガールズなんだ",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110190"
  },
