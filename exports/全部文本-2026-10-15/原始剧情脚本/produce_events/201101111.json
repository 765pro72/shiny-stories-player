  {
    "id": 2011011110140,
    "speaker": "樹里",
    "text": "アタシ、今回\r\n地方でひとりで仕事してさ……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201101111/2011011110140"
  },
  {
    "id": 2011011110150,
    "speaker": "樹里",
    "text": "普段メンバーが隣に居てくれるのって\r\nすげー心強いことなんだなって気付いたんだ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
