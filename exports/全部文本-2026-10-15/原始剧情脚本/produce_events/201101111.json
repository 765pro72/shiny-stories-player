  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\nちょっと休みながら待ってようか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "荷物、その辺に置いていいからな",
