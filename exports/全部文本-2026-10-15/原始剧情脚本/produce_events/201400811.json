  {
    "id": 2014008110040,
    "speaker": "甘奈",
    "text": "プロデューサーさ～ん、コーヒー淹れたよ～\r\nはい、どーぞ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
