    "text": "うん！\r\nきっと気に入るよ！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110260"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そしたらまた買いに来ようかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008110270,
