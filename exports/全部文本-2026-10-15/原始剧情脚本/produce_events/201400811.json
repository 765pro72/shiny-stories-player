  {
    "speaker": "クラスメイト",
    "text": "甘奈甘奈～、これ、この前の相談のお礼～\r\n一緒に食べよ～",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2014008110010,
    "speaker": "甘奈",
    "text": "あ～！　あの店のプリン！！　買えたんだ～！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110010"
  },
  {
    "speaker": "クラスメイト",
    "text": "昨日、頑張って並んだら、売り切れる直前に！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2014008110020,
    "speaker": "甘奈",
    "text": "そうなんだ……！\r\n甘奈もまた並んでみようかなぁ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110020"
  },
  {
    "speaker": "クラスメイト",
    "text": "あ、それならハロウィンの日がいいと思う！\r\n限定プリン出すんだって！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2014008110030,
    "speaker": "甘奈",
    "text": "えー！　めっちゃ欲しい～",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110030"
  },
  {
    "speaker": "クラスメイト",
    "text": "かなりの力作らしいから並ぶ価値、ありそうだよ～",
    "textCtrl": "p",
    "textFrame": "003"
  },
