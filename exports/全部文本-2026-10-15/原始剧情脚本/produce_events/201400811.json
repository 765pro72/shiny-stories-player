    "waitTime": 800
  },
  {
    "speaker": "プロデューサー",
    "text": "ありがとう、わざわざ淹れてもらっちゃって悪いな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008110050,
    "speaker": "甘奈",
    "text": "気にしないで！\r\n──あっ！　プロデューサーさんもそのページ見てるんだ！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201400811/2014008110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、前に並んだお菓子屋さんのプリン──\r\nふと思い出して……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あの時は手に入らなかったし\r\nなんだかどうしても食べたくなってな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008110060,
    "speaker": "甘奈",
    "text": "限定の、めっちゃ美味しそうだよね！",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110060"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、ただ、仮装するのが条件らしいし\r\n男ひとりだとちょっとな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2014008110070,
    "speaker": "甘奈",
    "text": "そうなんだ……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110070"
  },
  {
    "id": 2014008110080,
    "speaker": "甘奈",
    "text": "あ！　それなら──",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201400811/2014008110080"
  },
  {
    "textFrame": "off",
