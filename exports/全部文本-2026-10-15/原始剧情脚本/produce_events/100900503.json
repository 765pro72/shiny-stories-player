    "textFrame": "001",
    "voice": "produce_events/100900503/1009005030180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ごめん、『起こりうること』だからさ……！\r\n絶対じゃないんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
