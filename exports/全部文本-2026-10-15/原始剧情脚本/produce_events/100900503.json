    "textFrame": "001",
    "voice": "produce_events/100900503/1009005030050"
  },
  {
    "id": 1009005030060,
    "speaker": "果穂",
    "text": "そうしたら、\r\nアイドルってみんなを笑顔にするんだって知って……っ",
