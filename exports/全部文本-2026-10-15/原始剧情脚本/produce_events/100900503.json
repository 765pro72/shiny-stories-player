  {
    "speaker": "プロデューサー",
    "text": "調べてくれたからもう知ってると思うけど、\r\n歌ったり踊ったり、時には演技やファンとの交流もする",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "アイドルは本当に色んなことをやる仕事だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009005030150,
    "speaker": "果穂",
    "text": "はい……っ",
