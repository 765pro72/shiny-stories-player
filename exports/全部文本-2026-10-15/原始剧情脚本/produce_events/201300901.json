  {
    "id": 2013009010010,
    "speaker": "夏葉",
    "text": "──ふふ～……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "natsuha",
    "textCtrl": "p",
