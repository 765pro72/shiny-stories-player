    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 1021002010100,
    "speaker": "円香",
    "text": "『ちょっと……何……？』",
    "textCtrl": "p",
    "textFrame": "001",
