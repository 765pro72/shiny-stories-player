    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "ま、まずい……！　画面、割れて……ないな……\r\nはあ……ビックリした……",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0328"
  },
  {
    "id": 1021002010080,
    "speaker": "円香",
    "text": "『なんの音ですか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100201/1021002010080"
  },
  {
    "textFrame": "off",
    "bg": "00004",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、すまん……\r\n今、スマホを落としてしまって",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1021002010090,
    "speaker": "円香",
    "text": "『……？\r\n…………………………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102100201/1021002010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "……円香？　おーい……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
