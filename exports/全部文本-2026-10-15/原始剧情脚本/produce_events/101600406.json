  },
  {
    "speaker": "プロデューサー",
    "text": "どうだ、千雪……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060020,
    "speaker": "千雪",
    "text": "ふふっ……",
    "charAnim1": "sad1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600406/1016004060020"
  },
  {
    "id": 1016004060030,
    "speaker": "千雪",
    "text": "こういう時、ちょっとドキドキしますよね\r\nわかります……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060030"
  },
  {
    "id": 1016004060040,
    "speaker": "千雪",
    "text": "『明るい日射しの中で、\r\n街並みを眺めながら聴くアルストロメリア』",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060040"
  },
  {
    "id": 1016004060050,
    "speaker": "千雪",
    "text": "……タイトル通りの、\r\nすごく素敵なプレイリストだと思います",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060050"
  },
  {
    "id": 1016004060060,
    "speaker": "千雪",
    "text": "とっても嬉しい……\r\nお願いしてよかったです",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……そうか、よかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060070,
    "speaker": "千雪",
    "text": "それに……",
    "charAnim1": "surp1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060070"
  },
  {
    "id": 1016004060080,
    "speaker": "千雪",
    "text": "……柔らかくて、あたたかくて\r\n強いところもあるけれど、優しさが底にずっと流れてる――",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060080"
  },
  {
    "id": 1016004060090,
    "speaker": "千雪",
    "text": "プロデューサーさんからは私たち、\r\nこんな風に見えてるんですね",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060090"
  },
  {
    "id": 1016004060100,
    "speaker": "千雪",
    "text": "ふふっ……私から見えてるプロデューサーさんと、\r\nちょっと似ているような気がします……！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060100"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ありがとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……けど、なんだか\r\n優しすぎる評価な気もするな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060110,
    "speaker": "千雪",
    "text": "いつもはもっとわがままで頑固なのに……？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060110"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや\r\nそういうことが言いたいんじゃなくてだな――",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060120,
    "speaker": "千雪",
    "text": "ふふっ、わかってます",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060120"
  },
  {
    "id": 1016004060130,
    "speaker": "千雪",
    "text": "……でも、本当に感謝してるんですよ",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060130"
  },
  {
    "id": 1016004060140,
    "speaker": "千雪",
    "text": "リストのことだけじゃなくて……",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060140"
  },
  {
    "id": 1016004060150,
    "speaker": "千雪",
    "text": "プロデューサーさんとお仕事する中で\r\n私も色々気づかせてもらったことがありますから",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060150"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060160,
    "speaker": "千雪",
    "text": "宣伝担当さんから\r\n最初にお話を伺ったときに……",
    "charAnim1": "wait3",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060160"
  },
  {
    "id": 1016004060170,
    "speaker": "千雪",
    "text": "私のリストを\r\n正解だと押しつけたくないって、言いましたが……",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060170"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060180,
    "speaker": "千雪",
    "text": "でも、プロデューサーさんが作ってくださったものは\r\nとても嬉しいし……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060180"
  },
  {
    "id": 1016004060190,
    "speaker": "千雪",
    "text": "テレビ局で会った新人さんの『桑山千雪』への憧れを\r\n壊さないようにしたいって気持ちもほんとうで……",
    "charAnim2": "face_close2",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060190"
  },
  {
    "id": 1016004060200,
    "speaker": "千雪",
    "text": "……私、何かが変わった気がしてるんです",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060200"
  },
  {
    "id": 1016004060210,
    "speaker": "千雪",
    "text": "うまく伝えられなくてもどかしいんですが、\r\nその事が私、とっても嬉しくて――",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060210"
  },
  {
    "speaker": "プロデューサー",
    "text": "……伝わってるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪がひとつひとつ受け止めて、考えて――\r\nだからこそ変わることができた、って",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今回のライブが成功したのも、\r\nそのおかげだと、俺は思ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060220,
    "speaker": "千雪",
    "text": "プロデューサーさん……",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060220"
  },
  {
    "speaker": "プロデューサー",
    "text": "これからも千雪を、\r\n一番近くで見られること、楽しみにしてるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016004060230,
    "speaker": "千雪",
    "text": "ありがとうございます",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060230"
  },
  {
    "id": 1016004060240,
    "speaker": "千雪",
    "text": "……プロデューサーさんの期待に添えるよう、\r\n頑張ります……！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060240"
  },
  {
    "id": 1016004060250,
    "speaker": "千雪",
    "text": "だから――",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060250"
  },
  {
    "id": 1016004060260,
    "speaker": "千雪",
    "text": "ずっと、私のプロデューサーさんで\r\nいてくださいね……！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600406/1016004060260"
  },
