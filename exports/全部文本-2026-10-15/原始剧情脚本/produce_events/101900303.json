  {
    "speaker": "プロデューサー",
    "text": "おーい、愛依\r\n大丈夫か……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003030030,
    "speaker": "愛依",
    "text": "──あ……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030030"
  },
  {
    "id": 1019003030040,
    "speaker": "愛依",
    "text": "プロデューサー……\r\nごめん、うち……",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030040"
  },
  {
    "id": 1019003030050,
    "speaker": "愛依",
    "text": "ちょっと休憩のつもりだったんだけど……\r\nぼーっとしちゃってたみたい",
    "charAnim1": "sad1",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "……愛依\r\n今日はもう上がろうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003030060,
    "speaker": "愛依",
    "text": "えっ、でも──……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "今日は休んで、\r\nまた明日から頑張ろう……な？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1019003030070,
    "speaker": "愛依",
    "text": "……うん、そだね\r\nそうしよっかな",
    "charAnim1": "wait3",
    "charLipAnim": "lip_wait",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030070"
  },
  {
    "id": 1019003030080,
    "speaker": "愛依",
    "text": "あっ、じゃあツイスタ用の写真だけ\r\n撮ってくから……！",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "mei",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101900303/1019003030080"
  },
  {
    "speaker": "プロデューサー",
    "text": "……わかった",
    "textCtrl": "p",
    "textFrame": "002"
  },
