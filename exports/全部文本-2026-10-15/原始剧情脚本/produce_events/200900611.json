    "textFrame": "001",
    "voice": "produce_events/200900611/2009006110230"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだか……\r\nステージみたいだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006110240,
    "speaker": "果穂",
    "text": "え……？\r\nあ、そういえば……",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900611/2009006110240"
  },
  {
    "id": 2009006110250,
    "speaker": "果穂",
    "text": "シャボン玉がキラキラしてて、スッゴくきれいで……\r\nなんだか、ステージの上にいるみたいです！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900611/2009006110250"
  },
  {
    "id": 2009006110260,
    "speaker": "果穂",
    "text": "それじゃあ、今はプロデューサーさんも\r\nおんなじステージにいるんですね",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900611/2009006110260"
  },
  {
    "speaker": "プロデューサー",
    "text": "え、俺も……か？",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006110270,
    "speaker": "果穂",
    "text": "はいっ！\r\nいっぱいのシャボン玉でキラキラのステージです！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900611/2009006110270"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな……\r\n果穂が、このステージに連れてきてくれたんだな",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
