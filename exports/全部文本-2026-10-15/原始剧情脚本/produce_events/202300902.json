      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "bgm": "100",
    "voice": "produce_events/202300902/2023009020110"
  },
  {
    "id": 2023009020120,
    "speaker": "雛菜",
    "text": "すっごく大事なお仕事が入った時に\r\nすっごく大事な用事があったとしたら",
    "charAnim1": "wait3",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020120"
  },
  {
    "id": 2023009020130,
    "speaker": "雛菜",
    "text": "どっちを優先する～？",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020130"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002",
    "autoWaitTime": 500
  },
  {
    "id": 2023009020140,
    "speaker": "雛菜",
    "text": "ね、どっち～？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_serious",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、場合によるんじゃないか？\r\n仕事とその用事、どっちを優先するかは",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020150,
    "speaker": "雛菜",
    "text": "そっか～……",
    "charAnim1": "wait4",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "なんだ、雛菜\r\n仕事の日に用事ができたとかか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020160,
    "speaker": "雛菜",
    "text": "ううん～\r\n今日撮影で聞いたんだけど",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020160"
  },
  {
    "id": 2023009020170,
    "speaker": "雛菜",
    "text": "受験があって専属モデル辞めちゃう子が\r\nいるんだって",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020170"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020180,
    "speaker": "雛菜",
    "text": "しばらくは学業に専念して、\r\nそれからまた活動するって",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020180"
  },
  {
    "id": 2023009020190,
    "speaker": "雛菜",
    "text": "モデルでもアイドルとかでも\r\n最近はそういう人が多いんだって～",
    "charAnim1": "sad1",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020190"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "芸能活動をしながら学業も両立している人は\r\n増えてるんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "学んだことを、また芸能活動に生かして\r\n活動の幅を広げてる……なんて人も多いしさ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020200,
    "speaker": "雛菜",
    "text": "そっか～……",
    "charAnim1": "wait3",
    "charAnim2": "face_close",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020200"
  },
  {
    "speaker": "プロデューサー",
    "text": "……雛菜も、考えてるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020210,
    "speaker": "雛菜",
    "text": "へ～？",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020210"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、雛菜はずっと考えてるか\r\n最初から",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023009020220,
    "speaker": "雛菜",
    "text": "…………",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hinana",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/202300902/2023009020220"
  },
  {
    "select": "進学について",
