  {
    "id": 2023009020110,
    "speaker": "雛菜",
    "text": "──ね、プロデューサーはさ～",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
