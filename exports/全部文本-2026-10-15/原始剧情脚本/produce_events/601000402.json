  {
    "id": 6010004020010,
    "speaker": "智代子",
    "text": "ここにいるみんなはもうご存じだと思いますが！\r\n私は、ごくごく普通の人間です！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "charCategory": "stand_costume",
    "charType": "characters",
    "charId": "010",
    "charPosition": {
      "x": 568,
