    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020210"
  },
  {
    "id": 3006002020220,
    "speaker": "恋鐘",
    "text": "任せとくばい！　こんな感じでどげん！？",
