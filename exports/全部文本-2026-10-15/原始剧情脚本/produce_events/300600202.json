    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020260"
  },
  {
    "id": 3006002020270,
    "speaker": "摩美々",
    "text": "ホントだぁ。さすがだねー",
