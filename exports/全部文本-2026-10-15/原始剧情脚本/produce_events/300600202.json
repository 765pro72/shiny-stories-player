    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020270"
  },
  {
    "id": 3006002020280,
    "speaker": "咲耶",
    "text": "フフ、ありがとう\r\nどうだい、少しは参考になりそうかな？",
