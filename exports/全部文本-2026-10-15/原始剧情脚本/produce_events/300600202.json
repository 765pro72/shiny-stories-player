    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020340"
  },
  {
    "id": 3006002020350,
    "speaker": "恋鐘",
    "text": "咲耶のおかげで、モデルの極意がわかったたい！\r\nモデルは、笑顔が武器なんね！",
