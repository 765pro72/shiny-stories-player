    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020380"
  },
  {
    "id": 3006002020390,
    "speaker": "咲耶",
    "text": "可愛い笑顔か……\r\nそう言われると、なんだか照れ臭いな……",
