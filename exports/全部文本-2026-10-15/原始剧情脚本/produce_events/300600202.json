    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020280"
  },
  {
    "id": 3006002020290,
    "speaker": "恋鐘",
    "text": "咲耶は本当にすごかね！\r\nこれはさすがのうちでも勝てんかもしれん！",
