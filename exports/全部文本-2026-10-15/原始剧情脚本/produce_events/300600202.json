    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020320"
  },
  {
    "id": 3006002020330,
    "speaker": "咲耶",
    "text": "フフ、その笑顔を武器にすれば、きっとね",
