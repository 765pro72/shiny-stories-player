    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020310"
  },
  {
    "id": 3006002020320,
    "speaker": "恋鐘",
    "text": "え！？　じゃあうち、スーパーモデルになれると！？",
