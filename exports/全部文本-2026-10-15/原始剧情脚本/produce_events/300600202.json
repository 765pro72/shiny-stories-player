    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020330"
  },
  {
    "id": 3006002020340,
    "speaker": "恋鐘",
    "text": "やったー！\r\nモデルでも一番になれるたい！",
    "charAnim1": "smile4",
