    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020350"
  },
  {
    "id": 3006002020360,
    "speaker": "咲耶",
    "text": "そうだね\r\n笑顔は女の子の、とっておきの武器だよ",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020360"
  },
  {
    "id": 3006002020370,
    "speaker": "恋鐘",
    "text": "ならお礼に、うちの笑顔の作り方を\r\n咲耶にも教えてあげるばい！",
    "charAnim1": "smile3",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020370"
  },
  {
    "id": 3006002020380,
    "speaker": "恋鐘",
    "text": "ほらほら！\r\n可愛い笑顔を見せるたい！",
