    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020220"
  },
  {
    "id": 3006002020230,
    "speaker": "摩美々",
    "text": "さっきとあんまり変わってないケド",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020230"
  },
  {
    "id": 3006002020240,
    "speaker": "咲耶",
    "text": "うん。それもとても可愛らしいね\r\nでも。少しうつむいてみたりして……",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020240"
  },
  {
    "id": 3006002020250,
    "speaker": "咲耶",
    "text": "……こういう感じかな",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300600202/3006002020250"
  },
  {
    "id": 3006002020260,
    "speaker": "恋鐘",
    "text": "わあ！　さすが咲耶ばい！\r\n悩んだ顔もかっこよかー！",
