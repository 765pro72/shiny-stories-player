    "waitTime": 1300
  },
  {
    "speaker": "プロデューサー",
    "text": "お……、夏葉！\r\nちょうど良かった",
    "textCtrl": "p",
    "textFrame": "002",
    "bgm": "006"
  },
  {
    "speaker": "プロデューサー",
    "text": "『シネマ芸術』のインタビュー掲載号\r\n届いてるぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040140,
    "speaker": "夏葉",
    "text": "……あら、そうなの？\r\nでも書店にももうあったから",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201301204/2013012040140"
  },
  {
    "charAnim1": "wait",
    "charLabel": "natsuha",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "se": "0177",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "id": 2013012040150,
    "speaker": "夏葉",
    "text": "私も買ってきたわ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/201301204/2013012040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "……はは、やっぱりそうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──そうだ\r\nじゃあ、もしよかったらご実家に送ったらどうだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040160,
    "speaker": "夏葉",
    "text": "え……？",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_sad",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040160"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務所には１冊置いておければいいし\r\n何冊か余っちゃうからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今回、ご家族の話もしてるし\r\n喜んでくれるんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040170,
    "speaker": "夏葉",
    "text": "……ありがとう\r\nでも、大丈夫よ",
    "charAnim1": "wait1",
    "charAnim2": "face_smile2",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "あ、そうか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040180,
    "speaker": "夏葉",
    "text": "ええ、多分実家には３冊くらい\r\nあると思うから……",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040180"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040190,
    "speaker": "夏葉",
    "text": "載ってるもの全部３冊くらいは買っているから\r\nもうさすがに置く場所が無くなってきたみたい",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040190"
  },
  {
    "id": 2013012040200,
    "speaker": "夏葉",
    "text": "それも私のだけじゃなくて\r\n放課後クライマックスガールズの全員分よ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………！\r\nそうだったのか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040210,
    "speaker": "夏葉",
    "text": "ちょっとした資料庫ね\r\n足りないバックナンバーがあれば取り寄せるわよ？",
    "charAnim1": "smile2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……助かるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040220,
    "speaker": "夏葉",
    "text": "インタビューでも言ったでしょう？\r\n応援してもらってるのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040220"
  },
  {
    "id": 2013012040230,
    "speaker": "夏葉",
    "text": "……とっても",
    "charAnim1": "wait4",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040230"
  },
  {
    "select": "頼もしいな",
    "nextLabel": "1"
  },
  {
    "select": "ありがたいな",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
    "select": "大事にしないとな",
    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "家族から応援してもらえるのが\r\n一番心強いんじゃないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040240,
    "speaker": "夏葉",
    "text": "そうね……\r\n少し行き過ぎなところもあるけれど",
    "charAnim1": "wait1",
    "charAnim2": "face_sad",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040240"
  },
  {
    "id": 2013012040250,
    "speaker": "夏葉",
    "text": "でも、とても心強いわ",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040250"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだよな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040260,
    "speaker": "夏葉",
    "text": "だけどね、プロデューサー",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040260"
  },
  {
    "id": 2013012040270,
    "speaker": "夏葉",
    "text": "アナタの応援だって、同じくらい……\r\nいつも、頼もしく思ってるのよ",
    "charAnim1": "hello",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/201301204/2013012040270"
  },
  {
    "id": 2013012040280,
    "label": "2",
    "speaker": "夏葉",
    "text": "ええ……そうね\r\n今回の役をやって、改めてそう思ったわ",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040280"
  },
  {
    "id": 2013012040290,
    "speaker": "夏葉",
    "text": "私のことを信じて、\r\n当たり前に応援してくれる人がいること",
    "charAnim1": "wait2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040290"
  },
  {
    "id": 2013012040300,
    "speaker": "夏葉",
    "text": "とっても、特別なことよね",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040300"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040310,
    "speaker": "夏葉",
    "text": "もちろん、その中には\r\nプロデューサー、アナタもいてくれるでしょう？",
    "charAnim1": "smile2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201301204/2013012040310"
  },
  {
    "speaker": "プロデューサー",
    "text": "そんなの、当たり前だよ",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "……この仕事をしていて\r\n周りの人に応援してもらえない人もたくさんいる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "夏葉が演じた、あの子みたいに\r\n反対を受ける子だっているだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013012040320,
    "speaker": "夏葉",
    "text": "そうね……",
