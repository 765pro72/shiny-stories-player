    "text": "──だから、大丈夫ですっ",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……うん！\r\n俺もサポートするから、一緒に頑張っていこう！",
    "textCtrl": "p",
    "textFrame": "002"
  },
