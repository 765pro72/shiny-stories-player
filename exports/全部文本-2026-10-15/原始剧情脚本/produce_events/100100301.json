  {
    "id": 1001003010160,
    "speaker": "真乃",
    "text": "……\r\n公開オーディション？",
    "charAnim1": "wait1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100100301/1001003010160"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、『G.R.A.D.』っていうテレビ番組で、\r\nアイドルひとりひとりが実力を競い合って頂点を決めるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003010170,
    "speaker": "真乃",
    "text": "……アイドル、ひとりひとりの実力……っ",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、どうだろう。このオーディション番組\r\n真乃に参加してもらえたらと思ってるんだけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003010180,
    "speaker": "真乃",
    "text": "『『G.R.A.D.』、己の力で目指せ最高のステージ\r\nアイドルの頂点はキミだ──』",
    "charAnim1": "wait_return_L",
    "charAnim2": "blank",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010180"
  },
  {
    "charAnim4": "eye_left",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
