  },
  {
    "id": 1001003010280,
    "speaker": "真乃",
    "text": "それに……ファンのみなさんにも……",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010280"
  },
  {
    "id": 1001003010290,
