    "waitTime": 2000
  },
  {
    "id": 1001003010060,
    "speaker": "真乃",
    "text": "『この間公開された、WEBインタビュー拝見しました！』",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/100100301/1001003010060"
  },
  {
    "id": 1001003010070,
    "speaker": "真乃",
    "text": "『なんだか真乃ちゃんを近くに感じ、\r\n直接お話を聞いているみたいな気持ちになって』──",
    "charAnim1": "shy2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010070"
  },
  {
    "id": 1001003010080,
    "speaker": "真乃",
    "text": "『ライブや握手会だけじゃなく、画面越しでも\r\n真乃ちゃんに会える機会が増えたようで嬉しいです』",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010080"
  },
  {
    "id": 1001003010090,
    "speaker": "真乃",
    "text": "『これからもずっと応援しています\r\n頑張ってください』",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010090"
  },
  {
    "charAnim1": "wait4",
