  },
  {
    "id": 1001003010030,
    "speaker": "真乃",
    "text": "──あっ\r\n桜の便せんの方からも届いてる……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010030"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　ああ、結構初めのほうから\r\nファンレターをくれている人だよな",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……これから打ち合わせも控えてるから、\r\n全部……とは言ってあげられないけど",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ファンレター少しだけなら読んでもいいぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003010040,
    "speaker": "真乃",
    "text": "い、いいんですか……？",
    "charAnim1": "wait4",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_sad",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010040"
  },
  {
    "id": 1001003010050,
    "speaker": "真乃",
    "text": "……あの、ありがとうございます……っ\r\nじゃあ、お言葉に甘えて……",
    "charAnim1": "wait1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
