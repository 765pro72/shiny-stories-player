    "waitTime": 2250
  },
  {
    "id": 1001003010100,
    "speaker": "真乃",
    "text": "ほわぁ\r\nう、うれしいです……",
    "charAnim1": "smile3",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010100"
  },
  {
    "id": 1001003010110,
    "speaker": "真乃",
    "text": "『嬉しい』って『会える』って言ってくださって\r\n本当に……いろんなお仕事、頑張ってよかったって……",
    "charAnim1": "smile2",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010110"
  },
  {
    "charAnim2": "face_close",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1001003010120,
    "speaker": "真乃",
    "text": "この先も、もっともっと頑張ろうって\r\nファンのみなさんがそう思わせてくれます……っ",
    "charAnim1": "shy1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010120"
  },
  {
    "speaker": "プロデューサー",
    "text": "うん、そうだな",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1001003010130,
    "speaker": "真乃",
    "text": "…………っ",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile_s",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010130"
  },
  {
    "id": 1001003010140,
    "speaker": "真乃",
    "text": "プロデューサーさん、\r\n打ち合わせ始めませんか……っ",
    "charAnim1": "anger3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100100301/1001003010140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、おう！\r\n──じゃあ、まずはこの書類を見てくれ……",
    "textCtrl": "p",
