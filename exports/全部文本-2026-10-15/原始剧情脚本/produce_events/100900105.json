    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050210"
  },
  {
    "speaker": "プロデューサー",
    "text": "違う違う。身長の話じゃなくて、心の話だよ",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "心、ですか……？",
