    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/100900105/1009001050200"
  },
  {
    "id": null,
    "label": "2",
    "speaker": "果穂",
    "text": "えっ、あたし、またおっきくなりましたか？",
