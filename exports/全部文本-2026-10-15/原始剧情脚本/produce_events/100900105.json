    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050290"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "前にプロデューサーさんが教えてくれたみたいに、\r\nあたしらしさを大事にしようって思ったんです",
