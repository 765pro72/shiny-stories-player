    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050270"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "だからプロデューサーさんも、ついて来てくださいね！",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
