    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050300"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂らしさが何なのか、わかったのか？",
