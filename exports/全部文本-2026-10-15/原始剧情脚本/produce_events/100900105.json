    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050140"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "あたしはあたしらしいアイドルになろうって！",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050150"
  },
  {
    "id": null,
    "speaker": "果穂",
    "text": "ヒーローがヒーローのやり方でみんなを笑顔にするように、\r\nあたしは、あたしのやり方で！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900105/1009001050160"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……",
    "charLabel": "kaho",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "果穂はもう、ヒーロー\r\nなのかもしれないな",
