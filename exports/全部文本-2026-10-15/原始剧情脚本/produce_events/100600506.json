    "textFrame": "002"
  },
  {
    "id": 1006005060050,
    "speaker": "咲耶",
    "text": "フフッ\r\n私は別に『おかえり』でもかまわないのだけれど",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
