    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100600506/1006005060080"
  },
  {
    "speaker": "プロデューサー",
    "text": "からかってきた人の言うことかー？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006005060090,
    "speaker": "咲耶",
    "text": "違いない",
