    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "みんなももう揃ってる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1006005060100,
    "speaker": "咲耶",
    "text": "おや、私が最後か\r\n悪いことをしてしまったね……",
