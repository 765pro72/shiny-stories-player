    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それなら、赤っぽい何かであればいいってことになるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009012040100,
