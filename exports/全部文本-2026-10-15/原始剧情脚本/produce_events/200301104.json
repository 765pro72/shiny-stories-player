    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040100"
  },
  {
    "id": 2003011040110,
    "speaker": "めぐる",
    "text": "幸せになるために、こういうのをやるんだーって思ったら\r\nなんだか心がキュッてなるんだ",
