    "voice": "produce_events/200301104/2003011040160"
  },
  {
    "id": 2003011040170,
    "speaker": "めぐる",
    "text": "『ガーターだとハードルが高い場合は、\r\n別の方法で取り入れてみては？』だって",
    "charAnim1": "wait2",
    "charAnim2": "blank",
