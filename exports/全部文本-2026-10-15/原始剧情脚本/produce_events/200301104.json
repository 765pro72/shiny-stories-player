    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040040"
  },
  {
    "id": 2003011040050,
    "speaker": "めぐる",
    "text": "それに、結婚式をやるのってすーっごく大変なんだなーって",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040050"
  },
  {
    "id": 2003011040060,
    "speaker": "めぐる",
    "text": "大変そうなんだけど、\r\nでも、こういう雑誌を見るのは好きだな……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040060"
  },
  {
    "id": 2003011040070,
    "speaker": "めぐる",
    "text": "きっとね",
    "charAnim2": "face_close",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "autoWaitTime": 1000,
    "voice": "produce_events/200301104/2003011040070"
  },
  {
    "id": 2003011040080,
    "speaker": "めぐる",
    "text": "これを読む人は、好きな人と結婚しようって話をして……\r\nすごーくそわそわした気持ちで、手に取るんだなって思って",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040080"
  },
  {
    "id": 2003011040090,
    "speaker": "めぐる",
    "text": "ずっと考えてたら、ちょっとだけ\r\n本当にちょっとだけ、気持ちに寄り添えるような気がする",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301104/2003011040090"
  },
  {
    "id": 2003011040100,
    "speaker": "めぐる",
    "text": "ほら、見てプロデューサー\r\nこの特集",
