  },
  {
    "id": 1002002020150,
    "speaker": "灯織",
    "text": "……今の、プロデューサーの言葉ですよ",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100200202/1002002020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002002020160,
    "speaker": "灯織",
    "text": "……踏切の時",
    "charAnim1": "wait1",
    "charAnim2": "face_close",
