    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait_s",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "し、信じてくれよ！？　本当に──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002002020170,
    "speaker": "灯織",
    "text": "……っふふ",
