    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300511/2023005110080"
  },
  {
    "id": 2023005110090,
    "speaker": "雛菜",
    "text": "なんかね～\r\n雛菜、カフェのお仕事したでしょ～？",
