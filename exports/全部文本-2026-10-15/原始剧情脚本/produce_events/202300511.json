    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300511/2023005110090"
  },
  {
    "id": 2023005110100,
    "speaker": "雛菜",
    "text": "そしたら、ユアクマちゃんのファンの人が\r\n雛菜のツイスタを見てくれて",
