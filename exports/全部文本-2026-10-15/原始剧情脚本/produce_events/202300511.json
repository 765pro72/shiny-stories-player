    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300511/2023005110100"
  },
  {
    "id": 2023005110110,
    "speaker": "雛菜",
    "text": "雛菜のお気に入りのグッズ見たいって\r\nコメントが来てたの～！",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202300511/2023005110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "おお……！\r\nそんな反応があったのか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023005110120,
    "speaker": "雛菜",
    "text": "あと、いつもコメントしてくれる人も～",
