[
  {
    "textFrame": "off",
    "bg": "00000",
    "bgm": "0215",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "speaker": "プロデューサー",
    "text": "仕事としてアイドルを探していたら、\r\nもっと楽な子を選ぶんじゃないかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "事務所を牽制しに来た子を、\r\nわざわざ引き止めてスカウトなんてしないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "リスクが高すぎる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……そう思わないか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021010110010,
    "speaker": "円香",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "それに幼なじみの名前を出すような、\r\n卑怯な手を使ったりもしない",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021010110020,
    "speaker": "円香",
    "text": "自覚があったんですね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "後から考えればだけどな\r\nあの時は必死だったから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "全部が全部『仕事として』じゃないよ\r\n円香が思う以上に俺はやりたいようにやっている",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そう見えなかったなら────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "それなりにプロデューサーらしく\r\n頑張れているってことでいいのかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110030,
    "speaker": "円香",
    "text": "さあ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110030"
  },
  {
    "id": 2021010110040,
    "speaker": "円香",
    "text": "それか、そういうところもひっくるめて、\r\n私を騙そうとしているか",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、そうなのか？\r\nそれはひどいやつだなあ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110050,
    "speaker": "円香",
    "text": "そう、ひどい人",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110050"
  },
  {
    "id": 2021010110060,
    "speaker": "円香",
    "text": "自覚がないから余計にひどい",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110060"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "じゃあ、円香は\r\nそのひどい人に騙されたってことか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110070,
    "speaker": "円香",
    "text": "そういうことになりますね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110070"
  },
  {
    "id": 2021010110080,
    "speaker": "円香",
    "text": "でも、正しくは騙されたんじゃなくて",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110080"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021010110090,
    "speaker": "円香",
    "text": "騙されたふりをしてあげただけ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110090"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "……ほらな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "こんな気難しい子、\r\n仕事の義務感だけでスカウトしたりしないよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110100,
    "speaker": "円香",
    "text": "ひどい言い草\r\n最低",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110100"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2021010110110,
    "speaker": "円香",
    "text": "……でも、同感",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2021010110111,
    "speaker": "円香＆プロデューサー",
    "text": "ふふ……────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110111"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 3000
  },
  {
    "id": 2021010110120,
    "speaker": "円香",
    "text": "もし、あの日に戻れたら",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110120"
  },
  {
    "id": 2021010110130,
    "speaker": "円香",
    "text": "私はきっと事務所に行かない\r\nそんな気がする",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110130"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "後悔があるってことか？\r\nアイドルになったことに……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021010110140,
    "speaker": "円香",
    "text": "どうなんですかね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110140"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "id": 2021010110150,
    "speaker": "円香",
    "text": "まだ言語化できない",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110150"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2021010110160,
    "speaker": "円香",
    "text": "……そうしたら出会うこともありませんでしたね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110160"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "いや、きっとどこかで会っていたよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "少なくとも俺が過去に戻ったら、\r\nかならず探しに行くからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110170,
    "speaker": "円香",
    "text": "……でしょうね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110170"
  },
  {
    "id": 2021010110180,
    "speaker": "円香",
    "text": "知ってる",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "とりあえず家の住所は割れてるしな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110190,
    "speaker": "円香",
    "text": "ええ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110190"
  },
  {
    "speaker": "プロデューサー",
    "text": "というのは冗談冗談……！\r\n……まあ、ほら",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "俺が、誰よりも円香のことを────",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "わかっているなんて言えないけど",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "……でも、円香の存在に、\r\n誰よりも早く気付いたとは思っている",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから、今……アイドルとして、\r\nここにいてくれてありがとうと言いたくて",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0219",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "プレゼントは、俺が贈りたいものを選んだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "円香はきっといらないって言うだろうけど\r\n今日だけは押し付けるよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110200,
    "speaker": "円香",
    "text": "…………これ……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110200"
  },
  {
    "speaker": "プロデューサー",
    "text": "好きなものとか大事なものとか……\r\n何か見つかった時に使ってくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2021010110210,
    "speaker": "円香",
    "text": "…………宝石箱────",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202101011/2021010110210"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺に教えてくれなんて言わない\r\nただ、大切にしてほしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
