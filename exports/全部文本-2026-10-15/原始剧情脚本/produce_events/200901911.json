  {
    "id": 2009019110010,
    "speaker": "果穂",
    "text": "あたし、いろいろできるようになったんだなって思って！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110010"
  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　どんなことだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "bg": "00462",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2009019110020,
    "speaker": "果穂",
    "text": "中学生になって、門限が延びました！",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040090120",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200901911/2009019110020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、それはそうだな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009019110030,
    "speaker": "果穂",
    "text": "あと、難しい勉強もできるようになったし、\r\n大人の人みたいに注文して飲み物飲んだりもできるし",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110030"
  },
  {
    "id": 2009019110040,
    "speaker": "果穂",
    "text": "プロデューサーさんに送ってもらったり、\r\nお迎えに来てもらったりしなくても、お仕事に行けます！",
    "charAnim1": "think",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110040"
  },
  {
    "id": 2009019110050,
    "speaker": "果穂",
    "text": "お仕事も、\r\nいろんなのをやらせてもらえるようになりました！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110050"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだなぁ、そう考えると\r\n果穂ができるようになったことって、たくさんあるな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009019110060,
    "speaker": "果穂",
    "text": "はい！",
    "charAnim1": "wait",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110060",
    "autoWaitTime": 1000
  },
  {
    "id": 2009019110070,
    "speaker": "果穂",
    "text": "それに、できるようになったことだけじゃなくて\r\n今までやってきたお仕事も……！",
    "charAnim1": "touch",
    "charAnim2": "face_wait",
    "charAnim3": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110070"
  },
  {
    "id": 2009019110080,
    "speaker": "果穂",
    "text": "『終わったら終わり』じゃないんだって思いました",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200901911/2009019110080"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ……この前の動画か？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009019110090,
    "speaker": "果穂",
    "text": "そうですー！",
    "charAnim1": "wait4",
