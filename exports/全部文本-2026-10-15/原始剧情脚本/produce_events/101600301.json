    "textFrame": "001",
    "voice": "produce_events/101600301/1016003010130"
  },
  {
    "id": 1016003010140,
    "speaker": "千雪",
    "text": "ラジオでちょっと話題にしただけなのに\r\nこんな企画につなげてくださったスタッフさんたちにも",
    "textCtrl": "p",
    "textFrame": "001",
