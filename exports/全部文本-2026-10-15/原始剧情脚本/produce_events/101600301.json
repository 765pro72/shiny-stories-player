    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/101600301/1016003010090"
  },
  {
    "id": 1016003010100,
    "speaker": "千雪",
    "text": "だからって、その……\r\nちょっと見合わないといいますか",
    "charAnim1": "touch",
    "charAnim2": "face_sad",
    "charAnim4": "eye_left",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600301/1016003010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "……まぁ、気持ちはわかるよ",
    "charAnim2": "face_sad",
    "charAnim4": "blank",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "けど、千雪が心をこめて作ったものだってこともよくわかる\r\n忙しい合間を縫って、丁寧に",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0328"
