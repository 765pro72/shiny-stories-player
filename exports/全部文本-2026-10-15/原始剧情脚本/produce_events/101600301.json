    "waitTime": 2000
  },
  {
    "id": 1016003010090,
    "speaker": "千雪",
    "text": "──なんだかありがたいような申し訳ないような……\r\nもちろん、一生懸命作ったものではあるんですけど",
    "charAnim1": "anger2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_anger2",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
