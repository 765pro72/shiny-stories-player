    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "残り……何日だっけ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016003010050,
    "speaker": "千雪",
    "text": "……え、ええと\r\nあと３日です……",
