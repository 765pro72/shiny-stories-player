  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "そう思うよ。『G.R.A.D.』にエントリーしてるアイドルたちは\r\nみんなこういう機会を大切に────",
    "charAnim1": "wait",
    "charAnim2": "face_sad",
