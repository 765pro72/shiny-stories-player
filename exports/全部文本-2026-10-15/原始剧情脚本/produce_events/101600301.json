  {
    "speaker": "プロデューサー",
    "text": "────えっ……\r\nもうこんなに値が付いてるのか……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0399",
