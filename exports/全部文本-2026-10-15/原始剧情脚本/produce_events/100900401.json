    },
    "voice": "produce_events/100900401/1009004010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうなのか、超大作だな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "もう他のは集まってるのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009004010070,
    "speaker": "果穂",
    "text": "いえっ！",
