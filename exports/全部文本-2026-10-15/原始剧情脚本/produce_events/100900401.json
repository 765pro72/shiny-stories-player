    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900401/1009004010080"
  },
  {
    "id": 1009004010090,
    "speaker": "果穂",
    "text": "でも、ちょっとずつ集めるのが楽しいです！",
