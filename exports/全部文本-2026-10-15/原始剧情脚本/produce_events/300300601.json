    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300601/3003006010410"
  },
  {
    "id": 3003006010420,
    "speaker": "めぐる",
    "text": "えへへっ！　……わたし、ご挨拶したら、\r\nこの前、発明したキラキラソーダを取ってくるよ！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300601/3003006010420"
  },
  {
    "id": 3003006010430,
    "speaker": "真乃",
    "text": "あ……私たちの飲み物って、\r\n人間さんも飲めるのかな？",
