    "voice": "produce_events/300300601/3003006010440"
  },
  {
    "id": 3003006010450,
    "speaker": "めぐる",
    "text": "じゃあ、普通にグルグルキノコ茶にしとこっか！\r\n一番、ドロドロで飲みやすいと思うし！",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300300601/3003006010450"
  },
  {
    "id": 3003006010460,
    "speaker": "真乃",
    "text": "マカロントカゲのしっぽも残ってたはずだから、\r\nお茶請けとしてお出ししてもいいかも",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
