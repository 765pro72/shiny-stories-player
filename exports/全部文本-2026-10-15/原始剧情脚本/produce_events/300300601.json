    "voice": "produce_events/300300601/3003006010430"
  },
  {
    "id": 3003006010440,
    "speaker": "めぐる",
    "text": "えっ！　あ、どうなんだろう……！？",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "meguru",
    "textCtrl": "p",
