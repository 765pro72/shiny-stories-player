[
  {
    "speaker": "プロデューサー",
    "text": "（もうすぐ待ち合わせの時間だけど……\r\n咲耶はまだ来ないな）",
    "textCtrl": "p",
    "textFrame": "002",
    "bg": "00013",
    "bgm": "015"
  },
  {
    "speaker": "プロデューサー",
    "text": "（いつもの咲耶なら、もう着いていてもいい頃のはず……\r\nもしかして、何かあったんじゃ……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0103",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "（……！　咲耶からだ！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
