      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "bg": "00013",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "effectLabel": "black1",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
