  {
    "speaker": "プロデューサー",
    "text": "いや……\r\n……真乃、聞いてなかったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2001019040040,
    "speaker": "真乃",
    "text": "ほわ……\r\n急いでいたので……",
