    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200101904/2001019040060"
  },
  {
    "id": 2001019040070,
    "speaker": "真乃",
    "text": "他にも、あの投稿をきっかけに\r\nカフェのこととか聞いてくださる方も多くて……",
