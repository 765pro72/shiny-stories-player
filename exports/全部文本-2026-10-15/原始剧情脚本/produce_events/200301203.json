  {
    "id": 2003012030030,
    "speaker": "めぐる",
    "text": "『ロケ弁！！！！！！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301203/2003012030030"
  },
  {
    "id": 2003012030040,
    "speaker": "めぐる",
    "text": "『#遅めのお昼　#美味しい　#ぺろりしました\r\n#有名なところのなんだって　#みんな知ってる？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301203/2003012030040"
  },
  {
    "id": 2003012030050,
    "speaker": "めぐる",
    "text": "『#真乃と灯織と中身がちょっとずつ違うんだよー！\r\n#もはや間違い探し　#どっちも美味しそうだった！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301203/2003012030050"
  },
  {
    "id": 2003012030060,
    "speaker": "めぐる",
    "text": "『#この後も頑張りまーす\r\n#放送日はまたお知らせするねー！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301203/2003012030060"
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "めぐる、最近ツイスタマメだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003012030070,
    "speaker": "めぐる",
    "text": "えへへっ、うん！\r\nなるべく毎日更新を目指してるの！",
