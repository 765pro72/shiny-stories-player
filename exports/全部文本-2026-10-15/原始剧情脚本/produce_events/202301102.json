    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/202301102/2023011020110"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは、ちゃんと考えてくれて嬉しいよ\r\n────でも、これだけは確実に言える",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "雛菜は、いつも頑張ってるよな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2023011020120,
    "speaker": "雛菜",
