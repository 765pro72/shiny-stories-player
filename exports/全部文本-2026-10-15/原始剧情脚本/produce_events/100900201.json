    },
    "voice": "produce_events/100900201/1009002010010"
  },
  {
    "id": 1009002010020,
    "speaker": "果穂",
    "text": "『今日は体育のドッジボールで、\r\n最後のひとりに残りました！』",
    "charAnim1": "wait4",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010020"
  },
  {
    "id": 1009002010030,
    "speaker": "果穂",
    "text": "『とちゅうで、友達に当たりそうだったボールを\r\nキャッチできた時もありました』",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010030"
  },
  {
    "id": 1009002010040,
    "speaker": "果穂",
    "text": "『ありがとう！　と言ってもらえて、\r\nヒーローはいつもこんな気持ちなのかな？　と思いました』",
    "charAnim1": "wait3",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "へぇ……！\r\nすごいじゃないか果穂、大活躍だな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009002010050,
    "speaker": "果穂",
    "text": "えへへ……！",
    "charAnim1": "shy1",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010050"
  },
  {
    "id": 1009002010060,
    "speaker": "果穂",
    "text": "『それから、うちにある封印されし宝物について\r\n思い出しました……！』",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "宝物？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009002010070,
    "speaker": "果穂",
    "text": "はい！\r\nキラキラでカッコいい剣です！",
    "charAnim1": "smile1",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010070"
  },
  {
    "id": 1009002010080,
    "speaker": "果穂",
    "text": "……でも、どこにしまったかわからなくなっちゃってて……",
    "charAnim1": "sad1",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010080"
  },
  {
    "id": 1009002010090,
    "speaker": "果穂",
    "text": "プロデューサーさんも、\r\n見つかるようにお祈りしてくれたら嬉しいです……！",
    "charAnim1": "smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "おう、わかった……！\r\n見つかりますように……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009002010100,
    "speaker": "果穂",
    "text": "見つかりますように……！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "──でも、剣なんて勇者みたいだな\r\n物語の主人公だ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009002010110,
    "speaker": "果穂",
    "text": "はいっ！　──あっ、でもっ、\r\nプロデューサーさんとあたしは、もう主人公です！",
    "charAnim1": "think",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010110"
  },
  {
    "id": 1009002010120,
    "speaker": "果穂",
    "text": "プロデューサーさん、前に、\r\n『俺たちの戦いはまだ終わらない』って言ってくれました",
    "charAnim1": "wait1",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010120"
  },
  {
    "id": 1009002010130,
    "speaker": "果穂",
    "text": "だから、あたしたちのお話はまだまだ続いています！\r\nこの先も、ずっとずっとです！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010130"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうだな\r\n一緒にアイドル物語を突っ走る約束だった",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1009002010140,
    "speaker": "果穂",
    "text": "ふたり揃えば、あたしたちは無敵です！\r\nだから──",
    "charAnim1": "hero2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100900201/1009002010140"
  },
