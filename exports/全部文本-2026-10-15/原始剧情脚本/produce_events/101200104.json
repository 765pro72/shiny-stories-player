    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1012001040020,
    "speaker": "凛世",
    "text": "はい、プロデューサーさまの、ためならば……",
    "charAnim1": "smile3",
