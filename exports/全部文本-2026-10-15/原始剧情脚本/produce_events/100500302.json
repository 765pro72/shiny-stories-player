    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500302/1005003020180"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ\r\n朝イチ集合だよな、頼んだぞ！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003020190,
