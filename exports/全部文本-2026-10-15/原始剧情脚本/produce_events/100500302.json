    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500302/1005003020160"
  },
  {
    "speaker": "プロデューサー",
    "text": "なっ……！\r\n違うぞ摩美々、今のは──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003020170,
    "speaker": "摩美々",
    "text": "まぁ、今に始まったことじゃないので\r\n別にいいですケドー",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
