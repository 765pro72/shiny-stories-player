    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1005003020140,
    "speaker": "摩美々",
    "text": "いいですよ\r\n望むところですー",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500302/1005003020140"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……！\r\nそれじゃあ、OKということで先方にも連絡しておくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003020150,
    "speaker": "摩美々",
    "text": "……？\r\n何か面白いこと、ありましたかぁ？",
    "charAnim1": "anger2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500302/1005003020150"
  },
  {
    "speaker": "プロデューサー",
    "text": "いやいや、すまん\r\n無意識だった……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……摩美々\r\n俺も全力でサポートしていくからな！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003020160,
    "speaker": "摩美々",
    "text": "……プロデューサーって、\r\n唐突に暑苦しいですよねー",
