    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0806",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "編集部に届いたお手紙、アンケートのコメント、\r\nSNSでの反響までまとめられてる",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "これ、読んでみてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005003020060,
    "speaker": "摩美々",
    "text": "へえ……",
    "charAnim1": "wait1",
    "charAnim2": "face_wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "001",
