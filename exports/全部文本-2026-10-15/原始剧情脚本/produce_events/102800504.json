  },
  {
    "id": 1028005040110,
    "speaker": "はるき",
    "text": "──わたしのほうこそ、\r\nお時間作っていただき申し訳ありません",
    "charAnim1": "sad2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_surp",
    "charLabel": "haruki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102800504/1028005040110"
  },
  {
    "speaker": "プロデューサー",
    "text": "いえ、俺のほうこそ\r\nゆっくり話ができたらなと思っていたので",
    "textCtrl": "p",
    "textFrame": "002"
  },
