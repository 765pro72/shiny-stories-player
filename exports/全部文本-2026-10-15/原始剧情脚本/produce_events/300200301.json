    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/300200301/3002003010180"
  },
  {
    "id": 3002003010190,
    "speaker": "灯織",
    "text": "やれる努力をしないで本番を迎えるなんて\r\n私は、絶対に嫌",
