  },
  {
    "textFrame": "off",
    "se": "0100",
    "waitType": "time",
    "waitTime": 1300
  },
  {
    "id": 1020003010020,
    "speaker": "透",
    "text": "低潮時における水深が６メートルを超えない海域などを\r\n『低地』として定義しています",
    "textCtrl": "p",
    "textFrame": "001",
