    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "──それ、ナレーションのオファーってことだよな\r\n透、直接打診を受けた時はまず相談してほしくって────",
    "textCtrl": "p",
    "textFrame": "002"
  },
