    "textFrame": "001",
    "voice": "produce_events/102000301/1020003010030"
  },
  {
    "textFrame": "off",
    "se": "0328",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1020003010040,
    "speaker": "透",
    "text": "種、科を問わず多種多様な生命が死と生とをつなぎ、その\r\n地球環境への影響は、熱帯雨林に匹敵するとも言われます",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/102000301/1020003010040"
  },
  {
    "textFrame": "off",
