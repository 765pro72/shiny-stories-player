  },
  {
    "speaker": "プロデューサー",
    "text": "（さすが咲耶、順調に進んでる……\r\nこれなら、きっとファンにも喜んでもらえるな！）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "effectLabel": "black2",
    "effectTarget": {
      "type": "rect",
