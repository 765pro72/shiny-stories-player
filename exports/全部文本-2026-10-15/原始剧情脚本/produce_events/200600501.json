      "easing": "easeInQuart"
    },
    "waitType": "effect"
  },
  {
    "id": 2006005010120,
    "speaker": "咲耶",
    "text": "お疲れ様でした。……あの、すみません……\r\nもう少し、この子を触っていてもいいですか？",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010120"
  },
  {
    "speaker": "スタッフ",
    "text": "はい、撤収までなら大丈夫ですよ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006005010130,
    "speaker": "咲耶",
    "text": "ありがとうございます\r\nじゃあ、少しだけ……",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010130"
  },
  {
    "id": 2006005010140,
    "speaker": "咲耶",
    "text": "小さくて、温かくて……\r\n本当に可愛いね……",
    "charAnim1": "wait5",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010140"
  },
  {
    "id": 2006005010150,
    "speaker": "咲耶",
    "text": "あ、そこはくすぐったい\r\n……クス、私の指は美味しいかい？",
    "charAnim1": "shy1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010150"
  },
  {
    "id": 2006005010160,
    "speaker": "咲耶",
    "text": "背中もふわふわだ\r\nフフ、気持ち良さそうに伸びてるね",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010160"
  },
  {
    "textFrame": "off",
    "effectLabel": "black3",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "000000"
    },
    "effectValue": {
      "type": "from",
      "alpha": 0,
      "time": 240
    },
    "waitType": "effect"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
    },
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "effectLabel": "black3",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 240
    },
    "waitType": "effect"
  },
  {
    "speaker": "プロデューサー",
    "text": "（髪型だけじゃなく……\r\nなんだか、いつもと雰囲気が違うな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005010170,
    "speaker": "咲耶",
    "text": "……プロデューサー、どうしたんだい？\r\nさっきから、考え事かな？",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200600501/2006005010170"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、いや、そんなことないよ。\r\nさっきの撮影といい、扱いにずいぶん慣れているんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005010180,
    "speaker": "咲耶",
    "text": "……慣れている、というわけではないけれど……",
    "charAnim1": "anger1",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010180"
  },
  {
    "id": 2006005010190,
    "speaker": "咲耶",
    "text": "お互いのことを知ろうと、私たちは歩み寄った\r\nそれだけのことだよ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010190"
  },
  {
    "id": 2006005010200,
    "speaker": "咲耶",
    "text": "おかげでこの子とも気持ちが通じ合ったようだよ\r\nほら、もうこんなに仲良くなれたんだ",
    "charAnim1": "wait4",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010200"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ。今日初めて会ったとは思えないほどだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005010210,
    "speaker": "咲耶",
    "text": "フフ。人と人との繋がりと同じことさ\r\nお互いを知りたいと思えば、自然と仲良くなれるものだ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010210"
  },
  {
    "id": 2006005010220,
    "speaker": "咲耶",
    "text": "プロデューサーも抱いてみるかい？\r\nアナタも、きっとこの子と仲良くなれると思うよ",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010220"
  },
  {
    "id": 2006005010230,
    "speaker": "咲耶",
    "text": "ほら、こちらにおいで",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010230"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか？\r\nじゃあ、少しだけ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "effectLabel": "white3",
    "effectTarget": {
      "type": "rect",
      "width": 1136,
      "height": 640,
      "color": "ffffff"
    },
    "effectValue": {
      "type": "from",
