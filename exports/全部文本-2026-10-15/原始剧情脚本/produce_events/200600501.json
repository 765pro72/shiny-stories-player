    },
    "effectValue": {
      "type": "from",
      "x": 1000,
      "alpha": 0,
      "time": 1000
    },
    "waitType": "effect"
  },
  {
    "charAnim1": "wait",
    "charAnim2": "blank",
    "charLabel": "sakuya",
    "textFrame": "off",
    "bgm": "029",
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    }
  },
  {
    "textFrame": "off",
    "effectLabel": "black2",
    "effectValue": {
      "type": "to",
      "alpha": 0,
