    }
  },
  {
    "textFrame": "off",
    "effectLabel": "white3",
    "effectValue": {
      "type": "to",
      "alpha": 0,
      "time": 1000,
      "easing": "easeInQuart"
    },
    "waitType": "effect",
    "stillType": "idols",
    "stillId": "1030060020"
  },
  {
    "id": 2006005010240,
    "speaker": "咲耶",
    "text": "そんなふうにおっかなびっくりでなくても大丈夫だよ\r\n怯えると、それが伝わってしまうからね",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010240"
  },
  {
    "id": 2006005010250,
    "speaker": "咲耶",
    "text": "こんなに小さな子なんだ\r\n怖がらせてしまうのは、可哀想だろう？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010250"
  },
  {
    "speaker": "プロデューサー",
    "text": "な、なるほど……\r\nこんな感じか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0220",
    "waitType": "time",
    "waitTime": 800
  },
  {
    "id": 2006005010260,
    "speaker": "咲耶",
    "text": "そうそう、そうやって優しく、\r\n伝えたい気持ちを心に込めて撫でてあげるんだ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010260"
  },
  {
    "id": 2006005010270,
    "speaker": "咲耶",
    "text": "フフ、どうやら、アナタの気持ちは伝わったようだね\r\nほら、見てごらん。とってもご機嫌だ",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010270"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005010280,
    "speaker": "咲耶",
    "text": "ああ\r\n私の時より気持ち良さそうで、少し妬けてしまうな",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010280"
  },
  {
    "id": 2006005010290,
    "speaker": "咲耶",
    "text": "さて、アナタはこの子に、どんな気持ちを伝えたのかな？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200600501/2006005010290"
  },
  {
    "speaker": "プロデューサー",
    "text": "どんな気持ち……と言うと、\r\nお疲れ様、よくやったなってところかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "今日は、咲耶と一緒に収録を頑張った\r\nアイドルみたいなものだったから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006005010300,
    "speaker": "咲耶",
    "text": "うん、今日の立役者だね\r\nフフ、アナタに褒められたから、こんなに嬉しそうなのか",
