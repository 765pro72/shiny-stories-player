    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ステージが、夢……か……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002010030,
    "speaker": "千雪",
    "text": "……はい",
