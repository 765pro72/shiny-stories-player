    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010030"
  },
  {
    "id": 1016002010040,
    "speaker": "千雪",
    "text": "ただの桑山千雪が、\r\nアルストロメリアの桑山千雪になれる場所……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010040"
  },
  {
    "id": 1016002010050,
    "speaker": "千雪",
    "text": "そこに向かっていく時間が、\r\nなんだかすごく大切に思えて……",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010050"
  },
  {
    "id": 1016002010060,
    "speaker": "千雪",
    "text": "……少し特別に思っちゃってるのかも",
    "charAnim1": "wait4",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "いいんじゃないか\r\n験担ぎみたいなもんだろう",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002010070,
    "speaker": "千雪",
    "text": "……ふふ、はいっ",
    "charAnim1": "surp1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010070"
  },
  {
    "speaker": "プロデューサー",
    "text": "千雪が大切だと思ったものは、\r\nきっと未来で千雪を輝かせてくれる",
    "charAnim2": "face_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは証明されてるんだからさ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1016002010080,
    "speaker": "千雪",
    "text": "……ありがとうございます\r\nでも、それは……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010080"
  },
  {
    "id": 1016002010090,
    "speaker": "千雪",
    "text": "……私が、欲しいものに手を伸ばしても\r\nいいんだって思えるのは──",
    "charAnim1": "shy1",
    "charAnim2": "face_cry",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/101600201/1016002010090"
  },
  {
    "id": 1016002010100,
    "speaker": "千雪",
    "text": "プロデューサーさんが、支えてくださるから……\r\nなんですよ……？",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
