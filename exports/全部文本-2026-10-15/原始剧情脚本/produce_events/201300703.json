    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030160"
  },
  {
    "speaker": "プロデューサー",
    "text": "…………",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007030170,
    "speaker": "夏葉",
    "text": "──結婚しなくても、きっと幸せでいられるわ\r\n今だって、すごく幸せだもの",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030170"
  },
  {
    "speaker": "プロデューサー",
    "text": "……うん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007030180,
    "speaker": "夏葉",
    "text": "それでも、そうしたいって思うことが\r\nもしあるなら……",
