  {
    "id": 2013007030130,
    "speaker": "夏葉",
    "text": "──まさかこんなに早く\r\nこのドレスを着ることになるとは思わなかったわ",
    "charAnim1": "sad2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
