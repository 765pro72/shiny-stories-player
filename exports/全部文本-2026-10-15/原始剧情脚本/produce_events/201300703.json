    "waitTime": 1000
  },
  {
    "id": 2013007030030,
    "speaker": "夏葉",
    "text": "それならいいのよ、うふふっ\r\n頑張って準備した甲斐があったわ！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030030"
  },
  {
    "speaker": "プロデューサー",
    "text": "……撮影本番はこれからだからな？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007030040,
    "speaker": "夏葉",
    "text": "もちろん、わかっているわ！",
    "charAnim1": "hello",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030040"
  },
  {
    "id": 2013007030050,
    "speaker": "夏葉",
    "text": "撮影が始まるまでは、ここで少し\r\n休憩していてって言われたけれど……",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030050"
  },
  {
    "speaker": "プロデューサー",
    "text": "その格好だと、\r\n少し移動するのも大変そうだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007030060,
    "speaker": "夏葉",
    "text": "ええ、汚したらいけないし\r\n大人しく座っているしかないわね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030060"
  },
  {
    "speaker": "プロデューサー",
    "text": "……何か必要なものがあれば\r\n俺が行ってくるぞ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2013007030070,
    "speaker": "夏葉",
    "text": "いいえ、違うのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030070"
  },
  {
    "id": 2013007030080,
    "speaker": "夏葉",
    "text": "さっき、外の高台からは海が見えて\r\nカリヨンの鐘もあるって聞いたから",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030080"
  },
  {
    "id": 2013007030090,
    "speaker": "夏葉",
    "text": "見てみたいと思って──",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/201300703/2013007030090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ、それならそこの窓から\r\n見えそうだぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
