    "voice": "produce_events/202201111/2022011110040"
  },
  {
    "speaker": "プロデューサー",
    "text": "あの俳優……ああ、この前の信重役の俳優さんだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2022011110050,
    "speaker": "小糸",
    "text": "はい……",
