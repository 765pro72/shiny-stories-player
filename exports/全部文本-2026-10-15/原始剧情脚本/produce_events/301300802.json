    "textFrame": "001",
    "voice": "produce_events/301300802/3013008020030"
  },
  {
    "id": 3013008020040,
    "speaker": "樹里",
    "text": "まぁ、見てりゃあな……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/301300802/3013008020040"
  },
  {
    "id": 3013008020050,
    "speaker": "凛世",
    "text": "視線……姿勢……\r\n気……",
