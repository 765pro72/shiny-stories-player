  },
  {
    "id": 6014001060050,
    "speaker": "甘奈",
    "text": "あれ、どうしたんだろ……",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_shy2",
    "charLabel": "amana",
    "textCtrl": "p",
    "textFrame": "001",
