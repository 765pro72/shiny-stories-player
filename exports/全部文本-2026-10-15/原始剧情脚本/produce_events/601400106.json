    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/601400106/6014001060030"
  },
  {
    "id": 6014001060040,
    "speaker": "甘奈",
    "text": "みんな、すごい笑顔で、\r\nそれで気付いたら甘奈も笑ってて……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
