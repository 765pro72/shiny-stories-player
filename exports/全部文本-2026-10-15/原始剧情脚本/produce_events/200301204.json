  {
    "speaker": "プロデューサー",
    "text": "どう……\r\nうーん",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『俺がファンなら、そういうちょっとした失敗も\r\n身近に感じられて嬉しいかな』",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0272"
  },
  {
    "speaker": "プロデューサー",
    "text": "『だから、そのままもう一回アップするのはどうだ？\r\nちょっとハッシュタグ付けてさ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003012040210,
    "speaker": "めぐる",
    "text": "『そっか！　そうするー！\r\nありがとー！』",
    "charAnim1": "smile2",
