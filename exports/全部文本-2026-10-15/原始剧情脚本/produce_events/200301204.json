  },
  {
    "id": 2003012040270,
    "speaker": "めぐる",
    "text": "『ツイスタで写真付け忘れちゃったんだけど\r\nこういうミス初めてで……』",
    "charLipAnim": "lip_sad_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040270"
  },
  {
    "id": 2003012040280,
    "speaker": "めぐる",
    "text": "『こういう時ってどうしたらいいかな！？\r\nわたしの思うようにしちゃっていい？』",
    "charAnim1": "sad1",
    "charLipAnim": "lip_sad_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040280"
  },
  {
    "id": 2003012040290,
    "speaker": "めぐる",
    "text": "『それとも、公式アカウントとして\r\n対応すべきこととかある！？』",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad_s",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040290"
  },
  {
    "charAnim1": "wait",
    "charLabel": "meguru",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
