    "text": "『本当』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『いったん写真のない投稿消してもいいし\r\n残しておいても問題ないよ』",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003012040310,
    "speaker": "めぐる",
    "text": "『そうなの……？』",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
