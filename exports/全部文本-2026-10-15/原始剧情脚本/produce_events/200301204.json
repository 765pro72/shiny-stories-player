    "waitTime": 1200
  },
  {
    "speaker": "プロデューサー",
    "text": "おおっ……連投すごいな……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "『全然ミスじゃないから大丈夫だ』",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0272"
  },
  {
    "id": 2003012040300,
    "speaker": "めぐる",
