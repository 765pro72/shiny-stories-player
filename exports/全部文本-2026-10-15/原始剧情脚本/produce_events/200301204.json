  {
    "id": 2003012040220,
    "speaker": "めぐる",
    "text": "『イルミネ！！！！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040220"
  },
  {
    "id": 2003012040230,
    "speaker": "めぐる",
    "text": "『#今日は（も？）一緒にいました！　#３ショット\r\n#真乃と灯織が同時に目をつぶった回　#仲良し』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040230"
  },
  {
    "id": 2003012040240,
    "speaker": "めぐる",
    "text": "『#みんな学校が違うのが不思議な感じ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200301204/2003012040240"
  },
  {
    "id": 2003012040250,
    "speaker": "めぐる",
    "text": "『#さっき間違えちゃった！　#ごめーん！\r\n#みんな見なかったことにしてほしいなー！』",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200301204/2003012040250"
  },
  {
    "label": "3",
    "speaker": "プロデューサー",
    "text": "（……なんてな。めぐるのことだから\r\n間違えて送信しちゃったとか、そういうところかな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
