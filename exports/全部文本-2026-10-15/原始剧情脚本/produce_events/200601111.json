    "voice": "produce_events/200601111/2006011110210"
  },
  {
    "id": 2006011110220,
    "speaker": "咲耶",
    "text": "撫で方がちょっと雑なんじゃないか？\r\nこの調子じゃ、髪が乱れてしまうよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charAnim3": "no",
