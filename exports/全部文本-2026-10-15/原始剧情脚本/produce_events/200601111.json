    "waitTime": 1500
  },
  {
    "speaker": "プロデューサー",
    "text": "うわっ……！？\r\nど、どうした……！？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110020,
    "speaker": "咲耶",
    "text": "フフ\r\nただの気まぐれ──……いや、悪戯かな",
    "charAnim1": "think",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110020"
  },
  {
    "id": 2006011110030,
    "speaker": "咲耶",
    "text": "ハロウィンの魔法がまだ続いているんだ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110030"
  },
  {
    "speaker": "プロデューサー",
    "text": "い、悪戯にしては……\r\n優しいというかなんというか……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110040,
    "speaker": "咲耶",
    "text": "そうかい？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110040"
  },
  {
    "id": 2006011110050,
    "speaker": "咲耶",
    "text": "──……男性は、頭を撫でられる機会に\r\n恵まれていないと思ってね",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110050"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "y": -50,
      "scale": 1,
      "time": 400
    },
    "se": "0242",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 2006011110060,
    "speaker": "咲耶",
    "text": "ファンの子たちも喜んでくれるし、私自身、\r\n素晴らしいスキンシップだと思っているのだけれど──",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110060"
  },
  {
    "id": 2006011110070,
    "speaker": "咲耶",
    "text": "プロデューサーにとってはどうなのか\r\n試してみたくなってしまって",
    "charAnim1": "wait5",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110070"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\n成人男性からすると、慣れない体験……かな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "ちょっと恥ずかしさが勝つっていうか……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110080,
    "speaker": "咲耶",
    "text": "おや\r\nそれはもったいない",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110080"
  },
  {
    "id": 2006011110090,
    "speaker": "咲耶",
    "text": "嫌ではないのなら、男性だから、\r\n大人だからという理由で避けてしまうのは損だよ",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110090"
  },
  {
    "id": 2006011110100,
    "speaker": "咲耶",
    "text": "せっかくだ、もう一度\r\n私に身を任せてみてくれないかな？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110100"
  },
  {
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "y": 50,
      "scale": 1.1,
      "time": 400
    },
    "se": "0242",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "わ、っとと……！\r\n咲耶待ってくれ……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textFrame": "off",
    "se": "0888",
    "waitType": "time",
    "waitTime": 1200
  },
  {
    "textFrame": "off",
    "se": "0888",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 2006011110110,
    "speaker": "咲耶",
    "text": "ほら──……\r\nよしよし、いい子だ",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110110"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は動物じゃないんだが……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110120,
    "speaker": "咲耶",
    "text": "そうやって気まずそうにしている顔も\r\nとても素敵だよ",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110120"
  },
  {
    "speaker": "プロデューサー",
    "text": "からかわないでくれって……！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110130,
    "speaker": "咲耶",
    "text": "フフ\r\nそんなつもりはないさ",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110130"
  },
  {
    "id": 2006011110140,
    "speaker": "咲耶",
    "text": "……アナタのすべてが、好ましいんだ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110140"
  },
  {
    "id": 2006011110150,
    "speaker": "咲耶",
    "text": "──……アナタのおかげで、\r\n私は素晴らしい毎日を謳歌している",
    "charAnim1": "wait5",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110150"
  },
  {
    "id": 2006011110160,
    "speaker": "咲耶",
    "text": "どれだけ感謝してもし足りない",
    "charAnim2": "face_wait",
    "charAnim3": "no",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110160"
  },
  {
    "id": 2006011110170,
    "speaker": "咲耶",
    "text": "私の指から──アナタに触れたところから\r\nそれが、伝わっているといいのだけれど",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110170"
  },
  {
    "speaker": "プロデューサー",
    "text": "！\r\n咲耶──……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ひとつ、いいか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110180,
    "speaker": "咲耶",
    "text": "うん？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601111/2006011110180"
  },
  {
    "speaker": "プロデューサー",
    "text": "男が頭を撫でられ慣れてないっていうなら……\r\n背の高い女の子だって、そうだと思うんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2006011110190,
    "speaker": "咲耶",
    "text": "え？　それはどういう──わ……！？",
    "charAnim1": "anger2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
