[
  {
    "speaker": "プロデューサー",
    "text": "『W.I.N.G.』に出場することが決まったぞ！\r\nやったな、摩美々！",
    "charAnim1": "wait1",
    "charLabel": "mamimi",
    "textCtrl": "p",
    "textFrame": "002",
    "charType": "characters",
