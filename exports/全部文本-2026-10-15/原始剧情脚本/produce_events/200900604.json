  },
  {
    "id": 2009006040190,
    "label": "1",
    "speaker": "果穂",
    "text": "無敵……！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040190"
  },
  {
    "id": 2009006040200,
    "speaker": "果穂",
    "text": "プロデューサーさんっ！\r\nどういうことですか！？",
    "charAnim1": "think",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂はファンから声援をもらうと、強くなるだろ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006040210,
    "speaker": "果穂",
    "text": "はい、スッゴく強くなれます！\r\nステージの上だと、なんだって出来ちゃいそうです！",
    "charAnim1": "sad2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040210"
  },
  {
    "speaker": "プロデューサー",
    "text": "元気な果穂の声を聞くと、ファンも元気になれるんだ\r\n果穂が、ジャスティスレッドから元気をもらったみたいに",
    "charAnim2": "face_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "果穂は応援する人の気持ちも、\r\nされる人も気持ちも知っている",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "応援の力を、\r\nめいっぱいのパフォーマンスでお返しできる……",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だから果穂は、無敵なんだ！",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006040220,
    "speaker": "果穂",
    "text": "わあ……！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040220"
  },
  {
    "id": 2009006040230,
    "speaker": "果穂",
    "text": "あたし、応援の声が聞こえると、\r\nその声に応えたくていっぱいがんばれちゃいます",
    "charAnim1": "wait2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040230"
  },
  {
    "id": 2009006040240,
    "speaker": "果穂",
    "text": "応援してくれた人にありがとうって\r\n気持ちを届けたくて……スッゴく力が湧いてくるんです！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "その気持ちが届いているからこそ\r\nみんなはもっと果穂のことを応援してくれるんだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006040250,
    "speaker": "果穂",
    "text": "そっか……\r\nちゃんと、届いてるんだ……",
    "charAnim1": "wait4",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040250"
  },
  {
    "id": 2009006040260,
    "speaker": "果穂",
    "text": "あたし、これからもいーっぱい、\r\nありがとうの気持ちを届けたいです！",
    "charAnim1": "shy2",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040260"
  },
  {
    "id": 2009006040270,
    "speaker": "果穂",
    "text": "それで、もっともっと無敵になっちゃいます！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "nextLabel": "end",
    "voice": "produce_events/200900604/2009006040270"
  },
  {
    "textFrame": "off"
  },
  {
    "label": "2",
    "speaker": "プロデューサー",
    "text": "果穂は、ファンの人たちに応援の声をもらうことが、\r\nどれだけ力になるかを知っている",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "だからさっきもヒーローに力強い声援を\r\n送ることができたんだな",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006040280,
    "speaker": "果穂",
    "text": "えへへ、プロデューサーさんの声も\r\nとっても力強くてカッコよかったです！",
    "charAnim1": "think",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040280"
  },
  {
    "id": 2009006040290,
    "speaker": "果穂",
    "text": "あたしも、プロデューサーさんに応援してもらうと\r\nスッゴく強くなれるんです！",
    "charAnim1": "smile1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040290"
  },
  {
    "speaker": "プロデューサー",
    "text": "それなら果穂がもっと強くなれるように\r\nいっぱい応援してサポートしないとな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2009006040300,
    "speaker": "果穂",
    "text": "はい……！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040300"
  },
  {
    "id": 2009006040310,
    "speaker": "果穂",
    "text": "ステージに立ってても、\r\nプロデューサーさんの声が聞こえる気がするんです",
