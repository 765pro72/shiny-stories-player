    "waitTime": 1000
  },
  {
    "id": 2009006040060,
    "speaker": "果穂",
    "text": "――あっ！？\r\nジャスティスレッドが倒れちゃいました……！",
    "charAnim1": "surp2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040060"
  },
  {
    "id": 2009006040070,
    "speaker": "果穂",
    "text": "プロデューサーさん！\r\nピンチの時こそ、ヒーローには応援が必要なんですっ！",
