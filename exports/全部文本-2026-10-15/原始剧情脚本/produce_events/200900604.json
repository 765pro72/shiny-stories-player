    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040320"
  },
  {
    "id": 2009006040330,
    "speaker": "果穂",
    "text": "プロデューサーさんの声が聞こえると……\r\nもっともっとがんばろうってやる気があふれてきます！",
