    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040330"
  },
  {
    "id": 2009006040340,
    "speaker": "果穂",
    "text": "だからこれからも……\r\nいっぱい応援、してください！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
