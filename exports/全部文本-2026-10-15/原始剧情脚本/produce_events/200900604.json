    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200900604/2009006040310"
  },
  {
    "id": 2009006040320,
    "speaker": "果穂",
    "text": "がんばれ、負けるな……って",
