  },
  {
    "id": 2009006040130,
    "speaker": "果穂",
    "text": "怪人がたくさん出てきた時は\r\nドキドキしちゃいましたけど……",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
