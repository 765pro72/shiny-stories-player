    },
    "voice": "produce_events/200601404/2006014040010"
  },
  {
    "speaker": "スタイリスト",
    "text": "可愛い～！\r\nよろしくお願いします！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "芸人１",
    "text": "なぁ最初にひとつ言っていい？\r\nなんでジャージなのにもうそんなきまってるん？",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "芸人１",
    "text": "ビフォーアフターのギャップ撮るために\r\nジャージ着てもらってるはずなのに、既にオシャレやん",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040020,
    "speaker": "咲耶",
    "text": "フフ、ありがとうございます",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040020"
  },
  {
    "speaker": "芸人２",
    "text": "顔がいいと全部よく見えるのか……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "芸人１",
    "text": "俺らがジャージ着たら芋くなるだけやのに\r\n何この格差",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "スタイリスト",
    "text": "そもそも現役アイドルと比べるなって話じゃない？",
    "charAnim1": "sad2",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "芸人１",
    "text": "いや事実やけど辛辣すぎ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "芸人２",
    "text": "咲耶ちゃん、せっかくだからカメラに向かってきめてみて？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040030,
    "speaker": "咲耶",
    "text": "──このあと私がどう変わるのか\r\nキミの目で見届けてほしいな",
    "charAnim1": "wink",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040030"
  },
  {
    "speaker": "芸人１",
    "text": "嘘やん無茶ぶりもすぐ対応する～～\r\nこの子絶対二物も三物もあるやん～～！",
    "textCtrl": "p",
    "textFrame": "003"
  },
