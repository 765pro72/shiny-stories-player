  {
    "speaker": "芸人１",
    "text": "──さぁ始まりました！\r\n今週のゲストは、アンティーカの白瀬咲耶ちゃん！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040010,
    "speaker": "咲耶",
    "text": "よろしくお願いします",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "3000060030",
    "charPosition": {
