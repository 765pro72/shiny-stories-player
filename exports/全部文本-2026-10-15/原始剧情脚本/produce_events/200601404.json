    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040110"
  },
  {
    "id": 2006014040120,
    "speaker": "咲耶",
    "text": "（……私、こんな顔をしているんだ……）",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040120"
  },
  {
    "speaker": "咲耶の祖母",
    "text": "やっぱり、前とは違うのねぇ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040130,
    "speaker": "咲耶",
    "text": "……え",
    "charAnim1": "surp2",
    "charAnim2": "blank",
    "charLipAnim": "lip_anger",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
