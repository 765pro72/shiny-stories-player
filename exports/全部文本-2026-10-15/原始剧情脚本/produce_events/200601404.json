  },
  {
    "textFrame": "off",
    "se": "1402",
    "waitType": "time",
    "waitTime": 1700
  },
  {
    "speaker": "咲耶の祖母",
    "text": "あらぁ、やっぱり可愛いわぁ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "咲耶の祖父",
    "text": "そうだな",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040040,
    "speaker": "咲耶",
    "text": "……\r\nお茶、代わりに淹れてこようか？",
    "charAnim1": "wait1",
    "charAnim2": "face_shy2",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "idols",
    "charId": "1040060080",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "from",
      "alpha": 0,
      "time": 100
    },
    "voice": "produce_events/200601404/2006014040040"
  },
  {
    "speaker": "咲耶の祖母",
    "text": "いいのいいの！\r\n咲耶ちゃん見終わったらおばあちゃんが淹れるわ、座ってて",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040050,
    "speaker": "咲耶",
    "text": "……",
    "charAnim1": "shy2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait_s",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040050"
  },
  {
    "speaker": "咲耶の祖母",
    "text": "あら！　もしかして今日のお洋服って\r\nテレビで出てるやつだったの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040060,
    "speaker": "咲耶",
    "text": "うん、そうだよ",
    "charAnim2": "face_shy",
    "charAnim3": "yes",
    "charAnim3Loop": false,
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040060"
  },
  {
    "speaker": "咲耶の祖母",
    "text": "ふふ、見せてくれたのねぇ\r\nありがとう",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040070,
    "speaker": "咲耶",
    "text": "……うん",
    "charAnim1": "smile2",
    "charAnim2": "blank",
