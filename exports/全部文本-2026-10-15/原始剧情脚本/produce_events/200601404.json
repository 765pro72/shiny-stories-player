  },
  {
    "id": 2006014040080,
    "speaker": "咲耶",
    "text": "ほ、本当ですか……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040080"
  },
  {
    "id": 2006014040090,
    "speaker": "咲耶",
    "text": "自分ではあまり選ばないタイプの服なので……\r\n私が着て大丈夫かなって不安で……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040090"
  },
  {
    "speaker": "咲耶の祖父",
    "text": "何も心配することないのになぁ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "咲耶の祖母",
    "text": "本当に！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 2006014040100,
    "speaker": "咲耶",
    "text": "……！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200601404/2006014040100"
  },
  {
    "id": 2006014040110,
    "speaker": "咲耶",
    "text": "（ずいぶん…………へにゃっとした────）",
