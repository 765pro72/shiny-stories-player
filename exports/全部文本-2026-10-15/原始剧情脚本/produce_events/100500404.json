  },
  {
    "speaker": "プロデューサー",
    "text": "（摩美々からの返信は──）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0272",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "プロデューサー",
    "text": "（……ないか……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "（心配、ではあるけど……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、具合が悪い時は\r\nゆっくり休ませてあげたほうがいいよな……）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "se": "0182",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "textFrame": "off",
    "se": "0182",
    "waitType": "time",
    "waitTime": 2000
  },
  {
    "speaker": "プロデューサー",
    "text": "──！",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "se": "0327",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "textFrame": "off",
    "se": "0330",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "もしもし\r\n摩美々……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040010,
    "speaker": "摩美々",
    "text": "『……お疲れ様ですー』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "029",
    "voice": "produce_events/100500404/1005004040010"
  },
  {
    "id": 1005004040020,
    "speaker": "摩美々",
    "text": "『プロデューサー、今大丈夫ですか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ああ\r\n俺は大丈夫だけど、摩美々は──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040030,
    "speaker": "摩美々",
    "text": "『……大丈夫だからかけてるんですケド』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040030"
  },
  {
    "speaker": "プロデューサー",
    "text": "まぁ、そうだよな……！\r\nはは……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "摩美々、具合はいいのか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040040,
    "speaker": "摩美々",
    "text": "『はいー\r\nおかげさまで』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040040"
  },
  {
    "id": 1005004040050,
    "speaker": "摩美々",
    "text": "『熱も下がって、\r\n雑誌用のアンケートを書いたりしてましたぁ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040050"
  },
  {
    "speaker": "プロデューサー",
    "text": "えっ……！\r\nこんな時なんだ、徹底的に休んだらどうだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040060,
    "speaker": "摩美々",
    "text": "『まぁ、そうなんですケド……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040060"
  },
  {
    "speaker": "プロデューサー",
    "text": "しばらくずっと忙しかったんだから\r\n今くらい、ゆっくり休んだって──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040070,
    "speaker": "摩美々",
    "text": "『…………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040070"
  },
  {
    "id": 1005004040080,
    "speaker": "摩美々",
    "text": "『プロデューサーにこそ\r\nそういう時間、必要だと思うんですケド』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040080"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは──\r\nはは、何も言い返せないな……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "それじゃあさ\r\n摩美々の体調が治ったら伝えようかと思ってたんだが──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "新しく、バラエティ番組の\r\n仕事が決まったぞ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040090,
    "speaker": "摩美々",
    "text": "『……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040090"
  },
  {
    "speaker": "プロデューサー",
    "text": "ただ、風邪のこともあるし\r\n無理はしないでほしい",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "とにかく、\r\n詳しい内容はこの後メールで送るよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040100,
    "speaker": "摩美々",
    "text": "『……はい\r\nわかりました』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040100"
  },
  {
    "textFrame": "off",
    "bgm": "fade_out",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1005004040110,
    "speaker": "摩美々＆プロデューサー",
    "text": "『…………』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040110"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1000
  },
  {
    "speaker": "プロデューサー",
    "text": "それじゃあ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040120,
    "speaker": "摩美々",
    "text": "『──『もしも１日誰かになれるとしたら』ってやつ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040120"
  },
  {
    "speaker": "プロデューサー",
    "text": "え？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040130,
    "speaker": "摩美々",
    "text": "『あるんですよー、雑誌のアンケートで』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "0000",
    "voice": "produce_events/100500404/1005004040130"
  },
  {
    "id": 1005004040140,
    "speaker": "摩美々",
    "text": "『……それ、私ー\r\nプロデューサーがいいなって思うんです』",
    "textCtrl": "p",
    "textFrame": "001",
    "bgm": "056",
    "voice": "produce_events/100500404/1005004040140"
  },
  {
    "speaker": "プロデューサー",
    "text": "はあ……\r\nそれはまた、なんで──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040150,
    "speaker": "摩美々",
    "text": "『……面白いから』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040150"
  },
  {
    "speaker": "プロデューサー",
    "text": "そ、そうか",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "──それじゃあ、摩美々が俺になってる時\r\n俺はどうしてるんだろうな……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040160,
    "speaker": "摩美々",
    "text": "『はぁ……\r\n……ふふ』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040160"
  },
  {
    "id": 1005004040170,
    "speaker": "摩美々",
    "text": "『逆に、プロデューサーは私になってるとか？』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040170"
  },
  {
    "speaker": "プロデューサー",
    "text": "それは……\r\nどうしたもんかなぁ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040180,
    "speaker": "摩美々",
    "text": "『ふふー……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040180"
  },
  {
    "id": 1005004040190,
    "speaker": "摩美々",
    "text": "『──ふぁ……』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ、長話してもよくないよな\r\nそれじゃあ──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040200,
    "speaker": "摩美々",
    "text": "『……事務所に居るんで』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040200"
  },
  {
    "speaker": "プロデューサー",
    "text": "え……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1005004040210,
    "speaker": "摩美々",
    "text": "『私が１日プロデューサーになったら\r\n私、事務所に居るんで』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040210"
  },
  {
    "id": 1005004040220,
    "speaker": "摩美々",
    "text": "『……だから\r\nプロデューサーが私になったら、事務所に来てくださいー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040220"
  },
  {
    "speaker": "プロデューサー",
    "text": "はは……\r\nおう、わかったよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 1500
  },
  {
    "id": 1005004040230,
    "speaker": "摩美々",
    "text": "『──じゃあ\r\n私、寝ますねー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040230"
  },
  {
    "id": 1005004040240,
    "speaker": "摩美々",
    "text": "『おやすみなさい』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/100500404/1005004040240"
  },
  {
    "speaker": "プロデューサー",
    "text": "……ああ\r\nおやすみ、摩美々",
    "textCtrl": "p",
    "textFrame": "002"
  },
