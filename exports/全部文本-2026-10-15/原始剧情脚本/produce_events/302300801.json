    "bgEffectTime": 800
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "id": 3023008010070,
    "speaker": "雛菜",
    "text": "でもみんなそうじゃないんですか？",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010070"
  },
  {
    "id": 3023008010080,
    "speaker": "雛菜",
    "text": "悪い運勢だな～って思ってたら\r\n余計悪いこと起こりそう！",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010080"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "た、確かに……",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "textFrame": "off",
    "bg": "00009",
    "bgEffect": "fade",
    "waitType": "time",
    "waitTime": 1000,
    "bgEffectTime": 1000
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "メイクスタッフ",
    "text": "じゃあそれ以外のはやったことある？\r\n手相とか……タロットとか！",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3023008010090,
    "speaker": "雛菜",
    "text": "あ～……\r\nなんか小さい頃手相の本とかは見たことあるかも？",
    "charAnim1": "wait4",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/302300801/3023008010090"
  },
  {
    "id": 3023008010100,
    "speaker": "雛菜",
    "text": "そういうのが流行ってた時があって～……",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010100"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "あったあった！\r\n定期的にそういうの流行るもんね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "その時はノクチルのみんなで手相占いしたの？",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3023008010110,
    "speaker": "雛菜",
    "text": "いえ……\r\nうちのママがそういうのすきなので～……",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010110"
  },
  {
    "id": 3023008010120,
    "speaker": "雛菜",
    "text": "でも、タロットはしたことないかも\r\nカードのやつですよね～？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010120"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "そうそう！　私、最近占いに行ってね\r\nタロット占いしてもらったんだ",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3023008010130,
    "speaker": "雛菜",
    "text": "へ～！\r\nどんな感じなんですか～？",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile2",
    "charLabel": "hinana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010130"
  },
  {
    "charAnim1": "wait",
    "charLipAnim": "lip_shy_s",
    "charLabel": "hinana",
    "textFrame": "off",
    "charEffect": {
      "type": "to",
      "alpha": 0,
      "time": 100
