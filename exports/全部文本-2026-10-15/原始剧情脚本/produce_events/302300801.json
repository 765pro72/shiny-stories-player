  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 500
  },
  {
    "speaker": "メイクスタッフ",
    "text": "色々やり方とかあるみたいだから\r\nその占い師さんによって違いがあるかもしれないけど",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "私がやってもらったのは自分で数を決めたり\r\nカードを選んだりするやつだったから",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "speaker": "メイクスタッフ",
    "text": "自分が選んだ運勢！　って感じがして\r\nよかったんだよね",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 3023008010140,
    "speaker": "雛菜",
    "text": "あ～\r\nなるほど～……",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/302300801/3023008010140"
  },
  {
