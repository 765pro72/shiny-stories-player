  {
    "speaker": "プロデューサー",
    "text": "もしもし？　ルビー？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2801005010010,
    "speaker": "ルビー",
    "text": "『はいはーい\r\n何？　どうしたのプロデューサー』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010010"
  },
  {
    "speaker": "プロデューサー",
    "text": "取引先でさ、展示イベントのチケットをもらったんだ\r\n『マイ・ショーケース』ってイベントなんだけど──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2801005010020,
    "speaker": "ルビー",
    "text": "『えっ！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "よかったら──",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2801005010030,
    "speaker": "ルビー",
    "text": "『行く行く行く！！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010030"
  },
  {
    "textFrame": "off",
    "bg": "00001",
    "bgEffect": "fade",
    "se": "1106",
    "waitType": "time",
    "waitTime": 800,
    "bgEffectTime": 500
  },
  {
    "textFrame": "off",
    "waitType": "time",
    "waitTime": 600
  },
  {
    "speaker": "プロデューサー",
    "text": "ははっ、即答だな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2801005010040,
    "speaker": "ルビー",
    "text": "『もちろんだよ！\r\nそのイベント、チケット争奪戦になったんだから！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010040"
  },
  {
    "id": 2801005010050,
    "speaker": "ルビー",
    "text": "『私全然取れなくてショックで──\r\nありがとうプロデューサー！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010050"
  },
  {
    "id": 2801005010060,
    "speaker": "ルビー",
    "text": "『プロデューサーもチケット譲ってくれた人に\r\nすっごい感謝しといた方がいいよ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "了解だ\r\nルビーの喜びようとあわせて改めて伝えておくよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2801005010070,
    "speaker": "ルビー",
    "text": "『うんお願い！\r\nふふっ、楽しみだなぁ……！』",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/280100501/2801005010070"
  },
  {
    "textFrame": "off",
    "bg": "00000",
    "bgEffect": "fade",
