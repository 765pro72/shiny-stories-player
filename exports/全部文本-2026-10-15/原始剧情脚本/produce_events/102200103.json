    "textFrame": "002"
  },
  {
    "id": 1022001030010,
    "speaker": "小糸",
    "text": "あ……、プロデューサーさん！",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "koito",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
