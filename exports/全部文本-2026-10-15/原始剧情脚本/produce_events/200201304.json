    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040320"
  },
  {
    "speaker": "プロデューサー",
    "text": "……え\r\nええ……？　なんのだ……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002013040330,
    "speaker": "灯織",
    "text": "プロデュースしてくださったりとか\r\nいつもフォローしてくださったりとか",
