    "charAnim2": "face_anger",
    "charLipAnim": "lip_surp",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040290"
  },
  {
    "id": 2002013040300,
    "speaker": "灯織",
    "text": "あの……\r\n押しつけがましくなってしまうんですけど……",
