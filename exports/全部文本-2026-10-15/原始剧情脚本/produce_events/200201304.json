  {
    "id": 2002013040250,
    "speaker": "灯織",
    "text": "……やはり迷惑でしたか？",
    "charAnim1": "sad3",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
