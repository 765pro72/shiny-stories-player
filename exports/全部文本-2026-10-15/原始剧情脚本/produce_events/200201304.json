    "voice": "produce_events/200201304/2002013040190"
  },
  {
    "speaker": "プロデューサー",
    "text": "いや……\r\n灯織が食べる分だと思ってたから",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002013040200,
    "speaker": "灯織",
    "text": "ええ……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charAnim4": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040200"
  },
  {
    "id": 2002013040210,
    "speaker": "灯織",
    "text": "そんな、自分だけが食べるなんてことしませんよ",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040210"
  },
  {
    "id": 2002013040220,
    "speaker": "灯織",
    "text": "この後真乃とめぐるが来るので、\r\nふたりにもおやつとして出すつもりですし",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040220"
  },
  {
    "id": 2002013040230,
    "speaker": "灯織",
    "text": "余れば早い者勝ちで置いておくので\r\n気にせず食べられる量を教えてもらえれば",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040230"
  },
  {
    "speaker": "プロデューサー",
    "text": "そうか……じゃあ遠慮なく\r\n１枚もらおうかな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2002013040240,
    "speaker": "灯織",
    "text": "わかりました",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040240"
  },
  {
