    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040360"
  },
  {
    "id": 2002013040370,
    "speaker": "灯織",
    "text": "そもそも、私はアイドルになりたくて\r\n自分で応募しているので",
