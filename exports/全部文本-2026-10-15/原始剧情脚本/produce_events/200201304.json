    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040310"
  },
  {
    "id": 2002013040320,
    "speaker": "灯織",
    "text": "お礼のつもりなんです",
