    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200201304/2002013040370"
  },
  {
    "id": 2002013040380,
    "speaker": "灯織",
    "text": "頑張ることは自分のためで\r\nお礼でもなんでもないですよ",
