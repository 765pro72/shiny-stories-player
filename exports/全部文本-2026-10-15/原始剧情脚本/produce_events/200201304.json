  {
    "id": 2002013040190,
    "speaker": "灯織",
    "text": "どうして驚いているんですか\r\n私、変なこと聞きましたか？",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
