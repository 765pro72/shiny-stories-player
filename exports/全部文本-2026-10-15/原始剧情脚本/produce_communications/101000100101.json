  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1010001001010050,
    "label": "1010001001012",
    "speaker": "智代子",
    "text": "流行を追うのはアイドルとしても大事なことですもんね",
