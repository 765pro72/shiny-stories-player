    "charLabel": "natsuha",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101300100111/1013001001110050"
  },
  {
    "id": 1013001001110060,
    "speaker": "夏葉",
    "text": "そういうバランスに気を付けるためにも\r\n自分で作るのが１番！　外食じゃそうはいかないわよ",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
