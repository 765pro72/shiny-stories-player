    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100300100131/1003001001310030"
  },
  {
    "id": 1003001001310040,
    "speaker": "めぐる",
    "text": "……えへへ！　でも、嬉しいな！\r\nそれじゃあわたしは、これからもアイドル、頑張るね！",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
