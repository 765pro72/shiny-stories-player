    "textFrame": "001",
    "voice": "produce_communications/100300100131/1003001001310020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（めぐるの恩返し、か。\r\n気持ちは嬉しいが、そうだなぁ……）",
    "charLabel": "meguru",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "お礼を言うのは\r\n俺のほうだよ",
    "nextLabel": "1003001001311"
  },
  {
    "select": "サプライズで頼む",
    "nextLabel": "1003001001312"
  },
  {
    "textCtrl": "cm",
    "select": "出世返しでいいよ",
    "nextLabel": "1003001001313"
  },
  {
    "id": 1003001001310030,
    "label": "1003001001311",
    "speaker": "めぐる",
    "text": "えー、プロデューサーがお礼しちゃうの！？\r\nお世話になってるのはわたしの方なのに！？",
