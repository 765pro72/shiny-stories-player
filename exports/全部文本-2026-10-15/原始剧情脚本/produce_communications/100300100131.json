    "text": "（よし、楽しく話せたな）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1003001001310050,
    "label": "1003001001312",
    "speaker": "めぐる",
    "text": "サプライズってわかってたら、\r\nサプライズにならないよー！",
