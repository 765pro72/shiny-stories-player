    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1003001001310020,
    "speaker": "めぐる",
    "text": "プロデューサーにはいつもお世話になってるし、\r\nたまには恩返しをしないとって思ったんだ！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
