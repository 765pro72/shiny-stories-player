    "nextLabel": "1802001000112"
  },
  {
    "textCtrl": "cm",
    "select": "ピーマン体操を\r\n歌ってたのに？",
    "nextLabel": "1802001000113"
  },
  {
    "id": 1802001000110030,
    "label": "1802001000111",
    "speaker": "かな",
    "text": "ピーマン体操のときは笑顔で食べてたから\r\nそんなふうには見えなかったでしょ？",
