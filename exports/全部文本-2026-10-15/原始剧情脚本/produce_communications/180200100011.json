    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/180200100011/1802001000110030"
  },
  {
    "id": 1802001000110040,
    "speaker": "かな",
    "text": "私の演技にすっかり騙されてたのね\r\n黒歴史だけど、頑張ったかいがあったわ",
