    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（ずいぶんと悩んで決めたようだが……）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "レッスンや仕事で\r\n消費すればいい",
    "nextLabel": "1010001000511"
  },
  {
