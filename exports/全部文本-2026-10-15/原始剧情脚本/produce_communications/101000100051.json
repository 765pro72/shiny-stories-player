    "nextLabel": "1010001000512"
  },
  {
    "textCtrl": "cm",
    "select": "それは食べ過ぎ",
    "nextLabel": "1010001000513"
  },
  {
    "id": 1010001000510030,
    "label": "1010001000511",
    "speaker": "智代子",
    "text": "はっ！　我慢しなくても、その手がありましたね……！\r\nプロデューサーさん、名案です！　さすが！",
