    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100051/1010001000510040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1010001000510050,
    "label": "1010001000512",
    "speaker": "智代子",
    "text": "そうなんですか！？\r\n……それじゃあ、パンもうひとつ食べてくればよかったなぁ",
