  },
  {
    "speaker": "プロデューサー",
    "text": "どうした？　何か聞きたいことでもあったか？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001000410020,
    "speaker": "智代子",
    "text": "その通りです！　質問させてください！\r\nスマホの新しいストラップ、どれがいいと思いますか？",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100041/1010001000410020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（この三つの中から選ぶのか）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "キャンディーのヤツ",
    "nextLabel": "1010001000411"
  },
  {
    "select": "お寿司のヤツ",
