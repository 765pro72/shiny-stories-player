  },
  {
    "speaker": "プロデューサー",
    "text": "（長崎についてか……）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "ちゃんぽんとか\r\n美味しいんだよな",
    "nextLabel": "1004001000611"
  },
  {
    "select": "国民的アイドルの\r\n出身地、だろ",
    "nextLabel": "1004001000612"
  },
  {
    "textCtrl": "cm",
    "select": "九州のひとつ？",
    "nextLabel": "1004001000613"
  },
  {
    "id": 1004001000610030,
    "label": "1004001000611",
    "speaker": "恋鐘",
    "text": "そうなんよ～！　\r\n他にも長崎は美味しいもんたくさんあるから最高たい！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100061/1004001000610030"
  },
  {
    "id": 1004001000610040,
    "speaker": "恋鐘",
    "text": "いつかプロデューサーも長崎に遊びに来るとよかよ！",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100061/1004001000610040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1004001000610050,
    "label": "1004001000612",
    "speaker": "恋鐘",
    "text": "んふふ～、その通り！\r\nやっぱりわかっとるね～、プロデューサー！",
    "charAnim1": "smile3",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100061/1004001000610050"
  },
  {
    "id": 1004001000610060,
    "speaker": "恋鐘",
    "text": "ばってん、うちの聞きたいことは\r\nそういうことじゃなかよ～",
    "charAnim1": "anger2",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100061/1004001000610060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1004001000610070,
    "label": "1004001000613",
    "speaker": "恋鐘",
    "text": "えー、まぁ、そうやけど……やっぱり東京では\r\nそのくらいの印象しかないんかなー",
    "charAnim1": "sad2",
    "charLipAnim": "lip_sad",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100061/1004001000610070"
  },
  {
    "id": 1004001000610080,
    "speaker": "恋鐘",
    "text": "いや……うちが有名になれば長崎も有名になるばい！\r\n頑張らんと……！",
