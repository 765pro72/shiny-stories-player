  },
  {
    "speaker": "プロデューサー",
    "text": "（部屋の片付けで悩んでいるのか……）",
    "charLabel": "yuika",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "収納スペースを\r\nＤＩＹだ",
    "nextLabel": "1007001000911"
