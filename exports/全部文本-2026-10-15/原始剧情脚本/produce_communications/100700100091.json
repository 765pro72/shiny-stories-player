    "charLabel": "yuika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100700100091/1007001000910030"
  },
  {
    "id": 1007001000910040,
    "speaker": "結華",
    "text": "それに、もしハマったらガテン系アイドルとか？\r\n新しい路線開拓しちゃうかもだよね！",
    "charAnim1": "wait1",
    "charAnim2": "face_smile",
