  {
    "speaker": "プロデューサー",
    "text": "ん？　和歌か何かか……？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1012001000210020,
    "speaker": "凛世",
    "text": "はい……\r\n今朝……同じようなことがありました……",
    "charAnim1": "wait1",
