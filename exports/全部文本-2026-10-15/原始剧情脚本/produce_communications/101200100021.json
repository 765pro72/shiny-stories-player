  },
  {
    "speaker": "プロデューサー",
    "text": "（夢のことを詠んだ歌、なのかな？）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "いい夢を見たのか？",
    "nextLabel": "1012001000211"
  },
  {
    "select": "どんな意味の歌なんだ？",
    "nextLabel": "1012001000212"
  },
  {
    "textCtrl": "cm",
    "select": "歌人と同じ体験が\r\nできたんだな",
    "nextLabel": "1012001000213"
  },
  {
    "id": 1012001000210030,
    "label": "1012001000211",
    "speaker": "凛世",
    "text": "はい……\r\n夢の中でも……夢から覚めても……",
    "charAnim1": "smile2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101200100021/1012001000210030"
  },
  {
    "id": 1012001000210040,
    "speaker": "凛世",
    "text": "プロデューサーさまにお会いできて……\r\n凛世は、幸せです……",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_shy",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101200100021/1012001000210040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1012001000210050,
    "label": "1012001000212",
    "speaker": "凛世",
    "text": "愛しい人を、夢に見て……\r\n覚めたくはなかった……と……",
    "charAnim1": "sad2",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101200100021/1012001000210050"
  },
  {
    "id": 1012001000210060,
    "speaker": "凛世",
    "text": "凛世にも……\r\nその心持ちが、よくわかるのです……",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_sad",
    "charLabel": "rinze",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101200100021/1012001000210060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "text": "//凛世、心もち悲しげに",
    "textCtrl": "p",
    "textFrame": "003"
  },
  {
    "id": 1012001000210070,
    "label": "1012001000213",
    "speaker": "凛世",
    "text": "はい……ですが……\r\n少し切ない……歌なのです……",
