    "voice": "produce_communications/100200100081/1002001000810070"
  },
  {
    "id": 1002001000810080,
    "speaker": "灯織",
    "text": "……やはり、私はしっかり勉強しておきたいです",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
