  },
  {
    "speaker": "プロデューサー",
    "text": "ん？　どうしたんだ、急に",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1002001000810020,
    "speaker": "灯織",
    "text": "仕事で目上の方に会って、言葉遣いに\r\n迷うことがあったんです",
    "charAnim1": "sad3",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100081/1002001000810020"
  },
  {
    "speaker": "プロデューサー",
    "text": "なるほどな。うーん、マナーか……",
    "charLabel": "hiori",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "礼儀を重んじるのは\r\nいいことだ",
    "nextLabel": "1002001000811"
  },
  {
    "select": "俺が教えてやる",
    "nextLabel": "1002001000812"
  },
  {
    "textCtrl": "cm",
    "select": "固くなりすぎない\r\nようにな",
    "nextLabel": "1002001000813"
  },
  {
    "id": 1002001000810030,
    "label": "1002001000811",
    "speaker": "灯織",
    "text": "はい。私もそう思います",
    "charAnim2": "face_anger",
    "charAnim3": "yes",
    "charLipAnim": "lip_wait",
    "charAnim3Loop": false,
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100081/1002001000810030"
  },
  {
    "id": 1002001000810040,
    "speaker": "灯織",
    "text": "人と関わるうえで、最低限のマナーは\r\n必要ですから",
    "charAnim1": "wait2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100081/1002001000810040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1002001000810050,
    "label": "1002001000812",
    "speaker": "灯織",
    "text": "ありがたいことですけど……\r\n教えてもらうばかりでは\r\nいけないと思ってて……",
    "charAnim1": "wait2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100081/1002001000810050"
  },
  {
    "id": 1002001000810060,
    "speaker": "灯織",
    "text": "少し、自分で勉強してから、\r\nプロデューサーに聞くようにします",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100081/1002001000810060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1002001000810070,
    "label": "1002001000813",
    "speaker": "灯織",
    "text": "たしかに、そういう考えもありますが……",
    "charAnim1": "anger1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
