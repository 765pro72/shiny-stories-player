  {
    "id": 1802001000910010,
    "speaker": "かな",
    "text": "あーあ、燃えちゃってるわね～\r\n下手に謝ったりするから、余計に加熱しちゃうのよ",
    "charAnim1": "wait2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_surp",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
