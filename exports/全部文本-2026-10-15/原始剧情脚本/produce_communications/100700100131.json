    "voice": "produce_communications/100700100131/1007001001310010"
  },
  {
    "id": 1007001001310020,
    "speaker": "結華",
    "text": "日頃レッスン頑張ってるからかなー\r\nやっぱりみんな上手なんだよね",
    "charAnim1": "wait1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "yuika",
