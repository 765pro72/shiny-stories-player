  {
    "id": 1802001001510010,
    "speaker": "かな",
    "text": "ねえ……プロデューサーは\r\n私のプロデュースを辞めたいって思ったことある？",
    "charAnim1": "wait3",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_shy",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
