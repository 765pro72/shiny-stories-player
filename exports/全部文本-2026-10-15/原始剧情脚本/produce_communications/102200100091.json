    "textFrame": "001",
    "voice": "produce_communications/102200100091/1022001000910050"
  },
  {
    "id": 1022001000910060,
    "speaker": "小糸",
    "text": "それも、円香ちゃんの\r\n優しいところのひとつです……たぶん",
