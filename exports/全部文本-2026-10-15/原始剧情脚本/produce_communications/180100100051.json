    "voice": "produce_communications/180100100051/1801001000510030"
  },
  {
    "id": 1801001000510040,
    "speaker": "ルビー",
    "text": "よし、これから毎日走り込みだ！\r\n目指せ１日走破200キロ！",
    "charAnim1": "anger2",
    "charAnim2": "face_anger2",
    "charLipAnim": "lip_wait",
