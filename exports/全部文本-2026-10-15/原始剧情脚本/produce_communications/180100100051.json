    "textFrame": "001",
    "voice": "produce_communications/180100100051/1801001000510020"
  },
  {
    "speaker": "プロデューサー",
    "text": "ふむふむ……って何十曲歌う気だこれ、\r\nアンコールですら３曲もあるじゃないか、これは……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "select": "やるなら\r\n体力つけなきゃな",
    "nextLabel": "1801001000511"
  },
  {
    "textFrame": "off",
