  },
  {
    "textCtrl": "cm",
    "select": "必要ないだろう",
    "nextLabel": "1002001001013"
  },
  {
    "id": 1002001001010030,
    "label": "1002001001011",
    "speaker": "灯織",
    "text": "はい、やるならきちんとケアしないといけませんし……\r\nトップアイドルを目指す以上、妥協はできません",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100101/1002001001010030"
  },
  {
    "id": 1002001001010040,
    "speaker": "灯織",
    "text": "プロデューサー、よろしくお願いします",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100101/1002001001010040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1002001001010050,
    "label": "1002001001012",
    "speaker": "灯織",
    "text": "ありがたいですが、男性と女性では\r\nやはり違うと思いますので……",
    "charAnim1": "surp1",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100101/1002001001010050"
  },
  {
    "id": 1002001001010060,
    "speaker": "灯織",
    "text": "……必要があれば、頼らせてもらいますから",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100101/1002001001010060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1002001001010070,
    "label": "1002001001013",
    "speaker": "灯織",
    "text": "そうでしょうか\r\nより綺麗になったほうがいいと思いますが……",
