    "voice": "produce_communications/100200100101/1002001001010010"
  },
  {
    "id": 1002001001010020,
    "speaker": "灯織",
    "text": "私も、もっと美容について気を使ったほうが\r\nいいでしょうか？",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100101/1002001001010020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（美容か……そうだな）",
