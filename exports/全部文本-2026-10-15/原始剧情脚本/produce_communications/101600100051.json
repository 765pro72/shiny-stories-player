    "textFrame": "001",
    "voice": "produce_communications/101600100051/1016001000510020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（今作っているのも\r\nすごく可愛らしいデザインのものみたいだが……）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "千雪が作ったもの\r\nなら嬉しいよ",
    "nextLabel": "1016001000511"
  },
  {
    "select": "可愛いのなんて、\r\n照れるよ",
    "nextLabel": "1016001000512"
  },
  {
    "textCtrl": "cm",
    "select": "千雪が持っていた\r\nほうがいいと思う",
    "nextLabel": "1016001000513"
  },
  {
    "id": 1016001000510030,
    "label": "1016001000511",
    "speaker": "千雪",
    "text": "わぁ、そんな……",
