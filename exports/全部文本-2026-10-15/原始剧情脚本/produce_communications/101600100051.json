    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100051/1016001000510050"
  },
  {
    "id": 1016001000510060,
    "speaker": "千雪",
    "text": "可愛いものとプロデューサーさん……\r\nきっとお似合いになるって、思いますよ？",
