    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100051/1016001000510030"
  },
  {
    "id": 1016001000510040,
    "speaker": "千雪",
    "text": "ふふ。じゃあ、どんなぬいぐるみがいいか\r\n教えていただかなきゃですね……♪",
