  },
  {
    "select": "ぽぉっぽるぅ～！",
    "nextLabel": "1001001001411"
  },
  {
    "select": "ピーちゃんの物真似か？",
    "nextLabel": "1001001001412"
  },
  {
    "textCtrl": "cm",
    "select": "ピーちゃんは留守番中\r\nじゃないの？",
    "nextLabel": "1001001001413"
  },
  {
    "id": 1001001001410030,
    "label": "1001001001411",
    "speaker": "真乃",
    "text": "ほわっ、プロデューサーさん、\r\n鳩さんの物真似、すっごく上手なんですね～っ",
    "charAnim1": "surp1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100100100141/1001001001410030"
  },
  {
    "id": 1001001001410040,
    "speaker": "真乃",
    "text": "なんて言ってくれたんですか？\r\n私は『今日も頑張ります』って言ったんですよ",
    "charAnim1": "smile3",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100100100141/1001001001410040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "charLabel": "mano"
  },
  {
    "id": 1001001001410050,
    "label": "1001001001412",
    "speaker": "真乃",
    "text": "はいっ、でもピーちゃんは鳩さんなので、\r\n人の言葉は喋れないんですけどね",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100100100141/1001001001410050"
  },
  {
    "id": 1001001001410060,
    "speaker": "真乃",
    "text": "なので『ぽっぽる～』のところだけが物真似です\r\nすごく似てるって、家族に好評なんですよっ",
    "charAnim1": "smile2",
    "charLipAnim": "lip_smile",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100100100141/1001001001410060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "charLabel": "mano"
  },
  {
    "id": 1001001001410070,
    "label": "1001001001413",
    "speaker": "真乃",
    "text": "そうなんです、ピーちゃんは私が帰るまで、\r\nとってもお利口さんにお留守番しててくれて……",
    "charAnim1": "sad1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_anger",
    "charLabel": "mano",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100100100141/1001001001410070"
  },
  {
    "id": 1001001001410080,
    "speaker": "真乃",
    "text": "ほわ……ちょっぴり、\r\nピーちゃんが恋しくなってきちゃいました……",
