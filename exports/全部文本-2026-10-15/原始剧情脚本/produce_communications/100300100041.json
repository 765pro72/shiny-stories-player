  {
    "id": 1003001000410030,
    "label": "1003001000411",
    "speaker": "めぐる",
    "text": "なるほどー！\r\nたしかにそれなら、ふたりとも喜んでくれそうだね！",
    "charAnim1": "shy1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100300100041/1003001000410030"
  },
  {
    "id": 1003001000410040,
    "speaker": "めぐる",
    "text": "わたしも気になってるお店があったんだ\r\nちょっと聞いてみる！",
    "charAnim1": "smile2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100300100041/1003001000410040"
  },
  {
