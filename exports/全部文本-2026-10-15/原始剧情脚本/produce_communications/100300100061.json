    "text": "（めぐるは悩んでいるみたいだ）",
    "charLabel": "meguru",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "早寝早起きが\r\nめぐるらしい",
    "nextLabel": "1003001000611"
  },
  {
    "select": "コーヒーを飲むといい",
    "nextLabel": "1003001000612"
  },
  {
    "textCtrl": "cm",
    "select": "夜更かしは\r\nしないほうがいいぞ",
    "nextLabel": "1003001000613"
  },
  {
    "id": 1003001000610030,
    "label": "1003001000611",
    "speaker": "めぐる",
    "text": "わたしらしさって早寝早起きなの！？\r\n……でもプロデューサーが言うなら、そうなんだよね！",
