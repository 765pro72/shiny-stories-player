    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100300100061/1003001000610030"
  },
  {
    "id": 1003001000610040,
    "speaker": "めぐる",
    "text": "じゃあこのままでもいいかも！\r\nありがとう、プロデューサー！",
