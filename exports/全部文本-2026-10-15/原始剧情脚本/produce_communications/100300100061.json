    "text": "（よし、楽しく話せたな）",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1003001000610050,
    "label": "1003001000612",
    "speaker": "めぐる",
    "text": "プロデューサーもよく飲んでるもんね！\r\n……ちょっと苦いけど",
