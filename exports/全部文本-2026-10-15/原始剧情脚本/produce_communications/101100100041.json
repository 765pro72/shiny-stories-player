  {
    "speaker": "プロデューサー",
    "text": "まあ、俺の制服みたいなものだからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011001000410020,
    "speaker": "樹里",
    "text": "アタシはどうも制服のネクタイが苦手でさー\r\nつけないことが多いんだよ",
