    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（そういえば樹里は普段、ネクタイをしていないな）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "ラフな着こなしも\r\n雰囲気あるぞ",
    "nextLabel": "1011001000411"
  },
  {
    "select": "樹里はネクタイも\r\n似合うと思う",
    "nextLabel": "1011001000412"
  },
  {
    "textCtrl": "cm",
    "select": "毎日してれば\r\n慣れるぞ",
    "nextLabel": "1011001000413"
  },
  {
    "id": 1011001000410030,
    "label": "1011001000411",
    "speaker": "樹里",
    "text": "着こなしってほど意識はしてねーよ\r\nただ、一番上までボタンしめると、窮屈だからな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410030"
  },
  {
    "id": 1011001000410040,
    "speaker": "樹里",
    "text": "でも、アンタはこういうアタシも受け止めてくれるんだな……",
    "charAnim1": "wait2",
    "charAnim2": "face_close",
    "charLipAnim": "lip_sad",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1011001000410050,
    "label": "1011001000412",
    "speaker": "樹里",
    "text": "友達にもネクタイ似合うって言われたことあるけどさ\r\nネクタイって結ぶのむずかしいんだよな",
    "charAnim1": "sad2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410050"
  },
  {
    "id": 1011001000410060,
    "speaker": "樹里",
    "text": "……今度、アンタに教えてもらおうかな",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410060"
  },
  {
