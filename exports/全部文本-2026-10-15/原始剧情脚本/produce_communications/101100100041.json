    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1011001000410070,
    "label": "1011001000413",
    "speaker": "樹里",
    "text": "慣れるか……そーゆーもんなのか？\r\nでも、どーもネクタイって窮屈で苦手なんだよなー",
    "charAnim1": "anger2",
    "charAnim2": "face_anger",
    "charLipAnim": "lip_wait",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100041/1011001000410070"
  },
  {
    "id": 1011001000410080,
