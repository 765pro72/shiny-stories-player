[
  {
    "id": 1006001001110010,
    "speaker": "咲耶",
    "text": "ねえ、プロデューサー\r\nアナタは黒と言えば、何を連想する？",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "sakuya",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
