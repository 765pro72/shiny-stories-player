  {
    "id": 1016001000410010,
    "speaker": "千雪",
    "text": "はい。ここに来るまでに道を尋ねられて……",
    "charAnim1": "sad2",
    "charAnim2": "face_sad",
    "charLipAnim": "lip_sad",
    "charLabel": "chiyuki",
    "textCtrl": "p",
