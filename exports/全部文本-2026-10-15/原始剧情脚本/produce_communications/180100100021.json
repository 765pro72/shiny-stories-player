  },
  {
    "speaker": "プロデューサー",
    "text": "学校の宿題か、どれどれ……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "select": "少し見てあげようか",
    "nextLabel": "1801001000211"
  },
  {
    "textFrame": "off",
    "select": "……肩、叩こうか",
    "nextLabel": "1801001000212"
  },
  {
    "textCtrl": "cm",
