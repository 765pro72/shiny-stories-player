  {
    "speaker": "プロデューサー",
    "text": "なんでいきなりおばあちゃんになってるんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1801001000210020,
    "speaker": "ルビー",
    "text": "いやー、宿題やってたら肩凝っちゃって\r\nでもこれやらないと怒られるしなー",
    "charAnim1": "wait1",
    "charAnim2": "face_sad1",
