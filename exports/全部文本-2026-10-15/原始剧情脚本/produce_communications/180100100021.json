    "textFrame": "001",
    "voice": "produce_communications/180100100021/1801001000210050"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "textFrame": "off",
    "nextLabel": "end"
