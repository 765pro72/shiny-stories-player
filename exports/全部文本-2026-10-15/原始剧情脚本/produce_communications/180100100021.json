  },
  {
    "id": 1801001000210040,
    "label": "1801001000212",
    "speaker": "ルビー",
    "text": "あはは、プロデューサーもわかんなかったんだ？\r\nだよね、難しいよねこの課題！",
    "charAnim1": "surp2",
    "charAnim2": "face_smile2",
    "charLipAnim": "lip_smile1",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/180100100021/1801001000210040"
  },
  {
    "id": 1801001000210050,
    "speaker": "ルビー",
    "text": "それじゃあ肩を叩くことで、少しでも\r\n担当アイドルをねぎらってもらおうかな～",
    "charAnim1": "wait4",
    "charAnim2": "face_sad2",
    "charLipAnim": "lip_smile1",
    "charLabel": "ruby",
