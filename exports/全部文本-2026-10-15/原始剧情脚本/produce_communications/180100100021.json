    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/180100100021/1801001000210030"
  },
  {
    "speaker": "プロデューサー",
    "text": "あくまでヒントだけだ\r\n自分で答えにたどり着かなきゃ意味ないからな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002"
