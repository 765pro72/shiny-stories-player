    "nextLabel": "1010001000213"
  },
  {
    "id": 1010001000210030,
    "label": "1010001000211",
    "speaker": "智代子",
    "text": "本当ですか！？　わーい！　練習の成果ですねっ",
    "charAnim1": "anger1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100021/1010001000210030"
  },
  {
    "id": 1010001000210040,
    "speaker": "智代子",
    "text": "でもまだ油断しませんよ、最高の笑顔を追求していきます！\r\nチョコアイドルは進化し続けるアイドルですから！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100021/1010001000210040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1010001000210050,
    "label": "1010001000212",
    "speaker": "智代子",
    "text": "えへへ、ありがとうございます！\r\nきっとこれ、ちりも積もればっていうヤツですよね！",
    "charAnim1": "wait3",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100021/1010001000210050"
  },
  {
    "id": 1010001000210060,
    "speaker": "智代子",
    "text": "いつでも笑顔を届けられるように、\r\n私、これからも頑張ります！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100021/1010001000210060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1010001000210070,
    "label": "1010001000213",
    "speaker": "智代子",
    "text": "な、なるほど！　アドバイスありがとうございます……！\r\n……にー……？",
    "charAnim1": "wait2",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_surp",
