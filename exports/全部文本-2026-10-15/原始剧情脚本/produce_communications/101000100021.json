  {
    "speaker": "プロデューサー",
    "text": "鏡とにらめっこして、どうしたんだ？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1010001000210020,
    "speaker": "智代子",
    "text": "あっ、プロデューサーさん！　おはようございます！\r\n挨拶と笑顔の練習をしていました！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
