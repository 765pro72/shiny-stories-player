    "voice": "produce_communications/100400100041/1004001000410030"
  },
  {
    "id": 1004001000410040,
    "speaker": "恋鐘",
    "text": "ファンの手を両手でしっかり包んで一番の笑顔！\r\nこれはばーり喜んでくれそうたい！",
    "charAnim1": "wait1",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100041/1004001000410040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1004001000410050,
    "label": "1004001000412",
    "speaker": "恋鐘",
    "text": "なるほどー、ファンとがっちり握手して\r\nうちの元気をみんなに送るわけやね！",
