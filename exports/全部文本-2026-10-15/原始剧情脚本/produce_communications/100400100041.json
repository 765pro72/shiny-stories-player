    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100041/1004001000410050"
  },
  {
    "id": 1004001000410060,
    "speaker": "恋鐘",
    "text": "握手したファンが一週間くらい寝んで良くなるほど\r\nうちのパワーを注入するばい！",
    "charAnim1": "wait2",
    "charLipAnim": "lip_smile",
    "charLabel": "kogane",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100400100041/1004001000410060"
  },
  {
