  {
    "id": 1801001000110010,
    "speaker": "ルビー",
    "text": "うー、今日は朝から最悪……",
    "charAnim1": "wait1",
    "charAnim2": "face_close2",
    "charLipAnim": "lip_sad",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "001",
