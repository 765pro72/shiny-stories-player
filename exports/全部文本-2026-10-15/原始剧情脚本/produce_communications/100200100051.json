    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100051/1002001000510050"
  },
  {
    "id": 1002001000510060,
    "speaker": "灯織",
    "text": "ただ、明日は……お言葉に甘えさせていただきます",
    "charAnim1": "sad3",
    "charLipAnim": "lip_angry",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100051/1002001000510060"
  },
  {
