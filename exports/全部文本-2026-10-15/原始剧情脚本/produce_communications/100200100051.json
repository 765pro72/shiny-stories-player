    "text": "（うーん、頑張りすぎだな）",
    "charLabel": "hiori",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "今日は早めに帰ろう",
    "nextLabel": "1002001000511"
  },
  {
