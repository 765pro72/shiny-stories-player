    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "charLabel": "hiori"
  },
  {
    "id": 1002001000510050,
    "label": "1002001000512",
    "speaker": "灯織",
    "text": "はい、私の自己管理が甘いせいですので……\r\n今日はきちんとやります",
