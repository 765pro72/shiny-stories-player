  {
    "id": 1802001000310010,
    "speaker": "かな",
    "text": "えーと、この問題は……\r\nこの公式を使えばいいんだっけ？",
    "charAnim1": "sad1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_sad",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
    "charType": "characters",
    "charId": "802",
    "charPosition": {
      "x": 568,
