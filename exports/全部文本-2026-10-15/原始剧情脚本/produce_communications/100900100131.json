    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100900100131/1009001001310050"
  },
  {
    "id": 1009001001310060,
    "speaker": "果穂",
    "text": "じゃあ、これからも頑張っていけば、\r\nヒーローみたいに勇気をあげられるんですね！",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100900100131/1009001001310060"
  },
  {
