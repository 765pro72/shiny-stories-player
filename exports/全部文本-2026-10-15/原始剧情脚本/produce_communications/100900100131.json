    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1009001001310070,
    "label": "1009001001313",
    "speaker": "果穂",
    "text": "たしかにヒーローも、思いは背中で語るもの\r\nって言ってました！",
