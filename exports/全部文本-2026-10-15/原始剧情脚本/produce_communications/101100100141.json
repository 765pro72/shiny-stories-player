  },
  {
    "speaker": "プロデューサー",
    "text": "どうしたんだ、急に",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1011001001410020,
    "speaker": "樹里",
    "text": "いや、なんか気になってさ\r\nやっぱ外に食べに行くのか？",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100141/1011001001410020"
  },
  {
    "speaker": "プロデューサー",
    "text": "俺は昼ごはんはいつも……",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "屋上でお弁当！",
    "nextLabel": "1011001001411"
  },
  {
    "select": "定食屋へ行く",
    "nextLabel": "1011001001412"
  },
  {
    "textCtrl": "cm",
    "select": "健康的にバナナ！",
    "nextLabel": "1011001001413"
  },
  {
    "id": 1011001001410030,
    "label": "1011001001411",
    "speaker": "樹里",
    "text": "お、実はアタシも学校の屋上で弁当食べること多いんだ",
    "charAnim1": "shy2",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100141/1011001001410030"
  },
  {
    "id": 1011001001410040,
    "speaker": "樹里",
    "text": "いつもはひとりだけど、\r\nプロデューサーとなら一緒してもいいかもな！",
    "charAnim1": "smile2",
    "charAnim2": "face_shy",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100141/1011001001410040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1011001001410050,
    "label": "1011001001412",
    "speaker": "樹里",
    "text": "おー、定食屋か。なんだか男って感じがするな",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100141/1011001001410050"
  },
  {
    "id": 1011001001410060,
    "speaker": "樹里",
    "text": "今度プロデューサーがよく行く定食屋に\r\n連れてってくれよ",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100141/1011001001410060"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1011001001410070,
    "label": "1011001001413",
    "speaker": "樹里",
    "text": "はあ？　バナナだけ？\r\n朝じゃなくて昼だぞ？",
    "charAnim1": "anger2",
