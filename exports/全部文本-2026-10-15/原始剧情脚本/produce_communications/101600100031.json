    "textFrame": "001",
    "voice": "produce_communications/101600100031/1016001000310070",
    "charAnim3Loop": false
  },
  {
    "id": 1016001000310080,
    "speaker": "千雪",
    "text": "でも、無理に押し付けてたらごめんなさい……\r\n……お昼は、ちゃんとしたものも食べてくださいね？",
