    "charLabel": "kaho",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100900100121/1009001001210030"
  },
  {
    "id": 1009001001210040,
    "speaker": "果穂",
    "text": "じゃあさっそく、鬼を決めるジャンケンをしましょうっ！",
