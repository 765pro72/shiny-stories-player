  },
  {
    "select": "多くの人に\r\n知ってもらえた証拠だ",
    "nextLabel": "1010001001411"
  },
  {
    "select": "ファンとの交流は\r\n大事だな",
    "nextLabel": "1010001001412"
  },
  {
    "textCtrl": "cm",
    "select": "みんなが智代子に、\r\n注目してるぞ",
