  {
    "id": 1802001000710010,
    "speaker": "かな",
    "text": "芸能人への質問コーナーで、\r\n使ってるシャンプーの項目ってあるでしょ",
    "charAnim1": "wait3",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_shy",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
