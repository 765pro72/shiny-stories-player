    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/180200100131/1802001001310030"
  },
  {
    "speaker": "プロデューサー",
    "text": "おすすめの動画か、そうだな……",
    "textCtrl": "l",
    "textFrame": "002"
  },
