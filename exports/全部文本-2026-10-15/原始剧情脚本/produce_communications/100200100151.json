    "charLipAnim": "lip_wait",
    "charLabel": "hiori",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/100200100151/1002001001510050"
  },
  {
    "id": 1002001001510060,
    "speaker": "灯織",
    "text": "体調には気をつけてくださいね",
