  },
  {
    "speaker": "プロデューサー",
    "text": "そうか、しっかりしてるなぁ……栄養バランスも\r\nいろどりもバッチリだし",
    "charLabel": "hiori",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "俺も見習わないとな",
    "nextLabel": "1002001001511"
  },
  {
    "select": "俺も料理しようかな",
    "nextLabel": "1002001001512"
  },
  {
    "textCtrl": "cm",
    "select": "俺にも分けてくれ",
    "nextLabel": "1002001001513"
  },
  {
    "id": 1002001001510030,
    "label": "1002001001511",
    "speaker": "灯織",
    "text": "そ、そこまで言ってもらうようなことでは\r\nありません。",
    "charAnim1": "shy3",
    "charAnim2": "blank",
