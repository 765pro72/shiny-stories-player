    "waitTime": 500
  },
  {
    "id": 1024001000410060,
    "speaker": "にちか",
    "text": "……っ\r\nテンション低いですよー……！",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/102400100041/1024001000410060"
  },
  {
    "id": 1024001000410070,
    "speaker": "にちか",
    "text": "そういうエラい、って感じのことじゃなくて\r\nスタッフの情熱が、お店を作ってるってことです！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_surp",
    "charLabel": "nichika",
    "textCtrl": "p",
    "textFrame": "001",
    "se": "0220",
    "voice": "produce_communications/102400100041/1024001000410070"
  },
  {
    "speaker": "プロデューサー",
    "text": "……！　そうだよな……\r\nなんだか、負けられない気持ちになってくるなぁ……！",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0730"
  },
  {
    "speaker": "プロデューサー",
    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002"
