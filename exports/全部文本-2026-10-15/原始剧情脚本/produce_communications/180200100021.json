  {
    "speaker": "プロデューサー",
    "text": "もらいもののお菓子があるから\r\nよかったら食べてくれ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1802001000210010,
    "speaker": "かな",
    "text": "あー、遠慮しておくわ\r\n私、糖質制限してるから",
    "charAnim1": "wait1",
    "charAnim2": "face_serious",
    "charLipAnim": "lip_shy",
