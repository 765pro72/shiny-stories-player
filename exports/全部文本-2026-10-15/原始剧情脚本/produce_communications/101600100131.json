    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1016001001310050,
    "label": "1016001001312",
    "speaker": "千雪",
    "text": "ええ\r\n新しいエプロンを買うのも素敵なんですけど……",
