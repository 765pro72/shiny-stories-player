  {
    "id": 1802001001410010,
    "speaker": "かな",
    "text": "あ……見て、プロデューサー！\r\nSNSの投稿で、私の書き込み見つけたんだけど",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_smile",
    "charLabel": "kana",
    "textCtrl": "p",
    "textFrame": "001",
