  {
    "speaker": "プロデューサー",
    "text": "冬優子、何を見て――\r\nああ、この前取材した雑誌か",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 1018001000410020,
    "speaker": "冬優子",
    "text": "ふゆが載ってるなんて、信じられないです……！\r\nまるで、アイドルみたい……！",
    "charAnim1": "sad1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101800100041/1018001000410020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（アイドルなんだけどな……）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "もっとすごいアイドルに\r\nなれるぞ",
    "nextLabel": "1018001000411"
  },
  {
    "select": "冬優子だってアイドルだ",
    "nextLabel": "1018001000412"
  },
  {
    "textCtrl": "cm",
    "select": "もうちょっと\r\n自覚を持とうな",
    "nextLabel": "1018001000413"
  },
  {
    "id": 1018001000410030,
    "label": "1018001000411",
    "speaker": "冬優子",
    "text": "あ……\r\nそ、そうですよね、もっとすごい、アイドルに……！",
    "charAnim1": "surp1",
    "charAnim2": "face_surp",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101800100041/1018001000410030"
  },
  {
    "id": 1018001000410040,
    "speaker": "冬優子",
    "text": "雑誌に出るくらいで驚かない……\r\nそんなすごいアイドルに、なっちゃいます！",
    "charAnim1": "smile1",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101800100041/1018001000410040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "textFrame": "off"
  },
  {
    "id": 1018001000410050,
    "label": "1018001000412",
    "speaker": "冬優子",
    "text": "そ、そうですね……\r\nふゆだって今は、アイドルですもんね！",
    "charAnim1": "think",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "fuyuko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101800100041/1018001000410050"
  },
  {
    "id": 1018001000410060,
    "speaker": "冬優子",
    "text": "えへへ、\r\n雑誌の自分が、自分じゃないように見えちゃいました",
