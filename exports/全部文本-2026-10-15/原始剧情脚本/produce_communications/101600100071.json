  },
  {
    "id": 1016001000710010,
    "speaker": "千雪",
    "text": "そうですか？\r\n……ふふ、たしかに、朝ってけっこう好きな時間帯かもです",
    "charAnim1": "wait2",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
