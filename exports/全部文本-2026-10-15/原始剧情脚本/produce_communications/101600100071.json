    "text": "（まぁ、普通に話せたかな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1016001000710070,
    "label": "1016001000713",
    "speaker": "千雪",
