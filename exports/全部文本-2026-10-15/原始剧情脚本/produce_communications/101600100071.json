    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710010"
  },
  {
    "id": 1016001000710020,
    "speaker": "千雪",
    "text": "最近はランニングをするようにもしてるんですよ\r\n朝に走ると、風がとても気持ちよくて",
    "charAnim1": "sad1",
    "charAnim2": "face_close",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710020"
  },
  {
    "speaker": "プロデューサー",
    "text": "（今朝を思い出しているのか\r\n話してる千雪も楽しそうだ）",
    "textCtrl": "l",
    "textFrame": "002"
  },
  {
    "select": "俺も走っていいか？",
    "nextLabel": "1016001000711"
  },
  {
    "select": "すれ違う人が\r\n挨拶してくれるよな",
    "nextLabel": "1016001000712"
  },
  {
    "textCtrl": "cm",
    "select": "朝は眠くて、\r\n俺には無理だな",
    "nextLabel": "1016001000713"
  },
  {
    "id": 1016001000710030,
    "label": "1016001000711",
    "speaker": "千雪",
    "text": "わぁ、それ、素敵です！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710030"
  },
  {
    "id": 1016001000710040,
    "speaker": "千雪",
    "text": "プロデューサーさんと一緒なら\r\nいつもよりたくさん走れそうです♪",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710040"
  },
  {
    "speaker": "プロデューサー",
    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1016001000710050,
    "label": "1016001000712",
    "speaker": "千雪",
    "text": "そうなんですよ\r\nみなさん笑顔で挨拶をしてくれるので",
    "charAnim1": "anger2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710050"
  },
  {
    "id": 1016001000710060,
    "speaker": "千雪",
    "text": "今日も一日頑張ろうって思えちゃうんですよね♪",
    "charAnim1": "surp1",
    "charAnim2": "blank",
    "charLipAnim": "lip_wait",
    "charLabel": "chiyuki",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101600100071/1016001000710060"
  },
  {
