    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "juri",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101100100101/1011001001010030"
  },
  {
    "id": 1011001001010040,
    "speaker": "樹里",
    "text": "なあ、アンタも一緒にやらねーか？\r\n一緒にいい汗流そうぜ！",
