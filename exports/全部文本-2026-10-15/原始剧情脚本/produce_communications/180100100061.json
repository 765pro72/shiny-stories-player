    "charAnim2": "blank",
    "charLipAnim": "lip_surp",
    "charLabel": "ruby",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/180100100061/1801001000610040"
  },
  {
    "id": 1801001000610050,
    "speaker": "ルビー",
    "text": "あーでも、そういうのもいいよね\r\n食べ過ぎもいけないし、カップ麺はんぶんこしよ！",
    "charAnim1": "wait1",
