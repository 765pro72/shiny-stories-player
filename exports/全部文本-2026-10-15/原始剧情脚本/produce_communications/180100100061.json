  {
    "textCtrl": "cm",
    "textFrame": "off",
    "select": "でも食べ過ぎは……",
    "nextLabel": "1801001000613"
  },
  {
    "id": 1801001000610030,
    "label": "1801001000611",
    "speaker": "ルビー",
    "text": "うおー、プロデューサー大好き！\r\nあざーっす！　ゴチになります！",
    "charAnim1": "smile2",
    "charAnim2": "blank",
    "charLipAnim": "lip_smile1",
    "charLabel": "ruby",
