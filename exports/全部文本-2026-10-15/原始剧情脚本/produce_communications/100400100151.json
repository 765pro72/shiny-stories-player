    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1004001001510050,
    "label": "1004001001512",
    "speaker": "恋鐘",
    "text": "おー！　うち、温泉好きやし\r\nそんなら毎日温泉に入れるし、ばりよか案ばいっ！",
