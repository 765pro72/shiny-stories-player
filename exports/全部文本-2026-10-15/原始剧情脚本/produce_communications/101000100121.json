    "charLabel": "chiyoko",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_communications/101000100121/1010001001210050"
  },
  {
    "id": 1010001001210060,
    "speaker": "智代子",
    "text": "ひとつだけなら決まってるじゃないですか！\r\nね？　ねっ？　ほら、あのお菓子ですよぅ",
    "charAnim1": "surp2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "chiyoko",
