    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1010001001210050,
    "label": "1010001001212",
    "speaker": "智代子",
    "text": "え？　あれ？　プロデューサーさん？",
