    "voice": "produce_communications/101000100121/1010001001210030"
  },
  {
    "id": 1010001001210040,
    "speaker": "智代子",
    "text": "甘いし美味しいし、万能の食べ物なんですよ\r\n無人島生活でも役立つこと間違いなしです！",
    "charAnim1": "smile1",
    "charAnim2": "face_smile",
