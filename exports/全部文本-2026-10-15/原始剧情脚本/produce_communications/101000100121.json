    "nextLabel": "1010001001212"
  },
  {
    "textCtrl": "cm",
    "select": "お菓子じゃなきゃ、\r\nダメか？",
    "nextLabel": "1010001001213"
  },
  {
    "id": 1010001001210030,
    "label": "1010001001211",
    "speaker": "智代子",
    "text": "やっぱりチョコですよね！\r\nプロデューサーさんはわかってます！",
