    "nextLabel": "1006001001412"
  },
  {
    "textCtrl": "cm",
    "select": "一生懸命な姿だけで\r\n充分だ",
    "nextLabel": "1006001001413"
  },
  {
    "id": 1006001001410030,
    "label": "1006001001411",
    "speaker": "咲耶",
    "text": "ああ。アナタのために、\r\n腕によりをかけようじゃないか",
