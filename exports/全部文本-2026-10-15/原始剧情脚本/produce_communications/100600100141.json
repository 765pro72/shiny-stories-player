    "text": "（よし、楽しく話せたな）",
    "textCtrl": "p",
    "textFrame": "002",
    "nextLabel": "end"
  },
  {
    "id": 1006001001410050,
    "label": "1006001001412",
    "speaker": "咲耶",
    "text": "謙虚なんだね\r\nもっと甘えてくれてもいいのに",
