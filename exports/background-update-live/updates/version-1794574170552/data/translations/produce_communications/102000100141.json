{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"透、運命って信じるか？","trans":"透，你相信命运吗？"},{"id":"1020001001410010","name":"透","text":"──えっ、何……","trans":"──诶，什么……"},{"id":"1020001001410020","name":"透","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、いや\\nすまん──","trans":"啊，没事\\n抱歉──"},{"id":"select","name":"","text":"ラス１のおにぎり、\\n好きな具だったんだ","trans":"比如最后剩下的饭团，\\n刚好是喜欢的口味"},{"id":"select","name":"","text":"テレビで\\nさっき言ってて","trans":"电视里\\n刚才有讲到"},{"id":"select","name":"","text":"冗談だよ","trans":"开个玩笑而已"},{"id":"1020001001410030","name":"透","text":"……ふふっ、コンビニで？\\nそれは──","trans":"……呵呵，便利店里？\\n那确实──"},{"id":"1020001001410040","name":"透","text":"運命だね","trans":"是命运啊"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1020001001410050","name":"透","text":"へぇ……","trans":"诶……"},{"id":"1020001001410060","name":"透","text":"テレビなんて、適当でしょ\\nプロデューサーがどう思うかじゃない？","trans":"电视里讲这个没什么吧\\n制作人又是怎么想的？"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1020001001410070","name":"透","text":"……ふーん","trans":"……嗯——哼"},{"id":"1020001001410080","name":"透","text":"ヘンな冗談だね","trans":"真是奇怪的玩笑"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}