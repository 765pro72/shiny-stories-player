{"translator":"岛木","rows":[{"id":"1020001001110010","name":"透","text":"ふぁ……──","trans":"哈啊……──"},{"id":"0000000000000","name":"プロデューサー","text":"なんだ？\\n寝てないみたいな顔してるな","trans":"怎么了？\\n又是一晚没睡的表情"},{"id":"0000000000000","name":"プロデューサー","text":"動画でも観てたか\\nよく休んでくれって言ったつもりなんだけど","trans":"又看视频了吗\\n我说过要好好休息了吧"},{"id":"1020001001110020","name":"透","text":"あ、うん\\nメッセありがとね","trans":"啊，嗯\\n谢谢你的短信"},{"id":"select","name":"","text":"今日はちゃんと\\n寝るんだぞ","trans":"今天要\\n老实睡觉啊"},{"id":"select","name":"","text":"しっかり休んでくれ","trans":"给我好好休息啊"},{"id":"select","name":"","text":"夜更かしは\\nほどほどに","trans":"熬夜就\\n适可而止吧"},{"id":"1020001001110030","name":"透","text":"大丈夫大丈夫","trans":"没事没事"},{"id":"1020001001110040","name":"透","text":"はい","trans":"好吧"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1020001001110050","name":"透","text":"うん。休んでる\\nでも──","trans":"嗯。会休息的\\n不过——"},{"id":"1020001001110060","name":"透","text":"プロデューサーも絶対ハマると思うんだけどな\\nあのドラマ","trans":"我觉得制作人看了那部电视剧\\n也绝对会着迷的"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1020001001110070","name":"透","text":"はいはい","trans":"好好"},{"id":"1020001001110080","name":"透","text":"プロデューサーもね","trans":"制作人也是一样哦"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}