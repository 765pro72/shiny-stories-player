{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──カバンについてるの、マスコットか？","trans":"──挂在书包上的，是吉祥物吗？"},{"id":"1020001001010010","name":"透","text":"これ？　うん","trans":"这个？　嗯"},{"id":"1020001001010020","name":"透","text":"雛菜につけられた","trans":"被雏菜挂上来的"},{"id":"0000000000000","name":"プロデューサー","text":"はは、つけられちゃったのか","trans":"哈哈，原来是被挂上来的啊"},{"id":"select","name":"","text":"仲いいな","trans":"关系真好啊"},{"id":"select","name":"","text":"可愛い\\nマスコットだな","trans":"吉祥物\\n真可爱啊"},{"id":"select","name":"","text":"透は優しいな","trans":"透真温柔啊"},{"id":"1020001001010030","name":"透","text":"──ふふっ。うん","trans":"──呵呵。嗯"},{"id":"1020001001010040","name":"透","text":"まぁね","trans":"还好吧"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1020001001010050","name":"透","text":"そう？","trans":"是吗？"},{"id":"1020001001010060","name":"透","text":"──そうかも\\n初めてちゃんと見た","trans":"──可能吧\\n还是第一次认真看"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1020001001010070","name":"透","text":"え？　うーん……","trans":"诶？　嗯……"},{"id":"1020001001010080","name":"透","text":"優しいとかってことじゃないけど……","trans":"虽然也算不上是温柔吧……"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}