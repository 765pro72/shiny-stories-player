{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──何見てるんだ？","trans":"──在看什么啊？"},{"id":"1020001000510010","name":"透","text":"え？　うん……窓","trans":"诶？　嗯……窗户"},{"id":"0000000000000","name":"プロデューサー","text":"窓？","trans":"窗户？"},{"id":"1020001000510020","name":"透","text":"窓っていうか、なんだろう……\\n窓の外？","trans":"与其说是窗户，怎么说好呢……\\n窗外？"},{"id":"0000000000000","name":"プロデューサー","text":"ええっと──","trans":"哦──"},{"id":"select","name":"","text":"鳥が飛んでるな","trans":"鸟在飞啊"},{"id":"select","name":"","text":"何かあるのか？","trans":"有什么呢？"},{"id":"select","name":"","text":"雨降るって\\n言ってたけど","trans":"听天气预报说\\n会下雨"},{"id":"1020001000510030","name":"透","text":"……ふふっ\\n何それ","trans":"……呵呵\\n那算什么"},{"id":"1020001000510040","name":"透","text":"飛んでるけどさ","trans":"虽然确实在飞啊"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1020001000510050","name":"透","text":"べつに、ないけど……","trans":"也没什么，特别的……"},{"id":"1020001000510060","name":"透","text":"明るいなーとか、\\n家だなーとか","trans":"很明亮啊\\n像在家一样啊─"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1020001000510070","name":"透","text":"え、今日？\\nそうなんだ","trans":"诶，今天？\\n这样啊"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}