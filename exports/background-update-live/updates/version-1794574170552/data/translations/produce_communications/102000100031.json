{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"朝からチョコレートか","trans":"早上就吃巧克力吗"},{"id":"1020001000310010","name":"透","text":"え、うん\\n朝から食べてこれなくて","trans":"诶，嗯\\n没吃早餐"},{"id":"1020001000310020","name":"透","text":"いる？","trans":"要吗"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"select","name":"","text":"もらっていいのか？","trans":"可以收下吗？"},{"id":"select","name":"","text":"大丈夫、大丈夫","trans":"没关系，不用了"},{"id":"select","name":"","text":"俺は、ちょっと\\nもたれるかな","trans":"没事\\n我暂时还不饿"},{"id":"1020001000310030","name":"透","text":"うん。いいよ","trans":"嗯。可以啊"},{"id":"1020001000310031","name":"透","text":"──あっ","trans":"──啊"},{"id":"1020001000310040","name":"透","text":"ヘンな感じに割れちゃった","trans":"掰成奇怪的形状了"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1020001000310050","name":"透","text":"いらないの？","trans":"不要吗？"},{"id":"1020001000310060","name":"透","text":"あと30秒でなくなっちゃうからね","trans":"还有30秒就吃完了"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1020001000310070","name":"透","text":"そうなんだ","trans":"这样啊"},{"id":"1020001000310080","name":"透","text":"ごめんね","trans":"抱歉"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}