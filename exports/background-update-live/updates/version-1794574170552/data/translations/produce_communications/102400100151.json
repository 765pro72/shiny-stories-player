{"translator":"岛木","rows":[{"id":"1024001001510010","name":"にちか","text":"ふぁさっ……！","trans":"哗啦……！"},{"id":"0000000000000","name":"プロデューサー","text":"────うわっ……！\\nなんだ、にちか……！","trans":"——呜哇……！\\n怎么了，日花……！"},{"id":"1024001001510020","name":"にちか","text":"髪、切りましたね……！\\nふぁさ……っ！！！","trans":"你剪头发了对吧……！\\n哗啦……！！！"},{"id":"0000000000000","name":"プロデューサー","text":"こ、こらこら……っ","trans":"喂，喂……"},{"id":"select","name":"","text":"くすぐったいって！","trans":"很痒啊！"},{"id":"select","name":"","text":"髪で\\n遊ばない！","trans":"不要\\n玩头发！"},{"id":"select","name":"","text":"ちょっと……！","trans":"等下……！"},{"id":"1024001001510030","name":"にちか","text":"あははははっ！\\nふぁさっ、ふぁさーーーっ！！","trans":"啊哈哈哈哈！\\n哗啦，哗啦——————！！"},{"id":"1024001001510040","name":"にちか","text":"あっ、逃げたら５倍にしますね！","trans":"啊，逃跑的话就要玩5倍的量了！"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、楽しく話せたな）","trans":""},{"id":"1024001001510050","name":"にちか","text":"えーっ\\nじゃ何なら遊んでいいんですかー？","trans":"欸\\n那玩什么就可以呢——？"},{"id":"0000000000000","name":"プロデューサー","text":"……えっ\\nえーと────","trans":"……欸\\n唔————"},{"id":"1024001001510060","name":"にちか","text":"じゃ、髪にしますねー！","trans":"那就头发吧——！"},{"id":"0000000000000","name":"プロデューサー","text":"（まぁ、普通に話せたかな）","trans":""},{"id":"1024001001510070","name":"にちか","text":"ちょっと、何ですかー？","trans":"怎么了——？"},{"id":"0000000000000","name":"プロデューサー","text":"いや、何ですかってそりゃあ────","trans":"不，要说怎么了那当然————"},{"id":"1024001001510080","name":"にちか","text":"ちょっとなんなのか\\n言ってもらわないとわからないですねー","trans":"不好好说清楚的话\\n我当然不懂啦——"},{"id":"0000000000000","name":"プロデューサー","text":"（うっ……しまった。別のことを言えば良かったな……）","trans":""}]}