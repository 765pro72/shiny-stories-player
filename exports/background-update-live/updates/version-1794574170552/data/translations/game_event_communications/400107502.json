{"translator":"","rows":[{"id":"4001075020010","name":"美琴","text":"ここまでで大丈夫？","trans":"送到这里可以吗？"},{"id":"4001075020020","name":"にちか","text":"あ、大丈夫です！","trans":"啊，可以了！"},{"id":"4001075020030","name":"にちか","text":"……はい、ほんとに","trans":"……嗯，真的可以了"},{"id":"4001075020040","name":"美琴","text":"そう","trans":"是吗"},{"id":"4001075020050","name":"美琴","text":"それじゃあ\\nゆっくり休んで","trans":"那就\\n好好休息吧"},{"id":"4001075020060","name":"にちか","text":"はい……","trans":"好的……"},{"id":"4001075020070","name":"にちか","text":"……────","trans":"……────"},{"id":"4001075020080","name":"にちか","text":"……った","trans":"……疼"},{"id":"4001075020090","name":"美琴","text":"１、２、３────\\nターン……！","trans":"1、2、3────\\n转身……！"},{"id":"4001075020100","name":"美琴","text":"……！","trans":"……！"},{"id":"4001075020110","name":"美琴","text":"…………","trans":"…………"},{"id":"4001075020120","name":"美琴","text":"少し休もう","trans":"稍微休息一下吧"},{"id":"4001075020130","name":"美琴","text":"…………","trans":"…………"},{"id":"4001075020140","name":"にちか","text":"…………","trans":"…………"},{"id":"4001075020150","name":"美琴","text":"緊張しているの？","trans":"你在紧张吗？"},{"id":"4001075020160","name":"にちか","text":"……！","trans":"……！"},{"id":"4001075020170","name":"にちか","text":"はは……\\nしてるかもです","trans":"哈哈……\\n可能是有点紧张"},{"id":"4001075020180","name":"にちか","text":"でも大丈夫です！\\nフィジカル鍛えたので！","trans":"但没关系的！\\n我体能已经锻炼过了！"},{"id":"4001075020190","name":"美琴","text":"うん\\n今日も最高のパフォーマンスにしよう","trans":"嗯\\n今天也要呈现出最棒的表演"},{"id":"4001075020200","name":"にちか","text":"はい……！","trans":"好的……！"},{"id":"4001075020210","name":"美琴","text":"……あの時──","trans":"……那时候──"},{"id":"4001075020220","name":"美琴","text":"私たちのことを初めて見る、\\nっていう人も、きっとたくさんいる","trans":"肯定有很多人，\\n是第一次来看我们"},{"id":"4001075020230","name":"美琴","text":"だから、印象に残るようなことをしたいの","trans":"所以，我想要给他们留下深刻的印象"},{"id":"4001075020240","name":"にちか","text":"は、はい……","trans":"是，是的……"},{"id":"4001075020250","name":"美琴","text":"曲の間奏部分に、\\nアクロバティックなダンスを取り入れるのはどうかな","trans":"在歌曲的间奏部分\\n加入一些特技舞蹈怎么样"},{"id":"4001075020260","name":"にちか","text":"…………","trans":"…………"},{"id":"4001075020270","name":"美琴","text":"どう思う？","trans":"你觉得呢？"},{"id":"4001075020280","name":"にちか","text":"えっ……\\nわ、私に聞いてます？","trans":"啊……\\n是在问我吗？"},{"id":"4001075020290","name":"美琴","text":"うん、もちろん","trans":"嗯，当然了"},{"id":"4001075020300","name":"にちか","text":"……そうですか────","trans":"……是吗────"},{"id":"4001075020310","name":"美琴","text":"無理そう？","trans":"做不到吗？"},{"id":"4001075020320","name":"にちか","text":"いえ……いえいえ！","trans":"不……不是的！"},{"id":"4001075020330","name":"にちか","text":"やります！\\n絶対、やります！","trans":"我会做的！\\n绝对会做到的！"},{"id":"4001075020340","name":"美琴","text":"わかった","trans":"明白了"},{"id":"4001075020350","name":"美琴","text":"なら振付を早めに決めて、それに合わせて\\nフィジカルトレーニングもしていかないとね","trans":"那我们要尽早决定好舞蹈动作，然后\\n进行相应的体能训练"},{"id":"4001075020360","name":"にちか","text":"はい……！","trans":"好的……！"},{"id":"4001075020370","name":"にちか","text":"私、めっちゃくちゃ鍛えますね！\\nムキムキになりますので！","trans":"我会拼命锻炼的！\\n会变得结实得不得了的！"},{"id":"4001075020380","name":"美琴","text":"うん","trans":"嗯"},{"id":"4001075020390","name":"美琴","text":"無理をさせていたのかも","trans":"我可能太勉强她了"},{"id":"4001075020400","name":"美琴","text":"でも、妥協はできない","trans":"但是，我不能妥协 "},{"id":"4001075020410","name":"美琴","text":"できない、けど────","trans":"不能妥协，不过────"},{"id":"4001075020420","name":"美琴","text":"…………──────","trans":"…………──────"},{"id":"4001075020430","name":"美琴","text":"………………","trans":"………………"},{"id":"4001075020440","name":"美琴","text":"……あ","trans":"……啊"},{"id":"4001075020450","name":"美琴","text":"もしもし","trans":"喂喂"},{"id":"4001075020460","name":"にちか","text":"『あ、美琴さん……今、大丈夫です？』","trans":"『啊，美琴小姐……现在方便吗？』"},{"id":"4001075020470","name":"美琴","text":"うん、大丈夫","trans":"嗯，方便"},{"id":"4001075020480","name":"美琴","text":"よかった\\n無事に帰れたみたいで","trans":"太好了\\n看来你顺利回到家了"},{"id":"4001075020490","name":"にちか","text":"『はい……\\nあの、ご迷惑おかけしてすみませんでした』","trans":"『是的……\\n那个，很抱歉给您添麻烦了』"},{"id":"4001075020500","name":"美琴","text":"ううん","trans":"没事"},{"id":"4001075020510","name":"にちか","text":"美琴さんは……\\nその、大丈夫……ですか？","trans":"美琴小姐……\\n那个，您还好吗？"},{"id":"4001075020520","name":"美琴","text":"『え？』","trans":"『嗯？』"},{"id":"4001075020530","name":"にちか","text":"あ……すみません","trans":"啊……对不起"},{"id":"4001075020540","name":"にちか","text":"なんだかちょっと\\n声に元気がない感じがして……","trans":"感觉你的声音\\n有点没精神……"},{"id":"4001075020550","name":"美琴","text":"そうかな……","trans":"是吗……"},{"id":"4001075020560","name":"美琴","text":"自分ではよくわからないや","trans":"我自己也不太清楚"},{"id":"4001075020570","name":"美琴","text":"……もしかして何か用事があった？","trans":"……你是不是有什么事？"},{"id":"4001075020580","name":"にちか","text":"『あ、えと……』","trans":"『啊，那个……』"},{"id":"4001075020590","name":"にちか","text":"『お礼がしたかったのと……\\nあと────』","trans":"『我想跟你道谢……\\n还有────』"},{"id":"4001075020600","name":"美琴","text":"うん","trans":"嗯"},{"id":"4001075020610","name":"にちか","text":"『今日はすみませんでした……\\n絶対、完璧なパフォーマンス見せられたのに────』","trans":"『今天真的很抱歉……\\n本来可以呈现出完美的表演的────』"},{"id":"4001075020620","name":"にちか","text":"『本当に……────』","trans":"『真的……────』"},{"id":"4001075020630","name":"美琴","text":"そうだね\\nそうかもしれない","trans":"是啊\\n可能是这样"},{"id":"4001075020640","name":"にちか","text":"『…………すみません────』","trans":"『…………对不起────』"},{"id":"4001075020650","name":"美琴","text":"早くよくなるといいね","trans":"希望你能早点好起来"},{"id":"4001075020660","name":"にちか","text":"『あ、明日の朝イチで病院行ってきます』","trans":"『啊，明天一早我会去医院的』"},{"id":"4001075020670","name":"美琴","text":"うん、気を付けて","trans":"嗯，小心点"},{"id":"4001075020680","name":"にちか","text":"『はい……』","trans":"『好的……』"},{"id":"4001075020690","name":"にちか","text":"『あ、じゃあ……そろそろ切りますね\\nお時間取っちゃってすみませんでした……』","trans":"『啊，那么……我先挂了\\n抱歉占用了您的时间……』"},{"id":"4001075020700","name":"美琴","text":"ううん","trans":"没事"},{"id":"4001075020710","name":"美琴","text":"それじゃあ、おやすみ","trans":"那，晚安"},{"id":"4001075020720","name":"にちか","text":"『はい、おやすみなさい』","trans":"『嗯，晚安』"},{"id":"4001075020730","name":"美琴","text":"…………","trans":"…………"}]}