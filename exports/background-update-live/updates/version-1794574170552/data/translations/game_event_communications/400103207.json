{"translator":"告","rows":[{"id":"4001032070010","name":"透","text":"──後ろふたりの肩に乗るってことでしょ、実質","trans":"——实际上，就是坐在后面两个人的肩上吧"},{"id":"4001032070020","name":"雛菜","text":"ん～\\n後ろは身長が合ってた方がいいって書いてあるけど","trans":"嗯～\\n上面写后面的人身高差不多比较好"},{"id":"4001032070030","name":"小糸","text":"じゃ、じゃあ────","trans":"那，那————"},{"id":"4001032070040","name":"円香","text":"じゃあ、浅倉と私","trans":"那，浅仓和我"},{"id":"4001032070050","name":"透","text":"うん","trans":"嗯"},{"id":"4001032070060","name":"雛菜","text":"じゃあ雛菜が先頭ね～","trans":"那雏菜站前面～"},{"id":"0000000000000","name":"プロデューサー","text":"──聞いてほしい\\n俺の方から、ひとつ条件を出したいんだ","trans":"——你们听一下\\n我有一个条件"},{"id":"0000000000000","name":"プロデューサー","text":"今回、優勝してきてほしい","trans":"这次，我希望你们优胜"},{"id":"4001032070070","name":"小糸","text":"……！\\nゆ、優勝って……","trans":"……！\\n优，优胜是……！"},{"id":"4001032070080","name":"雛菜","text":"全部のユニットの中で\\n１位とるってこと～？","trans":"在所有组里\\n拿到第1名吗～？"},{"id":"0000000000000","name":"プロデューサー","text":"うん\\nそれができるなら、オファーを受ける","trans":"嗯\\n你们做得到的话，我就接下这份工作"},{"id":"4001032070090","name":"透","text":"ふふっ\\n頑張って、雛菜","trans":"呵呵\\n加油，雏菜"},{"id":"4001032070100","name":"透","text":"突撃部長","trans":"突击部长"},{"id":"4001032070110","name":"雛菜","text":"あは～\\nど～ん！","trans":"啊哈～\\n咚～！"},{"id":"4001032070120","name":"円香","text":"ちゃんとやってね","trans":"要好好做"},{"id":"4001032070130","name":"雛菜","text":"は～い","trans":"好～"},{"id":"4001032070140","name":"円香","text":"なぜ、優勝なんですか","trans":"为什么是优胜"},{"id":"0000000000000","name":"プロデューサー","text":"……これは、プロデューサーとしての\\n俺の真剣なオーダーだ","trans":"……这是作为制作人的\\n我认真的要求"},{"id":"0000000000000","name":"プロデューサー","text":"できなさそうだったら、\\n出る価値のある案件じゃないと思ってる","trans":"如果你们做不到的话，\\n这份工作就不值得你们出场"},{"id":"4001032070150","name":"小糸","text":"…………！","trans":""},{"id":"4001032070160","name":"円香","text":"小糸、足かけて\\n──せーので立ち上がる","trans":"小糸，脚上来\\n————预备之后会站起来"},{"id":"4001032070170","name":"円香","text":"せーの────","trans":"预——备————"},{"id":"4001032070180","name":"透","text":"あ、ごめん","trans":"啊，抱歉"},{"id":"4001032070190","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"4001032070200","name":"小糸","text":"わ、わ……！","trans":"哇，哇……！"},{"id":"4001032070210","name":"円香","text":"……","trans":""},{"id":"4001032070220","name":"雛菜","text":"……","trans":""},{"id":"4001032070230","name":"小糸","text":"……え、えっと……\\n…………","trans":"……那，那个……\\n…………"},{"id":"4001032070240","name":"透","text":"……え\\nあー……","trans":"……诶\\n啊——……"},{"id":"4001032070250","name":"透","text":"じゃ、出る？","trans":"要出发吗？"},{"id":"4001032070260","name":"小糸","text":"……！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"優勝、できるのか","trans":"你们，能优胜吗"},{"id":"4001032070270","name":"透","text":"え\\nんー……","trans":"诶\\n嗯——……"},{"id":"4001032070280","name":"透","text":"ふふっ\\nごめんごめん","trans":"呵呵\\n抱歉抱歉"},{"id":"4001032070290","name":"透","text":"入った、目に\\n前髪","trans":"进眼睛了\\n刘海"},{"id":"4001032070300","name":"小糸","text":"ご、ごめん\\nわ、わたしのせいで……","trans":"对，对不起\\n都，都是我的错……"},{"id":"4001032070310","name":"小糸","text":"なるべく、そーっと乗るね……","trans":"我尽量，慢慢地骑……"},{"id":"4001032070320","name":"円香","text":"いい\\n遠慮してたらやられる","trans":"没事\\n太顾虑会被干掉"},{"id":"4001032070330","name":"雛菜","text":"ね、プロデューサーは\\nできると思う～？","trans":"对了，制作人\\n觉得做得到吗～？"},{"id":"0000000000000","name":"プロデューサー","text":"…………\\n少なくとも、できないとは言えないと思ってる","trans":"…………\\n至少，我想我没法说你们做不到"},{"id":"4001032070340","name":"雛菜","text":"あは～\\nどっち～？","trans":"啊哈～\\n到底怎样～？"},{"id":"4001032070350","name":"小糸","text":"ひ、雛菜ちゃん……","trans":"雏，雏菜……"},{"id":"4001032070360","name":"円香","text":"できなかったら反省文？","trans":"做不到的话写悔过书？"},{"id":"0000000000000","name":"プロデューサー","text":"いや……\\nできなかったらどうかするってことではないよ。けど──","trans":"不……\\n这不是做不到的话要怎么办的问题。但是——"},{"id":"0000000000000","name":"プロデューサー","text":"優勝したら、\\n見えてるものが変わるって思う","trans":"你们优胜的话，\\n我觉得你们看到的事物会产生变化"},{"id":"4001032070370","name":"透","text":"──オッケー\\nじゃ、もう一回","trans":"——OK\\n那再来"},{"id":"4001032070380","name":"雛菜","text":"せ～の────","trans":"预～备————"},{"id":"4001032070390","name":"小糸","text":"わ……！","trans":"哇……！"},{"id":"4001032070400","name":"小糸","text":"────た、高いね……！　結構……！","trans":"————还，还挺高的……！"},{"id":"4001032070410","name":"透","text":"ふふっ\\nいいね","trans":"呵呵\\n不错呢"},{"id":"4001032070420","name":"透","text":"じゃ出たい人ー\\nはい","trans":"那想出发的人——\\n我"},{"id":"4001032070430","name":"円香","text":"はいはい","trans":"我我我"},{"id":"4001032070440","name":"雛菜","text":"は～い","trans":"来了～"},{"id":"4001032070450","name":"小糸","text":"……！\\nは、はい……！","trans":"……！\\n好，好的……！"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"4001032070460","name":"透","text":"じゃあ、します\\n優勝","trans":"那，会成功的\\n优胜"},{"id":"4001032070470","name":"雛菜","text":"雛菜は好きなとこ\\n行っていいの～？","trans":"可以\\n去雏菜想去的地方吗～？"},{"id":"4001032070480","name":"透","text":"うん","trans":"嗯"},{"id":"4001032070490","name":"円香","text":"行く方向と、\\n走るか歩くかくらいは言って","trans":"至少说一下，\\n要去的方向，还有走路还是跑步"},{"id":"4001032070500","name":"雛菜","text":"は～い","trans":"好～"},{"id":"4001032070510","name":"小糸","text":"と、透ちゃん……！","trans":"小，小透……！"},{"id":"4001032070520","name":"雛菜","text":"あは～\\nじゃあ雛菜も優勝か～","trans":"啊哈～\\n那雏菜也优胜吗～"},{"id":"4001032070530","name":"小糸","text":"ひ、雛菜ちゃん……！","trans":"雏，雏菜……！"},{"id":"4001032070540","name":"円香","text":"ん\\nいい、いい","trans":"嗯\\n算了，算了"},{"id":"4001032070550","name":"円香","text":"優勝するって言わなきゃ\\n出られないんでしょ","trans":"不说要优胜的话\\n我们也没法出场吧"},{"id":"4001032070560","name":"小糸","text":"……！","trans":""},{"id":"4001032070570","name":"小糸","text":"そ、そっか……","trans":"对，对哦……！"},{"id":"4001032070580","name":"雛菜","text":"じゃあ\\n右の鏡の方に────","trans":"那\\n往右边镜子的方向————"},{"id":"4001032070590","name":"雛菜","text":"走る～！","trans":"用跑的～！"},{"id":"4001032070600","name":"透","text":"イエー","trans":"耶——"},{"id":"4001032070610","name":"円香","text":"行くよ、小糸","trans":"要走了，小糸"},{"id":"4001032070620","name":"小糸","text":"う、うん……！\\n────ぴぇ……！","trans":"啊，嗯……！\\n————耶……！"},{"id":"0000000000000","name":"プロデューサー","text":"わかった\\nそれじゃ、オファーを受ける","trans":"知道了\\n那我去接下这份工作"},{"id":"0000000000000","name":"プロデューサー","text":"頼めるか、みんな","trans":"能拜托你们吗"},{"id":"4001032070630","name":"円香","text":"雛菜にちゃんとつかまって","trans":"抓紧雏菜"},{"id":"4001032070640","name":"小糸","text":"う、うん……！\\n大丈夫……！","trans":"啊，嗯……！\\n没问题……！"},{"id":"4001032070650","name":"雛菜","text":"じゃあ、次左～","trans":"那，接着往左～"},{"id":"4001032070660","name":"透","text":"イエー","trans":"耶——"},{"id":"4001032070670","name":"雛菜","text":"全速力～","trans":"全速前进～"},{"id":"4001032070680","name":"透","text":"──あ","trans":"——啊"},{"id":"4001032070690","name":"小糸","text":"ぴぇ……！","trans":"耶……！"},{"id":"4001032070700","name":"透","text":"風","trans":"风"},{"id":"4001032070710","name":"雛菜","text":"あは～！","trans":"啊哈～"},{"id":"4001032070720","name":"透","text":"風","trans":"风"},{"id":"4001032070730","name":"円香","text":"壁まで行ったら、右に曲がって","trans":"到墙壁那边就右转"},{"id":"4001032070740","name":"雛菜","text":"は～い","trans":"好～"},{"id":"4001032070750","name":"透","text":"が","trans":"要"},{"id":"4001032070760","name":"透","text":"くる","trans":"来了"},{"id":"4001032070770","name":"雛菜","text":"ど～ん！\\n小糸ちゃん、壁にタッチ～！","trans":"咚～！\\n小糸，碰墙璧～！"},{"id":"4001032070780","name":"円香","text":"帽子取るイメージ","trans":"抓帽子的感觉"},{"id":"4001032070790","name":"小糸","text":"わ、うん……！","trans":"哇，嗯……！"},{"id":"4001032070800","name":"小糸","text":"た、タッチ…………！","trans":"碰，碰一下…………！"},{"id":"4001032070810","name":"透","text":"どーん\\n一騎撃破","trans":"咚——\\n一队击破"},{"id":"0000000000000","name":"off","text":"ピース・オブ・エイト！\\nオキロ　ノロマ！","trans":"Piece of eight！\\n起床 慢性子！"},{"id":"4001032070820","name":"透","text":"もしかすると","trans":"或许"},{"id":"4001032070830","name":"透","text":"本当の世界になる","trans":"会成为真正的世界"},{"id":"4001032070840","name":"雛菜","text":"ね、お水いる？","trans":"要喝水吗？"},{"id":"0000000000000","name":"オウム","text":"アー……","trans":"啊——……"},{"id":"4001032070850","name":"雛菜","text":"いる～？\\nいらない～？","trans":"喝～？\\n不喝～？"},{"id":"4001032070860","name":"雛菜","text":"ん～……","trans":"嗯～……"},{"id":"4001032070870","name":"雛菜","text":"あ、お菓子にする～？","trans":"啊，要吃点心吗～？"},{"id":"0000000000000","name":"オウム","text":"ンー……","trans":"嗯——……"},{"id":"4001032070880","name":"雛菜","text":"あは～\\n透先輩じゃん","trans":"啊哈～\\n是透学姐"},{"id":"0000000000000","name":"オウム","text":"アー……","trans":"啊——……"},{"id":"4001032070890","name":"小糸","text":"透ちゃん、まだかかるのかな……","trans":"小透，还要很久吗……"},{"id":"4001032070900","name":"円香","text":"さぁ……\\n居残りっていっても、宿題終わらせるだけだから","trans":"谁知道……\\n说是要她留下来，也就是让她写完作业而已"},{"id":"4001032070910","name":"円香","text":"…………────","trans":""},{"id":"4001032070920","name":"小糸","text":"透ちゃんの本、\\nちょっと増えてるね……","trans":"小透的书，\\n变得有点多了……"},{"id":"4001032070930","name":"円香","text":"そうだね\\n大掃除で出てきたっぽい","trans":"是啊\\n好像大扫除的时候翻出来的"},{"id":"4001032070940","name":"小糸","text":"小さい時のやつかな……\\n──なんとなく、表紙覚えてるような気もする……","trans":"是小时候看的吗……\\n——总觉得记得这些书的封面……"},{"id":"4001032070950","name":"円香","text":"ん……","trans":"嗯……"},{"id":"4001032070960","name":"円香","text":"見る？","trans":"看吗？"},{"id":"4001032070970","name":"小糸","text":"あ、ううん……！\\nごめんね、読んでたのに……！","trans":"啊，没有……！\\n对不起，明明是你在看……！"},{"id":"4001032070980","name":"円香","text":"ちゃんと読んでたわけじゃないから","trans":"我也没特别认真在看"},{"id":"4001032070990","name":"小糸","text":"ヨットの本……？","trans":"小船的书……？"},{"id":"4001032071000","name":"円香","text":"……みたいね\\nきょうだい４人が、ヨットで冒険してる","trans":"……好像是\\n四兄弟，在搭船冒险"},{"id":"4001032071010","name":"雛菜","text":"ね、シャケって言える～？\\nしゃ、け～","trans":"会说鲑鱼吗～？\\n鲑，鱼～"},{"id":"0000000000000","name":"オウム","text":"アー……","trans":"啊——……"},{"id":"4001032071020","name":"小糸","text":"冒険なんだ……\\nモンスターが出てくるとか、そういう感じ……？","trans":"原来是冒险……\\n是那种怪兽会出现的……？"},{"id":"4001032071030","name":"円香","text":"ううん\\n避暑で田舎に来て……湖の島でキャンプしてる","trans":"不是\\n是为了避暑来乡下……然后在湖中小岛上野营"},{"id":"4001032071040","name":"円香","text":"魚釣ったり、泳いだり、\\nたき火で料理したりとか","trans":"钓个鱼，游个泳，\\n点个篝火做料理之类的"},{"id":"4001032071050","name":"小糸","text":"へぇ……！\\nじゃあ、普通の夏休みって感じだね……！","trans":"嘿……！\\n那就是很普通的暑假嘛……！"},{"id":"4001032071060","name":"円香","text":"そうだね","trans":"是啊"},{"id":"4001032071070","name":"雛菜","text":"しゃ、け～\\n言ってみて～、しゃ、け～","trans":"鲑，鱼～\\n说一下，鲑，鱼～"},{"id":"4001032071080","name":"円香","text":"────でも、この子たちには海に見えてる","trans":"————可是，他们把湖当作大海"},{"id":"4001032071090","name":"小糸","text":"え？","trans":"诶？"},{"id":"4001032071100","name":"円香","text":"お互いのこと、航海士みたいに呼び合って……\\nどこかの海で、海賊と戦ってるつもりになってる","trans":"但他们，以水手的称呼呼唤彼此……\\n并打算在某片海上，与海盗作战"},{"id":"4001032071110","name":"小糸","text":"へぇ……","trans":"嘿……"},{"id":"4001032071120","name":"雛菜","text":"しゃ、け～！\\n水飲みたくないの～？","trans":"鲑，鱼～！\\n不想喝水了吗～？"},{"id":"0000000000000","name":"オウム","text":"アー……\\nンー……","trans":"啊——……\\n嗯——……"},{"id":"4001032071130","name":"小糸","text":"わ、わたしたち……","trans":"我，我们……"},{"id":"4001032071140","name":"円香","text":"……ん？","trans":"……嗯？"},{"id":"4001032071150","name":"小糸","text":"────う、ううん……","trans":"————没，没事……"},{"id":"0000000000000","name":"プロデューサー","text":"『みんなでどうなりたいか、ってことも\\n少しずつ考えながら、選んでみてくれると嬉しい』","trans":"“但是关于大家想怎么做\\n我希望你们能够一点点思考这个问题，再以此为基础选择工作”"},{"id":"4001032071160","name":"小糸","text":"────……","trans":""},{"id":"4001032071170","name":"円香","text":"同じだね\\nアイドルごっこして","trans":"这和扮偶像\\n一样呢"},{"id":"4001032071180","name":"小糸","text":"……！","trans":""},{"id":"4001032071190","name":"円香","text":"ほんとは、湖なのにね","trans":"其实，明明只是个湖"},{"id":"4001032071200","name":"雛菜","text":"そっか～\\n言えないのか～……","trans":"是吗～\\n说不了吗～……"},{"id":"4001032071210","name":"小糸","text":"……そ、そうだよね…………","trans":"……这，这样啊……胜利后"},{"id":"4001032071220","name":"円香","text":"…………でも","trans":"…………但是"},{"id":"4001032071230","name":"透","text":"──でもさ、行こうよ","trans":"——不过，还是走吧"},{"id":"4001032071240","name":"透","text":"海だって、これ","trans":"这里，也是大海啊"},{"id":"4001032071250","name":"円香","text":"海を知らないわけじゃない","trans":"也并不是不了解大海"},{"id":"0000000000000","name":"オウム","text":"シャケ……！","trans":"鲑鱼……！"},{"id":"4001032071260","name":"雛菜","text":"……！\\nやは～","trans":"……！\\n呀哈～"},{"id":"4001032071270","name":"小糸","text":"…………\\nう、うん…………！","trans":"…………\\n啊，嗯…………！"},{"id":"4001032071280","name":"小糸","text":"明日……\\nゆ、優勝するしね……！","trans":"明天……\\n我，我们也会优胜呢……！"},{"id":"4001032071290","name":"雛菜","text":"ね、聞いた～？","trans":"听到了吗～？"},{"id":"4001032071291","name":"円香＆小糸","text":"…………？","trans":""},{"id":"4001032071300","name":"雛菜","text":"今シャケって言ったの！","trans":"刚才喊鲑鱼了！"},{"id":"4001032071310","name":"小糸","text":"……え\\nと、鳥のこと……？","trans":"……诶\\n你，你在说鸟……？"},{"id":"4001032071320","name":"雛菜","text":"うん～！","trans":"嗯～！"},{"id":"4001032071330","name":"円香","text":"そんなすぐ覚えるの","trans":"它能马上记住吗"},{"id":"4001032071340","name":"雛菜","text":"うん、覚えたよ～？\\n──はい、もう一回～","trans":"嗯，已经记住了哦～？\\n——来，再来一次～"},{"id":"0000000000000","name":"オウム","text":"アー……\\nンー……","trans":"啊——……\\n嗯——……"},{"id":"4001032071350","name":"小糸","text":"……\\n透ちゃんだね……","trans":"……\\n是小透啊"},{"id":"4001032071360","name":"雛菜","text":"シャケだよ、シャケ～","trans":"是鲑鱼啊，鲑鱼～"},{"id":"4001032071370","name":"円香","text":"……","trans":""},{"id":"4001032071380","name":"小糸","text":"あ、あれ\\n円香ちゃん……？","trans":"奇，奇怪\\n圆香……？"},{"id":"4001032071390","name":"円香","text":"飲み物、もらってくる","trans":"我去拿饮料"},{"id":"0000000000000","name":"オウム","text":"シャケ……！\\nシャケ……！","trans":"鲑鱼……！\\n鲑鱼……！"},{"id":"4001032071400","name":"雛菜","text":"そうそう、すごい～！\\nじゃあ────","trans":"对对，厉害～！\\n那就————"},{"id":"4001032071410","name":"雛菜","text":"透先輩、おにぎりいる～？","trans":"透学姐，要吃饭团吗～？"},{"id":"0000000000000","name":"オウム","text":"アー……\\nンー……","trans":"啊——……\\n嗯——……"},{"id":"0000000000000","name":"オウム","text":"シャケ……！","trans":"鲑鱼……！"},{"id":"4001032071420","name":"雛菜","text":"あは～！","trans":"啊哈～！"},{"id":"4001032071430","name":"小糸","text":"と、透ちゃんだね……！","trans":"是，是小透啊……！"},{"id":"4001032071440","name":"透","text":"──────","trans":""},{"id":"4001032071450","name":"透","text":"────あ","trans":"————啊"},{"id":"4001032071460","name":"透","text":"忘れてた","trans":"忘了"},{"id":"4001032071470","name":"透","text":"補講……おわり……\\n戻ってる……とこ……","trans":"补课……结束了……\\n要……回去了……"},{"id":"4001032071480","name":"透","text":"作戦……かいぎ……\\nはじ……めて……て……〇……","trans":"作战……会议……\\n开……始……也……O……"},{"id":"4001032071490","name":"透","text":"オッケー","trans":"OK——"},{"id":"4001032071440","name":"透","text":"──────","trans":""}]}