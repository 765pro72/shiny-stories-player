{"translator":"告","rows":[{"id":"4001017040010","name":"甜花","text":"……外、騒がしいね……","trans":"……外面，好吵……"},{"id":"4001017040020","name":"甜花","text":"怖い人たち……\\nもう、行っちゃった……？","trans":"可怕的人……\\n都，走了吗……？"},{"id":"0000000000000","name":"仔馬","text":"ひひん……","trans":"嘶嘶……"},{"id":"4001017040030","name":"甜花","text":"もうちょっとだけ……我慢……","trans":"再……忍一下……"},{"id":"0000000000000","name":"仔馬","text":"ひひん……！","trans":""},{"id":"4001017040040","name":"甜花","text":"──にへへ……いい子……","trans":"──诶嘿嘿……好乖……"},{"id":"4001017040050","name":"甜花","text":"……\\nなーちゃん……千雪さん……","trans":"……\\n小奈……千雪……"},{"id":"4001017040060","name":"甜花","text":"きっと……\\nとっても、心配してる……","trans":"一定……\\n非常担心……"},{"id":"4001017040070","name":"甜花","text":"駅員さんに……言わなきゃ……","trans":"要去……告诉站员……"},{"id":"4001017040080","name":"甜花","text":"でも……","trans":"可是……"},{"id":"0000000000000","name":"仔馬","text":"……ひひん……","trans":""},{"id":"4001017040090","name":"甜花","text":"──怖い人たち……\\n早く……行ってくれればいい、のに……","trans":"——坏人……\\n早点离开……就，好了……"},{"id":"4001017040100","name":"甘奈","text":"警備員さんたち……\\nいないね……","trans":"警卫……\\n都不在……"},{"id":"4001017040110","name":"千雪","text":"うん……","trans":"嗯……"},{"id":"4001017040120","name":"甘奈","text":"こっちの車両じゃなかったのかな……","trans":"可能不在这辆车厢里吧……"},{"id":"4001017040130","name":"甘奈","text":"賞金稼ぎのこと、聞きたかったのに……","trans":"本来还想问问赏金猎人的事的……"},{"id":"4001017040140","name":"千雪","text":"そうね……","trans":"是啊……"},{"id":"4001017040150","name":"甘奈","text":"……甜花ちゃん……","trans":"……甜花……"},{"id":"4001017040160","name":"千雪","text":"…………","trans":""},{"id":"4001017040170","name":"千雪","text":"──あ……","trans":"——啊……"},{"id":"4001017040180","name":"甘奈","text":"！\\n警備員さん、いた！？","trans":"！\\n警卫在吗！？"},{"id":"4001017040190","name":"千雪","text":"あ……ううん\\nごめんね、違うの……","trans":"啊……不是\\n对不起，不是这样……"},{"id":"4001017040200","name":"千雪","text":"天の川──","trans":"银河——"},{"id":"4001017040210","name":"甘奈","text":"…………！","trans":""},{"id":"4001017040220","name":"千雪","text":"…………見えちゃった","trans":"…………看得到了"},{"id":"4001017040230","name":"甘奈","text":"……うん……","trans":"……嗯……"},{"id":"4001017040240","name":"甘奈","text":"──こんな時なのに……\\n綺麗……","trans":"——这种时候偏偏……\\n真漂亮……"},{"id":"4001017040250","name":"千雪","text":"……うん","trans":"……1嗯"},{"id":"4001017040260","name":"甘奈","text":"３人で……\\n見るはずだったのにな……","trans":"明明……\\n该是3个人一起看得……"},{"id":"4001017040270","name":"千雪","text":"甘奈ちゃん……","trans":"甘奈……"},{"id":"4001017040280","name":"千雪","text":"……まだ、時間はあるわ","trans":"……还有时间"},{"id":"4001017040290","name":"甘奈","text":"千雪さん、でも──","trans":"可是，千雪"},{"id":"4001017040300","name":"千雪","text":"そうね……\\nハロウィンが終わる前に、『天船』に戻らなきゃ","trans":"是啊……\\n要赶在万圣节结束前，回到“天船”上"},{"id":"4001017040310","name":"甘奈","text":"……だよね","trans":"……是啊"},{"id":"4001017040320","name":"甘奈","text":"…………\\n船が行っちゃったら、どうなるのかな","trans":"…………\\n船开走的话，会怎么样呢"},{"id":"4001017040330","name":"千雪","text":"……わからないわ","trans":"……不知道"},{"id":"4001017040340","name":"甘奈","text":"…………","trans":""},{"id":"4001017040350","name":"千雪","text":"…………","trans":""},{"id":"4001017040360","name":"千雪","text":"……甘奈ちゃん、キャラメル","trans":"……甘奈，牛奶糖"},{"id":"4001017040370","name":"甘奈","text":"千雪さん……","trans":""},{"id":"4001017040380","name":"千雪","text":"最後になっちゃった\\n──はい","trans":"最后一个了\\n——来"},{"id":"4001017040390","name":"甘奈","text":"……いいの？","trans":"……可以吗？"},{"id":"4001017040400","name":"千雪","text":"うん\\nちょっと食べすぎちゃったみたい","trans":"嗯\\n我好像吃多了"},{"id":"4001017040410","name":"甘奈","text":"…………","trans":""},{"id":"4001017040420","name":"千雪","text":"…………絶対、３人で見ようね","trans":"…………绝对，要3个人一起看银河"},{"id":"4001017040430","name":"千雪","text":"私たち、天の川に行くの\\nそして時間までに『天船』に乗る","trans":"我们，要到银河去\\n然后在规定时间前搭上“天船”"},{"id":"4001017040440","name":"甘奈","text":"……うん","trans":"……嗯"},{"id":"4001017040450","name":"甘奈","text":"──ごめんなさい\\nありがとう……","trans":"——对不起\\n谢谢你……"},{"id":"4001017040460","name":"甘奈","text":"食べて、力貯めておかなきゃ","trans":"吃了它，然后要保存体力"},{"id":"4001017040470","name":"甘奈","text":"思い出、いっぱい作るんだもんね","trans":"要一起创造好多好多回忆嘛"},{"id":"4001017040480","name":"甜花","text":"今……\\nどのへん、だろ……","trans":"现在……\\n在，哪里了……"},{"id":"0000000000000","name":"仔馬","text":"ひひん","trans":""},{"id":"4001017040490","name":"甜花","text":"……？\\nお外、見たいの……？","trans":"……？\\n想看外面……？"},{"id":"4001017040500","name":"甜花","text":"──あっ！\\nあんまり開けたら見つかっちゃう──","trans":"——啊！\\n开太大的话会被发现——"},{"id":"4001017040510","name":"甜花","text":"…………！","trans":""},{"id":"4001017040520","name":"甜花","text":"すごい……天の川……","trans":"好厉害……银河……"},{"id":"4001017040530","name":"甜花","text":"──ペガサス座……おっきい……！","trans":"——天马座……好大……！"},{"id":"0000000000000","name":"仔馬","text":"ひひん……","trans":""},{"id":"4001017040540","name":"甜花","text":"……？　お兄ちゃん……？","trans":"……？ 哥哥……？"},{"id":"0000000000000","name":"仔馬","text":"ひひん……ひひん……","trans":""},{"id":"4001017040550","name":"甜花","text":"──ええっ！\\nあれ……お兄ちゃん、なの……？","trans":"——诶！\\n那是……哥哥，吗……？"},{"id":"4001017040560","name":"甜花","text":"おうちって……あそこ……？","trans":"回家……是回那边……？"},{"id":"4001017040570","name":"甜花","text":"仔馬さんは……仔馬座なの……！？","trans":"小马……是小马座……！？"},{"id":"4001017040580","name":"甜花","text":"そうなんだね……","trans":"是这样啊……"},{"id":"4001017040590","name":"甜花","text":"じゃあ、お兄ちゃんのとこ……\\n帰らなきゃ……","trans":"那，得回去……\\n哥哥那边……"},{"id":"0000000000000","name":"仔馬","text":"ひひん……","trans":""},{"id":"4001017040600","name":"甜花","text":"…………","trans":""},{"id":"4001017040610","name":"甜花","text":"甜花は……\\n妹、いる……","trans":"甜花……\\n有个妹妹……"},{"id":"4001017040620","name":"甜花","text":"それから……\\n千雪さん……","trans":"还有……\\n千雪……"},{"id":"4001017040630","name":"甜花","text":"…………\\n甜花も、帰らなきゃ……","trans":"…………\\n甜花，也要回去……"},{"id":"0000000000000","name":"仔馬","text":"ひひん……","trans":""},{"id":"4001017040640","name":"甜花","text":"うん……\\n帰ろうね……","trans":"嗯……\\n要一起回去……"},{"id":"4001017040650","name":"甜花","text":"絶対……！","trans":"绝对……！"}]}