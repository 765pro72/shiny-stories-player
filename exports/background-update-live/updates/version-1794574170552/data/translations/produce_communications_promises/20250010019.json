{"translator":"","rows":[{"id":"202500100190010","name":"美琴","text":"ごめんね\\n外せない別件が入ってしまったの","trans":"不好意思\\n突然有件不得不去做的事"},{"id":"202500100190020","name":"美琴","text":"今週、休みを入れてもいいかな？","trans":"这周能让我休息吗？"},{"id":"select","name":"","text":"いいよ","trans":"没问题"},{"id":"select","name":"","text":"ごめん","trans":"抱歉"},{"id":"202500100990010","name":"美琴","text":"そう、ありがとう","trans":"嗯，谢谢你"},{"id":"202500100990020","name":"美琴","text":"そっか、わかった","trans":"是吗，我知道了"}]}