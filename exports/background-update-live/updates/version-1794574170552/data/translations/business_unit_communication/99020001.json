{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"990200010010","name":"恋鐘","text":"にく～にく～\r\nお・に・く～♪","trans":"肉～肉～\n肉·肉·肉～♪","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010020","name":"咲耶","text":"にく、にく──♪","trans":"肉，肉——♪","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010021","name":"結華＆霧子","text":"お・に・くー……♪","trans":"肉·肉·肉——……♪","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010030","name":"摩美々","text":"にくー","trans":"肉——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010040","name":"恋鐘","text":"にく！","trans":"肉！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010050","name":"咲耶","text":"にく","trans":"肉","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010060","name":"霧子","text":"にく……","trans":"肉……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010070","name":"結華","text":"お・に・く！！","trans":"肉·肉·肉！！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010080","name":"摩美々","text":"はぁい、ストップー\r\nこれだけ言っとけば大丈夫でしょー","trans":"好～，停\n说这么多就够了吧——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010090","name":"結華","text":"うん、十分と見た！\r\n営業のご褒美くれるって言ったのはプロデューサーだし","trans":"嗯，我判断足够了！\n而且说要给我们营业奖励的是制作人嘛","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010100","name":"咲耶","text":"フフ、そうさ\r\n私たちはむしろ、食べねばならぬ、とすら言える","trans":"呵呵，正是\n甚至可以说，我们是非吃不可","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010110","name":"恋鐘","text":"んふふ～\r\nば～り奮発してもらわんばね～！","trans":"嗯呵呵～\n可要让我们吃得超豪华哦～！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010120","name":"霧子","text":"ふふ……\r\nにく……にく……♪","trans":"呵呵……\n肉……肉……♪","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"990200010130","name":"摩美々","text":"というわけでー\r\n期待してまぁす","trans":"所以说嘛——\n我很期待哦","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}