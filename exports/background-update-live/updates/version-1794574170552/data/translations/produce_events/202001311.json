{"translator":"魚見","rows":[{"id":"2020013110010","name":"透","text":"──────……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"あんまり食べ過ぎるなよー","trans":"别一下子吃太多喔——"},{"id":"2020013110020","name":"透","text":"んー……","trans":"嗯——……"},{"id":"2020013110030","name":"透","text":"ねー","trans":"话说——"},{"id":"2020013110040","name":"透","text":"もう売ってなかった、このグミ","trans":"已经没得卖了，这款软糖"},{"id":"0000000000000","name":"プロデューサー","text":"え……そうなのか？\\nそれは残念だな……","trans":"诶……这样吗？\\n那还挺可惜的……"},{"id":"0000000000000","name":"プロデューサー","text":"でも、間に合ってよかったよ\\n透にあげるの","trans":"不过，辛亏买给你买得早"},{"id":"2020013110050","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"2020013110060","name":"透","text":"そうだ、見た\\n映画、最後まで","trans":"对，我看了\\n电影，看到结局"},{"id":"0000000000000","name":"プロデューサー","text":"え、映画……？\\n──ああ……！　あのお化けの映画か？","trans":"诶、电影……？\\n——啊啊……！　是那部妖怪的电影吗？"},{"id":"2020013110070","name":"透","text":"そう","trans":"对"},{"id":"0000000000000","name":"プロデューサー","text":"シーツ姿のお化け、最後どうなるんだ？","trans":"穿西装的妖怪，最后怎样了"},{"id":"2020013110080","name":"透","text":"あー……","trans":"啊——……"},{"id":"2020013110090","name":"透","text":"お化けは","trans":"妖怪"},{"id":"2020013110100","name":"透","text":"消える","trans":"消失了"},{"id":"0000000000000","name":"透","text":"──────","trans":""},{"id":"2020013110120","name":"透","text":"笑うみたいに","trans":"像是在笑"},{"id":"2020013110130","name":"透","text":"ホッとしたみたいに","trans":"像是释怀了"},{"id":"2020013110140","name":"透","text":"やっぱ……","trans":"糟喔……"},{"id":"2020013110150","name":"透","text":"一緒に見よ","trans":"一起看吧"},{"id":"0000000000000","name":"プロデューサー","text":"え…………\\n透、もう見たんだろ？","trans":"诶…………\\n但你不是看过了吗？"},{"id":"2020013110160","name":"透","text":"見たけど────","trans":"看是看过了————"},{"id":"2020013110170","name":"透","text":"見たい、一緒に","trans":"想看，想一起看"},{"id":"0000000000000","name":"プロデューサー","text":"……はは、わかったよ\\nじゃあ、今度一緒にな","trans":"……哈哈、好吧\\n那下次一起看"},{"id":"2020013110180","name":"透","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"────で、こっちはオーディションなんだけど\\n重要な役だから、決まればかなり大きい仕事になる","trans":"————然后，这边是联系过来的试镜\\n算是挺重要的角色，定下来的话就是一场大活"},{"id":"2020013110190","name":"透","text":"オッケー","trans":"OK——"},{"id":"2020013110200","name":"透","text":"あちっ","trans":"好烫"},{"id":"0000000000000","name":"プロデューサー","text":"！\\n大丈夫か？","trans":"！\\n没事吧？"},{"id":"0000000000000","name":"プロデューサー","text":"ほら、水","trans":"给，喝点水"},{"id":"2020013110210","name":"透","text":"んー……","trans":"嗯——……"},{"id":"2020013110220","name":"透","text":"あ────","trans":"啊————"},{"id":"2020013110230","name":"透","text":"光が\\n反射して","trans":"光\\n在反射"},{"id":"2020013110240","name":"透","text":"照らしてる","trans":"照到了"},{"id":"0000000000000","name":"プロデューサー","text":"え……？","trans":"诶……？"},{"id":"2020013110250","name":"透","text":"そこ\\n心臓のとこ、プロデューサーの","trans":"那儿\\n心脏的位置，制作人的"},{"id":"2020013110260","name":"透","text":"当たってる、光","trans":"光，照到了"},{"id":"0000000000000","name":"プロデューサー","text":"光……？","trans":"光……？"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……！\\n本当だ！","trans":"啊啊……！\\n真的啊！"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ、光ってるな","trans":"哈哈、在发光呢"},{"id":"2020013110270","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"2020013110280","name":"透","text":"夕焼けみたいな","trans":"像晚霞一样"},{"id":"2020013110290","name":"透","text":"光","trans":"那道光"},{"id":"2020013110300","name":"透","text":"よかった\\n見つけられて","trans":"能被找到\\n真是太好了"},{"id":"2020013110310","name":"off","text":"見失って、見つけて\\n見つけてもらって","trans":"找丢后、又找了回来\\n最后被找到"},{"id":"2020013110320","name":"off","text":"そうやって、何度でも","trans":"就像这样，无论经过几次"},{"id":"2020013110330","name":"off","text":"のぼってく\\n一緒に","trans":"都会一起\\n向上攀爬"}]}