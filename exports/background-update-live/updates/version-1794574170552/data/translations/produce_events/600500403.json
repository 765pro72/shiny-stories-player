{"translator":"Rosineae","rows":[{"id":"6005004030010","name":"摩美々","text":"いいですね、なんか──","trans":"感觉挺棒的──"},{"id":"6005004030020","name":"摩美々","text":"なんか、終わりが近づいてるのが、\\n嫌になっちゃうくらい……","trans":"总觉得，都有些不想结束了……"},{"id":"0000000000000","name":"プロデューサー","text":"……うん\\nそうか","trans":"……嗯\\n是吗"},{"id":"6005004030030","name":"摩美々","text":"──……\\nぁ……","trans":"──……\\n啊……"},{"id":"6005004030040","name":"摩美々","text":"……じゃ\\nいってきますねー","trans":"……那么\\n我上台了哦"},{"id":"0000000000000","name":"プロデューサー","text":"──摩美々！","trans":"──摩美美！"},{"id":"6005004030050","name":"摩美々","text":"……？","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"最後まで、楽しんできてくれ","trans":"好好享受到最后一刻吧"},{"id":"6005004030060","name":"摩美々","text":"……ふふー","trans":"……哼哼"},{"id":"6005004030070","name":"摩美々","text":"だから、言われなくてもー","trans":"不用说我也会的"}]}