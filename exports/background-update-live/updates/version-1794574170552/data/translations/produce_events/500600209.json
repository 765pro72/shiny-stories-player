{"translator":"告","rows":[{"id":"5006002090010","name":"雛菜","text":"──透先輩、爪出して～\\n塗ります～","trans":"——透学姐，手指伸出来～\\n该涂了～"},{"id":"5006002090020","name":"透","text":"はい\\n……元気ないじゃん","trans":"好\\n……很没精神啊"},{"id":"5006002090030","name":"雛菜","text":"ん～\\n『感謝祭』終わっちゃったな～って","trans":"嗯～\\n就在想“感谢祭”结束了啊～这样"},{"id":"5006002090040","name":"雛菜","text":"楽しかったのにな～","trans":"明明很开心的～"},{"id":"5006002090050","name":"小糸","text":"た、楽しかったよね……！","trans":"很，很开心呢……！"},{"id":"5006002090060","name":"雛菜","text":"うん～！\\nみんなもすっごい楽しそうだったしね～？","trans":"嗯～！\\n大家都很开心呢～？"},{"id":"5006002090070","name":"小糸","text":"……うん！","trans":"……嗯！"},{"id":"5006002090080","name":"小糸","text":"と、透ちゃんと円香ちゃんは\\nどうだった？","trans":"小，小透和圆香\\n什么感想？"},{"id":"5006002090090","name":"透","text":"んー","trans":"嗯——"},{"id":"5006002090100","name":"透","text":"樋口は？","trans":"樋口呢？"},{"id":"5006002090110","name":"円香","text":"よかったんじゃない","trans":"不也挺好吗"},{"id":"5006002090120","name":"円香","text":"客席も喜んでたっぽいし","trans":"客人好像也很开心"},{"id":"5006002090130","name":"小糸","text":"え、えへへ……\\nそ、そうだよね……よかった……","trans":"诶，诶嘿嘿……\\n是，是啊……太好了……"},{"id":"5006002090140","name":"円香","text":"浅倉は\\nどうだったの？","trans":"浅仓\\n又怎么想？"},{"id":"5006002090150","name":"透","text":"あー……","trans":"啊——……"},{"id":"5006002090160","name":"雛菜","text":"あ～\\n動いちゃだめだって～","trans":"啊～\\n不可以乱动～"},{"id":"5006002090170","name":"透","text":"あ、ごめん","trans":"啊，对不起"},{"id":"5006002090180","name":"透","text":"……なんだろ","trans":"……怎么说呢"},{"id":"5006002090190","name":"透","text":"めっちゃいたね、人","trans":"有好多人在"},{"id":"5006002090200","name":"小糸","text":"え……？\\nファンの人が、ってこと……？","trans":"诶……？\\n在说粉丝吗……？"},{"id":"5006002090210","name":"透","text":"うん","trans":"嗯"},{"id":"5006002090220","name":"雛菜","text":"透先輩のファンは\\nいっぱいいるよ～","trans":"透学姐\\n有很多粉丝哦～"},{"id":"5006002090230","name":"透","text":"えー \\nやばい","trans":"诶——\\n不妙"},{"id":"5006002090240","name":"透","text":"何、見えてたかな","trans":"他们看到了什么呢"},{"id":"5006002090250","name":"雛菜","text":"ん～？","trans":"嗯～？"},{"id":"5006002090260","name":"小糸","text":"み、みんな\\nステージ見てくれてたよ……？","trans":"大，大家\\n都有看舞台哦……？"},{"id":"5006002090270","name":"透","text":"あー……","trans":"啊——……"},{"id":"5006002090280","name":"透","text":"ふふっ\\nなんか、こっちが見てたって感じだったから","trans":"呵呵\\n感觉大家都在看这边"},{"id":"5006002090290","name":"円香","text":"……","trans":""},{"id":"5006002090300","name":"円香","text":"見てるぶん、見られてたんじゃない","trans":"我们看粉丝，粉丝不也在看我们吗"},{"id":"5006002090310","name":"透","text":"え？","trans":"诶？"},{"id":"5006002090320","name":"透","text":"そっか\\nいいね","trans":"是吗\\n真好"},{"id":"5006002090330","name":"透","text":"見えてたのか\\nあれ","trans":"大家\\n都看得到那个吗"}]}