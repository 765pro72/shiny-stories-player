{"translator":"魚見","rows":[{"id":"3021020010010","name":"円香","text":"夢","trans":"梦"},{"id":"3021020010020","name":"円香","text":"俯瞰しながら","trans":"俯瞰这梦境的同时"},{"id":"3021020010030","name":"円香","text":"そこにいる","trans":"我却身在此处"},{"id":"3021020010040","name":"円香","text":"大海原の船の上","trans":"在汪洋大海中的一艘船上"},{"id":"3021020010050","name":"円香","text":"…………","trans":""},{"id":"3021020010060","name":"円香","text":"からっぽの帆船","trans":"空荡荡的帆船"},{"id":"3021020010070","name":"円香","text":"と","trans":"和"},{"id":"3021020010080","name":"透","text":"おー、竜","trans":"噢——、龙"},{"id":"3021020010090","name":"雛菜","text":"どこ～？","trans":"在哪～？"},{"id":"3021020010100","name":"小糸","text":"……あ、いた！\\n雛菜ちゃん、右の空だよ……！","trans":"……啊、在那！\\n雏菜，在右边的天上……！"},{"id":"3021020010110","name":"雛菜","text":"……あ、ほんとだ～\\n飛んでるね～","trans":"……啊、真的耶～\\n在飞呢～"},{"id":"3021020010120","name":"円香","text":"…………","trans":""},{"id":"3021020010130","name":"透","text":"おーい","trans":"喂——"},{"id":"3021020010140","name":"透","text":"戻ってこーい","trans":"给我回来——"},{"id":"3021020010150","name":"小糸","text":"……行っちゃったね","trans":"……飞走了呢"},{"id":"3021020010160","name":"雛菜","text":"また戻ってくるといいね～","trans":"要是会再飞回来就好了"},{"id":"3021020010170","name":"円香","text":"……","trans":""},{"id":"3021020010180","name":"円香","text":"ねえ","trans":"嗳"},{"id":"3021020010190","name":"円香","text":"この船、海に浮かんだまま\\n進んでない","trans":"这艘船，一直漂在海上\\n完全没有前进"},{"id":"3021020010200","name":"透","text":"え？","trans":"诶？"},{"id":"3021020010210","name":"透","text":"だって\\n凪いでるし、今","trans":"毕竟\\n风平浪静啊，现在"},{"id":"3021020010220","name":"円香","text":"……うちらどこ向かってるんだっけ","trans":"……我们原本是要去哪来着"},{"id":"3021020010230","name":"雛菜","text":"雛菜もわかんない～","trans":"雏菜也不知道～"},{"id":"3021020010240","name":"円香","text":"は？","trans":"哈？"},{"id":"3021020010250","name":"雛菜","text":"へ～だって～\\nなんとなく波に乗ってるし～","trans":"诶～那毕竟～\\n也只是在随波逐流啊～"},{"id":"3021020010260","name":"円香","text":"……じゃあ、質問を変えるけど","trans":"……那我换一个问题"},{"id":"3021020010270","name":"円香","text":"何してるの？","trans":"这是在做什么？"},{"id":"3021020010280","name":"透","text":"んー\\n待ってる？","trans":"嗯——\\n在等待？"},{"id":"3021020010290","name":"透","text":"釣れるの","trans":"能钓上什么来"},{"id":"3021020010300","name":"円香","text":"船の上、何もないし\\n何も釣れた様子がないんだけど","trans":"这船上，什么都没有\\n看起来什么都没有钓到"},{"id":"3021020010310","name":"小糸","text":"え、えっと……\\nからっぽだからだよ……！","trans":"呃、那个……\\n因为船上空荡荡的嘛……！"},{"id":"3021020010320","name":"円香","text":"……うちら遭難してる？","trans":"……我们这是遇难了？"},{"id":"3021020010330","name":"円香","text":"それで、食料調達してるの？","trans":"那，这是在准备食材？"},{"id":"3021020010340","name":"透","text":"んー","trans":"嗯——"},{"id":"3021020010350","name":"円香","text":"それともただ退屈なだけ？","trans":"还是说只是闲来无聊？"},{"id":"3021020010360","name":"透","text":"んー","trans":"嗯——"},{"id":"3021020010370","name":"円香","text":"……","trans":""},{"id":"3021020010380","name":"円香","text":"わからない","trans":"不明白"},{"id":"3021020010390","name":"円香","text":"私はなんで乗ってるの？","trans":"我为什么会乘上这艘船？"},{"id":"3021020010400","name":"円香","text":"……いや","trans":"……算了"},{"id":"3021020010410","name":"円香","text":"どうせ考えたって無駄","trans":"再怎么想也是白费功夫"},{"id":"3021020010420","name":"透","text":"樋口","trans":"樋口"},{"id":"3021020010430","name":"透","text":"降りるの？","trans":"你要下船吗？"},{"id":"3021020010440","name":"円香","text":"さあ","trans":"天知道"},{"id":"3021020010450","name":"円香","text":"そもそも\\nなんで乗ってるのか","trans":"说到底\\n为什么要乘上这艘船"},{"id":"3021020010460","name":"透","text":"え────","trans":"诶————"},{"id":"3021020010470","name":"off","text":"きたから？\\nバーンって","trans":"因为船来了？\\n啪——地一声"},{"id":"3021020010480","name":"off","text":"楽しそうだから？","trans":"因为感觉会很好玩？"},{"id":"3021020010490","name":"off","text":"み、みんながいるから……？","trans":"因、因为大家都在……？"},{"id":"3021020010500","name":"円香","text":"それはきっかけでしょ","trans":"那只是契机吧"},{"id":"3021020010510","name":"円香","text":"みんなはどうして乗り続けるの","trans":"大家为什么还要继续"},{"id":"3021020010520","name":"円香","text":"この船に","trans":"待在这艘船上呢"}]}