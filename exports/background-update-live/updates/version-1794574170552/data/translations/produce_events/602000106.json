{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"おーい！　透！","trans":"喂！　透！"},{"id":"6020001060010","name":"透","text":"イエーイ","trans":"耶"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ、イエーイ！","trans":"哈哈，耶！"},{"id":"0000000000000","name":"プロデューサー","text":"──やったな","trans":"──做到了啊"},{"id":"6020001060020","name":"透","text":"なんか、\\nあんまり現実感ないかも","trans":"总感觉，\\n有点不太现实"},{"id":"6020001060030","name":"透","text":"でも……──","trans":"不过……──"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"6020001060040","name":"透","text":"プロデューサーの顔見てたら、\\nなんかいいことしたかもって感じ、してきた","trans":"看到制作人的脸的话，\\n就好像会有什么好事发生"},{"id":"0000000000000","name":"プロデューサー","text":"いいことだよ\\n多くの人にとってもそうだし、何より──","trans":"就是好事哦\\n对很多人来说都是，特别──"},{"id":"0000000000000","name":"プロデューサー","text":"透にとって、そうだ","trans":"对透来说，也是"},{"id":"6020001060050","name":"透","text":"……──","trans":"……──"},{"id":"6020001060060","name":"透","text":"うん\\nそうだね","trans":"嗯\\n对啊"},{"id":"6020001060070","name":"透","text":"うちに帰って……\\n寝る頃にはさ","trans":"回家后……\\n睡着的时候"},{"id":"6020001060080","name":"透","text":"わかってると思う","trans":"就能明白"},{"id":"6020001060090","name":"透","text":"私にとって、\\nきっとすごく大事な日だったって──","trans":"对我来说，\\n今天一定是特别重要的日子──"}]}