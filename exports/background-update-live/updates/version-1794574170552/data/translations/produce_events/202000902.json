{"translator":"魚見","rows":[{"id":"2020009020010","name":"透","text":"入って","trans":"进来"},{"id":"2020009020020","name":"透","text":"置いて、スマホ","trans":"放一边，手机"},{"id":"0000000000000","name":"プロデューサー","text":"────はい、ええ……","trans":"————好的，是……"},{"id":"0000000000000","name":"プロデューサー","text":"……ええ、ですね。はい\\nええ……","trans":"……是，的呢，好的\\n对……"},{"id":"0000000000000","name":"プロデューサー","text":"……恐れ入ります、少々お待ちください\\n────すまん……！　ここ、掛けててくれるか","trans":"……非常抱歉，请您稍微等一下\\n————抱歉……！"},{"id":"2020009020030","name":"透","text":"え？　うん","trans":"诶？　嗯"},{"id":"0000000000000","name":"プロデューサー","text":"悪いな、もうちょっとだ……！\\n────もしもし、失礼しました。……はい","trans":"对不住啊，再等一下下……！\\n————喂喂，刚才失礼了。"},{"id":"2020009020040","name":"透","text":"……ふふっ\\n働き者ー","trans":"……呵呵\\n大忙人—"},{"id":"0000000000000","name":"プロデューサー","text":"……いえ……ええ\\nご認識にズレがあったら恐縮なのですが────","trans":"……不……是的\\n如果让您有所误解的话实在过意不去————"},{"id":"2020009020050","name":"透","text":"……\\nふぁ……","trans":"……\\n呼啊……"},{"id":"0000000000000","name":"透","text":"ライト","trans":"灯"},{"id":"0000000000000","name":"プロデューサー","text":"おーい、お待たせ\\nごめんな……！","trans":"喂——，让你久等了\\n抱歉啊……！"},{"id":"2020009020070","name":"透","text":"終わった？","trans":"结束了？"},{"id":"0000000000000","name":"プロデューサー","text":"おう、ちょっと先方に誤解があったみたいで……","trans":"噢，刚才对方好像有些误解……"},{"id":"0000000000000","name":"プロデューサー","text":"……いや、透に言うことじゃないよな\\nすまん、帰ろう","trans":"……不对，不是该跟透说的事啊\\n抱歉，我们回去吧"},{"id":"2020009020080","name":"透","text":"うん\\nじゃ────","trans":"嗯\\n那————"},{"id":"2020009020081","name":"透＆プロデューサー","text":"────","trans":"————"},{"id":"0000000000000","name":"透","text":"エアコン","trans":"空调"},{"id":"0000000000000","name":"プロデューサー","text":"わ、悪い……","trans":"对、对不住……"},{"id":"0000000000000","name":"プロデューサー","text":"すまん、メッセだ。これだけ……！\\n一瞬返させてくれ","trans":"抱歉，消息。就一下……！\\n马上就回复完"},{"id":"2020009020100","name":"透","text":"んー\\nさっきの人？","trans":"嗯—\\n刚才的人？"},{"id":"0000000000000","name":"プロデューサー","text":"いや、さっきの件はもう大丈夫なんだけど…………","trans":"不是，刚才那件事已经没问题了…………"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"2020009020110","name":"透","text":"……働きものー","trans":"……大忙人—"},{"id":"0000000000000","name":"プロデューサー","text":"────あれ？","trans":"————啊嘞？"},{"id":"0000000000000","name":"プロデューサー","text":"……あ、悪い。１階押しちゃったか\\nショールームだな、ここ","trans":"……啊，抱歉。按到一楼了吗\\n是商品展示区啊"},{"id":"2020009020120","name":"透","text":"あー\\n２階か、出口","trans":"啊—\\n二楼吗，出口"},{"id":"0000000000000","name":"プロデューサー","text":"すまん……\\nええと、２階────","trans":"抱歉……\\n我看看，二楼————"},{"id":"2020009020130","name":"透","text":"行こ","trans":"走吧"},{"id":"0000000000000","name":"プロデューサー","text":"────えっ","trans":"————诶"},{"id":"2020009020140","name":"透","text":"行こ、あそこじゃん\\nここ","trans":"走吧，不就是那个吗\\n这里"},{"id":"0000000000000","name":"プロデューサー","text":"……ああ！\\nいいけど────","trans":"……啊啊！\\n也行————"},{"id":"0000000000000","name":"入り口の看板","text":"『あなたに一途なお部屋、あります』","trans":"“对您一心一意的房间，就在这里”"},{"id":"2020009020150","name":"透","text":"ブラインドー","trans":"窗帘—"},{"id":"2020009020160","name":"透","text":"おー\\n自動","trans":"噢—\\n自动"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"2020009020170","name":"透","text":"……\\nオーブン、スイッチオン！","trans":"……\\n开启，开关打开"},{"id":"2020009020180","name":"透","text":"ふふっ、ついた\\nねー────","trans":"呵呵，打开了\\n呐————"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"……えっ\\nあ────","trans":"……诶\\n啊————"},{"id":"0000000000000","name":"プロデューサー","text":"すまんすまん、うん\\nブラインドすごいなぁ……！","trans":"抱歉抱歉，嗯\\n窗帘真厉害啊……！"},{"id":"0000000000000","name":"プロデューサー","text":"……あれっ","trans":"……啊嘞"},{"id":"0000000000000","name":"プロデューサー","text":"あっ、透────","trans":"啊，透————"},{"id":"2020009020190","name":"透","text":"オーブン、オフ","trans":"开启，关闭"},{"id":"2020009020200","name":"透","text":"エアコン、オフ\\nブラインド、下がれ","trans":"空调，关闭\\n窗帘，放下"},{"id":"2020009020210","name":"透","text":"ライト、オフ","trans":"灯，关"},{"id":"0000000000000","name":"プロデューサー","text":"透、すまん……！\\nなぁ透────","trans":"透，抱歉……！\\n呐透————"},{"id":"2020009020220","name":"透","text":"入って","trans":"进来"},{"id":"0000000000000","name":"プロデューサー","text":"────え","trans":"————诶"},{"id":"2020009020230","name":"透","text":"終わった？　メッセ","trans":"结束了？　消息"},{"id":"0000000000000","name":"プロデューサー","text":"ええと……うん。もうこれで完了\\nごめんな","trans":"那个……嗯。这个就结束了\\n抱歉啊"},{"id":"2020009020240","name":"透","text":"ううん\\n……じゃ","trans":"没事\\n……那"},{"id":"2020009020250","name":"透","text":"入って\\n置いて。スマホ","trans":"进来\\n放一边。手机"},{"id":"0000000000000","name":"プロデューサー","text":"……透","trans":"……透"},{"id":"2020009020260","name":"透","text":"オフにして\\nで────","trans":"关掉\\n然后————"},{"id":"2020009020270","name":"透","text":"一途、オン","trans":"一心一意模式，开启"}]}