{"translator":"魚見","rows":[{"id":"3020011020010","name":"真乃","text":"『事務所に着きました。』","trans":"“到事务所了。”"},{"id":"3020011020020","name":"真乃","text":"『忘れ物を取ってからすぐに出ます。』","trans":"“拿了落下的东西马上就出去”"},{"id":"3020011020030","name":"真乃","text":"……","trans":""},{"id":"3020011020040","name":"真乃","text":"……お疲れさ──────","trans":"……辛苦了——————"},{"id":"3020011020050","name":"透","text":"────────\\n────────────","trans":"────────\\n────────────"},{"id":"3020011020060","name":"透","text":"────────…………","trans":""},{"id":"3020011020070","name":"真乃","text":"──────","trans":""},{"id":"3020011020080","name":"真乃","text":"……\\n少しだけ……お邪魔します…………っ","trans":"……\\n稍微……打扰一下…………"},{"id":"3020011020090","name":"真乃","text":"────────っ","trans":"————————"},{"id":"3020011020100","name":"透","text":"────────","trans":""},{"id":"3020011020110","name":"真乃","text":"…………","trans":""},{"id":"3020011020120","name":"透","text":"……ん──────────","trans":"……嗯——————————"},{"id":"3020011020130","name":"真乃","text":"──────っ","trans":"——————"},{"id":"3020011020140","name":"真乃","text":"…………ほわ","trans":"…………呼哇"},{"id":"3020011020160","name":"真乃","text":"……\\nお腹……","trans":"……\\n肚子……"},{"id":"3020011020170","name":"透","text":"────","trans":""},{"id":"3020011020180","name":"真乃","text":"……\\nお腹、めくれたみたい……","trans":"……\\n肚子，有点露出来了……"},{"id":"3020011020190","name":"真乃","text":"ちょっとだけ、直すね…………っ","trans":"稍微，盖回去一下…………"},{"id":"3020011020210","name":"真乃","text":"……おやすみなさい","trans":"……晚安"},{"id":"3020011020220","name":"off","text":"ぺぺっ、ベンベンベン…………","trans":"pepe、penpenpen…………"},{"id":"3020011020230","name":"真乃","text":"戻りました──────","trans":"我回来了——————"},{"id":"3020011020240","name":"真乃","text":"────ほわ……っ","trans":"————呼哇……"},{"id":"0000000000000","name":"透","text":"────────…………","trans":""},{"id":"3020011020260","name":"真乃","text":"……\\nごめんなさい……すぐ、出るね…………っ","trans":"……\\n对不起……我马上、就出去…………"},{"id":"3020011020270","name":"透","text":"……──────────","trans":""},{"id":"3020011020280","name":"真乃","text":"……","trans":""},{"id":"3020011020290","name":"真乃","text":"スマホ……","trans":"手机……"},{"id":"0000000000000","name":"透","text":"──────────","trans":""},{"id":"3020011020310","name":"真乃","text":"……\\nスマホ……落ちそうなの…………","trans":"……\\n手机……好像快掉下来了…………"},{"id":"3020011020320","name":"真乃","text":"ちょっとだけ、触るね…………っ","trans":"稍微，碰一下…………"},{"id":"3020011020330","name":"透","text":"……ん──────","trans":"……嗯——————"},{"id":"3020011020340","name":"真乃","text":"──────っ","trans":"——————"},{"id":"3020011020350","name":"透","text":"────────…………\\n──────","trans":"────────…………\\n──────"},{"id":"3020011020360","name":"真乃","text":"……","trans":""},{"id":"3020011020370","name":"真乃","text":"……またまた、おやすみなさい……","trans":"……再一次，晚安……"},{"id":"3020011020380","name":"off","text":"トゥルッ、ドゥンドゥンドゥン──────","trans":"duru、dundundun——————"},{"id":"3020011020390","name":"真乃","text":"……","trans":""},{"id":"3020011020400","name":"透","text":"────────ん…………","trans":"————————嗯…………"},{"id":"3020011020410","name":"透","text":"……ん……\\n…………あー────","trans":"……嗯……\\n…………嗯————"},{"id":"3020011020420","name":"透","text":"────────夕方……？","trans":"————————傍晚……？"},{"id":"3020011020430","name":"透","text":"──────……","trans":""},{"id":"3020011020440","name":"off","text":"……べべっ、ドゥンドゥンドゥン……","trans":"……bebe、dundundun……"},{"id":"3020011020450","name":"真乃","text":"──────わ……","trans":"——————哇……"},{"id":"3020011020460","name":"真乃","text":"もう、お月様…………","trans":"月亮、已经出来了…………"},{"id":"3020011020470","name":"off","text":"……ドゥドゥっ、ドゥンドゥンドゥン……","trans":"……dudu、dundundun……"},{"id":"3020011020480","name":"真乃","text":"……","trans":""},{"id":"3020011020490","name":"透","text":"ふぁ…………よく寝た──────","trans":"呼啊…………睡了好久——————"},{"id":"3020011020500","name":"透","text":"──────なんだっけ、この曲","trans":"——————叫什么来着，这首歌"},{"id":"3020011020510","name":"真乃","text":"────もう少しだけ……\\n事務所のお部屋、あったかいままになりますように","trans":"————希望事务所的房间……\\n能再保持一会温暖"},{"id":"3020011020520","name":"透","text":"……いっか","trans":"……算了"},{"id":"3020011020530","name":"透","text":"いい曲だってだけで","trans":"就只当是首好歌"}]}