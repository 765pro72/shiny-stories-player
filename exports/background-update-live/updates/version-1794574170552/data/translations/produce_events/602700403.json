{"translator":"煉金術式","rows":[{"id":"6027004030010","name":"羽那","text":"ねぇ、プロデューサー","trans":"我说，制作人"},{"id":"6027004030020","name":"羽那","text":"すっごく楽しい──！","trans":"我很开心——！"},{"id":"0000000000000","name":"プロデューサー","text":"……！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"うん\\nステージを見ていて、わかるよ","trans":"嗯\\n看了羽那的表演，我就懂了"},{"id":"0000000000000","name":"プロデューサー","text":"羽那が楽しんでるってこと","trans":"羽那真的很乐在其中呢"},{"id":"6027004030030","name":"羽那","text":"……ふふっ","trans":"……呵呵"},{"id":"6027004030040","name":"羽那","text":"安心した？","trans":"放心啦？"},{"id":"0000000000000","name":"プロデューサー","text":"……ああ","trans":"……嗯"},{"id":"6027004030050","name":"羽那","text":"やったーっ","trans":"太好啦"},{"id":"0000000000000","name":"プロデューサー","text":"ライブ、あと少しだけど──\\n最後まで楽しんできてくれ","trans":"演出也进入尾声了——\\n去享受到最后一刻吧"},{"id":"6027004030060","name":"羽那","text":"うんっ","trans":"嗯"}]}