{"translator":"可可","rows":[{"id":"6024002030010","name":"にちか","text":"集中してます","trans":"我在集中精神"},{"id":"0000000000000","name":"プロデューサー","text":"……うん、わかってる","trans":"……嗯，我知道"},{"id":"6024002030020","name":"にちか","text":"……","trans":"……"},{"id":"6024002030030","name":"にちか","text":"──────めちゃめちゃ、めちゃめちゃ緊張してます","trans":"——————而且我现在还非常非常，非常非常地紧张"},{"id":"0000000000000","name":"プロデューサー","text":"……うん","trans":"……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"わかってるよ","trans":"我知道哦"},{"id":"6024002030040","name":"にちか","text":"…………──────────","trans":"…………——————————"},{"id":"6024002030050","name":"にちか","text":"自分のステージの方が……ずっと楽","trans":"如果是自己的舞台的话……就轻松多了"},{"id":"0000000000000","name":"プロデューサー","text":"…………\\nにちか──────","trans":"…………\\n日花——————"},{"id":"0000000000000","name":"プロデューサー","text":"──────にちかのステージでもあるんだけどな","trans":"——————虽说这也是日花的舞台"},{"id":"0000000000000","name":"プロデューサー","text":"……でも、いいんだ今回は","trans":"……不过，这次就这样也好"},{"id":"0000000000000","name":"プロデューサー","text":"にちかが、大事にしたいもので──────","trans":"因为是日花想要重视的舞台——————"}]}