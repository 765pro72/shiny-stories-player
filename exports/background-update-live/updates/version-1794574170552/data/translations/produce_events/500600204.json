{"translator":"告","rows":[{"id":"5006002040010","name":"小糸","text":"──ファイブ、シックス、セブン、エイト！\\nとんとん、決め……！","trans":"——5，6，7，8！\\n咚咚，收尾……！"},{"id":"5006002040020","name":"透","text":"…………","trans":""},{"id":"5006002040030","name":"円香","text":"……ふう……","trans":"……呼……"},{"id":"5006002040040","name":"小糸","text":"はぁ……\\nい、今の……","trans":"哈……\\n刚，刚才的……"},{"id":"5006002040050","name":"小糸","text":"だ、だいぶ\\nできてきたよね……！","trans":"差，差不多\\n都能做到了……！"},{"id":"5006002040060","name":"透","text":"うん","trans":"嗯"},{"id":"5006002040070","name":"円香","text":"浅倉は\\n途中の歌詞飛んでたけど","trans":"浅仓倒是\\n中间跳了歌词"},{"id":"5006002040080","name":"透","text":"え？","trans":"诶？"},{"id":"5006002040090","name":"円香","text":"……小糸はできてたんじゃない？","trans":"……小糸不是能做到吗？"},{"id":"5006002040100","name":"小糸","text":"ほ、ほんと……！？","trans":"真，真的吗……！？"},{"id":"5006002040110","name":"透","text":"うわ\\nすごいね","trans":"呜哇\\n好厉害"},{"id":"5006002040120","name":"小糸","text":"…………！","trans":""},{"id":"5006002040130","name":"小糸","text":"つ、次のレッスン時間の時\\n雛菜ちゃんも一緒に合わせてやって","trans":"下，下次课程上\\n和雏菜配合"},{"id":"5006002040140","name":"小糸","text":"トレーナーさんに見てもらおう……！","trans":"让教练看看吧……！"},{"id":"5006002040150","name":"透","text":"オッケー","trans":"OK"},{"id":"5006002040160","name":"円香","text":"じゃ、今日は終わり？","trans":"那，今天就结束了？"},{"id":"5006002040170","name":"小糸","text":"う、うん……！\\n付き合ってくれてありがとう、ふたりとも","trans":"啊，嗯……！\\n谢谢你们两个陪我"},{"id":"5006002040180","name":"円香","text":"別に","trans":"没事"},{"id":"5006002040190","name":"透","text":"うん","trans":"嗯"},{"id":"5006002040200","name":"透","text":"あ、今日","trans":"啊，今天"},{"id":"5006002040210","name":"透","text":"食べてく？\\nうちで","trans":"来吃饭吗？\\n来我家"},{"id":"5006002040220","name":"小糸","text":"あ……う、ううん！\\nわたしはここで……","trans":"啊……不，不用了！\\n"},{"id":"5006002040230","name":"小糸","text":"ちょっとやることあるから……！","trans":"我还有点事……！"},{"id":"5006002040240","name":"透","text":"そっか","trans":"是吗"},{"id":"5006002040250","name":"円香","text":"帰り道、気をつけて","trans":"回去路上小心"},{"id":"5006002040260","name":"小糸","text":"う、うん……！\\nありがとう","trans":"啊，嗯……！\\n谢谢你"},{"id":"5006002040270","name":"小糸","text":"お、お疲れ様！\\nばいばい！","trans":"辛，辛苦了！\\n拜拜！"},{"id":"5006002040280","name":"円香","text":"お疲れ","trans":"辛苦了"},{"id":"5006002040290","name":"透","text":"バイバーイ","trans":"拜拜——"},{"id":"5006002040300","name":"円香","text":"………………","trans":""},{"id":"5006002040310","name":"透","text":"忙しそうだね、小糸ちゃん","trans":"小糸好像很忙"},{"id":"5006002040320","name":"円香","text":"だね","trans":"是啊"},{"id":"5006002040330","name":"円香","text":"レッスン時間も増えて\\n自主練もしてるんだから","trans":"课程时间增加了\\n加上小糸也会去自主练习"},{"id":"5006002040340","name":"透","text":"あー","trans":"啊——"},{"id":"5006002040350","name":"透","text":"じゃあ、いい？","trans":"那，可以吗？"},{"id":"5006002040360","name":"透","text":"樋口も","trans":"樋口也来"},{"id":"5006002040370","name":"透","text":"……えっと\\nカレーとラッシー","trans":"……我想想\\n咖喱和拉西"},{"id":"5006002040380","name":"円香","text":"……行く","trans":"……去"},{"id":"5006002040390","name":"雛菜","text":"──お邪魔しました～！","trans":"——打扰了～！"},{"id":"5006002040400","name":"雛菜","text":"あれ～\\nふたりとも今おかえり～？","trans":"奇怪～\\n两个人现在要回去吗～？"},{"id":"5006002040410","name":"透","text":"あ、雛菜","trans":"啊，雏菜"},{"id":"5006002040420","name":"透","text":"うち、いた？","trans":"刚才在家？"},{"id":"5006002040430","name":"雛菜","text":"うん～\\n今日は帰る～！","trans":"嗯～\\n今天要回去～！"},{"id":"5006002040440","name":"透","text":"そっか","trans":"是吗"},{"id":"5006002040450","name":"透","text":"じゃーねー","trans":"再见——"},{"id":"5006002040460","name":"雛菜","text":"ばいばい～！","trans":"拜拜～！"},{"id":"5006002040470","name":"円香","text":"………………","trans":""},{"id":"5006002040480","name":"円香","text":"──うわ、何これ","trans":"——呜哇，这什么"},{"id":"5006002040490","name":"円香","text":"雛菜\\n散らかしっぱなし","trans":"雏菜\\n扔了一地"},{"id":"5006002040500","name":"透","text":"ははっ","trans":"哈哈"},{"id":"5006002040510","name":"円香","text":"…………はぁ","trans":"…………唉"},{"id":"5006002040520","name":"透","text":"あれ\\n片付けてくれるの","trans":"咦\\n你要打扫吗"},{"id":"5006002040530","name":"円香","text":"私が散らかった所に\\nいたくないだけ","trans":"我只是\\n不想待在杂乱的地方"},{"id":"5006002040540","name":"透","text":"おー\\nあざす","trans":"哦——\\n感谢"},{"id":"5006002040550","name":"円香","text":"ん","trans":"嗯"},{"id":"5006002040560","name":"円香","text":"……？","trans":""},{"id":"5006002040570","name":"円香","text":"このノート、\\n雛菜のじゃない？","trans":"这个笔记，\\n是雏菜的吧？"},{"id":"5006002040580","name":"透","text":"え","trans":"诶"},{"id":"5006002040590","name":"円香","text":"…………","trans":""},{"id":"5006002040600","name":"透","text":"あー","trans":"啊——"},{"id":"5006002040610","name":"透","text":"これ──……","trans":"这个——……"},{"id":"0000000000000","name":"透の母","text":"透ー！\\n円香ちゃんー！","trans":"透——！\\n圆香——！"},{"id":"0000000000000","name":"透の母","text":"ごはんー","trans":"吃饭了——"},{"id":"5006002040620","name":"透","text":"今行くー","trans":"马上去"},{"id":"5006002040630","name":"透","text":"だって","trans":"在喊了"},{"id":"5006002040640","name":"円香","text":"……うん","trans":"……嗯"}]}