{"translator":"gpt-5-mini（社区机翻，未人工审核）","ai":true,"aiHash":"b122b56","rows":[{"id":"3026011010010","name":"ルカ","text":"……？","trans":"……？"},{"id":"3026011010020","name":"ルカ","text":"（──街頭ピアノ）","trans":"（──街头钢琴）"},{"id":"0000000000000","name":"少女","text":"──……\\nうう～……！　できない……","trans":"──……\\n呜呜～……！　做不到……"},{"id":"3026011010030","name":"ルカ","text":"…………頑張れ──","trans":"…………加油──"},{"id":"0000000000000","name":"ルカの母","text":"────","trans":"────"},{"id":"3026011010040","name":"ルカ","text":"……、……────","trans":"……、……────"},{"id":"3026011010050","name":"ルカ","text":"ただいまー……","trans":"我回来了～……"},{"id":"0000000000000","name":"ルカの母","text":"おかえり\\n──どうしたの？","trans":"欢迎回家\\n──怎么了？"},{"id":"3026011010060","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"ルカの母","text":"……","trans":"……"},{"id":"0000000000000","name":"ルカの母","text":"……話せないこと？","trans":"……有什么说不出口的事吗？"},{"id":"3026011010070","name":"ルカ","text":"………………ううん","trans":"………………不"},{"id":"3026011010080","name":"ルカ","text":"音楽でね……こんど、\\nグループに分かれてはっぴょうすることになったの","trans":"关于音乐呢……下次，\\n要分组发表演出的事情"},{"id":"0000000000000","name":"ルカの母","text":"うん","trans":"嗯"},{"id":"3026011010090","name":"ルカ","text":"ひとりはピアノで……\\nほかの子は歌で……","trans":"一个人弹钢琴……\\n其他孩子唱歌……"},{"id":"0000000000000","name":"ルカの母","text":"うん","trans":"嗯"},{"id":"3026011010100","name":"ルカ","text":"……だれも、ピアノやりたい人がいなかったの","trans":"……没人想弹钢琴"},{"id":"0000000000000","name":"ルカの母","text":"……うん","trans":"……嗯"},{"id":"3026011010110","name":"ルカ","text":"話し合おうねって先生が言って……\\nでもやっぱりだれもいなくて、くじになって……","trans":"老师说要大家商量……\\n但是果然还是没人愿意，于是抽签了……"},{"id":"3026011010120","name":"ルカ","text":"…………\\n……ピアノになっちゃった","trans":"…………\\n……就变成弹钢琴了"},{"id":"0000000000000","name":"ルカの母","text":"……────","trans":"……────"},{"id":"3026011010130","name":"ルカ","text":"歌いたかったのに……！","trans":"我明明想唱歌的……！"},{"id":"3026011010140","name":"ルカ","text":"ピアノ、やったことない……\\nはっぴょうの日までにできなかったらどうしよう……","trans":"我没弹过钢琴……\\n如果到发表的那天还不会该怎么办……"},{"id":"3026011010150","name":"ルカ","text":"……こわいよぉ……","trans":"……好可怕啊……"},{"id":"0000000000000","name":"ルカの母","text":"……そっか","trans":"……是吗"},{"id":"0000000000000","name":"ルカの母","text":"……そんなに悲しくなっちゃうなら──\\n無理はしなくていいんだよ","trans":"……如果会让你那么难过的话──\\n就不用勉强自己"},{"id":"3026011010160","name":"ルカ","text":"……！","trans":"……！"},{"id":"0000000000000","name":"ルカの母","text":"……ママから先生に言おうか\\nピアノが弾ける子に代わってもらうことはできませんかって","trans":"……要不要妈妈去跟老师说呢？\\n能不能换成会弹钢琴的孩子来代替你"},{"id":"0000000000000","name":"ルカの母","text":"そしたら考えてもらえるかも","trans":"说不定老师会考虑的"},{"id":"3026011010170","name":"ルカ","text":"で、でも……","trans":"但、可是……"},{"id":"0000000000000","name":"ルカの母","text":"……？","trans":"……？"},{"id":"3026011010180","name":"ルカ","text":"くじにするって……\\nみんなで『いいよ』って言って……","trans":"大家说要抽签……\\n大家都说“可以”的……"},{"id":"3026011010190","name":"ルカ","text":"わたしも、いいって……\\nだから……──","trans":"我也说了可以……\\n所以……──"},{"id":"3026011010200","name":"ルカ","text":"……っ……","trans":"…………"},{"id":"0000000000000","name":"ルカの母","text":"…………怖くても、頑張りたいの？","trans":"…………尽管害怕，你还是想努力吗？"},{"id":"3026011010210","name":"ルカ","text":"────、うん…………","trans":"────、嗯…………"},{"id":"0000000000000","name":"ルカの母","text":"……そう","trans":"……是吗"},{"id":"0000000000000","name":"ルカの母","text":"………ぎゅってすれば、大丈夫","trans":"………抱一抱就没事了"},{"id":"3026011010220","name":"ルカ","text":"え……？","trans":"诶……？"},{"id":"0000000000000","name":"ルカの母","text":"ママのおまじない\\n……不安なことも、これで乗り越えてきたの","trans":"妈妈的魔法哦\\n……很多不安的事都是这样过去的"},{"id":"0000000000000","name":"ルカの母","text":"やってみて","trans":"试试看吧"},{"id":"3026011010230","name":"ルカ","text":"ぎゅってすれば、だいじょうぶ……？","trans":"抱一抱就没事……？"},{"id":"0000000000000","name":"ルカの母","text":"そう","trans":"是的"},{"id":"3026011010240","name":"ルカ","text":"ぎゅってすれば、だいじょうぶ────","trans":"抱一抱就没事────"},{"id":"0000000000000","name":"ルカの母","text":"──うん\\n頑張れるよ、大丈夫","trans":"──嗯\\n你能做到的，没问题"},{"id":"3026011010250","name":"ルカ","text":"……えへへ…………","trans":"……诶嘿嘿…………"},{"id":"0000000000000","name":"ルカの母","text":"任されたこと、\\nちゃんとやり遂げようとして偉いね","trans":"被委托了的事，\\n你还想好好完成，真了不起"},{"id":"0000000000000","name":"ルカの母","text":"──頑張って","trans":"──加油哦"},{"id":"3026011010260","name":"ルカ","text":"……！\\nうん────！","trans":"……！\\n嗯────！"}]}