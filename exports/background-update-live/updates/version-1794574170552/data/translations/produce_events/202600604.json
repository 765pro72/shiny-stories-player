{"translator":"StYL3","rows":[{"id":"2026006040010","name":"ルカ","text":"──────────","trans":"——————————"},{"id":"0000000000000","name":"プロデューサー","text":"『ルカ、お疲れ様』","trans":"“路加，辛苦啦”"},{"id":"0000000000000","name":"プロデューサー","text":"『こっちは待ち合わせの場所に着いたけど\\nルカはどうだ？』","trans":"“我已经到约好的碰头地点了\\n路加你在哪？”"},{"id":"2026006040020","name":"ルカ","text":"いちいち電話してくんな","trans":"别什么事都给我打电话"},{"id":"0000000000000","name":"プロデューサー","text":"『いや、すまん』","trans":"“啊，抱歉”"},{"id":"0000000000000","name":"プロデューサー","text":"『ただ、道が少し複雑だったから\\nちゃんと辿り着けるか気になってな』","trans":"“只是，这地方有点难找\\n我担心你有没有顺利抵达”"},{"id":"0000000000000","name":"プロデューサー","text":"『今、どの辺だ？』","trans":"“你现在在哪？”"},{"id":"2026006040030","name":"ルカ","text":"さぁ────","trans":"不知道————"},{"id":"0000000000000","name":"プロデューサー","text":"『さぁって……』","trans":"“不知道……”"},{"id":"0000000000000","name":"プロデューサー","text":"『もしかして、迷ったのか？』","trans":"“你该不会迷路了吧？”"},{"id":"2026006040040","name":"ルカ","text":"知らねぇ","trans":"谁知道呢"},{"id":"2026006040050","name":"ルカ","text":"……\\nほっとけよ","trans":"……\\n别管我了"},{"id":"2026006040060","name":"ルカ","text":"──────────……？","trans":"——————————……？"},{"id":"2026006040070","name":"ルカ","text":"これ────\\n誰かの……手袋……","trans":"这是————\\n谁的……手套……"},{"id":"2026006040080","name":"ルカ","text":"片方だけ────────","trans":"只有单手的————————"},{"id":"2026006040090","name":"ルカ","text":"…………","trans":"…………"},{"id":"2026006040100","name":"ルカ","text":"迷子か","trans":"迷路吗"},{"id":"2026006040110","name":"ルカ","text":"──────\\nもう、こいつは……","trans":"——————\\n这人真是……"},{"id":"0000000000000","name":"街の女性","text":"あ、あの──────────","trans":"请、请问——————————"},{"id":"0000000000000","name":"街の女性","text":"もしかして、その手袋……","trans":"你手上的手套……"},{"id":"2026006040120","name":"ルカ","text":"？\\nああ……落ちてて──────","trans":"？\\n啊……掉在这里的——————"},{"id":"0000000000000","name":"街の女性","text":"す、すみません……！\\nそれ、私が落としちゃったやつで……！","trans":"不、不好意思……！\\n那是，我不小心掉的……！"},{"id":"2026006040130","name":"ルカ","text":"そう……","trans":"这样……"},{"id":"0000000000000","name":"街の女性","text":"ありがとうございました……！\\nとっても助かりました！","trans":"谢谢你……！\\n帮大忙了！"},{"id":"2026006040140","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ────────！","trans":"路加————————！"},{"id":"0000000000000","name":"プロデューサー","text":"探したぞ……","trans":"真让我好找……"},{"id":"2026006040150","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"ええと……今の人は？","trans":"刚才的是……？"},{"id":"2026006040160","name":"ルカ","text":"手袋、落ちてた……","trans":"掉了手套……"},{"id":"2026006040170","name":"ルカ","text":"それ、拾って──────","trans":"被我捡了——————"},{"id":"0000000000000","name":"プロデューサー","text":"……そうか\\nあの人の手袋、拾ってあげたんだな","trans":"……是吗\\n你帮那个人捡回她的手套了啊"},{"id":"0000000000000","name":"プロデューサー","text":"はは、新年早々いいことしたな","trans":"哈哈，刚过年就有好事发生"},{"id":"2026006040180","name":"ルカ","text":"…………","trans":"…………"},{"id":"select","name":"","text":"ルカは\\n寒くないか？","trans":"路加\\n你不冷吗？"},{"id":"select","name":"","text":"いい年に\\nなりそうだな","trans":"今年\\n会是美好的一年"},{"id":"select","name":"","text":"手袋見つかって\\nよかったな","trans":"能找回手套\\n真是太好了"},{"id":"0000000000000","name":"プロデューサー","text":"ルカは\\n寒くないか？","trans":"路加\\n你不冷吗？"},{"id":"2026006040190","name":"ルカ","text":"別に……","trans":"不冷……"},{"id":"0000000000000","name":"プロデューサー","text":"そうか……","trans":"这样啊……"},{"id":"2026006040200","name":"ルカ","text":"寒くねぇし……","trans":"我又不冷……"},{"id":"2026006040210","name":"ルカ","text":"手袋も、いらねぇ","trans":"不需要手套"},{"id":"2026006040220","name":"ルカ","text":"そういうの、もういらねぇ────","trans":"不需要，那种东西了————"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ……行こう\\n現場に着けば暖かいから……な？","trans":"路加……走吧\\n到了现场就会暖和起来了……好吗？"},{"id":"0000000000000","name":"プロデューサー","text":"そうだ！\\nその前にコンビニであったかい飲み物でも買おう！","trans":"对了！\\n在此之前先去便利店买热饮吧！"},{"id":"2026006040230","name":"ルカ","text":"…………","trans":"…………"},{"id":"2026006040240","name":"ルカ","text":"いらねぇっつってんだろ","trans":"我不是说了不需要吗"},{"id":"0000000000000","name":"プロデューサー","text":"いい年に\\nなりそうだな","trans":"今年\\n会是美好的一年"},{"id":"2026006040250","name":"ルカ","text":"いい年？","trans":"美好的一年？"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、ルカがいいことをしたからな","trans":"嗯，因为路加做了好事啊"},{"id":"2026006040260","name":"ルカ","text":"別に……ただ拾っただけ","trans":"没啥……捡到东西罢了"},{"id":"0000000000000","name":"プロデューサー","text":"でも、あの人の元に手袋は戻ったわけだし\\nルカはいいことをしたよ、うん","trans":"不过，让手套回到那个人手上\\n路加做了件好事哦，嗯"},{"id":"2026006040270","name":"ルカ","text":"…………","trans":"…………"},{"id":"2026006040271","name":"ルカ","text":"────────","trans":"————————"},{"id":"2026006040280","name":"ルカ","text":"拾っただけっつってんだろ","trans":"我不是说了只是捡到吗"},{"id":"0000000000000","name":"プロデューサー","text":"手袋見つかって\\nよかったな","trans":"能找回手套\\n真是太好了"},{"id":"0000000000000","name":"ルカ","text":"まぁ……","trans":"啊……"},{"id":"0000000000000","name":"プロデューサー","text":"あの人、すごく安心してるみたいだった","trans":"那个人，看起来很安心"},{"id":"0000000000000","name":"プロデューサー","text":"きっと、大事なものだったんだな","trans":"我想，因为那是很重要的东西吧"},{"id":"2026006040300","name":"ルカ","text":"……","trans":"……"},{"id":"2026006040310","name":"ルカ","text":"さぁ、知らねぇ……","trans":"谁知道呢……"},{"id":"2026006040320","name":"ルカ","text":"私には、関係ねぇ","trans":"跟我，没关系"}]}