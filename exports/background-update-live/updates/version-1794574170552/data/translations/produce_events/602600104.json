{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"……ここで応援してるからな","trans":"……我在这里支持你"},{"id":"0000000000000","name":"プロデューサー","text":"結果がどうなろうと──","trans":"无论结果如何——"},{"id":"6026001040010","name":"ルカ","text":"勝つに決まってんだろ──","trans":"那我肯定能赢——"},{"id":"0000000000000","name":"プロデューサー","text":"あ、ああ……そうだな","trans":"啊，嗯……没错"},{"id":"0000000000000","name":"プロデューサー","text":"俺も、きっとそうなるって信じてる……","trans":"我也相信一定如此……"},{"id":"6026001040020","name":"ルカ","text":"ここに戻ってくる時は──","trans":"我回到这里的时候——"},{"id":"6026001040030","name":"ルカ","text":"優勝した後────","trans":"一定是优胜之后————"},{"id":"0000000000000","name":"プロデューサー","text":"うん……\\nここで応援してるからな","trans":"嗯……\\n我会在这里支持你"}]}