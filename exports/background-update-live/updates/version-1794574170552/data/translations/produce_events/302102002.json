{"translator":"魚見","rows":[{"id":"3021020020010","name":"円香","text":"まって","trans":"等等我"},{"id":"3021020020020","name":"透","text":"え、ごめん\\n早かった？","trans":"诶、抱歉\\n走太快了？"},{"id":"3021020020030","name":"円香","text":"……ううん\\n気にしなくていい","trans":"……没事\\n你不用在意"},{"id":"3021020020040","name":"円香","text":"行こ","trans":"走吧"},{"id":"3021020020050","name":"透","text":"ん","trans":"嗯"},{"id":"3021020020060","name":"円香","text":"…………","trans":""},{"id":"3021020020070","name":"円香","text":"同じ場所を、同じ足取りで歩く","trans":"在同样的地方，迈着同样的步伐"},{"id":"3021020020080","name":"円香","text":"正しいかたちをなぞるように","trans":"像是一路照着正确答案走"},{"id":"3021020020090","name":"円香","text":"無自覚に","trans":"无意识地"},{"id":"3021020020100","name":"円香","text":"…………","trans":""},{"id":"3021020020110","name":"透","text":"…………","trans":""},{"id":"3021020020120","name":"円香","text":"…………","trans":""},{"id":"3021020020130","name":"円香","text":"……なんで、海？","trans":"……为什么，是大海？"},{"id":"3021020020140","name":"透","text":"んー\\nなんか……","trans":"嗯——\\n感觉……"},{"id":"3021020020150","name":"透","text":"呼んでた、海が","trans":"在呼唤我，大海"},{"id":"3021020020160","name":"円香","text":"…………","trans":""},{"id":"3021020020170","name":"円香","text":"…………っ","trans":"…………"},{"id":"3021020020180","name":"雛菜","text":"円香先輩って────","trans":"圆香前辈你————"},{"id":"3021020020190","name":"円香","text":"まだ、ここから","trans":"今后，我还能"},{"id":"3021020020200","name":"円香","text":"横に並べる？","trans":"站在她身旁吗？"},{"id":"3021020020210","name":"円香","text":"いや、もうやめたほうがいい\\nそういうの","trans":"算了，还是不去想比较好\\n那种事情"},{"id":"3021020020220","name":"円香","text":"夢はいつか覚めるものだし","trans":"梦终究会醒"},{"id":"3021020020230","name":"円香","text":"飛べばいつかは落ちる","trans":"展翅后终将坠落"},{"id":"3021020020240","name":"円香","text":"うつくしいもの？","trans":"美丽之物？"},{"id":"3021020020250","name":"円香","text":"なんだっていい","trans":"谁管那是什么"},{"id":"3021020020260","name":"雛菜","text":"雛菜たちは、透先輩についていくけど","trans":"雏菜我们打算跟透前辈走"},{"id":"3021020020270","name":"小糸","text":"円香ちゃんは……？","trans":"圆香呢……？"},{"id":"3021020020280","name":"円香","text":"…………","trans":""},{"id":"3021020020290","name":"円香","text":"私は","trans":"我"},{"id":"3021020020300","name":"円香","text":"ここでいい","trans":"待在这就好"},{"id":"3021020020310","name":"円香","text":"なんて","trans":"什么的"},{"id":"3021020020320","name":"円香","text":"嘘","trans":"骗人的"},{"id":"3021020020330","name":"円香","text":"浅倉だけが先を行くように見えるのは","trans":"要我看着浅仓往前渐行渐远"},{"id":"3021020020350","name":"円香","text":"────────っ","trans":"————————"},{"id":"3021020020340","name":"円香","text":"許せない","trans":"我无法容忍"},{"id":"3021020020351","name":"小糸＆雛菜","text":"円香ちゃん……？","trans":"圆香……？"},{"id":"3021020020360","name":"小糸","text":"ま、待って……！","trans":"等、等一下……！"},{"id":"3021020020370","name":"円香","text":"苦しいし、みっともない","trans":"痛苦、狼狈"},{"id":"3021020020380","name":"円香","text":"正しいかたちを\\nなぞっているのに","trans":"明明照着正确答案走"},{"id":"3021020020390","name":"円香","text":"あるべきかたちになっていく","trans":"却还是成了本应有的模样"},{"id":"3021020020400","name":"円香","text":"もうやめたい","trans":"已经想放弃了"},{"id":"3021020020410","name":"円香","text":"魂を曝け出したくなんかない","trans":"根本就不想揭露自己的灵魂"},{"id":"3021020020420","name":"円香","text":"嘘","trans":"骗人的"},{"id":"3021020020430","name":"円香","text":"私は","trans":"我"},{"id":"3021020020440","name":"円香","text":"走りたい","trans":"想跑起来"},{"id":"3021020020450","name":"円香","text":"走る","trans":"跑动"},{"id":"3021020020460","name":"円香","text":"炎が、空を焼く","trans":"火焰，灼烧天空"},{"id":"3021020020470","name":"円香","text":"湧き上がる感情のまま","trans":"听从内心涌现的情感"},{"id":"3021020020480","name":"円香","text":"ぜんぶ","trans":"一切"},{"id":"3021020020490","name":"円香","text":"ぜんぶ焼き尽くせ","trans":"将一切燃烧殆尽"}]}