{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"user-2","name":"プロデューサー","text":"────千雪！\r\nやった……！","trans":"————千雪！\n成功了……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-3","name":"プロデューサー","text":"行けるな、次に────！","trans":"能行，下一个————！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003050010","name":"千雪","text":"プロデューサーさん……\r\nはい……！","trans":"制作人……\n是的……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003050020","name":"千雪","text":"嬉しいです……やっぱり","trans":"好开心……果然","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003050030","name":"千雪","text":"────ふふっ\r\n色々お騒がせしちゃっておいてばかみたいですけど……","trans":"————呵呵\n闹出那么多事之后还说这种话，好像有点傻……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003050040","name":"千雪","text":"……どっちの千雪──ってことじゃ、ないんですね","trans":"……原来并不是“哪一个千雪”——这种事呢","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003050050","name":"千雪","text":"どっちも、喜ばせたいです","trans":"我想让两个都开心","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-13","name":"プロデューサー","text":"うん\r\n俺もそう思うよ────","trans":"嗯\n我也这么想————","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-16","name":"プロデューサー","text":"『千雪』","trans":"“千雪”","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}