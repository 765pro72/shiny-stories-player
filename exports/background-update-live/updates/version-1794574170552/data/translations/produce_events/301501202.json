{"translator":"nono","rows":[{"id":"3015012020010","name":"甜花","text":"…………","trans":""},{"id":"3015012020020","name":"甜花","text":"…………","trans":""},{"id":"3015012020030","name":"甜花","text":"…………","trans":""},{"id":"3015012020040","name":"甜花","text":"（お腹、空いた…………）","trans":"（肚子，饿了…………）"},{"id":"3015012020050","name":"甜花","text":"（なんか、ないかな……）","trans":"（有没有啥，吃的呢……）"},{"id":"3015012020060","name":"甜花","text":"（えと──）","trans":"（我看看──）"},{"id":"3015012020070","name":"甜花","text":"（これは……\\n多分、明日……食べるやつ、だし……）","trans":"（这个……\\n好像是，明天……准备吃的……）"},{"id":"3015012020080","name":"甜花","text":"（ごはん、チンして……\\nふりかけとか、なんかで……）","trans":"（把饭，热好了之后……\\n然后撒上去，还是怎么来着……）"},{"id":"3015012020090","name":"甜花","text":"…………","trans":""},{"id":"3015012020100","name":"甜花","text":"（あ……\\nそだ……）","trans":"（啊……\\n对了……）"},{"id":"3015012020110","name":"甜花","text":"（前に……ネットで見たやつ……）","trans":"（之前……在网上看到过的那个……）"},{"id":"3015012020120","name":"甜花","text":"（たぶん……\\n作り方、保存してたはず……）","trans":"（我记得……\\n保存了，食谱来着……）"},{"id":"3015012020130","name":"甜花","text":"（あった……\\nたぬき丼……）","trans":"（有了……\\n油渣盖饭……）"},{"id":"3015012020140","name":"甜花","text":"（揚げ玉なら……あるし……）","trans":"（油渣的话……家里还有……）"},{"id":"3015012020150","name":"甜花","text":"（お醤油も、ある……）","trans":"（酱油，也有……）"},{"id":"3015012020160","name":"甜花","text":"（うん……\\nこれなら、甜花でも……できる……！）","trans":"（嗯……\\n这个的话，甜花都能……做出来……！）"},{"id":"3015012020170","name":"甜花","text":"（……それに──）","trans":"（……而且──）"},{"id":"3015012020180","name":"甜花","text":"（ご飯に……\\n……揚げ物……）","trans":"（米饭和……\\n……油炸食物……）"},{"id":"3015012020190","name":"甜花","text":"（罪、って感じで……\\nお夜食っぽい……！）","trans":"（就像是，有罪恶感的……\\n夜宵一样……！）"},{"id":"3015012020200","name":"甜花","text":"（よし……\\nこれにしよ……！）","trans":"（好的……\\n就做这个吧……！）"},{"id":"3015012020210","name":"甜花","text":"（で、できた……！）","trans":"（做、做好了……！）"},{"id":"3015012020220","name":"甜花","text":"……それじゃ……\\nいただきまーす……","trans":"……这么……\\n我开动了……"},{"id":"3015012020230","name":"","text":"──……","trans":""},{"id":"3015012020240","name":"甜花","text":"（にへへ……美味しい……！）","trans":"（欸嘿嘿……好吃……！）"},{"id":"3015012020250","name":"甘奈","text":"……甜花ちゃん……？","trans":"……甜花……？"},{"id":"3015012020260","name":"甜花","text":"わ──","trans":"哇──"},{"id":"3015012020270","name":"甜花","text":"な、なーちゃん……！？","trans":"小、小奈……！？"},{"id":"3015012020280","name":"甜花","text":"えと……\\nち、違うよ……！","trans":"不……\\n不是你想的那样……！"},{"id":"3015012020290","name":"甘奈","text":"え～？\\n何が？","trans":"欸～？\\n我想的什么？"},{"id":"3015012020300","name":"甜花","text":"あ……\\nな、なんだろ……？","trans":"啊……\\n是、是什么呢……？"},{"id":"3015012020310","name":"甘奈","text":"あははっ","trans":"啊哈哈"},{"id":"3015012020320","name":"甜花","text":"に、にへへ……","trans":"欸、欸嘿嘿"},{"id":"3015012020330","name":"甘奈","text":"甜花ちゃん、お夜食中？","trans":"甜花，是在吃夜宵吗？"},{"id":"3015012020340","name":"甜花","text":"あ……\\nう、うん……","trans":"啊……\\n是、是的"},{"id":"3015012020350","name":"甜花","text":"夜ごはん……\\nちょっと、少なかったっぽくて……","trans":"晚饭……\\n有点、没吃饱……"},{"id":"3015012020360","name":"甜花","text":"それで……\\n作った……たぬき丼……！","trans":"所以……\\n才弄了这个……油渣盖饭……！"},{"id":"3015012020370","name":"甘奈","text":"えっ！\\n作ったの！？　すご～い！","trans":"哎！\\n自己做的吗！？　好厉害！"},{"id":"3015012020380","name":"甜花","text":"にへへ……\\nそれほどでも……！","trans":"欸嘿嘿……\\n没有那么厉害啦……！"},{"id":"3015012020390","name":"甜花","text":"色々、かけただけ……\\nだからね……！","trans":"只是，把各种各样现有的……\\n放在一起罢了……！"},{"id":"3015012020400","name":"甘奈","text":"──でも、甜花ちゃんっ","trans":"──但是，甜花"},{"id":"3015012020410","name":"甜花","text":"う……\\nひゃい……","trans":"呜……\\n嗯……"},{"id":"3015012020420","name":"甘奈","text":"こないだ衣装さんにも言われたんだから","trans":"之前也被服装师给说了"},{"id":"3015012020430","name":"甘奈","text":"食べすぎには、\\n気を付けなきゃだよ～？","trans":"要注意不能，\\n吃太多哦～？"},{"id":"3015012020440","name":"甜花","text":"う、うん……\\nそう、だよね…………","trans":"嗯，嗯……\\n是，的呢…………"},{"id":"3015012020450","name":"甘奈","text":"でもでも～、めっちゃいい匂い！\\n美味しそ～","trans":"但是～，真香啊！\\n很好吃的感觉～"},{"id":"3015012020460","name":"甜花","text":"あ……なーちゃんも……\\n食べる……？","trans":"啊……小奈……\\n也要吃吗……？"},{"id":"3015012020470","name":"甘奈","text":"えへへっ\\nじゃあ、ひと口ちょうだい？","trans":"欸嘿嘿\\n那么，就给我吃一口吧。"},{"id":"3015012020480","name":"甘奈","text":"そしたら甘奈は\\nこのこと、見なかったことにするねっ","trans":"这样的话甘奈\\n就当做，没看见过这回事"},{"id":"3015012020490","name":"甜花","text":"わ……\\nなーちゃん、優しい……！","trans":"哇……\\n小奈，太温柔了……！"},{"id":"3015012020500","name":"甜花","text":"じゃあ……\\nはい……！","trans":"那么……\\n请用……！"},{"id":"3015012020510","name":"甘奈","text":"…………ん～！\\n美味し～☆","trans":"…………啊嗯～！\\n好吃～☆"},{"id":"3015012020520","name":"甜花","text":"で、でしょ……！\\nにへへ……！","trans":"是、是吧……！\\n欸嘿嘿……！"}]}