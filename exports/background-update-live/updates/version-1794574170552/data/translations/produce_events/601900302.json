{"translator":"","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──愛依、おめでとう！","trans":"——爱依，恭喜啊！"},{"id":"6019003020010","name":"愛依","text":"……プロデューサー！\\nうち、ちゃんとできてた……！？","trans":"……制作人！\\n我做到了吗……！？"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、できてたよ","trans":"嗯，做到了哦"},{"id":"6019003020020","name":"愛依","text":"そっか……\\nよかった……","trans":"是吗……\\n太好了……"},{"id":"0000000000000","name":"プロデューサー","text":"愛依、もっと自信を持っていい","trans":"爱依，再自信一点"},{"id":"0000000000000","name":"プロデューサー","text":"愛依は自分の力で予選を突破して\\n決勝に進むんだから","trans":"你可是凭着自己的实力\\n进入决赛的"},{"id":"6019003020030","name":"愛依","text":"……うん","trans":"……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"愛依はすごいよ","trans":"爱依很棒哦"}]}