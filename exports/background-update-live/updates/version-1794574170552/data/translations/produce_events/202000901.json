{"translator":"魚見","rows":[{"id":"0000000000000","name":"広告動画の声","text":"ライト……！","trans":"灯……！"},{"id":"0000000000000","name":"広告動画の声","text":"エアコン……！","trans":"空调……！"},{"id":"0000000000000","name":"広告動画の声","text":"ブラインド……！","trans":"窗帘……！"},{"id":"0000000000000","name":"広告動画の声","text":"オーブン、強火で20分……！","trans":"开启，大火20分钟……！"},{"id":"0000000000000","name":"広告動画の声","text":"バスルームにお湯をはって……！","trans":"浴室加热水……！"},{"id":"0000000000000","name":"広告動画の声","text":"それから","trans":"然后"},{"id":"0000000000000","name":"広告動画の声","text":"ベッドルームにミュージック","trans":"卧室放音乐"},{"id":"2020009010010","name":"透","text":"んあー……","trans":"嗯啊——"},{"id":"0000000000000","name":"広告動画の声","text":"『────あなたに一途なお部屋、あります』","trans":"“————对您一心一意的房间，就在这里”"},{"id":"0000000000000","name":"広告動画の声","text":"『広告スキップまであと５秒』……","trans":"“距离跳过广告还有5秒”"},{"id":"0000000000000","name":"広告動画の声","text":"『ボイスでらくらく、クリーン家事♡\\n次世代ルームで検索してね』","trans":"“音控轻轻松松，智能家电♡\\n请搜索次世代房间”"},{"id":"2020009010020","name":"off","text":"『広告をスキップできます』","trans":"“跳过广告”"},{"id":"0000000000000","name":"プロデューサー","text":"……\\n連打したって変わらないぞ？","trans":"……\\n就算连点也不会变快噢？"},{"id":"2020009010030","name":"透","text":"……え？\\nあー","trans":"……诶？\\n啊——"},{"id":"2020009010040","name":"透","text":"え、変わるかもじゃん？","trans":"诶，会变快的吧？"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nまぁ、１秒くらいは変わるかもしれないけど────","trans":"……\\n嘛，或许能快个一秒钟左右吧————"},{"id":"2020009010050","name":"透","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"────はは、邪魔しないよ\\nけど……","trans":"————哈哈，不会打扰你啦\\n不过……"},{"id":"0000000000000","name":"プロデューサー","text":"１秒を惜しむんだったら、出る時間も気にかけてくれー\\nもう５分ほどで車が着くから","trans":"一秒钟都珍惜的话，出发时间也注意一下—\\n还有五分钟车就到了"},{"id":"2020009010060","name":"透","text":"……あー","trans":"……啊——"},{"id":"0000000000000","name":"プロデューサー","text":"ざっと戸締まりだけしてくるよ","trans":"我先把窗关上咯"},{"id":"2020009010070","name":"透","text":"んー","trans":"嗯——"},{"id":"2020009010080","name":"透","text":"ふぁ……","trans":"呼啊……"},{"id":"0000000000000","name":"プロデューサー","text":"さ、透────","trans":"喂，透————"},{"id":"0000000000000","name":"プロデューサー","text":"────おーい……\\n出れるか？　上着着てくれー","trans":"————喂——……\\n能出发吗？　外套穿上—"},{"id":"2020009010090","name":"透","text":"うぃー\\n出ます出ます……","trans":"是——\\n来了来了"},{"id":"0000000000000","name":"プロデューサー","text":"キッチン消してくるから、\\n悪いけど向こうのブラインド下ろし────","trans":"我去关厨房煤气，\\n能麻烦你把那边的窗帘拉下————"},{"id":"2020009010100","name":"透","text":"えっ","trans":"诶"},{"id":"0000000000000","name":"プロデューサー","text":"──え？","trans":"——诶？"},{"id":"2020009010110","name":"透","text":"さっきのじゃん\\nやばい","trans":"这不是刚才那个嘛\\n不得了"},{"id":"0000000000000","name":"プロデューサー","text":"……？\\nええと────","trans":"……？\\n那个————"},{"id":"2020009010120","name":"透","text":"ライト……！","trans":"灯……！"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"2020009010130","name":"透","text":"もー\\nライトだって","trans":"真的是—\\n都说了灯了"},{"id":"2020009010140","name":"透","text":"消えなきゃ\\nぱっ、て","trans":"要关掉啊\\n啪地一下"},{"id":"0000000000000","name":"プロデューサー","text":"……ああー！\\nさっきの広告……","trans":"……啊啊—！\\n刚才的广告……"},{"id":"2020009010150","name":"透","text":"いくね、もっかい","trans":"来咯，再一次"},{"id":"0000000000000","name":"プロデューサー","text":"えっ、とお────","trans":"诶，透————"},{"id":"2020009010160","name":"透","text":"ライトー……！","trans":"灯—……！"},{"id":"0000000000000","name":"プロデューサー","text":"……っ","trans":"……！"},{"id":"2020009010170","name":"透","text":"……ふっ\\nふふふっ……","trans":"……呵\\n呵呵呵……"},{"id":"0000000000000","name":"プロデューサー","text":"いやいや、ちょっと待ってくれ\\nとお────","trans":"不是不是，稍微等一下\\n透————"},{"id":"2020009010180","name":"透","text":"ブラインドー……！","trans":"窗帘—……！"},{"id":"0000000000000","name":"プロデューサー","text":"……っ","trans":"……！"},{"id":"2020009010190","name":"透","text":"……ふふっ\\nあははっ……！","trans":"……呵呵\\n啊哈哈……！"},{"id":"2020009010200","name":"透","text":"ボイスでらくらくだわー","trans":"音控轻轻松松耶—"},{"id":"0000000000000","name":"プロデューサー","text":"透ー……！","trans":"透—！"},{"id":"select","name":"","text":"遊んでる\\n時間は────","trans":"现在可不是\\n玩的————"},{"id":"select","name":"","text":"あれは人力じゃない","trans":"那个可不是人工的"},{"id":"select","name":"","text":"……まだあるぞ","trans":"……还有哟"},{"id":"2020009010210","name":"透","text":"エアコーン……！","trans":"空调—……！"},{"id":"0000000000000","name":"プロデューサー","text":"……っ","trans":"……！"},{"id":"2020009010220","name":"透","text":"ふふっ\\nグー","trans":"呵呵\\ngood—"},{"id":"0000000000000","name":"プロデューサー","text":"いや、グーじゃなくて","trans":"不是，才不是good—"},{"id":"2020009010230","name":"透","text":"でも\\n出れるじゃん、もう","trans":"但是\\n可以走了吧，已经"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"2020009010240","name":"透","text":"一途、あざす","trans":"一心一意，感谢"},{"id":"2020009010250","name":"透","text":"えー","trans":"诶—"},{"id":"0000000000000","name":"プロデューサー","text":"だろ？","trans":"对吧？"},{"id":"2020009010260","name":"透","text":"じゃあ\\n連打で","trans":"那\\n连点"},{"id":"2020009010270","name":"透","text":"連打して終わらせて\\nこの時間","trans":"用连点来结束\\n这段时间"},{"id":"0000000000000","name":"プロデューサー","text":"……広告じゃないんだぞー","trans":"……这可不是广告啊—"},{"id":"2020009010280","name":"透","text":"おー\\nなんだっけ","trans":"噢—\\n什么来着"},{"id":"2020009010290","name":"透","text":"お風呂にお湯？","trans":"浴室加热水？"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nタクシーに乗る、だ","trans":"……\\n是，上出租车"},{"id":"2020009010300","name":"透","text":"あー……\\nえっ","trans":"啊—……\\n诶"},{"id":"0000000000000","name":"プロデューサー","text":"透、タクシー！","trans":"透，出租车！"},{"id":"2020009010310","name":"透","text":"……っ","trans":"……！"}]}