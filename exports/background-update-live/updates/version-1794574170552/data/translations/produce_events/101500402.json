{"translator":"nono","rows":[{"id":"1015004020010","name":"甜花","text":"……はっ、はっ……","trans":"……哈、哈……"},{"id":"1015004020020","name":"甜花","text":"…………ひぃっ……\\nふぅっ……","trans":"…………呜……\\n呼……"},{"id":"1015004020030","name":"甜花","text":"──……","trans":"——……"},{"id":"1015004020040","name":"甜花","text":"（──10分……\\n止まらないで……走った……！）","trans":"（——10分钟……\\n都没停下来……一在跑……！）"},{"id":"1015004020050","name":"甜花","text":"（にへへ……\\n甜花、頑張ってる……！）","trans":"（欸嘿嘿……\\n甜花，正在努力了……！）"},{"id":"1015004020060","name":"甜花","text":"（だから、ちょっと……休憩……！）","trans":"（所以，就休息……一会儿……！）"},{"id":"1015004020070","name":"甜花","text":"…………","trans":"…………"},{"id":"1015004020080","name":"甜花","text":"なんか……\\nお日様……ぽかぽかで……","trans":"怎么感觉……\\n太阳公公……好暖和……"},{"id":"1015004020090","name":"甜花","text":"あったかくて……\\n……お昼寝、したく──","trans":"暖暖的……\\n……让人，想睡午觉了——"},{"id":"1015004020100","name":"甜花","text":"……！？","trans":"……！？"},{"id":"0000000000000","name":"女の子","text":"いたた……","trans":"痛痛……"},{"id":"1015004020110","name":"甜花","text":"わ……\\nあの……だ、大丈夫……？","trans":"哇……\\n那个……没、没事吧……？"},{"id":"0000000000000","name":"女の子","text":"慣れてるから、平気……！","trans":"没事，习惯了……！"},{"id":"1015004020120","name":"甜花","text":"そ……そっか……","trans":"这、这样啊……"},{"id":"1015004020130","name":"甜花","text":"……えと……\\nじ、自転車の、練習……？","trans":"……那个……\\n是、是在练习自行车吗……？"},{"id":"0000000000000","name":"女の子","text":"うんっ、そうだよ\\nお姉ちゃんは？","trans":"嗯，是的哦\\n姐姐你呢？"},{"id":"1015004020140","name":"甜花","text":"え……","trans":"欸……"},{"id":"0000000000000","name":"女の子","text":"何をしてたの？","trans":"在干什么呢？"},{"id":"1015004020150","name":"甜花","text":"あ、えと……\\n体力……つけたくて、ランニングしてて……","trans":"啊，这个……\\n在……锻炼体力，用跑步"},{"id":"1015004020160","name":"甜花","text":"……でも……休んでて……","trans":"……但是……正在休息中……"},{"id":"0000000000000","name":"女の子","text":"そうなんだあ","trans":"原来如此"},{"id":"1015004020170","name":"甜花","text":"うん……","trans":"嗯……"},{"id":"1015004020180","name":"甜花","text":"──じ、自転車……","trans":"——自、自行车……"},{"id":"1015004020190","name":"甜花","text":"ずっと……練習、してるの……？","trans":"一直……都在练习吗……？"},{"id":"0000000000000","name":"女の子","text":"うんっ\\nまだ始めたばっかだけど","trans":"嗯\\n虽然才刚刚开始"},{"id":"0000000000000","name":"女の子","text":"わたし、\\n妹よりも、先に乗れるようになりたいんだ","trans":"我，\\n要想比妹妹，先学会骑车"},{"id":"0000000000000","name":"女の子","text":"だから、毎日、ここでこっそりやってるの","trans":"所以，每天都在这里偷偷练习"},{"id":"1015004020200","name":"甜花","text":"わ……\\nお姉ちゃん、なんだね……！","trans":"哇……\\n原来是当姐姐的啊……！"},{"id":"1015004020210","name":"甜花","text":"すごい、な……！","trans":"好厉害，啊"},{"id":"0000000000000","name":"女の子","text":"……ううんっ\\n乗れるようにならなくちゃ、すごくないよ","trans":"……嗯——\\n必须要学会才行，并不厉害"},{"id":"1015004020220","name":"甜花","text":"──……","trans":"——……"},{"id":"1015004020230","name":"甜花","text":"そ、か……\\n……じゃあ、頑張──","trans":"是、吗\\n……那么，加——"},{"id":"1015004020240","name":"甜花","text":"……甜花……\\nもう、頑張ってる……","trans":"……甜花……\\n已经在加油了……"},{"id":"1015004020250","name":"甜花","text":"……あ、えと……\\n……じゃなくて……","trans":"……啊，那个……\\n……不是……"},{"id":"0000000000000","name":"女の子","text":"？","trans":"？"},{"id":"1015004020260","name":"甜花","text":"もう、頑張ってるよね……","trans":"已经，在加油了呢……"},{"id":"0000000000000","name":"女の子","text":"ううん、ありがとう","trans":"嗯，谢谢你"},{"id":"0000000000000","name":"女の子","text":"『頑張れ』って言ってくれるの、嬉しい！","trans":"能跟我说“加油”，非常开心"},{"id":"0000000000000","name":"女の子","text":"ひとりだと\\nやっぱもうやめようかなって思っちゃうもん","trans":"一个人的话\\n果然会想着是不是放弃会比较好"},{"id":"1015004020270","name":"甜花","text":"…………","trans":"…………"},{"id":"0000000000000","name":"女の子","text":"じゃあ、わたし、行くね","trans":"再见，我，要走了"},{"id":"1015004020280","name":"甜花","text":"──あ、うん……！","trans":"……啊，嗯……！"},{"id":"0000000000000","name":"女の子","text":"お姉ちゃんも\\nランニング、頑張ってね","trans":"姐姐也\\n跑步，要加油呢"},{"id":"1015004020290","name":"甜花","text":"う、うん……\\nが……頑張る……ね","trans":"呜、嗯……\\n会……会加油……的"},{"id":"0000000000000","name":"女の子","text":"ばいばーい！","trans":"拜拜！"},{"id":"1015004020300","name":"甜花","text":"ばいばーい……","trans":"拜拜……"},{"id":"1015004020310","name":"甜花","text":"…………","trans":"…………"}]}