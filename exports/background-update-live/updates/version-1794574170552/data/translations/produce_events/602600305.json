{"translator":"煉金術式","rows":[{"id":"0000000000000","name":"プロデューサー","text":"おめでとうは、言っていいか……！？","trans":"我该说恭喜吗……！？"},{"id":"6026003050010","name":"ルカ","text":"……","trans":"……"},{"id":"6026003050020","name":"ルカ","text":"……ほぼ言ってんだろ","trans":"……你这都说了吧"},{"id":"0000000000000","name":"プロデューサー","text":"はは、一応確認をだな……","trans":"哈哈，总之还是确认一下……"},{"id":"6026003050030","name":"ルカ","text":"……じゃあいらねェ","trans":"……那就别说了"},{"id":"0000000000000","name":"プロデューサー","text":"え！？","trans":"诶！？"},{"id":"6026003050040","name":"ルカ","text":"落ちたとこから戻っただけだ","trans":"只是从跌倒的地方爬起来而已"},{"id":"6026003050050","name":"ルカ","text":"本番はこれからだろ","trans":"真正的挑战才刚开始"}]}