{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"6016003100020","name":"千雪","text":"悔しい悔しい……\r\n悔しい…………！","trans":"不甘心不甘心……\n不甘心…………！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-3","name":"プロデューサー","text":"────千雪、その","trans":"————千雪，那个","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003100030","name":"千雪","text":"……ふふふっ\r\n悔しいー……っ！","trans":"……呵呵呵\n不甘心——……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003100050","name":"千雪","text":"ふふっ\r\nすっごく、悔しがってます────","trans":"呵呵\n我非常、非常不甘心————","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003100060","name":"千雪","text":"アイドルじゃない私も、\r\nすーっごく","trans":"不是偶像的我，\n也特别特别……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-11","name":"プロデューサー","text":"じゃあ、よかった","trans":"那就好","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-13","name":"プロデューサー","text":"倍悔しいなら、きっと────","trans":"如果加倍不甘心，那一定————","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-14","name":"プロデューサー","text":"笑顔も倍増やせるよ","trans":"笑容也能加倍哦","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6016003100090","name":"千雪","text":"……そうかもです\r\nプロデューサーさん────","trans":"……也许是这样\n制作人————","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-20","name":"プロデューサー","text":"あぁ……俺も悔しいなぁ！","trans":"啊……我也很不甘心啊！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}