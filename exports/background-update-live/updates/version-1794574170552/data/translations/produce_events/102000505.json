{"translator":"魚見","rows":[{"id":"1020005050010","name":"雛菜","text":"透先輩～、コンビニ行こ～！","trans":"透前辈～、去便利店吧～！"},{"id":"1020005050020","name":"透","text":"あ、ごめん\\n今日予定あって","trans":"啊、抱歉\\n今天有事"},{"id":"1020005050030","name":"雛菜","text":"へ～？\\n予定って～？","trans":"诶～？\\n什么事～？"},{"id":"1020005050040","name":"透","text":"まぁ、ちょっと","trans":"嘛、一点小事"},{"id":"1020005050050","name":"小糸","text":"お待たせ……！","trans":"久等了……！"},{"id":"1020005050060","name":"雛菜","text":"透先輩、今日予定あるんだって～","trans":"透前辈，说是今天有事～"},{"id":"1020005050070","name":"小糸","text":"そ、そうなんだ……","trans":"这、这样啊……"},{"id":"1020005050080","name":"円香","text":"……急ぎ？","trans":"……很急？"},{"id":"1020005050090","name":"透","text":"うん、じゃ","trans":"嗯、拜"},{"id":"1020005050100","name":"透","text":"『今終わりました\\n向かいます』","trans":"“下课了\\n现在过去”"},{"id":"0000000000000","name":"プロデューサー","text":"その……\\nアイドルに興味ないかな？","trans":"就是……\\n你对偶像感兴趣吗？"},{"id":"0000000000000","name":"プロデューサー","text":"いや……急にごめん\\n俺、アイドルのプロデュースやってて","trans":"啊不是……抱歉了这么突然\\n其实我是当偶像制作人的"},{"id":"0000000000000","name":"プロデューサー","text":"向いてるんじゃないかと思うんだ、君\\nこれ、名刺で──","trans":"就觉着你很有天赋\\n这个、名片——"},{"id":"1020005050110","name":"透","text":"またか\\nって思ったけど","trans":"又来啊\\n我本是这么想的"},{"id":"0000000000000","name":"プロデューサー","text":"待って──","trans":"等一下——"},{"id":"0000000000000","name":"プロデューサー","text":"──いや、じゃなくて……\\n俺が、行くからさ！","trans":"——啊、不是……\\n我会走的！"},{"id":"0000000000000","name":"プロデューサー","text":"急に、失礼だった\\nなんか君のことを見てつい……","trans":"失礼了，这么突然\\n感觉一看到你就……"},{"id":"0000000000000","name":"プロデューサー","text":"駅、こっちだったよな！\\n俺歩いてくから、君はバス待っててよ","trans":"车站，是往这边对吧！\\n我会走过去的，你在这等公交就好"},{"id":"0000000000000","name":"プロデューサー","text":"じゃ──","trans":"拜拜——"},{"id":"1020005050120","name":"透","text":"あって思った","trans":"心里“啊”了一声"},{"id":"1020005050130","name":"透","text":"それに──","trans":"而且——"},{"id":"1020005050140","name":"透","text":"向こう側に、誰かがいた","trans":"对面，有谁在那儿"},{"id":"1020005050150","name":"透","text":"もしかしたら──","trans":"说不定——"},{"id":"1020005050160","name":"透","text":"もしかしたら、そうなのかもって","trans":"心里想着，说不定是那样"},{"id":"1020005050170","name":"透","text":"だから","trans":"所以"},{"id":"1020005050180","name":"透","text":"ねぇ──","trans":"我说——"},{"id":"1020005050190","name":"透","text":"すみませーん","trans":"打扰了——"},{"id":"1020005050200","name":"透","text":"……","trans":""},{"id":"1020005050210","name":"透","text":"あ……いた","trans":"啊……在这"},{"id":"1020005050211","name":"少女＆透","text":"ねぇ、のぼろうよ──","trans":"我说啊、爬上去吧——"},{"id":"1020005050220","name":"透","text":"浅倉透","trans":"浅仓透"},{"id":"0000000000000","name":"プロデューサー","text":"うん\\nで、ここに印鑑","trans":"嗯\\n然后在这盖章"},{"id":"1020005050230","name":"透","text":"印鑑……","trans":"印章……"},{"id":"1020005050240","name":"透","text":"あ、そうだ\\nいっこ聞いてもいい？","trans":"啊、对了\\n能问个事吗？"},{"id":"0000000000000","name":"プロデューサー","text":"ん？\\nああ、もちろん","trans":"嗯？\\n啊啊、当然了"},{"id":"1020005050250","name":"透","text":"あのさ……\\n昔──","trans":"那个啊……\\n以前——"},{"id":"0000000000000","name":"プロデューサー","text":"透？","trans":"透？"},{"id":"1020005050260","name":"透","text":"あー……","trans":"啊——……"},{"id":"1020005050270","name":"透","text":"飛べる？","trans":"能飞吗？"},{"id":"0000000000000","name":"プロデューサー","text":"えっ……？","trans":"诶……？"},{"id":"1020005050280","name":"透","text":"アイドルになったら\\n飛べる？","trans":"当上偶像之后\\n能飞起来吗？"},{"id":"0000000000000","name":"プロデューサー","text":"……ああ、俺が飛ばすよ\\n透が望む場所に","trans":"……嗯嗯、我会让透飞起来的\\n在透所期望的地方"},{"id":"1020005050290","name":"透","text":"はじめて","trans":"第一次"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"1020005050300","name":"透","text":"ちゃんと返ってきたの、答え","trans":"有人正经地回答我，问题"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ、そうか","trans":"哈哈、这样吗"},{"id":"1020005050310","name":"透","text":"うん\\nやっぱり、そうなのかも","trans":"嗯\\n果然，是那回事吧"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"1020005050320","name":"透","text":"ふふっ、ひとりごと","trans":"呵呵、自言自语"},{"id":"1020005050330","name":"透","text":"はい、押せたよ\\nプロデューサー","trans":"好了，盖好咯\\n制作人"}]}