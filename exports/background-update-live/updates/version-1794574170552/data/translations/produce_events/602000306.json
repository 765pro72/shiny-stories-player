{"translator":"Nast","rows":[{"id":"0000000000000","name":"プロデューサー","text":"お疲れ様\\n──どうだった？","trans":"辛苦了\\n──怎么样"},{"id":"6020003060010","name":"透","text":"え\\nうん","trans":"诶\\n嗯"},{"id":"6020003060020","name":"透","text":"楽しかった","trans":"尽兴了"},{"id":"0000000000000","name":"プロデューサー","text":"はは\\nシンプルな感想だ","trans":"哈哈\\n简单的感想呢"},{"id":"6020003060030","name":"透","text":"ふふっ\\nシンプルな感想でしょ","trans":"呵呵\\n是简单的感想吧"},{"id":"0000000000000","name":"プロデューサー","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"6020003060040","name":"透","text":"……\\nいいよ、なんか言わなくても","trans":"……\\n可以哦，就算什么都不说"},{"id":"6020003060050","name":"透","text":"楽しかったし────","trans":"因为尽兴了────"},{"id":"6020003060060","name":"透","text":"楽しいから、これからも","trans":"因为尽兴了，这之后也要"},{"id":"0000000000000","name":"プロデューサー","text":"────\\nうん","trans":"────\\n嗯"},{"id":"0000000000000","name":"プロデューサー","text":"それじゃ、\\n帰ろうか","trans":"那么，\\n回去吧"}]}