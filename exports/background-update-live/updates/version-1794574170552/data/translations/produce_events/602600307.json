{"translator":"煉金術式","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──ルカ","trans":"──路加"},{"id":"6026003070010","name":"ルカ","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"頑張ってな！","trans":"加油啊！"},{"id":"6026003070020","name":"ルカ","text":"……またそれかよ","trans":"……还是这句啊"},{"id":"0000000000000","name":"プロデューサー","text":"すまん違うんだ！　ルカが頑張らないって\\n思ってるわけじゃなくて、なんて言うかこう──","trans":"抱歉，我说错了！不是觉得路加不努力，\\n怎么说呢，就是──"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ！？","trans":"路加！？"},{"id":"6026003070030","name":"ルカ","text":"長い","trans":"话真多"},{"id":"6026003070040","name":"ルカ","text":"──黙って見てろ","trans":"──闭嘴看着"},{"id":"0000000000000","name":"プロデューサー","text":"……！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"──ああ、そうする","trans":"──好，我会的"}]}