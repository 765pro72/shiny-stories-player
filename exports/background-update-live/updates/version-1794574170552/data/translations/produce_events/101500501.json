{"translator":"月剑","rows":[{"id":"1015005010010","name":"甜花","text":"起きる、食べる、ゲーム、寝る","trans":"起床，吃东西，玩游戏，睡觉"},{"id":"1015005010020","name":"甜花","text":"食べる、ゲーム、寝る","trans":"吃东西，玩游戏，睡觉"},{"id":"1015005010030","name":"甜花","text":"起きる──","trans":"起床——"},{"id":"1015005010040","name":"甘奈","text":"あ！\\n甜花ちゃん、おはよう","trans":"啊！\\n小甜花，早上好"},{"id":"1015005010050","name":"甜花","text":"……なーちゃん……\\nおはよ……","trans":"……小奈……\\n早上好……"},{"id":"1015005010060","name":"甜花","text":"──あ……\\nご飯、できてる……","trans":"——啊……饭已经做好了……"},{"id":"1015005010070","name":"甘奈","text":"えへへっ\\nそろそろ起きてくる頃かな～って思って","trans":"诶嘿嘿\\n就感觉是不是到了小甜花起床的时候了"},{"id":"1015005010080","name":"甘奈","text":"はいっ！\\n朝ごはん兼お昼ごはんです☆　どうぞっ","trans":"好！\\n早饭兼午饭☆ 请用吧"},{"id":"1015005010090","name":"甜花","text":"にへへ……\\nありがと……","trans":"尼嘿嘿……\\n谢谢……"},{"id":"1015005010100","name":"甜花","text":"いただきまーす……","trans":"我开动了"},{"id":"1015005010110","name":"甜花","text":"……たまご、とろとろ……！","trans":"……鸡蛋，又软又滑……！"},{"id":"1015005010120","name":"甘奈","text":"うん☆\\nスクランブルエッグ、バター多めにしといたよ～","trans":"嗯\\n炒鸡蛋中多放了些黄油嘛～"},{"id":"1015005010130","name":"甜花","text":"にへへ……\\nやった……","trans":"尼嘿嘿……\\n太好了……"},{"id":"1015005010140","name":"甜花","text":"……──\\n美味しい……","trans":"……——\\n真好吃……"},{"id":"1015005010150","name":"甘奈","text":"──甜花ちゃん","trans":"——小甜花"},{"id":"1015005010160","name":"甘奈","text":"甘奈、これから\\n友達とお出かけするんだけどね","trans":"甘奈接下来\\n要和朋友一起出门"},{"id":"1015005010170","name":"甘奈","text":"何か買ってくるものとかあるかな？","trans":"有什么需要我买给你的东西吗？"},{"id":"1015005010180","name":"甜花","text":"あー……","trans":"啊——……"},{"id":"1015005010190","name":"甜花","text":"特に、ない……","trans":"没什么，需要的……"},{"id":"1015005010200","name":"甘奈","text":"そっか～","trans":"是吗～"},{"id":"1015005010210","name":"甘奈","text":"──あのね、甜花ちゃん\\nたまには一緒にお出かけ……しない？","trans":"——话说，小甜花\\n偶尔要不要一起出门……呢？"},{"id":"1015005010220","name":"甜花","text":"あ……うん……","trans":"啊……嗯……"},{"id":"1015005010230","name":"甜花","text":"今度、ね……","trans":"下次，吧……"},{"id":"1015005010240","name":"甘奈","text":"約束だよ～？","trans":"约好了哦～？"},{"id":"1015005010250","name":"甜花","text":"うん……","trans":"嗯……"},{"id":"1015005010260","name":"甘奈","text":"それじゃあ、夕方くらいには帰ってくるから！\\nいってきまーす","trans":"那么，我会在晚上左右回来！\\n我出门了"},{"id":"1015005010270","name":"甜花","text":"……いってらっしゃーい……","trans":"……一路走好……"},{"id":"1015005010280","name":"甜花","text":"あ、なーちゃ──\\nお皿は…………","trans":"啊，小奈\\n盘子还…………"},{"id":"1015005010290","name":"甜花","text":"…………下げとけば、いっか……","trans":"……收起来就好了吧……"},{"id":"1015005010300","name":"甜花","text":"ふぁ……","trans":"哈啊……"},{"id":"1015005010310","name":"甜花","text":"（なーちゃん、帰ってきてないし……）","trans":"（小奈还不回来……）"},{"id":"1015005010320","name":"甜花","text":"（夜ご飯も……まだ、だよね……）","trans":"（晚饭也一时半会吃不上呢……）"},{"id":"1015005010330","name":"甜花","text":"…………","trans":"………………"},{"id":"1015005010340","name":"甜花","text":"ちょっと、寝よ……","trans":"稍微睡一下吧……"},{"id":"1015005010350","name":"甜花","text":"起きる、食べる、ゲーム、寝る","trans":"起床，吃饭，玩游戏，睡觉"},{"id":"1015005010360","name":"甜花","text":"食べる、ゲーム、寝る","trans":"吃饭，玩游戏，睡觉"},{"id":"1015005010370","name":"甜花","text":"これが、甜花の完璧な一日","trans":"这就是甜花的完美的一天"}]}