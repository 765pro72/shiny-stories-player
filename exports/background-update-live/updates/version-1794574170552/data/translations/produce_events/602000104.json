{"translator":"岛木","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──ははっ、緊張してるな","trans":"──哈哈，真紧张啊"},{"id":"6020001040010","name":"透","text":"うん","trans":"嗯"},{"id":"6020001040020","name":"透","text":"……え、何\\nプロデューサー","trans":"……诶，怎么了\\n制作人"},{"id":"0000000000000","name":"プロデューサー","text":"いや、緊張してるなって","trans":"没，说你够紧张的"},{"id":"6020001040030","name":"透","text":"あー──","trans":"啊──"},{"id":"0000000000000","name":"プロデューサー","text":"いいことだよ\\nすごく","trans":"这也是好事"},{"id":"6020001040040","name":"透","text":"──……うん","trans":"──……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"6020001040050","name":"透","text":"……ううん","trans":"……没事"},{"id":"6020001040060","name":"透","text":"べつに緊張してない\\nって言おうと思ったんだけど","trans":"本来还想说\\n我没紧张"},{"id":"6020001040070","name":"透","text":"してた、緊張","trans":"果然还是，紧张了"},{"id":"6020001040080","name":"透","text":"でも……","trans":"不过……"},{"id":"6020001040090","name":"透","text":"大丈夫だから","trans":"一定没问题的"}]}