{"translator":"告","rows":[{"id":"3020004010010","name":"透","text":"……","trans":""},{"id":"3020004010020","name":"透","text":"……────","trans":""},{"id":"3020004010030","name":"小糸","text":"と、透ちゃん……\\n太陽、直で見ちゃだめだよ……！","trans":"小，小透……\\n不能直接看太阳啊……！"},{"id":"3020004010040","name":"透","text":"え\\nうん……","trans":"诶\\n嗯……"},{"id":"3020004010050","name":"小糸","text":"み、見てないよね……！？","trans":"没，没在看吧……！？"},{"id":"3020004010060","name":"透","text":"見てない見てない……","trans":"没有没有……"},{"id":"3020004010070","name":"小糸","text":"え…………","trans":"诶…………"},{"id":"3020004010080","name":"雛菜","text":"ん～\\n透先輩、太陽撮ってたの～～～？","trans":"嗯~\\n透学姐，在拍太阳吗~~~？"},{"id":"3020004010090","name":"透","text":"うん","trans":"嗯"},{"id":"3020004010100","name":"透","text":"ううん\\nなんか、空","trans":"不对\\n应该说，天空"},{"id":"3020004010110","name":"円香","text":"ふうん","trans":"呵"},{"id":"3020004010120","name":"小糸","text":"カメラも\\n直接向けたら危ないんだよ、透ちゃん────","trans":"镜头\\n直接对向太阳也很危险，小透————"},{"id":"3020004010130","name":"小糸","text":"目、焼けちゃうよ……！","trans":"眼睛，会烧掉……！"},{"id":"3020004010140","name":"透","text":"えー","trans":"诶——"},{"id":"3020004010150","name":"透","text":"何それ","trans":"什么啊"},{"id":"3020004010160","name":"透","text":"め","trans":"眼睛"},{"id":"3020004010170","name":"透","text":"を","trans":"会"},{"id":"3020004010180","name":"透","text":"やく","trans":"烧掉"},{"id":"3020004010190","name":"雛菜","text":"あは～\\n小糸ちゃん怖いこと言う～","trans":"啊哈~\\n小米说了好可怕的话~"},{"id":"3020004010200","name":"小糸","text":"ほ、ほんとだよ！\\nだめって習わなかった……！？","trans":"是，是真的啦！\\n你们没学过这样不行吗……！？"},{"id":"3020004010210","name":"雛菜","text":"そうだっけ～","trans":"是这样吗~"},{"id":"3020004010220","name":"透","text":"────…………","trans":""},{"id":"3020004010230","name":"円香","text":"……小糸の言ってたこと、聞いてた？","trans":"……你有在听小糸说话吗？"},{"id":"3020004010240","name":"透","text":"────え、うん\\n焼けるって？","trans":"————诶，嗯\\n会烧起来吧？"},{"id":"3020004010250","name":"円香","text":"……\\n自己責任でね","trans":"……\\n自己负责吧"},{"id":"3020004010260","name":"透","text":"あはは\\nわかった","trans":"啊哈哈\\n知道了"},{"id":"3020004010270","name":"透","text":"──\\n来ないかなって思って","trans":"——\\n在想会不会来"},{"id":"3020004010280","name":"小糸","text":"な、何が……？","trans":"什，什么……？"},{"id":"3020004010290","name":"透","text":"んー","trans":"嗯——"},{"id":"3020004010300","name":"透","text":"なんか\\n宇宙人とか","trans":"大概就\\n宇宙人那些"},{"id":"3020004010310","name":"小糸","text":"え……\\n宇宙人ってお昼にいるのかな……？","trans":"诶……\\n宇宙人中午会在吗……？"},{"id":"3020004010320","name":"円香","text":"昼か夜かは\\n関係なくない？","trans":"早中晚\\n没关系的吧？"},{"id":"3020004010330","name":"雛菜","text":"宇宙人って\\n地球に何しに来るの～？","trans":"宇宙人\\n会来地球干什么呢~？"},{"id":"3020004010340","name":"透","text":"侵略？","trans":"侵略？"},{"id":"3020004010350","name":"雛菜","text":"へ～\\nすごいね～～～","trans":"嘿~\\n好厉害~~~"},{"id":"3020004010360","name":"透","text":"うん","trans":"嗯"},{"id":"3020004010370","name":"透","text":"UFOで来るよ","trans":"会搭UFO来哦"},{"id":"3020004010380","name":"透","text":"ユー","trans":"U——"},{"id":"3020004010390","name":"透","text":"フォー","trans":"FO——"},{"id":"3020004010400","name":"透","text":"が","trans":"会"},{"id":"3020004010410","name":"透","text":"とんでくる","trans":"飞过来"},{"id":"3020004010420","name":"円香","text":"……\\n来たら逃げる","trans":"……\\n来的话我就跑"},{"id":"3020004010430","name":"雛菜","text":"雛菜も逃げる～！","trans":"雏菜也要~！"},{"id":"3020004010440","name":"小糸","text":"そ、そんな虫じゃないんだから……！","trans":"那，那可不是那种虫子啦……！"},{"id":"3020004010450","name":"透","text":"大丈夫だって\\n国が助けてくれるから","trans":"没事的\\n国家会救我们的"},{"id":"3020004010460","name":"透","text":"考えるって言ってた\\n偉い人が","trans":"上头的人\\n说了在考虑"},{"id":"3020004010470","name":"透","text":"宇宙人に出会ったら\\nどうするか","trans":"遇到宇宙人的话\\n要怎么做"},{"id":"3020004010480","name":"小糸","text":"そ、それはたぶん\\nそういう意味じゃないと思うけど……","trans":"他，他们说的\\n我觉得大概不是这个意思……"},{"id":"3020004010490","name":"透","text":"────……","trans":""},{"id":"3020004010491","name":"円香＆小糸＆雛菜","text":"──────","trans":""},{"id":"3020004010500","name":"円香","text":"……今日は来ないんじゃない","trans":"……今天不会来吧"},{"id":"3020004010510","name":"透","text":"んー……","trans":"嗯——"},{"id":"3020004010520","name":"透","text":"『そんなことはない』って\\n──そんなものに遭遇することはないって","trans":"还好你没说“没这种事”\\n——根本遇不到那种东西"},{"id":"3020004010530","name":"透","text":"言わないでくれて\\nよかった","trans":"还好\\n你没这么和我说"},{"id":"3020004010540","name":"透","text":"偉い人","trans":"上头的人"},{"id":"3020004010550","name":"小糸","text":"──と、透ちゃん……！","trans":"——小，小透……！"},{"id":"3020004010560","name":"透","text":"────……","trans":""},{"id":"3020004010570","name":"透","text":"空の上は、めちゃくちゃ広い\\nたぶん","trans":"天空上面，非常非常宽广\\n大概"},{"id":"3020004010580","name":"小糸","text":"透ちゃん、だめだからね……！","trans":"小透，不能这么做……！"},{"id":"3020004010590","name":"透","text":"めが","trans":"会有"},{"id":"3020004010600","name":"透","text":"やけるくらいの光が","trans":"眼睛会烧焦的程度"},{"id":"3020004010610","name":"透","text":"あるくらいだから","trans":"的光亮存在"},{"id":"3020004010620","name":"透","text":"────","trans":""},{"id":"3020004010630","name":"小糸","text":"だ、だめだから……！","trans":"不，不可以四轮！"},{"id":"0000000000000","name":"透","text":"──────","trans":""},{"id":"3020004010650","name":"透","text":"────うん","trans":"————嗯"},{"id":"3020004010660","name":"透","text":"ありがと","trans":"休息"},{"id":"3020004010670","name":"円香","text":"……","trans":""},{"id":"3020004010680","name":"透","text":"見なかった","trans":"没看"},{"id":"3020004010690","name":"小糸","text":"……！\\nはぁ……","trans":"……！\\n哈……"},{"id":"3020004010700","name":"円香","text":"写った？","trans":"拍到了？"},{"id":"3020004010710","name":"透","text":"ふふ、写ってるかも","trans":"呵呵，可能吧"},{"id":"3020004010720","name":"雛菜","text":"へ～\\n宇宙人来た～？","trans":"嘿~\\n宇宙人来了~？"},{"id":"3020004010730","name":"透","text":"うん\\nそういう感じは、あった","trans":"嗯\\n感觉有来"},{"id":"3020004010740","name":"小糸","text":"透ちゃん、見せて……！","trans":"小透，给我看……！"},{"id":"3020004010750","name":"小糸","text":"…………\\nぜ、全然写ってないよ……！","trans":"…………\\n完，完全没拍到啊……！"},{"id":"3020004010760","name":"透","text":"え、うそ\\n拡大して","trans":"诶，真假\\n放大试试"},{"id":"3020004010770","name":"透","text":"──あー\\nんじゃ、もっかい","trans":"——啊——\\n那就，再来一张"},{"id":"3020004010780","name":"小糸","text":"あ、だからだめだって────","trans":"啊，所以我说不行啦————"},{"id":"3020004010790","name":"円香","text":"……","trans":""},{"id":"3020004010800","name":"雛菜","text":"あは～～～！","trans":"啊哈~~~！"},{"id":"3020004010810","name":"透","text":"来い","trans":"来吧"},{"id":"3020004010820","name":"透","text":"UFO","trans":""}]}