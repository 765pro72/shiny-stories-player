{"translator":"可可","rows":[{"id":"3024010020010","name":"にちか","text":"──────────","trans":"──────────"},{"id":"0000000000000","name":"にちか","text":"『──────おねえちゃーん……！』","trans":"“──────姐姐……！”"},{"id":"0000000000000","name":"にちか","text":"『ねぇ、おねえちゃーん──────』","trans":"“姐姐啊──────”"},{"id":"0000000000000","name":"ダンストレーナー","text":"今回のところは半日オフってことで────","trans":"这次就以给你们放半天假的形式────"},{"id":"0000000000000","name":"にちか","text":"『──────ブランコ、あいてるよー……！』","trans":"“──────秋千，空出来了……！”"},{"id":"0000000000000","name":"ダンストレーナー","text":"────プロデューサークンの許可ももらってるから\\n休んで何かしてこーい！","trans":"────你们的制作人也同意了\\n好好休息去做点什么吧！"},{"id":"0000000000000","name":"にちか","text":"『ねーえー……！\\nブランコー……！』","trans":"“荡嘛……！\\n秋千……！”"},{"id":"0000000000000","name":"にちか","text":"ブランコでも…………乗って帰ろっかなー……","trans":"或者……荡一会儿秋千再回去……"},{"id":"3024010020070","name":"にちか","text":"──────────…………","trans":"──────────…………"},{"id":"3024010020080","name":"にちか","text":"ないなー…………","trans":"哎…………"},{"id":"0000000000000","name":"子ども","text":"────ねぇママ、ブランコのるー！","trans":"────妈妈，我要荡秋千──！"},{"id":"0000000000000","name":"母親","text":"えーっ\\nダメー。もうおうち帰る時間ー","trans":"诶\\n不行哦──。我们该回家了"},{"id":"0000000000000","name":"子ども","text":"えーっ","trans":"诶"},{"id":"3024010020090","name":"にちか","text":"────────ないなー……","trans":"────────唉……"},{"id":"3024010020100","name":"にちか","text":"……意味わかんないから、ガチで","trans":"……真不知道你说这个干嘛，真的"},{"id":"3024010020110","name":"にちか","text":"意味わかんないから\\nガチで","trans":"真不知道你说这个干嘛\\n真的"},{"id":"3024010020120","name":"にちか","text":"ブランコとか","trans":"说什么要荡秋千"},{"id":"3024010020130","name":"にちか","text":"──────美琴さん……","trans":"──────美琴小姐……"},{"id":"3024010020140","name":"にちか","text":"帰った……かな……","trans":"已经回家……了吧……"},{"id":"0000000000000","name":"はづき","text":"『──────帰るよ～……\\nもう暗いし……』","trans":"“──────该回家啦～……\\n天都黑了……”"},{"id":"0000000000000","name":"にちか","text":"『えーっ\\nちょっとだけじゃーん……！』","trans":"“诶\\n再玩一下嘛……！”"},{"id":"0000000000000","name":"はづき","text":"『……\\nまたすぐ来れるんだし～……』","trans":"“……\\n下次还能再来嘛～……”"},{"id":"3024010020180","name":"にちか","text":"……","trans":"……"},{"id":"0000000000000","name":"にちか","text":"『えーっ\\nまたとかじゃなくてー……！』","trans":"“诶\\n不是能不能再来的问题……！”"},{"id":"0000000000000","name":"にちか","text":"『帰ったら終わるじゃん今日ー……！』","trans":"“回去的话今天就结束了啊……！”"},{"id":"3024010020210","name":"にちか","text":"──────…………","trans":"──────…………"},{"id":"3024010020220","name":"にちか","text":"終わらせたけど\\n今日は","trans":"今天\\n已经结束了"},{"id":"3024010020230","name":"にちか","text":"お前が","trans":"自己一手促成的"},{"id":"0000000000000","name":"美琴","text":"……スーパーは、あっち？","trans":"……你去超市，是要走那边？"},{"id":"3024010020250","name":"にちか","text":"────────っ……","trans":"────────唔……"},{"id":"3024010020260","name":"にちか","text":"…………\\n美琴さん…………","trans":"…………\\n美琴小姐…………"},{"id":"3024010020270","name":"美琴","text":"……うん","trans":"……嗯"},{"id":"3024010020280","name":"にちか","text":"────────えっ","trans":"────────诶"},{"id":"3024010020290","name":"にちか","text":"えっ、み──────","trans":"诶，美──────"},{"id":"3024010020300","name":"にちか","text":"美琴さん………………！？","trans":"美琴小姐………………！？"},{"id":"3024010020310","name":"美琴","text":"……","trans":"……"},{"id":"3024010020320","name":"にちか","text":"えっとっ、あの……\\n事務所は……","trans":"诶，那个……\\n不是去事务所……"},{"id":"3024010020330","name":"美琴","text":"……？\\n行って、戻るところ","trans":"……？\\n刚去过了，正准备回家"},{"id":"3024010020340","name":"にちか","text":"あ、で、ですよね、そっか……！\\n書類受け取るだけ……ですもんね……！","trans":"啊，这，是这样啊，确实……！\\n只是去拿些资料……来着……！"},{"id":"3024010020350","name":"美琴","text":"うん","trans":"嗯"},{"id":"3024010020360","name":"にちか","text":"……っと\\n帰り、タクシー……とか、呼べなかったんです……？","trans":"……请问\\n走着回，是因为……打不到出租车吗……？"},{"id":"3024010020370","name":"美琴","text":"……呼べないということはないと思うけど","trans":"……不可能打不到吧"},{"id":"3024010020380","name":"にちか","text":"えっと","trans":"那么"},{"id":"3024010020390","name":"にちか","text":"えっと？","trans":"是要？"},{"id":"3024010020400","name":"美琴","text":"急がないし","trans":"也不赶时间"},{"id":"3024010020410","name":"美琴","text":"することも……思いつかないから","trans":"对于要做的事情……完全没头绪"},{"id":"3024010020420","name":"にちか","text":"……\\nあ、あの……はい…………","trans":"……\\n那，那个……确实…………"},{"id":"3024010020430","name":"美琴","text":"……","trans":"……"},{"id":"3024010020440","name":"にちか","text":"……\\n私も……です","trans":"……\\n我也……一样"},{"id":"3024010020450","name":"にちか","text":"私も、どうしてたらいいか思いつかなくて……\\nなんていうか……ここで、ぼんやりしてて──────","trans":"我也，完全不知道该做什么才好……\\n怎么说呢……就在这，傻傻待着了──────"},{"id":"3024010020460","name":"にちか","text":"ソレ","trans":"所以"},{"id":"3024010020470","name":"にちか","text":"デ？","trans":"呢？"},{"id":"3024010020480","name":"にちか","text":"────────ブランコ……","trans":"────────秋千……"},{"id":"3024010020490","name":"にちか","text":"ブランコ……乗りません──────？","trans":"要……荡秋千吗──────？"},{"id":"3024010020500","name":"にちか","text":"──────あ、あの、とりあえず座るというか…………！","trans":"──────啊，我意思是，在上面坐一会儿吧…………！"},{"id":"3024010020510","name":"美琴","text":"────うん","trans":"────好"},{"id":"3024010020520","name":"美琴","text":"……","trans":"……"},{"id":"3024010020530","name":"にちか","text":"……","trans":"……"},{"id":"3024010020540","name":"美琴","text":"……","trans":"……"},{"id":"3024010020550","name":"にちか","text":"……っ\\nえっと……！","trans":"……啊\\n那个……！"},{"id":"3024010020560","name":"にちか","text":"漕いだりとか────","trans":"要不要荡起来────"},{"id":"3024010020570","name":"美琴","text":"……？","trans":"……？"},{"id":"3024010020580","name":"にちか","text":"──────いっか、そんなの","trans":"──────算了吧，这种事"},{"id":"3024010020590","name":"にちか","text":"あのっ、なんでもないです……\\nえっと…………","trans":"那个，当我没说……\\n就…………"},{"id":"3024010020600","name":"美琴","text":"……何かをする？","trans":"……要不咱们找点事做？"},{"id":"3024010020610","name":"にちか","text":"────────ヨカッタ","trans":"────────太好了"},{"id":"3024010020620","name":"にちか","text":"は、はい──────！","trans":"好，好啊──────！"},{"id":"3024010020630","name":"にちか","text":"よかった\\nまだ、今日は","trans":"太好了\\n今天，又可以"},{"id":"3024010020640","name":"にちか","text":"今日が\\n続いてて","trans":"今天\\n又延续下去了"},{"id":"0000000000000","name":"にちか","text":"『帰ったら終わるじゃん今日ー……！』","trans":"“回去的话今天就结束了啊……！”"},{"id":"3024010020660","name":"にちか","text":"──────あのっ……","trans":"──────啊……"},{"id":"3024010020670","name":"にちか","text":"明日に続いてて","trans":"还会延续到明天"},{"id":"3024010020680","name":"にちか","text":"はい────────！","trans":"好的────────！"}]}