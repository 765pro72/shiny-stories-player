{"translator":"告","rows":[{"id":"3020004020010","name":"円香","text":"結局、いか焼きしか買ってない","trans":"结果只买了烤鱿鱼"},{"id":"3020004020020","name":"円香","text":"私、ベビカス────","trans":"小蜂蜜蛋糕————"},{"id":"3020004020030","name":"円香","text":"──やめた\\n量多すぎ","trans":"——我还是没买\\n量太多了"},{"id":"3020004020040","name":"小糸","text":"──んっ","trans":"——嗯"},{"id":"3020004020050","name":"小糸","text":"このくらいがちょうどいいよ……","trans":"这样就够吃了……"},{"id":"3020004020060","name":"小糸","text":"お腹減ってるし\\n甘いのより辛いのがいいなー……！","trans":"大家都饿了\\n所以辣的比甜的更好吧——……！"},{"id":"3020004020070","name":"小糸","text":"でも、焼きそばとかは多いよね……","trans":"可是，炒面的量就很多了……"},{"id":"3020004020080","name":"雛菜","text":"ん～\\nおいしい～～～！","trans":"嗯~\\n好吃~~~！"},{"id":"3020004020090","name":"雛菜","text":"いか焼き、おいしそ～～！","trans":"烤鱿鱼，好好吃的样子~~~！"},{"id":"3020004020100","name":"透","text":"ふふっ\\nいいね、いか焼き","trans":"呵呵\\n烤鱿鱼不错呢"},{"id":"3020004020110","name":"透","text":"いかってさ、\\n昔、宇宙人だったんだって","trans":"鱿鱼啊，\\n以前好像是禹州人呢"},{"id":"3020004020120","name":"小糸","text":"────え","trans":"————诶"},{"id":"3020004020130","name":"円香","text":"またその話？","trans":"又是这话题？"},{"id":"3020004020140","name":"透","text":"え？","trans":"诶？"},{"id":"3020004020150","name":"雛菜","text":"あは～\\n透先輩、宇宙人すきすぎ～","trans":"啊哈~\\n透学姐，太喜欢宇宙人了~"},{"id":"3020004020160","name":"透","text":"ふふっ\\nそうかな","trans":"呵呵\\n是吗"},{"id":"3020004020170","name":"小糸","text":"な、なんで照れてるの……","trans":"为，为什么会害羞……"},{"id":"3020004020180","name":"透","text":"よし\\n呼ぼう","trans":"好\\n呼叫他们吧"},{"id":"3020004020190","name":"円香","text":"宇宙人？","trans":"宇宙人？"},{"id":"3020004020200","name":"透","text":"見たいでしょ","trans":"你们想看吧"},{"id":"3020004020210","name":"透","text":"いかみたいな感じかどうか","trans":"是不是像鱿鱼那样"},{"id":"3020004020220","name":"小糸","text":"え……\\n呼ぶって────","trans":"诶……\\n呼叫宇宙人————"},{"id":"3020004020221","name":"小糸＆雛菜","text":"……？","trans":""},{"id":"3020004020230","name":"雛菜","text":"透先輩～～～？","trans":"透学姐~~~？"},{"id":"3020004020240","name":"小糸","text":"な、何描いてるの……？","trans":"你，你在画什么……？"},{"id":"3020004020250","name":"円香","text":"……ミステリーサークル","trans":"……麦田怪圈"},{"id":"3020004020260","name":"小糸","text":"え……","trans":"诶……"},{"id":"3020004020270","name":"小糸","text":"ミステリーサークルって、\\nUFOが来た後にできるやつじゃないの……？","trans":"麦田怪圈，\\n不是UFO来了之后才有的东西吗……？"},{"id":"3020004020280","name":"円香","text":"浅倉に言って","trans":"去跟浅仓说"},{"id":"3020004020290","name":"雛菜","text":"宇宙人来る～～～？","trans":"宇宙人会来吗~~~？"},{"id":"3020004020300","name":"円香","text":"……","trans":""},{"id":"3020004020310","name":"雛菜","text":"来たら逃げた方がいいんだっけ～？","trans":"来了的话逃跑会比较好吗~？"},{"id":"3020004020320","name":"透","text":"無理無理……！","trans":"不行不行……！"},{"id":"3020004020330","name":"透","text":"もう、一瞬だから……！","trans":"就，差那一瞬间……！"},{"id":"3020004020340","name":"小糸","text":"……な、なんか\\n気持ち悪いよ……","trans":"……感，感觉\\n好奇怪哦……"},{"id":"3020004020350","name":"透","text":"小糸ちゃん\\n手伝ってー","trans":"小糸\\n帮帮我——"},{"id":"3020004020360","name":"小糸","text":"ぴぇ……！\\nえ……！？","trans":"耶……！\\n诶……！？"},{"id":"3020004020370","name":"透","text":"丸……！\\nでっかく……！","trans":"画个圆……！\\n很大的……！"},{"id":"3020004020380","name":"透","text":"いかの棒で……！","trans":"用鱿鱼的棍子……！"},{"id":"3020004020390","name":"円香","text":"頑張って小糸","trans":"小糸加油"},{"id":"3020004020400","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"3020004020410","name":"小糸","text":"────ぴゃ……！","trans":"————呀……！"},{"id":"3020004020420","name":"小糸","text":"と、透ちゃん……！\\nなんか変な感じだよ……！？","trans":"小，小透……！\\n好像很奇怪的样子……！？"},{"id":"3020004020430","name":"透","text":"だから\\n来るんだって","trans":"所以说\\n要来了"},{"id":"3020004020440","name":"円香","text":"……","trans":""},{"id":"3020004020450","name":"小糸","text":"…………！\\nと、透ちゃん……！","trans":"…………！\\n小，小透……！"},{"id":"3020004020451","name":"一同","text":"────！","trans":""},{"id":"3020004020452","name":"一同","text":"…………","trans":""},{"id":"3020004020460","name":"透","text":"……\\nなんだ","trans":"……\\n什么啊"},{"id":"3020004020470","name":"透","text":"花火かー","trans":"是烟花啊"},{"id":"3020004020480","name":"小糸","text":"──３並べって結局\\nじゃんけんに勝つかどうかじゃない……？","trans":"——井字棋\\n结果不就是猜拳决定输赢吗……？"},{"id":"3020004020490","name":"円香","text":"あと、勝つ気があるかどうか","trans":"还有，想不想赢猜拳"},{"id":"3020004020500","name":"雛菜","text":"透先輩\\nもうよくない～？","trans":"透学姐\\n好了吗~？"},{"id":"3020004020510","name":"透","text":"来るって書いてあるんだけどなー\\nこうやって──","trans":"他们写了要来啊——\\n像这样——"},{"id":"3020004020520","name":"透","text":"光で合図したら","trans":"用光线发信号的话"},{"id":"3020004020530","name":"雛菜","text":"まだ呼ぶの～？","trans":"还要叫吗~？"},{"id":"3020004020540","name":"透","text":"あ、思う？\\n来るって","trans":"啊，你这么觉得？\\n他们会来"},{"id":"3020004020550","name":"雛菜","text":"知らないけど～","trans":"不太懂~"},{"id":"3020004020560","name":"雛菜","text":"いかみたいなんでしょ～？","trans":"就是像鱿鱼那样吧~？"},{"id":"3020004020570","name":"小糸","text":"──あ、そうだ……！\\n一筆書きでこれ、描ける……！？","trans":"——啊，对了……！\\n你们，能一笔画出这个吗……！？"},{"id":"3020004020580","name":"円香","text":"何","trans":"什么"},{"id":"3020004020590","name":"小糸","text":"えへへ\\nあのね────","trans":"诶嘿嘿\\n就是————"},{"id":"3020004020600","name":"雛菜","text":"雛菜もそれやる～～～","trans":"雏菜也要画~~~"},{"id":"3020004020610","name":"透","text":"んー……","trans":"嗯——……"},{"id":"3020004020620","name":"透","text":"興味持たないと\\nもっと","trans":"不再\\n多提点兴趣的话"},{"id":"3020004020630","name":"透","text":"ここだぞー\\n宇宙人ー","trans":"宇宙人——\\n这里——"},{"id":"3020004020631","name":"円香＆小糸＆雛菜","text":"────","trans":""},{"id":"3020004020640","name":"透","text":"ま────","trans":"算了————"},{"id":"3020004020650","name":"透","text":"イーカ","trans":"也好——"}]}