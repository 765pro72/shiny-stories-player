{"translator":"Rosineae","rows":[{"id":"3008013010010","name":"樹里","text":"……っ……\\n…………────","trans":"……哈……\\n…………────"},{"id":"3008013010020","name":"樹里","text":"……っ\\n……っ……はっ……","trans":"……呼\\n……哈啊……"},{"id":"3008013010030","name":"樹里","text":"…………ふぅ……\\n────","trans":"…………呼……\\n────"},{"id":"3008013010040","name":"樹里","text":"────もう一周……\\n……っ────","trans":"────再跑一圈……\\n……────"},{"id":"3008013010050","name":"霧子","text":"────はい……はい……\\nふふ……","trans":"────嗯……嗯……\\n呵呵……"},{"id":"3008013010060","name":"霧子","text":"お迎えは……大丈夫です……\\nもう……近くまで────","trans":"不用麻烦……来接我……\\n已经……到附近了────"},{"id":"3008013010070","name":"霧子","text":"────はい……\\nレッスン……行ってきます……","trans":"────好……\\n我去上课了……"},{"id":"3008013010080","name":"霧子","text":"────１、２、タ、ト、タ……","trans":"────１、２、哒、咚、哒……"},{"id":"0000000000000","name":"ダンス講師","text":"そこ、ちょっともたついちゃうかな……！","trans":"这里有些慢了呢……"},{"id":"3008013010090","name":"霧子","text":"は、はい……！","trans":"好、好的……！"},{"id":"0000000000000","name":"ダンス講師","text":"いいの、ステップは丁寧に踏めてるから\\nでもそれで遅れちゃう","trans":"没关系，动作做得很仔细\\n不过这样跳就慢了"},{"id":"3008013010100","name":"霧子","text":"もう一回……いきます……","trans":"再来一次……"},{"id":"0000000000000","name":"商店街のおばさん","text":"────あらぁ、樹里ちゃんこんにちはー","trans":"────喔，小树里你好啊"},{"id":"3008013010110","name":"樹里","text":"──あー……！　こんにちはー","trans":"──啊……！你好"},{"id":"3008013010120","name":"樹里","text":"それ、荷物持とうか","trans":"要我帮忙拿东西吗"},{"id":"0000000000000","name":"商店街のおばさん","text":"やだぁそんなんじゃないからぁ\\nこれから大事な練習なんじゃないの？","trans":"我不是这个意思\\n之后你不是有重要的练习吗？"},{"id":"3008013010130","name":"樹里","text":"や、まぁ、ランニングしようかなってだけだけど────","trans":"啊，嗯，虽然说就只是想去跑步────"},{"id":"3008013010140","name":"樹里","text":"────うん\\n大事にやんねーとな、ランニングも","trans":"────嗯\\n跑步也得认真对待啊"},{"id":"0000000000000","name":"商店街のおばさん","text":"そだよぉ\\n気持ちいぃ時間だし、おばちゃん平気だから","trans":"对啊\\n这个时候挺舒适的，阿姨没事的"},{"id":"3008013010150","name":"樹里","text":"あ、じゃなくて遠慮しなくたって──","trans":"啊，不用客气也行──"},{"id":"0000000000000","name":"商店街のおばさん","text":"車、気を付けんのよー\\n頑張ってー","trans":"注意看车哦\\n加油"},{"id":"3008013010160","name":"樹里","text":"……うん！\\nおばちゃんも気を付けて！","trans":"……嗯！\\n阿姨你也注意安全！"},{"id":"3008013010170","name":"樹里","text":"────ほんとだ、気持ちいい……","trans":"────真的，好舒服……"},{"id":"3008013010180","name":"樹里","text":"んーんー────","trans":"哼──哼────"},{"id":"3008013010190","name":"霧子","text":"────ありがとうございました……","trans":"────非常感谢……"},{"id":"3008013010200","name":"霧子","text":"────タ、トタ……","trans":"────哒、咚哒……"},{"id":"0000000000000","name":"ダンス講師","text":"────ストーップ！　遅い遅い！","trans":"────停！慢了慢了！"},{"id":"0000000000000","name":"ダンス講師","text":"もうテンポとっ払っちゃおうか\\nゆっくりでいいから、動きを体にしっかり染み込ませること","trans":"不用数拍子了\\n慢慢来也可以，要让身体记住动作"},{"id":"3008013010210","name":"霧子","text":"────……","trans":""},{"id":"0000000000000","name":"ダンス講師","text":"10回繰り返そう。オッケー？\\n繰り返して繰り返して、そこからテンポアップ","trans":"重复十遍吧。可以吗？\\n重复再重复，然后加快节奏"},{"id":"3008013010220","name":"霧子","text":"はい……！","trans":"是……！"},{"id":"3008013010230","name":"霧子","text":"────トタ、タ……","trans":"────咚哒、哒……"},{"id":"3008013010240","name":"霧子","text":"……\\nふふ……","trans":"……\\n呵呵……"},{"id":"3008013010250","name":"霧子","text":"繰り返して……繰り返して…………","trans":"重复……再重复…………"},{"id":"3008013010260","name":"霧子","text":"ゆっくり……\\n音楽に……なるんだね……","trans":"慢慢……\\n变成……音乐了呢……"},{"id":"3008013010270","name":"霧子","text":"……\\n頑張って……","trans":"……\\n加油"},{"id":"3008013010280","name":"樹里","text":"……っ……\\n……","trans":"……哈……\\n……"},{"id":"3008013010290","name":"霧子","text":"１……２……３……４────\\n１……２……タ、ト、タ……","trans":"１……２……３……４────\\n１……２……哒、咚、哒"},{"id":"3008013010300","name":"樹里","text":"────っ……\\nやってんなー……","trans":"────……\\n练着呢……"},{"id":"3008013010310","name":"霧子","text":"────タ、ト、タ……\\n１……２……","trans":"────哒、咚、哒……\\n１……２……"},{"id":"3008013010320","name":"霧子","text":"────ふぅ……","trans":"────呼……"},{"id":"3008013010330","name":"樹里","text":"……頑張れー\\n────んっ……","trans":"……加油啊\\n────嘿……"},{"id":"3008013010340","name":"霧子","text":"────繰り返し……繰り返し……","trans":"────重复……重复……"},{"id":"3008013010350","name":"霧子","text":"……もう一回────","trans":"……再一次────"},{"id":"3008013010360","name":"樹里","text":"……あれっ\\n霧子……","trans":"……咦\\n雾子……"},{"id":"3008013010370","name":"霧子","text":"──────タ、ト、タ…………！","trans":"──────哒、咚、哒…………！"},{"id":"3008013010380","name":"樹里","text":"……","trans":""},{"id":"3008013010390","name":"樹里","text":"おーい────！","trans":"喂────！"},{"id":"3008013010400","name":"霧子","text":"────？\\nあ……","trans":"────？\\n啊……"},{"id":"3008013010410","name":"樹里","text":"おーす\\nすげー集中してるなー","trans":"早啊\\n跳得很投入呢"},{"id":"3008013010420","name":"霧子","text":"うん……！\\nランニング……？","trans":"嗯……！\\n在跑步吗……？"},{"id":"3008013010430","name":"樹里","text":"おー\\n邪魔するつもりはねーんだけど、つい","trans":"嗯\\n没想打扰你的"},{"id":"3008013010440","name":"樹里","text":"綺麗に振り入ってんなーって思って","trans":"就觉得跳得挺好的"},{"id":"3008013010450","name":"霧子","text":"わ……","trans":"哇……"},{"id":"3008013010460","name":"霧子","text":"樹里ちゃんも……\\n綺麗な……汗……","trans":"树里也是……\\n漂亮的……汗水……"},{"id":"3008013010470","name":"樹里","text":"おっと、マジか……！","trans":"噢，真的吗……！"},{"id":"3008013010480","name":"霧子","text":"ずーっと……\\n走ってたんだね……","trans":"一直……\\n在跑步呢……"},{"id":"3008013010490","name":"樹里","text":"ははっ、んー\\n走ってるだけだけどなー","trans":"哈哈，嗯\\n就只是一直跑着"},{"id":"3008013010500","name":"樹里","text":"……でもさ、なんつーか\\nもっと行けるなーって気になるよ","trans":"……不过，怎么说呢\\n感觉能跑得更久了"},{"id":"3008013010510","name":"樹里","text":"こんだけ、\\n丁寧な練習してるヤツがいるって思ったらさ","trans":"一想到，有这么认真练习的人在"},{"id":"3008013010520","name":"霧子","text":"ふふ……\\nもっと……行くの……？","trans":"呵呵……\\n要跑久一些吗……？"},{"id":"3008013010530","name":"霧子","text":"────よろしく……お願いします……！","trans":"────请多指教……！"},{"id":"3008013010540","name":"樹里","text":"え？　おー\\nまぁ、どこまでってわけじゃねーけど……","trans":"诶？嗯──\\n虽说不可能一直跑下去"},{"id":"3008013010550","name":"樹里","text":"うん、もっと","trans":"嗯，多跑一些"},{"id":"3008013010560","name":"樹里","text":"────っ……っ……\\nラストー……！","trans":"────哈……哈……\\n最后一圈……！"},{"id":"3008013010570","name":"樹里","text":"もっと……\\nよし！　って思えるとこまで！","trans":"继续……\\n直到自己满意为止！"},{"id":"3008013010580","name":"霧子","text":"うん……\\n────あの……それじゃ……","trans":"嗯……\\n────那么……"},{"id":"3008013010581","name":"霧子＆樹里","text":"またね……！","trans":"再见……！"},{"id":"3008013010590","name":"霧子","text":"────音楽みたい……\\n樹里ちゃんが……走ると……","trans":"────像音乐一样……\\n树里跑起来……"},{"id":"0000000000000","name":"ダンス講師","text":"────オッケー！\\n霧子ちゃん、いい感じー……！","trans":"────OK！\\n雾子，跳得很好……！"},{"id":"0000000000000","name":"ダンス講師","text":"だいぶ頑張ったね？","trans":"下功夫练过了是吧？"},{"id":"3008013010600","name":"霧子","text":"──────樹里ちゃん……","trans":"──────树里……"},{"id":"3008013010610","name":"霧子","text":"は、はい……！\\nあの……","trans":"是、是的……！\\n那个……"},{"id":"3008013010611","name":"霧子＆樹里","text":"どこを……走ってますか……","trans":"在哪里……跑着呢……"},{"id":"3008013010620","name":"霧子","text":"わたしも……\\nもっと……行けそうだよ……","trans":"我也……\\n……能更进一步了哦……"},{"id":"3008013010630","name":"霧子","text":"繰り返して……繰り返して……","trans":"重复……再重复……"},{"id":"3008013010640","name":"霧子","text":"音が……\\n音楽に……なるところまで……","trans":"直到声音……\\n变为音乐……"}]}