{"translator":"魚見","rows":[{"id":"3023010020010","name":"小糸","text":"ひ、雛菜ちゃん\\n重くなかった……？","trans":"雏、雏菜\\n会很重吗……？"},{"id":"3023010020020","name":"雛菜","text":"ん～？","trans":"嗯～？"},{"id":"3023010020030","name":"小糸","text":"お菓子……\\n結構、いっぱいだなって……！","trans":"零食……\\n买了还挺多的……！"},{"id":"3023010020040","name":"小糸","text":"と、透ちゃんのおにぎりもいっぱいあるし……","trans":"透、透的饭团也不少……"},{"id":"3023010020050","name":"透","text":"おー","trans":"噢——"},{"id":"3023010020060","name":"透","text":"小糸ちゃんもいる？","trans":"小糸也要吗？"},{"id":"3023010020070","name":"透","text":"いっぱい買ったから\\nおにぎり","trans":"买了很多\\n饭团"},{"id":"3023010020080","name":"小糸","text":"あ、えっと\\n大丈夫……！","trans":"啊、那个\\n不用了……！"},{"id":"3023010020090","name":"小糸","text":"う、うちに帰ったら夜ご飯だし……","trans":"回、回到家都要吃晚饭了……"},{"id":"3023010020100","name":"透","text":"そっか","trans":"这样啊"},{"id":"3023010020110","name":"円香","text":"……サイダー","trans":"……汽水"},{"id":"3023010020120","name":"透","text":"さんきゅ","trans":"谢啦"},{"id":"3023010020130","name":"雛菜","text":"円香先輩～\\n雛菜のラテも～","trans":"圆香前辈～\\n还有雏菜的拿铁～"},{"id":"3023010020140","name":"円香","text":"……ん","trans":"……嗯"},{"id":"3023010020150","name":"小糸","text":"わ、わたしも\\nウーロン茶、飲もうかな……！","trans":"我、我也\\n喝点乌龙茶好了……！"},{"id":"3023010020151","name":"一同","text":"…………","trans":""},{"id":"3023010020160","name":"透","text":"んー、シュワシュワ","trans":"嗯——、嘶嘶嘶"},{"id":"3023010020170","name":"透","text":"しみるね","trans":"透心凉"},{"id":"3023010020180","name":"小糸","text":"…………ふぅ","trans":"…………呼"},{"id":"3023010020190","name":"円香","text":"…………","trans":""},{"id":"3023010020200","name":"雛菜","text":"……………………","trans":""},{"id":"3023010020210","name":"小糸","text":"……？\\nひ、雛菜ちゃん……？","trans":"……？\\n雏、雏菜……？"},{"id":"3023010020220","name":"雛菜","text":"に…………","trans":"好…………"},{"id":"3023010020230","name":"雛菜","text":"苦い～～～！","trans":"好苦～～～！"},{"id":"3023010020240","name":"小糸","text":"ぴぇ……！","trans":"噼诶……！"},{"id":"3023010020250","name":"小糸","text":"雛菜ちゃん\\nだ、大丈夫……？","trans":"雏菜\\n没、没事吧……？"},{"id":"3023010020260","name":"円香","text":"自業自得","trans":"自作自受"},{"id":"3023010020270","name":"透","text":"あー","trans":"啊——"},{"id":"3023010020280","name":"透","text":"……『ビターなコーヒーの味わい』\\nだって","trans":"……“醇苦的咖啡体验”\\n上面写着"},{"id":"3023010020290","name":"小糸","text":"う、うん……","trans":"嗯、嗯……"},{"id":"3023010020300","name":"雛菜","text":"うう～～～","trans":"呜呜～～～"},{"id":"3023010020310","name":"雛菜","text":"雛菜、これ飲めないかも～……","trans":"雏菜、可能喝不了这个～……"},{"id":"3023010020320","name":"円香","text":"…………","trans":""},{"id":"3023010020330","name":"円香","text":"……シュガー","trans":"……砂糖"},{"id":"3023010020340","name":"透","text":"おー\\nナイスアイディア","trans":"噢—\\n好主意"},{"id":"3023010020350","name":"雛菜","text":"あ～～","trans":"啊～～"},{"id":"3023010020360","name":"小糸","text":"あ、あと\\nはちみつとかもどうかな……？","trans":"还、还有\\n蜂蜜什么的怎么样……？"},{"id":"3023010020370","name":"小糸","text":"たぶん、キッチンにあるはず……！","trans":"厨房里应该会有……！"},{"id":"3023010020380","name":"雛菜","text":"あ～……\\nそれなら飲めそうかも～？","trans":"啊～……\\n那样的话说不定能喝～？"},{"id":"3023010020390","name":"小糸","text":"う、うん……！","trans":"嗯、嗯……！"},{"id":"3023010020400","name":"透","text":"いいね","trans":"真不错"},{"id":"3023010020410","name":"雛菜","text":"やは～\\n雛菜特製ラテ、完成～～～！","trans":"呀哈～\\n雏菜特制拿铁、完成～～～！"},{"id":"3023010020420","name":"透","text":"おー","trans":"噢——"},{"id":"3023010020430","name":"円香","text":"ある意味新作","trans":"某种意义也算新品"},{"id":"3023010020440","name":"雛菜","text":"…………","trans":""},{"id":"3023010020450","name":"小糸","text":"ど、どうかな\\n雛菜ちゃん……！","trans":"怎、怎么样\\n雏菜……！"},{"id":"3023010020460","name":"小糸","text":"飲みやすくなった……？","trans":"会好喝点吗……？"},{"id":"3023010020470","name":"雛菜","text":"ん～～～！","trans":"嗯～～～！"},{"id":"3023010020480","name":"雛菜","text":"甘くておいしい～！","trans":"甜甜的好好喝～！"},{"id":"3023010020490","name":"雛菜","text":"やっぱり雛菜、ラテすき～～～♡","trans":"雏菜果然喜欢拿铁～～～♡"}]}