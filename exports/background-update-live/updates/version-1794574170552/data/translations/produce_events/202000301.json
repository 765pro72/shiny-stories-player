{"translator":"Rosineae","rows":[{"id":"0000000000000","name":"プロデューサー","text":"……あぁ\\nこんなとこにいたのか……","trans":"……啊\\n原来在这里啊……"},{"id":"0000000000000","name":"プロデューサー","text":"おーい、透","trans":"喂，透"},{"id":"2020003010010","name":"透","text":"────……","trans":""},{"id":"2020003010020","name":"透","text":"……プロデューサー","trans":"……制作人"},{"id":"0000000000000","name":"プロデューサー","text":"あんまり離れたとこ\\n行かないでくれって言ったつもりなんだけどな？","trans":"我有说过不要离开太远吧？"},{"id":"2020003010030","name":"透","text":"あー","trans":"啊"},{"id":"2020003010040","name":"透","text":"ごめん","trans":"对不起"},{"id":"0000000000000","name":"プロデューサー","text":"窮屈だったか？　控室","trans":"待在休息室感觉不自在吗？"},{"id":"2020003010050","name":"透","text":"ううん","trans":"没有"},{"id":"2020003010060","name":"透","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"はは、どっちなんだ","trans":"哈哈，到底是怎样啊"},{"id":"2020003010070","name":"透","text":"ふふっ\\n窮屈だったのかも、じゃあ","trans":"呵呵\\n那么，可能是有些不自在"},{"id":"0000000000000","name":"プロデューサー","text":"……時々、少し心配になるよ\\nそのままどこかに行ってしまったりとか────","trans":"……有时会让人担心啊\\n就那样去了某处之类的────"},{"id":"0000000000000","name":"プロデューサー","text":"さすがに、しないよな","trans":"你不会这么做的吧"},{"id":"0000000000000","name":"プロデューサー","text":"────心配したんだからな","trans":"────我很担心啊"},{"id":"2020003010080","name":"透","text":"……あー","trans":"……啊"},{"id":"2020003010090","name":"透","text":"謝ったじゃん\\nごめん","trans":"我不是道歉了吗\\n对不起"},{"id":"0000000000000","name":"プロデューサー","text":"あ、いや……","trans":"啊，不……"},{"id":"0000000000000","name":"プロデューサー","text":"……ごめんな\\n俺も先方の世間話につかまっちゃって","trans":"……抱歉\\n我也被跟对方的聊天给缠住了"},{"id":"0000000000000","name":"プロデューサー","text":"外の空気、\\n吸いたくもなるよな","trans":"确实会想呼吸下外面的空气啊"},{"id":"2020003010100","name":"透","text":"まぁ\\nうん","trans":"嘛\\n嗯"},{"id":"2020003010110","name":"透","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"2020003010120","name":"透","text":"──\\n見てた、あれ","trans":"──\\n刚才在看，那个"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"0000000000000","name":"プロデューサー","text":"────遊園地か","trans":"────游乐场啊"},{"id":"2020003010130","name":"透","text":"うん、やばい\\nめっちゃ街なのに、ここ","trans":"嗯，真厉害\\n这里明明是商业区"},{"id":"0000000000000","name":"プロデューサー","text":"はは、オフィスビルばっかりだからな\\nああいう乗り物見えたら、なんか嬉しくなるよ","trans":"哈哈，到处都是办公大楼\\n看见那种乘坐物的话，总觉得会很开心啊"},{"id":"2020003010140","name":"透","text":"じゃ、行く？","trans":"那么，要去吗？"},{"id":"0000000000000","name":"プロデューサー","text":"……え？","trans":"……诶？"},{"id":"0000000000000","name":"プロデューサー","text":"────\\n追いかけなかったら────","trans":"────\\n如果我没有追过来的话────"},{"id":"0000000000000","name":"プロデューサー","text":"────どこに行くんだ？","trans":"────你要去哪里？"},{"id":"0000000000000","name":"プロデューサー","text":"追いかけなかったら\\nどうなるんだ、透？","trans":"没有追过来的话\\n会怎么样，透？"},{"id":"2020003010150","name":"透","text":"……えっと\\n遊園地？","trans":"……那个\\n游乐场？"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ────","trans":"啊────"},{"id":"0000000000000","name":"プロデューサー","text":"──えっ\\n遊園地……！？","trans":"──诶\\n游乐场！？"},{"id":"2020003010160","name":"透","text":"────あははっ\\nイエーイ……！","trans":"────啊哈哈\\n耶……！"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nメリーゴーランド、乗りたかったのかー……？","trans":"……\\n你想坐旋转木马吗……？"},{"id":"2020003010170","name":"透","text":"まぁ、そうー……！","trans":"啊，没错……！"},{"id":"0000000000000","name":"プロデューサー","text":"────はは\\nこれじゃ追いつけないなぁ","trans":"────哈哈\\n这样就追不上了啊"},{"id":"2020003010180","name":"透","text":"えー……？","trans":"诶……？"},{"id":"0000000000000","name":"プロデューサー","text":"……あぁ\\nなんでもない……！","trans":"……啊\\n没什么……！"},{"id":"2020003010190","name":"透","text":"えー……！","trans":"诶……！"},{"id":"0000000000000","name":"プロデューサー","text":"……\\n追いつかないって、言った！","trans":"……\\n我刚才说，这样子追不上！"},{"id":"2020003010200","name":"透","text":"何がー……！","trans":"追什么……！"},{"id":"0000000000000","name":"プロデューサー","text":"ええと、馬が……！\\nそっちの馬に……！","trans":"那个，木马……！\\n追不上那里的木马……！"},{"id":"2020003010210","name":"透","text":"なんでー……？","trans":"为什么……？"},{"id":"0000000000000","name":"プロデューサー","text":"なんでって、固定されてるし────","trans":"还说为什么，木马被固定着────"},{"id":"2020003010220","name":"透","text":"追ってるかもしれないじゃん……！","trans":"不是有可能在追逐着吗……！"},{"id":"2020003010230","name":"透","text":"私が……！","trans":"我……！"},{"id":"0000000000000","name":"プロデューサー","text":"────え？","trans":"────诶？"},{"id":"2020003010240","name":"透","text":"回ってるから、これ……！","trans":"因为，这个在旋转着……！"},{"id":"0000000000000","name":"プロデューサー","text":"────…………","trans":""},{"id":"2020003010250","name":"透","text":"──ありがと、付き合ってくれて","trans":"──谢谢你陪我一起"},{"id":"2020003010260","name":"透","text":"ごめん、さっき","trans":"刚才真是对不起"},{"id":"0000000000000","name":"プロデューサー","text":"……透","trans":"……透"},{"id":"2020003010270","name":"透","text":"なんか、めっちゃ夢中だったから\\n世間話","trans":"好像你跟人聊天聊得很入迷"},{"id":"2020003010280","name":"透","text":"出てきた、控室","trans":"我就从休息室里出去了"},{"id":"0000000000000","name":"プロデューサー","text":"追いかけなかったら────","trans":"如果没有追过来的话────"},{"id":"2020003010290","name":"透","text":"嬉しいから\\n追っかけてきてくれたこと","trans":"你追了过来\\n我很开心"}]}