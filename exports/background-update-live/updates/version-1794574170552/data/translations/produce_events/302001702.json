{"translator":"","rows":[{"id":"3020017020010","name":"にちか","text":"あとは、牛乳か……","trans":"然后是，牛奶吗……"},{"id":"3020017020020","name":"にちか","text":"あー\\n売り切れ……","trans":"啊——\\n卖完了……"},{"id":"3020017020030","name":"にちか","text":"……あ\\n今日特売セールだったっけ、牛乳","trans":"……啊\\n今天是特价来着，牛奶"},{"id":"3020017020040","name":"にちか","text":"…………","trans":"…………"},{"id":"0000000000000","name":"海外ドラマの字幕","text":"偶然なんてものはなく、すべては必然だなんて言う奴が\\nいるが、俺はそうは思わない","trans":"有人说，偶然这种事根本不存在，一切皆命中注定\\n但我可不这么认为"},{"id":"0000000000000","name":"海外ドラマの字幕","text":"逆なんだ。必然なんてものはなく、\\nあるのはただ、偶然の連続","trans":"正好相反。没有所谓必然，\\n只有一连串的偶然"},{"id":"0000000000000","name":"海外ドラマの字幕","text":"そこに意味とか理由をつけたがるのが\\n人間の愚かなところさ","trans":"总是给偶然加上意义和理由\\n这就是人类愚蠢的一面"},{"id":"3020017020050","name":"透","text":"────ふぁ……","trans":"────呼啊……"},{"id":"0000000000000","name":"電車のアナウンス","text":"次は────","trans":"下一站是────"},{"id":"3020017020060","name":"透","text":"え","trans":"诶"},{"id":"3020017020070","name":"透","text":"やば\\n逆方向","trans":"糟糕\\n坐反了"},{"id":"3020017020080","name":"透","text":"────あと20分……\\nまじすか","trans":"────还有20分钟……\\n真的假的"},{"id":"0000000000000","name":"スタッフ","text":"白瀬さんの撮影、以上となります\\nお疲れ様でしたー！","trans":"白濑女士的拍摄结束\\n辛苦大家了！"},{"id":"3020017020090","name":"咲耶","text":"お疲れ様でした！","trans":"辛苦了！"},{"id":"3020017020100","name":"咲耶","text":"！","trans":"！"},{"id":"3020017020110","name":"咲耶","text":"透……？","trans":"透……？"},{"id":"3020017020120","name":"透","text":"あ──","trans":"啊──"},{"id":"3020017020130","name":"咲耶","text":"フフッ、こんなところで会うなんて奇遇だね","trans":"哈哈，在这里遇到真是奇遇呢"},{"id":"3020017020140","name":"透","text":"うす","trans":"嗯"},{"id":"3020017020150","name":"咲耶","text":"どうしてこんなところに？","trans":"怎么会在这里？"},{"id":"3020017020160","name":"透","text":"あー\\n乗っちゃって、逆方向","trans":"啊——\\n坐错车了，反方向"},{"id":"3020017020170","name":"咲耶","text":"なるほど……","trans":"原来如此……"},{"id":"3020017020180","name":"咲耶","text":"それなら、電車が来るまでの退屈しのぎに、\\n私とおしゃべりをするというのはどうだろう","trans":"既然如此，在电车来之前打发时间\\n和我聊聊天怎么样？"},{"id":"3020017020190","name":"透","text":"あー、イエス","trans":"啊——，YES"},{"id":"3020017020200","name":"咲耶","text":"おや……\\n透、お昼は？","trans":"哦……\\n透，中午吃了吗？"},{"id":"3020017020210","name":"透","text":"なくて、時間","trans":"来不及，时间"},{"id":"3020017020220","name":"咲耶","text":"それは大変だ\\n次の駅で、何か食べて帰る？","trans":"那可不好\\n下一站吃点什么再回去？"},{"id":"3020017020230","name":"透","text":"うす","trans":"好"},{"id":"0000000000000","name":"レジスタッフ","text":"ポイントカードお返ししますー\\n……お会計、３番の端末でお願いいたします","trans":"这是您的积分卡\\n……请在3号机付款"},{"id":"3020017020240","name":"にちか","text":"…………","trans":"…………"},{"id":"3020017020250","name":"にちか","text":"────他のとこ、行くか","trans":"────还是找其他地方吧"},{"id":"3020017020260","name":"透","text":"あー……","trans":"啊……"},{"id":"3020017020270","name":"咲耶","text":"透、大丈夫？","trans":"透，你还好吗？"},{"id":"3020017020280","name":"透","text":"無理かも……","trans":"可能不行了……"},{"id":"3020017020290","name":"にちか","text":"えっと……牛乳────","trans":"那个……牛奶────"},{"id":"3020017020300","name":"にちか","text":"あ……あった","trans":"啊……找到了"},{"id":"0000000000000","name":"割引シール","text":"『10%OFF』","trans":"『9折优惠』"},{"id":"3020017020310","name":"にちか","text":"…………","trans":"…………"},{"id":"3020017020320","name":"にちか","text":"……────","trans":"……────"},{"id":"3020017020330","name":"透","text":"あ……","trans":"啊……"},{"id":"3020017020340","name":"透","text":"やばい……\\nもう、コンビニとか","trans":"糟糕……\\n便利店……"},{"id":"3020017020350","name":"咲耶","text":"わかった\\n今調べるよ","trans":"明白了\\n我找一下"},{"id":"3020017020360","name":"咲耶","text":"コンビニは少し行かないとないみたいだ\\n近くに小さなスーパーがあるみたいだけれど……","trans":"便利店要走一段路才有\\n不过附近好像有家小超市……"},{"id":"3020017020370","name":"咲耶","text":"そこでもいいかな？","trans":"那里也行吗？"},{"id":"3020017020380","name":"透","text":"買い物？","trans":"买东西？"},{"id":"3020017020390","name":"にちか","text":"……は、はい……","trans":"……是、是的……"},{"id":"3020017020400","name":"咲耶","text":"透、焼きそばパンあったよ────","trans":"透，有炒面面包────"},{"id":"3020017020410","name":"咲耶","text":"！","trans":"！"},{"id":"3020017020420","name":"咲耶","text":"にちか……","trans":"日花……"},{"id":"3020017020430","name":"にちか","text":"──！","trans":"──！"},{"id":"3020017020440","name":"咲耶","text":"やあ、偶然だね","trans":"呀，真巧啊"},{"id":"3020017020450","name":"にちか","text":"……ですねー……","trans":"……是啊……"},{"id":"3020017020460","name":"咲耶","text":"私たちも、さっき仕事帰りにバッタリ会ってね","trans":"我们也是，刚刚下班的路上偶然碰见的"},{"id":"3020017020470","name":"にちか","text":"あー……\\nそうなんですねー","trans":"啊——\\n原来是这样啊"},{"id":"3020017020480","name":"透","text":"これ？\\n欲しいの","trans":"这个？\\n想要的"},{"id":"3020017020490","name":"透","text":"牛乳","trans":"牛奶"},{"id":"3020017020500","name":"にちか","text":"……！","trans":"……！"},{"id":"0000000000000","name":"割引シール","text":"『10%OFF』","trans":"『10%OFF』"},{"id":"3020017020510","name":"にちか","text":"あ……えっと\\nいや……別に────","trans":"啊……那个\\n不……没什么────"},{"id":"3020017020520","name":"透","text":"……","trans":"……"},{"id":"3020017020530","name":"にちか","text":"すみません────\\nあの、失礼します……","trans":"对不起────\\n那个，我先告辞了……"},{"id":"3020017020540","name":"咲耶","text":"ああ、またね","trans":"啊啊，再见"},{"id":"3020017020550","name":"透","text":"んー……\\nうま","trans":"嗯——……\\n好吃"},{"id":"3020017020560","name":"咲耶","text":"フフッ\\n透、鼻にソースが付いているよ","trans":"呵呵\\n透，你鼻子上沾了酱哦"},{"id":"3020017020570","name":"透","text":"え、まじすか","trans":"诶，真的假的"},{"id":"3020017020580","name":"咲耶","text":"…………","trans":"…………"},{"id":"3020017020590","name":"咲耶","text":"『一緒に焼きそばパンを食べよう』────\\n気軽にそう言えるくらいの関係になれたらいいな……","trans":"『一起吃炒面面包吧』────\\n能变成这样轻松说出的关系就好了……"},{"id":"3020017020600","name":"透","text":"あー……","trans":"啊——……"},{"id":"3020017020610","name":"透","text":"まあ、あるんじゃないですか","trans":"嘛，也是会有的吧"},{"id":"3020017020620","name":"咲耶","text":"……え？","trans":"……诶？"},{"id":"3020017020630","name":"透","text":"七草さんが好きだったら\\n焼きそばパン","trans":"如果七草喜欢的话\\n炒面面包"},{"id":"3020017020640","name":"咲耶","text":"──フフッ\\nああ、そうだね！","trans":"──哈哈\\n啊啊，也是呢！"},{"id":"3020017020650","name":"咲耶","text":"透に言われると、\\n本当にそういう日が来るような気がするよ","trans":"被透这么一说，\\n感觉真会有这样的一天呢"}]}