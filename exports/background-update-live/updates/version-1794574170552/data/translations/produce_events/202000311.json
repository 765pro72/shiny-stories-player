{"translator":"Rosineae","rows":[{"id":"2020003110010","name":"透","text":"────","trans":"────"},{"id":"0000000000000","name":"プロデューサー","text":"……ん？\\nなんだ、透","trans":"……嗯？\\n怎么了，透"},{"id":"2020003110020","name":"透","text":"────え\\nううん────","trans":"────诶\\n没什么"},{"id":"2020003110030","name":"透","text":"見てた、なんか","trans":"那个，我在看"},{"id":"0000000000000","name":"プロデューサー","text":"……あぁ、これか？\\nCDラジカセ","trans":"……啊，这个吗？\\nCD收录两用机"},{"id":"2020003110040","name":"透","text":"ううん\\nじゃなくて","trans":"没有\\n不是这个"},{"id":"2020003110050","name":"透","text":"プロデューサーのこと","trans":"我在看制作人"},{"id":"0000000000000","name":"プロデューサー","text":"……からかうなー\\n宿題、ちゃんと取り組むこと","trans":"……别开玩笑\\n认真写作业"},{"id":"2020003110060","name":"透","text":"えー……","trans":"诶……"},{"id":"0000000000000","name":"プロデューサー","text":"透ならやれる\\n集中だ！","trans":"透的话能做到的\\n集中精神！"},{"id":"2020003110070","name":"透","text":"ふふふっ\\n何、やばい","trans":"呵呵呵\\n什么，不妙"},{"id":"0000000000000","name":"プロデューサー","text":"やばくない\\nわからないとこあったら、協力するよ","trans":"没有什么不妙\\n如果有不懂的地方的话，我会帮你的"},{"id":"2020003110080","name":"透","text":"あー\\nうん……","trans":"啊\\n嗯……"},{"id":"2020003110090","name":"透","text":"……ていうか\\nなんなの、それ","trans":"……话说\\n那是什么"},{"id":"0000000000000","name":"プロデューサー","text":"話をそらさな────","trans":"不要转移话────"},{"id":"2020003110100","name":"透","text":"いい曲？","trans":"好曲子？"},{"id":"0000000000000","name":"プロデューサー","text":"──\\nあぁ……これか","trans":"──\\n啊……这个吗"},{"id":"0000000000000","name":"プロデューサー","text":"うーん、どうだろうな\\n資料聴いておかなきゃってだけでさ","trans":"唔，该怎么说呢\\n只是因为我得听这些资料而已"},{"id":"2020003110110","name":"透","text":"へぇ","trans":"欸"},{"id":"0000000000000","name":"プロデューサー","text":"──悪いな\\n音漏れしないように注意するよ","trans":"──抱歉\\n我会注意不让声音漏出来的"},{"id":"2020003110120","name":"透","text":"あ、ううん","trans":"啊，不用"},{"id":"2020003110130","name":"透","text":"聴いてて、普通に","trans":"正常听就好"},{"id":"2020003110140","name":"透","text":"見てる","trans":"我在看"},{"id":"0000000000000","name":"プロデューサー","text":"……透は、宿題やること","trans":"……透要做作业"},{"id":"2020003110150","name":"透","text":"えー","trans":"诶"},{"id":"0000000000000","name":"プロデューサー","text":"『はい』な？","trans":"应该回答“好的”才对吧？"},{"id":"2020003110160","name":"透","text":"はーい……","trans":"好的……"},{"id":"2020003110170","name":"透","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"────って、透","trans":"────我说，透"},{"id":"2020003110180","name":"プロデューサー","text":"俺見てないで────","trans":"别看我啊────"},{"id":"0000000000000","name":"プロデューサー","text":"────っ","trans":"────"},{"id":"2020003110190","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"2020003110200","name":"透","text":"回ってるね\\nめっちゃ","trans":"旋转得很快呢"},{"id":"0000000000000","name":"プロデューサー","text":"……おう","trans":"……嗯"},{"id":"2020003110210","name":"透","text":"いいね\\n回って音が鳴るって","trans":"旋转着发出声音\\n真不错呢"},{"id":"0000000000000","name":"プロデューサー","text":"……え？","trans":"……诶？"},{"id":"2020003110220","name":"透","text":"鳴ってるーって、\\n感じするじゃん","trans":"不是能感觉到在响着吗"},{"id":"2020003110230","name":"透","text":"パソコンの画面から\\n聞こえてくるより","trans":"比起看着电脑画面来听"},{"id":"2020003110240","name":"透","text":"なんか\\n音が音、追いかけてるみたいで","trans":"总觉得\\n声音好像在追赶着声音"},{"id":"0000000000000","name":"透","text":"追ってるかもしれないじゃん……！\\n私が……！","trans":"不是有可能在追逐着吗……！\\n我……！"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"そっか\\n……うん","trans":"是吗\\n……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"ちゃんと追いかけて\\nつかまえないとな","trans":"得好好追上\\n抓住才行啊"},{"id":"0000000000000","name":"プロデューサー","text":"……この曲が、いい曲かどうか","trans":"……这首曲子是不是首好曲子"},{"id":"2020003110260","name":"透","text":"……えー、何","trans":"……诶，什么"},{"id":"2020003110270","name":"透","text":"なんか深いよ","trans":"好像很深邃啊"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ、いや……","trans":"啊，没有……"},{"id":"0000000000000","name":"プロデューサー","text":"独り言\\n────はい、集中！　宿題！","trans":"是我自言自语的话\\n────好了，集中精神！作业！"},{"id":"2020003110280","name":"透","text":"はーい","trans":"好的"}]}