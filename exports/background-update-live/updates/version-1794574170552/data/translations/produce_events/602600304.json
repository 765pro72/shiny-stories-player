{"translator":"煉金術式","rows":[{"id":"6026003040010","name":"ルカ","text":"────","trans":"────"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ\\nルカならきっと──","trans":"路加\\n路加的话一定──"},{"id":"6026003040020","name":"ルカ","text":"話","trans":"你说"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"6026003040030","name":"ルカ","text":"したい、っつってたよな\\nその割に、今、都合聞かれてねェけど","trans":"你说想聊聊对吧\\n但现在，你都不问我方便不方便"},{"id":"0000000000000","name":"プロデューサー","text":"！\\nすまん──！","trans":"！\\n对不起──！"},{"id":"6026003040040","name":"ルカ","text":"余計な言葉はいらねェ","trans":"少说多余的话"},{"id":"6026003040050","name":"ルカ","text":"──集中させろ","trans":"──让我集中"}]}