{"translator":"告","rows":[{"id":"3020003020010","name":"透","text":"しゃー","trans":"好——"},{"id":"3020003020020","name":"透","text":"やろ","trans":"来练习"},{"id":"3020003020030","name":"小糸","text":"……！","trans":""},{"id":"3020003020040","name":"雛菜","text":"……？","trans":""},{"id":"3020003020050","name":"円香","text":"……","trans":""},{"id":"3020003020060","name":"透","text":"やるよー","trans":"来练习了——"},{"id":"3020003020070","name":"透","text":"はい、柔軟\\nはい！","trans":"好，伸展\\n好！"},{"id":"3020003020080","name":"小糸","text":"……う、うん！","trans":"……嗯，嗯！"},{"id":"3020003020090","name":"小糸","text":"今日は透ちゃん\\n張り切ってるね……！","trans":"小透\\n今天很努力呢……！"},{"id":"3020003020100","name":"透","text":"うん","trans":"嗯"},{"id":"3020003020110","name":"透","text":"ほら、雛菜も\\nはい","trans":"好了，雏菜也来\\n来"},{"id":"3020003020120","name":"雛菜","text":"うん～！","trans":"嗯～！"},{"id":"3020003020130","name":"雛菜","text":"なんか、やる気だね～？","trans":"好像很有干劲呢～？"},{"id":"3020003020140","name":"円香","text":"ったく","trans":"真是"},{"id":"3020003020150","name":"透","text":"いくよー","trans":"要开始了——"},{"id":"3020003020160","name":"透","text":"樋口、補助しようか","trans":"樋口，我帮你吗"},{"id":"3020003020170","name":"円香","text":"いい、いい","trans":"不用，不用"},{"id":"3020003020180","name":"透","text":"オッケー\\nじゃ首回りから────","trans":"OK\\n那就先转头————"},{"id":"3020003020190","name":"小糸","text":"右、右、右、キメ……！","trans":"右，右，右，收尾……！"},{"id":"3020003020200","name":"透","text":"────右、右、右、キメ","trans":"————右，右，右，收尾"},{"id":"3020003020210","name":"小糸","text":"えっと、あれ……？","trans":"咦，怪了……？"},{"id":"3020003020220","name":"小糸","text":"キメ、がこう……！","trans":"收尾是这样……！"},{"id":"3020003020230","name":"透","text":"こう……","trans":"这样……"},{"id":"3020003020240","name":"小糸","text":"うん！\\nじゃ、せーの────","trans":"嗯！\\n那，预备————"},{"id":"3020003020241","name":"透＆小糸","text":"右、右、右、キメ……！","trans":"右，右，右，收尾……！"},{"id":"3020003020250","name":"雛菜","text":"なんか違くない～？","trans":"好像不太一样～？"},{"id":"3020003020260","name":"透","text":"……","trans":""},{"id":"3020003020270","name":"透","text":"見てて、雛菜\\nもっかい","trans":"雏菜看好\\n再来"},{"id":"3020003020280","name":"雛菜","text":"ん～！\\n食べながらでいい～？","trans":"嗯～！\\n可以边吃边看吗～？"},{"id":"3020003020290","name":"透","text":"オッケー\\n──小糸ちゃん","trans":"OK\\n——小糸"},{"id":"3020003020300","name":"小糸","text":"え、あ、うん……！","trans":"诶，啊，嗯……！"},{"id":"3020003020301","name":"透＆小糸","text":"右、右、右、キメ……！","trans":"右，右，右，收尾……！"},{"id":"3020003020310","name":"透","text":"右、右、右、キメ……","trans":"右，右，右，收尾……"},{"id":"3020003020320","name":"雛菜","text":"あは～ \\nこのかばん、学校で見た～","trans":"啊哈～\\n这个包，在学校有看到～"},{"id":"3020003020330","name":"小糸","text":"可愛いね……！\\n雑誌の付録って感じしないし……","trans":"好可爱……！\\n给人感觉不像是杂志附赠的……"},{"id":"3020003020340","name":"透","text":"右、右、右、キメ……","trans":"右，右，右，收尾……"},{"id":"3020003020350","name":"円香","text":"────見せて","trans":"————让我看看"},{"id":"3020003020360","name":"小糸","text":"ほら、これ\\nすごいよね……！","trans":"来，你看\\n很厉害吧……！"},{"id":"3020003020370","name":"円香","text":"ふうん……\\nでも確かにすごくかぶりそう","trans":"哼……\\n不过感觉很容易撞包"},{"id":"3020003020380","name":"透","text":"キメ……","trans":"收尾……"},{"id":"3020003020390","name":"雛菜","text":"透先輩、終わり～？","trans":"透学姐，结束了吗～？"},{"id":"3020003020400","name":"小糸","text":"と、透ちゃん\\n一緒に、やる……？","trans":"小，小透\\n要我，跟你一起吗……？"},{"id":"0000000000000","name":"ダンストレーナー","text":"１、２、３、４\\n右、右、右、キメ……！","trans":"1，2，3，4\\n右，右，右，收尾……！"},{"id":"0000000000000","name":"ダンストレーナー","text":"はい、いいでしょう……！","trans":"好，可以……！"},{"id":"3020003020410","name":"透","text":"ふー……","trans":"呼——……"},{"id":"0000000000000","name":"ダンストレーナー","text":"──とってもいい感じです\\nみなさん、なんだかレベルが上がったわね！","trans":"——感觉很不错\\n各位的等级好像都上升了一样！"},{"id":"3020003020420","name":"小糸","text":"は、はい……！","trans":"谢，谢谢……！"},{"id":"3020003020430","name":"雛菜","text":"へ～？","trans":"嘿～？"},{"id":"0000000000000","name":"円香","text":"……","trans":""},{"id":"3020003020441","name":"小糸＆雛菜","text":"────","trans":""},{"id":"3020003020450","name":"透","text":"……よしっ","trans":"……好"},{"id":"0000000000000","name":"ダンストレーナー","text":"こうやって意識を高く持って\\nレッスンに臨んでもらえたら嬉しいです","trans":"希望你们能继续保持良好的意识\\n并以这样的状态参加课程"},{"id":"3020003020460","name":"小糸","text":"は、はい……","trans":"好，好的……"},{"id":"0000000000000","name":"ダンストレーナー","text":"その調子で頑張りましょうね","trans":"请保持现状继续努力"},{"id":"3020003020461","name":"一同","text":"ありがとうございました……！","trans":"非常感谢……！"},{"id":"3020003020470","name":"透","text":"よし、行こう","trans":"好，走吧"},{"id":"3020003020480","name":"小糸","text":"……？","trans":""},{"id":"3020003020490","name":"透","text":"行こう、バッティングセンター","trans":"走吧，去击球场"},{"id":"3020003020500","name":"円香","text":"……","trans":""},{"id":"3020003020510","name":"透","text":"これで打てる","trans":"这样能打中了"},{"id":"3020003020520","name":"円香","text":"……打てるか","trans":"……能中吗"}]}