{"translator":"","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──のっ、乗ります……っ","trans":"——我，我还没上车……"},{"id":"0000000000000","name":"プロデューサー","text":"────ああ……\\n行っちゃったか…………","trans":"——啊……\\n开走了…………"},{"id":"0000000000000","name":"プロデューサー","text":"ふぅ……","trans":"呼……"},{"id":"1020001010010","name":"？？？","text":"……\\n歩いた方が早いよ","trans":"……\\n走路会比较快哦"},{"id":"0000000000000","name":"プロデューサー","text":"……え？　あ……──","trans":"……咦？　啊……——"},{"id":"1020001010020","name":"？？？","text":"駅でしょ\\nバス、あと40分くらい来ないから","trans":"去车站？\\n巴士，还有40分钟左右才会来"},{"id":"0000000000000","name":"プロデューサー","text":"……！","trans":"……！"},{"id":"0000000000000","name":"プロデューサー","text":"（綺麗な子だな……）","trans":"（好漂亮的女孩啊……）"},{"id":"0000000000000","name":"プロデューサー","text":"ありがとう\\n──40分かぁ……","trans":"谢谢\\n——40分钟啊……"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"1020001010030","name":"？？？","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"……あの、君\\n部活とかやってないの？","trans":"……那个，你\\n有参加什么社团吗？"},{"id":"1020001010040","name":"？？？","text":"──……なんで？","trans":"——……怎么这么问？"},{"id":"0000000000000","name":"プロデューサー","text":"その……\\nアイドルに興味ないかな？","trans":"就是……\\n你对偶像感兴趣吗？"},{"id":"1020001010050","name":"？？？","text":"……え？","trans":"……诶？"},{"id":"0000000000000","name":"プロデューサー","text":"いや……急にごめん\\n俺、アイドルのプロデュースやってて","trans":"不……抱歉，突然这么问\\n我现在正在培养偶像"},{"id":"0000000000000","name":"プロデューサー","text":"向いてるんじゃないかと思うんだ、君\\nこれ、名刺で──","trans":"我觉得你应该很适合做偶像\\n这是我的名片——"},{"id":"1020001010060","name":"？？？","text":"いい\\n……行くね","trans":"不用\\n……走了"},{"id":"0000000000000","name":"プロデューサー","text":"……あっ、ごめん！\\nごめん、待ってくれ！","trans":"……啊，抱歉！\\n抱歉，等一下！"},{"id":"0000000000000","name":"プロデューサー","text":"待って──","trans":"等等——"},{"id":"1020001010070","name":"？？？","text":"……しつこいよ\\nそういうのいいから","trans":"……好烦啊\\n我没兴趣"},{"id":"0000000000000","name":"プロデューサー","text":"──いや、じゃなくて……\\n俺が、行くからさ！","trans":"——没，不是……\\n我是肯定会去的！"},{"id":"0000000000000","name":"off","text":"──────","trans":"──────"},{"id":"1020001010080","name":"？？？","text":"……え？","trans":"……咦？"},{"id":"0000000000000","name":"プロデューサー","text":"急に、失礼だった\\nなんか君のことを見てつい……","trans":"抱歉，是我唐突了\\n我只是看着你就觉得……"},{"id":"0000000000000","name":"プロデューサー","text":"駅、こっちだったよな！\\n俺歩いてくから、君はバス待っててよ","trans":"车站，是这个方向吧！\\n我会走过去的，你就等巴士吧"},{"id":"0000000000000","name":"プロデューサー","text":"じゃ──","trans":"我走了——"},{"id":"1020001010090","name":"？？？","text":"……\\n──……待って","trans":"……\\n——……等等"},{"id":"1020001010100","name":"？？？","text":"待って","trans":"等等"},{"id":"0000000000000","name":"プロデューサー","text":"……っ\\nえ……っ","trans":"……\\n咦……"},{"id":"1020001010110","name":"？？？","text":"……じゃなくて、これ","trans":"……不对，看这个"},{"id":"0000000000000","name":"プロデューサー","text":"……？\\n──っ、セロハンテープ","trans":"……？\\n——胶带"},{"id":"1020001010120","name":"？？？","text":"服についてた","trans":"粘在衣服上了"},{"id":"0000000000000","name":"プロデューサー","text":"……えっ、うわっ……！\\n取ってくれたのか……","trans":"……咦，呜哇……！\\n你帮我拿下来了吗……"},{"id":"1020001010130","name":"？？？","text":"──……さっき、私もごめん\\n名刺だけもらっとく","trans":"——……刚才的事，我也要道歉\\n名片我就收下了"},{"id":"1020001010140","name":"？？？","text":"じゃあ","trans":"那我走了"},{"id":"0000000000000","name":"プロデューサー","text":"──よし、契約書もこれでOK\\nいいんだな、透","trans":"——好，合同书也搞定了\\n这样可以吧，透"},{"id":"1020001010150","name":"透","text":"うん","trans":"嗯"},{"id":"1020001010160","name":"透","text":"プロデューサー、しつこいから\\nそれに……","trans":"毕竟制作人，很烦\\n而且……"},{"id":"0000000000000","name":"プロデューサー","text":"……？","trans":"……？"},{"id":"1020001010170","name":"透","text":"ううん、なんでもない","trans":"没事"},{"id":"1020001010180","name":"透","text":"──ほら、レッスン行くよ\\nプロデューサー","trans":"——好了，去练习了\\n制作人"}]}