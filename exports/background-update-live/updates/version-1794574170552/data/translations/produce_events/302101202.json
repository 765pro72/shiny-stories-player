{"translator":"魚見","rows":[{"id":"3021012020010","name":"小糸","text":"『撮影、終了しました』","trans":"“拍摄，结束了”"},{"id":"3021012020020","name":"小糸","text":"『電車で帰宅します』","trans":"“我们坐电车回家”"},{"id":"3021012020030","name":"小糸","text":"『直帰予定です』","trans":"“打算直接回去”"},{"id":"3021012020040","name":"小糸","text":"こ、これでいいかな？","trans":"这、这样就可以了吧？"},{"id":"3021012020050","name":"透","text":"グー","trans":"Good——"},{"id":"3021012020060","name":"円香","text":"オッケー","trans":"OK——"},{"id":"3021012020070","name":"円香","text":"やば","trans":"糟"},{"id":"3021012020080","name":"円香","text":"電車、１時間後","trans":"下趟电车、要等一个钟"},{"id":"3021012020090","name":"雛菜","text":"１時間後～！？","trans":"等一个钟～！？"},{"id":"3021012020100","name":"円香","text":"各駅なら何本かあるけど\\n乗り換えだるいでしょ","trans":"转其他站倒是有几趟\\n但换乘也很累人吧"},{"id":"3021012020110","name":"透","text":"あー","trans":"啊——"},{"id":"3021012020120","name":"透","text":"待つかー","trans":"那就等吧——"},{"id":"3021012020130","name":"雛菜","text":"え～\\n何する～？","trans":"诶～\\n那干嘛呢～？"},{"id":"3021012020140","name":"小糸","text":"何、しよっか……","trans":"做、做什么好呢……"},{"id":"3021012020141","name":"一同","text":"………………","trans":""},{"id":"3021012020150","name":"円香","text":"……\\nとりあえず……","trans":"……\\n总之……"},{"id":"3021012020160","name":"円香","text":"食べ物じゃない？","trans":"先填饱肚子吧？"},{"id":"3021012020170","name":"雛菜","text":"……食べ物、ないよ～？","trans":"……没有吃的哦～？"},{"id":"3021012020180","name":"雛菜","text":"ね～、円香先輩～\\nどこ～？","trans":"哎～、圆香前辈～\\n哪有～？"},{"id":"3021012020190","name":"円香","text":"知らん","trans":"不知道"},{"id":"3021012020200","name":"小糸","text":"た、食べ物はないけど……！","trans":"虽、虽然没有吃的……！"},{"id":"3021012020210","name":"小糸","text":"見て、海だよ……！","trans":"看、是海哦……！"},{"id":"3021012020220","name":"透","text":"にゃあにゃあ\\n言ってる","trans":"在喵喵叫"},{"id":"3021012020230","name":"小糸","text":"え、猫？","trans":"诶、猫？"},{"id":"3021012020240","name":"透","text":"え、鳥\\nたぶん","trans":"诶、鸟\\n大概"},{"id":"3021012020250","name":"小糸","text":"あ、本当だ……\\nたくさんいるね！","trans":"啊、真的耶……\\n有好多呢！"},{"id":"3021012020260","name":"透","text":"魚もいるかな","trans":"也会有鱼吗"},{"id":"3021012020270","name":"小糸","text":"いるんじゃないかな……\\nあっちにあるの漁船だよね","trans":"也会有的吧……\\n那边的是渔船对吧"},{"id":"3021012020280","name":"円香","text":"漁船があるなら、\\n食堂もありそうなのに","trans":"有渔船的话，\\n感觉也会有食堂才对"},{"id":"3021012020290","name":"雛菜","text":"あった～？","trans":"有吗～？"},{"id":"3021012020300","name":"円香","text":"ない","trans":"没有"},{"id":"3021012020310","name":"円香","text":"正確にはあるけど遠い","trans":"准确来讲是，有但是很远"},{"id":"3021012020320","name":"雛菜","text":"雛菜、歩いてもいいよ～？","trans":"雏菜可以走过去哦～？"},{"id":"3021012020330","name":"円香","text":"口コミもないし、営業時間も書いてない\\nリスクが大きい","trans":"既没招牌，也没写营业时间\\n风险太高了"},{"id":"3021012020340","name":"雛菜","text":"あ～","trans":"啊～"},{"id":"3021012020350","name":"円香","text":"今日はごはん抜きで","trans":"今天就不吃了"},{"id":"3021012020360","name":"雛菜","text":"夜に１日分食べないとだね～","trans":"晚上得把一天的都吃回来呢～"},{"id":"3021012020370","name":"小糸","text":"あ……\\nそろそろ時間かも……！","trans":"啊……\\n快到时间了吧……！"},{"id":"3021012020380","name":"円香","text":"電車？\\nじゃあ戻るか","trans":"电车？\\n那回去吧"},{"id":"3021012020390","name":"雛菜","text":"円香先輩～\\nぬい、忘れてる～","trans":"圆香前辈～\\n玩偶、忘拿了～"},{"id":"3021012020400","name":"円香","text":"ああ……\\nぬいぐるみ？","trans":"啊啊……\\n玩偶？"},{"id":"3021012020410","name":"円香","text":"あげる","trans":"给你了"},{"id":"3021012020420","name":"雛菜","text":"円香先輩のだよ～？","trans":"这个是圆香前辈的喔～？"},{"id":"3021012020430","name":"円香","text":"飾る場所ないし","trans":"没地方放"},{"id":"3021012020440","name":"小糸","text":"て、手作りだって言ってたよ！","trans":"说、说是手工的哦！"},{"id":"3021012020450","name":"小糸","text":"手作りのプレゼント、だって……！","trans":"说是亲手做的礼物……！"},{"id":"3021012020460","name":"円香","text":"……え、ファンが来てたの？","trans":"……诶、有粉丝来了吗？"},{"id":"3021012020470","name":"小糸","text":"直接は会ってないけど……\\nスタッフさんに渡してくれたみたい","trans":"虽然没直接见到人……\\n好像是拜托工作人员送来的"},{"id":"3021012020480","name":"円香","text":"……酔狂","trans":"……一时兴起"},{"id":"3021012020490","name":"小糸","text":"あ、あと……\\n『一緒に並べて置いてほしい』って言ってたって","trans":"还、还有……\\n说是“希望能摆在一起”"},{"id":"3021012020500","name":"円香","text":"……各人で持ち帰ったらバラバラになるけど","trans":"……各自带各自的回去不就分开了"},{"id":"3021012020510","name":"雛菜","text":"あ～\\nじゃあ、透先輩のところに置く～？","trans":"啊～\\n那就放到透前辈家～？"},{"id":"3021012020520","name":"透","text":"ん","trans":"嗯"},{"id":"3021012020530","name":"円香","text":"どこでもいい","trans":"放哪都行"},{"id":"3021012020540","name":"雛菜","text":"それか事務所とか～？","trans":"还是说事务所之类的～？"},{"id":"3021012020550","name":"小糸","text":"お、置く場所もらえるかな……？","trans":"会、会有地方放吗……？"},{"id":"3021012020560","name":"小糸","text":"い、今の……","trans":"刚、刚才的……"},{"id":"3021012020570","name":"小糸","text":"乗るはずの急行……だったよね……？","trans":"是我们本来要坐的……那趟对吧……？"},{"id":"3021012020580","name":"円香","text":"…………","trans":""},{"id":"3021012020590","name":"透","text":"次は？","trans":"下一趟是？"},{"id":"3021012020600","name":"円香","text":"……２時間後","trans":"……两个钟后"},{"id":"3021012020610","name":"雛菜","text":"２時間後～～～！？","trans":"两个钟后～～～！？"},{"id":"3021012020611","name":"一同","text":"………………","trans":""},{"id":"3021012020620","name":"円香","text":"……さすがにちょっと","trans":"……这再怎么说也有点"},{"id":"3021012020630","name":"円香","text":"ポンコツすぎる","trans":"蠢过头了"}]}