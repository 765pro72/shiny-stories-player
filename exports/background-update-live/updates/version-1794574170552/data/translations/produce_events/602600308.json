{"translator":"煉金術式","rows":[{"id":"6026003080010","name":"ルカ","text":"────なァ","trans":"────喂"},{"id":"0000000000000","name":"プロデューサー","text":"っ、え……！？","trans":"啊，什么……！？"},{"id":"6026003080020","name":"ルカ","text":"……何、その反応","trans":"……你这什么反应"},{"id":"0000000000000","name":"プロデューサー","text":"いや、すまん──！\\nルカから声をかけてくれることって少ないから──","trans":"不，不好意思──！\\n因为路加很少主动找我──"},{"id":"6026003080030","name":"ルカ","text":"……","trans":""},{"id":"6026003080040","name":"ルカ","text":"話になんねェな","trans":"真是没话说"},{"id":"6026003080050","name":"ルカ","text":"一緒に進みたいんじゃねぇのかよ","trans":"不是你说要跟我一起前进么"},{"id":"0000000000000","name":"プロデューサー","text":"待ってくれ、悪かった……！\\n用件はちゃんと聞くから──あ、でもその前に！","trans":"等一下，对不起……！\\n再给我一次机会──啊，不过在那之前！"},{"id":"6026003080060","name":"ルカ","text":"？","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"おめでとう、ルカ！","trans":"恭喜你，路加！"},{"id":"6026003080070","name":"ルカ","text":"…………","trans":""},{"id":"6026003080080","name":"ルカ","text":"……うざ","trans":"……烦人"}]}