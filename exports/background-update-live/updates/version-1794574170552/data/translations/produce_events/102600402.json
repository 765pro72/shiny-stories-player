{"translator":"煉金術式","rows":[{"id":"0000000000000","name":"off","text":"────","trans":"————"},{"id":"0000000000000","name":"off","text":"…………","trans":"…………"},{"id":"0000000000000","name":"off","text":"────…………","trans":"————…………"},{"id":"1026004020010","name":"ルカ","text":"……っ","trans":"……"},{"id":"1026004020020","name":"ルカ","text":"視線","trans":"视线"},{"id":"1026004020030","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"スタッフ","text":"再開しまーす！\\n斑鳩さん、スタンバイお願いしまーす！","trans":"准备继续了！\\n斑鸠小姐，麻烦就位！"},{"id":"1026004020040","name":"ルカ","text":"──","trans":"——"},{"id":"1026004020050","name":"ルカ","text":"ああ……","trans":"好……"},{"id":"1026004020060","name":"ルカ","text":"狙うような","trans":"被谁盯着"},{"id":"1026004020070","name":"ルカ","text":"……！","trans":"……！"},{"id":"0000000000000","name":"スタッフ","text":"……？\\n斑鳩さん？　どうかされました？","trans":"……？\\n斑鸠小姐？怎么了吗？"},{"id":"1026004020080","name":"ルカ","text":"──","trans":"——"},{"id":"1026004020090","name":"ルカ","text":"……悪い\\nなんでもない","trans":"不好意思\\n没什么"},{"id":"1026004020100","name":"ルカ","text":"……こっち？","trans":"……这里？"},{"id":"0000000000000","name":"スタッフ","text":"はい！","trans":"没问题！"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ、今日はどうだった？","trans":"路加，今天感觉怎么样？"},{"id":"0000000000000","name":"プロデューサー","text":"これからも街ブラ企画の仕事って\\n受けて平気そうかな","trans":"之后还有个游街节目\\n你愿意接吗？"},{"id":"1026004020110","name":"ルカ","text":"…………","trans":"…………"},{"id":"1026004020120","name":"ルカ","text":"────誰かに見られてる気がする","trans":"————被人注视的异样感"},{"id":"1026004020130","name":"ルカ","text":"ワンマンの発表をした頃からずっと","trans":"自从公布个人巡演就从未平息"},{"id":"1026004020140","name":"ルカ","text":"ファンの熱心な視線でも、\\nミーハーなヤツらの好奇心の塊みたいな視線でもない","trans":"既不像粉丝热情的关注\\n也不像狂热追随者的注视"},{"id":"1026004020150","name":"ルカ","text":"もっと──何かを探るような\\nこちらのボロを狙うような","trans":"而是像在——追根究底、紧逼着\\n寻找我的破绽"},{"id":"1026004020160","name":"ルカ","text":"そんな、嫌な視線が","trans":"这种、恶心的视线"},{"id":"1026004020170","name":"ルカ","text":"（──────最近ずっと、まとわりついてる）","trans":"（——————最近一直没法摆脱）"},{"id":"1026004020180","name":"ルカ","text":"（……って、言うって？）","trans":"（……让我说出口？）"},{"id":"1026004020190","name":"ルカ","text":"……ありえないだろ","trans":"……绝对不可能"},{"id":"0000000000000","name":"プロデューサー","text":"え！？\\n何かまずかったか！？　街ブラ──","trans":"欸！？\\n路加原来这么讨厌游街——"},{"id":"1026004020200","name":"ルカ","text":"は──、……","trans":"哈——……"},{"id":"1026004020210","name":"ルカ","text":"……それは問題ない","trans":"……接吧，那边没问题"},{"id":"0000000000000","name":"プロデューサー","text":"そうか、よかった……！","trans":"这样啊，那太好了……！"},{"id":"0000000000000","name":"プロデューサー","text":"えっと……\\nじゃあ、ありえないっていうのは──","trans":"嗯……\\n那你刚才说绝对不可能是——"},{"id":"1026004020220","name":"ルカ","text":"……関係ねェよ","trans":"……跟你没关系"},{"id":"0000000000000","name":"プロデューサー","text":"了解……！","trans":"了解……！"},{"id":"1026004020230","name":"ルカ","text":"……","trans":"……"},{"id":"1026004020240","name":"ルカ","text":"下手に騒いで","trans":"惹来不必要的麻烦"},{"id":"1026004020250","name":"ルカ","text":"ケチがつくなんてありえない","trans":"被人揪出弱点——绝不可能"},{"id":"1026004020260","name":"ルカ","text":"（…………大事なライブだろ）","trans":"（…………这么重要的演出）"},{"id":"1026004020270","name":"ルカ","text":"（……誰かが絡んでこようが、無視すりゃいい）","trans":"（……不管谁来纠缠，都该无视掉）"},{"id":"1026004020280","name":"ルカ","text":"（私が気をつければ問題ない）","trans":"（加点小心就行了）"},{"id":"1026004020290","name":"ルカ","text":"（──まだ\\nそういうレベルだ）","trans":"（——总归不过是低级把戏）"},{"id":"0000000000000","name":"プロデューサー","text":"……ルカ？","trans":"……路加？"},{"id":"1026004020300","name":"ルカ","text":"あ……？","trans":"啊……？"},{"id":"0000000000000","name":"プロデューサー","text":"──何かあったら、教えてくれよ？","trans":"——要是有什么心事，一定要告诉我哦？"},{"id":"1026004020310","name":"ルカ","text":"…………","trans":"…………"},{"id":"1026004020320","name":"ルカ","text":"何もない","trans":"没什么"},{"id":"1026004020330","name":"ルカ","text":"……けど、わかった","trans":"……不过，我记下了"},{"id":"0000000000000","name":"プロデューサー","text":"おう……！","trans":"好……！"}]}