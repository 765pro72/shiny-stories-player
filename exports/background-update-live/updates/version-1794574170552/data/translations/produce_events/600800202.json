{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"6008002020010","name":"霧子","text":"ふぅ……ふぅ……\r\n──","trans":"呼……呼……\n──","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-1","name":"プロデューサー","text":"お疲れ、霧子","trans":"辛苦了，雾子","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020020","name":"霧子","text":"は、はい……！\r\nお疲れ様です……！","trans":"是，是的……！\n您辛苦了……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-3","name":"プロデューサー","text":"よく動けてたぞ","trans":"你动得很不错哦","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020030","name":"霧子","text":"ありがとう……ございます……\r\nふふっ……","trans":"谢……谢您……\n呵呵……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-5","name":"プロデューサー","text":"手応えありか？","trans":"有手感了吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020040","name":"霧子","text":"……は、はい……\r\nいえ……","trans":"……是，是的……\n不……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020050","name":"霧子","text":"やっぱり……みんなでお仕事……\r\n楽しいな……って……","trans":"果然……大家一起工作……\n很开心……这样……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020060","name":"霧子","text":"プロデューサーさん……\r\n……何があっても……","trans":"制作人……\n……不管发生什么……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020070","name":"霧子","text":"見守ってて……ください……","trans":"请您……守护着我们……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020080","name":"霧子","text":"わたしたちが揃ったら……\r\nきっと…………","trans":"我们凑齐的话……\n一定…………","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"6008002020090","name":"霧子","text":"最強なんです……","trans":"是最强的……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}