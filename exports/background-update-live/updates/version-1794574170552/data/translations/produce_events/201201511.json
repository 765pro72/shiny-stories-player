{"translator":"阿柚","rows":[{"id":"2012015110010","name":"凛世","text":"────問い３……\\nＡ……","trans":"────第3题……\\nＡ……"},{"id":"2012015110020","name":"凛世","text":"────問い４……\\nロココ様式……","trans":"────第4题……\\n洛可可风格……"},{"id":"0000000000000","name":"試験監督教諭","text":"────はい、じゃあ鉛筆置いて","trans":"────好了，都把鉛筆放下"},{"id":"0000000000000","name":"試験監督教諭","text":"答案、後ろの席から回収ー","trans":"把答卷从后面往前传──"},{"id":"2012015110030","name":"凛世","text":"……","trans":"……"},{"id":"0000000000000","name":"クラスメイト１","text":"杜野さん、答案もらっていき────\\n────ふっ……","trans":"杜野同学，我来收答────\\n────哈哈……"},{"id":"2012015110040","name":"凛世","text":"……\\nは、はい……あの……","trans":"……\\n好，好的……那个……"},{"id":"0000000000000","name":"クラスメイト１","text":"すっごい、帰る準備早くない？\\n……ふふふっ","trans":"真快啊，你这就做好回去的准备了吗？\\n……哈哈哈"},{"id":"2012015110050","name":"凛世","text":"……！\\nはい……待ちかねており……","trans":"……！\\n是的……确实等不及了……"},{"id":"2012015110060","name":"凛世","text":"こちら……\\nよろしく……お願いいたします……！","trans":"这个……\\n就拜托你……交上去了……！"},{"id":"0000000000000","name":"クラスメイト１","text":"うわっ、はいー\\n……お疲れ様ー！","trans":"呜哇，好的\\n……辛苦了ー！"},{"id":"2012015110070","name":"凛世","text":"はい……！","trans":"嗯……！"},{"id":"0000000000000","name":"友人１","text":"あーっ\\nもりちゃんバイバーイ","trans":"啊\\n小杜拜拜"},{"id":"0000000000000","name":"友人２","text":"くっそ走ってる～","trans":"跑得好欢～"},{"id":"2012015110080","name":"凛世","text":"はい……急ぐのです……\\nごきげんよう……！","trans":"嗯……因为挺急的……\\n你俩保重……！"},{"id":"0000000000000","name":"別クラス担任","text":"コラ、杜野さんー\\n廊下走らない！","trans":"喂，杜野同学ー\\n别在走廊上奔跑！"},{"id":"2012015110090","name":"凛世","text":"……っ\\n申し訳……ございません……","trans":"……啊\\n非常抱歉……"},{"id":"0000000000000","name":"友人１","text":"あはっ、じゃーねー！","trans":"啊哈，再见ー！"},{"id":"2012015110100","name":"凛世","text":"ふ…………────","trans":"呼…………────"},{"id":"2012015110110","name":"凛世","text":"────終わった……","trans":"────都结束了……"},{"id":"2012015110120","name":"凛世","text":"……始まる──────！","trans":"……要开始了──────！"},{"id":"0000000000000","name":"プロデューサー","text":"……────","trans":"……────"},{"id":"0000000000000","name":"プロデューサー","text":"────よし、と\\nふっ……","trans":"────好嘞\\n呼……"},{"id":"2012015110130","name":"凛世","text":"────……","trans":"────……"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……\\nよく晴れてるな","trans":"啊……\\n真是个好天气啊"},{"id":"0000000000000","name":"フラワーショップ店長","text":"────あ、いらっしゃい","trans":"────啊，欢迎光临"},{"id":"0000000000000","name":"フラワーショップ店長","text":"ご予約の花ね？\\n入ってますよー","trans":"预约的花吗？\\n已经到了哦ー"},{"id":"2012015110140","name":"凛世","text":"はい……\\nふふっ……","trans":"好的……\\n哼哼……"},{"id":"0000000000000","name":"プロデューサー","text":"────そろそろ凛世、終わってるか","trans":"────凛世差不多，也该考完了啊"},{"id":"2012015110150","name":"凛世","text":"……\\n……っ……","trans":"……\\n……呼……"},{"id":"2012015110160","name":"凛世","text":"────……\\nよい……香り……","trans":"────……\\n好香………"},{"id":"0000000000000","name":"プロデューサー","text":"────ああ……","trans":"────啊……"},{"id":"0000000000000","name":"プロデューサー","text":"あったかいなぁ……","trans":"真暖和啊……"},{"id":"2012015110170","name":"凛世","text":"……っ……\\n…………っ……","trans":"……呼……\\n…………呼……"},{"id":"2012015110180","name":"凛世","text":"……あ────","trans":"……啊────"},{"id":"0000000000000","name":"プロデューサー","text":"あ","trans":"啊"},{"id":"0000000000000","name":"プロデューサー","text":"……花の匂い────","trans":"……花的香气────"},{"id":"2012015110190","name":"凛世","text":"────プロデューサーさま……！","trans":"────制作人殿下……！"},{"id":"0000000000000","name":"プロデューサー","text":"……！\\n凛世────","trans":"……！\\n凛世────"},{"id":"0000000000000","name":"プロデューサー","text":"────と、春","trans":"────还有，春天"},{"id":"2012015110200","name":"凛世","text":"はい────！","trans":"嗯────！"},{"id":"2012015110210","name":"凛世","text":"戻りました……！","trans":"我回来了……！"},{"id":"0000000000000","name":"プロデューサー","text":"……おう！\\n上がってくれ","trans":"……嗯！\\n快上来吧"},{"id":"0000000000000","name":"プロデューサー","text":"春がきたみたいだ","trans":"就像是春天来了一样啊"}]}