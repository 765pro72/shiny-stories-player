{"translator":"nono","rows":[{"id":"3015014020010","name":"甜花","text":"なーちゃん……！","trans":"小奈……！"},{"id":"3015014020020","name":"甜花","text":"ご、ごめんね……！","trans":"抱、抱歉……！"},{"id":"3015014020030","name":"甜花","text":"掃除、思ったより……\\n長くなっちゃって……","trans":"课后值日，比我想的……\\n要花时间……"},{"id":"3015014020040","name":"甘奈","text":"ううん、全然大丈夫☆","trans":"没事，完全没问题☆"},{"id":"3015014020050","name":"甘奈","text":"でも、\\nちょっと急がなきゃかも……！","trans":"但是，\\n可能时间会有一些赶……！"},{"id":"3015014020060","name":"甘奈","text":"さっき、仕事終わって向かってるって\\n千雪さんから連絡来てたから！","trans":"刚才，千雪说工作结束了\\n正在过去的路上！"},{"id":"3015014020070","name":"甜花","text":"わ、うん……！","trans":"哇，嗯……！"},{"id":"3015014020080","name":"甜花","text":"え、と……\\n手袋、手袋────","trans":"那个……\\n手套，手套────"},{"id":"3015014020090","name":"甜花","text":"あぅ……\\nさ、さむ……！","trans":"啊呜……\\n好、好冷……！"},{"id":"3015014020100","name":"甘奈","text":"甜花ちゃん、大丈夫……！？","trans":"甜花，没事吧……！？"},{"id":"3015014020110","name":"甘奈","text":"こうやって──\\nおっきく動くと暖かくなるよ！","trans":"像这样──\\n运动起来的话会变暖哦！"},{"id":"3015014020120","name":"甜花","text":"う、うん……","trans":"嗯，嗯呜……"},{"id":"3015014020130","name":"甜花","text":"わかってる……\\nけど……","trans":"我知道……\\n但是……"},{"id":"3015014020140","name":"甜花","text":"動けない……","trans":"动不起来……"},{"id":"3015014020150","name":"甘奈","text":"──わ、千雪さんもう着いたって！","trans":"──哦，千雪已经倒了！"},{"id":"3015014020160","name":"甘奈","text":"打ち合わせ、\\nちょっと遅れそうって連絡入れとく……？","trans":"要说一声，\\n商谈要迟到一会儿吗……？"},{"id":"3015014020170","name":"甜花","text":"そ、そだね……","trans":"是、是的呢……"},{"id":"3015014020180","name":"甜花","text":"──あ……","trans":"──啊……"},{"id":"3015014020190","name":"甘奈","text":"……？","trans":""},{"id":"3015014020200","name":"甜花","text":"なーちゃん……\\nこれ────","trans":"小奈……\\n你看────"},{"id":"3015014020210","name":"甜花","text":"上、見て……！","trans":"看看，上面……！"},{"id":"3015014020220","name":"甘奈","text":"え──\\n雪……！？","trans":"诶──\\n下雪了……！？"},{"id":"3015014020230","name":"甜花","text":"う、うん……！\\n雪、だよね……！","trans":"嗯、嗯……！\\n是，下雪了呢……！"},{"id":"3015014020231","name":"甘奈＆甜花","text":"…………","trans":""},{"id":"3015014020240","name":"甘奈","text":"…………なんか────","trans":"…………感觉────"},{"id":"3015014020250","name":"甜花","text":"──お、思い出すね……！\\nちっちゃい時……！","trans":"──会、会想起来呢……！\\n小时候……！"},{"id":"3015014020260","name":"甘奈","text":"だよね……！？","trans":"是啊……！？"},{"id":"3015014020270","name":"甘奈","text":"ちっちゃい時、は──","trans":"小时候──"},{"id":"3015014020280","name":"甘奈","text":"雪ってだけで楽しくって、\\nはしゃいじゃったよね……！","trans":"光是看到下雪就开心得，\\n跑来跑去的……！"},{"id":"3015014020290","name":"甜花","text":"う、うん……！","trans":"嗯、嗯……！"},{"id":"3015014020300","name":"甘奈","text":"懐かしいなぁ……！","trans":"真怀念……！"},{"id":"3015014020310","name":"甘奈","text":"…………！","trans":""},{"id":"3015014020320","name":"甜花","text":"…………","trans":""},{"id":"3015014020330","name":"甜花","text":"──わーっ……────！","trans":"──哇……────！"},{"id":"3015014020340","name":"甘奈","text":"……！","trans":""},{"id":"3015014020350","name":"甘奈","text":"て、甜花ちゃん……！？","trans":"甜、甜花……！？"},{"id":"3015014020360","name":"甘奈","text":"……──","trans":""},{"id":"3015014020370","name":"甘奈","text":"わーっ……────！","trans":"哇……────！"},{"id":"3015014020380","name":"甜花","text":"わ……！\\nなーちゃん……！","trans":"哇……！\\n小奈……！"},{"id":"3015014020390","name":"甘奈","text":"えへへっ……！","trans":"诶嘿嘿……！"},{"id":"3015014020391","name":"甘奈＆甜花","text":"わーーーーっ…………！","trans":"哇────────っ…………！"},{"id":"3015014020400","name":"甘奈","text":"……はあっ……！","trans":"……哈……！"},{"id":"3015014020410","name":"甘奈","text":"……もーっ、甜花ちゃん！","trans":"……真是的，甜花！"},{"id":"3015014020420","name":"甘奈","text":"さっき、\\n動けないって言ってたのに～","trans":"刚才还说，\\n动不起来的～"},{"id":"3015014020430","name":"甜花","text":"う、うん……","trans":"啊、嗯……"},{"id":"3015014020440","name":"甜花","text":"けど……なんか……！\\nにへへ……","trans":"但是……感觉……！\\n欸嘿嘿……"},{"id":"3015014020450","name":"甘奈","text":"──そうだ！","trans":"──对了！"},{"id":"3015014020460","name":"甘奈","text":"ね！\\nこのまま事務所まで、競争しない？","trans":"要不！\\n就这样比赛看谁先到事务所，怎么样？"},{"id":"3015014020470","name":"甘奈","text":"そしたら、\\n打ち合わせにも間に合うかも！","trans":"这样的话，\\n商谈可能也不会迟到！"},{"id":"3015014020480","name":"甜花","text":"え……！","trans":"诶……！"},{"id":"3015014020490","name":"甜花","text":"で、でも……\\nそれは……絶対負ける……","trans":"但、但是……\\n这个……绝对赢不了……"},{"id":"3015014020500","name":"甘奈","text":"えーっ？\\nそんなことないよ～！","trans":"诶？\\n才没有这种事呢～！"},{"id":"3015014020501","name":"甘奈＆甜花","text":"えへへ……！","trans":"欸嘿嘿……！"}]}