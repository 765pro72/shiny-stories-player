{"translator":"魚見","rows":[{"id":"3020012010010","name":"透","text":"────\\nふぁ……","trans":"————\\n呼啊……"},{"id":"3020012010020","name":"透","text":"あー……","trans":"啊——……"},{"id":"3020012010030","name":"雛菜","text":"なんか部屋、暑いね～","trans":"总感觉屋子里好热呢~"},{"id":"3020012010040","name":"小糸","text":"う、うん……\\n言われてみれば……","trans":"嗯、嗯……\\n这么一说确实是……"},{"id":"3020012010050","name":"雛菜","text":"透先輩、エアコン入れとく～？","trans":"透前辈，开空调吗～？"},{"id":"3020012010060","name":"透","text":"んー","trans":"嗯——"},{"id":"3020012010070","name":"円香","text":"そういえばアイス\\n……買ったの忘れてた","trans":"说起来都忘了\\n……买了有冰淇淋"},{"id":"3020012010080","name":"透","text":"あー","trans":"啊——"},{"id":"3020012010090","name":"透","text":"イエス","trans":"YES"},{"id":"3020012010100","name":"雛菜","text":"雛菜、南国フルーツ味～","trans":"雏菜要，南国水果风味～"},{"id":"3020012010110","name":"小糸","text":"わ、わたしは……\\nえっと……！","trans":"我、我要……\\n嗯嗯……！"},{"id":"3020012010120","name":"雛菜","text":"透先輩\\n何味～？","trans":"透前辈的\\n是什么味～？"},{"id":"3020012010130","name":"透","text":"……んー","trans":"……嗯——"},{"id":"3020012010140","name":"透","text":"ヨーグルト？\\n味","trans":"酸奶？\\n味"},{"id":"3020012010150","name":"雛菜","text":"そうなんだ～","trans":"这样啊～"},{"id":"3020012010160","name":"小糸","text":"ほ、ホワイトサワー……！","trans":"乳、乳酸菌气泡……！"},{"id":"3020012010170","name":"透","text":"え？","trans":"诶？"},{"id":"3020012010180","name":"小糸","text":"そ、そう書いてあるよ\\n袋に……！","trans":"这、这么写着哦\\n包装上……！"},{"id":"3020012010190","name":"透","text":"ホワイトサワー","trans":"乳酸菌气泡"},{"id":"3020012010200","name":"透","text":"味","trans":"味"},{"id":"3020012010210","name":"雛菜","text":"……あは～","trans":"……啊哈～"},{"id":"3020012010220","name":"雛菜","text":"……ね、今ってもう夏？","trans":"……嗳、现在已经是夏天了？"},{"id":"3020012010230","name":"小糸","text":"う、うん……\\nもうちょっとで夏休みだね……！","trans":"嗯、嗯……\\n很快就要放暑假了呢……！"},{"id":"3020012010240","name":"小糸","text":"その前に\\nちょっと大変な撮影があるけど……","trans":"不过在那之前\\n有个比较麻烦的拍摄……"},{"id":"3020012010250","name":"透","text":"え","trans":"诶"},{"id":"3020012010260","name":"円香","text":"……スケボー？","trans":"……滑板？"},{"id":"3020012010270","name":"透","text":"あー","trans":"啊——"},{"id":"3020012010280","name":"雛菜","text":"来週だっけ～？","trans":"下周来着～？"},{"id":"3020012010290","name":"小糸","text":"う、うん……！","trans":"嗯、嗯……！"},{"id":"3020012010300","name":"透","text":"…………","trans":""},{"id":"0000000000000","name":"メイクスタッフ","text":"浅倉ちゃーん\\n夏休みも忙しいのー？","trans":"浅仓妹妹\\n暑假也很忙吗——？"},{"id":"3020012010310","name":"透","text":"んー、うん\\nわりと","trans":"嗯——、嗯\\n还挺"},{"id":"0000000000000","name":"メイクスタッフ","text":"浅倉ちゃんって何座？","trans":"浅仓妹妹什么星座的？"},{"id":"3020012010320","name":"透","text":"え……\\n牡牛座？","trans":"诶……\\n金牛座？"},{"id":"0000000000000","name":"メイクスタッフ","text":"そんな浅倉ちゃんに……\\nえーっと、牡牛座の夏は──────","trans":"金牛座的浅仓妹妹……\\n让我看看，你的夏天会是————"},{"id":"0000000000000","name":"メイクスタッフ","text":"おっ！\\n浅倉ちゃん……当たり！","trans":"噢！\\n浅仓妹妹……中大奖！"},{"id":"3020012010330","name":"透","text":"え？","trans":"诶？"},{"id":"0000000000000","name":"メイクスタッフ","text":"『１位・牡牛座　チャレンジの夏！\\nコツコツと小さな積み重ねが吉となる』だって","trans":"“第1名・金牛座　充满挑战之夏！\\n踏踏实实积累出的成果会成为你的幸运”"},{"id":"0000000000000","name":"メイクスタッフ","text":"イケイケだねー\\n今年の夏は","trans":"积极向前呢——\\n今年夏天"},{"id":"3020012010340","name":"透","text":"おー","trans":"噢——"},{"id":"3020012010350","name":"小糸","text":"当たりだって\\n透ちゃん……！","trans":"中奖了\\n透……！"},{"id":"3020012010360","name":"透","text":"……え？","trans":"……诶？"},{"id":"3020012010370","name":"小糸","text":"と、透ちゃんのアイス……！\\n当たりって書いてあるよ","trans":"透、透的冰淇淋……！\\n上面写着中奖了"},{"id":"3020012010380","name":"透","text":"え\\n……おー","trans":"诶\\n……噢——"},{"id":"3020012010390","name":"雛菜","text":"やは～\\n透先輩、すごい～！","trans":"呀哈～\\n透前辈，好厉害～！"},{"id":"3020012010400","name":"雛菜","text":"『アタリが出たら素敵な夏の予感！』\\n……だって～！","trans":"“中奖便是开启美妙的夏天的预感！”\\n……这么写着～！"},{"id":"3020012010410","name":"透","text":"やばい","trans":"不得了"},{"id":"3020012010420","name":"小糸","text":"い、いいことあるといいね\\n透ちゃん……！","trans":"希、希望能发生些好事呢\\n透……！"},{"id":"3020012010430","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3020012010440","name":"透","text":"んー","trans":"嗯——"},{"id":"3020012010450","name":"透","text":"交換できるかな\\nこれ","trans":"能交换吗\\n这个"},{"id":"3020012010460","name":"透","text":"アイス\\nもう１個","trans":"冰淇淋\\n再来一根"},{"id":"3020012010470","name":"小糸","text":"え、えっと……\\nどうかな……？","trans":"嗯、嗯……\\n能不能呢……？"},{"id":"3020012010480","name":"円香","text":"できるんじゃない？","trans":"可以的吧？"},{"id":"3020012010490","name":"円香","text":"知らないけど","trans":"我也不清楚就是了"},{"id":"3020012010500","name":"小糸","text":"そ、そうだよね……！","trans":"也、也是呢……！"},{"id":"3020012010510","name":"透","text":"イエー","trans":"耶——"},{"id":"3020012010520","name":"雛菜","text":"あは～\\nそしたらまた当たるかな～？","trans":"啊哈～\\n那会不会再中一次呢～？"},{"id":"3020012010530","name":"透","text":"ふふっ\\nおー","trans":"呵呵\\n噢——"},{"id":"3020012010540","name":"透","text":"じゃ\\n当てにいくか","trans":"那\\n再去中一次吧"},{"id":"3020012010550","name":"透","text":"『素敵な夏』","trans":"“美妙的夏天”"}]}