{"translator":"","rows":[{"id":"3014014020010","name":"甜花","text":"……","trans":""},{"id":"3014014020020","name":"甘奈","text":"甜花ちゃーん……\\nおはよ～……","trans":"甜花……\\n早上好～"},{"id":"3014014020030","name":"甜花","text":"…………","trans":""},{"id":"3014014020040","name":"甘奈","text":"……","trans":""},{"id":"3014014020050","name":"甘奈","text":"（えへへ……やっぱり幸せそう……）","trans":"（诶嘿嘿……果然还是一脸幸福的样子）"},{"id":"3014014020060","name":"甘奈","text":"（……なんだけど、今日は……！）","trans":"（……但是，今天是……！）"},{"id":"0000000000000","name":"パパ","text":"そうだ、甘奈。出張に行ってる間\\nうちでお泊り会とかしてもいいぞ？","trans":"对了，甘奈在我出差的期间\\n在家里弄个留宿会也可以哦"},{"id":"3014014020070","name":"甘奈","text":"本当！？","trans":"真的吗！？"},{"id":"0000000000000","name":"ママ","text":"普段お世話になってるんだし\\n千雪さんとか呼んでね","trans":"毕竟平时就受到了很多的关照\\n把千雪叫过来玩吧"},{"id":"3014014020080","name":"甘奈","text":"えへへ、やったぁ☆","trans":"诶嘿嘿、太好了☆"},{"id":"3014014020090","name":"甘奈","text":"甜花ちゃーん……\\n起きないとだよ～……","trans":"甜花酱……\\n要起床了哦～……"},{"id":"3014014020100","name":"甜花","text":"……","trans":""},{"id":"3014014020110","name":"甘奈","text":"……","trans":""},{"id":"3014014020120","name":"甘奈","text":"（なるべく優しく……）","trans":"（尽量温柔地……）"},{"id":"3014014020130","name":"甘奈","text":"……甜花ちゃーん……\\n朝ですよ～……","trans":"……甜花……\\n已经是早上了哦～……"},{"id":"3014014020140","name":"甘奈","text":"そろそろ起きないと～……\\nダメだよ～……","trans":"不早点起床的话\\n是不行的哦～……"},{"id":"3014014020150","name":"甜花","text":"…………","trans":""},{"id":"3014014020160","name":"甘奈","text":"（起きないなぁ～……）","trans":"（还是叫不醒呢～……）"},{"id":"3014014020170","name":"甜花","text":"あ……\\nデビ太郎────","trans":"啊……\\n恶魔太郎────"},{"id":"3014014020180","name":"甘奈","text":"……？\\nデビ太郎……？","trans":"……？\\n恶魔太郎……？"},{"id":"3014014020190","name":"甘奈","text":"！　そうだ……！","trans":"对了……！甜花……！\\n起床了～……！"},{"id":"3014014020200","name":"甘奈","text":"甜花ちゃーん……！\\n起きて～……！","trans":"甜花——……！\n起床啦～……！"},{"id":"3014014020210","name":"甘奈","text":"デビ太郎が寂しいって～……！","trans":"恶魔太郎说他很寂寞哦～……！"},{"id":"3014014020220","name":"甜花","text":"…………んん……","trans":"…………嗯…………"},{"id":"3014014020230","name":"甘奈","text":"……！","trans":""},{"id":"3014014020240","name":"甘奈","text":"起きてくれないと～……\\n拗ねちゃうぞ～……！　って……！","trans":"他说，不起来的话～……\\n要闹变扭了～……！"},{"id":"3014014020250","name":"甜花","text":"……ん…………？","trans":"……嗯…………？"},{"id":"3014014020260","name":"甜花","text":"……あれ……\\nなーちゃん…………","trans":"……咦？……\\n小奈…………"},{"id":"3014014020270","name":"甘奈","text":"おはよう、甜花ちゃん","trans":"早上好，甜花"},{"id":"3014014020280","name":"甜花","text":"……今……\\n何時…………？","trans":"……现在……\\n几点了…………？"},{"id":"3014014020290","name":"甘奈","text":"10時くらいだよ～","trans":"10点左右了哦～"},{"id":"3014014020300","name":"甜花","text":"……にへへ、そっか……\\nじゃあ、まだ寝られ──","trans":"呢嘿嘿……这样啊……\\n那么，还可以继续睡──"},{"id":"3014014020310","name":"甘奈","text":"──ストーップ……！","trans":"──STOP……！"},{"id":"3014014020320","name":"甜花","text":"…………？","trans":""},{"id":"3014014020330","name":"甘奈","text":"今日は大事な日でしょ～！","trans":"今天是重要的日子吧～！"},{"id":"3014014020340","name":"甜花","text":"……大事な日……？","trans":"……重要的日子……？"},{"id":"3014014020350","name":"","text":"…………","trans":""},{"id":"0000000000000","name":"甜花","text":"はっっ……！！","trans":"哇啊……！！"},{"id":"3014014020360","name":"甜花","text":"──す、すぐ……！\\n着替えるね……！","trans":"──马、马上……！\\n换好衣服……！"},{"id":"3014014020370","name":"甜花","text":"……にへへ……","trans":"……呢嘿嘿……"},{"id":"3014014020380","name":"甜花","text":"お菓子……\\nいっぱい、だね……！","trans":"有很多点心啊……！"},{"id":"3014014020390","name":"甘奈","text":"甜花ちゃーん\\n材料を買うのが先だよ～","trans":"甜花\\n要先买材料哦～"},{"id":"3014014020400","name":"甜花","text":"そ、そうだった、ね……！","trans":"对，对哦……！"},{"id":"3014014020410","name":"甜花","text":"……えと……\\nなーちゃん……今日は、何作るの……？","trans":"诶……\\n小奈……今天要做什么呢……？"},{"id":"3014014020420","name":"甘奈","text":"千雪さんの\\n好きなクッキーっ☆","trans":"千雪姐喜欢的曲奇☆"},{"id":"3014014020430","name":"甜花","text":"クッキー……！","trans":"曲奇……！"},{"id":"3014014020440","name":"甜花","text":"甜花……\\n色んな味の……食べたいな……！","trans":"甜花……\\n想吃各种各样口味的曲奇……！"},{"id":"3014014020450","name":"甘奈","text":"えへへ\\nたくさん作ろうね～","trans":"诶嘿嘿\\n那就做多一点吧～"},{"id":"3014014020460","name":"千雪","text":"（耳をつけて……）","trans":"（加上耳朵……）"},{"id":"3014014020470","name":"千雪","text":"（口を描いたら……）","trans":"（画上嘴巴）"},{"id":"3014014020480","name":"千雪","text":"……ふふっ\\n可愛い兄弟、できちゃった","trans":"……呵呵\n可爱的姐妹，诞生了呢"},{"id":"3014014020490","name":"千雪","text":"（しっかり冷やして……）","trans":"（呼呼……可爱的兄弟，完成）"},{"id":"3014014020500","name":"千雪","text":"楽しみだなぁ……！","trans":"真是期待呢……！"}]}