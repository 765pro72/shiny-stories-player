{"translator":"告","rows":[{"id":"3021003020010","name":"透","text":"じゃ\\n行ってくる","trans":"那\\n走了"},{"id":"3021003020020","name":"円香","text":"はいはい","trans":"好好好"},{"id":"3021003020030","name":"小糸","text":"す、すぐ戻ってくるね……！","trans":"马，马上回来……！"},{"id":"3021003020040","name":"小糸","text":"あ……\\n円香ちゃん、雛菜ちゃん","trans":"啊……\\n圆香，雏菜"},{"id":"3021003020050","name":"小糸","text":"これ、舐めて待ってて……！\\n飴……！","trans":"吃着这个等我们吧……！\\n糖果……！"},{"id":"3021003020060","name":"off","text":"課題は、全員終わらなかった","trans":"作业，所有人都没完成"},{"id":"3021003020070","name":"off","text":"けど","trans":"但是"},{"id":"3021003020080","name":"雛菜","text":"あ～……\\n取られちゃってる～","trans":"啊～……\\n被抓走了～"},{"id":"3021003020090","name":"円香","text":"……このぬいぐるみ？\\nさっき浅倉と見てたやつ","trans":"……这个娃娃？\\n刚才和浅仓看的"},{"id":"3021003020100","name":"円香","text":"まだ取れそうじゃん","trans":"不是还能抓吗"},{"id":"3021003020110","name":"雛菜","text":"雛菜、ハートを抱っこしたやつが\\nよかった～……","trans":"雏菜，觉得\\n抱着心心的比较好～……"},{"id":"3021003020120","name":"円香","text":"…………","trans":""},{"id":"3021003020130","name":"円香","text":"……ああ\\n一番、取りやすい位置にあるのが、ってこと？","trans":"……那个啊\\n是因为，在最好抓的位置？"},{"id":"3021003020140","name":"雛菜","text":"うん～","trans":"嗯～"},{"id":"3021003020150","name":"円香","text":"…………","trans":""},{"id":"3021003020160","name":"円香","text":"……ん","trans":"……嗯"},{"id":"3021003020170","name":"雛菜","text":"ん～？","trans":"嗯～？"},{"id":"3021003020180","name":"円香","text":"３プレイ500円","trans":"抓3次500日元"},{"id":"3021003020190","name":"雛菜","text":"え～！\\n円香先輩、できるの～？","trans":"诶～！\\n圆香学姐，抓得到吗～？"},{"id":"3021003020200","name":"円香","text":"さあ。でもそんなに難しくなさそう","trans":"谁知道。不过看起来也没多难"},{"id":"3021003020210","name":"雛菜","text":"あ～……","trans":"啊～……"},{"id":"3021003020220","name":"雛菜","text":"円香先輩、やっていいよ？\\n雛菜、見てるから～","trans":"圆香学姐，可以试试啊？\\n雏菜会看着的～"},{"id":"3021003020230","name":"円香","text":"……\\n別にこのぬいぐるみ欲しくないんだけど","trans":"……\\n但我也不是很想要这个布娃娃"},{"id":"3021003020240","name":"雛菜","text":"じゃあもし取れたら払うね～？","trans":"那抓到的话雏菜出钱～？"},{"id":"3021003020250","name":"円香","text":"……ったく","trans":"……真是"},{"id":"3021003020260","name":"off","text":"だいたいのことが、できる","trans":"大多都能完成"},{"id":"3021003020270","name":"円香","text":"…………","trans":""},{"id":"3021003020280","name":"円香","text":"ほら、雛菜","trans":"来，雏菜"},{"id":"3021003020290","name":"雛菜","text":"これ、ハート抱っこしたやつ\\nじゃないじゃん～","trans":"这个，不是\\n抱着心心的～"},{"id":"3021003020300","name":"円香","text":"……大して変わらないでしょ","trans":"……没什么差别吧"},{"id":"3021003020310","name":"雛菜","text":"変わるよ～！\\n顔だってあっちは眠そうでかわいいでしょ？","trans":"有差别～！\\n那个表情看起来想睡觉也比较可爱吧？"},{"id":"3021003020320","name":"円香","text":"……よくわかんないけど","trans":"……我不是很懂"},{"id":"3021003020330","name":"円香","text":"…………\\nあの、奥にあるハートのでいいの？","trans":"…………\\n你要在里面的，那个带心的？"},{"id":"3021003020340","name":"雛菜","text":"うん～！\\n取れるの～？","trans":"嗯～！\\n抓得到吗～？"},{"id":"3021003020350","name":"円香","text":"…………","trans":""},{"id":"3021003020360","name":"雛菜","text":"あは～\\n円香先輩、楽しい～？","trans":"啊哈～\\n圆香学姐，开心吗～？"},{"id":"3021003020370","name":"円香","text":"別に","trans":"也没有"},{"id":"3021003020380","name":"off","text":"それなりに","trans":"顺其自然地"},{"id":"3021003020390","name":"off","text":"なんでも、できる","trans":"什么都，做得到"},{"id":"3021003020400","name":"円香","text":"……アームの力、弱すぎじゃない？","trans":"……爪子的力道也太小了吧？"},{"id":"3021003020410","name":"雛菜","text":"掴むんじゃなくて\\n引っ掛ければ～？","trans":"不用抓的\\n用勾的呢～？"},{"id":"3021003020420","name":"円香","text":"引っ掛ける？　……どこに？","trans":"勾的？ ……勾哪？"},{"id":"3021003020430","name":"雛菜","text":"貸して、雛菜やる～！","trans":"借一下，雏菜来玩～！"},{"id":"3021003020440","name":"off","text":"願わなくたって","trans":"就算不许愿"},{"id":"3021003020450","name":"円香","text":"できないじゃん","trans":"也没抓到啊"},{"id":"3021003020460","name":"円香","text":"掠ってもいない","trans":"擦都没擦到"},{"id":"3021003020470","name":"雛菜","text":"あ～……","trans":"啊～……"},{"id":"3021003020480","name":"円香","text":"貸して","trans":"换我"},{"id":"3021003020490","name":"雛菜","text":"じゃあふたつめのスイッチは\\n円香先輩がやってもいいけど～？","trans":"那第二个按钮\\n让圆香学姐来按也可以哦～？"},{"id":"3021003020500","name":"円香","text":"あー……何やってんの、行き過ぎ","trans":"啊——……你在干什么，按过头了"},{"id":"3021003020510","name":"雛菜","text":"ん～、ピッタリでしょ～\\n……はい、円香先輩だよ～！","trans":"嗯～，刚好吧～\\n……来，换圆香学姐～！"},{"id":"3021003020520","name":"円香","text":"……","trans":""},{"id":"3021003020530","name":"円香","text":"雛菜、最後までやっていい","trans":"雏菜，你可以玩到最后"},{"id":"3021003020540","name":"雛菜","text":"え～","trans":"诶～"},{"id":"3021003020550","name":"円香","text":"ピッタリなんでしょ？","trans":"不是刚好吗？"},{"id":"3021003020560","name":"雛菜","text":"ん～\\nそうだけど～","trans":"嗯～\\n虽然是这样～"},{"id":"3021003020570","name":"雛菜","text":"１回じゃ取れないかな～？","trans":"是不是1次抓不到啊～？"},{"id":"3021003020580","name":"円香","text":"は？","trans":"哈？"},{"id":"3021003020590","name":"off","text":"適当に","trans":"随意地"},{"id":"3021003020591","name":"円香＆雛菜","text":"あー","trans":"啊——"},{"id":"3021003020600","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3021003020610","name":"透","text":"やる、私も","trans":"我也来玩"},{"id":"3021003020620","name":"円香","text":"……おかえり","trans":"……回来啦"},{"id":"3021003020630","name":"小糸","text":"お、お待たせ……！ ごめんね\\n混んでて遅くなっちゃった……！","trans":"久，久等了……！ 对不起\\n人太多就迟到了……！"},{"id":"3021003020640","name":"雛菜","text":"あは～、いいよ～","trans":"啊哈～，没关系～"},{"id":"3021003020650","name":"off","text":"課題は、別に難しくなかった","trans":"作业，并不是很难"},{"id":"3021003020660","name":"off","text":"でも、面倒そうだった","trans":"但是，很麻烦"},{"id":"3021003020670","name":"円香","text":"……あとで全員から250円徴収ね","trans":"……之后每个人征收250日元"},{"id":"3021003020680","name":"透","text":"オッケーオッケー","trans":"OKOK"},{"id":"3021003020690","name":"透","text":"──いけっ","trans":"——去吧"},{"id":"3021003020700","name":"小糸","text":"が、頑張って……！","trans":"加，加油"},{"id":"3021003020710","name":"off","text":"だから、もうちょっとだけ休憩","trans":"所以，再休息一下"},{"id":"3021003020711","name":"一同","text":"あーーーーー……","trans":"啊——————……"},{"id":"3021003020720","name":"off","text":"この飴玉が溶けるまで","trans":"在这糖果融化之前"}]}