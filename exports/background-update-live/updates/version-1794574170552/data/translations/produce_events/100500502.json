{"translator":"告","rows":[{"id":"1005005020010","name":"摩美々","text":"──プレゼントなんていらないから……","trans":"——我不想要礼物……"},{"id":"1005005020020","name":"摩美々","text":"…………夢……","trans":"…………是梦……"},{"id":"1005005020030","name":"摩美々","text":"（──や、いつの記憶ー）","trans":"（——不对，什么时候的记忆——）"},{"id":"1005005020040","name":"摩美々","text":"（……まだ思い出すとかぁ）","trans":"（……居然还能想起来）"},{"id":"1005005020050","name":"摩美々","text":"…………","trans":""},{"id":"1005005020060","name":"摩美々","text":"……ふぁ……","trans":"……呵……"},{"id":"1005005020070","name":"摩美々","text":"んー\\n18時半","trans":"嗯——\\n18点半"},{"id":"1005005020080","name":"摩美々","text":"……──","trans":""},{"id":"0000000000000","name":"メッセージ","text":"『摩美々ちゃん、今日もお店来るでしょ？』","trans":"“摩美美，你今天也要来店里的吧？”"},{"id":"0000000000000","name":"メッセージ","text":"『こないだ言ってた新作入ったよ』","trans":"“之前跟你说的新品到货啦”"},{"id":"0000000000000","name":"メッセージ","text":"『やっぱめっちゃいい！』","trans":"“不行了真的好好看！”"},{"id":"0000000000000","name":"メッセージ","text":"『早く実物見てほしい～』","trans":"“好想快点让你看到实物啊~”"},{"id":"1005005020090","name":"摩美々","text":"（ちょっと寝すぎた……\\n……ケド）","trans":"（睡得有点久了……\\n……不过）"},{"id":"1005005020100","name":"摩美々","text":"（今から準備して──\\nまぁ、行けるかぁ）","trans":"（现在开始准备——\\n也来得及吧）"},{"id":"1005005020110","name":"摩美々","text":"『オッケー』","trans":"“OK”"},{"id":"1005005020120","name":"摩美々","text":"『行く』","trans":"“我去”"},{"id":"1005005020130","name":"摩美々","text":"『でも閉店ギリギリになるかも』","trans":"“但你们可能都关门了”"},{"id":"1005005020140","name":"摩美々","text":"……行くかぁ","trans":"……走吧"},{"id":"1005005020150","name":"摩美々","text":"夜へ","trans":"朝着夜晚"},{"id":"1005005020160","name":"摩美々","text":"最初はたぶん\\nどこへ行くつもりもなく","trans":"一开始大概\\n没有什么目标"},{"id":"1005005020170","name":"摩美々","text":"ただ、\\n見てほしかった","trans":"只是，\\n想让大家看看"},{"id":"1005005020180","name":"摩美々","text":"夜へ向かう　悪い子のまみみを","trans":"走向夜晚的 坏孩子摩美美"},{"id":"1005005020190","name":"摩美々","text":"──ケド\\nそれが叶うことはなくて","trans":"——但是\\n这也没有实现"},{"id":"1005005020200","name":"摩美々","text":"だから","trans":"所以"},{"id":"1005005020210","name":"摩美々","text":"もう忘れた","trans":"早就忘了"},{"id":"1005005020220","name":"摩美々","text":"なんのために\\n夜へ向かうのか","trans":"到底是为什么\\n而走向夜晚"},{"id":"0000000000000","name":"ショップ店員","text":"あ、摩美々ちゃん！","trans":"啊，摩美美！"},{"id":"0000000000000","name":"ショップ店員","text":"よかった、ちゃんと来た\\n待ってたよー","trans":"太好了，你来了\\n我等好久了——"},{"id":"1005005020230","name":"摩美々","text":"どーもー","trans":"你好——"},{"id":"0000000000000","name":"ショップ店員","text":"──ていうかこれ見て！\\nこのブーツ！","trans":"——倒是来看这个！\\n这双靴子！"},{"id":"1005005020240","name":"摩美々","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"ショップ店員","text":"超派手だけど\\n摩美々ちゃん好きだと思うんだよね、どうかな？","trans":"虽然超花哨的\\n不过我觉得你喜欢，怎么样？"},{"id":"1005005020250","name":"摩美々","text":"あー\\n超派手、超目立つじゃーん","trans":"啊——\\n超花哨，超引人注目啊"},{"id":"1005005020260","name":"摩美々","text":"いいねー\\n買いまぁす","trans":"真不错——\\n我买了——"},{"id":"0000000000000","name":"ショップ店員","text":"あははっ、さすがの即決！","trans":"啊哈哈，英明的决断！"},{"id":"0000000000000","name":"ショップ店員","text":"お買い上げ、ありがとうございまーす！","trans":"多谢惠顾——！"},{"id":"1005005020270","name":"摩美々","text":"……あ","trans":"……啊"},{"id":"1005005020280","name":"摩美々","text":"これ、履いて帰ってもいいー？","trans":"这个可以直接穿回去吗？"},{"id":"0000000000000","name":"ショップ店員","text":"もちろん\\nじゃあ、タグ切るね","trans":"当然\\n那我帮你剪下挂牌"},{"id":"0000000000000","name":"ショップ店員","text":"──あ、箱は？　いる？","trans":"——啊，鞋盒呢？ 要吗？"},{"id":"1005005020290","name":"摩美々","text":"いらないー","trans":"不要——"},{"id":"0000000000000","name":"ショップ店員","text":"はーい、了解","trans":"好——，了解"},{"id":"1005005020300","name":"摩美々","text":"夜へ向かう","trans":"走向夜晚"},{"id":"1005005020310","name":"摩美々","text":"とびきりに目立つ靴を履いて","trans":"穿上最亮眼的鞋子"},{"id":"1005005020320","name":"摩美々","text":"夜へ","trans":"向着夜晚"},{"id":"1005005020330","name":"摩美々","text":"────なんのために？","trans":"————为了什么？"},{"id":"1005005020340","name":"摩美々","text":"もう忘れた","trans":"早就忘了"},{"id":"1005005020350","name":"摩美々","text":"────どこへ？","trans":"————去哪里？"},{"id":"1005005020360","name":"摩美々","text":"もう、わからない","trans":"已经，不知道了"},{"id":"1005005020370","name":"摩美々","text":"まみみを","trans":"快来"},{"id":"1005005020380","name":"摩美々","text":"……みつけて","trans":"……寻找摩美美"}]}