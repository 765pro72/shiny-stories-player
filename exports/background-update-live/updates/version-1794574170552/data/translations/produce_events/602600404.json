{"translator":"煉金術式","rows":[{"id":"0000000000000","name":"プロデューサー","text":"ルカ、お疲れさ──","trans":"路加，辛苦你——"},{"id":"6026004040010","name":"ルカ","text":"アンタも","trans":"你也是"},{"id":"0000000000000","name":"プロデューサー","text":"────えっ！！？？","trans":"————欸！！？？"},{"id":"6026004040020","name":"ルカ","text":"おい……","trans":"喂……"},{"id":"0000000000000","name":"プロデューサー","text":"すまん……！\\nでもだって、今──！","trans":"抱歉……！\\n但刚才那是——！"},{"id":"6026004040030","name":"ルカ","text":"……さすがに失礼だろ","trans":"……也太瞧不起我了吧"},{"id":"6026004040040","name":"ルカ","text":"そんなに意外かよ\\n私がアンタを労うのは","trans":"有什么好惊讶的\\n慰劳你两句怎么了"},{"id":"0000000000000","name":"プロデューサー","text":"いやっ、そういうことじゃ──！","trans":"不、不是这个意思——！"},{"id":"6026004040050","name":"ルカ","text":"言わない方がいいか？","trans":"那我还是不说咯？"},{"id":"6026004040060","name":"ルカ","text":"お疲れサマ、プロデューサー\\n頑張ったね","trans":"辛苦了，制作人\\n你受累了"},{"id":"0000000000000","name":"プロデューサー","text":"────っ！","trans":"————！"},{"id":"6026004040070","name":"ルカ","text":"──","trans":"——"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ、待っ──！","trans":"路加，等——！"},{"id":"6026004040080","name":"ルカ","text":"うるせェよ","trans":"少说两句吧"},{"id":"6026004040090","name":"ルカ","text":"────クソプロデューサー","trans":"————混蛋制作人"}]}