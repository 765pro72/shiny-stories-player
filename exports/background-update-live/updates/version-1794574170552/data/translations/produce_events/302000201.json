{"translator":"岛木","rows":[{"id":"3020002010010","name":"円香","text":"…………","trans":""},{"id":"3020002010020","name":"透","text":"──あー","trans":"——啊——"},{"id":"3020002010030","name":"円香","text":"……おかえり","trans":"……欢迎回来"},{"id":"3020002010040","name":"透","text":"うん","trans":"嗯"},{"id":"3020002010050","name":"透","text":"──あー……\\n肩やばい","trans":"——啊……\\n肩好酸"},{"id":"3020002010060","name":"透","text":"首かな","trans":"该说脖子？"},{"id":"3020002010070","name":"円香","text":"……","trans":""},{"id":"3020002010080","name":"透","text":"……","trans":""},{"id":"3020002010090","name":"透","text":"このへん","trans":"这附近"},{"id":"3020002010100","name":"円香","text":"……","trans":""},{"id":"3020002010110","name":"円香","text":"──冷湿布系？　温湿布系？","trans":"——冷湿布？ 还是温湿布？"},{"id":"3020002010120","name":"透","text":"え？　何","trans":"诶？ 什么"},{"id":"3020002010130","name":"円香","text":"……──","trans":""},{"id":"3020002010140","name":"透","text":"──おかーさーん……\\n冷湿布か温湿布あるー？","trans":"——妈妈……\\n有冷湿布或者温湿布吗——？"},{"id":"3020002010150","name":"円香","text":"……","trans":""},{"id":"3020002010160","name":"透","text":"ねぇ、冷湿布か温湿布────","trans":"冷湿布或者温湿布————"},{"id":"3020002010170","name":"円香","text":"……聞こえてるくせに、まったく","trans":"……明明都听到了，真是的"},{"id":"3020002010180","name":"円香","text":"…………","trans":""},{"id":"3020002010190","name":"透","text":"──メロン、持ってきてくれたんだ？","trans":"——拿着蜜瓜来了啊？"},{"id":"3020002010200","name":"透","text":"ありがと言っといて\\n樋口ママに","trans":"跟我向你妈妈\\n说句谢谢"},{"id":"3020002010210","name":"円香","text":"うん……\\nおばさんにも言われた","trans":"嗯……\\n阿姨刚才也这么说"},{"id":"3020002010220","name":"透","text":"食べる？\\n切るって","trans":"要吃吗？\\n拿去切了"},{"id":"3020002010230","name":"円香","text":"あ……\\nうん","trans":"啊……\\n嗯"},{"id":"3020002010240","name":"透","text":"──おかーさーん、食べるってー","trans":"——妈妈，我们要吃"},{"id":"3020002010250","name":"透","text":"……えーと","trans":"……嗯"},{"id":"3020002010260","name":"円香","text":"……\\n湿布、貸して","trans":"……\\n湿布，给我"},{"id":"3020002010270","name":"透","text":"──あ、冷なんだ","trans":"——啊，是冷的"},{"id":"3020002010280","name":"円香","text":"……\\n肩出して","trans":"……\\n露下肩膀"},{"id":"3020002010290","name":"透","text":"うん","trans":"嗯"},{"id":"3020002010300","name":"透","text":"──ったぁ……","trans":"——痛……"},{"id":"3020002010310","name":"透","text":"そこ。痛い","trans":"这里。好痛"},{"id":"3020002010320","name":"円香","text":"知ってる","trans":"知道"},{"id":"3020002010330","name":"円香","text":"──ていうか、なんで冷の方かわかってるの？","trans":"——说起来，知道为什么用冷的湿布吗？"},{"id":"3020002010340","name":"透","text":"え？　あー……","trans":"诶？ 啊——……"},{"id":"3020002010350","name":"透","text":"わからん","trans":"不懂"},{"id":"3020002010360","name":"円香","text":"──","trans":""},{"id":"3020002010370","name":"透","text":"いいじゃん\\n樋口がわかってれば","trans":"樋口懂的话，\\n不就行了"},{"id":"3020002010380","name":"円香","text":"…………はぁ？","trans":"…………哈？"},{"id":"3020002010390","name":"透","text":"……？","trans":""},{"id":"3020002010400","name":"円香","text":"……\\n説明だるい……","trans":"……\\n懒得解释……"},{"id":"3020002010410","name":"円香","text":"……今日体育もレッスンもないし","trans":"……今天没有体育课也没有训练"},{"id":"3020002010420","name":"円香","text":"寝違えたんじゃないの","trans":"是睡姿有点怪吧"},{"id":"3020002010430","name":"透","text":"あー……","trans":"啊——……"},{"id":"3020002010440","name":"透","text":"そういうやつかも\\nそっか","trans":"可能是这样吧"},{"id":"3020002010450","name":"円香","text":"だから、冷","trans":"所以，用冷的"},{"id":"3020002010460","name":"透","text":"──っ\\n冷た……","trans":"——\\n好凉……"},{"id":"3020002010470","name":"円香","text":"１時間くらいしたら取って\\n長く冷やすのよくないから","trans":"差不多一个小时就拿下来\\n冷敷太久也不好"},{"id":"3020002010480","name":"透","text":"はーい","trans":"好——"},{"id":"3020002010490","name":"透","text":"ありがと","trans":"谢谢"},{"id":"3020002010500","name":"円香","text":"……","trans":""},{"id":"3020002010510","name":"円香","text":"……すごい湿布の匂い","trans":"……湿布味道好重"},{"id":"3020002010520","name":"透","text":"ふふ、うん\\nこれからメロン来るけどね","trans":"呵呵，嗯\\n待会还要吃蜜瓜"},{"id":"3020002010530","name":"円香","text":"……浅倉、あっちで食べたら","trans":"……浅仓，去那边吃行吗"},{"id":"3020002010540","name":"透","text":"なんで","trans":"为什么"},{"id":"3020002010550","name":"円香","text":"湿布でメロンが死ぬから","trans":"闻着湿布吃蜜瓜会死的"},{"id":"3020002010560","name":"透","text":"えー","trans":"诶——"},{"id":"3020002010570","name":"透","text":"こっちで食べるよ","trans":"就要在这里吃"},{"id":"3020002010580","name":"円香","text":"……っ","trans":"……"},{"id":"3020002010590","name":"円香","text":"なんで","trans":"为什么"},{"id":"3020002010600","name":"透","text":"こっちで食べたいから","trans":"因为想在这吃"}]}