{"translator":"告","rows":[{"id":"3020007010010","name":"透","text":"──────\\n……あれ","trans":"──────\\n……怪了"},{"id":"3020007010020","name":"透","text":"……\\nあー……","trans":"……\\n啊——……"},{"id":"3020007010030","name":"透","text":"鍵……","trans":"钥匙……"},{"id":"3020007010040","name":"透","text":"樋口ー\\n…………","trans":"樋口——\\n…………"},{"id":"3020007010050","name":"円香","text":"────","trans":""},{"id":"3020007010060","name":"透","text":"……あれ","trans":"……咦"},{"id":"3020007010070","name":"透","text":"うわ\\nいないかー……","trans":"呜哇\\n不在吗——……"},{"id":"3020007010080","name":"透","text":"……\\nんー……","trans":"……\\n嗯——……"},{"id":"0000000000000","name":"透の母","text":"今日ね、同窓会だから私ー","trans":"今天我要去同学会——"},{"id":"3020007010090","name":"透","text":"……あー","trans":"……啊——"},{"id":"0000000000000","name":"透の母","text":"お父さんも遅くなるって","trans":"爸爸也说要晚点回来"},{"id":"3020007010100","name":"透","text":"んー……","trans":"嗯——……"},{"id":"0000000000000","name":"透の母","text":"ね、こっちのブラウスと水玉のだったら\\nやっぱりこっちだと思う！？","trans":"对了，这件罩衫和水球图案的那件比的话\\n你觉不觉得还是穿这件更好！？"},{"id":"3020007010110","name":"透","text":"……え？","trans":"……诶？"},{"id":"3020007010120","name":"透","text":"はぁー……","trans":"呵——……"},{"id":"3020007010130","name":"透","text":"あー\\n服か……","trans":"啊——\\n衣服吗……"},{"id":"3020007010140","name":"透","text":"着たい方で","trans":"想穿哪件就"},{"id":"0000000000000","name":"透の母","text":"えー！　迷っちゃうなぁ……\\nあ、透の青いワンピース借りようかな？","trans":"诶——！ 好头疼啊……\\n啊，干脆借一下透的蓝裙子吧？"},{"id":"3020007010150","name":"透","text":"──お母さんのじゃん\\nもともと……","trans":"——那件是妈妈的吧\\n原本……"},{"id":"3020007010160","name":"透","text":"……\\nだいぶかかるかな……","trans":"……\\n要花很久时间吗……"},{"id":"3020007010170","name":"透","text":"────","trans":""},{"id":"3020007010180","name":"透","text":"『だれか　hel』","trans":"“谁来 hel”"},{"id":"3020007010190","name":"透","text":"あ","trans":"啊"},{"id":"3020007010200","name":"透","text":"『ｐ』","trans":"“p”"},{"id":"3020007010210","name":"透","text":"…………\\nヘルプミー","trans":"…………\\nHelp me——"},{"id":"3020007010220","name":"小糸","text":"…………────","trans":""},{"id":"3020007010230","name":"小糸","text":"……着目する角度90°－Θを\\n左下にもってきて……","trans":"……需要注意的角度90°－Θ\\n代入到左下角……"},{"id":"3020007010240","name":"小糸","text":"……","trans":""},{"id":"3020007010250","name":"雛菜","text":"ん～……","trans":"嗯～……"},{"id":"0000000000000","name":"店員","text":"こちらのお色、新色なんですー\\nいい色じゃないですかー？","trans":"这个颜色是新的颜色——\\n是很不错的颜色吧——？"},{"id":"3020007010260","name":"雛菜","text":"へ～？","trans":"诶～？"},{"id":"0000000000000","name":"店員","text":"お客様ですと、きっとこちらのお色味なんかも\\n似合うんじゃないかなーって思うんですけどー","trans":"客人您的话，都不禁让人想着\\n一定很适合这个颜色了——"},{"id":"3020007010270","name":"雛菜","text":"あ～……","trans":"啊～……"},{"id":"3020007010280","name":"雛菜","text":"はい、大丈夫です～","trans":"不用了，没关系～"},{"id":"3020007010290","name":"透","text":"……\\nダメかー……","trans":"……\\n不行吗——"},{"id":"3020007010300","name":"透","text":"…………","trans":""},{"id":"3020007010310","name":"透","text":"…………","trans":""},{"id":"3020007010320","name":"透","text":"…………","trans":""},{"id":"3020007010330","name":"透","text":"…………","trans":""},{"id":"3020007010340","name":"透","text":"…………\\nあー……","trans":"…………\\n啊——……"},{"id":"3020007010350","name":"透","text":"ネカフェ\\n行くかー……","trans":"干脆\\n去网咖吧——……"},{"id":"3020007010360","name":"透","text":"────……","trans":""},{"id":"3020007010370","name":"透","text":"……おー","trans":"……哦——"},{"id":"3020007010380","name":"透","text":"なに、おまえ","trans":"你什么情况"},{"id":"3020007010390","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3020007010400","name":"透","text":"ひとり？\\nおまえも","trans":"一个人吗？\\n你也"},{"id":"3020007010410","name":"透","text":"ふふっ\\nちょ……","trans":"呵呵\\n等……"},{"id":"3020007010420","name":"透","text":"あ","trans":"啊"},{"id":"3020007010430","name":"透","text":"待て待て……\\nないよ、エサとか","trans":"等等等等……\\n我可没吃的"},{"id":"3020007010440","name":"透","text":"さびしいかも","trans":"有点寂寞"},{"id":"3020007010450","name":"透","text":"もー……","trans":"真是的——……"},{"id":"3020007010460","name":"透","text":"ダメだって\\nもー────","trans":"都说不行了\\n真是————"},{"id":"0000000000000","name":"女性の声","text":"マロンちゃーん……！\\n────あっ、マロンちゃん……！","trans":"栗子——……！\\n————啊，栗子……！"},{"id":"3020007010470","name":"透","text":"さびしくて","trans":"这么冷清"},{"id":"3020007010480","name":"透","text":"気持ちいいかも","trans":"还有点舒服"},{"id":"3020007010490","name":"透","text":"…………","trans":""},{"id":"0000000000000","name":"女性","text":"もう、勝手に走ってっちゃダメ……！\\n──ごめんなさいねぇ、ご迷惑かけたかしら？","trans":"真是的，不可以随便乱跑……！\\n——对不起，有给你造成困扰吗？"},{"id":"3020007010500","name":"透","text":"……あ","trans":"……啊"},{"id":"3020007010510","name":"透","text":"全然","trans":"不会"},{"id":"0000000000000","name":"女性","text":"よかった……！　それじゃあ失礼しますね\\n──マロンちゃん行くわよー","trans":"太好了……！ 那我失陪了\\n——栗子，该走啦——"},{"id":"3020007010520","name":"透","text":"…………\\nバイバーイ","trans":"…………\\n拜拜——"},{"id":"3020007010530","name":"透","text":"……あ","trans":"……啊"},{"id":"3020007010540","name":"小糸","text":"『透ちゃん！？\\nどうしたの？』","trans":"“小透！？\\n怎么了？”"},{"id":"3020007010550","name":"円香","text":"『何』","trans":"“什么”"},{"id":"3020007010560","name":"雛菜","text":"『help』","trans":"“help”"},{"id":"3020007010570","name":"雛菜","text":"『ってなに～？』","trans":"“什么意思～？”"},{"id":"3020007010580","name":"透","text":"おー……","trans":"哦——……"},{"id":"3020007010590","name":"透","text":"『鍵なくて』","trans":"“没带钥匙”"},{"id":"3020007010600","name":"透","text":"『外　今』","trans":"“现在 在外面”"},{"id":"3020007010610","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3020007010620","name":"透","text":"ヘルプミー","trans":"Help me——"}]}