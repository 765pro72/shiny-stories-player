{"translator":"o3-mini（社区机翻，未人工审核）","ai":true,"aiHash":"ac3bc8c","rows":[{"id":"0000000000000","name":"プロデューサー","text":"ルカ、お疲れさ──","trans":"路加，辛苦了──"},{"id":"6026004040010","name":"ルカ","text":"アンタも","trans":"你也一样"},{"id":"0000000000000","name":"プロデューサー","text":"────えっ！！？？","trans":"────诶！！？？"},{"id":"6026004040020","name":"ルカ","text":"おい……","trans":"喂……"},{"id":"0000000000000","name":"プロデューサー","text":"すまん……！\\nでもだって、今──！","trans":"抱歉……！\\n不过那个，现在──！"},{"id":"6026004040030","name":"ルカ","text":"……さすがに失礼だろ","trans":"……这么说话可真失礼啊"},{"id":"6026004040040","name":"ルカ","text":"そんなに意外かよ\\n私がアンタを労うのは","trans":"你就那么意外吗\\n我可是会关心你的"},{"id":"0000000000000","name":"プロデューサー","text":"いやっ、そういうことじゃ──！","trans":"不，不是那个意思──！"},{"id":"6026004040070","name":"ルカ","text":"──","trans":"──"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ、待っ──！","trans":"路加，等一下──！"},{"id":"6026004040080","name":"ルカ","text":"うるせェよ","trans":"闭嘴啦"},{"id":"6026004040090","name":"ルカ","text":"────クソプロデューサー","trans":"────该死的制片人"}]}