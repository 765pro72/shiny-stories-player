{"translator":"","rows":[{"id":"3008019010010","name":"霧子","text":"ん……","trans":"嗯……"},{"id":"3008019010020","name":"摩美々","text":"何ー？\\n急に止まってー","trans":"怎么了？\\n突然停下——"},{"id":"3008019010030","name":"霧子","text":"あ、あのね……摩美々ちゃん……\\nこのカプセルのマスコット……","trans":"那、那个……摩美美……\\n这个扭蛋里的玩偶……"},{"id":"3008019010040","name":"霧子","text":"爬虫類や両生類……みたい……","trans":"好像是……爬虫类或者两栖类的……"},{"id":"3008019010050","name":"摩美々","text":"……！","trans":""},{"id":"3008019010060","name":"摩美々","text":"エンツォとモンドじゃーん","trans":"这不就是恩佐和蒙多嘛"},{"id":"3008019010070","name":"霧子","text":"うん……\\n似てるね……","trans":"嗯……\\n很像呢……"},{"id":"3008019010080","name":"摩美々","text":"ふふー\\nたまには回してみるのもありかもー","trans":"哼哼——\\n偶尔抽抽看也不错呢——"},{"id":"3008019010090","name":"摩美々","text":"ハズレー……\\nまぁ、これも可愛いケドー","trans":"没抽中——……\\n虽说这个也挺可爱的——"},{"id":"3008019010100","name":"摩美々","text":"もう一回────","trans":"再来一次————"},{"id":"3008019010110","name":"霧子","text":"出ないね……","trans":"抽不中呢……"},{"id":"3008019010120","name":"摩美々","text":"ざんねーん……100円切れー","trans":"遗憾……100円硬币用完了——"},{"id":"3008019010130","name":"摩美々","text":"行こうかぁ","trans":"我们走吧"},{"id":"3008019010140","name":"霧子","text":"わたし……100円玉持ってるかも……","trans":"我可能……身上带着100円硬币……"},{"id":"3008019010150","name":"摩美々","text":"や、借りてまではいいしー\\nまた今度でー","trans":"不，也不至于特意向你借——\\n下次再说吧——"},{"id":"3008019010160","name":"霧子","text":"う、うん……","trans":"嗯、嗯……"},{"id":"0000000000000","name":"店員","text":"480円のお返しでーす","trans":"这是找给您的480円"},{"id":"3008019010170","name":"霧子","text":"はい……","trans":"好的……"},{"id":"3008019010180","name":"霧子","text":"『事務所に寄ります』……","trans":"『我会去事务所一趟』"},{"id":"3008019010190","name":"摩美々","text":"『私も事務所いるよ』","trans":"『我也在事务所哦』"},{"id":"3008019010200","name":"霧子","text":"……","trans":""},{"id":"3008019010210","name":"霧子","text":"あ……","trans":"啊……"},{"id":"3008019010220","name":"霧子","text":"………………","trans":""},{"id":"3008019010230","name":"霧子","text":"わ……！","trans":"哇……！"},{"id":"3008019010240","name":"霧子","text":"『提出書類出しました』……","trans":"『材料提交完了』……"},{"id":"3008019010250","name":"霧子","text":"摩美々ちゃん……","trans":"摩美美……"},{"id":"3008019010260","name":"霧子","text":"上着はあるのに……","trans":"明明外套放在这……"},{"id":"3008019010270","name":"霧子","text":"まだかな……","trans":"还没回来吗……"},{"id":"0000000000000","name":"クリーニング店員","text":"ごめんなさい、点数多いから\\n時間かかっちゃってー","trans":"实在对不起，因为东西比较多\\n多花了一些时间——"},{"id":"3008019010280","name":"摩美々","text":"大丈夫ですー","trans":"没关系——"},{"id":"3008019010290","name":"霧子","text":"…………","trans":""},{"id":"3008019010300","name":"霧子","text":"エンツォさん……モンドさん……\\nちょっと……待っててくれる……？","trans":"恩佐先生……蒙多先生……\\n能稍微……等我一下吗……？"},{"id":"3008019010310","name":"霧子","text":"寒いよね……","trans":"很冷吧……"},{"id":"3008019010320","name":"霧子","text":"摩美々ちゃん……\\nフード……貸してね……","trans":"摩美美……\\n兜帽……借用一下哦……"},{"id":"3008019010330","name":"霧子","text":"…………","trans":""},{"id":"3008019010340","name":"摩美々","text":"…………","trans":""},{"id":"3008019010350","name":"摩美々","text":"重ー……","trans":"好重——……"},{"id":"3008019010360","name":"摩美々","text":"ここ、置いとけばいっかぁ……","trans":"放在这就行了吧……"},{"id":"3008019010370","name":"摩美々","text":"…………","trans":""},{"id":"3008019010380","name":"摩美々","text":"帰ろー…………","trans":"回去吧——……"},{"id":"3008019010390","name":"霧子","text":"あれ……","trans":"咦……"},{"id":"3008019010400","name":"霧子","text":"上着が……","trans":"外套……"},{"id":"3008019010410","name":"摩美々","text":"…………","trans":""},{"id":"3008019010420","name":"霧子","text":"摩美々ちゃん……！","trans":"摩美美……！"},{"id":"3008019010430","name":"霧子","text":"中に……入ったまま……","trans":"玩偶还……在里面……"},{"id":"3008019010440","name":"霧子","text":"ふう……ふう……","trans":"呼……呼……"},{"id":"3008019010450","name":"霧子","text":"……あ\\nモンドさん……？","trans":"……啊\\n蒙多先生……？"},{"id":"3008019010460","name":"霧子","text":"…………\\n揺られてる……","trans":"…………\\n摇摇晃晃的……"},{"id":"3008019010470","name":"摩美々","text":"…………あ","trans":"…………啊"},{"id":"3008019010480","name":"摩美々","text":"『クリーニング、他の人のも受け取り済み\\n事務所に適当に置いたんで』","trans":"『送洗的衣物，我连大家的份一起取了\\n就放在事务所里』"},{"id":"3008019010490","name":"霧子","text":"わ……！","trans":"哇……！"},{"id":"3008019010500","name":"摩美々","text":"……！","trans":""},{"id":"3008019010510","name":"摩美々","text":"え……\\n霧子ー？","trans":"诶……\\n雾子——？"},{"id":"3008019010520","name":"霧子","text":"ふふっ……","trans":"呵呵……"},{"id":"3008019010530","name":"霧子","text":"あのね……\\n追いかけてきたの……","trans":"那个……\\n我追上来了……"},{"id":"3008019010540","name":"霧子","text":"可愛いから……","trans":"因为，太可爱了……"},{"id":"3008019010550","name":"摩美々","text":"えー？\\n何ー、急に……","trans":"诶——？\\n突然间怎么了……"},{"id":"3008019010560","name":"霧子","text":"摩美々ちゃん……\\nちょっとごめんね……","trans":"摩美美……\\n稍微失礼一下……"},{"id":"3008019010570","name":"霧子","text":"実は……いたの……","trans":"其实……就在……"},{"id":"3008019010580","name":"霧子","text":"摩美々ちゃんの……\\nフードの中……","trans":"摩美美的……\\n兜帽里……"},{"id":"3008019010590","name":"摩美々","text":"あ……\\nこれ────","trans":"啊……\\n这是————"},{"id":"3008019010600","name":"摩美々","text":"ふふー\\n全然気付かなかったんだケドー","trans":"哼哼——\\n我完全没有注意到——"},{"id":"3008019010610","name":"摩美々","text":"てゆーか、\\n霧子にイタズラされるとかぁ","trans":"不如说——\\n雾子竟然会对我做恶作剧呢"},{"id":"3008019010620","name":"霧子","text":"ごめんね……\\n摩美々ちゃんを……待ってる時……","trans":"抱歉哦……\\n我在等……摩美美的时候……"},{"id":"3008019010630","name":"霧子","text":"みんなが……\\nここに……入ってみたいって……","trans":"大家……\\n说着……好想到兜帽里去……"},{"id":"3008019010640","name":"霧子","text":"ふかふか……あったかそうだから……","trans":"看起来暄腾腾的……暖洋洋的……"},{"id":"3008019010650","name":"摩美々","text":"ふーん","trans":"哼——"},{"id":"3008019010660","name":"摩美々","text":"まぁ、いいケドー","trans":"嘛，也不坏吧——"}]}