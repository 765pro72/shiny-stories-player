{"translator":"Rosineae","rows":[{"id":"3021008020010","name":"灯織","text":"『駅につきました』","trans":"“我到车站了”"},{"id":"3021008020020","name":"灯織","text":"『事務所までもう少しかかります』","trans":"“再过一会儿就能到事务所”"},{"id":"3021008020030","name":"灯織","text":"…………","trans":""},{"id":"3021008020040","name":"灯織","text":"『プロデューサーこそ、朝早くからお疲れ様です』","trans":"“制作人才是，这么早辛苦了”"},{"id":"3021008020050","name":"灯織","text":"うん……","trans":"嗯……"},{"id":"3021008020060","name":"灯織","text":"…………","trans":""},{"id":"3021008020070","name":"灯織","text":"……","trans":""},{"id":"3021008020080","name":"灯織","text":"あ……────","trans":"啊……────樋……"},{"id":"3021008020090","name":"灯織","text":"………………","trans":""},{"id":"3021008020100","name":"灯織","text":"……………………","trans":""},{"id":"0000000000000","name":"円香","text":"…………","trans":""},{"id":"0000000000000","name":"灯織","text":"…………","trans":""},{"id":"3021008020130","name":"円香","text":"ん…………","trans":"嗯…………"},{"id":"0000000000000","name":"灯織","text":"………………","trans":""},{"id":"3021008020150","name":"円香","text":"ふわ……………………","trans":"哈啊……………………"},{"id":"0000000000000","name":"灯織","text":"………………","trans":""},{"id":"3021008020170","name":"円香","text":"んん…………","trans":"呼…………"},{"id":"3021008020180","name":"円香","text":"ん…………","trans":"嗯…………"},{"id":"3021008020190","name":"灯織","text":"…………","trans":""},{"id":"3021008020200","name":"円香","text":"あっ……","trans":"啊……"},{"id":"3021008020210","name":"灯織","text":"……！","trans":""},{"id":"3021008020220","name":"円香","text":"ん……","trans":"嗯……"},{"id":"3021008020230","name":"灯織","text":"……どうぞ","trans":"……给你"},{"id":"3021008020240","name":"円香","text":"ありがとう","trans":"谢谢"},{"id":"3021008020250","name":"円香","text":"……側溝に落ちるところだったね\\n拾ってくれて助かった","trans":"……差点掉进排水沟里了呢\\n谢谢你帮忙捡起来"},{"id":"3021008020260","name":"灯織","text":"いえ、よかったです","trans":"不用谢，没掉进去就好"},{"id":"3021008020270","name":"灯織","text":"……おはようございます","trans":"……早上好"},{"id":"3021008020280","name":"円香","text":"ん、おはよ","trans":"嗯，早上好"},{"id":"3021008020290","name":"円香","text":"うしろにいたんだ\\n気付かなかった","trans":"你在我后面啊\\n都没注意到"},{"id":"3021008020300","name":"灯織","text":"あ……私も……\\nすみません、樋口さんだって気付かなくて","trans":"啊……我也是……\\n对不起，没注意到是樋口小姐"},{"id":"3021008020310","name":"円香","text":"……拾ってくれたこれ、知ってる？","trans":"……你知道你捡起来的这个是什么吗？"},{"id":"3021008020320","name":"灯織","text":"……？\\n保湿リップですよね……？","trans":"……？\\n是保湿唇膏对吧……？"},{"id":"3021008020330","name":"円香","text":"そう。これ────","trans":"没错。这是────"},{"id":"3021008020340","name":"円香","text":"駅の──……………………","trans":"车站的──……………………"},{"id":"3021008020350","name":"円香","text":"……………………","trans":""},{"id":"3021008020351","name":"灯織＆円香","text":"………………","trans":""},{"id":"3021008020352","name":"灯織＆円香","text":"ふふっ……","trans":"呵呵……"},{"id":"3021008020360","name":"円香","text":"……これ、駅の近くにしか売ってないんだけど、おすすめ","trans":"……这个只在车站附近有卖，挺推荐的"},{"id":"3021008020370","name":"灯織","text":"そうなんですね","trans":"这样啊"},{"id":"3021008020380","name":"円香","text":"香りもないし、結構使いやすい","trans":"没有香味，挺好用的"},{"id":"3021008020390","name":"円香","text":"肌に合う合わないはあると思うけど","trans":"虽说合不合肌肤因人而异"},{"id":"3021008020400","name":"灯織","text":"……ありがとうございます\\n覚えておきます","trans":"……谢谢\\n我记下来了"},{"id":"3021008020410","name":"灯織","text":"行き先は事務所ですか？","trans":"是要去事务所吗？"},{"id":"3021008020420","name":"円香","text":"そう","trans":"对"},{"id":"3021008020430","name":"灯織","text":"……樋口さんも朝早くからお疲れ様です","trans":"…………樋口小姐也这么早去事务所，辛苦了"},{"id":"3021008020440","name":"円香","text":"あ、全然……\\n置き忘れた本を取りに行くだけ","trans":"啊，没有……\\n只是去拿忘在那里的书"},{"id":"3021008020450","name":"灯織","text":"あっ、そうでしたか\\nすみません……","trans":"啊，是吗\\n不好意思……"},{"id":"3021008020460","name":"円香","text":"今日の昼が図書館の返却期限で","trans":"图书馆借的，今天中午是还书期限"},{"id":"3021008020470","name":"円香","text":"風野さんは仕事？","trans":"风野小姐是去工作吗？"},{"id":"3021008020480","name":"灯織","text":"あ……はい……\\n一応……","trans":"啊……嗯……\\n是的……"},{"id":"3021008020490","name":"円香","text":"……そっちは本当に忙しそう","trans":"……看起来真是很忙的样子"},{"id":"3021008020500","name":"円香","text":"頑張って","trans":"加油哦"},{"id":"3021008020510","name":"灯織","text":"は、はい……！","trans":"好、好的……！"},{"id":"3021008020520","name":"灯織","text":"あ……","trans":"啊……"},{"id":"3021008020530","name":"灯織","text":"あの、もし支障なければ……なんですけど\\n樋口さんって何座ですか……？","trans":"那个，如果方便的话……\\n樋口小姐是什么座……？"},{"id":"3021008020540","name":"円香","text":"え……？\\nああ、星座……？","trans":"诶……？\\n啊啊，你是说星座……？"}]}