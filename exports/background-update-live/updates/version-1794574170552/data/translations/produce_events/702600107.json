{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"ルカ、『W.I.N.G.』出場が決まったよ\\nおめでとう","trans":"路加，你可以出场《W.I.N.G》了\\n恭喜你"},{"id":"7026001070010","name":"ルカ","text":"……そうか","trans":"……是吗"},{"id":"0000000000000","name":"プロデューサー","text":"良かったな","trans":"太好了"},{"id":"7026001070020","name":"ルカ","text":"────……","trans":"————……"},{"id":"0000000000000","name":"プロデューサー","text":"ここまで勝ち上がってこられたのは\\nルカの努力と実力があったからだ","trans":"能够赢到现在\\n正是因为路加的努力和实力"},{"id":"7026001070030","name":"ルカ","text":"…………","trans":"…………"},{"id":"7026001070040","name":"ルカ","text":"そうだよ……","trans":"是啊……"},{"id":"7026001070050","name":"ルカ","text":"わかってんだよ……\\nそんなこと……","trans":"这种事……\\n我当然知道……"},{"id":"7026001070060","name":"ルカ","text":"全部、自分の実力……","trans":"全是，我自己的实力……"},{"id":"7026001070070","name":"ルカ","text":"ふッ……\\nアハハッ……！","trans":"呵……\\n啊哈哈……！"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"7026001070080","name":"ルカ","text":"もうすぐだ\\nやっぱり……できんじゃん","trans":"快了\\n我果然……做得到"},{"id":"0000000000000","name":"プロデューサー","text":"ああ\\nそうだな","trans":"是啊"},{"id":"0000000000000","name":"プロデューサー","text":"ルカならきっと\\nこの先も、勝てると思う","trans":"路加的话\\n今后也一定能赢的"},{"id":"7026001070090","name":"ルカ","text":"…………なんだそれ","trans":"…………你在说什么"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ……","trans":"路加……"},{"id":"7026001070100","name":"ルカ","text":"もういい……","trans":"够了……"},{"id":"7026001070110","name":"ルカ","text":"…………","trans":"…………"},{"id":"7026001070120","name":"ルカ","text":"優勝してやるよ","trans":"我会优胜的"}]}