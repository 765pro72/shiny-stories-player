{"translator":"Rosineae","rows":[{"id":"2020007110010","name":"透","text":"ねー","trans":"喂——"},{"id":"2020007110020","name":"透","text":"どんな味？\\nルッコラって","trans":"是什么味道？\\n芝麻菜"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"嗯？"},{"id":"2020007110030","name":"透","text":"え？\\nどんな味かなーって、ルッコラ","trans":"诶？\\n就想知道是什么味道，芝麻菜"},{"id":"0000000000000","name":"プロデューサー","text":"……はは\\n用件、それか？","trans":"……哈哈\\n打电话来就为了问这个吗？"},{"id":"2020007110040","name":"透","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"プロデューサー","text":"なんだ、家なのか？","trans":"怎么，在家里吗？"},{"id":"2020007110050","name":"透","text":"んー\\n暇","trans":"嗯——\\n很闲"},{"id":"0000000000000","name":"プロデューサー","text":"そっか\\nちゃんと休めてるなら、よかった","trans":"是吗\\n有在休息就好"},{"id":"2020007110060","name":"透","text":"外？","trans":"在外面？"},{"id":"0000000000000","name":"プロデューサー","text":"え、俺か\\nうん","trans":"诶，我吗\\n对啊"},{"id":"2020007110070","name":"透","text":"聞こえる、セミの声\\n忙しい？","trans":"能听见蝉鸣声\\n在忙吗？"},{"id":"0000000000000","name":"プロデューサー","text":"まぁまぁかな","trans":"还好吧"},{"id":"2020007110080","name":"透","text":"じゃ、教えてよ\\nルッコラどんな味か","trans":"那就告诉我嘛\\n芝麻菜是什么味道"},{"id":"2020007110090","name":"透","text":"あるんだ\\n冷蔵庫に","trans":"冰箱里面有"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ……\\n留守番なのか","trans":"啊……\\n在看家吗"},{"id":"2020007110100","name":"透","text":"そう\\n来る？","trans":"嗯\\n要来吗？"},{"id":"0000000000000","name":"プロデューサー","text":"なんでだ","trans":"为什么呀"},{"id":"2020007110110","name":"透","text":"いいじゃん\\n手伝ってよ、宿題とか","trans":"有什么关系\\n来帮下忙嘛，像是作业之类的"},{"id":"0000000000000","name":"プロデューサー","text":"ダメダメ\\nせっかく時間あるんだから、じっくり取り組むこと","trans":"不行不行\\n难得有时间，自己认真写"},{"id":"2020007110120","name":"透","text":"えー","trans":"诶——"},{"id":"2020007110130","name":"透","text":"……あ","trans":"……啊"},{"id":"2020007110140","name":"透","text":"聴こえるね、なんか","trans":"能听见呢，好像"},{"id":"0000000000000","name":"プロデューサー","text":"あ、すまん\\nちょっと騒がしいとこでさ","trans":"啊，抱歉\\n这里有些嘈杂"},{"id":"0000000000000","name":"プロデューサー","text":"かけなおそうか、後で？","trans":"要等会儿再说吗？"},{"id":"2020007110150","name":"透","text":"え、ううん\\nいい","trans":"诶，不用\\n没关系"},{"id":"2020007110160","name":"透","text":"いい、このままで","trans":"就这么继续说吧"},{"id":"0000000000000","name":"プロデューサー","text":"ええと……そうか","trans":"啊……是吗"},{"id":"2020007110170","name":"透","text":"うん\\n……","trans":"嗯\\n……"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"2020007110180","name":"透","text":"……聴いたことある\\nこの曲","trans":"……我有听过\\n这首曲子"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"2020007110190","name":"透","text":"曲\\n後ろ、聴こえるやつ","trans":"曲子\\n从后面传来的"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ、うん\\n古いやつだよな","trans":"啊，嗯\\n是首很老的曲子呢"},{"id":"0000000000000","name":"プロデューサー","text":"ちょっともの悲しくて……\\nギターの音がさ","trans":"稍微有些悲伤……\\n吉他的声音"},{"id":"2020007110200","name":"透","text":"……え？","trans":"……诶？"},{"id":"2020007110210","name":"透","text":"ギターの音？\\nこれ","trans":"这是吉他的声音？"},{"id":"0000000000000","name":"プロデューサー","text":"え？　うん","trans":"诶？嗯"},{"id":"2020007110220","name":"透","text":"へー……","trans":"欸……"},{"id":"2020007110230","name":"透","text":"初めて聴いた","trans":"第一次听到"},{"id":"0000000000000","name":"プロデューサー","text":"ははは、いやいや……\\nこの前弾いてたじゃないか","trans":"哈哈哈，没有吧……\\n之前不是有弹过吗"},{"id":"2020007110240","name":"透","text":"え、だって\\n全然違うじゃん","trans":"诶，可是\\n完全不一样啊"},{"id":"0000000000000","name":"プロデューサー","text":"まぁ、弦も緩んでたか","trans":"是因为琴弦松了吧"},{"id":"0000000000000","name":"プロデューサー","text":"でも、ギターだよ。これが\\nいろんな曲に使われてるだろ？","trans":"不过，这是吉他哦\\n各种各样的曲子里都有用到吧？"},{"id":"2020007110250","name":"透","text":"ふーん……","trans":"哼……"},{"id":"2020007110260","name":"透","text":"ふふ\\n増えた","trans":"呵呵\\n变多了"},{"id":"0000000000000","name":"プロデューサー","text":"……？","trans":""},{"id":"2020007110270","name":"透","text":"音","trans":"声音"},{"id":"2020007110280","name":"透","text":"かたまりだったけど\\n音楽って","trans":"虽说是一个整体\\n音乐"},{"id":"2020007110290","name":"透","text":"これが、ギター","trans":"这就是，吉他"},{"id":"0000000000000","name":"プロデューサー","text":"……うん","trans":"……嗯"},{"id":"2020007110300","name":"透","text":"ちょ……\\n黙らないでよ、なんか","trans":"喂……\\n别不说话呀"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ、すまん\\nええと────","trans":"啊啊，不好意思\\n那个————"},{"id":"2020007110310","name":"透","text":"ルッコラ\\n教えてもらってない","trans":"你还没告诉我\\n芝麻菜是什么味道"},{"id":"0000000000000","name":"プロデューサー","text":"ははは、その話続いてたのか\\nそんな大した味じゃないぞ。普通の野菜だ","trans":"哈哈哈，还在想这个吗\\n味道没什么特别的。就是普通的蔬菜"},{"id":"2020007110320","name":"透","text":"えー、わかんないって","trans":"诶——，但我不知道啊"},{"id":"2020007110330","name":"透","text":"増えたらいいじゃん\\n味も","trans":"味道也是\\n变多的话不是很好吗"}]}