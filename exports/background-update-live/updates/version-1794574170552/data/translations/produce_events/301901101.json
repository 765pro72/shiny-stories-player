{"translator":"StYL3","rows":[{"id":"3019011010010","name":"愛依","text":"機材トラブル……ですか……？","trans":"器材……故障吗……？"},{"id":"0000000000000","name":"スタッフ","text":"はい。現在対応中なのですが\\n少々時間がかかりそうでして……","trans":"是的。目前正在检查\\n似乎会花点时间……"},{"id":"3019011010020","name":"冬優子","text":"わかりました\\nこちらは大丈夫ですので……！","trans":"明白了\\n我们有时间……！"},{"id":"3019011010030","name":"冬優子","text":"早く直るといいですね……！","trans":"希望你们能顺利修好……！"},{"id":"0000000000000","name":"スタッフ","text":"すみません、ありがとうございます……","trans":"不好意思，谢谢你们……"},{"id":"0000000000000","name":"スタッフ","text":"退屈しのぎになればと思いまして、\\nお菓子やトランプをお持ちしました","trans":"我带了点心和扑克牌，\\n供你们打发时间"},{"id":"0000000000000","name":"スタッフ","text":"よければお使いください……！\\nまた状況が見えましたらすぐにお伝えします──！","trans":"需要的话请自便……！\\n要是有什么进展我会再通知你们的——！"},{"id":"3019011010040","name":"愛依","text":"ババ抜き、やらない？\\n罰ゲーム付きで","trans":"来玩抽鬼牌吧？\\n带惩罚游戏那种"},{"id":"3019011010050","name":"あさひ","text":"いっすよ！\\n負けないっす！","trans":"好哦！\\n我不会输的！"},{"id":"3019011010060","name":"冬優子","text":"はぁ……？","trans":"哈……？"},{"id":"3019011010070","name":"愛依","text":"あたし、強いよ","trans":"我，很强哦"},{"id":"3019011010080","name":"愛依","text":"……","trans":"……"},{"id":"3019011010090","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010100","name":"冬優子","text":"……もう、仕方ないなぁ","trans":"……真是，拿你们没办法"},{"id":"3019011010110","name":"愛依","text":"……","trans":"……"},{"id":"3019011010120","name":"愛依","text":"（よっしゃー、絶対勝つぞー！）","trans":"（好叻——，绝对要赢——！）"},{"id":"3019011010130","name":"あさひ","text":"そろわないっすね……","trans":"凑不到一对呢……"},{"id":"3019011010140","name":"あさひ","text":"はい、次冬優子ちゃんっす","trans":"接下来轮到冬优子"},{"id":"3019011010150","name":"冬優子","text":"はーい","trans":"好的"},{"id":"3019011010160","name":"冬優子","text":"愛依ちゃんどうぞ","trans":"换你了，爱依"},{"id":"3019011010170","name":"愛依","text":"うん","trans":"嗯"},{"id":"3019011010180","name":"愛依","text":"！","trans":"！"},{"id":"3019011010190","name":"愛依","text":"（やったー！　揃ったし！）","trans":"（好耶——！　凑一对了！）"},{"id":"3019011010200","name":"愛依","text":"（やっぱうち、ババ抜き強いな～！\\nこの調子で一番はいただき～♪）","trans":"（咱抽鬼牌果然很强呢～！\\n就这样一步一步拿下游戏～♪）"},{"id":"3019011010210","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010220","name":"あさひ","text":"うーん","trans":"唔——"},{"id":"3019011010230","name":"あさひ","text":"……","trans":"……"},{"id":"3019011010240","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010250","name":"愛依","text":"……","trans":"……"},{"id":"3019011010260","name":"愛依","text":"（アハハ、うちが一番手もち少ない♪\\nこのまま一気に──）","trans":"（啊哈哈，咱手上的牌最少♪\\n就这样一鼓作气——）"},{"id":"3019011010270","name":"冬優子","text":"──愛依ちゃーん\\n愛依ちゃんの番だよ？","trans":"——爱依\\n该你抽了哦？"},{"id":"3019011010280","name":"愛依","text":"あ、うん……！","trans":"啊，嗯……！"},{"id":"3019011010290","name":"愛依","text":"じゃあ、これ","trans":"那就，这张"},{"id":"3019011010300","name":"愛依","text":"あ……！","trans":"啊……！"},{"id":"3019011010310","name":"愛依","text":"（あー！　ついに来ちゃった～！\\nヤバ！　どうするかな～……）","trans":"（啊——！　还是抽到了～！\\n完蛋！　怎么办才好～……）"},{"id":"3019011010320","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010330","name":"愛依","text":"（とりあえず……！\\nガシャガシャに入れ替えて……！）","trans":"（总而言之……！\\n先把它混进去……！）"},{"id":"3019011010340","name":"あさひ","text":"？　愛依ちゃんどうしたんすか？\\n早くするっす～","trans":"？　怎么了吗，爱依？\\n搞快点～"},{"id":"3019011010350","name":"愛依","text":"え、あ……！","trans":"诶，好……！"},{"id":"3019011010360","name":"愛依","text":"（ひー、待って～！）","trans":"（噫——，等等～！）"},{"id":"3019011010370","name":"愛依","text":"もう少し……","trans":"再等一下……"},{"id":"3019011010380","name":"愛依","text":"いいよ","trans":"抽吧"},{"id":"3019011010390","name":"あさひ","text":"じゃあ──","trans":"那——"},{"id":"3019011010400","name":"愛依","text":"（あー、そっちじゃ！）","trans":"（啊——，别选那张！）"},{"id":"3019011010410","name":"あさひ","text":"こっちっす！","trans":"这张！"},{"id":"3019011010420","name":"愛依","text":"あ……！","trans":"啊……！"},{"id":"3019011010430","name":"あさひ","text":"あははっ\\n当たりっす！","trans":"啊哈哈\\n抽对了！"},{"id":"3019011010440","name":"愛依","text":"……","trans":"……"},{"id":"3019011010450","name":"愛依","text":"（なんで～！）","trans":"（为什么啊～！）"},{"id":"3019011010460","name":"愛依","text":"（あさひちゃんは\\n全然ババ引かないまま上がっちゃうし……！）","trans":"（朝日就要在没抽中鬼牌的情况下\\n获得胜利了……！）"},{"id":"3019011010470","name":"愛依","text":"（冬優子ちゃんもなんか強いカンジだし……！）","trans":"（冬优子势头也很猛……！）"},{"id":"3019011010480","name":"愛依","text":"……","trans":"……"},{"id":"3019011010490","name":"愛依","text":"（ダメダメ弱気になっちゃ！）","trans":"（不行不行别气馁啊！）"},{"id":"3019011010500","name":"愛依","text":"（絶対にあきらめない！）","trans":"（绝不放弃！）"},{"id":"3019011010510","name":"愛依","text":"冬優子ちゃん……\\nいいよ……","trans":"冬优子……\\n抽吧……"},{"id":"3019011010520","name":"冬優子","text":"うん","trans":"嗯"},{"id":"3019011010530","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010540","name":"愛依","text":"（よっし！　それそれ！\\nそれ引いて～！　いけ～冬優子ちゃん！）","trans":"（好！　就是那张！\\n抽吧抽吧～！　冲呀～冬优子！）"},{"id":"3019011010550","name":"冬優子","text":"……","trans":"……"},{"id":"3019011010560","name":"愛依","text":"（違う違う！　さっきの！　さっきのでいいの！）","trans":"（不对不对！　刚才那张！　快抽刚才那张！）"},{"id":"3019011010570","name":"冬優子","text":"……ふふ","trans":"……呵呵"},{"id":"3019011010580","name":"愛依","text":"あ……！","trans":"啊……！"},{"id":"3019011010590","name":"あさひ","text":"冬優子ちゃんの勝ちっすね","trans":"是冬优子赢了呢"},{"id":"3019011010600","name":"冬優子","text":"わーい","trans":"耶——"},{"id":"3019011010610","name":"愛依","text":"ちょ、も、もういっか──","trans":"再、再玩一局——"},{"id":"0000000000000","name":"スタッフ","text":"──機材、直りました！\\nすみませんがスタジオの方にお願いします！","trans":"——器材维修好了！\\n不好意思请三位移步摄影棚！"},{"id":"3019011010611","name":"あさひ＆冬優子","text":"はい","trans":"好的"},{"id":"3019011010620","name":"愛依","text":"……はい","trans":"……好"},{"id":"3019011010630","name":"愛依","text":"冬優子ちゃん\\n強いね","trans":"冬优子\\n好强啊"},{"id":"3019011010640","name":"冬優子","text":"愛依ちゃんがわかりやすすぎなだけだよー","trans":"是爱依你太好懂了——"},{"id":"3019011010650","name":"愛依","text":"……？","trans":"……？"}]}