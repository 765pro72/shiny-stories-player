{"translator":"阿柚","rows":[{"id":"3023004010010","name":"雛菜","text":"あは～……","trans":"啊哈～……"},{"id":"3023004010020","name":"雛菜","text":"ざんね～ん","trans":"真遗憾～"},{"id":"3023004010030","name":"雛菜","text":"今日は間に合いそうって\\n思ったんだけどな～？","trans":"还以为今天\\n能来得及的啊～"},{"id":"3023004010040","name":"雛菜","text":"…………","trans":"…………"},{"id":"3023004010050","name":"雛菜","text":"…………あは～","trans":"…………啊哈～"},{"id":"3023004010060","name":"雛菜","text":"ん～～～～～……？","trans":"嗯～～～～～……？"},{"id":"3023004010070","name":"雛菜","text":"あっ、いた～～～……！","trans":"啊，有了～～～……！"},{"id":"3023004010080","name":"雛菜","text":"透先輩～～～……♡","trans":"透前辈～～～……♡"},{"id":"3023004010090","name":"透","text":"え？","trans":"诶？"},{"id":"3023004010100","name":"雛菜","text":"し～！\\nばれちゃうよ～……？","trans":"嘘～！\\n不然要暴露了～……"},{"id":"3023004010110","name":"透","text":"あ……","trans":"啊……"},{"id":"3023004010120","name":"透","text":"ふふ\\nどしたの","trans":"哼哼\\n干什么呢"},{"id":"3023004010130","name":"雛菜","text":"なんか１限間に合うと思ったら\\nぎりぎり間に合わなくて～","trans":"还以为能赶上第一节课\\n但最后还是差一点～"},{"id":"3023004010140","name":"雛菜","text":"こっそり学校探検してたら、\\n透先輩発見～～～♡","trans":"然后偷偷在学校探险，\\n就发现透前辈了～～～♡"},{"id":"3023004010150","name":"透","text":"そっか","trans":"这样啊"},{"id":"3023004010160","name":"雛菜","text":"うん～！","trans":"嗯～！"},{"id":"3023004010170","name":"雛菜","text":"……透先輩はこんな\\nすみっこで体育見学？","trans":"……透前辈是在这\\n小角落里见习体育课吗？"},{"id":"3023004010180","name":"雛菜","text":"……もしかして具合悪い～？","trans":"……难道是身体不舒服～？"},{"id":"3023004010190","name":"透","text":"あー……うん","trans":"啊……嗯"},{"id":"3023004010200","name":"雛菜","text":"え～！？","trans":"诶～！？"},{"id":"3023004010210","name":"透","text":"ジャージ、無くて","trans":"运动衫，没了"},{"id":"3023004010220","name":"雛菜","text":"あは～、なんだ～！","trans":"啊哈～，什么嘛～！"},{"id":"3023004010230","name":"雛菜","text":"雛菜がおんなじクラスだったら\\n雛菜のジャージ貸してあげたのに～……","trans":"要是能同班的话\\n就能把雏菜的运动衫借你了～……"},{"id":"3023004010240","name":"雛菜","text":"そしたら雛菜は見学で～\\n透先輩のこと見てる！","trans":"这样一来就是雏菜在旁见学～\\n看着透前辈！"},{"id":"3023004010250","name":"透","text":"ふふっ\\nいいよ","trans":"哼哼\\n可以啊"},{"id":"3023004010260","name":"雛菜","text":"ん～でも、\\n一緒に見学するほうがいいかも～","trans":"嗯～不过，\\n直接待在一起见习可能还更好些～"},{"id":"3023004010270","name":"雛菜","text":"その方が\\nいっぱいおしゃべりできるしね～？","trans":"那样的话\\n还能聊挺久的天呢～"},{"id":"3023004010280","name":"透","text":"やってるじゃん\\n今","trans":"现在不是在做嘛"},{"id":"3023004010290","name":"雛菜","text":"あ、そっか！","trans":"啊，对哦！"},{"id":"3023004010300","name":"雛菜","text":"じゃあこのままでいいね～","trans":"那就保持这样吧～"},{"id":"0000000000000","name":"体育教師","text":"──全員集合！","trans":"──全员集合！"},{"id":"0000000000000","name":"体育教師","text":"見学の人も集まりなさい！","trans":"见习的人也过来集合！"},{"id":"3023004010310","name":"透","text":"…………","trans":"…………"},{"id":"3023004010320","name":"雛菜","text":"あは～\\nばれちゃうから雛菜もう行こ～！","trans":"啊哈～\\n因为暴露了所以雏菜得走了～！"},{"id":"3023004010330","name":"雛菜","text":"透先輩も集合しなきゃだよ～？","trans":"透前辈要过去集合哦～"},{"id":"3023004010340","name":"透","text":"うん","trans":"嗯"},{"id":"3023004010350","name":"透","text":"……あ","trans":"……啊"},{"id":"3023004010360","name":"雛菜","text":"やは～\\nちょうどチャイム鳴った！","trans":"啊哈～\\n刚好下课铃响了！"},{"id":"3023004010370","name":"雛菜","text":"じゃあ雛菜、行くね～？","trans":"那雏菜先走了哦～"},{"id":"3023004010380","name":"雛菜","text":"えらいから\\n２限目から出る！","trans":"因为雏菜很棒\\n所以等下出席第二节课了！"},{"id":"3023004010390","name":"透","text":"うん","trans":"嗯"},{"id":"3023004010400","name":"雛菜","text":"またチェインするね～♡","trans":"之后再一起CHINE聊天吧～♡"},{"id":"0000000000000","name":"体育教師","text":"そこ！\\n早く集合しなさい！","trans":"那边的！\\n赶快过来集合！"},{"id":"3023004010410","name":"透","text":"やば","trans":"糟了"},{"id":"3023004010420","name":"雛菜","text":"ほら、透先輩\\n行って行って～……！","trans":"透前辈\\n快去快去～……！"},{"id":"3023004010430","name":"透","text":"うん\\n雛菜も","trans":"嗯\\n雏菜你也是"},{"id":"3023004010440","name":"透","text":"…………","trans":"…………"},{"id":"3023004010450","name":"透","text":"３限目でもらっていい？\\nチェイン","trans":"能占下你第三节课吗\\nCHINE"},{"id":"3023004010460","name":"雛菜","text":"へ～？","trans":"诶～？"},{"id":"3023004010470","name":"透","text":"体育でしょ\\n１限目","trans":"这不第一节课是体育课吗"},{"id":"3023004010480","name":"透","text":"寝ちゃうし","trans":"等下得睡觉"},{"id":"3023004010490","name":"雛菜","text":"あは～、何それ～！","trans":"啊哈～那算啥啊～！"},{"id":"3023004010500","name":"雛菜","text":"透先輩見学じゃん～～～","trans":"透前辈你不一直在见习吗～～～"}]}