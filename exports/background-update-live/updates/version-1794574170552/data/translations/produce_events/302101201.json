{"translator":"魚見","rows":[{"id":"0000000000000","name":"近くの乗客","text":"お、いいねえ\\nえびしゅうまい弁当？","trans":"噢、真不错\\n虾仁烧卖便当？"},{"id":"0000000000000","name":"近くの乗客","text":"……ええ！","trans":"……嗯！"},{"id":"0000000000000","name":"近くの乗客","text":"やっぱり旅の定番を抑えとくべきかなと思いまして","trans":"旅游的经典项目啊\\n我还想着是不是该先忍忍"},{"id":"0000000000000","name":"近くの乗客","text":"でも匂いを嗅ぐとそちらも羨ましくなりますね～","trans":"不过一闻到这香味\\n怕是你那边也要羡慕起来了吧～"},{"id":"0000000000000","name":"近くの乗客","text":"牛焼肉弁当！","trans":"烤牛肉便当！"},{"id":"3021012010001","name":"透＆小糸＆雛菜","text":"………………","trans":""},{"id":"3021012010010","name":"雛菜","text":"……お腹空いた～","trans":"……肚子饿了～"},{"id":"3021012010020","name":"雛菜","text":"この電車、車内販売ないの～？","trans":"这辆电车里没有车厢小卖部吗～？"},{"id":"3021012010030","name":"小糸","text":"う、うん\\n見かけないね……","trans":"嗯、嗯\\n没看到有呢……"},{"id":"3021012010040","name":"小糸","text":"あ、飴ならあるよ……！\\nお腹は膨らまないけど……","trans":"啊、不过我带了有糖……！\\n虽然填不饱肚子……"},{"id":"3021012010050","name":"小糸","text":"食べる……？","trans":"要吃吗……？"},{"id":"3021012010060","name":"雛菜","text":"食べる～","trans":"要吃～"},{"id":"3021012010070","name":"小糸","text":"透ちゃんもいる？","trans":"透也要吗？"},{"id":"3021012010080","name":"透","text":"食べる","trans":"要"},{"id":"0000000000000","name":"近くの乗客","text":"──あったかいお茶も買ってありますんで\\nよかったら","trans":"——热茶也买了有\\n需要的话"},{"id":"0000000000000","name":"近くの乗客","text":"お、気が利くねえ\\nいくらだった？","trans":"噢、准备得真好\\n多少钱？"},{"id":"0000000000000","name":"近くの乗客","text":"いえいえ、そんな──……","trans":"没事没事、不用——……"},{"id":"3021012010081","name":"透＆小糸＆雛菜","text":"………………","trans":""},{"id":"3021012010090","name":"雛菜","text":"……喉、乾いた～","trans":"……喉咙好干～"},{"id":"3021012010100","name":"小糸","text":"……待ち合わせ時間、\\nもうちょっと早くすれば良かったね……！","trans":"……集合时间、\\n要是再定早些就好了呢……！"},{"id":"3021012010110","name":"小糸","text":"バスが渋滞しなかったら、\\nお弁当も飲み物も買えたんだけど……","trans":"因为公交路上堵车了，\\n便当和饮料都没买成……"},{"id":"3021012010120","name":"雛菜","text":"ん～","trans":"嗯～"},{"id":"3021012010130","name":"雛菜","text":"あ、売店～！","trans":"啊、小卖部～！"},{"id":"3021012010140","name":"雛菜","text":"雛菜、買ってくる～！","trans":"雏菜去买点东西回来～！"},{"id":"3021012010150","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"3021012010160","name":"雛菜","text":"小糸ちゃん、ちょっとどいて～？","trans":"小糸、稍微让一下～？"},{"id":"3021012010170","name":"小糸","text":"ひ、雛菜ちゃん……！？","trans":"雏、雏菜……！？"},{"id":"3021012010180","name":"雛菜","text":"みんなの分も買うよ～？\\nいい～？","trans":"大家的份都一起买咯～？\\n可以吗～？"},{"id":"3021012010190","name":"透","text":"オッケー\\nあざす","trans":"OK——\\n谢啦"},{"id":"3021012010200","name":"小糸","text":"ひ、雛菜ちゃん\\nこの駅、多分そんなに長く止まらないから……！","trans":"雏、雏菜\\n这站车、大概不会停太久的……！"},{"id":"3021012010210","name":"小糸","text":"急いでね……！","trans":"要快点噢……！"},{"id":"3021012010220","name":"雛菜","text":"うん～～～","trans":"嗯～～～"},{"id":"3021012010221","name":"透＆小糸","text":"………………","trans":""},{"id":"3021012010230","name":"小糸","text":"あ……\\nわ、わたしも手伝ってくる","trans":"啊……\\n我、我也去帮忙"},{"id":"3021012010240","name":"透","text":"ん","trans":"嗯"},{"id":"3021012010250","name":"透","text":"行く？\\n一緒に","trans":"去吗？\\n一起"},{"id":"3021012010260","name":"小糸","text":"だ、大丈夫！\\n待ってて……！","trans":"没、没事的！\\n在这等着……！"},{"id":"3021012010270","name":"小糸","text":"わ……！\\n雛菜ちゃん","trans":"哇……！\\n雏菜"},{"id":"3021012010280","name":"雛菜","text":"どうしたの～？\\n乗るよ～！","trans":"怎么了…？\\n上车咯～！"},{"id":"3021012010290","name":"小糸","text":"う、うん！\\nお弁当は……","trans":"嗯、嗯！\\n便当呢……"},{"id":"3021012010300","name":"雛菜","text":"ない～！","trans":"没有～！"},{"id":"3021012010301","name":"透＆小糸＆雛菜","text":"………………","trans":""},{"id":"3021012010310","name":"円香","text":"……ん","trans":"……嗯"},{"id":"3021012010320","name":"円香","text":"駅弁は？","trans":"便当呢？"},{"id":"3021012010330","name":"雛菜","text":"売り切れ～","trans":"卖完了～"},{"id":"3021012010340","name":"小糸","text":"ま、円香ちゃん！\\n起きてたの？","trans":"圆、圆香！\\n你醒着啊？"},{"id":"3021012010350","name":"円香","text":"ところどころ","trans":"这里睡不太稳"},{"id":"3021012010360","name":"円香","text":"…………","trans":""},{"id":"3021012010370","name":"円香","text":"……もう現地に着いてから食べたら\\n仕事が始まるまで少しは時間あるでしょ","trans":"……到了现场再吃呗\\n到场后离开始还会有一点时间的吧"},{"id":"3021012010380","name":"雛菜","text":"あるの～？","trans":"会有吗～？"},{"id":"3021012010390","name":"円香","text":"あるある","trans":"有的有的"},{"id":"3021012010400","name":"小糸","text":"か、確認してみるね……！","trans":"我、我确认一下……！"},{"id":"3021012010410","name":"円香","text":"それじゃ","trans":"那就这样"},{"id":"3021012010420","name":"透","text":"寝る？","trans":"睡了？"},{"id":"3021012010430","name":"円香","text":"ん、空腹も紛れるし","trans":"嗯、分散下肚子的注意力"},{"id":"3021012010440","name":"円香","text":"着いたら起こして","trans":"到了叫醒我"},{"id":"3021012010450","name":"透","text":"小糸ちゃん\\n時間は？","trans":"小糸\\n怎么样？"},{"id":"3021012010460","name":"小糸","text":"う、うん\\n時間は……あるけど……","trans":"嗯、嗯\\n时间是有……就是……"},{"id":"3021012010461","name":"一同","text":"………………","trans":""},{"id":"3021012010470","name":"円香","text":"店がない","trans":"没有店家"}]}