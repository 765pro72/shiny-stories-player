{"translator":"Satorrri","rows":[{"id":"6017004020010","name":"あさひ","text":"……熱い","trans":"……热"},{"id":"6017004020020","name":"あさひ","text":"……すごく熱いっす","trans":"……好热"},{"id":"6017004020030","name":"あさひ","text":"なんでっすかね\\n動いたからってだけじゃなくて……なんか……","trans":"怎么说呢\\n并不是因为运动才觉得热……总觉得……"},{"id":"6017004020040","name":"あさひ","text":"……みんなも熱いっすか？","trans":"……大家也很热吗？"},{"id":"6017004020050","name":"あさひ","text":"そっすか！","trans":"是吗！"},{"id":"6017004020060","name":"あさひ","text":"あははっ","trans":"啊哈哈"},{"id":"6017004020070","name":"あさひ","text":"──いっすね！","trans":"——真好啊！"},{"id":"6017004020080","name":"あさひ","text":"………………","trans":""},{"id":"6017004020090","name":"あさひ","text":"わあああああああああああ──………！","trans":"哇啊啊啊啊啊啊啊啊啊啊啊——……！"}]}