{"translator":"","rows":[{"id":"6019003040010","name":"愛依","text":"──プロデューサー","trans":"——制作人"},{"id":"6019003040020","name":"愛依","text":"……うち、\\n今度は負けないから","trans":"……我，\\n这次不会再输了"},{"id":"0000000000000","name":"プロデューサー","text":"…………うん","trans":"…………嗯"},{"id":"0000000000000","name":"プロデューサー","text":"行って来い！","trans":"去吧！"},{"id":"6019003040030","name":"愛依","text":"うん、行ってくる……！","trans":"嗯，那我去了……！"},{"id":"6019003040040","name":"愛依","text":"最後まで諦めない","trans":"直到最后也不放弃"},{"id":"6019003040050","name":"愛依","text":"──絶対に","trans":"——绝对"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、愛依ならきっとできる","trans":"是啊，爱依你一定做得到的"}]}