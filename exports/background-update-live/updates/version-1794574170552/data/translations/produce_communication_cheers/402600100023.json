{"translator":"告","rows":[{"id":"4026001000230010","name":"ルカ","text":"なんだよ……\\n言いたいことでもあんのかよ？","trans":"干什么……\\n有什么想说的？"},{"id":"0000000000000","name":"プロデューサー","text":"え？\\nああ、そうだな……！","trans":"诶？\\n啊，对了……！"},{"id":"select","name":"","text":"きっと上手くいく","trans":"一定会顺利的"},{"id":"select","name":"","text":"いつも通りにいこう","trans":"照常发挥吧"},{"id":"select","name":"","text":"大丈夫か？","trans":"没问题吧？"},{"id":"4026001000230020","name":"ルカ","text":"適当言いやがって……","trans":"说得轻松……"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、リラックスできたみたいだな）","trans":""},{"id":"4026001000230030","name":"ルカ","text":"言われなくても\\nわかってんだよ……","trans":"不用你说\\n我也知道……"},{"id":"0000000000000","name":"プロデューサー","text":"（うん……落ち着いているみたいだ）","trans":"（嗯……冷静下来了）"},{"id":"4026001000230040","name":"ルカ","text":"んなもん知るかよ……","trans":"谁知道……"},{"id":"0000000000000","name":"プロデューサー","text":"（しまった……他のことを言えばよかった）","trans":""}]}