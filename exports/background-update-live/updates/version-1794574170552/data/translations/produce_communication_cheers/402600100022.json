{"translator":"告","rows":[{"id":"4026001000220010","name":"ルカ","text":"広い……\\n思ったより────……","trans":"很大……\\n比想象中还————……"},{"id":"0000000000000","name":"プロデューサー","text":"（ステージが気になるみたいだな）","trans":"（似乎很在意舞台）"},{"id":"select","name":"","text":"問題ありそうか？","trans":"有什么问题吗？"},{"id":"select","name":"","text":"照明も強く\\n当たりそうだ","trans":"照明似乎\\n也很强"},{"id":"select","name":"","text":"音もよく\\n響きそうだ","trans":"音响声\\n也很响亮"},{"id":"4026001000220020","name":"ルカ","text":"別に……\\n使えるもんはなんでも使うだけ","trans":"没有……\\n物尽其用而已"},{"id":"0000000000000","name":"プロデューサー","text":"（うん、やる気が出てきたみたいだな）","trans":"（嗯，看来拿出了干劲）"},{"id":"4026001000220030","name":"ルカ","text":"……慣れてる","trans":"……习惯了"},{"id":"0000000000000","name":"プロデューサー","text":"（問題なさそうだ）","trans":"（似乎没问题）"},{"id":"4026001000220040","name":"ルカ","text":"わかってんだよ\\nんなことは……","trans":"我知道啊\\n这种小事……"},{"id":"0000000000000","name":"プロデューサー","text":"（しまった……別のことを言えばよかったか）","trans":"（糟了……应该说些别的）"}]}