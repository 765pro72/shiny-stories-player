[
  {
    "idol": "风野灯织",
    "voiceId": "mypage_002_04",
    "original": "ファンのみなさんが好きでいてくれる『風野灯織』のことは、少しだけ、認められるようになりました",
    "translation": "",
    "voicePath": "sounds/voice/characters/002/mypage_002_04.m4a",
    "condition": "アイドルロードを進行して獲得"
  },
  {
    "idol": "风野灯织",
    "voiceId": "mypage_002_head_03",
    "original": "えっ……！\nえっ……！？",
    "translation": "",
    "voicePath": "sounds/voice/characters/002/mypage_002_head_03.m4a",
    "condition": "信頼度をLv.15以上にする"
  },
  {
    "idol": "风野灯织",
    "voiceId": "mypage_002_breast_03",
    "original": "……？\nどうかしましたか？",
