  },
  {
    "idol": "芹泽朝日",
    "voiceId": "mypage_017_belly_03",
    "original": "なんすか？\n仕事終わったっすか？",
    "translation": "",
    "voicePath": "sounds/voice/characters/017/mypage_017_belly_03.m4a",
    "condition": "信頼度をLv.15以上にする"
  },
