  },
  {
    "speaker": "プロデューサー",
    "text": "どうした？",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003022010170,
    "speaker": "めぐる",
    "text": "チアのメンバーって\r\nどんな理由で選ばれたのか知ってる？",
    "charAnim1": "wait1",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010170"
  },
  {
    "id": 2003022010180,
    "speaker": "めぐる",
    "text": "いくつか他のパフォーマンスもあるけど\r\nわたしたちはどうしてチア担当なのかなぁって思って",
    "charAnim1": "wait2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010180"
  },
  {
    "speaker": "プロデューサー",
    "text": "ディレクターさんいわく……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "誰かを元気づける人をメンバーにしたい、\r\nという基準でメンバーを選んだそうだよ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003022010190,
    "speaker": "めぐる",
    "text": "そう思ってもらえてるんだ……！",
