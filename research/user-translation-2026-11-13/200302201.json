      "type": "to",
      "alpha": 0,
      "time": 100
    }
  },
  {
    "speaker": "プロデューサー",
    "text": "たぶん\r\n……ああ、あった。このページだ",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0100"
  },
  {
    "textFrame": "off",
    "se": "1940",
    "waitType": "time",
    "waitTime": 1800
  },
  {
    "id": 2003022010090,
    "speaker": "めぐる",
    "text": "想像してたより、本格的そうだね",
    "charAnim1": "sad2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_wait",
    "charLabel": "meguru",
