    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010220"
  },
  {
    "id": 2003022010230,
    "speaker": "めぐる",
    "text": "だから、今回もよろしくお願いします！",
