    "textFrame": "001",
    "charPosition": {
      "x": 568,
      "y": 640,
      "order": 0
    },
    "charEffect": {
      "type": "to",
      "alpha": 1,
      "time": 100
    },
    "voice": "produce_events/200302201/2003022010090"
  },
  {
    "speaker": "プロデューサー",
    "text": "うーん、そうみたいだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "あまりアクロバティックな技はやらないって書いてあるけど\r\n多少跳んだりはあるみたいだ",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "speaker": "プロデューサー",
    "text": "お、バトンを使う演出もあるみたいだ\r\nちょっと珍しいな",
    "textCtrl": "p",
    "textFrame": "002",
    "se": "0220"
  },
  {
    "id": 2003022010100,
    "speaker": "めぐる",
    "text": "バトンかぁ\r\n高く投げたり、回したり、なんかかっこよさそう！",
    "charAnim1": "shy2",
    "charAnim2": "face_wait",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010100"
  },
  {
    "speaker": "プロデューサー",
    "text": "どんなパフォーマンスになるのか\r\n楽しみだな",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "charAnim1": "wait",
