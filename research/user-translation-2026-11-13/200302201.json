    "nextLabel": "3"
  },
  {
    "label": "1",
    "speaker": "プロデューサー",
    "text": "あ、いや、一緒にと言いつつ\r\n俺はサポートしかできないんだが……",
    "textCtrl": "p",
    "textFrame": "002"
  },
  {
    "id": 2003022010210,
    "speaker": "めぐる",
    "text": "そんなことないよっ",
