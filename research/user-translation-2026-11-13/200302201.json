    "charLabel": "meguru",
    "textCtrl": "p",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010190"
  },
  {
    "id": 2003022010200,
    "speaker": "めぐる",
    "text": "よーし、運動会の競技の練習も、レッスンも、チアも\r\n頑張るぞー！",
    "charAnim1": "anger1",
    "charAnim2": "face_smile",
    "charLipAnim": "lip_smile",
    "charLabel": "meguru",
    "textCtrl": "l",
    "textFrame": "001",
    "voice": "produce_events/200302201/2003022010200"
  },
  {
    "select": "一緒に頑張ろう",
    "nextLabel": "1"
  },
  {
    "select": "休憩も忘れずに",
    "nextLabel": "2"
  },
  {
    "textCtrl": "cm",
