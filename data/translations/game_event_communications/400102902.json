{
  "translator": "loapple",
  "rows": [
    {
      "id": "4001029020010",
      "name": "雛菜",
      "text": "──つんつ～ん",
      "trans": "——戳～戳"
    },
    {
      "id": "4001029020020",
      "name": "雛菜",
      "text": "お～～～い",
      "trans": "喂～～～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──うっ……",
      "trans": "——唔……"
    },
    {
      "id": "4001029020030",
      "name": "小糸",
      "text": "ぴぇ……！\\nあ……こ、これ……",
      "trans": "呀……！\\n啊……这，这个……"
    },
    {
      "id": "4001029020040",
      "name": "小糸",
      "text": "も、もしかして\\nさっきの本の魔法で……？",
      "trans": "难，难道说\\n是刚才那本书的魔法……？"
    },
    {
      "id": "4001029020050",
      "name": "透",
      "text": "かな？",
      "trans": "可能吧？"
    },
    {
      "id": "4001029020060",
      "name": "透",
      "text": "『呼び出し魔法』だって",
      "trans": "上面写着“召唤魔法”"
    },
    {
      "id": "4001029020070",
      "name": "雛菜",
      "text": "じゃあこれが\\nあっちの世界のおいしい物ってこと～？",
      "trans": "那这个就是\\n那边世界的好吃的东西？"
    },
    {
      "id": "4001029020080",
      "name": "透",
      "text": "ふふ\\nじゃない？",
      "trans": "呼呼\\n应该是吧？"
    },
    {
      "id": "4001029020090",
      "name": "円香",
      "text": "……絶対違う",
      "trans": "……绝对不是"
    },
    {
      "id": "4001029020100",
      "name": "透",
      "text": "え？",
      "trans": "诶？"
    },
    {
      "id": "4001029020110",
      "name": "小糸",
      "text": "そ、そもそもあっちの世界のものを\\n呼び出すなんて……",
      "trans": "再，再说了召唤出那边世界的东西什么的……"
    },
    {
      "id": "4001029020120",
      "name": "小糸",
      "text": "け、結構難易度の高い\\n魔法、だよね……？",
      "trans": "应，应该是相当有难度的魔法吧……？"
    },
    {
      "id": "4001029020130",
      "name": "雛菜",
      "text": "本見た感じ\\nちょっと難しそうだったけど～",
      "trans": "看书上写的话\\n感觉是稍微有点难度～"
    },
    {
      "id": "4001029020140",
      "name": "雛菜",
      "text": "さすが透先輩だよね～♡",
      "trans": "真不愧是透前辈～♡"
    },
    {
      "id": "4001029020150",
      "name": "透",
      "text": "ふふっ",
      "trans": "呼呼"
    },
    {
      "id": "4001029020160",
      "name": "透",
      "text": "失敗かもだけど",
      "trans": "虽然也有可能失败了"
    },
    {
      "id": "4001029020170",
      "name": "円香",
      "text": "ほんと、完全に失敗",
      "trans": "真的，彻底的失败"
    },
    {
      "id": "4001029020180",
      "name": "円香",
      "text": "なんなの、これ",
      "trans": "这玩意是啥"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────……",
      "trans": ""
    },
    {
      "id": "4001029020190",
      "name": "円香",
      "text": "こんな間の抜けた顔の生き物\\n初めて見た",
      "trans": "长着如此没出息的脸的生物\\n我还是第一次见"
    },
    {
      "id": "4001029020200",
      "name": "小糸",
      "text": "……こ、これって、\\nニンゲンだよね……？",
      "trans": "……这，这难道是\\n人类？"
    },
    {
      "id": "4001029020210",
      "name": "雛菜",
      "text": "え～！\\nこれニンゲン！？",
      "trans": "诶～！\\n这就是人类！？"
    },
    {
      "id": "4001029020220",
      "name": "雛菜",
      "text": "資料集以外で\\n初めて見た～～～！",
      "trans": "除了在百科全书上\\n这还是第一次见到～～～！"
    },
    {
      "id": "4001029020230",
      "name": "透",
      "text": "えー\\nニンゲンかー",
      "trans": "诶——\\n是人类啊——"
    },
    {
      "id": "4001029020240",
      "name": "透",
      "text": "いけるのかも\\n食べてみたら",
      "trans": "能吃吗\\n咬一口试试"
    },
    {
      "id": "4001029020250",
      "name": "小糸",
      "text": "えっ\\nた、食べれるの……！？",
      "trans": "诶\\n要吃吗……！？"
    },
    {
      "id": "4001029020260",
      "name": "円香",
      "text": "やめといたら",
      "trans": "最好不要"
    },
    {
      "id": "4001029020270",
      "name": "円香",
      "text": "こんなの食べたらお腹壊す",
      "trans": "吃这种东西的话会吃坏肚子的"
    },
    {
      "id": "4001029020280",
      "name": "雛菜",
      "text": "あは～\\n円香先輩は血、吸わないの～？",
      "trans": "啊哈～\\n圆香前辈，不吸下血吗～？"
    },
    {
      "id": "4001029020290",
      "name": "円香",
      "text": "吸わない",
      "trans": "不吸"
    },
    {
      "id": "4001029020300",
      "name": "円香",
      "text": "ヴァンパイアだからって\\n今時ニンゲンの血なんて吸わないから",
      "trans": "就算是吸血鬼\\n现如今也不吸人类的血了"
    },
    {
      "id": "4001029020310",
      "name": "雛菜",
      "text": "へ～……",
      "trans": "诶～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──っ……",
      "trans": "——！……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……痛た…………",
      "trans": "……好痛…………"
    },
    {
      "id": "4001029020320",
      "name": "透",
      "text": "……あ",
      "trans": "……啊"
    },
    {
      "id": "4001029020330",
      "name": "円香",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "4001029020340",
      "name": "小糸",
      "text": "……ぴぇ！",
      "trans": "……呀！"
    },
    {
      "id": "4001029020350",
      "name": "雛菜",
      "text": "あは～\\n起きた～？",
      "trans": "啊哈～\\n醒过来了……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え…………\\nひな──…………",
      "trans": "诶…………\\n雏——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……………………\\nあぁ……",
      "trans": "………………\\n啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうか\\n俺、また──……",
      "trans": "是吗\\n我又——……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……来ちゃったんだな",
      "trans": "……来到这边了啊"
    },
    {
      "id": "4001029020360",
      "name": "雛菜",
      "text": "ん～？\\nそれってどういう意味ですか～？",
      "trans": "嗯～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ええと……",
      "trans": "那个……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "前にもこうやって\\n別の世界に来てしまったことがあって……",
      "trans": "之前也有过像这样\\n来到别的世界……"
    },
    {
      "id": "4001029020370",
      "name": "小糸",
      "text": "え……\\nそ、そんなことあるんだ……",
      "trans": "诶……\\n还会有这种事情……"
    },
    {
      "id": "4001029020380",
      "name": "透",
      "text": "……？",
      "trans": ""
    },
    {
      "id": "4001029020390",
      "name": "透",
      "text": "呼んだんだけど\\nたぶん",
      "trans": "应该是被我召唤过来的\\n大概"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？",
      "trans": "诶？"
    },
    {
      "id": "4001029020400",
      "name": "透",
      "text": "ごめん",
      "trans": "对不起"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、そうだったのか……",
      "trans": "啊，是这样啊……"
    },
    {
      "id": "4001029020410",
      "name": "透",
      "text": "うん",
      "trans": "嗯"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、どうしてここに来たのか\\n理由がわかるだけでもよかったよ",
      "trans": "那至少弄了明白为什么会到这边来，真是太好了"
    },
    {
      "id": "4001029020420",
      "name": "透",
      "text": "そうなんだ",
      "trans": "是吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それで、ここは──……",
      "trans": "然后这里是……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "学校、か……？",
      "trans": "学校，吗……？"
    },
    {
      "id": "4001029020430",
      "name": "雛菜",
      "text": "そうだよ～\\n魔法学校！",
      "trans": "是哟～\\n魔法学校！"
    },
    {
      "id": "4001029020440",
      "name": "雛菜",
      "text": "色んな種族の子が集まって～\\n魔女とか魔法使いになるためにレッスンしてるの！",
      "trans": "积聚了各种种族的孩子～\\n为了成为魔女和魔法使进行着刻苦的训练！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうなのか\\nじゃあみんなは……",
      "trans": "是这样啊\\n那各位是……"
    },
    {
      "id": "4001029020450",
      "name": "雛菜",
      "text": "魔女の卵～！",
      "trans": "魔女之卵～！"
    },
    {
      "id": "4001029020460",
      "name": "小糸",
      "text": "ち、違うよ雛菜ちゃん\\n正式名称は魔法使い見習いだって……！",
      "trans": "不，不是哦雏菜\\n正式名称应该是魔法使见习生……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なるほど……",
      "trans": "原来如此……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それなら、みんなはもしかして\\n俺が元いた世界に帰る方法とかわかったり──……",
      "trans": "这样的话，难道说大家\\n知道让我回到原来的世界的方法——……"
    },
    {
      "id": "4001029020470",
      "name": "円香",
      "text": "……ざっと目を通しましたが",
      "trans": "……粗略地扫了一下"
    },
    {
      "id": "4001029020480",
      "name": "円香",
      "text": "あなたを呼び出したこの本に\\nあなたを元の場所に戻す方法は載っていませんね",
      "trans": "把你召唤出来的这本书里\\n没记载怎么让你回到原来世界的魔法"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………そうか",
      "trans": "…………是吗"
    },
    {
      "id": "4001029020490",
      "name": "小糸",
      "text": "……………………",
      "trans": ""
    },
    {
      "id": "4001029020500",
      "name": "小糸",
      "text": "あ、あの……！",
      "trans": "那，那个……！"
    },
    {
      "id": "4001029020510",
      "name": "小糸",
      "text": "も、もしかしたら別の本……",
      "trans": "说，说不定别的书的话……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん？",
      "trans": "嗯？"
    },
    {
      "id": "4001029020520",
      "name": "小糸",
      "text": "つ、対になる本とかがあって、\\nそ、それに載ってるのかも……",
      "trans": "说，说不定有成对的书\\n记，记载那本上面……"
    },
    {
      "id": "4001029020530",
      "name": "雛菜",
      "text": "あ～！\\nそういうのある～！",
      "trans": "啊～！\\n也有那种书～！"
    },
    {
      "id": "4001029020540",
      "name": "小糸",
      "text": "む、難しい魔法だと、\\nそ、そういうの、結構あるみたいで……",
      "trans": "复，复杂的魔法的话\\n经，经常会这样……"
    },
    {
      "id": "4001029020550",
      "name": "円香",
      "text": "じゃ、図書館にあるのかもね",
      "trans": "那，说不定就在图书馆"
    },
    {
      "id": "4001029020560",
      "name": "円香",
      "text": "この本にも図書館の印字があるし",
      "trans": "而且这本书也有图书馆的印章"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "図書館か……",
      "trans": "图书馆吗……"
    },
    {
      "id": "4001029020561",
      "name": "一同",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "図書館って、どこにあるんだ？",
      "trans": "图书馆是在哪里？"
    },
    {
      "id": "4001029020570",
      "name": "雛菜",
      "text": "ん～",
      "trans": "嗯～"
    },
    {
      "id": "4001029020580",
      "name": "雛菜",
      "text": "ここを出て～……\\n渡り廊下の向こうの棟の１つ上の階だけど",
      "trans": "从这里出去～……\\n在通道走廊对面那栋的上面一层"
    },
    {
      "id": "4001029020590",
      "name": "雛菜",
      "text": "行くの～？",
      "trans": "要去吗～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん、行ってみるよ",
      "trans": "嗯，去看看"
    },
    {
      "id": "4001029020600",
      "name": "透",
      "text": "じゃあ、はい",
      "trans": "那么，给"
    },
    {
      "id": "4001029020610",
      "name": "透",
      "text": "いるでしょ、この本",
      "trans": "你需要这本书吧"
    },
    {
      "id": "4001029020620",
      "name": "透",
      "text": "……えっと\\nツイの本？　見つけるんだったら",
      "trans": "……那个\\n成对的书？ 如果要找的话"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうだな、ありがとう",
      "trans": "说的也是，谢谢你"
    },
    {
      "id": "4001029020630",
      "name": "雛菜",
      "text": "あは～\\nじゃ、行こ～～～！",
      "trans": "啊哈～\\n那，出发吧～～～！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "みんなも一緒に来てくれるのか？",
      "trans": "大家也要一起来吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──はは",
      "trans": "——哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "やっぱり夜の学校って\\n少し不気味だよな……って",
      "trans": "果然夜晚的学校\\n有点渗人啊……嗯"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あれ、みんな……？",
      "trans": "那个，大家……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………………………",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………\\n仕方ない、図書館には着いたみたいだし",
      "trans": "………………\\n没办法，看起来也到图书馆了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……入ってみるか",
      "trans": "……进去看看吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──失礼しまー……",
      "trans": "——打扰了——……"
    }
  ]
}