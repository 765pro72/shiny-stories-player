{"translator":"告","rows":[{"id":"0000000000000","name":"テレビの音声","text":"『もうええわ！　どうも失礼しました～』","trans":"“够啦！ 那么我先失陪了～”"},{"id":"0000000000000","name":"テレビの音声","text":"『わはは──…………』","trans":"“哇哈哈——…………”"},{"id":"4001030020010","name":"甜花","text":"………………","trans":""},{"id":"0000000000000","name":"テレビの音声","text":"『……続いてのコンビは……こちら──…………』","trans":"“……接下来的组合……是——……”"},{"id":"4001030020020","name":"甜花","text":"あぅ…………","trans":"啊呜…………"},{"id":"4001030020030","name":"甜花","text":"……コンティニュー…………","trans":"……续关…………"},{"id":"4001030020040","name":"甜花","text":"………………","trans":""},{"id":"4001030020050","name":"甜花","text":"あふ………","trans":"啊呼……"},{"id":"4001030020060","name":"甜花","text":"…………ん……","trans":"…………嗯……"},{"id":"0000000000000","name":"パパ","text":"『──甜花、甘奈。ちょっとおいで』","trans":"“——甜花，甘奈。过来一下”"},{"id":"0000000000000","name":"パパ","text":"『今日はふたりにおともだちを紹介するよ』","trans":"“今天要给你们两个介绍朋友”"},{"id":"4001030020070","name":"甘奈","text":"『おともだち？』","trans":"“朋友？”"},{"id":"0000000000000","name":"パパ","text":"『ああ、そうだ\\nふたりがたくさんお願いしていた……』","trans":"“对\\n就是你们两个心心念念的……”"},{"id":"4001030020080","name":"甜花","text":"『わ……！\\nデビたろう……！』","trans":"“哇……！\\n恶魔太郎……！”"},{"id":"4001030020090","name":"甘奈","text":"『とっても、とっても、大きい……！』","trans":"“非常，非常，大……！”"},{"id":"0000000000000","name":"ママ","text":"『ふふ、ふたりでかわいがってあげてね』","trans":"“呵呵，你们两个要好好疼它哦”"},{"id":"4001030020100","name":"甜花","text":"『うん……！\\nいっぱい、ぎゅーってする……！』","trans":"“嗯……！\\n会一直，紧紧地——抱它……！”"},{"id":"4001030020110","name":"甘奈","text":"『パパ、ママ……\\nありがとーー！』","trans":"“爸爸，妈妈……\\n谢谢——！”"},{"id":"4001030020120","name":"off","text":"はじめて、デビ太郎がおうちに来た日……","trans":"那是，恶魔太郎来到家里的第一天"},{"id":"4001030020130","name":"off","text":"その日から……毎日、一緒","trans":"从那天开始……每天，都在一起"},{"id":"4001030020140","name":"off","text":"遊ぶ時も、ごはんの時も、おやつの時も……","trans":"去玩的时候，吃饭的时候，吃点心的时候……"},{"id":"4001030020150","name":"off","text":"お昼寝の時も……\\nふたりの真ん中……置いて、ぎゅー……","trans":"睡午觉的时候……\\n就会……放在两个人之间，抱紧紧——……"},{"id":"4001030020160","name":"off","text":"けど、甜花……","trans":"可是，甜花……"},{"id":"4001030020170","name":"off","text":"だんだんデビ太郎に\\nなーちゃん、取られた気持ちになって……","trans":"渐渐地觉得\\n小奈，抢走了恶魔太郎……"},{"id":"4001030020180","name":"甜花","text":"『もういい、なーちゃんにあげる』","trans":"“够了，送给小奈”"},{"id":"4001030020190","name":"off","text":"ぽいって……\\nデビ太郎……投げちゃった","trans":"嘿的一下……\\n就把恶魔太郎……扔了出去"},{"id":"4001030020200","name":"甘奈","text":"『てんかちゃん、どうしたの？\\n……おこってる……？』","trans":"“甜花，怎么了？\\n……在生气吗……？”"},{"id":"4001030020210","name":"甜花","text":"『おこってない』","trans":"“没有生气”"},{"id":"4001030020220","name":"off","text":"ぷいって……\\nそっぽ、向いて","trans":"气鼓鼓地……\\n把头，扭过去"},{"id":"4001030020230","name":"甘奈","text":"『……てんかちゃん』","trans":"“……甜花”"},{"id":"4001030020240","name":"甜花","text":"『…………』","trans":"“…………”"},{"id":"4001030020250","name":"甘奈","text":"『……てんかちゃん』","trans":"“……甜花”"},{"id":"4001030020260","name":"甜花","text":"『………………』","trans":"“………………”"},{"id":"4001030020270","name":"甜花","text":"『……なあに』","trans":"“……什么”"},{"id":"4001030020280","name":"甘奈","text":"『あげる』","trans":"“给你”"},{"id":"4001030020290","name":"甘奈","text":"『あまなばっかりデビたろうとあそんじゃった\\nてんかちゃんも、あそびたかったんでしょ』","trans":"“总是甘奈在和恶魔太郎玩了\\n甜花，也想和它玩吧”"},{"id":"4001030020300","name":"甘奈","text":"『ごめんね』","trans":"“对不起”"},{"id":"4001030020310","name":"甘奈","text":"『てんかちゃんに、あげる』","trans":"“所以这个，还给甜花”"},{"id":"4001030020320","name":"甜花","text":"──むにゃっ","trans":"——呣啊"},{"id":"4001030020330","name":"甜花","text":"………………","trans":""},{"id":"4001030020340","name":"甜花","text":"あぅ…………寝てた……","trans":"啊呜…………睡着了……"},{"id":"0000000000000","name":"テレビの音声","text":"『──冬の夜空に願いを』","trans":"“——向着冬天的夜空许愿”"},{"id":"0000000000000","name":"テレビの音声","text":"『ふたご座流星群がこの冬もやってきます』","trans":"“双子座流星雨也将在这个冬季降临”"},{"id":"0000000000000","name":"テレビの音声","text":"『本日はこちらを特集し──』","trans":"“今天将以这个作为特辑——”"},{"id":"4001030020350","name":"甜花","text":"…………","trans":""},{"id":"4001030020360","name":"甜花","text":"ん……んー……","trans":"嗯……嗯——……"},{"id":"4001030020370","name":"甜花","text":"ごめんね、デビ太郎……\\n枕にしちゃった……","trans":"对不起，恶魔太郎……\\n把你当枕头了……"},{"id":"4001030020380","name":"甜花","text":"なーちゃんのこと……\\n一緒に、見に行こ……？","trans":"一起……\\n去看看，小奈吧……？"},{"id":"4001030020390","name":"甜花","text":"…………","trans":""},{"id":"4001030020400","name":"甘奈","text":"すー……すー……","trans":"呼——……呼——……"},{"id":"4001030020410","name":"甜花","text":"…………","trans":""},{"id":"4001030020420","name":"甜花","text":"……まだ、熱い……","trans":"……还，很热……"},{"id":"4001030020430","name":"甜花","text":"…………","trans":""},{"id":"4001030020440","name":"甜花","text":"明日は…………","trans":"明天…………"},{"id":"4001030020450","name":"甜花","text":"甜花、もうちょっと……頑張るから……ね","trans":"甜花，会再……努力……的"},{"id":"4001030020460","name":"甜花","text":"早く、よくなりますように……\\nなーちゃん……","trans":"希望，小奈……\\n快点好起来……"},{"id":"4001030020470","name":"甜花","text":"…………","trans":""}]}