{
  "translator": "qwen-max-0125",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "透のメンバーカラーは────この色だよ",
      "trans": "透的应援色是────这个颜色哦"
    },
    {
      "id": "4001084020010",
      "name": "透",
      "text": "え、何色？\\nこれ",
      "trans": "诶，什么颜色？\\n这个是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "水色……かな",
      "trans": "水色……大概"
    },
    {
      "id": "4001084020020",
      "name": "透",
      "text": "あー",
      "trans": "啊──"
    },
    {
      "id": "4001084020030",
      "name": "透",
      "text": "オッケー",
      "trans": "OK——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……聞かないのか？\\nなんでこの色にしたのか、とか……",
      "trans": "……透不好奇吗？\\n选这个颜色的理由，之类的……"
    },
    {
      "id": "4001084020040",
      "name": "透",
      "text": "え、うん",
      "trans": "诶，也没啦"
    },
    {
      "id": "4001084020050",
      "name": "透",
      "text": "いいじゃん\\nプロデューサーがそう思ったなら",
      "trans": "没关系\\n制作人觉得行就行"
    },
    {
      "id": "4001084020060",
      "name": "透",
      "text": "──したっけ、そんな話",
      "trans": "──之前还聊过这个来着，记得"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、したよ",
      "trans": "嗯，聊过"
    },
    {
      "id": "4001084020070",
      "name": "透",
      "text": "水色？\\n私",
      "trans": "水色？\\n我"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "水色も、ある",
      "trans": "该说是……不光水色"
    },
    {
      "id": "4001084020080",
      "name": "透",
      "text": "も？",
      "trans": "不光？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そう\\nいろんな色が増えていくんだ、どんどん",
      "trans": "没错\\n这之后，透一定还能——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "透の中に",
      "trans": "——染上更多颜色"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そんなふうに見えるよ",
      "trans": "我向你保证"
    },
    {
      "id": "4001084020090",
      "name": "透",
      "text": "ふふっ────\\nそっか",
      "trans": "呵呵────\\n这样啊"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "────浅倉さん、お待たせしました\\nご準備できましたら収録ブースへお入りください",
      "trans": "────浅仓小姐，久等了\\n准备完成就可以进入录音棚了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、はい……！\\n────透、準備はいいか？",
      "trans": "啊，好的……！\\n────透，怎么样？"
    },
    {
      "id": "4001084020100",
      "name": "透",
      "text": "んー",
      "trans": "嗯──"
    },
    {
      "id": "4001084020110",
      "name": "透",
      "text": "ねー",
      "trans": "呐──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん？",
      "trans": "嗯？"
    },
    {
      "id": "4001084020120",
      "name": "透",
      "text": "じゃあ\\n見逃さないで",
      "trans": "那么\\n别看漏哦"
    },
    {
      "id": "4001084020130",
      "name": "透",
      "text": "全部",
      "trans": "全部"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『お疲れ様。迷わず来れそうか？』",
      "trans": "『辛苦了。能找到路吗？』"
    },
    {
      "id": "4001084020140",
      "name": "円香",
      "text": "『ご心配なく\\nスタジオ近くまで来ました』",
      "trans": "『不用担心\\n我已经到工作室附近了』"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『そうか、よかった』",
      "trans": "『这样啊，那就好』"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『入口がわかりづらいから\\n俺が出て待っていられたらよかったけど』",
      "trans": "『入口有点难找\\n本来我是想去接你的——』"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『透の収録中だから外せなくて\\n悪いな』",
      "trans": "『但透还在录音，所以没法出去\\n抱歉』"
    },
    {
      "id": "4001084020150",
      "name": "円香",
      "text": "『ですから、ご心配なく』",
      "trans": "『不用担心，我找得到』"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『ああ、そうだ』",
      "trans": "『啊，对了』"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『ひょったこくんの看板が目印だよ』",
      "trans": "『迷路的话，可以顺着“ひょったこくん”的招牌过来哦』"
    },
    {
      "id": "4001084020160",
      "name": "円香",
      "text": "ひょったこくん……",
      "trans": "“章鱼火男君”吗……"
    },
    {
      "id": "4001084020170",
      "name": "円香",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "────────────────……",
      "trans": "────────────────……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────お、来たか\\nお疲れ様",
      "trans": "────噢，来了啊\\n辛苦了"
    },
    {
      "id": "4001084020190",
      "name": "円香",
      "text": "お疲れ様です",
      "trans": "您辛苦了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "迷わず来れたか？",
      "trans": "找到路了吗？"
    },
    {
      "id": "4001084020200",
      "name": "円香",
      "text": "見ての通り",
      "trans": "如你所见"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "────……",
      "trans": "────……"
    },
    {
      "id": "4001084020220",
      "name": "円香",
      "text": "浅倉の歌",
      "trans": "浅仓的歌"
    },
    {
      "id": "4001084020230",
      "name": "円香",
      "text": "聴いていましたよね\\nお邪魔してすみません",
      "trans": "打扰到你\\n听她唱歌了吧，不好意思"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、いや……",
      "trans": "啊，不……"
    },
    {
      "id": "4001084020240",
      "name": "円香",
      "text": "私は向こうで待機しているので\\nどうぞお構いなく",
      "trans": "我去那边等着\\n请不用在意"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "────────────────……",
      "trans": "────────────────……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（透は今のところ、問題なさそうだ）",
      "trans": "（透目前看起来没什么问题）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（むしろ、気がかりなのは……）",
      "trans": "（更让我担心的反倒是……）"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "────────♪",
      "trans": "────────♪"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（円香は、透の歌を聴いている）",
      "trans": "（円香，在听透唱歌）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（聴いていないように見えるけど）",
      "trans": "（看似漠不关心……）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（音をひとつひとつ\\nなぞるように……────）",
      "trans": "（但透的每个音符\\n她都没有错过……────）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（……おそらくは、無自覚に）",
      "trans": "（……大概，她也没意识到吧）"
    },
    {
      "id": "4001084020270",
      "name": "透",
      "text": "……あ、樋口",
      "trans": "……啊，樋口"
    },
    {
      "id": "4001084020280",
      "name": "円香",
      "text": "お疲れ",
      "trans": "辛苦了"
    },
    {
      "id": "4001084020290",
      "name": "透",
      "text": "おー",
      "trans": "哦——"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "少し換気するのでお待ちくださいね",
      "trans": "我们要稍微通一下风，请稍等"
    },
    {
      "id": "4001084020300",
      "name": "透",
      "text": "あー……\\nなんか飲みたい、めっちゃ",
      "trans": "啊——……\\n想喝点什么了，突然"
    },
    {
      "id": "4001084020310",
      "name": "円香",
      "text": "水は？",
      "trans": "水？"
    },
    {
      "id": "4001084020320",
      "name": "透",
      "text": "じゃなくて\\n炭酸とか",
      "trans": "不是啦\\n碳酸饮料之类的"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "────プロデューサーさん",
      "trans": "────制作人先生"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、はい",
      "trans": "啊，我在"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "浅倉さん、やっぱ変わりましたよね──……",
      "trans": "浅仓小姐，果然不一样了呢──……"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "なんていうか、目つきが変わったっていうか\\nまだ足りないって言ってるみたいな────",
      "trans": "怎么说呢，感觉眼神变了\\n或者说仍旧欲求不满────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ええ",
      "trans": "嗯"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "……あ、換気オーケーみたいです",
      "trans": "……啊，通风好像结束了"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "樋口さん、ご準備できましたら\\nブースにお入りください！",
      "trans": "樋口小姐，准备好了的话\\n请进入录音棚"
    },
    {
      "id": "4001084020330",
      "name": "円香",
      "text": "……はい、よろしくお願いします",
      "trans": "……好的，请多关照了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "円香\\nそれじゃ、また後で",
      "trans": "那圆香\\n待会儿见"
    },
    {
      "id": "4001084020340",
      "name": "円香",
      "text": "ええ",
      "trans": "嗯"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "────樋口さん、聴こえますかー？",
      "trans": "────樋口小姐，能听到吗？"
    },
    {
      "id": "4001084020350",
      "name": "円香",
      "text": "はい",
      "trans": "能"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "では早速録っていきますね\\nよろしくお願いします",
      "trans": "那么我们马上开始录制吧\\n请多关照"
    },
    {
      "id": "4001084020360",
      "name": "円香",
      "text": "……────────────────",
      "trans": "……────────────────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "円香は……どうだ？\\n実際に自分のメンバーカラーを見て……",
      "trans": "圆香……在看见自己的应援色之后\\n有什么想法吗……？"
    },
    {
      "id": "4001084020370",
      "name": "円香",
      "text": "は？",
      "trans": "哈？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、ないならないでいいんだ\\n一応聞いておこうと思って",
      "trans": "不，没有的话也无所谓\\n就随便问问啦"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "表情だけだと、その……わからないからさ",
      "trans": "毕竟光看表情的话，那个……看不太出来"
    },
    {
      "id": "4001084020380",
      "name": "円香",
      "text": "特に何も",
      "trans": "没什么想法"
    },
    {
      "id": "4001084020390",
      "name": "円香",
      "text": "誰かが変えたいと言えば\\nそれでもいいですし",
      "trans": "谁想改的话\\n改也可以"
    },
    {
      "id": "4001084020400",
      "name": "円香",
      "text": "私はなんでも",
      "trans": "我无所谓"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "透、待たせてごめんな\\n終わったら円香と一緒に送っていくから",
      "trans": "透，抱歉让你久等了\\n等结束了我送你和圆香回去"
    },
    {
      "id": "4001084020410",
      "name": "透",
      "text": "んー",
      "trans": "嗯——"
    },
    {
      "id": "4001084020420",
      "name": "透",
      "text": "寝てていい？\\n終わるまで",
      "trans": "可以睡一会吗？\\n睡到结束"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、ここはちょっと……\\n人が通るからな……",
      "trans": "不，这儿还是不太……\\n会有人经过的……"
    },
    {
      "id": "4001084020430",
      "name": "透",
      "text": "じゃ、目\\n閉じてるだけ",
      "trans": "那就，闭一会儿眼睛"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……疲れてるのか？",
      "trans": "……累了吗？"
    },
    {
      "id": "4001084020440",
      "name": "透",
      "text": "んー……\\nなんか……",
      "trans": "嗯——……\\n总听到……"
    },
    {
      "id": "4001084020450",
      "name": "透",
      "text": "違くて、ずっと\\n音",
      "trans": "哪里、不对劲\\n的声音"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……歌、ちょっと難しかったかな",
      "trans": "……是不是歌有点难了？"
    },
    {
      "id": "4001084020460",
      "name": "透",
      "text": "そうじゃなくて────",
      "trans": "不是那个意思────"
    },
    {
      "id": "0000000000000",
      "name": "円香",
      "text": "────────────────……",
      "trans": "────────────────……"
    },
    {
      "id": "4001084020480",
      "name": "off",
      "text": "あ",
      "trans": "啊。"
    },
    {
      "id": "4001084020490",
      "name": "off",
      "text": "その音",
      "trans": "那个声音"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "4001084020500",
      "name": "透",
      "text": "ねー",
      "trans": "呐——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……あ、うん\\nどうした？",
      "trans": "……啊，嗯\\n怎么了？"
    },
    {
      "id": "4001084020510",
      "name": "透",
      "text": "やりたいかも",
      "trans": "可能想要"
    },
    {
      "id": "4001084020520",
      "name": "透",
      "text": "もっかい",
      "trans": "再录一遍"
    },
    {
      "id": "4001084020530",
      "name": "透",
      "text": "歌",
      "trans": "歌"
    }
  ]
}