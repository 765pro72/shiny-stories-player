{"translator":"告","rows":[{"id":"4001032030010","name":"小糸","text":"──あ、ここのおうちも\\n門松立ってる……","trans":"——啊，这家也是\\n门口摆了门松……"},{"id":"4001032030020","name":"小糸","text":"わ、寒い────","trans":"哇，好冷————"},{"id":"0000000000000","name":"近所の住民","text":"こんにちはー","trans":"你好——"},{"id":"4001032030030","name":"小糸","text":"あ……\\nこ、こんにちは……！","trans":"啊……\\n你，你们好……！"},{"id":"0000000000000","name":"近所の家族","text":"お父さーん\\n窓拭きクリーナー、切れたー","trans":"爸爸——\\n擦窗的清洁剂用完了——"},{"id":"0000000000000","name":"近所の家族","text":"ああ、ちょっと待って────","trans":"好，等一下"},{"id":"4001032030040","name":"小糸","text":"──\\n大晦日だな……","trans":"——\\n果然是除夕啊……"},{"id":"4001032030050","name":"透","text":"────しょ、と…………","trans":"————好嘞…………"},{"id":"4001032030060","name":"円香","text":"…………","trans":""},{"id":"4001032030070","name":"透","text":"……うわ、やば────","trans":"……呜哇，不好————"},{"id":"4001032030080","name":"透","text":"……\\nやり直しかー……","trans":"……\\n只能重来吗——……"},{"id":"4001032030090","name":"円香","text":"…………","trans":""},{"id":"4001032030100","name":"円香","text":"……手伝う？　掃除","trans":"……要帮忙吗？ 打扫"},{"id":"4001032030110","name":"透","text":"……え？\\nあー……","trans":"……诶？\\n啊——……"},{"id":"4001032030120","name":"透","text":"やる？","trans":"要来吗？"},{"id":"4001032030130","name":"円香","text":"……","trans":""},{"id":"4001032030140","name":"透","text":"逃げてきたんじゃないの\\n樋口んちの大掃除","trans":"你是逃跑的吧\\n从自家的打扫里"},{"id":"4001032030150","name":"円香","text":"……すす払いするって\\n追い出されただけ","trans":"……他们要大扫除\\n就把我赶出来了"},{"id":"4001032030160","name":"透","text":"本格的じゃん\\nめっちゃ","trans":"动真格啊\\n厉害"},{"id":"4001032030170","name":"円香","text":"何したらいい？","trans":"我要干什么？"},{"id":"4001032030180","name":"透","text":"おー\\nじゃ、すす払い","trans":"哦——\\n那，大扫除"},{"id":"4001032030190","name":"円香","text":"……\\nそれ手伝う","trans":"……\\n我帮你这个"},{"id":"4001032030200","name":"透","text":"え、これ？","trans":"诶，这个？"},{"id":"4001032030210","name":"円香","text":"本、あいうえお順に並べてるんでしょ\\n……それが掃除になるのか知らないけど","trans":"书要按假名顺序排吧\\n……虽然不知道这算不算打扫"},{"id":"4001032030220","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"4001032030230","name":"透","text":"なんか、押し入れにたまってて\\n小さい時読んだのとか","trans":"柜子里好像放了一堆\\n小时候看过的书什么的"},{"id":"4001032030240","name":"円香","text":"並べてる説明になってない","trans":"完全没说怎么排啊"},{"id":"4001032030250","name":"透","text":"じゃ、サンキュ\\nまかせた","trans":"那谢谢\\n交给你了"},{"id":"4001032030260","name":"円香","text":"……","trans":""},{"id":"4001032030270","name":"透","text":"──あ、先だから\\nひらがなが","trans":"——啊，要先放\\n平假名开头的"},{"id":"4001032030280","name":"透","text":"カタカナとひらがなかぶったら\\nひらがなが先","trans":"片假名和平假名一样的\\n先放平假"},{"id":"4001032030290","name":"円香","text":"……50音順じゃなくなる","trans":"……这就不是五十音顺序了"},{"id":"0000000000000","name":"オウム","text":"ノロマ！　ノロマ！","trans":"慢性子！ 慢性子！"},{"id":"4001032030300","name":"円香","text":"何、こいつ\\nうるさい","trans":"这家伙搞什么\\n好吵"},{"id":"4001032030310","name":"透","text":"──片付けるよ\\nおまえも","trans":"——来打扫啊\\n你也来"},{"id":"4001032030320","name":"円香","text":"……あ、初詣の前に、\\n一回、家に戻るから────","trans":"……啊，参拜之前，\\n我会先回一次家————"},{"id":"0000000000000","name":"雛菜の母","text":"えび天とかき揚げ、\\nどっちにしようかしら","trans":"炸虾和炸什锦，\\n选哪个好呢"},{"id":"4001032030330","name":"雛菜","text":"パパはえび天が\\nいいんじゃない～？","trans":"爸爸应该\\n想吃炸虾吧～？"},{"id":"0000000000000","name":"雛菜の母","text":"そうよね～\\n雛菜ちゃんは？","trans":"也对～\\n雏菜呢？"},{"id":"4001032030340","name":"雛菜","text":"雛菜も一緒～！","trans":"雏菜也一样～！"},{"id":"0000000000000","name":"雛菜の母","text":"ママも一緒だから、えび天のお蕎麦３つね～\\n──みんなも、食べてから集合？","trans":"妈妈也一样，所以是3份炸虾荞麦面呢～\\n——其他人也都是吃完再集合？"},{"id":"4001032030350","name":"雛菜","text":"うん～","trans":"嗯～"},{"id":"0000000000000","name":"雛菜の母","text":"それじゃあ、\\nおすそ分けなんていらない？","trans":"那，\\n要分一点给她们吗？"},{"id":"4001032030360","name":"雛菜","text":"ん～\\n大丈夫だと思う！","trans":"嗯～\\n应该没关系！"},{"id":"0000000000000","name":"雛菜の母","text":"は～い\\n行きはパパに車出してもらったら？","trans":"好～\\n要不要让爸爸开车载你去？"},{"id":"4001032030370","name":"雛菜","text":"いいよ～\\n歩いていける！","trans":"不用～\\n走路就能到！"},{"id":"4001032030380","name":"雛菜","text":"大晦日の道って\\n特別なんだって～","trans":"除夕的道路\\n可是很特别的～"},{"id":"0000000000000","name":"雛菜の母","text":"大晦日の道？","trans":"除夕的道路？"},{"id":"4001032030390","name":"雛菜","text":"そう～","trans":"是吗～"},{"id":"4001032030400","name":"透","text":"小糸ちゃーん……","trans":"小糸……"},{"id":"4001032030410","name":"小糸","text":"──あ……！\\nじゃあ、行ってきます……！","trans":"——啊……！\\n那我出门了……！"},{"id":"0000000000000","name":"小糸の母","text":"透ちゃん、円香ちゃん、寒いのにごめんなさい\\n小糸、みんなに迷惑掛けないようにしなさいよ","trans":"小透，圆香，这么冷真是麻烦你们了\\n小糸，不要给大家添麻烦"},{"id":"4001032030420","name":"小糸","text":"う、うん……\\n大丈夫だよ","trans":"啊，嗯……\\n没问题的"},{"id":"4001032030430","name":"小糸","text":"お、お待たせ……！\\n行こう……！","trans":"久，久等了……！\\n走吧……！"},{"id":"4001032030440","name":"透","text":"うん\\nじゃ次、雛菜のとこ","trans":"嗯\\n接下来，雏菜家"},{"id":"4001032030450","name":"小糸","text":"うん……！","trans":"嗯……！"},{"id":"4001032030460","name":"小糸","text":"──わ、もう聞こえてるね……！","trans":"——哇，已经听得到了啊……！"},{"id":"4001032030470","name":"透","text":"ふふっ\\n鳴らさなきゃいけないから、108回","trans":"呵呵\\n不得不敲108次呢"},{"id":"4001032030480","name":"小糸","text":"そ、そっか……！","trans":"是，是吗……！"},{"id":"4001032030490","name":"小糸","text":"……！\\n今、何回目かな……","trans":"……！\\n刚才那是第几次呢……"},{"id":"4001032030500","name":"円香","text":"大丈夫\\n108回越えても、つかせてもらえる","trans":"没问题\\n就算超了108次，也可以继续敲的"},{"id":"4001032030510","name":"小糸","text":"そ、そうだよね……！","trans":"也，也对……！"},{"id":"4001032030520","name":"透","text":"──ふふっ","trans":"——呵呵"},{"id":"4001032030530","name":"透","text":"いいねー\\nやる気、小糸ちゃん","trans":"真好啊\\n小糸很有干劲"},{"id":"4001032030540","name":"小糸","text":"う、うん……！","trans":"啊，嗯……！"},{"id":"4001032030550","name":"小糸","text":"最近、レッスンとかなくて\\n結構家にいたから……","trans":"因为最近也没有课程\\n都是在家里……"},{"id":"4001032030560","name":"円香","text":"ああ","trans":"是啊"},{"id":"4001032030570","name":"小糸","text":"それに……\\n11時半だよ、11時半……！","trans":"而且……\\n已经11点半了，11点半……！"},{"id":"4001032030580","name":"小糸","text":"みんなで……！","trans":"大家会一起……！"},{"id":"4001032030590","name":"円香","text":"──普段だったら、出歩けないからね","trans":"——平常的话，大家不会这样出去散步呢"},{"id":"4001032030600","name":"小糸","text":"えへへ……\\nうん……！","trans":"诶嘿嘿……\\n嗯……！"},{"id":"4001032030610","name":"透","text":"特別だから\\n今日は","trans":"因为\\n今天很特别"},{"id":"4001032030620","name":"小糸","text":"うん……！","trans":"嗯……！"},{"id":"4001032030630","name":"小糸","text":"夜なのに道、\\nきらきらしてるね────","trans":"明明是晚上，\\n道路却一闪一闪————"},{"id":"4001032030640","name":"透","text":"────","trans":""},{"id":"4001032030650","name":"透","text":"濡れてるみたいな\\n光ってるみたいな道","trans":"好像淋湿了一样\\n又好像在发光的道路"},{"id":"4001032030660","name":"透","text":"どれだけ先の音も伝えられる\\n透明な空気","trans":"无论多远的声音都能传递的\\n透明的空气"},{"id":"4001032030670","name":"透","text":"何かが終わる時と\\n始まる時がまざる","trans":"有什么要结束的时间\\n和开始的时间交错在一起"},{"id":"4001032030680","name":"透","text":"いつでもない時間","trans":"不像平常的时间"},{"id":"4001032030690","name":"透","text":"してるね\\nきらきら","trans":"确实有呢\\n一闪一闪"},{"id":"4001032030700","name":"透","text":"大晦日の道","trans":"除夕的道路"},{"id":"4001032030710","name":"透","text":"どこにも\\nつながってない道","trans":"哪里\\n都无法通往的道路"},{"id":"4001032030720","name":"円香","text":"……","trans":""},{"id":"4001032030730","name":"円香","text":"車、通らないのはいいかもね","trans":"没车经过也不错呢"},{"id":"4001032030740","name":"小糸","text":"うん……！\\nもう少し行ったら歩行者天国してるんじゃないかな……！","trans":"嗯……！\\n感觉再走一段路就像是在走步行者天国了……！"},{"id":"4001032030750","name":"透","text":"へぇ\\nじゃ","trans":"嘿\\n那"},{"id":"4001032030760","name":"透","text":"ジャンプしよ\\n０時０分00000秒に","trans":"一起跳吧\\n0点0分00000秒的时候"},{"id":"4001032030770","name":"小糸","text":"……！\\nえ……？","trans":"……！\\n诶……？"},{"id":"4001032030780","name":"透","text":"真ん中で\\n道の","trans":"在路上\\n正中间"},{"id":"4001032030790","name":"円香","text":"ええ……","trans":"诶……"},{"id":"4001032030800","name":"小糸","text":"……！\\nい、いいけど……","trans":"……！\\n是，是可以……！"},{"id":"4001032030810","name":"円香","text":"すごく悪目立ちする","trans":"一看就惹人嫌"},{"id":"4001032030811","name":"透＆小糸","text":"あははっ……","trans":"啊哈哈……"},{"id":"4001032030820","name":"小糸","text":"こ、こんばんは\\n雛菜ちゃん……！","trans":"晚，晚上好\\n雏菜……！"},{"id":"4001032030830","name":"雛菜","text":"は～い","trans":"好～"},{"id":"4001032030840","name":"雛菜","text":"あけましておめでと～！","trans":"新年快乐～！"},{"id":"4001032030850","name":"透","text":"イエー\\nおめでと～","trans":"耶——\\n快乐～"},{"id":"4001032030860","name":"円香","text":"ういうい","trans":"耶耶"},{"id":"4001032030870","name":"小糸","text":"あ、あと10分あるけど……！","trans":"还，还有10分钟啊……！"},{"id":"0000000000000","name":"雛菜の父","text":"じゃあ、みんなも\\n気を付けて行ってくるんだよ","trans":"那大家\\n路上要小心啊"},{"id":"4001032030880","name":"小糸","text":"は、はい！\\n行ってきます……！","trans":"好，好的！\\n我们出发了……！"},{"id":"4001032030890","name":"雛菜","text":"わ、もう鳴ってる～！","trans":"哇，已经在响了～！"},{"id":"4001032030900","name":"透","text":"うん","trans":"嗯"},{"id":"4001032030910","name":"小糸","text":"雛菜ちゃんのお父さん、\\n久しぶりだったね……！","trans":"好久没见到，\\n雏菜的爸爸了呢……！"},{"id":"4001032030920","name":"円香","text":"こんばんはって\\n言いそびれた","trans":"忘了和他说\\n晚上好了"},{"id":"4001032030930","name":"雛菜","text":"あ～\\n明日から温泉だから、色々準備してた！","trans":"啊～\\n明天要去温泉，所以准备了好多东西！"},{"id":"4001032030940","name":"小糸","text":"いいな、明日からかぁ……！\\n──あ……","trans":"真好啊，明天开始去吗……！\\n——啊……"},{"id":"4001032030950","name":"小糸","text":"そ、そうだ\\nみんな、どうするの……？","trans":"对，对了\\n你们要怎么办……？"},{"id":"4001032030960","name":"円香","text":"……おとといのやつ","trans":"……前天那件事"},{"id":"4001032030970","name":"透","text":"え","trans":"诶"},{"id":"4001032030980","name":"雛菜","text":"ん～……\\nあ、アイドルの運動会みたいなの～？","trans":"嗯～……\\n啊，像是偶像运动会那个～？"},{"id":"4001032030990","name":"小糸","text":"そ、そう……\\nテレビのやつ……！","trans":"对，对……！\\n电视节目那个……！"},{"id":"4001032031000","name":"透","text":"あー","trans":"啊——"},{"id":"4001032031010","name":"雛菜","text":"いつだっけ～？\\nなんか結構すぐだったよね～","trans":"什么时候啊～？\\n感觉好像最近就要拍了～"},{"id":"4001032031020","name":"雛菜","text":"雛菜、帰ってきてるかな～","trans":"雏菜，那时候回来了没啊～"},{"id":"4001032031030","name":"円香","text":"急なオファーだし、\\n適当な扱いされて終わると思うけど","trans":"这么唐突的工作，\\n待遇应该很随便，然后就结束了吧"},{"id":"4001032031040","name":"小糸","text":"そ、そっか……","trans":"是，是吗……"},{"id":"4001032031050","name":"透","text":"出たい？\\n小糸ちゃん","trans":"想上吗？\\n小糸"},{"id":"4001032031060","name":"小糸","text":"……え！\\nう、ううん、そういうわけじゃなくて……","trans":"……诶！\\n没，没有，我没这个意思……"},{"id":"4001032031070","name":"円香","text":"返事しないといけないからでしょ\\n期日、明日","trans":"不回复不行吧\\n期限，就是明天"},{"id":"4001032031080","name":"小糸","text":"う、うん……","trans":"啊，嗯……"},{"id":"4001032031090","name":"透","text":"おー\\nさすが","trans":"哦——\\n不愧是你"},{"id":"4001032031100","name":"円香","text":"で、どうする","trans":"然后呢，怎么办"},{"id":"4001032031110","name":"透","text":"え？\\nんー……","trans":"诶？\\n嗯——……"},{"id":"4001032031120","name":"透","text":"出たい人ー","trans":"想上的人——"},{"id":"4001032031121","name":"一同","text":"………………","trans":""},{"id":"4001032031130","name":"透","text":"遠慮なしで","trans":"不用客气"},{"id":"4001032031131","name":"一同","text":"…………","trans":""},{"id":"4001032031140","name":"透","text":"じゃ、いいんじゃん\\nなしで","trans":"那就这样吧\\n没人要上"},{"id":"4001032031150","name":"円香","text":"ん","trans":"嗯"},{"id":"4001032031160","name":"雛菜","text":"ん～！","trans":"嗯～！"},{"id":"4001032031170","name":"小糸","text":"う、うん……！\\nわたしも、親戚の所に行ったりするし……","trans":"啊，嗯……！\\n我也要去亲戚家串门……"},{"id":"4001032031180","name":"小糸","text":"プロデューサーさん、\\n今回は無理しなくていいって、言ってたもんね","trans":"制作人先生，\\n也说了这次不用勉强"},{"id":"4001032031190","name":"透","text":"オッケー\\nなしなし","trans":"OK\\n没人没人"},{"id":"4001032031200","name":"小糸","text":"う、うん……！","trans":"嗯，嗯……！"},{"id":"4001032031210","name":"透","text":"……ふふっ\\n年内最後の依頼だけど","trans":"……呵呵\\n虽然是年内最后的工作"},{"id":"4001032031220","name":"円香","text":"年明け最初の\\n仕事でもあるけど","trans":"也是年初\\n第一份工作"},{"id":"4001032031230","name":"雛菜","text":"ん～\\nま、仕方ないね～","trans":"嗯～\\n算了，也没办法～"},{"id":"4001032031240","name":"円香","text":"──\\n12時になる","trans":"——\\n快到12点了"},{"id":"4001032031250","name":"小糸","text":"……！","trans":""},{"id":"4001032031260","name":"雛菜","text":"やは～！\\nハッピーニューイヤー！","trans":"呀哈～！\\n新年快乐！"},{"id":"4001032031270","name":"透","text":"やばい……\\n飛ばなきゃ","trans":"不妙……\\n该跳了"},{"id":"4001032031280","name":"小糸","text":"そ、そうだった……！","trans":"对，对哦……！"},{"id":"4001032031290","name":"雛菜","text":"へ～\\n何～？","trans":"诶～\\n什么～？"},{"id":"4001032031300","name":"小糸","text":"０時０分00000秒に\\nジャンプするんだって……！","trans":"说是要在\\n0点0分00000秒的时候起跳……！"},{"id":"4001032031310","name":"雛菜","text":"そしたらどうなるの～？","trans":"然后会怎样～？"},{"id":"4001032031320","name":"円香","text":"特別な感じになる","trans":"会有特别的感觉"},{"id":"4001032031330","name":"雛菜","text":"あは～！\\nじゃ雛菜もやる～～","trans":"啊哈～！\\n那雏菜也要参加～～"},{"id":"4001032031340","name":"透","text":"難しいよ","trans":"很难哦"},{"id":"4001032031350","name":"透","text":"ぴったり、ジャストで\\n地面から離れなきゃダメだから","trans":"要准时，正好\\n让脚从地面离开才行"},{"id":"4001032031360","name":"雛菜","text":"何それ～！","trans":"在说什么啊～！"},{"id":"4001032031370","name":"透","text":"０時０分00000秒きっかりに\\n飛んだら、どうなるか","trans":"在0点0分00000秒准点\\n起跳的话，会怎么样呢"},{"id":"4001032031380","name":"透","text":"やばいやばい\\nあと10秒","trans":"糟了糟了\\n还有10秒"},{"id":"4001032031390","name":"雛菜","text":"９、８……！","trans":"9，8……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4001032031400","name":"小糸","text":"７、６……！","trans":"7，6……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4001032031410","name":"透","text":"５……","trans":"5……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4001032031420","name":"透","text":"樋口","trans":"樋口"},{"id":"4001032031430","name":"円香","text":"……\\n２、１────","trans":"……\n2，1────"},{"id":"4001032031440","name":"透","text":"いけっ","trans":"跳吧"},{"id":"4001032031441","name":"一同","text":"──────","trans":""},{"id":"4001032031450","name":"透","text":"０時０分00000秒きっかりに\\n飛んだら","trans":"在0点0分00000秒准点\\n起跳的话"},{"id":"4001032031460","name":"雛菜","text":"あけましておめでと～！","trans":"新年快乐～！"},{"id":"4001032031470","name":"小糸","text":"あけましておめでとう……！","trans":"新年快乐……！"},{"id":"4001032031480","name":"円香","text":"おめでとう","trans":"快乐"},{"id":"4001032031490","name":"透","text":"イエー","trans":"耶——"},{"id":"4001032031500","name":"透","text":"きっと\\nすべては消えて","trans":"一定是\\n所有东西都消失"},{"id":"4001032031510","name":"透","text":"ふふっ\\nニューイエー……！","trans":"呵呵\\nNew Yeah……！"},{"id":"4001032031520","name":"透","text":"ほんとの世界になる","trans":"成为一个真正的世界"},{"id":"4001032031530","name":"小糸","text":"えへへ……","trans":"诶嘿嘿……"},{"id":"4001032031540","name":"雛菜","text":"ニューイエーって何～？","trans":"New Yeah是什么～？"},{"id":"4001032031550","name":"円香","text":"ニューイエー","trans":"New Yeah"}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462f