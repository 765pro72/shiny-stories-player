      "name": "雛菜",
      "text": "そうなんだ～",
      "trans": "这样啊～"
    },
    {
      "id": "4001059030110",
      "name": "雛菜",
      "text": "雛菜も見る～\\nこっちの押し入れもやる～？",
      "trans": "雏菜也来～\\n这边的橱柜也要弄吗～？"
    },
    {
      "id": "4001059030120",
      "name": "透",
      "text": "あー\\nおねしゃす",
      "trans": "啊——\\n拜托了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────フォー……エバー……",
      "trans": "————永——……远——……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\nああ……企業の４周年企画…………",
      "trans": "……\\n啊啊……企业的4周年企划…………"
    },
    {
      "id": "0000000000000",
      "name": "企業公式の投稿",
      "text": "『あなたやあなたの隣の原石アーティストを\\nハッシュタグでレコメン！してください』",
      "trans": "“请将你或你身边的原石艺术家、歌手\\n带上标签推荐出来！”"
    },
    {
      "id": "0000000000000",
      "name": "企業公式の投稿",
      "text": "『集計数の上位アーティストを\\nビッグアリーナでのライブステージに招聘！』",
      "trans": "“最终计数靠前的艺术家\\n将会被招待到圆形大剧场的LIVE舞台上！”"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……え、原石……新人限定か……？",
      "trans": "……诶、原始……新人限定吗……？"
    },
    {
      "id": "4001059030130",
      "name": "雛菜",
      "text": "欲しいのあったら\\n分けといてもいい～？",
      "trans": "如果有想要的\\n能分出来吗～？"
    },
    {
      "id": "4001059030140",
      "name": "小糸",
      "text": "……！\\nふ、冬服を分けてるだけだから……！",
      "trans": "……！\\n这、这就只是在分冬装而已啦……！"
    },
    {
      "id": "4001059030150",
      "name": "雛菜",
      "text": "────あは～\\n裁縫セット！　久しぶりに見た～",
      "trans": "————啊哈～\\n裁缝套装！　好久没见过了～"
    },
    {
      "id": "4001059030160",
      "name": "透",
      "text": "おー\\nマジ？　どれ？",
      "trans": "噢——\\n真假？　在哪？"
    },
    {
      "id": "4001059030170",
      "name": "小糸",
      "text": "ひ、雛菜ちゃん……！",
      "trans": "雏、雏菜……！"
    },
    {
      "id": "0000000000000",
      "name": "企業公式の投稿",
      "text": "『ビッグアーティストも多数登場する夢のフェスイベント\\nプロデビューへのチャンスをつかもう！』",
      "trans": "“大艺术家们也会登场的梦一般的庆典活动\\n抓住成为专业的出道机会吧！”"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "企業公式の投稿",
      "text": "『弊社４周年にちなみ、今回は『４人組』を大募集！\\nジャンルを問わずまずはレコメン！　#4year4ever』",
      "trans": "“敝公司4周年一同，本次是“4人组”大募集！\\n不分类别总之先推荐！　＃4year4ever”"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……？\\nなんで────",
      "trans": "……？\\n为什么————"
    },
