{"translator":"AI初翻（gpt-4o）+奥術心白重译","rows":[{"id":"4001074040010","name":"ルカ","text":"──────","trans":"──────"},{"id":"4001074040020","name":"ルカ","text":"美琴────","trans":"美琴────"},{"id":"4001074040030","name":"美琴","text":"……ルカ","trans":"……路加"},{"id":"4001074040040","name":"ルカ","text":"………………","trans":"………………"},{"id":"4001074040050","name":"美琴","text":"──よろしくね","trans":"──请多关照呢"},{"id":"4001074040060","name":"ルカ","text":"え？","trans":"诶？"},{"id":"4001074040070","name":"美琴","text":"ライブイベントのこと","trans":"关于演出活动的事"},{"id":"4001074040080","name":"ルカ","text":"…………──","trans":"…………──"},{"id":"4001074040090","name":"美琴","text":"シーズも、出演することになったみたいだから","trans":"SHHis好像也会上台出演"},{"id":"4001074040100","name":"ルカ","text":"シーズ","trans":"SHHis"},{"id":"4001074040110","name":"美琴","text":"……よかった","trans":"……太好了"},{"id":"4001074040120","name":"美琴","text":"ルカとまた、同じステージに立てて","trans":"能再次和路加登上同一个舞台"},{"id":"4001074040130","name":"ルカ","text":"────","trans":"────"},{"id":"4001074040140","name":"ルカ","text":"…………同じ……","trans":"…………同一个……"},{"id":"4001074040150","name":"ルカ","text":"違う","trans":"不一样"},{"id":"4001074040160","name":"美琴","text":"これから、事務所で\\nそのイベントの打ち合わせなの","trans":"接下来，要在事务所那\\n开个关于活动的碰头会"},{"id":"4001074040170","name":"ルカ","text":"………………","trans":"………………"},{"id":"4001074040180","name":"美琴","text":"──そうだ","trans":"──对了"},{"id":"4001074040190","name":"美琴","text":"プロデューサー、打ち合わせの前に\\nコメティックの送り迎えがあるって言っていたっけ","trans":"制作人说，在开会之前\\n得去接CoMETIK来着"},{"id":"4001074040200","name":"ルカ","text":"コメティック","trans":"CoMETIK"},{"id":"4001074040210","name":"美琴","text":"でも、ルカがここにいるってことは","trans":"但是，路加在这里的话"},{"id":"4001074040220","name":"美琴","text":"プロデューサーはもう\\n事務所に着いているかな","trans":"就说明制作人\\n已经到事务所了吧"},{"id":"4001074040230","name":"ルカ","text":"………………","trans":"………………"},{"id":"4001074040240","name":"ルカ","text":"知らない","trans":"不知道"},{"id":"4001074040250","name":"ルカ","text":"────","trans":"────"},{"id":"4001074040260","name":"美琴","text":"？","trans":"？"},{"id":"4001074040270","name":"ルカ","text":"…………レモンティー","trans":"…………柠檬茶"},{"id":"4001074040280","name":"美琴","text":"うん","trans":"嗯"},{"id":"4001074040290","name":"美琴","text":"これ、新しく発売されたものみたい","trans":"这款，好像是新上市的"},{"id":"4001074040300","name":"美琴","text":"ルカは飲んだこと、ある？","trans":"路加喝过吗？"},{"id":"4001074040310","name":"ルカ","text":"違う","trans":"不对"},{"id":"4001074040320","name":"ルカ","text":"そんな美琴","trans":"这不是"},{"id":"4001074040330","name":"ルカ","text":"知らない","trans":"我认识的美琴"},{"id":"4001074040340","name":"ルカ","text":"……──さぁ","trans":"……──没"},{"id":"4001074040350","name":"美琴","text":"そっか","trans":"是吗"},{"id":"4001074040360","name":"美琴","text":"…………","trans":"…………"},{"id":"4001074040370","name":"美琴","text":"それじゃあ、時間だから","trans":"那，到时间了"},{"id":"4001074040380","name":"ルカ","text":"…………","trans":"…………"},{"id":"4001074040390","name":"美琴","text":"また今度","trans":"下次再见"},{"id":"4001074040400","name":"ルカ","text":"──────","trans":"──────"},{"id":"4001074040410","name":"ルカ","text":"──────────ッ","trans":"──────────"},{"id":"4001074040120","name":"美琴","text":"ルカとまた、同じステージに立てて","trans":"能再次和路加登上同一个舞台"},{"id":"4001074040430","name":"ルカ","text":"『同じステージ』って","trans":"“同一个舞台”什么的"},{"id":"4001074040440","name":"ルカ","text":"こんなの　違う","trans":"怎么会是，同一个啊"},{"id":"4001074040450","name":"ルカ","text":"美琴は\\nなんとも思わない？","trans":"难道美琴\\n不这么觉得吗？"},{"id":"4001074040460","name":"ルカ","text":"違う、わかってた","trans":"不，其实我早已清楚"},{"id":"4001074040470","name":"ルカ","text":"あの時から","trans":"从那时候起"},{"id":"4001074040480","name":"ルカ","text":"────","trans":"────"},{"id":"4001074040490","name":"ルカ","text":"私たちは\\nもう二度と──────────","trans":"我们\\n再也不会──────────"},{"id":"4001074040500","name":"ルカ","text":"ああ\\nそうだ","trans":"啊\\n是啊"},{"id":"4001074040510","name":"ルカ","text":"そうだった","trans":"就是这样"},{"id":"4001074040520","name":"ルカ","text":"ここには何もない","trans":"四周空无一人"},{"id":"4001074040530","name":"ルカ","text":"誰もいない","trans":"谁也不在"},{"id":"4001074040540","name":"ルカ","text":"私だけがここに\\n取り残されたまま──────","trans":"只有我一个人\\n被留在这里──────"}]}