{"translator":"AI初翻（gpt-4o）+奥術心白重译","rows":[{"id":"0000000000000","name":"プロデューサー","text":"ルカ、B控室で\\nメイクさんが待っててくれてるそうだ","trans":"路加，在B控室\\n有化妆师在等着你"},{"id":"4001074080010","name":"ルカ","text":"……","trans":"……"},{"id":"4001074080020","name":"ルカ","text":"…………！","trans":"…………！"},{"id":"4001074080030","name":"美琴","text":"────","trans":"────"},{"id":"4001074080040","name":"美琴","text":"──コメティックのステージ","trans":"──我还是第一次到现场看"},{"id":"4001074080050","name":"美琴","text":"生で見るのは初めて","trans":"CoMETIK的演出"},{"id":"4001074080060","name":"ルカ","text":"…………","trans":"…………"},{"id":"4001074080070","name":"ルカ","text":"……うん","trans":"……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"────美琴","trans":"────美琴"},{"id":"0000000000000","name":"プロデューサー","text":"ありがとう\\n美琴のおかげだよ","trans":"谢谢\\n多亏了美琴"},{"id":"4001074080080","name":"美琴","text":"……そうかな","trans":"……是吗"},{"id":"4001074080090","name":"美琴","text":"プロデューサーもわかっていたんじゃない？\\nこうなることを","trans":"制作人不是也知道的吗？\\n会是这样"},{"id":"0000000000000","name":"プロデューサー","text":"……どうだろうな","trans":"……会知道吗"},{"id":"0000000000000","name":"プロデューサー","text":"……いや、やっぱり\\nわかっていたわけじゃなくて──","trans":"……不，果然\\n其实并不知道──"},{"id":"0000000000000","name":"プロデューサー","text":"ただ、信じてたんだ","trans":"只是相信着而已"},{"id":"4001074080100","name":"美琴","text":"そっか","trans":"原来如此"},{"id":"4001074080101","name":"羽那＆はるき","text":"ルカちゃん──！","trans":"路加——！"},{"id":"4001074080110","name":"はるき","text":"よかった\\n間に合って……！","trans":"太好了\\n赶上了……！"},{"id":"4001074080120","name":"ルカ","text":"──────遅れた","trans":"──────来晚了"},{"id":"4001074080121","name":"羽那＆はるき","text":"えっ……！","trans":"诶……！"},{"id":"4001074080130","name":"はるき","text":"ううん……！","trans":"没有……！"},{"id":"4001074080140","name":"羽那","text":"ふふっ\\nルカちゃんが来てくれて嬉しいーっ","trans":"呵呵\\n路加能来真让我开心——"},{"id":"4001074080150","name":"ルカ","text":"…………","trans":"…………"},{"id":"4001074080160","name":"はるき","text":"みなさん、ありがとうございました……！","trans":"大家，非常感谢……！"},{"id":"4001074080170","name":"はるき","text":"ふふっ……少しでもコメティックを\\nいいなと思っていただけたのなら","trans":"呵呵……如果大家\\n有稍微喜欢上CoMETIK了的话"},{"id":"4001074080180","name":"はるき","text":"ぜひ、曲を聞いて\\nまたライブにも来てほしいです！","trans":"还请，再听听我们的歌\\n以及再来现场观看演出！"},{"id":"4001074080190","name":"羽那","text":"また会おうねーっ","trans":"下次再见哦"},{"id":"4001074080200","name":"ルカ","text":"………………","trans":"………………"},{"id":"4001074080210","name":"はるき","text":"──それでは……！","trans":"──那么……！"},{"id":"4001074080211","name":"羽那＆はるき","text":"あたしたち────","trans":"我们是────"},{"id":"4001074080220","name":"ルカ","text":"……──","trans":"……──"},{"id":"4001074080230","name":"ルカ","text":"────コメティックでした","trans":"────CoMETIK"},{"id":"4001074080231","name":"羽那＆はるき","text":"……！","trans":"……！"},{"id":"4001074080232","name":"羽那＆はるき","text":"────","trans":"────"},{"id":"4001074080240","name":"はるき","text":"シーズのステージ、すごかったね……！","trans":"SHHis的演出，好厉害啊……！"},{"id":"4001074080250","name":"羽那","text":"ねーっ","trans":"是啊"},{"id":"4001074080260","name":"羽那","text":"──でも\\nコメティックもすごいステージ、できてたよね？","trans":"──但是\\nCoMETIK也做到了吧？厉害的演出"},{"id":"4001074080270","name":"はるき","text":"……！","trans":"……！"},{"id":"4001074080280","name":"はるき","text":"うん……！\\nできてたと、思う。きっと……！","trans":"嗯……！\\n我觉得做到了。肯定……！"},{"id":"4001074080290","name":"ルカ","text":"…………","trans":"…………"},{"id":"4001074080300","name":"ルカ","text":"────","trans":"────"},{"id":"4001074080310","name":"羽那","text":"はぁ、なんかドーナツ食べたいなー","trans":"哈，总感觉好想吃甜甜圈啊—"},{"id":"4001074080320","name":"はるき","text":"ふふ～\\n羽那ちゃん、急だなぁ","trans":"呵呵～\\n羽那，真突然啊"},{"id":"4001074080330","name":"はるき","text":"……でも、わかるかも\\nがんばった分、カロリー摂取したいよねぇ……！","trans":"……但是，我也能懂\\n努力过后，就想摄取点卡路里了……！"},{"id":"4001074080340","name":"はるき","text":"羽那ちゃんはどっちのドーナツの気分？","trans":"羽那想吃哪种甜甜圈？"},{"id":"4001074080350","name":"羽那","text":"どっち──","trans":"哪种──"},{"id":"4001074080360","name":"羽那","text":"あー、どっちだろう？","trans":"啊，选哪种好呢？"},{"id":"4001074080370","name":"羽那","text":"──ねぇっ","trans":"──对了"},{"id":"4001074080380","name":"羽那","text":"ルカちゃんはどっちがいい？","trans":"路加觉得哪种好吃？"},{"id":"4001074080390","name":"ルカ","text":"…………は","trans":"…………哈"},{"id":"4001074080400","name":"羽那","text":"ミセス・ドーナツと──","trans":"是“Mrs. 甜甜圈”还是──"},{"id":"4001074080410","name":"はるき","text":"クリーミィ・クランキー・ドーナツ！","trans":"“奶油脆甜甜圈”！"},{"id":"4001074080420","name":"羽那","text":"あ、あたしたち迷ってるから\\n『どっちでもいい』はなしね？","trans":"啊，我们都选不出来\\n所以不能说『都可以』哦？"},{"id":"4001074080430","name":"ルカ","text":"ああ\\nそうか","trans":"啊啊\\n是吗"},{"id":"4001074080440","name":"ルカ","text":"ここには","trans":"这里有"},{"id":"4001074080450","name":"ルカ","text":"………………","trans":"………………"},{"id":"4001074080460","name":"はるき","text":"……ルカちゃん？","trans":"……路加？"},{"id":"4001074080470","name":"ルカ","text":"────","trans":"────"},{"id":"4001074080480","name":"ルカ","text":"…………ミセス・ドーナツ","trans":"…………“Mrs. 甜甜圈”"},{"id":"4001074080481","name":"羽那＆はるき","text":"……──！","trans":"……──！"},{"id":"4001074080490","name":"羽那","text":"じゃあ、ミセス・ドーナツで決まりだねっ","trans":"那，就决定是“Mrs. 甜甜圈”了呢"},{"id":"4001074080500","name":"はるき","text":"『そっちの様子はどうでしょうか？』","trans":"『那边情况怎么样了呢？』"},{"id":"4001074080510","name":"はるき","text":"『見学、行きたかったなぁ』","trans":"『真想去观摩一下啊』"},{"id":"0000000000000","name":"プロデューサー","text":"『もうすぐ始まるよ\\n『鈴木の部屋』の収録』","trans":"『快开始了哦\\n‘铃木的房间’的录制』"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"4001074080520","name":"羽那","text":"……ふふっ","trans":"……呵呵"},{"id":"4001074080530","name":"ルカ","text":"なんだよ","trans":"干嘛"},{"id":"4001074080540","name":"羽那","text":"ルカちゃんが来てくれて\\n嬉しいなーって思ってるの──！","trans":"只是觉得路加能来\\n真的很开心──！"},{"id":"4001074080550","name":"ルカ","text":"まぁ……仕事だし","trans":"嘛……毕竟是工作"},{"id":"4001074080560","name":"羽那","text":"えーっ、そうなの？","trans":"诶，是那样吗？"},{"id":"4001074080570","name":"ルカ","text":"──……収録。始まる","trans":"──……录制。要开始了"},{"id":"4001074080580","name":"羽那","text":"はーいっ","trans":"好——"}]}