{
  "translator": "告",
  "rows": [
    {
      "id": "4001022030010",
      "name": "甜花",
      "text": "じゅ、準備は……いいですか……！\\n本……落ちない……？",
      "trans": "准，准备好了吗……！\\n书……不会掉吗……？"
    },
    {
      "id": "4001022030020",
      "name": "甘奈",
      "text": "うぅ……！\\n頭の上に置いて歩くとか……１冊で限界だよ～っ",
      "trans": "唔……！\\n放在头上走路……1本就是极限了啦～"
    },
    {
      "id": "4001022030030",
      "name": "甜花",
      "text": "大丈夫……！\\nなーちゃんなら……３冊、いける……！",
      "trans": "没问题……！\\n小奈的话……3本，可以的……！"
    },
    {
      "id": "4001022030040",
      "name": "甜花",
      "text": "それでは、向こうの壁まで……\\nスタート……っ！",
      "trans": "那就，向着对面墙壁……\\n出发……！"
    },
    {
      "id": "4001022030050",
      "name": "甘奈",
      "text": "う、うわぁっ、うんっ……！",
      "trans": "呜，呜哇，嗯……！"
    },
    {
      "id": "4001022030060",
      "name": "甜花",
      "text": "す、すごい……！\\nなーちゃん、いい感じ……！",
      "trans": "好，好厉害……！\\n小奈，感觉很好……！"
    },
    {
      "id": "4001022030070",
      "name": "甘奈",
      "text": "う、うん……っ",
      "trans": "呜，嗯……"
    },
    {
      "id": "4001022030080",
      "name": "甜花",
      "text": "いち、に、いち、に……",
      "trans": "一，二，一，二……"
    },
    {
      "id": "4001022030090",
      "name": "甘奈",
      "text": "力を抜かなきゃ……\\n屈んで、ゴリラになっちゃうんだよね……！",
      "trans": "不放松的话……\\n就会缩起来，变成猩猩了吧……！"
    },
    {
      "id": "4001022030100",
      "name": "甜花",
      "text": "にへへ……！\\nなーちゃん、ゴリラさん……",
      "trans": "诶嘿嘿……！\\n小奈，是猩猩……!"
    },
    {
      "id": "4001022030110",
      "name": "甜花",
      "text": "それも……可愛いよ……！",
      "trans": "那样……也很可爱时！"
    },
    {
      "id": "4001022030120",
      "name": "甘奈",
      "text": "ええっ！？\\n──うわぁっ……",
      "trans": "诶诶！？\\n——呜哇……"
    },
    {
      "id": "4001022030130",
      "name": "甜花",
      "text": "なーちゃん……！\\nだ、大丈夫……！？",
      "trans": "小奈……！\\n没，没事吧……！？"
    },
    {
      "id": "4001022030140",
      "name": "甘奈",
      "text": "──あははっ……\\nもう、褒めちゃダメだって！　反対ごっこ！",
      "trans": "——啊哈哈……\\n真是的，都说不能夸人了！ 假装说反话！"
    },
    {
      "id": "4001022030141",
      "name": "甘奈＆甜花",
      "text": "えへへっ……",
      "trans": "欸嘿嘿……"
    },
    {
      "id": "4001022030150",
      "name": "千雪",
      "text": "──わぁ、もしかしてウォーキングやってたの？",
      "trans": "——哇，难道在走台步吗？"
    },
    {
      "id": "4001022030160",
      "name": "甘奈",
      "text": "あっ、千雪さん！\\nうんっ",
      "trans": "啊，千雪！\\n嗯"
    },
    {
      "id": "4001022030170",
      "name": "甘奈",
      "text": "もう帰っちゃうー？",
      "trans": "你要回去了吗—？"
    },
    {
      "id": "4001022030180",
      "name": "千雪",
      "text": "ふふっ、うん\\n今日は美容室の予約入れちゃってて",
      "trans": "呵呵，嗯\\n我今天预约要去美容室"
    },
    {
      "id": "4001022030190",
      "name": "千雪",
      "text": "でも……時間まで、何かお手伝いするね\\nビデオ撮ろっか？",
      "trans": "不过……触发事件之前，我可以帮忙呢\\n要拍视频吗？"
    },
    {
      "id": "4001022030200",
      "name": "甘奈",
      "text": "あっ、ううん！　それは美容室優先にしなきゃ！\\nウォーキングは、専門の先生に習うから大丈夫☆",
      "trans": "啊，不用了！ 美容室比较优先！\\n走台步的话，有在和专门的老师学习所以没问题☆"
    },
    {
      "id": "4001022030210",
      "name": "千雪",
      "text": "あ……そっかぁ──",
      "trans": "啊……是吗——"
    },
    {
      "id": "4001022030220",
      "name": "甘奈",
      "text": "えっとー\\n『アプリコット』……みたいな名前で──",
      "trans": "我记得—\\n好像叫……《银杏》——"
    },
    {
      "id": "4001022030230",
      "name": "千雪",
      "text": "……",
      "trans": ""
    },
    {
      "id": "4001022030240",
      "name": "甘奈",
      "text": "──でもね、オーディションまでに\\nできるだけレッスン入れなきゃなんだけど",
      "trans": "——不过啊，虽然要在试镜前\\n尽可能排满课程"
    },
    {
      "id": "4001022030250",
      "name": "甘奈",
      "text": "先生の予約がなかなか取れないんだ……\\n明後日は取れそうなんだけど、場所がなくて",
      "trans": "可是老师却很难约到……\\n后天本来可以约的，但是没有地方"
    },
    {
      "id": "4001022030260",
      "name": "千雪",
      "text": "明後日……",
      "trans": "后天……"
    },
    {
      "id": "4001022030270",
      "name": "千雪",
      "text": "──あ、私がここ予約しちゃってるから……！",
      "trans": "——啊，这边被我预约走了……！"
    },
    {
      "id": "4001022030280",
      "name": "甘奈",
      "text": "あっ、ううん！\\nそういうことじゃないんだ……！",
      "trans": "啊，没事！\\n我不是这意思……！"
    },
    {
      "id": "4001022030290",
      "name": "甘奈",
      "text": "先に予約してたんだもん！\\n明後日は千雪さんが頑張る時間だよっ☆",
      "trans": "毕竟是你先约的！\\n所以后天就是千雪努力的时间了☆"
    },
    {
      "id": "4001022030300",
      "name": "千雪",
      "text": "で、でも……",
      "trans": "可，可是……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『自分のことも大事に考えてくれ\\nレッスンも今週はみっちり入ってるからな』",
      "trans": "“你也要重视自己\\n毕竟这周课程都排得很紧”"
    },
    {
      "id": "4001022030310",
      "name": "甘奈",
      "text": "『新しい雑誌だって言ってたから、\\nどんな感じかはまだわからないんだけど……』",
      "trans": "“因为说是新的杂志，\\n也不知道是什么风格的……”"
    },
    {
      "id": "4001022030320",
      "name": "千雪",
      "text": "…………っ",
      "trans": "…………！"
    },
    {
      "id": "4001022030330",
      "name": "千雪",
      "text": "……\\nごめんね……",
      "trans": "\\n对不起……"
    },
    {
      "id": "4001022030340",
      "name": "甘奈",
      "text": "ううん！　甘奈こそヘンなこと言っちゃった……\\nプロデューサーさんにも相談するから大丈夫っ！",
      "trans": "没事！ 甘奈才是说了奇怪的话……\\n没关系，甘奈也会去和制作人商量的！"
    },
    {
      "id": "4001022030350",
      "name": "千雪",
      "text": "う、うん……",
      "trans": "呜，嗯……"
    },
    {
      "id": "4001022030360",
      "name": "甜花",
      "text": "……",
      "trans": ""
    },
    {
      "id": "4001022030370",
      "name": "千雪",
      "text": "──あっ、そうだ、これ……！",
      "trans": "——啊，对了，这个……！"
    },
    {
      "id": "4001022030380",
      "name": "千雪",
      "text": "あのね、\\nよかったらお勉強用にって思って────",
      "trans": "这个啊，\\n我觉得你们可以用来学习一下——"
    },
    {
      "id": "4001022030390",
      "name": "甘奈",
      "text": "……わぁ！\\nこれ、『アプリコット』……！？",
      "trans": "……哇！\\n这是，《银杏》……！？"
    },
    {
      "id": "4001022030400",
      "name": "甘奈",
      "text": "千雪さん……持ってたの……！",
      "trans": "千雪……你原来有吗……！"
    },
    {
      "id": "4001022030410",
      "name": "千雪",
      "text": "……あっ……ううん……！\\nたまたまなの……",
      "trans": "……啊……不是……！\\n只是偶然……"
    },
    {
      "id": "4001022030420",
      "name": "千雪",
      "text": "昨日、古本屋さんで見つけて……",
      "trans": "昨天，在旧书店看到了……"
    },
    {
      "id": "4001022030430",
      "name": "甘奈",
      "text": "かわいー……！",
      "trans": "好可爱—……！"
    },
    {
      "id": "4001022030440",
      "name": "千雪",
      "text": "うん……\\nすっごく……",
      "trans": "嗯……\\n非常……"
    },
    {
      "id": "4001022030450",
      "name": "千雪",
      "text": "すっごく、素敵な雑誌なの……",
      "trans": "真的，是非常好的杂志……"
    },
    {
      "id": "4001022030460",
      "name": "甜花",
      "text": "……千雪さん",
      "trans": "……千雪"
    },
    {
      "id": "4001022030470",
      "name": "甘奈",
      "text": "──ありがとう、千雪さんっ",
      "trans": "——谢谢你，千雪"
    },
    {
      "id": "4001022030480",
      "name": "甘奈",
      "text": "甘奈、めーっちゃ勉強するから……！",
      "trans": "甘奈，学—习了好多之后……！"
    },
    {
      "id": "4001022030490",
      "name": "甜花",
      "text": "お腹……空いたね……",
      "trans": "肚子……饿了呢……"
    },
    {
      "id": "4001022030500",
      "name": "甘奈",
      "text": "うん、張りきりすぎちゃった……！\\n甘奈もぺっこぺこ！",
      "trans": "嗯，努力过头了……！\\n甘奈也饿扁了！"
    },
    {
      "id": "4001022030510",
      "name": "甘奈",
      "text": "夕飯、何かなぁ？",
      "trans": "晚饭，是什么呢？"
    },
    {
      "id": "4001022030520",
      "name": "甜花",
      "text": "甜花、シチューがいい……！",
      "trans": "甜花，想吃炖菜……！"
    },
    {
      "id": "4001022030530",
      "name": "甘奈",
      "text": "あーっ、甘奈もおんなじこと思ってたの！\\nにんじん、お星さまにしたいな☆",
      "trans": "啊—，甘奈也想到一块了！\\n胡萝卜，希望能切成星星的样子☆"
    },
    {
      "id": "4001022030540",
      "name": "甜花",
      "text": "わ……それ……\\n『アプリコット』に、載ってた……！",
      "trans": "哇……你说的\\n是《银杏》上，刊登的……！"
    },
    {
      "id": "4001022030550",
      "name": "甘奈",
      "text": "うんっ！　『退屈なお星さまのためのシチュー』！\\nあとは、ケチャップライスと……",
      "trans": "嗯！ “为了无聊星星的炖菜”！\\n还有，番茄酱炒饭和……"
    },
    {
      "id": "4001022030560",
      "name": "甜花",
      "text": "『歌い疲れたベーコンたちのスープ』も……！",
      "trans": "“唱歌唱累的培根们的汤”也……！"
    },
    {
      "id": "4001022030570",
      "name": "甘奈",
      "text": "えへへっ\\nママにお願いしてみよっか！",
      "trans": "欸嘿嘿\\n试着拜托妈妈吧！"
    },
    {
      "id": "4001022030580",
      "name": "甜花",
      "text": "うんっ……！\\nメッセ、する……！",
      "trans": "嗯……！\\n我来，发消息……！"
    },
    {
      "id": "4001022030590",
      "name": "甜花",
      "text": "……",
      "trans": ""
    },
    {
      "id": "4001022030600",
      "name": "甘奈",
      "text": "……\\n……千雪さんは──",
      "trans": "……\\n……千雪——"
    },
    {
      "id": "4001022030610",
      "name": "甘奈",
      "text": "……あのね、千雪さんって────\\nもしかして『アプリコット』、読んでたんじゃないかなって",
      "trans": "……我在想，千雪——\\n是不是，看过《Apricot》"
    },
    {
      "id": "4001022030620",
      "name": "甜花",
      "text": "……なーちゃん\\nうん……",
      "trans": "……小奈\\n嗯……"
    },
    {
      "id": "4001022030630",
      "name": "甜花",
      "text": "……\\n甜花も、思った……",
      "trans": "\\n甜花，也在想"
    },
    {
      "id": "4001022030640",
      "name": "甜花",
      "text": "とっても……\\n好きだったり、するのかもって……",
      "trans": "或许……\\n非常，喜欢这本……"
    },
    {
      "id": "4001022030650",
      "name": "甘奈",
      "text": "……\\nそう……だよね……",
      "trans": "……\\n或许……是呢……"
    },
    {
      "id": "4001022030660",
      "name": "甜花",
      "text": "わ、わかんないけど…………",
      "trans": "虽，虽然不知道……"
    },
    {
      "id": "4001022030670",
      "name": "甘奈",
      "text": "……うん\\nでも、もしそうだったら…………",
      "trans": "……嗯\\n不过，如果是那样的话…………"
    },
    {
      "id": "4001022030680",
      "name": "甘奈",
      "text": "甘奈……──",
      "trans": "甘奈……——",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4001022030690",
      "name": "千雪",
      "text": "──……\\n『３人で、アルストロメリア』…………",
      "trans": "\\n“3个人，才是Alstroemeria”"
    },
    {
      "id": "4001022030700",
      "name": "千雪",
      "text": "……\\nごめんね……",
      "trans": "……\\n对不起……"
    },
    {
      "id": "4001022030710",
      "name": "千雪",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "4001022030720",
      "name": "千雪",
      "text": "あーっ……\\nダメダメダメ…………",
      "trans": "啊—……\\n不行不行不行…………"
    },
    {
      "id": "4001022030730",
      "name": "千雪",
      "text": "…………\\n………………",
      "trans": "…………\\n………………"
    },
    {
      "id": "4001022030740",
      "name": "千雪",
      "text": "私……\\nただの自主練なのに…………",
      "trans": "我……\\n明明只是自主训练…………"
    },
    {
      "id": "4001022030750",
      "name": "甘奈",
      "text": "先に予約してたんだもん！\\n明後日は千雪さんが頑張る時間だよっ☆",
      "trans": "毕竟是你先约的！\\n所以后天就是千雪努力的时间了☆"
    },
    {
      "id": "4001022030760",
      "name": "千雪",
      "text": "……\\n…………",
      "trans": "……\\n…………"
    },
    {
      "id": "4001022030770",
      "name": "千雪",
      "text": "なんでだろ……\\n私……",
      "trans": "为什么呢……\\n我……"
    },
    {
      "id": "4001022030780",
      "name": "千雪",
      "text": "…………\\nなんで……『アプリコット』なんだろう…………",
      "trans": "…………\\n为什么……会是《银杏》呢…………"
    },
    {
      "id": "4001022030790",
      "name": "甜花",
      "text": "──ん、しょ……\\n靴、揃えて……",
      "trans": "——嘿，咻……\\n鞋子，摆好……"
    },
    {
      "id": "4001022030800",
      "name": "甜花",
      "text": "来客スリッパじゃ、ないやつ……\\nあった……",
      "trans": "不是，来客穿的拖鞋……\\n有了……"
    },
    {
      "id": "4001022030810",
      "name": "甜花",
      "text": "荷物、置いて……現場……",
      "trans": "行李，放好……现场……"
    },
    {
      "id": "4001022030820",
      "name": "甜花",
      "text": "おつかれさ──",
      "trans": "辛苦——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "すみません、もう一度\\nお打合せの時間を頂戴できませんか……！",
      "trans": "不好意思，能否\\n再给我一点探讨的时间呢……！"
    },
    {
      "id": "4001022030830",
      "name": "甜花",
      "text": "……っ\\n電話中……！　静かに……！",
      "trans": "……\\n在打电话……！ 要安静……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……いや、だって……！",
      "trans": "……不，因为……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "グランプリが\\n大崎に内定してるっていうのは──",
      "trans": "优胜\\n内定为大崎这个情况——"
    },
    {
      "id": "4001022030840",
      "name": "甜花",
      "text": "……えっ",
      "trans": "……诶"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "その、大変光栄なことではあるんですが、\\nウチは聞いておらずでして──────",
      "trans": "虽然，十分荣幸，\\n但我们这边并未听说————"
    },
    {
      "id": "4001022030850",
      "name": "甜花",
      "text": "…………",
      "trans": ""
    }
  ],
