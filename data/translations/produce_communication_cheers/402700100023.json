{"translator":"","rows":[{"id":"4027001000230010","name":"羽那","text":"──受かりたいなーっ","trans":"——希望能通过呢"},{"id":"0000000000000","name":"プロデューサー","text":"（……！\\n羽那……そうだよな）","trans":"（……！\\n羽那……说得是啊）"},{"id":"select","name":"","text":"合格しよう","trans":"拿下合格吧"},{"id":"select","name":"","text":"羽那なら大丈夫だ","trans":"羽那的话肯定能行"},{"id":"select","name":"","text":"その気持ちが\\n大事だぞ","trans":"重视这份心情吧"},{"id":"4027001000230020","name":"羽那","text":"ふふっ、そうだね\\n合格しよう──！","trans":"呵呵、是吧\\n拿下合格——！"},{"id":"0000000000000","name":"プロデューサー","text":"（緊張してるみたいだけど……\\nよかった、笑ってくれたな）","trans":"（虽然看着还有点紧张……\\n不过太好了，能让她笑出来）"},{"id":"4027001000230030","name":"羽那","text":"あはっ、そうかなー","trans":"啊哈、这样吗——"},{"id":"0000000000000","name":"プロデューサー","text":"（……俺は\\n絶対大丈夫だと思ってるぞ……！）","trans":"（……我相信\\n羽那肯定能行……！）"},{"id":"4027001000230040","name":"羽那","text":"うん、ありがとう","trans":"嗯、谢谢"},{"id":"0000000000000","name":"プロデューサー","text":"（……伝えたいこと\\nあまり伝わらなかったかな……）","trans":"（……原本的意思\\n没太传达到啊……）"}]}