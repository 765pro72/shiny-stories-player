{
  "translator": "告",
  "rows": [
    {
      "id": "4026001000210010",
      "name": "ルカ",
      "text": "なんだよ\\n行ったり来たり",
      "trans": "你干什么\\n走来走去的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あぁ、すまん……",
      "trans": "啊，抱歉……"
    },
    {
      "id": "select",
      "name": "",
      "text": "大事な勝負だから\\n落ち着かなくてな",
      "trans": "很重要的比赛\\n我冷静不下来"
    },
    {
      "id": "select",
      "name": "",
      "text": "ルカは\\n緊張しないのか？",
      "trans": "路加\\n不紧张吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺もやる気を\\n出していこうと",
      "trans": "我也想\\n提起干劲"
    },
    {
      "id": "4026001000210020",
      "name": "ルカ",
      "text": "……関係ねぇ\\n私はやりたいようにやるだけ",
      "trans": "……无所谓\\n我只做我想做的事"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うん、さすがに頼もしいな……）",
      "trans": "（嗯，真是可靠……）"
    },
    {
      "id": "4026001000210030",
      "name": "ルカ",
      "text": "オメェが緊張してどうすんだよ\\nどっか行っとけ……",
      "trans": "你紧张有什么用\\n走开……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（どうやら問題なさそうだ）",
      "trans": "（看来没有问题）"
    },
    {
      "id": "4026001000210040",
      "name": "ルカ",
      "text": "は…………？\\nオメェのやる気とか見たくねェんだよ",
      "trans": "哈…………？\\n谁想看你的干劲啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（しまった……他のことを言えばよかった）",
      "trans": "（糟了……要是说点别的就好了）"
    }
  ]
}