{"translator":"闲云遮月","rows":[{"id":"4020001000220010","name":"透","text":"どう\\nいけてる、今日？","trans":"怎么样\\n今天能行吗？"},{"id":"0000000000000","name":"プロデューサー","text":"（そうだな────）","trans":"（这个嘛————）"},{"id":"select","name":"","text":"すごく素敵だ、透","trans":"透，你很棒哦"},{"id":"select","name":"","text":"自信がある顔\\nしてるぞ","trans":"你一脸自信呢"},{"id":"select","name":"","text":"輝くばかりだ","trans":"闪闪发光哦"},{"id":"4020001000220020","name":"透","text":"え、何……\\nやばいね","trans":"诶，什么……\\n哪有"},{"id":"0000000000000","name":"プロデューサー","text":"（あ、いい顔になった）","trans":"（啊，变得很开心嘛）"},{"id":"4020001000220030","name":"透","text":"ふふっ、うん\\nあるよ","trans":"呵呵，嗯\\n是呢"},{"id":"0000000000000","name":"プロデューサー","text":"（よし、そのまま本番だ！）","trans":"（好，保持到正式演出！）"},{"id":"4020001000220040","name":"透","text":"もう、いいって\\nほんとのこと言ってくれれば","trans":"真是的，算了\\n要是能说点真话就好了"},{"id":"0000000000000","name":"プロデューサー","text":"（……っ、うまく言えなかった）","trans":"（……，说得太糟糕了啊）"}]}