{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"4902200440010","name":"甜花","text":"あうぅ……そんな……\r\n甜花、負けるなんて……","trans":"呜呜……怎么会……\n甜花，居然会输……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-2","name":"プロデューサー","text":"さあ、ゲームに勝ったんだから\r\nここから出してもらうぞ","trans":"好啦，既然赢了游戏\n就让我从这里出去吧","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4902200440020","name":"甜花","text":"はい……\r\nえと、扉……────あ……","trans":"好……\n嗯，门……————啊……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-6","name":"プロデューサー","text":"お札が……！？","trans":"符……！？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4902200440030","name":"甜花","text":"う……ぁあ……あ……","trans":"唔……啊啊……啊……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-10","name":"プロデューサー","text":"わー！　待て待てっ\r\n甜花、お札……────！","trans":"哇——！　等等等等\n甜花，符……————！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4902200440040","name":"甜花","text":"──……？\r\n……","trans":"——……？\n……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-13","name":"プロデューサー","text":"……っ\r\nて、甜花……！","trans":"……唔\n甜，甜花……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4902200440050","name":"甜花","text":"にへへ……\r\nやっぱり、美味しい……","trans":"嘿嘿……\n果然，好吃……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"4902200440060","name":"甜花","text":"けど、約束だから……\r\n──バイバイ……","trans":"不过，因为约好了……\n——拜拜……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}