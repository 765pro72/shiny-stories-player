{"translator":"","rows":[{"id":"4901800420010","name":"円香","text":"……────なんて","trans":"…——开玩笑的"},{"id":"0000000000000","name":"プロデューサー","text":"え、どっちなんだ？","trans":"诶，是说哪一边？"},{"id":"4901800420020","name":"円香","text":"さあ","trans":"谁知道呢"},{"id":"0000000000000","name":"プロデューサー","text":"くっ、確かめたいが……\\n車が停まらないことには……","trans":"嗯，很想确认一下……\\n但又没办法停车……"},{"id":"4901800420030","name":"円香","text":"……どうぞ","trans":"……请"},{"id":"0000000000000","name":"プロデューサー","text":"お、ありがとう\\n────……","trans":"谢、谢谢\\n——……"},{"id":"4901800420040","name":"円香","text":"それで？","trans":"然后呢？"},{"id":"0000000000000","name":"プロデューサー","text":"……うーんやっぱり、どちらにしても\\n円香の気持ちが込められてることに変わりはないから","trans":"…果然呢，无论是哪一边\\n都能感受到円香满满的心意"},{"id":"0000000000000","name":"プロデューサー","text":"美味しいよ！","trans":"很好吃！"},{"id":"4901800420050","name":"円香","text":"？","trans":"？"}]}