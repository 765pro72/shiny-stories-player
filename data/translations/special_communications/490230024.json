{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "4902300240020",
      "name": "凛世",
      "text": "本当に……入っております……\r\nショートケーキが……",
      "trans": "真的……装着呢……\n草莓奶油蛋糕……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-5",
      "name": "プロデューサー",
      "text": "ああ、たっぷり入ってるな\r\n美味しそうだ",
      "trans": "啊，装得满满的啊\n看起来很好吃",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240030",
      "name": "凛世",
      "text": "はい……",
      "trans": "好的……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240040",
      "name": "凛世",
      "text": "ふふ……\r\n苺も……たくさん……",
      "trans": "呵呵……\n草莓也……好多……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240050",
      "name": "凛世",
      "text": "まさか……先日のご質問が……\r\nこのプレゼントの……ためだったとは……",
      "trans": "没想到……前几天的那个问题……\n竟是为了……这份礼物……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-11",
      "name": "プロデューサー",
      "text": "はは、プレゼントするなら、\r\n凛世が喜ぶものをあげたかったからさ",
      "trans": "哈哈，要送礼物的话，\n想送凛世会开心的东西嘛",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240060",
      "name": "凛世",
      "text": "──プロデューサーさま…………",
      "trans": "──制作人大人…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240070",
      "name": "凛世",
      "text": "このような……\r\n世にも珍しい……ショートケーキを……",
      "trans": "这样的……\n世上罕见的……草莓奶油蛋糕……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240080",
      "name": "凛世",
      "text": "凛世の……気になっていたものを……\r\n贈っていただき……",
      "trans": "我……一直惦记的东西……\n送了给我……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240090",
      "name": "凛世",
      "text": "それだけで……凛世は──……\r\nそのお心が……嬉しく……",
      "trans": "光是那样……我就──……\n那份心意……让我好开心……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240100",
      "name": "凛世",
      "text": "ですが…………\r\nひとつだけ……我儘を言うならば…………",
      "trans": "不过…………\n只提一个……任性要求的话…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240110",
      "name": "凛世",
      "text": "こちらを……プロデューサーさまにも……\r\n食べていただきたく……",
      "trans": "这个……也想请制作人大人……\n尝一尝……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-21",
      "name": "プロデューサー",
      "text": "えっ、でも……\r\nそれは凛世へのプレゼントだから────",
      "trans": "诶，可是……\n那是给凛世的礼物啊————",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-23",
      "name": "プロデューサー",
      "text": "ああ、いや、俺がもらうのは悪いなって思って……\r\nたんだけど────……",
      "trans": "啊，不，我是想着我收下不太好……\n来着————……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-26",
      "name": "プロデューサー",
      "text": "凛世がそうしてほしいって言ってくれるなら、\r\nそうさせてもらおうかな",
      "trans": "凛世要是希望我这么做，\n那我就却之不恭了",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240120",
      "name": "凛世",
      "text": "はい……！\r\nぜひ…………",
      "trans": "嗯……！\n请务必…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240130",
      "name": "凛世",
      "text": "真っ赤な……苺も……\r\n真っ白な……クリームも……",
      "trans": "通红的……草莓也……\n雪白的……奶油也……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240140",
      "name": "凛世",
      "text": "いつもと……\r\n違う……",
      "trans": "和平时……\n不一样……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4902300240150",
      "name": "凛世",
      "text": "特別な…………\r\n赤と……白────……",
      "trans": "特别的…………\n红与……白————……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
