{"translator":"ryo","rows":[{"id":"4901700360010","name":"冬優子","text":"──、ちょっと待って？","trans":"──、等等？"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"4901700360020","name":"冬優子","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"何やってるんだ？","trans":"你在干什么？"},{"id":"4901700360030","name":"冬優子","text":"せっかく積もったんだし、\\nふゆの足跡を残しておこうと思って","trans":"难得积了雪，\\n冬优想留下自己的脚印嘛"},{"id":"0000000000000","name":"プロデューサー","text":"はは、子どもみたいなことしてるな","trans":"哈哈，像个小孩子一样"},{"id":"4901700360040","name":"冬優子","text":"いいでしょ","trans":"有什么不行的嘛"},{"id":"4901700360050","name":"冬優子","text":"いくつになっても楽しいものは楽しいのよ","trans":"不管多大年纪，快乐的事永远会让人快乐啦"},{"id":"0000000000000","name":"プロデューサー","text":"気を付けてくれ\\n走ったりすると危ないぞ","trans":"小心点\\n跑起来会很危险的"},{"id":"4901700360060","name":"冬優子","text":"大丈夫\\n子どもじゃないんだか──","trans":"没事\\n我又不是小孩子──"},{"id":"4901700360070","name":"冬優子","text":"っ","trans":"哎"},{"id":"0000000000000","name":"プロデューサー","text":"！\\n冬優子──うわっ！","trans":"！\\n冬优子──哇！"},{"id":"4901700360080","name":"冬優子","text":"…………ふふっ","trans":"…………呵呵"},{"id":"4901700360090","name":"冬優子","text":"……なんであんたが転ぶのよ","trans":"……你怎么也摔倒了啊"},{"id":"0000000000000","name":"プロデューサー","text":"怪我はないか……？","trans":"没受伤吧……？"},{"id":"4901700360100","name":"冬優子","text":"ないわ\\nそっちこそ平気なの？","trans":"没有啦\\n你才是，不要紧吧？"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……！\\nよかったよ、冬優子が無事で──","trans":"啊……！\\n太好了，冬优子没事──"},{"id":"4901700360110","name":"冬優子","text":"…………","trans":"…………"},{"id":"4901700360120","name":"冬優子","text":"変な足跡","trans":"真是奇怪的脚印"}]}