{
  "translator": "",
  "rows": [
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "ローズティーとか……",
      "trans": "蔷薇茶……"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "以前いただいたことがあるんですけど\\nそれがとても美味しくて……",
      "trans": "以前有喝过\\n非常的好喝……"
    },
    {
      "id": "4901011120010",
      "name": "はづき",
      "text": "ふふ、よかったです\\nなんと、持ってきたのローズティーなんですよ～",
      "trans": "呵呵，那太好了\\n我带来的就是蔷薇茶哦～"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "お……！",
      "trans": "哦……！"
    },
    {
      "id": "4901011120020",
      "name": "はづき",
      "text": "私のとっておきなんです\\n楽しみにしていてくださいね～",
      "trans": "是我的珍藏哦\\n请你好好的期待吧～"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "すみません、ありがとうございます",
      "trans": "麻烦你了……谢谢你"
    },
    {
      "id": "4901011120030",
      "name": "はづき",
      "text": "お待たせしました～",
      "trans": "让你久等了～"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "本当だ、いい香りですね……！",
      "trans": "真的，很醇厚的香气呢……！"
    },
    {
      "id": "4901011120040",
      "name": "はづき",
      "text": "ふふっ、『とっておき』ですので",
      "trans": "呵呵，因为是“珍藏”"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "ありがとうございます、さっそくいただきます",
      "trans": "非常感谢，那我先来品茶"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "──……\\nああ、とっても美味しい……",
      "trans": "——……\\n啊啊，非常好喝……"
    },
    {
      "id": "4901011120050",
      "name": "はづき",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "けど、なんだか……急にめまいが……",
      "trans": "但是，怎么……突然头昏眼花……"
    },
    {
      "id": "4901011120060",
      "name": "はづき",
      "text": "本当にすみません、先生……",
      "trans": "真的很抱歉，老师……"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "はづき……先生……？",
      "trans": "叶月……老师？"
    },
    {
      "id": "4901011120070",
      "name": "はづき",
      "text": "でも、先生も悪いんですよ～？\\nせっかく思いとどまっていたのに……",
      "trans": "但是，是你的错哦～？\\n明明我都打消了念头……"
    },
    {
      "id": "4901011120080",
      "name": "はづき",
      "text": "『ローズティー』なんて言われたら\\n実行せざるを得ないじゃないですか",
      "trans": "你却偏偏说要“蔷薇茶”\\n那我不是得执行计划了吗"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "あ……ぅ……",
      "trans": "啊……唔……"
    },
    {
      "id": "4901011120090",
      "name": "はづき",
      "text": "では、ゆっくりと──",
      "trans": "那么，还请——"
    },
    {
      "id": "4901011120100",
      "name": "はづき",
      "text": "──おやすみなさい、先生",
      "trans": "——晚安，老师"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "あ……",
      "trans": "啊……"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（うっ……頭が痛い……）",
      "trans": "（呜……头疼……）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（まっくらだ、今、何時……？）",
      "trans": "（一片黑暗，现在，是几点……？）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（ここはどこだ……？）",
      "trans": "（这是哪里……？）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（俺は……）",
      "trans": "（我……）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（俺って誰だ……？）",
      "trans": "（我是谁……？）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（僕……………そうだ、僕の……）",
      "trans": "（我……………对了，我的……）"
    },
    {
      "id": "0000000000000",
      "name": "主人公",
      "text": "（ジュリエット……）",
      "trans": "（茱莉叶……）"
    },
    {
      "id": "select",
      "name": "",
      "text": "真乃・灯織・めぐる",
      "trans": "真乃・灯织・巡"
    },
    {
      "id": "select",
      "name": "",
      "text": "恋鐘・摩美々・咲耶\\n結華・霧子",
      "trans": "恋钟・摩美美・咲耶\\n结华・雾子"
    },
    {
      "id": "select",
      "name": "",
      "text": "果穂・智代子・樹里\\n凛世・夏葉",
      "trans": "果穂・智代子・树里\\n凛世・夏叶"
    },
    {
      "id": "select",
      "name": "",
      "text": "甘奈・甜花・千雪",
      "trans": "甘奈·甜花·千雪"
    },
    {
      "id": "select",
      "name": "",
      "text": "あさひ・冬優子・愛依",
      "trans": "朝日・冬优子・爱依"
    }
  ]
}