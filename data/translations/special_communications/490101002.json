{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "4901010020010",
      "name": "結華",
      "text": "──あ\r\n当日の入りの確認しとかなきゃ",
      "trans": "——啊\n得确认一下当天的到场时间才行",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020020",
      "name": "結華",
      "text": "えーと……『スプパの』────",
      "trans": "呃……“Supapa的”────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020030",
      "name": "結華",
      "text": "おわっ、電話……？",
      "trans": "哇，电话……？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020031",
      "name": "結華",
      "text": "──はいもしもしー？",
      "trans": "——喂，喂～？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020040",
      "name": "結華",
      "text": "『スプパ』",
      "trans": "“Supapa”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020060",
      "name": "霧子",
      "text": "『スプパ？』",
      "trans": "『汤意面？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020070",
      "name": "恋鐘",
      "text": "『スープパスタ～～！？』",
      "trans": "『汤意面～～！？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020080",
      "name": "摩美々",
      "text": "…………\r\n何ー、わざと言ってるのー",
      "trans": "…………\n什么嘛——，是故意这么说的吧——",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020090",
      "name": "咲耶",
      "text": "『スープパーティーかもしれないよ』",
      "trans": "『说不定是汤派对哦』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020100",
      "name": "霧子",
      "text": "『どっちも\r\nおいしそう＾＾』",
      "trans": "『两边\n好像都很好吃＾＾』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020110",
      "name": "恋鐘",
      "text": "『スープスパのパーティーしよると～～！？』",
      "trans": "『汤意面派对要办咧～～！？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020120",
      "name": "摩美々",
      "text": "『しよると～』",
      "trans": "『要办咧～』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020130",
      "name": "咲耶",
      "text": "フフ\r\nいけないな、摩美々……",
      "trans": "呵呵\n这可不行啊，摩美美……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020140",
      "name": "恋鐘",
      "text": "『どこで～～～！？！？！？』",
      "trans": "『在哪儿～～～！？！？！？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020150",
      "name": "咲耶",
      "text": "『今日は遅いから、\r\nまたあらためて集まろう』",
      "trans": "『今天太晚了，\n改天再好好聚一次吧』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020160",
      "name": "恋鐘",
      "text": "『うん～～～！！　いつにする～～！？！？』",
      "trans": "『嗯～～～！！　定哪天好啊～～！？！？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020170",
      "name": "咲耶",
      "text": "『21日か22日の18時なんてどうだい？』",
      "trans": "『21号或者22号的18点怎么样？』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020180",
      "name": "恋鐘",
      "text": "……！　あ、あさってしあさっての18時～～～～！？\r\nなんば言いよっとね、咲耶────",
      "trans": "……！　后，后天大后天的18点～～～～！？\n你说什么呢，咲耶────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020190",
      "name": "恋鐘",
      "text": "『そいはすぷぱのあるけん、いけんやろ～～～！！』",
      "trans": "『那天可是有汤意面咧，不去不行吧～～～！！』",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020230",
      "name": "結華",
      "text": "……ふぅ、Ｐたんってばタイミングわるーい",
      "trans": "……呼，P碳真是的，时机也太差劲了——",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901010020240",
      "name": "結華",
      "text": "──えっ\r\n未読やば",
      "trans": "──诶\n未读，糟了",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
