{
  "translator": "岛木",
  "rows": [
    {
      "id": "1021001000910010",
      "name": "円香",
      "text": "そういえば──",
      "trans": "说起来——"
    },
    {
      "id": "1021001000910020",
      "name": "円香",
      "text": "この間、浅倉からあなたの写真が\\n送られてきたんですが",
      "trans": "之前，从浅仓那里\\n收到了你的照片"
    },
    {
      "id": "1021001000910030",
      "name": "円香",
      "text": "──なんですかこれ。どういうつもり？",
      "trans": "——这是啥。到底有何居心？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ど、どういうつもりと言われても……",
      "trans": "就，就算说我想干什么……"
    },
    {
      "id": "select",
      "name": "",
      "text": "もうしないよ",
      "trans": "再也不干了"
    },
    {
      "id": "select",
      "name": "",
      "text": "ピースしただけだ",
      "trans": "举个peace手势而已"
    },
    {
      "id": "select",
      "name": "",
      "text": "透が撮りたいって",
      "trans": "是透想拍的"
    },
    {
      "id": "1021001000910040",
      "name": "円香",
      "text": "…………………………",
      "trans": "…………………………"
    },
    {
      "id": "1021001000910050",
      "name": "円香",
      "text": "はい、よく言葉を選べましたね\\nミスター・不純物",
      "trans": "嗯，选了个不错的回答\\nMr.不纯物"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1021001000910060",
      "name": "円香",
      "text": "はあ、そうですね\\n浅倉とツーショットでピース？",
      "trans": "哈，这样哦\\n和浅仓两个人拍照摆peace而已？"
    },
    {
      "id": "1021001000910070",
      "name": "円香",
      "text": "どうでもいいけど、二度としないで",
      "trans": "怎么样都好，不要再做这种事了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1021001000910080",
      "name": "円香",
      "text": "は？",
      "trans": "哈？"
    },
    {
      "id": "1021001000910090",
      "name": "円香",
      "text": "浅倉のせいにするの？　は？",
      "trans": "你想说是浅仓的错吗？  哈？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}