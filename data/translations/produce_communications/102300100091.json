{
  "translator": "阿柚",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "雛菜、おはよう！\\nなんだか眠そうだな……",
      "trans": "雏菜，早上好！\\n你看起来好像有些困啊……"
    },
    {
      "id": "1023001000910010",
      "name": "雛菜",
      "text": "プロデューサー、おはよう～\\nすっごく眠いけど～……",
      "trans": "制作人，早上好～\\n现在确实超困的～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、コーヒーはどうだ？\\n俺も今飲んでるけど、目が覚めるぞ",
      "trans": "啊，来点咖啡怎么样？\\n我现在就在喝，很提神的哦"
    },
    {
      "id": "1023001000910020",
      "name": "雛菜",
      "text": "ん～？\\nじゃあそれ一口ちょうだい～",
      "trans": "嗯～？\\n那你的给雏菜喝一口～"
    },
    {
      "id": "select",
      "name": "",
      "text": "これは\\n苦いぞ",
      "trans": "这个\\n很苦哦"
    },
    {
      "id": "select",
      "name": "",
      "text": "新しいの\\n淹れるよ",
      "trans": "给你泡杯\\n新的吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "これはだめだ",
      "trans": "那可不行"
    },
    {
      "id": "1023001000910030",
      "name": "雛菜",
      "text": "ん～……\\nじゃあ雛菜飲めないかも～",
      "trans": "嗯～……\\n那雏菜可能喝不了～"
    },
    {
      "id": "1023001000910040",
      "name": "雛菜",
      "text": "砂糖と牛乳\\nあるかな～？",
      "trans": "有白砂糖和牛奶吗～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001000910050",
      "name": "雛菜",
      "text": "え～、いいの～～～？",
      "trans": "诶～可以吗～～～？"
    },
    {
      "id": "1023001000910060",
      "name": "雛菜",
      "text": "じゃあコーヒーと砂糖と牛乳、\\n３対３対４でお願いします～～～",
      "trans": "那咖啡、糖、牛奶的比例\\n帮调到3：3：4吧～～～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001000910070",
      "name": "雛菜",
      "text": "ん～、そっか",
      "trans": "嗯～这样啊"
    },
    {
      "id": "1023001000910080",
      "name": "雛菜",
      "text": "じゃあいいや～\\n別のやつ飲む～……",
      "trans": "那算啦～\\n雏菜去喝别的～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}