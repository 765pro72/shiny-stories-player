{
  "translator": "岛木",
  "rows": [
    {
      "id": "1021001000510010",
      "name": "円香",
      "text": "……窓を開けますね",
      "trans": "……我开下窗户"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、どうかしたか？",
      "trans": "哦，怎么了？"
    },
    {
      "id": "1021001000510020",
      "name": "円香",
      "text": "空気がこもっているので\\n換気のために",
      "trans": "因为空气太闷了\\n换下气"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうか、気付かなかった\\nありがとう",
      "trans": "是吗，我都没注意\\n谢谢"
    },
    {
      "id": "select",
      "name": "",
      "text": "いい風だな",
      "trans": "这风真舒服"
    },
    {
      "id": "select",
      "name": "",
      "text": "肌寒いかな",
      "trans": "有点冷"
    },
    {
      "id": "select",
      "name": "",
      "text": "外がうるさいな",
      "trans": "外面好吵啊"
    },
    {
      "id": "1021001000510030",
      "name": "円香",
      "text": "はい",
      "trans": "嗯"
    },
    {
      "id": "1021001000510040",
      "name": "円香",
      "text": "……気持ちいい",
      "trans": "……真舒服"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1021001000510050",
      "name": "円香",
      "text": "そうですか？",
      "trans": "是吗？"
    },
    {
      "id": "1021001000510060",
      "name": "円香",
      "text": "私はちょうどいいです",
      "trans": "我觉得刚刚好"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1021001000510070",
      "name": "円香",
      "text": "空気を入れ換えている間くらい\\n我慢できないんですか",
      "trans": "就这点换气的时间\\n都不能忍受吗"
    },
    {
      "id": "1021001000510080",
      "name": "円香",
      "text": "それに、うるさいというなら、\\nあなたの声の方がよほど耳障りです",
      "trans": "而且对我来说，\\n你的声音更加刺耳"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}