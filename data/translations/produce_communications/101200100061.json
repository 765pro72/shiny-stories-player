    },
    {
      "id": "1012001000610020",
      "name": "凛世",
      "text": "プロデューサーさまは……\\nどのような女性を……お好みになるのでしょう……",
      "trans": "制作人大人……\\n喜欢……什么样的女性呢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "と、唐突だな……\\nけど、まぁそうだな……",
      "trans": "嗯、怎么了？　凛世"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺を好きになって\\nくれる人かな",
      "trans": "会喜欢我的人吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "一緒にいると落ち着く人",
      "trans": "会喜欢我的人吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "わからないな",
      "trans": "会喜欢我的人吧"
    },
    {
      "id": "1012001000610030",
      "name": "凛世",
      "text": "プロデューサーさまを……\\n好きに……？",
      "trans": "喜欢……\\n制作人大人……？"
    },
    {
      "id": "1012001000610040",
      "name": "凛世",
      "text": "はい……！\\nありがとう……ございます……",
      "trans": "好……！\\n十分……感谢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "嗯、怎么了？　凛世"
    },
    {
      "id": "1012001000610050",
      "name": "凛世",
      "text": "落ち着く……人……",
      "trans": "能安心的……人……"
    },
    {
      "id": "1012001000610060",
      "name": "凛世",
      "text": "プロデューサーさまにとって……\\n凛世がそうであれば……よいのですが……",
      "trans": "对制作人大人来说……\\n凛世是这样的人……就好了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "嗯、怎么了？　凛世"
    },
    {
      "id": "1012001000610070",
      "name": "凛世",
      "text": "そう……ですか……\\nはい……",
      "trans": "这样……啊……\\n好……"
    },
    {
      "id": "1012001000610080",
      "name": "凛世",
      "text": "プロデューサーさまの……思う女性に……\\n近づければと、思ったのですが……",
      "trans": "凛世只是想，更靠近……\\n制作人大人……所喜欢的女性……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "嗯、怎么了？　凛世"
    }
  ]
