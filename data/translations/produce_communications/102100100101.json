{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "円香って、休みの日は何しているんだ？",
      "trans": "圆香，你休息日做了些什么？"
    },
    {
      "id": "1021001001010010",
      "name": "円香",
      "text": "答えません",
      "trans": "不会告诉你的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、冷たいなあ\\nじゃあヒントだけでも",
      "trans": "哈哈，真冷淡啊\\n那给个提示也行"
    },
    {
      "id": "1021001001010020",
      "name": "円香",
      "text": "……プライベートです",
      "trans": "……私事"
    },
    {
      "id": "select",
      "name": "",
      "text": "惰眠とか？",
      "trans": "睡懒觉？"
    },
    {
      "id": "select",
      "name": "",
      "text": "勉強とか？",
      "trans": "学习？"
    },
    {
      "id": "select",
      "name": "",
      "text": "家事とか？",
      "trans": "家务？"
    },
    {
      "id": "1021001001010030",
      "name": "円香",
      "text": "あなたと一緒にしないでください",
      "trans": "能不能不要把我和你比较"
    },
    {
      "id": "1021001001010040",
      "name": "円香",
      "text": "知らないけど",
      "trans": "我可没兴趣"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1021001001010050",
      "name": "円香",
      "text": "必要な時にはやりますが、\\nでも、それくらいは普通でしょ？",
      "trans": "必要的时候会学的，\\n不过这种程度也挺普通的吧？"
    },
    {
      "id": "1021001001010060",
      "name": "円香",
      "text": "机にかじりつくような優等生にでも見えましたか",
      "trans": "难道我看起来像是趴在桌子前奋发图强的优等生吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1021001001010070",
      "name": "円香",
      "text": "……その聞き方から察するに",
      "trans": "……从这个问法就看得出来"
    },
    {
      "id": "1021001001010080",
      "name": "円香",
      "text": "あなたは休みの日以外、家事をしないみたいですね",
      "trans": "除了休息日以外，你平时都不会做家务啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}