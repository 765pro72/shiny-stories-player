{
  "translator": "StYL3",
  "rows": [
    {
      "id": "1025001000710010",
      "name": "美琴",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "どうした？　美琴",
      "trans": "怎么了？美琴"
    },
    {
      "id": "1025001000710020",
      "name": "美琴",
      "text": "あ……ううん、２８３プロって\\n意外とこじんまりした事務所だなって思って",
      "trans": "啊……没什么，283事务所\\n真是个虽小但让人感到舒适的事务所呢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは……確かに\\nそこまで大きな事務所って訳じゃないが……",
      "trans": "哈哈……确实\\n我们不是什么大事务所呢……"
    },
    {
      "id": "select",
      "name": "",
      "text": "居心地は\\n悪くないだろ",
      "trans": "还挺舒适\\n的吧？"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺はここが\\n好きだよ",
      "trans": "我很喜欢\\n这里哦"
    },
    {
      "id": "select",
      "name": "",
      "text": "ここが一番\\nだと思ってるよ",
      "trans": "我觉得这里\\n是最棒的"
    },
    {
      "id": "1025001000710030",
      "name": "美琴",
      "text": "うーん……そうだね\\nまだ慣れてないし、変わってるとも思うけど",
      "trans": "嗯……是啊\\n我还没适应，也觉得这里有点奇怪"
    },
    {
      "id": "1025001000710040",
      "name": "美琴",
      "text": "でも、悪くはないかな",
      "trans": "但是，这也不坏"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1025001000710050",
      "name": "美琴",
      "text": "……うん、そうだね",
      "trans": "……嗯，是呢"
    },
    {
      "id": "1025001000710060",
      "name": "美琴",
      "text": "それは、見ていればすぐに\\nわかるよ",
      "trans": "看你的样子\\n就知道了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1025001000710070",
      "name": "美琴",
      "text": "そうなの？",
      "trans": "是吗？"
    },
    {
      "id": "1025001000710080",
      "name": "美琴",
      "text": "だけどプロデューサー、\\n他の事務所のこと、あまり知らないんじゃない？",
      "trans": "那是因为制作人\\n没去了解过其他事务所吧？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}