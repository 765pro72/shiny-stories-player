{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "お、いいもの飲んでるな",
      "trans": "哦，在喝什么好喝的"
    },
    {
      "id": "1020001001310010",
      "name": "透",
      "text": "え？　うん",
      "trans": "诶？　嗯"
    },
    {
      "id": "1020001001310020",
      "name": "透",
      "text": "飲む？",
      "trans": "要喝吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──こら",
      "trans": "──喂"
    },
    {
      "id": "select",
      "name": "",
      "text": "からかうんじゃない",
      "trans": "不要捉弄我啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "飲まない",
      "trans": "不喝"
    },
    {
      "id": "select",
      "name": "",
      "text": "透が飲んでくれ",
      "trans": "透喝就行了"
    },
    {
      "id": "0000000000000",
      "name": "",
      "text": "★選択肢①【からかうんじゃない】PERFECT",
      "trans": "★选项①【别捉弄人】PERFECT",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "1020001001310030",
      "name": "透",
      "text": "あははっ、ごめん",
      "trans": "啊哈哈，抱歉"
    },
    {
      "id": "1020001001310040",
      "name": "透",
      "text": "炭酸平気なら\\nもう１本あるよ",
      "trans": "要喝碳酸饮料的话\\n还有一瓶哦"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "0000000000000",
      "name": "",
      "text": "★選択肢②【飲まない】GOOD",
      "trans": "★选项②【不喝】GOOD",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "1020001001310050",
      "name": "透",
      "text": "えー",
      "trans": "诶——"
    },
    {
      "id": "1020001001310060",
      "name": "透",
      "text": "まぁ、もう空だけどね",
      "trans": "算了，反正也喝完了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "",
      "text": "★選択肢③【透が飲んでくれ】NORMAL",
      "trans": "★选项③【让透喝吧】NORMAL",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "1020001001310070",
      "name": "透",
      "text": "……あ、うん",
      "trans": "……啊，嗯"
    },
    {
      "id": "1020001001310080",
      "name": "透",
