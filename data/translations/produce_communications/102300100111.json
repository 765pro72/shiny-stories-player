{
  "translator": "阿柚",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "雛菜、おはよう",
      "trans": "雏菜，早上好"
    },
    {
      "id": "1023001001110010",
      "name": "雛菜",
      "text": "あ、おはよう～\\nプロデューサー………………",
      "trans": "啊，早上好～\\n制作人………………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "こら、朝の挨拶をしながらソファに\\n寝転がるんじゃない……！",
      "trans": "喂喂，别边打着招呼\\n边躺到沙发上啊……！"
    },
    {
      "id": "1023001001110020",
      "name": "雛菜",
      "text": "あは～\\nだってここ雛菜の特等席だもん～",
      "trans": "啊哈～\\n因为这里是雏菜的特等席啊～"
    },
    {
      "id": "select",
      "name": "",
      "text": "今だけ\\nだぞ……！",
      "trans": "只限\\n现在哦……！"
    },
    {
      "id": "select",
      "name": "",
      "text": "誰か来たら\\n退くんだぞ？",
      "trans": "等谁一来\\n要马上让开哦"
    },
    {
      "id": "select",
      "name": "",
      "text": "ここで\\n寝ちゃだめだ",
      "trans": "在这儿睡着\\n可不行啊"
    },
    {
      "id": "1023001001110030",
      "name": "雛菜",
      "text": "うん～\\n誰か来たらちゃんと座るよ～？",
      "trans": "嗯～\\n有谁来的时候会好好坐着的哦～"
    },
    {
      "id": "1023001001110040",
      "name": "雛菜",
      "text": "プロデューサーしかいなかったら\\nいいでしょ～？",
      "trans": "反正现在也只有制作人在\\n没关系吧～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001001110050",
      "name": "雛菜",
      "text": "わかってるよ～",
      "trans": "知道了～"
    },
    {
      "id": "1023001001110060",
      "name": "雛菜",
      "text": "だから今はおやすみ～……",
      "trans": "那么现在先晚安～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001001110070",
      "name": "雛菜",
      "text": "え～……\\n雛菜、寝てるから聞こえません～",
      "trans": "诶～……\\n雏菜，因为睡着了所以听不见～"
    },
    {
      "id": "1023001001110080",
      "name": "雛菜",
      "text": "聞こえてないからね～～～？",
      "trans": "一个字都听不见～～～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}