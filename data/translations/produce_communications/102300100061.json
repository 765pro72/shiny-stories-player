{
  "translator": "阿柚",
  "rows": [
    {
      "id": "1023001000610010",
      "name": "雛菜",
      "text": "プロデューサー、\\nこの間本屋さんでね～",
      "trans": "制作人，\\n前几天在书店的时候"
    },
    {
      "id": "1023001000610020",
      "name": "雛菜",
      "text": "幸せになるための方法？\\nみたいな本が売ってたんだけど……",
      "trans": "有在卖一本好像是在教人\\n“变得幸福的方法”的书来着……"
    },
    {
      "id": "1023001000610030",
      "name": "雛菜",
      "text": "どう思う～～～？",
      "trans": "你怎么看～～～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え……そ、そうだな……",
      "trans": "诶……这，这样啊……"
    },
    {
      "id": "select",
      "name": "",
      "text": "雛菜も\\n書けそうだな",
      "trans": "雏菜应该也能\\n写一本啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "需要が\\nあるんだな",
      "trans": "也有人需要\\n这样的书啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "それ、\\n買ったのか？",
      "trans": "买了那书吗？"
    },
    {
      "id": "1023001000610040",
      "name": "雛菜",
      "text": "あは～、そうだよね～？",
      "trans": "啊哈～是这样呢～"
    },
    {
      "id": "1023001000610050",
      "name": "雛菜",
      "text": "雛菜がしあわせ～って思うこと\\nみんなに教えてあげたいね～",
      "trans": "雏菜想把自己感觉幸福的事情\\n告诉给大家呢～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001000610060",
      "name": "雛菜",
      "text": "ん～、そっか～～～",
      "trans": "嗯～这样啊～～～"
    },
    {
      "id": "1023001000610070",
      "name": "雛菜",
      "text": "やっぱりみんな\\nしあわせになりたいんだな～",
      "trans": "果然大家\\n都会想要幸福的啊～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001000610080",
      "name": "雛菜",
      "text": "へ～～～？\\n買ってないよ～",
      "trans": "诶～～～？\\n没买哟～"
    },
    {
      "id": "1023001000610090",
      "name": "雛菜",
      "text": "もうしあわせだもん\\n雛菜には必要ないかな～",
      "trans": "已经很幸福了啊\\n雏菜我是完全用不着啦～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}