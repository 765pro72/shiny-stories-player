{
  "translator": "岛木",
  "rows": [
    {
      "id": "1024001000510010",
      "name": "にちか",
      "text": "……\\n…………",
      "trans": "……\\n…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……に、にちか\\n大丈夫か、その…………",
      "trans": "……日，日花\\n没事吧，那个…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いいんだぞ、俺は。これ、分けたって……\\nでもダイエットだって言うから──",
      "trans": "我没关系的。把这个分你一半……\\n不过你说了要减肥——"
    },
    {
      "id": "1024001000510020",
      "name": "にちか",
      "text": "…………\\n………………",
      "trans": "…………\\n………………"
    },
    {
      "id": "select",
      "name": "",
      "text": "話さなくていい",
      "trans": "不用回复也行"
    },
    {
      "id": "select",
      "name": "",
      "text": "あっちで\\n食べてくるよ",
      "trans": "我去\\n那边吃吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "……悪いな\\n俺ばっかり",
      "trans": "……抱歉\\n就我一人吃独食"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……カロリー使うもんな\\n話すっていうのも……",
      "trans": "……毕竟说话也要\\n消耗卡路里……"
    },
    {
      "id": "1024001000510030",
      "name": "にちか",
      "text": "……\\nていうか……",
      "trans": "……\\n不如说……"
    },
    {
      "id": "1024001000510040",
      "name": "にちか",
      "text": "しまってくださいよ……\\nそれ…………",
      "trans": "请把这份……\\n收回去吧…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1024001000510050",
      "name": "にちか",
      "text": "…………\\nそれは……ありがたいです…………",
      "trans": "…………\\n那还……真是感谢了…………"
    },
    {
      "id": "1024001000510060",
      "name": "にちか",
      "text": "……あ、でも…………\\nちょっと見てたい……かもです……ハンバーグ弁当……",
      "trans": "……啊，不过…………\\n我也有点想看看……汉堡肉便当……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1024001000510070",
      "name": "にちか",
      "text": "…………って、言うんだったら…………",
      "trans": "…………要这么说的话…………"
    },
    {
      "id": "1024001000510080",
      "name": "にちか",
      "text": "食べなきゃいいじゃないですかー…………",
      "trans": "不吃不就行了吗…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}