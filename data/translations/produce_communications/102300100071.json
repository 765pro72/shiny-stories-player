{
  "translator": "阿柚",
  "rows": [
    {
      "id": "1023001000710010",
      "name": "雛菜",
      "text": "ね～、プロデューサー、\\n冷蔵庫のおやつ……",
      "trans": "喂～制作人，\\n冰箱的点心……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、好きなのひとつ\\n取っていいらしいぞ",
      "trans": "啊，可以选一个自己喜欢的哦"
    },
    {
      "id": "1023001000710020",
      "name": "雛菜",
      "text": "雛菜、いちごも食べたいけど……\\nチョコも食べたい～……",
      "trans": "雏菜，虽然想吃草莓味的……\\n但巧克力味的也想吃～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、そうか",
      "trans": "哈哈，这样啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺の分も\\n食べていいぞ",
      "trans": "把我那份吃了\\n也没关系哦"
    },
    {
      "id": "select",
      "name": "",
      "text": "半分こに\\nするか？",
      "trans": "两种都分一半\\n怎么样？"
    },
    {
      "id": "select",
      "name": "",
      "text": "ひとり\\nひとつだぞ",
      "trans": "一人\\n只能一个哦"
    },
    {
      "id": "1023001000710030",
      "name": "雛菜",
      "text": "やは～♡\\nほんとにいいの～！？",
      "trans": "呀哈～♡\\n真的可以吗～！？"
    },
    {
      "id": "1023001000710040",
      "name": "雛菜",
      "text": "すっごいうれしい～\\n雛菜、プロデューサーだいすき～",
      "trans": "超开心～\\n雏菜，最喜欢制作人了～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001000710050",
      "name": "雛菜",
      "text": "あは～\\nほんと～！？",
      "trans": "啊哈～\\n真的吗～！？"
    },
    {
      "id": "1023001000710060",
      "name": "雛菜",
      "text": "うれしい～\\n雛菜、プロデューサーすき～",
      "trans": "好开心～\\n雏菜，喜欢制作人～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001000710070",
      "name": "雛菜",
      "text": "え～～～\\nわかってるけど～……",
      "trans": "诶～～～\\n知道了～……"
    },
    {
      "id": "1023001000710080",
      "name": "雛菜",
      "text": "じゃあいちごにする～……",
      "trans": "那雏菜选草莓味吧～……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}