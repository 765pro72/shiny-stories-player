{
  "translator": "岛木",
  "rows": [
    {
      "id": "1022001001210010",
      "name": "小糸",
      "text": "あ……！\\nど、どうしよう……",
      "trans": "啊……！\\n怎，怎么办……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "小糸？\\nどうかしたか？",
      "trans": "小糸？\\n发生什么事了？"
    },
    {
      "id": "1022001001210020",
      "name": "小糸",
      "text": "あ、いえあの……お弁当、\\n妹のと間違えて持ってきちゃったみたいで……",
      "trans": "啊，那个……便当，\\n错拿到妹妹的那份了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "小糸、そういえば妹がいたんだったな \\nうーん、弁当か……",
      "trans": "小糸，原来还有个妹妹的啊\\n嗯，便当……"
    },
    {
      "id": "select",
      "name": "",
      "text": "連絡して\\nみたらどうだ？",
      "trans": "打个电话\\n怎么样？"
    },
    {
      "id": "select",
      "name": "",
      "text": "取りに\\n戻るか？",
      "trans": "要回去\\n再取一遍吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "中身が一緒なら\\n大丈夫だろ",
      "trans": "菜是一样的话\\n就没问题吧"
    },
    {
      "id": "1022001001210030",
      "name": "小糸",
      "text": "あ……そ、そうですよね……！\\nそうします！",
      "trans": "啊……对，对……！\\n就这样做吧！"
    },
    {
      "id": "1022001001210040",
      "name": "小糸",
      "text": "ちょっと電話してきますね！",
      "trans": "我去打个电话！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1022001001210050",
      "name": "小糸",
      "text": "い、いえ……！\\n大丈夫です……！",
      "trans": "不，不用……！\\n没关系的……！"
    },
    {
      "id": "1022001001210060",
      "name": "小糸",
      "text": "あ、ありがとうございます\\n連絡だけ、してみますね……！",
      "trans": "谢，谢谢\\n我去打个电话……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1022001001210070",
      "name": "小糸",
      "text": "あ……そうですよね……",
      "trans": "啊……说的也对……"
    },
    {
      "id": "1022001001210080",
      "name": "小糸",
      "text": "い、一応、連絡して\\n聞いてみます……",
      "trans": "姑，姑且还是打个电话\\n说一声吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}