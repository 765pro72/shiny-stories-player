{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "小糸！\\nおはよう！",
      "trans": "小糸！\\n早上好！"
    },
    {
      "id": "1022001001510010",
      "name": "小糸",
      "text": "は、はい！\\nおはようございます、プロデューサーさん……！",
      "trans": "是，是！\\n早上好，制作人……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………！\\n小糸も随分慣れてくれたな……",
      "trans": "…………！\\n小糸也终于习惯了啊……"
    },
    {
      "id": "1022001001510020",
      "name": "小糸",
      "text": "な、なんですか……も、もしかして\\nわたしと挨拶できて嬉しいんですか……！",
      "trans": "在，在说什么呢……难，难道\\n能和我打招呼这么高兴吗……！"
    },
    {
      "id": "select",
      "name": "",
      "text": "すごく\\n嬉しいよ",
      "trans": "非常\\n高兴哦"
    },
    {
      "id": "select",
      "name": "",
      "text": "当たり前だろ",
      "trans": "那是当然"
    },
    {
      "id": "select",
      "name": "",
      "text": "はは、\\nどうかな",
      "trans": "哈哈，\\n谁知道呢"
    },
    {
      "id": "1022001001510030",
      "name": "小糸",
      "text": "な……なんですか\\nほ、ほんとにもう……！",
      "trans": "怎……怎么了\\n真，真是的……！"
    },
    {
      "id": "1022001001510040",
      "name": "小糸",
      "text": "わ、わたしがいないと\\nだめだめプロデューサーさんですね……！",
      "trans": "要是我，我不在的话\\n就成了没用又不行的制作人了吗……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1022001001510050",
      "name": "小糸",
      "text": "そ、そうですか……！",
      "trans": "是，是吗……！"
    },
    {
      "id": "1022001001510060",
      "name": "小糸",
      "text": "よ、よかったですね……！\\n明日も明後日も挨拶できます、よ……！",
      "trans": "那，那可太好了……！\\n明天后天也要打招呼，哦……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1022001001510070",
      "name": "小糸",
      "text": "え……！\\nち、違うんですか……！",
      "trans": "欸……！\\n不，不是这样的吗……！"
    },
    {
      "id": "1022001001510080",
      "name": "小糸",
      "text": "そ、そうですか……！\\nべ、別にいいですけど……！",
      "trans": "是，是吗……！\\n反，反正也没有什么所谓……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}