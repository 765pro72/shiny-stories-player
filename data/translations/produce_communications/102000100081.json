{
  "translator": "岛木",
  "rows": [
    {
      "id": "1020001000810010",
      "name": "透",
      "text": "あっつ……\\nちょっとこぼれちゃった、コーヒー",
      "trans": "好烫……\\n咖啡有点洒出来了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "透？　大丈夫か",
      "trans": "透？　没事吧"
    },
    {
      "id": "1020001000810020",
      "name": "透",
      "text": "あつあつ……\\nごめん、タオルないかな",
      "trans": "烫烫……\\n不好意思，有毛巾吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おう\\n──ほら",
      "trans": "哦\\n──给"
    },
    {
      "id": "select",
      "name": "",
      "text": "マグも、\\nちゃんと置いて",
      "trans": "杯子，\\n先放下来吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "気を付けてな",
      "trans": "小心点"
    },
    {
      "id": "select",
      "name": "",
      "text": "シミになるかな",
      "trans": "会留下污渍吗"
    },
    {
      "id": "1020001000810030",
      "name": "透",
      "text": "ありがと",
      "trans": "谢谢"
    },
    {
      "id": "1020001000810040",
      "name": "透",
      "text": "ごめんね\\n熱いの苦手なんだ",
      "trans": "抱歉\\n不太习惯烫的东西"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001000810050",
      "name": "透",
      "text": "うん\\n──あ、これプロデューサーの？",
      "trans": "嗯\\n──啊，这个是制作人的？"
    },
    {
      "id": "1020001000810060",
      "name": "透",
      "text": "ごめんね、\\n洗って返すから",
      "trans": "对不起，\\n洗干净再还给你吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001000810070",
      "name": "透",
      "text": "うん\\n……コーヒー、そんなに得意じゃないのに",
      "trans": "嗯\\n……明明不太擅长泡咖啡"
    },
    {
      "id": "1020001000810080",
      "name": "透",
      "text": "やめとけばよかった",
      "trans": "早知道就不泡了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}