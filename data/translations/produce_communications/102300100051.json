{
  "translator": "阿柚",
  "rows": [
    {
      "id": "1023001000510010",
      "name": "雛菜",
      "text": "あ～♡\\nプロデューサー！",
      "trans": "啊～♡\\n制作人！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おお、雛菜おはよう\\nなんだかご機嫌だな",
      "trans": "哦，雏菜啊\\n感觉你心情不错啊"
    },
    {
      "id": "1023001000510020",
      "name": "雛菜",
      "text": "あは～？\\nわかりますか～？",
      "trans": "啊哈～？\\n看得出来吗～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、何かいいことでも……",
      "trans": "是啊，应该是有什么好事儿……"
    },
    {
      "id": "select",
      "name": "",
      "text": "さては\\n透だな",
      "trans": "跟透有关吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "さては\\n小糸だな",
      "trans": "跟小糸有关吧"
    },
    {
      "id": "select",
      "name": "",
      "text": "さては\\n円香だな",
      "trans": "跟圆香有关吧"
    },
    {
      "id": "1023001000510030",
      "name": "雛菜",
      "text": "え～！\\nなんでわかったの～～～！？",
      "trans": "诶～！\\n你怎么知道啊～～～！？"
    },
    {
      "id": "1023001000510040",
      "name": "雛菜",
      "text": "今日は透先輩のお家に\\n行くんだ～～～♡",
      "trans": "今天要去透前辈家里啦～～～♡"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001000510050",
      "name": "雛菜",
      "text": "あは～、昨日小糸ちゃんに\\n小テストのヤマ教えてもらったら～",
      "trans": "啊哈～昨天小糸\\n教了雏菜许多小考试的重点～"
    },
    {
      "id": "1023001000510060",
      "name": "雛菜",
      "text": "満点だった～！\\nすごいよね～？",
      "trans": "然后考了满分～！\\n厉害吧～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001000510070",
      "name": "雛菜",
      "text": "ん～……\\n円香先輩には会ってないよ～？",
      "trans": "嗯～……\\n雏菜没和圆香前辈见过面哦～？"
    },
    {
      "id": "1023001000510080",
      "name": "雛菜",
      "text": "なんで円香先輩だと\\n思ったの～？",
      "trans": "为什么会觉得是圆香前辈啊～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}