{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あれ？\\n透、髪に何かついてるぞ",
      "trans": "咦？\\n透，头发上好像有什么东西"
    },
    {
      "id": "1020001001210010",
      "name": "透",
      "text": "え、うそ",
      "trans": "诶，不会吧"
    },
    {
      "id": "1020001001210020",
      "name": "透",
      "text": "──えっ、どこ",
      "trans": "──唔，在哪"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "じっとしててくれ",
      "trans": "站着别动"
    },
    {
      "id": "select",
      "name": "",
      "text": "──ほら",
      "trans": "──看"
    },
    {
      "id": "select",
      "name": "",
      "text": "──セロハン\\nテープか？",
      "trans": "──透明胶带吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "すまんな、触るぞ",
      "trans": "抱歉，会碰到你"
    },
    {
      "id": "1020001001210030",
      "name": "透",
      "text": "……何これ、羽？",
      "trans": "……这是什么，羽毛？"
    },
    {
      "id": "1020001001210040",
      "name": "透",
      "text": "ふふっ、何これ",
      "trans": "呵呵，这算什么"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001001210050",
      "name": "透",
      "text": "……あー\\nさっき、使ってて",
      "trans": "……啊\\n刚才在用的"
    },
    {
      "id": "1020001001210060",
      "name": "透",
      "text": "ありがと",
      "trans": "谢谢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001001210070",
      "name": "透",
      "text": "あ、うん",
      "trans": "啊，嗯"
    },
    {
      "id": "1020001001210080",
      "name": "透",
      "text": "……ひやってする。なんか",
      "trans": "……感觉有点被吓到"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}