{
  "translator": "岛木",
  "rows": [
    {
      "id": "1020001000710010",
      "name": "透",
      "text": "──……",
      "trans": "──……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "音楽聴いてるのか？",
      "trans": "在听音乐吗？"
    },
    {
      "id": "1020001000710020",
      "name": "透",
      "text": "──……あ\\nプロデューサー？",
      "trans": "──……啊\\n制作人？"
    },
    {
      "id": "1020001000710030",
      "name": "透",
      "text": "何か言った？",
      "trans": "刚才说了什么吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "いや、聴いてるなって",
      "trans": "没，你在听音乐吗"
    },
    {
      "id": "select",
      "name": "",
      "text": "ごめん、邪魔したな",
      "trans": "抱歉，打扰到你了吗"
    },
    {
      "id": "select",
      "name": "",
      "text": "なんでもないんだ",
      "trans": "没什么"
    },
    {
      "id": "1020001000710040",
      "name": "透",
      "text": "え？\\n……あ、ううん",
      "trans": "诶？\\n……啊，不是"
    },
    {
      "id": "1020001000710050",
      "name": "透",
      "text": "寝てたよ",
      "trans": "刚睡着了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001000710060",
      "name": "透",
      "text": "え？　そんなことないよ",
      "trans": "诶？　不会"
    },
    {
      "id": "1020001000710070",
      "name": "透",
      "text": "ぼーっとしてただけだし",
      "trans": "在发呆而已"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001000710080",
      "name": "透",
      "text": "……？\\nそうなんだ",
      "trans": "……？\\n这样啊"
    },
    {
      "id": "1020001000710090",
      "name": "透",
      "text": "──まだ聴いてていい？",
      "trans": "──那再说一遍可以吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}