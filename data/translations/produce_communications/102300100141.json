{
  "translator": "阿柚",
  "rows": [
    {
      "id": "1023001001410010",
      "name": "雛菜",
      "text": "プロデューサー、見て～～～？\\nかわいいでしょ～～～",
      "trans": "制作人你看～～～\\n可爱吧～～～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？\\nストラップか",
      "trans": "嗯？\\n挂坠啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "透とお揃いで付けるのか？",
      "trans": "是准备和透系一样的吗？"
    },
    {
      "id": "1023001001410020",
      "name": "雛菜",
      "text": "ん～？\\nこれは雛菜と、プロデューサーの～！",
      "trans": "嗯～？\\n这是雏菜和制作人的～！"
    },
    {
      "id": "select",
      "name": "",
      "text": "ありがとう！",
      "trans": "谢谢！"
    },
    {
      "id": "select",
      "name": "",
      "text": "貰って\\nいいのか？",
      "trans": "真的可以\\n收下吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "ちょっと\\n可愛すぎないか？",
      "trans": "是不是有点\\n太可爱了啊？"
    },
    {
      "id": "1023001001410030",
      "name": "雛菜",
      "text": "あは～、プロデューサー\\nカバンに付ける？　スマホに付ける？",
      "trans": "啊哈～制作人\\n准备系在包上？　还是手机上？"
    },
    {
      "id": "1023001001410040",
      "name": "雛菜",
      "text": "ちゃんと付けてね～～～？",
      "trans": "要好好用着哦～～～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001001410050",
      "name": "雛菜",
      "text": "うん～\\nそのために持ってきたんだよ～？",
      "trans": "嗯～\\n就是为了给你才带过来的哟～"
    },
    {
      "id": "1023001001410060",
      "name": "雛菜",
      "text": "お揃い～～～！",
      "trans": "一对的～～～！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001001410070",
      "name": "雛菜",
      "text": "え～～～……\\nだからいいのに～",
      "trans": "诶～～～……\\n这不是挺好的嘛～"
    },
    {
      "id": "1023001001410080",
      "name": "雛菜",
      "text": "いらないならいいけど～",
      "trans": "不要的话也行啦～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}