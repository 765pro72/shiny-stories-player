{
  "translator": "",
  "rows": [
    {
      "id": "1013001000110010",
      "name": "夏葉",
      "text": "おはよう、プロデューサー",
      "trans": "早啊，制作人"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？　ああ、おはよう",
      "trans": "嗯？ 啊啊，早啊"
    },
    {
      "id": "1013001000110020",
      "name": "夏葉",
      "text": "なんだか気が抜けてるわね？\\n１日の始まりなんだから、挨拶はちゃんとした方がいいわよ",
      "trans": "怎么有点没精神啊？\\n一天才刚刚开始所以，招呼要好好打的啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（挨拶か、そうだな……）",
      "trans": "（打招呼，对哦……）"
    },
    {
      "id": "select",
      "name": "",
      "text": "夏葉！　おはよう！",
      "trans": "夏叶！ 早啊！"
    },
    {
      "id": "select",
      "name": "",
      "text": "おはようございます",
      "trans": "早上好"
    },
    {
      "id": "select",
      "name": "",
      "text": "グッドモーニング",
      "trans": "Good Morning"
    },
    {
      "id": "1013001000110030",
      "name": "夏葉",
      "text": "ふふっ、いいわね！",
      "trans": "呵呵，不错啊！"
    },
    {
      "id": "1013001000110040",
      "name": "夏葉",
      "text": "元気に挨拶もできたことだし\\nいい１日になりそうだわ",
      "trans": "很有活力地打了招呼的话\\n就一定会是不错的一天"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1013001000110050",
      "name": "夏葉",
      "text": "おはようございます",
      "trans": "早上好"
    },
    {
      "id": "1013001000110060",
      "name": "夏葉",
      "text": "礼儀正しい挨拶もいいわね\\nそこは評価に値するわ",
      "trans": "礼貌地打招呼也是很好的\\n也是值得这样的评价的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1013001000110070",
      "name": "夏葉",
      "text": "なぜ英語にしたの？　理由を聞きたいところね",
      "trans": "为什么要用英语啊？ 只是想知道理由"
    },
    {
      "id": "1013001000110080",
      "name": "夏葉",
      "text": "……まあ、いいわ\\n今日の予定はどうなっているのかしら？",
      "trans": "……嘛，也好\\n今天的预定会怎么样呢？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}