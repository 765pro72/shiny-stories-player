{
  "translator": "告",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ……どうかしたのか？",
      "trans": "路加……怎么了？"
    },
    {
      "id": "1026001000510010",
      "name": "ルカ",
      "text": "うるせぇな……",
      "trans": "好吵啊……"
    },
    {
      "id": "1026001000510020",
      "name": "ルカ",
      "text": "イラついてる時に話しかけんなよ……",
      "trans": "我不爽的时候别和我说话……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え……",
      "trans": "诶……"
    },
    {
      "id": "select",
      "name": "",
      "text": "もしかして\\n俺が何かしたか？",
      "trans": "难道\\n我做了什么吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "誰かと揉めたとか",
      "trans": "和谁吵架了吗"
    },
    {
      "id": "select",
      "name": "",
      "text": "今見てる映像か？",
      "trans": "因为在看的视频？"
    },
    {
      "id": "1026001000510030",
      "name": "ルカ",
      "text": "あ…………？",
      "trans": "啊…………？"
    },
    {
      "id": "1026001000510040",
      "name": "ルカ",
      "text": "ハッ……そうかもな\\nわかってきたじゃねぇか",
      "trans": "哈……也许吧\\n你也开窍了啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1026001000510050",
      "name": "ルカ",
      "text": "なんでそうなんだよ",
      "trans": "为什么会这么想啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、違うならいいんだ\\nははは……",
      "trans": "没有，不是就好\\n哈哈哈……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そのアーティストのパフォーマンスが\\n良くなかったとか……？",
      "trans": "是因为那个艺人的表演\\n不太好吗……？"
    },
    {
      "id": "1026001000510060",
      "name": "ルカ",
      "text": "うるせぇな……\\n良かったからイラついてんだよ……",
      "trans": "吵死了……\\n因为太好所以我才不爽……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}