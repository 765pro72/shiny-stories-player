{
  "translator": "StYL3",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "美琴は実家、\\n帰ったりするのか？",
      "trans": "美琴\\n你回过老家吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……結構遠方だよな",
      "trans": "……好像还挺远的啊"
    },
    {
      "id": "1025001001010010",
      "name": "美琴",
      "text": "え？\\n……ううん、全然帰っていないの",
      "trans": "诶？\\n……没有哦，完全没回去过"
    },
    {
      "id": "1025001001010020",
      "name": "美琴",
      "text": "ちゃんと、ここで結果を出すことが\\n恩返しだと思っているから",
      "trans": "想着要在这里做出些成绩\\n才回去"
    },
    {
      "id": "select",
      "name": "",
      "text": "なるほどな",
      "trans": "原来是这样"
    },
    {
      "id": "select",
      "name": "",
      "text": "そうなのか",
      "trans": "是吗"
    },
    {
      "id": "select",
      "name": "",
      "text": "……でもさ",
      "trans": "……但是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……確かに、美琴の言う通りだ\\n恩返し、していかないとな",
      "trans": "……确实，就像你说的\\n得回报他们才行呢"
    },
    {
      "id": "1025001001010030",
      "name": "美琴",
      "text": "うん……そうなの\\n本当にね",
      "trans": "嗯……是啊\\n就得这样才对"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ちゃんとご両親まで美琴の活躍が\\n届くように、俺も頑張らないとな……",
      "trans": "为了让你的父母知道你活跃的样子\\n我也得加油才行……"
    },
    {
      "id": "1025001001010040",
      "name": "美琴",
      "text": "……うん\\nそうだね……私も",
      "trans": "……嗯\\n是啊……我也要加油"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "連絡くらいは、してあげてくれよ\\nきっと心配してるだろうし……",
      "trans": "至少要跟他们保持联络啊\\n家里人肯定很担心你……"
    },
    {
      "id": "1025001001010050",
      "name": "美琴",
      "text": "……うん\\nそうかもしれないね",
      "trans": "……嗯\\n或许吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}