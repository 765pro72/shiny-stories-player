{
  "translator": "告",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ、レッスン室使ったか？",
      "trans": "路加，你用过练习室了？"
    },
    {
      "id": "1026001001310010",
      "name": "ルカ",
      "text": "レッスン室……？",
      "trans": "练习室……？"
    },
    {
      "id": "1026001001310020",
      "name": "ルカ",
      "text": "だったらどうなんだよ",
      "trans": "那又怎样"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや……",
      "trans": "不……"
    },
    {
      "id": "select",
      "name": "",
      "text": "鍵がないんだが……",
      "trans": "我找不到钥匙……"
    },
    {
      "id": "select",
      "name": "",
      "text": "使う時は\\nひと声かけてほしい",
      "trans": "用之前\\n你知会我一声"
    },
    {
      "id": "select",
      "name": "",
      "text": "問題はないが……",
      "trans": "是没问题……"
    },
    {
      "id": "1026001001310030",
      "name": "ルカ",
      "text": "鍵？　んなもん……\\nあ…………",
      "trans": "钥匙？ 那玩意……\\n啊…………"
    },
    {
      "id": "1026001001310040",
      "name": "ルカ",
      "text": "なんだよその目……\\n今返すんだから問題ねぇだろ",
      "trans": "你这眼神什么意思啊……\\n我现在还你不就没问题了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1026001001310050",
      "name": "ルカ",
      "text": "……わかってるよ",
      "trans": "……我知道"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん、空いてる時はいつでも使っていいからな",
      "trans": "嗯，空着的时候都可以用"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "使う時は\\nいつも戸締りを忘れないようにな",
      "trans": "用完之后\\n别忘了锁门"
    },
    {
      "id": "1026001001310060",
      "name": "ルカ",
      "text": "うるせェな\\nちゃんとかけただろ",
      "trans": "烦死了\\n不是锁好了吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}