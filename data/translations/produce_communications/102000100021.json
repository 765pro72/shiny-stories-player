{
  "translator": "岛木",
  "rows": [
    {
      "id": "1020001000210010",
      "name": "透",
      "text": "ふぁ……──",
      "trans": "哈啊……──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんだ？\\n寝てないみたいな顔してるな",
      "trans": "怎么了？\\n一晚没睡的样子"
    },
    {
      "id": "1020001000210020",
      "name": "透",
      "text": "ん……\\nなんか、動画観てて──",
      "trans": "嗯……\\n看视频去了──"
    },
    {
      "id": "1020001000210030",
      "name": "透",
      "text": "──おはよう、プロデューサー",
      "trans": "──早上好，制作人"
    },
    {
      "id": "select",
      "name": "",
      "text": "おはよう",
      "trans": "早上好"
    },
    {
      "id": "select",
      "name": "",
      "text": "うーん、やり直し",
      "trans": "嗯，重来一遍"
    },
    {
      "id": "select",
      "name": "",
      "text": "ははは、眠そうだ",
      "trans": "哈哈哈，这么困啊"
    },
    {
      "id": "1020001000210040",
      "name": "透",
      "text": "プロデューサーはしゃっきりしてるね\\nふぁ……──",
      "trans": "制作人真精神啊\\n哈啊……──"
    },
    {
      "id": "1020001000210050",
      "name": "透",
      "text": "──あ、ごめん……\\nもう禁止するから、あくび",
      "trans": "──啊，抱歉……\\n不会再打哈欠了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001000210060",
      "name": "透",
      "text": "あ、ダメ……？\\n──んんっ",
      "trans": "啊，不行……？\\n──咳"
    },
    {
      "id": "1020001000210070",
      "name": "透",
      "text": "おはよう、プロデューサー",
      "trans": "早上好，制作人"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001000210080",
      "name": "透",
      "text": "だって、眠いし",
      "trans": "因为，就是很困啊"
    },
    {
      "id": "1020001000210090",
      "name": "透",
      "text": "ごめんね\\n顔、洗ってくるよ",
      "trans": "抱歉\\n我去洗个脸"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}