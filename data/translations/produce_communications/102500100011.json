{
  "translator": "StYL3",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あれ、美琴\\n来てたのか",
      "trans": "咦，美琴\\n你来了啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おはよう！",
      "trans": "早啊！"
    },
    {
      "id": "1025001000110010",
      "name": "美琴",
      "text": "……うん、おはよう",
      "trans": "……嗯，早"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんだ、朝なのに元気が無いな",
      "trans": "怎感觉你一大早就没精神"
    },
    {
      "id": "select",
      "name": "",
      "text": "朝ご飯\\n食べたか？",
      "trans": "吃过\\n早餐了吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "ちゃんと\\n寝れたか？",
      "trans": "有好好\\n睡一觉吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "規則正しい\\n生活しないとな",
      "trans": "得调整好\\n作息才行啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "もしまだなら、\\nこのパン、食べるか？",
      "trans": "还没吃的话\\n要不要吃个面包？"
    },
    {
      "id": "1025001000110020",
      "name": "美琴",
      "text": "……いいの？\\nじゃあ、いただこうかな",
      "trans": "……可以吗？\\n那么，我就收下了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1025001000110030",
      "name": "美琴",
      "text": "え？\\nうん、これから帰って寝るよ",
      "trans": "诶？\\n没哦，正想回去睡觉"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "えっ、これから……！？",
      "trans": "诶，现在才睡……！？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "体調管理もしっかりな！",
      "trans": "还要注意健康啊！"
    },
    {
      "id": "1025001000110040",
      "name": "美琴",
      "text": "……うん\\nでも、大丈夫だから",
      "trans": "……嗯\\n但是，我没事的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}