{
  "translator": "StYL3",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "美琴は、地元から出てきて\\nもう長いよな？",
      "trans": "美琴来东京\\n也有段日子了吧？"
    },
    {
      "id": "1025001000510010",
      "name": "美琴",
      "text": "……うん、そうだね\\nもう10年",
      "trans": "……嗯，是啊\\n快10年了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "じゃあ、家事とかも\\n得意なのか？",
      "trans": "那么，你擅长\\n做家务吗？"
    },
    {
      "id": "1025001000510020",
      "name": "美琴",
      "text": "え……？",
      "trans": "诶……？"
    },
    {
      "id": "select",
      "name": "",
      "text": "洗濯とか",
      "trans": "比如说洗衣服"
    },
    {
      "id": "select",
      "name": "",
      "text": "掃除とか",
      "trans": "比如说打扫"
    },
    {
      "id": "select",
      "name": "",
      "text": "料理とか",
      "trans": "比如说做饭"
    },
    {
      "id": "1025001000510030",
      "name": "美琴",
      "text": "うん、洗濯はするよ",
      "trans": "嗯，我经常会洗衣服"
    },
    {
      "id": "1025001000510040",
      "name": "美琴",
      "text": "……洗濯機が、大体してくれるから",
      "trans": "……都是让洗衣机洗的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1025001000510050",
      "name": "美琴",
      "text": "……うん",
      "trans": "……嗯"
    },
    {
      "id": "1025001000510060",
      "name": "美琴",
      "text": "ほとんど物が無いから、\\n掃除は楽なの",
      "trans": "屋子里没什么东西\\n打扫起来很轻松"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1025001000510070",
      "name": "美琴",
      "text": "うーん……料理か……",
      "trans": "唔……做饭啊……"
    },
    {
      "id": "1025001000510080",
      "name": "美琴",
      "text": "でも、買ったほうが結局\\n美味しいし、安くないかな？",
      "trans": "但是，买现成的\\n即好吃又便宜吧？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}