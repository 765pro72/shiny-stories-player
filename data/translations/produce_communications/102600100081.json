{
  "translator": "告",
  "rows": [
    {
      "id": "1026001000810010",
      "name": "ルカ",
      "text": "チッ……クソッ……\\nなんなんだよ……！",
      "trans": "啧……可恶啊……\\n几个意思……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ？\\nどうかしたのか？",
      "trans": "路加？\\n怎么了？"
    },
    {
      "id": "1026001000810020",
      "name": "ルカ",
      "text": "別に……\\nオメェには関係ねェだろ……",
      "trans": "没事……\\n跟你无关……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（見たところ、ビニールの袋が開かないみたいだな）",
      "trans": "（看起来是塑料袋打不开）"
    },
    {
      "id": "select",
      "name": "",
      "text": "ハサミあるけど",
      "trans": "有剪刀"
    },
    {
      "id": "select",
      "name": "",
      "text": "それ……\\n開けにくそうだな",
      "trans": "那个……\\n看起来很难打开"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺が開けようか？",
      "trans": "我帮你开吧？"
    },
    {
      "id": "1026001000810030",
      "name": "ルカ",
      "text": "……\\nあんなら言えよ",
      "trans": "……\\n有就说啊"
    },
    {
      "id": "1026001000810040",
      "name": "ルカ",
      "text": "ふッ……\\nこいつさえあれば……",
      "trans": "呼……\\n只要有这家伙……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1026001000810050",
      "name": "ルカ",
      "text": "……何ジロジロ見てんだよ",
      "trans": "……你看什么看"
    },
    {
      "id": "1026001000810060",
      "name": "ルカ",
      "text": "気持ち悪い……",
      "trans": "恶心人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1026001000810070",
      "name": "ルカ",
      "text": "あ……？",
      "trans": "啊……？"
    },
    {
      "id": "1026001000810080",
      "name": "ルカ",
      "text": "うるせェな……\\nいらねェよこんなもん……",
      "trans": "吵死了……\\n这种东西谁要啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}