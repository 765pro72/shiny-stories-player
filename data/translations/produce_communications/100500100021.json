{
  "translator": "Rosineae",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おはよう、摩美々！",
      "trans": "早上好，摩美美！"
    },
    {
      "id": "1005001000210010",
      "name": "摩美々",
      "text": "あ……",
      "trans": "啊……"
    },
    {
      "id": "1005001000210020",
      "name": "摩美々",
      "text": "プロデューサー、はいポーズ",
      "trans": "制作人，来摆个姿势，给你拍张照"
    },
    {
      "id": "select",
      "name": "",
      "text": "ピース！　んっ！？",
      "trans": "剪刀手！嗯！？"
    },
    {
      "id": "select",
      "name": "",
      "text": "なんでいきなり？",
      "trans": "为什么突然要拍照？"
    },
    {
      "id": "select",
      "name": "",
      "text": "変顔しようか？",
      "trans": "要我做鬼脸吗？"
    },
    {
      "id": "1005001000210030",
      "name": "摩美々",
      "text": "驚かせちゃいましたぁ？",
      "trans": "吓到你了吗？"
    },
    {
      "id": "1005001000210040",
      "name": "摩美々",
      "text": "私もノってくれるプロデューサーに、\\nビックリしましたけどねー",
      "trans": "制作人照我说的做了，\\n这也让我大吃一惊呢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1005001000210050",
      "name": "摩美々",
      "text": "朝からいい顔をしてたのでー、\\nこれは残しておかないと、って思ったんですー",
      "trans": "制作人从早上开始表情就不错呢，\\n我想拍下来"
    },
    {
      "id": "1005001000210060",
      "name": "摩美々",
      "text": "はい。よく撮れてますよー",
      "trans": "嗯。拍得不错哟"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1005001000210070",
      "name": "摩美々",
      "text": "……そういうのはちょっとー、\\n求めてないですねー……",
      "trans": "……还是不要做鬼脸吧……"
    },
    {
      "id": "1005001000210080",
      "name": "摩美々",
      "text": "普通の写真がいいかな……",
      "trans": "拍张普通的照片就好"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……)",
      "trans": "（唔……糟了。早知道就聊点别的了……）"
    }
  ]
}