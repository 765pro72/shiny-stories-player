{
  "translator": "告",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ファンレター読んでたのか",
      "trans": "你在看粉丝信啊"
    },
    {
      "id": "1026001000910010",
      "name": "ルカ",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いいこと書いてあったか？",
      "trans": "有什么好的内容吗？"
    },
    {
      "id": "1026001000910020",
      "name": "ルカ",
      "text": "別に……",
      "trans": "没有……"
    },
    {
      "id": "select",
      "name": "",
      "text": "小さい子どもからも\\n来てたな",
      "trans": "很小的小孩子\\n也有寄来啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "ファンレターが来ると\\n俺も嬉しくなるよ",
      "trans": "你收到粉丝信\\n我也会很开心"
    },
    {
      "id": "select",
      "name": "",
      "text": "返事、書くのか？",
      "trans": "要回信吗？"
    },
    {
      "id": "1026001000910030",
      "name": "ルカ",
      "text": "…………まぁ",
      "trans": "…………是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "夢を与えるって、いいよな",
      "trans": "赠与梦想，真好啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1026001000910040",
      "name": "ルカ",
      "text": "ふん…………ッ",
      "trans": "哼…………"
    },
    {
      "id": "1026001000910050",
      "name": "ルカ",
      "text": "勝手に喜んでんじゃねェよ",
      "trans": "你别自己傻高兴了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1026001000910060",
      "name": "ルカ",
      "text": "あ……？",
      "trans": "啊……？"
    },
    {
      "id": "1026001000910070",
      "name": "ルカ",
      "text": "オメェに関係ねェだろ……",
      "trans": "关你什么事……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}