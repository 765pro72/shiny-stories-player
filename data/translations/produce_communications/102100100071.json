{
  "translator": "岛木",
  "rows": [
    {
      "id": "1021001000710010",
      "name": "円香",
      "text": "今日は朝から出かけるって\\n言ってませんでしたっけ",
      "trans": "不是说\\n今天早上要外出吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、そうだ\\nそろそろ出ないと──",
      "trans": "啊啊，对\\n差不多该出门了——"
    },
    {
      "id": "1021001000710020",
      "name": "円香",
      "text": "あの時計、止まっていますよ",
      "trans": "那个表，早就停了哦"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "えっ！",
      "trans": "欸！"
    },
    {
      "id": "select",
      "name": "",
      "text": "ありがとう！",
      "trans": "谢谢！"
    },
    {
      "id": "select",
      "name": "",
      "text": "まずい！",
      "trans": "糟糕！"
    },
    {
      "id": "select",
      "name": "",
      "text": "う、嘘だろ！",
      "trans": "不，骗人的吧！"
    },
    {
      "id": "1021001000710030",
      "name": "円香",
      "text": "……はいはい",
      "trans": "……好好"
    },
    {
      "id": "1021001000710040",
      "name": "円香",
      "text": "せいぜい頑張って、\\nコメツキバッタみたいに謝ってきてください",
      "trans": "尽力加油，\\n像小鸡啄米一样点头哈腰地跟人道歉吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1021001000710050",
      "name": "円香",
      "text": "やっぱり気付いてなかったんですね",
      "trans": "果然没有注意到吗"
    },
    {
      "id": "1021001000710060",
      "name": "円香",
      "text": "だとしても、時間感覚が無さすぎじゃないですか",
      "trans": "就算这样，不会太没有时间感了吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1021001000710070",
      "name": "円香",
      "text": "大声、出さないでください",
      "trans": "请不要，那么大声"
    },
    {
      "id": "1021001000710080",
      "name": "円香",
      "text": "……教えなければよかった",
      "trans": "……早知道就不告诉你了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}