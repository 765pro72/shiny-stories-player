{
  "translator": "告",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ……！\\n今ちょっといいかな",
      "trans": "路加……！\\n你现在方便吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "仕事先でチケットをもらったんだ",
      "trans": "我工作的时候拿到了门票"
    },
    {
      "id": "1026001000710010",
      "name": "ルカ",
      "text": "チケット？",
      "trans": "门票？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "よければ今度、行ってみないか？\\nルカにとっていい刺激になるかもしれない",
      "trans": "下次要不要去看看？\\n这对路加来说也可能是良好的刺激"
    },
    {
      "id": "select",
      "name": "",
      "text": "アニマル王国のチケットだ",
      "trans": "是动物王国的门票"
    },
    {
      "id": "select",
      "name": "",
      "text": "オペラのチケットだ",
      "trans": "是歌剧的门票"
    },
    {
      "id": "select",
      "name": "",
      "text": "映画のチケットだ",
      "trans": "是电影的门票"
    },
    {
      "id": "1026001000710020",
      "name": "ルカ",
      "text": "アニマル王国って\\n動物のやつかよ……",
      "trans": "动物王国是\\n看动物的啊……"
    },
    {
      "id": "1026001000710030",
      "name": "ルカ",
      "text": "ふん……\\n………………行かねぇ",
      "trans": "哼……\\n………………不去"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1026001000710040",
      "name": "ルカ",
      "text": "オペラ……",
      "trans": "歌剧……"
    },
    {
      "id": "1026001000710050",
      "name": "ルカ",
      "text": "アンタが行かねぇなら\\n行くかもな……",
      "trans": "你不去的话\\n我可能会去……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1026001000710060",
      "name": "ルカ",
      "text": "映画？\\nハッ……なんで一緒に映画なんか行くんだよ",
      "trans": "电影？\\n哈……为什么要和你去看电影啊"
    },
    {
      "id": "1026001000710070",
      "name": "ルカ",
      "text": "他当たれよ",
      "trans": "找别人去"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}