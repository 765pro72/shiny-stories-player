{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "小糸ー？",
      "trans": "小糸——？"
    },
    {
      "id": "1022001000110010",
      "name": "小糸",
      "text": "ぴゃ！？\\nななななんでしょう……",
      "trans": "呀！？\\n怎怎怎怎么了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、そんなに怖がらなくても\\n大丈夫なんだけどな……",
      "trans": "哈哈，不用那么害怕\\n也没关系的……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、そうだ\\nポケットに確か──……",
      "trans": "啊，对了\\n口袋里好像有——……"
    },
    {
      "id": "select",
      "name": "",
      "text": "──飴、\\n食べないか？",
      "trans": "——糖果，\\n要吃吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "──チョコ、\\n少し溶けてるけど",
      "trans": "——巧克力，\\n虽然有点融化了"
    },
    {
      "id": "select",
      "name": "",
      "text": "……あれ、\\n何もなかった",
      "trans": "……欸，\\n什么都没有"
    },
    {
      "id": "1022001000110020",
      "name": "小糸",
      "text": "え、あ……\\nい、いいんですか……！",
      "trans": "欸，啊……\\n可，可以吗……！"
    },
    {
      "id": "1022001000110030",
      "name": "小糸",
      "text": "え、えへ……ありがとうございます\\n……お、おいしい……！",
      "trans": "欸，诶嘿嘿……谢谢你\\n……真，真好吃……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1022001000110040",
      "name": "小糸",
      "text": "あ……えっと\\nあ、ありがとうございます……",
      "trans": "啊……那个\\n谢，谢谢你……"
    },
    {
      "id": "1022001000110050",
      "name": "小糸",
      "text": "い、いただきます……！",
      "trans": "我开动了……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ごめん、何かお菓子が入ってたと\\n思ったんだけど……",
      "trans": "抱歉，还以为有什么零食来着……"
    },
    {
      "id": "1022001000110060",
      "name": "小糸",
      "text": "べ、べつにお菓子……\\nい、いりません……！",
      "trans": "并，并不是……\\n这么想要吃零食……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}