{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──そういえば、\\n４人はいつから仲がいいんだ？",
      "trans": "——说起来，\\n你们四人是从什么时候关系变这么好的？"
    },
    {
      "id": "1022001000410010",
      "name": "小糸",
      "text": "え、わたしたちですか……！\\nえっと……",
      "trans": "欸，我们吗……！\\n嗯……"
    },
    {
      "id": "1022001000410020",
      "name": "小糸",
      "text": "と、透ちゃんと円香ちゃんは幼稚園からで……\\nひ、雛菜ちゃんは小学校から、です……！",
      "trans": "透和圆香是从幼儿园开始……\\n雏，雏菜则是小学认识的……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうか、じゃあもう10年以上の付き合いに\\nなるんだな",
      "trans": "是吗，那就已经是\\n十年以上的交情了啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "本当に\\n仲がいいんだな",
      "trans": "关系\\n真的很好啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "幼馴染って\\nいいよな",
      "trans": "儿时玩伴\\n真好啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "これからも\\n仲良くな",
      "trans": "之后也要\\n继续这样啊"
    },
    {
      "id": "1022001000410030",
      "name": "小糸",
      "text": "は、はい……そうなんです\\nあの……",
      "trans": "是，是……是这样的\\n那个……"
    },
    {
      "id": "1022001000410040",
      "name": "小糸",
      "text": "え、えへへ……\\nそ、そう見えますかね……！",
      "trans": "欸，诶嘿嘿……\\n看，看起来是这样的啊……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1022001000410050",
      "name": "小糸",
      "text": "え……は、はい……！\\nとってもいいですよ……！",
      "trans": "欸……是，是……！\\n关系真的很好……！"
    },
    {
      "id": "1022001000410060",
      "name": "小糸",
      "text": "す、すっごく、いいです……！",
      "trans": "真，真的很好……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1022001000410070",
      "name": "小糸",
      "text": "あ……そうですよね……",
      "trans": "啊……也是啊……"
    },
    {
      "id": "1022001000410080",
      "name": "小糸",
      "text": "これからも、ずっと……",
      "trans": "从今往后也要，一直……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}