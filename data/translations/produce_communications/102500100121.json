{
  "translator": "StYL3",
  "rows": [
    {
      "id": "1025001001210010",
      "name": "美琴",
      "text": "…………──",
      "trans": "…………──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それ、なんの曲だ？",
      "trans": "那是怎么样的曲子啊？"
    },
    {
      "id": "1025001001210020",
      "name": "美琴",
      "text": "え……\\nプロデューサー、居たの？",
      "trans": "诶……\\n制作人，原来你在的啊？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "すまん、盗み聴きするつもりは\\nなかったんだが……",
      "trans": "抱歉，我不是\\n有意偷听的……"
    },
    {
      "id": "select",
      "name": "",
      "text": "綺麗な曲だな",
      "trans": "很优美的曲子呢"
    },
    {
      "id": "select",
      "name": "",
      "text": "寂しい曲だな",
      "trans": "有点伤感的曲子呢"
    },
    {
      "id": "select",
      "name": "",
      "text": "聴いたこと\\nない曲だな",
      "trans": "是没听过的\\n曲子呢"
    },
    {
      "id": "1025001001210030",
      "name": "美琴",
      "text": "そう？\\nありがとう",
      "trans": "是吗？\\n谢谢"
    },
    {
      "id": "1025001001210040",
      "name": "美琴",
      "text": "プロデューサーにそう言ってもらえて\\nよかった",
      "trans": "我很高兴\\n你能这么说"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1025001001210050",
      "name": "美琴",
      "text": "…………！\\nうん、そうだね",
      "trans": "…………！\\n嗯，是呢"
    },
    {
      "id": "1025001001210060",
      "name": "美琴",
      "text": "すごい、どうしてわかったの？",
      "trans": "好厉害啊，你是怎么知道的？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1025001001210070",
      "name": "美琴",
      "text": "……うん、そうなの",
      "trans": "……嗯，是吗"
    },
    {
      "id": "1025001001210080",
      "name": "美琴",
      "text": "…………\\nそういう曲だから",
      "trans": "…………\\n就是这种曲子呢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}