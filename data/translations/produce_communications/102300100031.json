{
  "translator": "阿柚",
  "rows": [
    {
      "id": "1023001000310010",
      "name": "雛菜",
      "text": "プロデューサー、さっき道で\\n『芸能界に興味ありますか？』って言われた～",
      "trans": "制作人，刚才雏菜在路上\\n被问了“对娱乐圈有兴趣吗？”～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え……！？\\nそれで、どうしたんだ？",
      "trans": "诶……！？\\n然后呢，你怎么回答的？"
    },
    {
      "id": "1023001000310020",
      "name": "雛菜",
      "text": "ん～？\\n『あります～』って言ったよ～？",
      "trans": "嗯～？\\n就说了“有呀～”～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え……！",
      "trans": "诶……！"
    },
    {
      "id": "select",
      "name": "",
      "text": "断ったんだよな？",
      "trans": "之后有拒绝吧？"
    },
    {
      "id": "select",
      "name": "",
      "text": "勧誘\\nされたのか？",
      "trans": "这是\\n被劝诱了吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "そうか……",
      "trans": "这样啊……"
    },
    {
      "id": "1023001000310030",
      "name": "雛菜",
      "text": "へ～？\\nうん～、断った！",
      "trans": "诶～？\\n嗯～拒绝了！"
    },
    {
      "id": "1023001000310040",
      "name": "雛菜",
      "text": "だって透先輩もプロデューサーも\\nここにしかいないもんね～？",
      "trans": "因为不管是透前辈还是制作人\\n都只在这里才有不是嘛～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1023001000310050",
      "name": "雛菜",
      "text": "ん～、どうかな～？",
      "trans": "嗯～怎么说呢～？"
    },
    {
      "id": "1023001000310060",
      "name": "雛菜",
      "text": "なんか言ってたけど\\nすぐばいばいしてきちゃったから知らないや～",
      "trans": "虽然他有在说些什么\\n但没多久就跟他拜拜了所以也不知道啦～"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1023001000310070",
      "name": "雛菜",
      "text": "え～～～\\nそれだけ～？",
      "trans": "诶～～～\\n就这～？"
    },
    {
      "id": "1023001000310080",
      "name": "雛菜",
      "text": "プロデューサー、\\n雛菜がいなくなっちゃってもいいの～？",
      "trans": "制作人，\\n就算雏菜不在了也没关系吗～？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}