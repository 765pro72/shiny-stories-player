{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ふぁ……──",
      "trans": "哈啊……──"
    },
    {
      "id": "1020001001510010",
      "name": "透",
      "text": "寝てないみたいな顔だね",
      "trans": "一晚上没睡的表情啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あ、すまん",
      "trans": "──啊，抱歉"
    },
    {
      "id": "1020001001510020",
      "name": "透",
      "text": "動画とか見てた？",
      "trans": "是看视频了吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "仕事だよ、仕事！",
      "trans": "工作啊，工作！"
    },
    {
      "id": "select",
      "name": "",
      "text": "動画なら\\nいいんだけどな",
      "trans": "是看视频的话\\n就好了"
    },
    {
      "id": "select",
      "name": "",
      "text": "なんでそうなるんだ",
      "trans": "为什么要那样说啊"
    },
    {
      "id": "1020001001510030",
      "name": "透",
      "text": "ふふっ、何",
      "trans": "呵呵，什么嘛"
    },
    {
      "id": "1020001001510040",
      "name": "透",
      "text": "忙しいアピールってやつなの？",
      "trans": "这就是所谓的劳苦命吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001001510050",
      "name": "透",
      "text": "うわ、ごめん",
      "trans": "呜哇，抱歉"
    },
    {
      "id": "1020001001510060",
      "name": "透",
      "text": "なんか深刻だね……\\n頑張って",
      "trans": "感觉有点严重……\\n加油吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001001510070",
      "name": "透",
      "text": "……ごめんね",
      "trans": "……抱歉"
    },
    {
      "id": "1020001001510080",
      "name": "透",
      "text": "ちょっと\\n冗談言っただけ",
      "trans": "只是\\n开个玩笑而已"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}