{
  "translator": "岛木",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──卵焼きは、甘い派か？　しょっぱい派か？",
      "trans": "──煎蛋卷，你是甜党？　还是咸党？"
    },
    {
      "id": "1020001000110010",
      "name": "透",
      "text": "えっ、何",
      "trans": "诶，什么"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、すまん……\\nさっき出先で、そういう話になって──",
      "trans": "啊，抱歉……\\n刚才在外头谈到了这个话题──"
    },
    {
      "id": "1020001000110020",
      "name": "透",
      "text": "卵焼き……",
      "trans": "煎蛋卷……"
    },
    {
      "id": "select",
      "name": "",
      "text": "──腹、\\n減ってないか？",
      "trans": "──肚子饿了吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "嫌いか？　卵焼き",
      "trans": "不喜欢吗？　煎蛋卷"
    },
    {
      "id": "select",
      "name": "",
      "text": "……どうでも\\nいいよな",
      "trans": "……两边都行\\n对吧"
    },
    {
      "id": "1020001000110030",
      "name": "透",
      "text": "え？　うん\\n──あ、心配してくれたんだ",
      "trans": "诶？　嗯\\n──让你担心了吗"
    },
    {
      "id": "1020001000110040",
      "name": "透",
      "text": "ありがと",
      "trans": "谢谢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（よし、楽しく話せたな）",
      "trans": "（很好，聊得挺开心的）"
    },
    {
      "id": "1020001000110050",
      "name": "透",
      "text": "え？　ううん……\\nていうか",
      "trans": "诶？　不是……\\n说起来"
    },
    {
      "id": "1020001000110060",
      "name": "透",
      "text": "甘い卵焼きって何？",
      "trans": "甜的煎蛋卷是什么？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（まぁ、普通に話せたかな）",
      "trans": "（嗯，聊得还算正常吧）"
    },
    {
      "id": "1020001000110070",
      "name": "透",
      "text": "え、ううん……\\n考えてたけど",
      "trans": "诶，不是……\\n我想了一下"
    },
    {
      "id": "1020001000110080",
      "name": "透",
      "text": "作ってくれるとか\\nそういう話じゃなくて？",
      "trans": "还以为是要给我做煎蛋卷呢\\n原来不是吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（うっ……しまった。別のことを言えば良かったな……）",
      "trans": "（呜……糟了。要是说点别的话题就好了……）"
    }
  ]
}