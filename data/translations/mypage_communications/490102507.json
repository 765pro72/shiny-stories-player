{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "4901025070010",
      "name": "結華",
      "text": "助かりたい助かりたい助かりたい……！",
      "trans": "想逃过想逃过想逃过……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-5",
      "name": "プロデューサー",
      "text": "あっ、ずるいぞ！　俺だって！\r\nすっぱいのは嫌だすっぱいのは嫌だすっぱいのは嫌だ……！",
      "trans": "啊，太狡猾了！我也要！\n不想吃酸的我不想吃酸的我不想吃酸的……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070020",
      "name": "結華",
      "text": "ちょっとー。プロデューサーはプロデューサーでしょ？\r\nアイドルのために犠牲になってよぉ",
      "trans": "等一下——。制作人就是制作人吧？\n为了偶像牺牲一下嘛",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-7",
      "name": "プロデューサー",
      "text": "それとこれとは話が別だろ\r\n──いいか、恨みっこなしでいくぞ",
      "trans": "那跟这是两码事吧\n——听好了，不许记恨啊",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070070",
      "name": "結華",
      "text": "──やった回避！\r\nありがとプロデューサー！",
      "trans": "——躲过了！\n谢谢制作人！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-14",
      "name": "プロデューサー",
      "text": "うっ、ぐ……！\r\n～～～～……！！",
      "trans": "唔、呃……！\n～～～～……！！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070080",
      "name": "結華",
      "text": "……えっ、えっ。そんなに……？！\r\n大丈夫……！？",
      "trans": "……诶、诶。那么酸吗……？！\n没事吧……！？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-17",
      "name": "プロデューサー",
      "text": "──っ、……はぁ、はぁ……！",
      "trans": "——、……哈、哈……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-19",
      "name": "プロデューサー",
      "text": "……──や、でも……！　担当をこのすっぱさから\r\n守れたんなら、なんてことない、かな……！",
      "trans": "……——不，不过……！　只要能把自己的担当\n从这个酸度里守护住，就不算什么，吧……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070090",
      "name": "結華",
      "text": "いやいやＰたん……",
      "trans": "不不，P碳……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070100",
      "name": "結華",
      "text": "さっきまで、かわせるならかわそうとしてた人に\r\nそんなこと言われましてもねぇ……",
      "trans": "对刚才还想着能躲就躲的人\n说这种话，我也不知道怎么接啊……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-29",
      "name": "プロデューサー",
      "text": "うわっ、ゆ、結華！？\r\n大丈夫か！？",
      "trans": "哇，结、结华！？\n没事吧！？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070040",
      "name": "結華",
      "text": "～～～～っ無理……！\r\nこれは無理～～……っ……！",
      "trans": "～～～～不行……！\n这个真的不行～～……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-31",
      "name": "プロデューサー",
      "text": "すまん、俺がそっち選んどけば──！",
      "trans": "抱歉，要是我选那边就好了——！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070050",
      "name": "結華",
      "text": "～～……っ…………──！\r\n……や、……",
      "trans": "～～………………——！\n……不，……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "4901025070060",
      "name": "結華",
      "text": "──……それもおかしいでしょ\r\nなんでそうなるのさ、もう。……お人よしすぎ",
      "trans": "——……那也很奇怪吧\n为什么会变成这样啊，真是的。……太好心了",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
