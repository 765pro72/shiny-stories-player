{"translator":"阿柚","rows":[{"id":"5023001000220010","name":"雛菜","text":"あは～、そっか～","trans":"啊哈～这样啊～"},{"id":"5023001000220020","name":"雛菜","text":"ん～～～\\nだめだったね～","trans":"嗯～～～\\n果然不行啊～"},{"id":"0000000000000","name":"プロデューサー","text":"そうだな、でも惜しかった","trans":"是啊，真是可惜啊"},{"id":"5023001000220030","name":"雛菜","text":"あは～、そうかな～？","trans":"啊哈～是吗～？"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、次こそ頑張って\\n合格しような","trans":"是啊，下次一定要努力\\n合格通过"},{"id":"5023001000220040","name":"雛菜","text":"うん～\\nそうだね～？","trans":"嗯～\\n确实啊～"},{"id":"5023001000220050","name":"雛菜","text":"その方が楽しそう～～～","trans":"那样才比较开心啊～～～"}]}