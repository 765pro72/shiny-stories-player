{"translator":"闲云遮月","rows":[{"id":"0000000000000","name":"プロデューサー","text":"やった、透！\\n合格だぞ……！","trans":"太好了，透！\\n合格了……！"},{"id":"5020001000210010","name":"透","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"──\\n相変わらずリアクション薄────","trans":"——\\n还是老样子很淡定啊────"},{"id":"5020001000210020","name":"透","text":"はい、イエーイ","trans":"来，耶——"},{"id":"0000000000000","name":"プロデューサー","text":"……！","trans":"……！"},{"id":"5020001000210030","name":"透","text":"え、やらない？\\nハイタッチ……","trans":"诶，不来吗？\\n击个掌……"},{"id":"0000000000000","name":"プロデューサー","text":"やるよ……","trans":"来啊……"},{"id":"5020001000210040","name":"透＆プロデューサー","text":"イエーイ！","trans":"耶——！"}]}