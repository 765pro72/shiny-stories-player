{"translator":"告","rows":[{"id":"3022002020010","name":"円香","text":"──小糸、私たち帰るけど……","trans":"——小糸，我们要回去了……"},{"id":"3022002020020","name":"小糸","text":"……ぴゃ！？","trans":"……呀！？"},{"id":"3022002020030","name":"小糸","text":"あ、うん……！\\nお、お疲れ様……！","trans":"啊，嗯……！\\n辛，辛苦了……！"},{"id":"3022002020040","name":"小糸","text":"わたしもすぐに帰るよ……！","trans":"我也马上就回去了……！"},{"id":"3022002020050","name":"円香","text":"そう？　じゃあ一緒に帰る？","trans":"是吗？ 那要一起回去吗？"},{"id":"3022002020060","name":"小糸","text":"え……\\nあ、う、ううん！","trans":"诶……\\n啊，不，不用了！"},{"id":"3022002020070","name":"小糸","text":"え、えっと……\\nま、待たせたら悪いから、透ちゃんと先に帰って！","trans":"那，那个……\\n让你们等太久也不好，你和透先回去吧！"},{"id":"3022002020080","name":"円香","text":"…………\\nん、わかった","trans":"…………\\n嗯，我知道了"},{"id":"3022002020090","name":"円香","text":"行こう、浅倉","trans":"走吧，浅仓"},{"id":"3022002020100","name":"透","text":"うん\\n小糸ちゃん、じゃあね","trans":"嗯\\n小糸，我走咯"},{"id":"3022002020110","name":"小糸","text":"う、うん……！\\n透ちゃんたちも気を付けて帰ってね……！","trans":"唔，嗯……！\\n透和圆香回家路上小心……！"},{"id":"3022002020120","name":"透","text":"大丈夫\\nありがと","trans":"没问题\\n谢谢你"},{"id":"3022002020130","name":"小糸","text":"…………","trans":""},{"id":"3022002020140","name":"小糸","text":"……よ、よし……\\nみんな帰った…………","trans":"……好，好了……\\n大家都回去了…………"},{"id":"3022002020150","name":"小糸","text":"あとちょっとだけ……\\nちょっとだけ練習して帰ろう……！","trans":"就一会……\\n再多练习一点就回去吧……！"},{"id":"3022002020160","name":"小糸","text":"あー……","trans":"啊—……"},{"id":"3022002020170","name":"小糸","text":"んー……\\nもう一回、あー……","trans":"嗯—……\\n再来一次，啊—……"},{"id":"3022002020180","name":"円香","text":"──小糸","trans":"──小糸"},{"id":"3022002020190","name":"小糸","text":"ぴゃ！？","trans":"呀！？"},{"id":"3022002020200","name":"円香","text":"……驚きすぎ","trans":"……惊讶过头了吧"},{"id":"3022002020210","name":"小糸","text":"ななな、なんだ……\\n円香ちゃんか……！","trans":"什什什，什么啊……\\n是圆香啊……！"},{"id":"3022002020220","name":"小糸","text":"えーっと、あの……\\nわ、忘れ物……！？","trans":"那个，什么……\\n忘，忘东西了……！？"},{"id":"3022002020230","name":"円香","text":"そう、そんなところ","trans":"对，差不多"},{"id":"3022002020240","name":"小糸","text":"そ、そうなんだ……！\\n何を忘れちゃったの？","trans":"原，原来是这样……！\\n你忘了什么？"},{"id":"3022002020250","name":"円香","text":"──小糸、手出して","trans":"——小糸，伸出手来"},{"id":"3022002020260","name":"小糸","text":"ん？","trans":"嗯？"},{"id":"3022002020270","name":"円香","text":"これ、あげる","trans":"这个，给你"},{"id":"3022002020280","name":"小糸","text":"わぁ、お菓子……！","trans":"哇，零食……！"},{"id":"3022002020290","name":"小糸","text":"これ、わたしの好きなやつ……！\\nいいの？","trans":"这个，是我喜欢的那种……！\\n这样好吗？"},{"id":"3022002020300","name":"円香","text":"よくなかったらあげないでしょ","trans":"不行的话我也不会给你了吧"},{"id":"3022002020310","name":"小糸","text":"そ、そっか……！　えへへ……！","trans":"是，是吗……！ 诶嘿嘿……！"},{"id":"3022002020320","name":"円香","text":"……小糸は頑張ってて、偉いね","trans":"……小糸这么努力，很了不起呢"},{"id":"3022002020330","name":"小糸","text":"……え！\\nべべべ、別に！　普通だよ！","trans":"……诶！\\n才才才，才没有！ 这样很普通啊！"},{"id":"3022002020340","name":"円香","text":"ふふっ、そうかもね","trans":"呵呵，或许是呢"},{"id":"3022002020350","name":"小糸","text":"…………えっと","trans":"…………那个"},{"id":"3022002020360","name":"透","text":"──樋口\\n忘れ物、あった？","trans":"——樋口\\n忘记的东西，找到了吗"},{"id":"3022002020370","name":"円香","text":"ん、もう大丈夫\\n今行く","trans":"嗯，找到了\\n我现在过去"},{"id":"3022002020380","name":"小糸","text":"えっ、円香ちゃん\\n忘れ物って──……","trans":"诶，圆香\\n忘记的东西是——"},{"id":"3022002020390","name":"円香","text":"渡したでしょ、それ","trans":"那个，已经给你了吧"},{"id":"3022002020400","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"3022002020410","name":"円香","text":"渡すの、忘れてたと思って","trans":"我只是，忘了给你"},{"id":"3022002020420","name":"小糸","text":"え……！？","trans":"诶……！？"},{"id":"3022002020430","name":"円香","text":"じゃあね、小糸","trans":"我走了，小糸"},{"id":"3022002020440","name":"小糸","text":"えええ、あっ、うん！\\nあの……ありがとう！","trans":"诶诶诶，啊，嗯！\\n那个，……谢谢你！"},{"id":"3022002020450","name":"小糸","text":"ば、ばいばい！","trans":"拜，拜拜！"},{"id":"3022002020460","name":"円香","text":"……ばいばい","trans":"……拜拜"},{"id":"3022002020470","name":"小糸","text":"…………","trans":""},{"id":"3022002020480","name":"小糸","text":"…………","trans":""},{"id":"3022002020490","name":"小糸","text":"……おいしい","trans":"……好好吃"},{"id":"3022002020500","name":"小糸","text":"……うん","trans":"……嗯"},{"id":"3022002020510","name":"小糸","text":"よーし！\\nもう一回やるぞー！","trans":"好—！\\n再练一次！"}]}