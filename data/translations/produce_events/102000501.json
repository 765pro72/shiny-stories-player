{"translator":"魚見","rows":[{"id":"1020005010010","name":"透","text":"……ん\\nふぁ──","trans":"……嗯\\n呼啊——"},{"id":"1020005010020","name":"透","text":"……また？","trans":"……又来？"},{"id":"1020005010030","name":"透","text":"……","trans":""},{"id":"0000000000000","name":"透の母","text":"透ー","trans":"透——"},{"id":"0000000000000","name":"透の母","text":"お母さん買い物に行くけど、来るー？","trans":"妈妈出去买东西，你去吗——？"},{"id":"1020005010040","name":"透","text":"行かなーい","trans":"不去——"},{"id":"0000000000000","name":"透の母","text":"でも、みんなも今日出かけてるんでしょー？","trans":"但是今天，大家都出门了不是吗——？"},{"id":"1020005010050","name":"透","text":"いい\\n公園行くー","trans":"没事\\n我去公园——"},{"id":"0000000000000","name":"透の母","text":"そー\\n気を付けてねー","trans":"行吧——\\n要注意安全喔——"},{"id":"1020005010060","name":"透","text":"んー","trans":"嗯——"},{"id":"1020005010070","name":"透","text":"……ふぁ──","trans":"……呼啊——"},{"id":"1020005010080","name":"透","text":"たまに、見る夢","trans":"偶尔，会梦见"},{"id":"1020005010090","name":"透","text":"でも、いつもつかない","trans":"但却总是，无法触及"},{"id":"1020005010100","name":"透","text":"てっぺんに","trans":"顶点"},{"id":"0000000000000","name":"近所の子","text":"ねー、なにしてんのー？","trans":"嗳——、你在干嘛呀——？"},{"id":"1020005010110","name":"透","text":"え？\\n見てる","trans":"诶？\\n在看"},{"id":"0000000000000","name":"近所の子","text":"なにをー？","trans":"看什么——？"},{"id":"1020005010120","name":"透","text":"ジャングルジム","trans":"攀爬架"},{"id":"0000000000000","name":"近所の子","text":"えー\\nへんなのー","trans":"诶——\\n真奇怪——"},{"id":"0000000000000","name":"近所の子","text":"っていうかさー\\nジャングルジムってつまんなくない？","trans":"我说啊——\\n不觉得攀爬架很没意思吗？"},{"id":"0000000000000","name":"近所の子","text":"ただのぼるだけだし","trans":"就只是在那爬"},{"id":"1020005010130","name":"透","text":"えっ？","trans":"诶？"},{"id":"1020005010140","name":"透","text":"ただ、のぼるだけ──","trans":"只是，在那爬——"},{"id":"1020005010150","name":"透","text":"そっか","trans":"这样啊"},{"id":"0000000000000","name":"近所の子","text":"ねー、あっちで一緒に遊ぼーよ","trans":"嗳——、去那边一起玩呗——"},{"id":"1020005010160","name":"透","text":"あ、ごめん\\n僕、もう帰る","trans":"啊、抱歉\\n我要回去了"},{"id":"0000000000000","name":"学生","text":"ああ、ここだ\\n間に合ったかな……","trans":"啊啊、是这里\\n赶上了吗……"},{"id":"1020005010170","name":"透","text":"……","trans":""},{"id":"1020005010180","name":"透","text":"歩いた方が早いよ\\n駅でしょ","trans":"走过去更快哦\\n是去车站吧"},{"id":"0000000000000","name":"学生","text":"……え？\\n──あ……バス、まだまだか","trans":"……诶？\\n——啊……公交，还没来吗"},{"id":"0000000000000","name":"学生","text":"どうもありがとう","trans":"谢谢提醒"},{"id":"1020005010190","name":"透","text":"……","trans":""},{"id":"1020005010200","name":"透","text":"はぁっ……はぁっ……","trans":"呼……呼……"},{"id":"1020005010210","name":"透","text":"はぁっ……はぁっ……","trans":"呼……呼……"},{"id":"0000000000000","name":"学生","text":"ほら、着いた","trans":"你看，爬上来了"},{"id":"1020005010220","name":"透","text":"……うん","trans":"……嗯"},{"id":"1020005010230","name":"透","text":"……","trans":""},{"id":"1020005010240","name":"透","text":"俺が……行くからさ……","trans":"我……会去的……"},{"id":"1020005010250","name":"透","text":"届きそうな気がした","trans":"感觉能够着了"},{"id":"1020005010260","name":"透","text":"ふふっ、やばい……","trans":"呵呵、不得了"}]}