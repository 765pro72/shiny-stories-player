      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世────",
      "trans": "……世……"
    },
    {
      "id": "2012011030020",
      "name": "凛世",
      "text": "────\\n……ろ……でゅ…………──────",
      "trans": "────\\n……作……人…………──────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──\\nはは、よく寝てる……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………\\nごめんな────",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──土産もの？\\nいいぞ、俺も見ようかな",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "誰に買っていくんだ？",
      "trans": "……世……"
    },
    {
      "id": "2012011030030",
      "name": "凛世",
      "text": "放クラの……みなさまと……\\n寮の……みなさま……",
      "trans": "放课后的……各位……以及……\\n住在宿舍的……大家……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おー、そうか\\nたくさんだなぁ",
      "trans": "……世……"
    },
    {
      "id": "2012011030040",
      "name": "凛世",
      "text": "はい……\\nふふ……",
      "trans": "嗯……\\n哼哼……"
    },
    {
      "id": "2012011030050",
      "name": "凛世",
      "text": "それから……\\nプロデューサーさまにも……",
      "trans": "然后……\\n也要给制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、俺はいいよ\\nここに来れてるし",
      "trans": "……世……"
    },
    {
      "id": "2012011030060",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そのぶん、誰かに渡してあげてくれ",
      "trans": "……世……"
    },
    {
      "id": "2012011030070",
      "name": "凛世",
      "text": "……い、いえ……\\nでも……",
      "trans": "……不，不是……\\n但……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、もったいないよ\\nそんなのいいから────",
      "trans": "……世……"
    },
    {
      "id": "2012011030080",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────凛世？",
      "trans": "……世……"
    },
    {
      "id": "2012011030090",
      "name": "凛世",
      "text": "……\\nよく……ありません……",
      "trans": "……\\n才不能……算了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あっ\\n凛世────！",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なぁ、凛世……！",
      "trans": "……世……"
    },
    {
      "id": "2012011030100",
      "name": "凛世",
      "text": "……\\nあ、開けては……いけません……",
      "trans": "……\\n不，不能……开门……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世、すまん\\n何か気分を悪くしてたら────",
      "trans": "……世……"
    },
    {
      "id": "2012011030110",
      "name": "凛世",
      "text": "わ……悪くしては……おりません…………",
      "trans": "并……并不是……不舒服…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……その\\nそれなら……ええと…………",
      "trans": "……世……"
    },
    {
      "id": "2012011030120",
      "name": "凛世",
      "text": "……\\n────",
      "trans": "……\\n────"
    },
    {
      "id": "2012011030130",
      "name": "凛世",
      "text": "────\\nも……申し訳ございません……",
      "trans": "────\\n非……非常抱歉……"
    },
    {
      "id": "2012011030140",
      "name": "凛世",
      "text": "…………\\nほ、放っておいて……くださいませ──────",
      "trans": "………\\n请，请别管……凛世──────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\n凛世……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "い、いいんだ……！　その…………\\nごめんな……また、後で……",
      "trans": "……世……"
    },
    {
      "id": "2012011030150",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "2012011030160",
      "name": "凛世",
      "text": "……写真も……だめ……\\n土産ものも……だめ……",
      "trans": "……照片……也不行……\\n土特产……也不行……"
    },
    {
      "id": "2012011030170",
      "name": "凛世",
      "text": "凛世には……\\nバスの……一枚だけ────",
      "trans": "凛世只有……\\n公交的……那一张────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\n土産もののこと……かな",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "だよな……\\n俺にも買ってくれるって",
      "trans": "……世……"
    },
    {
      "id": "2012011030180",
      "name": "凛世",
      "text": "……\\nよく……ありません……",
      "trans": "……\\n才不能……算了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……いいかな\\nちょっとだけ話ができたら嬉しい",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──\\n凛世……？",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "り、凛世……どうした！？\\n開けるぞ……！",
      "trans": "……世……"
    },
    {
      "id": "2012011030190",
      "name": "凛世",
      "text": "────すぅ……\\n……すぅ……────",
      "trans": "────呼……\\n……呼……────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\nこんなところで……────",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……\\nはは、よく寝てる……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\nごめんな────",
      "trans": "……世……"
    },
    {
      "id": "select",
      "name": "",
      "text": "……\\nまんじゅうがいいよ",
      "trans": "……\\n馒头就可以了"
    },
    {
      "id": "select",
      "name": "",
      "text": "起きたら話そう",
      "trans": "……\\n馒头就可以了"
    },
    {
      "id": "select",
      "name": "",
      "text": "難しいな",
      "trans": "……\\n馒头就可以了"
    },
    {
      "id": "2012011030200",
      "name": "凛世",
      "text": "────…………\\n……すぅ……",
      "trans": "────…………\\n……呼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ありがとな……\\n俺、ありがとうって言うべきだった",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──仕事に来てるだけじゃ\\nないんだよな",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世の夏を……\\n預かってるんだから",
      "trans": "……世……"
    },
    {
      "id": "2012011030210",
      "name": "凛世",
      "text": "…………────────",
      "trans": "…………────────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おやすみ……\\n起きたら、言わせてくれ",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ありがとうって",
      "trans": "……世……"
    },
    {
      "id": "2012011030220",
      "name": "凛世",
      "text": "────…………\\n……すぅ……",
      "trans": "────…………\\n……呼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────いや……\\n話してくれてたんだよな、凛世は……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "それから……\\nプロデューサーさまにも……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────ごめんな、凛世\\n間違えてばっかりだ",
      "trans": "……世……"
    },
    {
      "id": "2012011030240",
      "name": "凛世",
      "text": "────…………",
      "trans": "────…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "起きたら、どうか",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "もう一回、答えさせてくれ",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "謝ったって……\\n言ってしまったことは消せない",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、もったいないよ\\nそんなのいいから────",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺に買ってくれるって言ったのにな\\n…………『そんなの』なんて",
      "trans": "……世……"
    },
    {
      "id": "2012011030250",
      "name": "凛世",
      "text": "────…………\\n……すぅ……",
      "trans": "────…………\\n……呼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ごめん、凛世\\nただ遠慮したつもりだったんだ……",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "もう一度聞いてくれるなら\\n今度は言うよ",
      "trans": "……世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "嬉しかったって────",
      "trans": "……世……"
    }
  ]
}