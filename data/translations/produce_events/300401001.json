{"translator":"Rosineae","rows":[{"id":"3004010010010","name":"恋鐘","text":"ふんふ～ん♪","trans":"哼哼～♪"},{"id":"3004010010020","name":"恋鐘","text":"ふふふ～ん♪","trans":"哼哼哼～♪"},{"id":"3004010010030","name":"霧子","text":"……\\n恋鐘ちゃん……？","trans":"……\\n恋钟……？"},{"id":"3004010010040","name":"霧子","text":"……","trans":""},{"id":"3004010010050","name":"霧子","text":"このにおい……──","trans":"这个香气……——"},{"id":"3004010010060","name":"恋鐘","text":"あれ～霧子！\\nどげんしたと？","trans":"咦～雾子！\\n怎么了？"},{"id":"3004010010070","name":"霧子","text":"恋鐘ちゃん……","trans":"恋钟……"},{"id":"3004010010080","name":"霧子","text":"お歌が……\\n聴こえてきたから……","trans":"我听见你在唱歌……"},{"id":"3004010010090","name":"霧子","text":"──何か……切ってるの……？","trans":"——在切什么东西吗……？"},{"id":"3004010010100","name":"恋鐘","text":"んふふ～、レモン！","trans":"嗯哼哼～柠檬！"},{"id":"3004010010110","name":"霧子","text":"わ……！","trans":"哇……！"},{"id":"3004010010120","name":"霧子","text":"──すんすんー……","trans":"——闻闻……"},{"id":"3004010010130","name":"恋鐘","text":"よかにおいやろ～","trans":"味道很好吧～"},{"id":"3004010010140","name":"霧子","text":"ふふ……\\nうん……","trans":"呵呵……\\n嗯……"},{"id":"3004010010150","name":"霧子","text":"明るいにおい……","trans":"很明亮的味道……"},{"id":"3004010010160","name":"恋鐘","text":"んふふ～！\\nこがんぴっかぴかのレモンやもん","trans":"嗯哼哼～！\\n毕竟是这么闪闪发亮的柠檬啊"},{"id":"3004010010170","name":"恋鐘","text":"霧子も一緒にやらん？","trans":"雾子不一起来吗？"},{"id":"3004010010180","name":"霧子","text":"え……？","trans":"诶……？"},{"id":"3004010010190","name":"恋鐘","text":"レモンのシロップ漬け！","trans":"糖渍柠檬！"},{"id":"3004010010200","name":"恋鐘","text":"寒か～って日に\\nいつでもレモネード飲めるように～って","trans":"为了在寒冷的日子里能随时喝到柠檬水"},{"id":"3004010010210","name":"恋鐘","text":"霧子も使ってよかよ！","trans":"雾子也可以用哦！"},{"id":"3004010010220","name":"霧子","text":"ほんと……！","trans":"真的吗……！"},{"id":"3004010010230","name":"霧子","text":"ふふ……\\nうん……！","trans":"呵呵……\\n嗯……！"},{"id":"3004010010240","name":"霧子","text":"恋鐘ちゃんの……\\nレモネード……","trans":"恋钟的……\\n柠檬水……"},{"id":"3004010010250","name":"恋鐘","text":"切ったレモンば瓶に敷いて……","trans":"把切好的柠檬铺进瓶子里……"},{"id":"3004010010260","name":"霧子","text":"ん……と──","trans":"那个——"},{"id":"3004010010270","name":"霧子","text":"──こんな……感じ……？","trans":"——这样子……？"},{"id":"3004010010280","name":"恋鐘","text":"うん！　よかね！","trans":"嗯！不错！"},{"id":"3004010010290","name":"恋鐘","text":"そいで、砂糖！","trans":"然后，砂糖！"},{"id":"3004010010300","name":"霧子","text":"お砂糖……","trans":"砂糖……"},{"id":"3004010010310","name":"恋鐘","text":"氷砂糖と、グラニュー糖\\n両方入れて……","trans":"冰糖跟细砂糖一起放进去……"},{"id":"3004010010320","name":"霧子","text":"あ……\\nふふ……","trans":"啊……\\n呵呵……"},{"id":"3004010010330","name":"霧子","text":"今度は……\\n優しいにおい……","trans":"这次是……\\n温柔的味道……"},{"id":"3004010010340","name":"恋鐘","text":"ん～？\\n砂糖やけん甘かよ～","trans":"嗯～？\\n因为是砂糖，很甜哦～"},{"id":"3004010010350","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3004010010360","name":"霧子","text":"レモンと……\\n仲良しの……においだね……","trans":"是跟柠檬……\\n相处友好的味道呢……"},{"id":"3004010010370","name":"恋鐘","text":"そいは、仲良くしてもらわんば困るけん！","trans":"相处不友好的话会很难办的！"},{"id":"3004010010380","name":"恋鐘","text":"うちのレモネードは！","trans":"我的柠檬水！"},{"id":"3004010010390","name":"霧子","text":"うん……！","trans":"嗯……！"},{"id":"3004010010400","name":"恋鐘","text":"はいっ、そいじゃあもう一回\\nレモンば敷いて……","trans":"好，那么再铺一次柠檬……"},{"id":"3004010010410","name":"霧子","text":"ん、しょ……","trans":"铺……"},{"id":"3004010010420","name":"恋鐘","text":"氷砂糖！","trans":"冰糖！"},{"id":"3004010010430","name":"霧子","text":"氷砂糖……！","trans":"冰糖……！"},{"id":"3004010010440","name":"恋鐘","text":"グラニュー糖！","trans":"细砂糖！"},{"id":"3004010010450","name":"霧子","text":"グラニュー糖……！","trans":"细砂糖……！"},{"id":"3004010010460","name":"恋鐘","text":"よしっ！","trans":"好！"},{"id":"3004010010470","name":"霧子","text":"ふふ……きれい……","trans":"呵呵……好漂亮……"},{"id":"3004010010480","name":"恋鐘","text":"最後にはちみつばかけて\\n蓋して……","trans":"最后放进蜂蜜，盖上盖……"},{"id":"3004010010490","name":"恋鐘","text":"おてんとさんの当たらんとこで寝かせる！","trans":"放在太阳照不到的地方！"},{"id":"3004010010500","name":"霧子","text":"お日さまの……？","trans":"照不到的地方……？"},{"id":"3004010010510","name":"恋鐘","text":"うん～\\nそいがコツ～！","trans":"嗯～这是要诀～!"},{"id":"3004010010520","name":"霧子","text":"わぁ……","trans":"哇……"},{"id":"3004010010530","name":"霧子","text":"レモンと……\\nお砂糖と……はちみつ……","trans":"柠檬……\\n跟砂糖……还有蜂蜜……"},{"id":"3004010010540","name":"霧子","text":"かくれんぼして……\\n甘くなるんだね……","trans":"一起捉迷藏……\\n会变甜呢……"},{"id":"3004010010550","name":"恋鐘","text":"んふふ～\\nもういいかい～って、毎日聞かんばね！","trans":"嗯哼哼～\\n每天都来问下“藏好了吗”！"},{"id":"3004010010560","name":"霧子","text":"ふふ……","trans":"呵呵……"},{"id":"3004010010570","name":"霧子","text":"もう……いいかーい……","trans":"藏好了吗……"},{"id":"3004010010580","name":"恋鐘","text":"ん～……もういいか～い","trans":"嗯～……藏好了～吗"},{"id":"3004010010590","name":"霧子","text":"ふふふ……","trans":"呵呵呵……"},{"id":"3004010010600","name":"霧子","text":"……まーだだよ","trans":"……还没有哦"}]}