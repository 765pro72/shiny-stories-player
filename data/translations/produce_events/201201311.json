{
  "translator": "阿柚",
  "rows": [
    {
      "id": "2012013110010",
      "name": "凛世",
      "text": "……\\nこちらを……ふたつ……",
      "trans": "……\\n这个……来两个……"
    },
    {
      "id": "2012013110020",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012013110030",
      "name": "凛世",
      "text": "ソースは……\\nチョコレートを……",
      "trans": "口味的话……\\n要巧克力酱……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はー…………",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "会議資料の準備と……予算の見直しは明日中、\\n出張の手配の依頼、予定整理して、稟議も切らないと",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "終わるか、今日……？",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110040",
      "name": "凛世",
      "text": "はい……\\n持ち歩きは……20分ほど……",
      "trans": "嗯……\\n送过去……要20分钟左右……"
    },
    {
      "id": "2012013110050",
      "name": "凛世",
      "text": "──\\nありがとうございます……",
      "trans": "──\\n谢谢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ふー……",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\n30分だけ仮眠……いいよな……",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110060",
      "name": "凛世",
      "text": "────ふふっ……",
      "trans": "────哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………────────\\n────────",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110070",
      "name": "凛世",
      "text": "──────……",
      "trans": "──────……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──────すぅ…………\\n──────────",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110080",
      "name": "凛世",
      "text": "…………？\\n奥の……電気が…………",
      "trans": "…………？\\n里头……灯怎么…………"
    },
    {
      "id": "2012013110090",
      "name": "凛世",
      "text": "プロデューサーさま…………",
      "trans": "制作人大人…………"
    },
    {
      "id": "2012013110100",
      "name": "凛世",
      "text": "────\\nプロ……──────",
      "trans": "────\\n制……──────"
    },
    {
      "id": "2012013110110",
      "name": "凛世",
      "text": "──────…………",
      "trans": "──────…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──────\\n──────────",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110120",
      "name": "凛世",
      "text": "……ふふっ",
      "trans": "……哈哈"
    },
    {
      "id": "2012013110130",
      "name": "凛世",
      "text": "眉間が……\\n鬼のようでございます…………",
      "trans": "眉间……\\n皱得跟恶鬼一样…………"
    },
    {
      "id": "2012013110140",
      "name": "凛世",
      "text": "トーストの上で……\\nとろっと溶ける……バター……",
      "trans": "烤吐司上…\\n像糖浆一样融化着……黄油……"
    },
    {
      "id": "2012013110150",
      "name": "凛世",
      "text": "パンケーキの上に……\\nでろーっと広がる……",
      "trans": "煎饼上……\\n啪嗒地向四周流淌着的……"
    },
    {
      "id": "2012013110160",
      "name": "凛世",
      "text": "チョコレートソース……",
      "trans": "巧克力酱……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ほら、眉間に指をあてて……",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110170",
      "name": "凛世",
      "text": "……\\nぐる……ぐる…………",
      "trans": "……\\n转呀……转…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────────…………\\n……────────────",
      "trans": "哈——…………"
    },
    {
      "id": "2012013110180",
      "name": "凛世",
      "text": "……──────",
      "trans": "……──────"
    },
    {
      "id": "2012013110190",
      "name": "凛世",
      "text": "────\\nちゃんと……オフにしてくださいませ……",
      "trans": "────\\n还请……“关”上……"
    },
    {
      "id": "2012013110200",
      "name": "凛世",
      "text": "お眠りになる間は…………",
      "trans": "在睡去的这段时间里…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────────…………\\nん…………はいはい………………",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "………………はぁ…………\\nもう30分か…………",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "よし……続きだ続き────",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────あれ\\nなんだ、『冷蔵庫にパンケーキがございます』…………",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………パンケーキ…………\\n凛世……！？",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……？",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……はは\\nありがとな、凛世",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "これ食べるまでは、オフにさせてもらうよ\\n────うん、チョコレートソースも付いてる",
      "trans": "哈——…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "でろー…………",
      "trans": "哈——…………"
    }
  ]
