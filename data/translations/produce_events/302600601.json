{"translator":"AI初翻（gpt-4o）+奥術心白重译","rows":[{"id":"3026006010010","name":"ルカ","text":"────────……","trans":"────────……"},{"id":"0000000000000","name":"スタッフ１","text":"コメティックのみなさん\\nお疲れさまでした～！","trans":"CoMETIK的各位\\n辛苦了～！"},{"id":"0000000000000","name":"アイドル１","text":"お疲れ様でしたー！","trans":"辛苦了—！"},{"id":"0000000000000","name":"アイドル２","text":"お疲れ様でした……！！","trans":"辛苦了……！！"},{"id":"3026006010020","name":"ルカ","text":"────────……","trans":"────────……"},{"id":"3026006010030","name":"ルカ","text":"────────終わった","trans":"────────结束了"},{"id":"3026006010040","name":"ルカ","text":"これで","trans":"这样一来"},{"id":"3026006010050","name":"ルカ","text":"────────終わったよ","trans":"────────就结束了"},{"id":"3026006010060","name":"ルカ","text":"これで…………","trans":"这样一来…………"},{"id":"0000000000000","name":"アイドル１","text":"見て見て！\\nシーズがステージに出てきたよ","trans":"快看快看！\\n轮到SHHis登场了"},{"id":"0000000000000","name":"アイドル２","text":"こっちもすごい盛り上がってるね","trans":"这边也好热闹呢"},{"id":"3026006010070","name":"ルカ","text":"──────────────","trans":"──────────────"},{"id":"3026006010080","name":"ルカ","text":"なぁ────────","trans":"我说────────"},{"id":"3026006010090","name":"ルカ","text":"どうだった？","trans":"怎么样？"},{"id":"3026006010100","name":"ルカ","text":"オマエ──────────","trans":"你──────────"},{"id":"3026006010110","name":"ルカ","text":"──────────────","trans":"──────────────"},{"id":"3026006010120","name":"ルカ","text":"なぁ────────","trans":"说啊────────"},{"id":"3026006010130","name":"ルカ","text":"どうだった？","trans":"什么感受？"},{"id":"3026006010140","name":"ルカ","text":"オマエ────────","trans":"你────────"},{"id":"3026006010150","name":"ルカ","text":"ひとりで頑張って","trans":"独自栽进里头"},{"id":"3026006010160","name":"ルカ","text":"────どうだった？","trans":"────感觉怎么样？"},{"id":"3026006010170","name":"ルカ","text":"だって私たち、相性最高なんだ──────","trans":"因为我们，相性最好了──────"},{"id":"3026006010180","name":"ルカ","text":"────んでだよ……！　ハァ……！？\\nなんでそうなるんだよ……！　勝手に決めんな…………！","trans":"────搞什么啊……！哈……！？\\n为什么要这么干啊……！别自作主张…………！"},{"id":"3026006010190","name":"ルカ","text":"解散…………て──────────？","trans":"解散…………吗──────────？"},{"id":"3026006010200","name":"ルカ","text":"…………","trans":"…………"},{"id":"3026006010210","name":"ルカ","text":"そんなふうに踊ってた？","trans":"是那样跳的吗？"},{"id":"3026006010220","name":"ルカ","text":"ひとりでやる","trans":"我一个人来干"},{"id":"3026006010230","name":"ルカ","text":"やっていける","trans":"会做得到的"},{"id":"3026006010240","name":"ルカ","text":"ひとりで踊って\\n歌って──────","trans":"一个人跳舞\\n唱歌──────"},{"id":"3026006010250","name":"ルカ","text":"どうだった？","trans":"怎么样？"},{"id":"3026006010260","name":"ルカ","text":"だって私たち、相性最高なんだ──────","trans":"因为我们，相性最好了──────"},{"id":"3026006010270","name":"ルカ","text":"──────────","trans":"──────────"},{"id":"3026006010280","name":"ルカ","text":"そう、最ッ高────────！","trans":"对，最好了────────！"},{"id":"0000000000000","name":"アイドル２","text":"シーズのステージ、すっごくよかった～！","trans":"SHHis的演出，实在是太棒了～！"},{"id":"0000000000000","name":"アイドル１","text":"さすがだったね……！","trans":"不愧是她们呢……！"},{"id":"3026006010290","name":"ルカ","text":"…………","trans":"…………"},{"id":"3026006010300","name":"ルカ","text":"でもそれは──────","trans":"不过那只是──────"},{"id":"3026006010310","name":"ルカ","text":"片方が、そう思いたかっただけ──────","trans":"只是我单方面，这么想而已──────"},{"id":"3026006010320","name":"ルカ","text":"本当は────────","trans":"其实────────"},{"id":"3026006010330","name":"ルカ","text":"はは","trans":"哈哈"},{"id":"3026006010340","name":"ルカ","text":"本当は、全然似合ってねェよ\\nオメェら────────────────────","trans":"其实，完全合不来啊\\n你跟我────────────────────"},{"id":"3026006010350","name":"ルカ","text":"……","trans":"……"},{"id":"0000000000000","name":"スタッフ２","text":"斑鳩さん！！","trans":"斑鸠小姐！！"},{"id":"0000000000000","name":"スタッフ２","text":"ライブ、お疲れ様でした！\\nすごくいいステージでした","trans":"演出，辛苦了！\\n非常地精彩"},{"id":"3026006010360","name":"ルカ","text":"そう……ありがとう","trans":"是吗……谢谢"},{"id":"0000000000000","name":"スタッフ２","text":"それで、えっと……","trans":"就是，那个……"},{"id":"3026006010370","name":"ルカ","text":"……？","trans":"……？"},{"id":"0000000000000","name":"スタッフ２","text":"本当はこういうのよくないんですけど……\\nサイン、お願いしたくて……","trans":"虽然这样不太好……\\n签名，拜托了……"},{"id":"3026006010380","name":"ルカ","text":"あぁ……いいよ\\n書くもんある？","trans":"啊……可以啊\\n有可以签的东西吗？"},{"id":"0000000000000","name":"スタッフ２","text":"は、はい！\\nええっと……","trans":"有，有的！\\n那个……"},{"id":"0000000000000","name":"スタッフ２","text":"じゃあ……ここに────────","trans":"那么……请签在这里────────"},{"id":"3026006010390","name":"ルカ","text":"え────────────……","trans":"欸────────────……"},{"id":"3026006010400","name":"ルカ","text":"これ…………","trans":"这是…………"},{"id":"0000000000000","name":"スタッフ２","text":"さっき、緋田さんにもお願いして\\n片側には緋田さんのサイン、書いてもらったんです","trans":"刚才，我也拜托绯田小姐了\\n那一边是绯田小姐的签名"},{"id":"0000000000000","name":"スタッフ２","text":"実は私……\\nおふたりがユニット組んでた頃からのファンで──────","trans":"其实我……\\n从你们组队的时候就一直是粉丝──────"},{"id":"0000000000000","name":"スタッフ２","text":"だから、もう片方には\\n斑鳩さんのサイン、書いてもらいたくて","trans":"所以，另一边\\n想请斑鸠小姐签名"},{"id":"3026006010410","name":"ルカ","text":"…………","trans":"…………"},{"id":"3026006010420","name":"ルカ","text":"でも、私は…………","trans":"可是，我…………"},{"id":"0000000000000","name":"スタッフ２","text":"ダメ、ですか……？","trans":"不行吗……？"},{"id":"3026006010430","name":"ルカ","text":"ここに……書いて、いいの──────？","trans":"可以……签在这里吗──────？"},{"id":"0000000000000","name":"スタッフ２","text":"はい、是非！","trans":"当然，请务必！"},{"id":"3026006010440","name":"ルカ","text":"…………","trans":"…………"},{"id":"3026006010450","name":"ルカ","text":"はい、これ","trans":"好了，给你"},{"id":"0000000000000","name":"スタッフ２","text":"ふふ、ありがとうございます！","trans":"嘿嘿，谢谢您！"},{"id":"0000000000000","name":"スタッフ２","text":"私、宝物にします────","trans":"我，会把它当成宝物────"},{"id":"3026006010460","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"スタッフ２","text":"おふたりのこと\\nすごくすごく、好きだったので────","trans":"我真的特别特别\\n喜欢你们二位────"},{"id":"3026006010470","name":"ルカ","text":"そう…………","trans":"是吗…………"},{"id":"0000000000000","name":"スタッフ２","text":"それじゃあ、私はこれで──","trans":"那我就先走了──"},{"id":"0000000000000","name":"スタッフ２","text":"今日のステージ、とってもよかったです！","trans":"今天的演出真的太精彩了！"},{"id":"0000000000000","name":"スタッフ２","text":"サイン、ありがとうございました","trans":"非常感谢您的签名"},{"id":"0000000000000","name":"スタッフ２","text":"えっと……","trans":"那个……"},{"id":"3026006010480","name":"ルカ","text":"──何？","trans":"──什么？"},{"id":"0000000000000","name":"スタッフ２","text":"…………私、これ\\nずっと、大切にします────！","trans":"……这个我会\\n一直，珍惜着的────！"},{"id":"3026006010490","name":"ルカ","text":"…………","trans":"…………"},{"id":"3026006010500","name":"ルカ","text":"そう……","trans":"是吗……"},{"id":"3026006010510","name":"ルカ","text":"ずっと、大切に──────────────……","trans":"一直，珍惜着──────────────……"}]}