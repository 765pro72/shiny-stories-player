{"translator":"魚見","rows":[{"id":"2020010110010","name":"透","text":"ねー","trans":"哎——"},{"id":"2020010110020","name":"透","text":"ねー","trans":"我说——"},{"id":"2020010110030","name":"透","text":"ねーって","trans":"我说啊——"},{"id":"2020010110040","name":"透","text":"ねー……","trans":"哎——"},{"id":"0000000000000","name":"プロデューサー","text":"────ん？","trans":"————嗯？"},{"id":"2020010110050","name":"透","text":"消して\\n電気","trans":"关掉吧\\n灯"},{"id":"0000000000000","name":"プロデューサー","text":"……\\n仕事してるんだけどな？","trans":"……\\n我还在工作哦？"},{"id":"2020010110060","name":"透","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"プロデューサー","text":"はは\\n寝れないか","trans":"哈哈\\n睡不着吗"},{"id":"2020010110070","name":"透","text":"そー","trans":"对——"},{"id":"0000000000000","name":"プロデューサー","text":"毛布かぶってても？","trans":"盖上毛毯？"},{"id":"0000000000000","name":"プロデューサー","text":"すまんすまん\\n────よ……","trans":"抱歉抱歉\\n————好……"},{"id":"0000000000000","name":"プロデューサー","text":"でも\\nもう20分くらいで出るからな？","trans":"不过\\n再过个二十分钟左右就要出门咯？"},{"id":"2020010110080","name":"透","text":"うぃー","trans":"知道了——"},{"id":"0000000000000","name":"プロデューサー","text":"……────","trans":""},{"id":"2020010110090","name":"透","text":"…………","trans":""},{"id":"2020010110100","name":"透","text":"……\\n……ねー","trans":"……\\n……我说——"},{"id":"0000000000000","name":"プロデューサー","text":"……ん？","trans":"……嗯？"},{"id":"2020010110110","name":"透","text":"見える？","trans":"看得见吗？"},{"id":"0000000000000","name":"プロデューサー","text":"え？　ああ……\\nPCは大丈夫だよ","trans":"诶？　啊啊……\\n电脑没事的"},{"id":"2020010110120","name":"透","text":"んー","trans":"嗯——"},{"id":"2020010110130","name":"透","text":"……ねー","trans":"……我说——"},{"id":"0000000000000","name":"プロデューサー","text":"……はは\\nどうした？","trans":"……哈哈\\n怎么了？"},{"id":"2020010110140","name":"透","text":"暗い","trans":"好暗"},{"id":"0000000000000","name":"プロデューサー","text":"……透ー\\n透が消せって言ったんだぞ","trans":"……透——\\n是你说要关灯的哦"},{"id":"2020010110150","name":"透","text":"ふふっ\\n違う。なんか……","trans":"呵呵\\n不是。感觉……"},{"id":"2020010110160","name":"透","text":"なんか黒い、めっちゃ\\n毛布かぶったら","trans":"感觉好黑，非常黑\\n盖上毛毯后"},{"id":"2020010110170","name":"透","text":"──────黒がある、ってこと？　黒って","trans":"——————黑是说明，　有黑色？"},{"id":"0000000000000","name":"プロデューサー","text":"……え？","trans":"……诶？"},{"id":"2020010110180","name":"透","text":"ないってことかな、なんも？","trans":"还是说没有吗，什么都？"},{"id":"0000000000000","name":"プロデューサー","text":"……ええと","trans":"……呃呃"},{"id":"0000000000000","name":"プロデューサー","text":"……ええと\\n黒い色があるのか、色がないから黒いのか……ってことか？","trans":"……那个\\n你是想问黑是因为有黑色存在，还是说什么都没有……是吗？"},{"id":"2020010110190","name":"透","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nそんなふうに言われると……どうなんだろう","trans":"……\\n被这么一问……是怎样呢"},{"id":"0000000000000","name":"プロデューサー","text":"……似てるな\\nあることも、ないことも","trans":"……很像啊\\n有也是，没有也是"},{"id":"2020010110200","name":"透","text":"……\\nじゃ、私は？","trans":"……\\n那，我呢？"},{"id":"2020010110210","name":"透","text":"黒？\\nない？","trans":"黑色？\\n无色？"},{"id":"0000000000000","name":"プロデューサー","text":"……────","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"────あるよ","trans":"————有的啊"},{"id":"0000000000000","name":"プロデューサー","text":"あるだろ？　黒なのか、ないのかはわからないけど\\n…………色とか線とか形とかさ","trans":"有的吧？　虽然不知道是黑色，还是无色\\n…………颜色啊线条啊形状之类"},{"id":"0000000000000","name":"プロデューサー","text":"…………味とか……\\n重さとか、音とか……温度とか","trans":"…………味道啊……\\n重量啊，声音啊……温度之类"},{"id":"0000000000000","name":"プロデューサー","text":"そういう……\\n……全部みたいに見える","trans":"这些……\\n……仿佛能看到所有"},{"id":"2020010110220","name":"透","text":"……ふーん","trans":"……呼呜——"},{"id":"2020010110230","name":"透","text":"ふぁ……\\n……じゃ、いいや","trans":"呼啊……\\n……那，就这样吧"},{"id":"2020010110240","name":"透","text":"ふふっ","trans":"呵呵"}]}