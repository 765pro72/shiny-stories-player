{"translator":"告","rows":[{"id":"3022003010010","name":"小糸","text":"透ちゃん\\nお、お邪魔します……！","trans":"小透\\n打，打扰了……！"},{"id":"3022003010020","name":"雛菜","text":"──あは～","trans":"——啊哈～"},{"id":"3022003010030","name":"雛菜","text":"この部屋涼しい～～～～～♡","trans":"这个房间好凉～～～～～♡"},{"id":"3022003010040","name":"透","text":"うそ","trans":"真的吗"},{"id":"3022003010050","name":"雛菜","text":"お邪魔します～～～！","trans":"打扰了～～～！"},{"id":"3022003010060","name":"小糸","text":"ぴぇ……！","trans":"耶……！"},{"id":"3022003010070","name":"小糸","text":"こ、この部屋、\\nちょっと涼しすぎない……！？","trans":"这，这个房间，\\n太凉了吧……！？"},{"id":"3022003010080","name":"透","text":"え？","trans":"诶？"},{"id":"3022003010090","name":"透","text":"──20度？","trans":"——20度？"},{"id":"3022003010100","name":"小糸","text":"さ、寒すぎるよ！","trans":"太，太冷了啦！"},{"id":"3022003010110","name":"小糸","text":"28度にしましょうって\\n習わなかった！？","trans":"你没学过\\n要设置成28度吗！？"},{"id":"3022003010120","name":"小糸","text":"円香ちゃんなんて\\nお布団かぶってるじゃん……！","trans":"就连圆香\\n都包着棉被了……！"},{"id":"3022003010130","name":"円香","text":"…………\\n私は快適だけど","trans":"…………\\n我倒是很舒服"},{"id":"3022003010140","name":"小糸","text":"それはそうだよ……！","trans":"那当然舒服啊……！"},{"id":"3022003010150","name":"雛菜","text":"あ、雛菜\\nアイス買ってきたよ～～～♡","trans":"啊，雏菜\\n买冰淇淋了～～～♡"},{"id":"3022003010160","name":"雛菜","text":"透先輩もいる～？","trans":"透学姐要吗～？"},{"id":"3022003010170","name":"透","text":"ありがと","trans":"谢谢你"},{"id":"3022003010180","name":"透","text":"でも、いいや","trans":"不过，不用了"},{"id":"3022003010190","name":"透","text":"寒いし","trans":"挺冷的"},{"id":"3022003010200","name":"小糸","text":"ほ、ほら……！\\n寒いって！","trans":"你，你看……！\\n你都喊冷了！"},{"id":"3022003010210","name":"小糸","text":"今、自分で言ったよ……！","trans":"刚才，你自己说的……！"},{"id":"3022003010220","name":"透","text":"え","trans":"诶"},{"id":"3022003010230","name":"小糸","text":"せ、せめて25度くらいにしようよ！","trans":"至，至少调成25度吧！"},{"id":"3022003010240","name":"小糸","text":"そしたら円香ちゃんも\\n出てこられるし……！","trans":"这样的话\\n圆香也能出来了……！"},{"id":"3022003010250","name":"円香","text":"……私は別にいいけど","trans":"……我没关系"},{"id":"3022003010260","name":"小糸","text":"アイスも食べられるし……！","trans":"还能吃冰淇淋……！"},{"id":"3022003010270","name":"雛菜","text":"みんな食べないなら\\n冷凍庫入れてくる～～～！","trans":"大家不吃的话\\n就放冰箱啦～～～！"},{"id":"3022003010280","name":"小糸","text":"透ちゃん、\\nエアコンのリモコンは？","trans":"小透，\\n冷气的遥控器呢？"},{"id":"3022003010290","name":"透","text":"あー……","trans":"啊——……"},{"id":"3022003010300","name":"透","text":"ふふっ\\nわかんなくて","trans":"呵呵\\n不知道"},{"id":"3022003010310","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"3022003010320","name":"透","text":"だから……っくしゅん","trans":"所以说……阿嚏"},{"id":"3022003010330","name":"透","text":"寒いよね","trans":"好冷啊"},{"id":"3022003010340","name":"小糸","text":"も、もう！\\nくしゃみしてるじゃん……！","trans":"你，你看！\\n都打喷嚏了……！"},{"id":"3022003010350","name":"小糸","text":"風邪引いちゃうよ！","trans":"会感冒啦！"},{"id":"3022003010360","name":"透","text":"ふふっ\\nごめん","trans":"呵呵\\n抱歉"},{"id":"3022003010370","name":"小糸","text":"ま、円香ちゃん！\\nそっちには無い！？","trans":"圆，圆香！\\n你那里有吗！？"},{"id":"3022003010380","name":"円香","text":"……無い","trans":"……没有"},{"id":"3022003010390","name":"円香","text":"ちょ……\\n布団めくらないでよ","trans":"等……\\n不要翻棉被"},{"id":"3022003010400","name":"円香","text":"寒い","trans":"好冷"},{"id":"3022003010410","name":"小糸","text":"でも、お布団の中に\\nあるかもしれないし……！","trans":"可是，棉被里\\n可能会有啊……！"},{"id":"3022003010420","name":"透","text":"……小糸ちゃんも、なんか着る？\\n上着","trans":"……小糸，也穿件衣服吧？\\n上衣什么的"},{"id":"3022003010430","name":"小糸","text":"ちょ、ちょっと……！","trans":"等，等一下……！"},{"id":"3022003010440","name":"小糸","text":"透ちゃんも探そう！？\\nリモコン！","trans":"小透也来找吧！？\\n遥控器！"},{"id":"3022003010450","name":"小糸","text":"せめてどこに置いたか\\n思い出してみて……！","trans":"至少想想\\n你放哪里了……！"},{"id":"3022003010460","name":"透","text":"え？\\nんー……","trans":"诶？\\n嗯——……"},{"id":"3022003010470","name":"雛菜","text":"ね～～～","trans":"那个～～～"},{"id":"3022003010480","name":"雛菜","text":"これ、キッチンにあったから\\n持ってきたんだけど","trans":"这个啊，刚去厨房的时候\\n顺手拿过来了"},{"id":"3022003010490","name":"雛菜","text":"どこの部屋のやつ～？","trans":"是哪个房间的～？"},{"id":"3022003010500","name":"雛菜","text":"──エアコンのリモコン！","trans":"——冷气遥控器！"}]}