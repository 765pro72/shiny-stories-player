{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"3004007010010","name":"恋鐘","text":"さらさら～……の……","trans":"滑滑的——……的……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010020","name":"恋鐘","text":"しゅっしゅっ～……","trans":"咻咻——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010030","name":"恋鐘","text":"ん～……よか香りばい～","trans":"嗯——……好香啊——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010040","name":"恋鐘","text":"ふんふ～ん……","trans":"哼哼——嗯……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010050","name":"恋鐘","text":"夢見る髪に～\r\n魔法のような恋の香りを～","trans":"给梦想的头发——\n施上魔法般恋爱的香气——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010060","name":"恋鐘","text":"……んふふ～\r\n『恋の香り』やって～……","trans":"……嗯呵呵——\n“恋爱的香气”来一下——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010070","name":"恋鐘","text":"……もう１プッシュしとこ","trans":"……再喷一下","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010080","name":"恋鐘","text":"おっつかれさまで～す！","trans":"辛——苦——啦——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010100","name":"恋鐘","text":"……なんか……恋の香りがするばい","trans":"……总觉得……闻到恋爱的香气了","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010110","name":"恋鐘","text":"……すんすん～……","trans":"……嗅嗅——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010130","name":"恋鐘","text":"霧子～！　来とったと～？","trans":"雾子——！你已经来了吗——？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010140","name":"霧子","text":"うん……おはよう……","trans":"嗯……早上好……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010150","name":"恋鐘","text":"おは──","trans":"早上——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010160","name":"恋鐘","text":"…………すんすん～","trans":"…………嗅嗅——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010170","name":"霧子","text":"きゃ……\r\nど、どうしたの……？","trans":"呀……\n怎、怎么了……？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010180","name":"恋鐘","text":"霧子やね～！","trans":"是雾子啊——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010200","name":"恋鐘","text":"恋の香りのしとるとよ～！","trans":"你身上有恋爱的香气哦——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010210","name":"霧子","text":"こ、恋……！？","trans":"恋、恋爱……！？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010220","name":"霧子","text":"──あ、ふふっ","trans":"——啊，呵呵","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010230","name":"霧子","text":"うん……\r\n『マジーア・アンティーカ』つけてるんだ……","trans":"嗯……\n我擦了“Magia Antica”……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010240","name":"恋鐘","text":"んふふ～！　うちも～","trans":"嗯呵呵——！我也是——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010250","name":"恋鐘","text":"──すんすん～","trans":"——嗅嗅——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010260","name":"霧子","text":"すんすん～……","trans":"嗅嗅——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010270","name":"霧子","text":"ほんとだ……\r\nおんなじ匂い……","trans":"真的呢……\n一样的味道……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010280","name":"恋鐘","text":"うん～！　……ばってん","trans":"嗯——！……不过","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010290","name":"恋鐘","text":"霧子の方が、なんか優しか感じするね！","trans":"雾子那边的，总觉得感觉更温柔呢！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010300","name":"霧子","text":"……そうなの……？","trans":"……是吗……？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010310","name":"恋鐘","text":"そうばい～\r\nうち、つけ過ぎやったとかな……","trans":"是啊——\n我是不是擦太多了呢……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010330","name":"霧子","text":"ふふ……\r\n恋鐘ちゃんが……優しいからじゃないかな……","trans":"呵呵……\n也许是因为……恋钟很温柔吧……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010350","name":"恋鐘","text":"あ、結華～","trans":"啊，结华——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010360","name":"結華","text":"ん？　早いねぇ\r\nきりりんも！","trans":"嗯？好早呢\n小雾也是！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010370","name":"霧子","text":"おはよう、結華ちゃん……","trans":"早上好，结华……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010380","name":"結華","text":"おはよ──","trans":"早上好——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010390","name":"霧子","text":"あ……","trans":"啊……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010410","name":"恋鐘","text":"すんすん～！","trans":"嗅嗅——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010430","name":"結華","text":"なっ、ふたりともなになに！？","trans":"诶，你们两个怎么了怎么了！？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010440","name":"恋鐘","text":"結華もばい！","trans":"结华也有！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010460","name":"結華","text":"えっ、何が……","trans":"诶，什么……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010461","name":"恋鐘＆霧子","text":"『マジーア・アンティーカ』","trans":"“Magia Antica”","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010470","name":"結華","text":"ああ……！\r\nうん、つけてきてみましたー","trans":"啊……！\n嗯，我试着擦过来了——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010480","name":"恋鐘","text":"結華も気に入っとると～？","trans":"结华也喜欢吗——？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010490","name":"結華","text":"そうねぇ……\r\nそれに、スポンサー様の顔も立てなきゃだしね？","trans":"是啊……\n而且也得给赞助商面子嘛？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010500","name":"恋鐘","text":"はぁ～！　さっすが結華ばい～","trans":"哈——！不愧是结华——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010510","name":"結華","text":"……あれ、ふたりもつけてる？","trans":"……咦，你们俩也擦了吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010520","name":"恋鐘","text":"うん～！　霧子の方が優しか匂いで～\r\nうちがつけ過ぎの匂い～！","trans":"嗯——！雾子那边是温柔的味道——\n我这边是擦太多的味道——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010530","name":"結華","text":"つけ過ぎの匂いって……！\r\nどれどれー……？","trans":"擦太多的味道是什么啊……！\n让我闻闻——……？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010540","name":"結華","text":"すんすんー……","trans":"嗅嗅——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010550","name":"恋鐘","text":"嗅ぎ過ぎ注意ばい～\r\nすんすん～……","trans":"别闻太多哦——\n嗅嗅——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010560","name":"霧子","text":"ふふ……結華ちゃん、お日さまの匂いもする……\r\nすんすん～……","trans":"呵呵……结华身上还有太阳的味道……\n嗅嗅——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010570","name":"摩美々","text":"……何してんのー","trans":"……你们在干什么啊——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010580","name":"結華","text":"あ、まみみん","trans":"啊，摩美美","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010590","name":"摩美々","text":"なんか……花みたいな匂いしな──","trans":"总觉得……有股花一样的味道——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010600","name":"恋鐘","text":"あっ、もしかして摩美々も～！？","trans":"啊，难道摩美美也——！？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010611","name":"恋鐘＆霧子","text":"すんすん～……！","trans":"嗅嗅——……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010640","name":"恋鐘","text":"……つけとらんとね","trans":"……你没擦呢","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010650","name":"摩美々","text":"……もしかしてー\r\n『マジーア・アンティーカ』？","trans":"……难道是——\n“Magia Antica”？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010660","name":"結華","text":"ふふっ、そう\r\nなんか今日、３人ともつけてるんだよねー","trans":"呵呵，对\n今天不知怎么的，三个人都擦了——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010670","name":"恋鐘","text":"摩美々もつけてみんね～？","trans":"摩美美也试试看——？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010680","name":"摩美々","text":"えー","trans":"诶——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010690","name":"咲耶","text":"みんなお疲れ様\r\n……何をしてるんだい？","trans":"大家辛苦了\n……你们在做什么？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010700","name":"摩美々","text":"あ、咲耶ぁ","trans":"啊，咲耶——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010710","name":"霧子","text":"あのね、わたしたち……","trans":"那个呢，我们……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010720","name":"霧子","text":"……あれっ\r\n咲耶さんも……『マジーア・アンティーカ』……？","trans":"……咦\n咲耶也……“Magia Antica”……？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010730","name":"咲耶","text":"おやおや、そういう霧子も……──","trans":"哎呀哎呀，这么说的雾子也……——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010740","name":"咲耶","text":"……クス、もしかしてみんなつけているのかい？","trans":"……噗，难道大家都擦了吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010750","name":"恋鐘","text":"ううん～\r\nひとりだけ、つけようとせん人のおるばい～！","trans":"不对哦——\n有一个人就是不肯擦呢——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010760","name":"結華","text":"ふふっ、こがたん待って待って","trans":"呵呵，小恋等等等等","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010770","name":"摩美々","text":"それ、誰のことー？","trans":"那个，是在说谁——？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010780","name":"恋鐘","text":"ふぇ……あれっ、摩美々～！？\r\nすんすん～……！","trans":"呼诶……咦，摩美美——！？\n嗅嗅——……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010790","name":"恋鐘","text":"──いつの間にかつけとる～！","trans":"——不知不觉就擦上了——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010800","name":"摩美々","text":"ふふー\r\n誰のことー？","trans":"呵呵——\n是在说谁——？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010810","name":"恋鐘","text":"摩美々も持っとったとね～！","trans":"原来摩美美也带着啊——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010820","name":"咲耶","text":"なるほど、恋の妖精たち再び、というわけか\r\nフフ、それなら……再会を祝いたいね","trans":"原来如此，恋爱的妖精们又聚齐了，是这样吧\n呵呵，那样的话……想庆祝一下重逢呢","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010830","name":"恋鐘","text":"んふふ～、うん～！","trans":"嗯呵呵——，嗯——！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3004007010850","name":"恋鐘","text":"…………はぁ～！\r\nよか匂い～……","trans":"…………哈——！\n好香——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}