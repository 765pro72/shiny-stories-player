{"translator":"魚見","rows":[{"id":"3021015010010","name":"透","text":"『恋人が死んで』","trans":"“恋人去世了”"},{"id":"3021015010020","name":"透","text":"『配信を始めた』","trans":"“我开始了直播”"},{"id":"3021015010030","name":"円香","text":"……観たまま書いてどうすんの","trans":"……照着原文写是想怎样"},{"id":"3021015010040","name":"透","text":"え\\nダメ？","trans":"诶\\n不行？"},{"id":"3021015010050","name":"円香","text":"ダメなんじゃない\\n自分の言葉で話せる人を求めてるんだから","trans":"不行的吧\\n那边需要的是能用自己的话说出来的人"},{"id":"3021015010060","name":"円香","text":"うちらが受けるオーディション\\n元々このドラマが好きな人も集まるだろうし","trans":"我们去参加的那场试镜\\n本来就聚集了很多喜欢这部剧的人"},{"id":"3021015010070","name":"円香","text":"……今更観始めてる時点で付け焼き刃なんだけど","trans":"……虽然现在才开始看就已经是临阵磨枪了"},{"id":"3021015010080","name":"円香","text":"事前アンケートくらいは\\nその辺上手くごまかした方がいいんじゃない？","trans":"事前调查问卷什么的\\n想办法好好蒙混过去不就行了？"},{"id":"3021015010090","name":"透","text":"んー","trans":"嗯——"},{"id":"3021015010100","name":"透","text":"『海を越えて、ようこそ』","trans":"“跨越大海，欢迎到来”"},{"id":"3021015010110","name":"透","text":"『海外ドラマ』","trans":"“海外电视剧”"},{"id":"3021015010120","name":"円香","text":"……取り敢えず最後まで観ない？","trans":"……总之先看到最后吧？"},{"id":"3021015010130","name":"透","text":"へーい","trans":"好喔——"},{"id":"3021015010140","name":"円香","text":"……","trans":""},{"id":"3021015010150","name":"円香","text":"……うちらがトーク番組のゲストなんて","trans":"……让我们去当杂谈节目的嘉宾"},{"id":"3021015010160","name":"円香","text":"…………","trans":""},{"id":"3021015010170","name":"透","text":"アピールしたいんだって\\nうちらのトーク","trans":"说是想展示一下\\n我们的杂谈"},{"id":"3021015010180","name":"透","text":"魅力あるからって","trans":"说是很有魅力"},{"id":"3021015010190","name":"円香","text":"……知ってる\\n一緒に聞いてた","trans":"……我知道\\n都一起听他说的"},{"id":"3021015010200","name":"透","text":"あー\\nそっか","trans":"啊——\\n对喔"},{"id":"3021015010210","name":"円香","text":"別に反発してるわけじゃないから\\nだから観るんでしょ、こうやって","trans":"我又不是在反对\\n所以才在看着好吧，像现在这样"},{"id":"3021015010220","name":"円香","text":"ぶっ通しで","trans":"一口气地"},{"id":"3021015010230","name":"透","text":"ふふ\\nぶっ通しだ","trans":"呵呵\\n一口气"},{"id":"3021015010240","name":"透","text":"晩ごはんどうするかって\\nお母さんが","trans":"晚饭怎么办\\n妈妈问"},{"id":"3021015010250","name":"円香","text":"……いや、いい\\nもう帰る","trans":"……没事，不用\\n我回去了"},{"id":"3021015010260","name":"円香","text":"明日には観終わるでしょ","trans":"明天就能看完了吧"},{"id":"3021015010270","name":"透","text":"泊まれば？","trans":"住下呗？"},{"id":"3021015010280","name":"透","text":"観ちゃえばいいじゃん\\n今日","trans":"看完它不就好了\\n今天"},{"id":"3021015010290","name":"円香","text":"……","trans":""},{"id":"3021015010300","name":"円香","text":"……そうだね","trans":"……说得也是"},{"id":"3021015010310","name":"透","text":"じゃあ、いるってことで","trans":"那就是在这吃晚饭了"},{"id":"3021015010320","name":"円香","text":"どうせ隣だし\\n準備したらまた来る","trans":"反正就在隔壁\\n我收拾一下再过来"},{"id":"3021015010330","name":"透","text":"なんか、もらってさ\\n魚、いっぱい","trans":"好像，收到了啥\\n鱼，好多"},{"id":"3021015010340","name":"透","text":"それ\\n樋口に食べさせたいんだって","trans":"说是\\n想让樋口也尝一尝"},{"id":"3021015010350","name":"透","text":"鮮度が命だから","trans":"鲜度至上嘛"},{"id":"3021015010360","name":"円香","text":"……それじゃあ、お言葉に甘えて","trans":"……那，既然都这么说了"},{"id":"3021015010370","name":"透","text":"ん","trans":"嗯"},{"id":"3021015010380","name":"円香","text":"……","trans":""},{"id":"3021015010390","name":"透","text":"樋口ー\\nパジャマー","trans":"樋口——\\n睡衣"},{"id":"3021015010400","name":"円香","text":"んー","trans":"嗯——"},{"id":"3021015010410","name":"透","text":"ここ\\n置いとくねー","trans":"我放这儿咯——"},{"id":"3021015010420","name":"透","text":"……あ","trans":"……啊"},{"id":"3021015010430","name":"透","text":"魚\\n樋口んちの分ー","trans":"鱼\\n樋口家那份"},{"id":"3021015010440","name":"透","text":"渡しといたからー\\n樋口ママに","trans":"送过去了——\\n给樋口妈妈"},{"id":"3021015010450","name":"円香","text":"どうも","trans":"谢谢"},{"id":"3021015010460","name":"円香","text":"……","trans":""},{"id":"3021015010470","name":"off","text":"乳白色の入浴剤","trans":"乳白色的入浴剂"},{"id":"3021015010480","name":"off","text":"甘い香り","trans":"甘甜的香气"},{"id":"3021015010490","name":"off","text":"溶ける","trans":"融化掉"},{"id":"3021015010500","name":"off","text":"不透明になる","trans":"变得不再透明"},{"id":"3021015010510","name":"off","text":"……そうやって、段々","trans":"……像这样，渐渐地"},{"id":"3021015010520","name":"off","text":"知らなかったふり","trans":"装作未曾知晓"},{"id":"3021015010530","name":"off","text":"美しいもの","trans":"美丽之物的存在"},{"id":"3021015010540","name":"off","text":"今まで忘れられていたように","trans":"就像至今为止所忘却的一般"},{"id":"3021015010550","name":"off","text":"浅倉透","trans":"浅仓透"},{"id":"3021015010560","name":"off","text":"……無理だ","trans":"……不行"},{"id":"3021015010570","name":"off","text":"私がアイドルでいる以上は","trans":"只要我还是偶像"},{"id":"3021015010580","name":"off","text":"浅倉をこれ以上","trans":"就别再继续"},{"id":"3021015010590","name":"off","text":"わかろうとするな","trans":"试图理解浅仓"}]}