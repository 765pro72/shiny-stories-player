{"translator":"StYL3","rows":[{"id":"6019004040010","name":"愛依","text":"……ふぅ……","trans":"……哈……"},{"id":"0000000000000","name":"プロデューサー","text":"愛依、お疲れ様……！","trans":"爱依，你辛苦了……！"},{"id":"6019004040020","name":"愛依","text":"プロデューサー、うち……","trans":"制作人，咱……"},{"id":"6019004040030","name":"愛依","text":"やり切った……！","trans":"做到了……！"},{"id":"6019004040040","name":"愛依","text":"気持ち……\\n届けた……！","trans":"把心意……\\n传达到了……！"},{"id":"0000000000000","name":"プロデューサー","text":"……よく頑張ったな！","trans":"……你很努力呢！"},{"id":"6019004040050","name":"愛依","text":"サンキュ！","trans":"谢啦！"},{"id":"6019004040081","name":"愛依","text":"次が楽しみでしょうがないし！","trans":"已经对下一场活动期待不已了！"}]}