{"translator":"月剑","rows":[{"id":"2018012110010","name":"冬優子","text":"……寒っ","trans":"……好冷"},{"id":"2018012110020","name":"冬優子","text":"お疲れ様です！","trans":"您辛苦了！"},{"id":"2018012110030","name":"冬優子","text":"プロデューサー、さー……ん","trans":"制作人，先……生"},{"id":"2018012110040","name":"冬優子","text":"………………","trans":"………………"},{"id":"2018012110050","name":"冬優子","text":"…………なんだ","trans":"…………什么嘛"},{"id":"2018012110060","name":"冬優子","text":"…………","trans":"…………"},{"id":"2018012110070","name":"冬優子","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"……お！","trans":"……有了！"},{"id":"0000000000000","name":"プロデューサー","text":"よし、これなら……──","trans":"好的，只要用这个的话……——"},{"id":"2018012110080","name":"冬優子","text":"……灯油くさ","trans":"……好大的煤油味"},{"id":"0000000000000","name":"プロデューサー","text":"──わっ！？","trans":"——哇！？"},{"id":"2018012110090","name":"冬優子","text":"驚きすぎ……","trans":"那么大反应……"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……冬優子か\\nお疲れ様","trans":"啊，是冬优子啊\\n您辛苦了"},{"id":"2018012110100","name":"冬優子","text":"……お疲れ様","trans":"……您辛苦了"},{"id":"2018012110110","name":"冬優子","text":"何やってんの？\\nこんなところで","trans":"躲在这种地方在干什么呢？"},{"id":"0000000000000","name":"プロデューサー","text":"ちょっとな\\nこれが──","trans":"是在弄这个……"},{"id":"0000000000000","name":"プロデューサー","text":"おっ……\\nついた！","trans":"哦……\\n点着了！"},{"id":"2018012110120","name":"冬優子","text":"……なんでストーブ？","trans":"……为什么在这里鼓捣暖炉？"},{"id":"0000000000000","name":"プロデューサー","text":"使えるかどうか試してほしいって頼まれたんだよ\\nだから一旦預かっててさ","trans":"有人托我试试看这东西能不能用\\n所以暂时放在我这里的"},{"id":"2018012110130","name":"冬優子","text":"ふーん","trans":"哼……？"},{"id":"2018012110140","name":"冬優子","text":"あったまってきた……","trans":"暖起来了……"},{"id":"0000000000000","name":"プロデューサー","text":"結構使えるもんだな","trans":"好像相当能用呢"},{"id":"2018012110150","name":"冬優子","text":"……くさいけどね","trans":"……虽说味道很大"},{"id":"0000000000000","name":"プロデューサー","text":"確かに臭うよな\\nでも、この臭いが落ち着くっていうか","trans":"确实味道很大\\n但是，这种味道很让人安心吧"},{"id":"2018012110160","name":"冬優子","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"どうした？","trans":"怎么了？"},{"id":"2018012110170","name":"冬優子","text":"……え？","trans":"……诶？"},{"id":"0000000000000","name":"プロデューサー","text":"何か用があったんじゃないのか？","trans":"你是有什么事才找来这里的吧？"},{"id":"2018012110180","name":"冬優子","text":"……………","trans":"…………"},{"id":"2018012110190","name":"冬優子","text":"……そうね","trans":"……是啊"},{"id":"0000000000000","name":"プロデューサー","text":"……………","trans":"………………"},{"id":"2018012110200","name":"冬優子","text":"はー","trans":"哈啊……"},{"id":"2018012110210","name":"冬優子","text":"あったか","trans":"好温暖"},{"id":"0000000000000","name":"プロデューサー","text":"……うん","trans":"……嗯"},{"id":"0000000000000","name":"プロデューサー","text":"たまにはいいよな\\nこういうのも","trans":"偶尔像这样烤烤火也不错"},{"id":"2018012110220","name":"冬優子","text":"……………","trans":"………………"},{"id":"2018012110230","name":"冬優子","text":"…………たまにはね","trans":"…………偶尔呢"}]}