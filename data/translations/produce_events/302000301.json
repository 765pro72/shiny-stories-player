{"translator":"告","rows":[{"id":"3020003010010","name":"円香","text":"１、２、３、４\\n右、右、右、キメ……","trans":"1，2，3，4\\n右，右，右，收尾……"},{"id":"3020003010020","name":"透","text":"右、右、右……キメ……","trans":"右，右，右……收尾……"},{"id":"3020003010030","name":"円香","text":"いや、キメ\\n──こうじゃない？","trans":"不，收尾\\n——是这样吧？"},{"id":"3020003010040","name":"透","text":"こう……え？","trans":"这样……诶？"},{"id":"3020003010050","name":"円香","text":"こう\\n──なんか違う","trans":"这样\\n——好像不对"},{"id":"3020003010060","name":"透","text":"……","trans":""},{"id":"3020003010070","name":"透","text":"──てか\\n行きたすぎでしょ、右に","trans":"——倒是\\n太往右边去了吧"},{"id":"3020003010080","name":"円香","text":"知らない\\nじゃあ、左行ったら","trans":"不知道\\n那往左呢"},{"id":"3020003010090","name":"透","text":"えー\\n冷たい","trans":"诶——\\n好冷"},{"id":"3020003010100","name":"円香","text":"……もうやめとく？\\nどうせ自主練だし","trans":"……干脆不练了？\\n反正是自主练习"},{"id":"3020003010110","name":"透","text":"あー……","trans":"啊——……"},{"id":"3020003010120","name":"透","text":"──うん\\nダメだわ、なんか","trans":"——嗯\\n好像不太行"},{"id":"3020003010130","name":"透","text":"かっとばそう","trans":"打飞它吧"},{"id":"3020003010140","name":"透","text":"──よーし","trans":"——好"},{"id":"3020003010150","name":"透","text":"こい","trans":"来吧"},{"id":"3020003010160","name":"円香","text":"……","trans":""},{"id":"3020003010170","name":"透","text":"あ、くるかな","trans":"啊，来了吗"},{"id":"3020003010171","name":"透＆円香","text":"────！","trans":""},{"id":"3020003010180","name":"透","text":"やば……","trans":"不妙……"},{"id":"3020003010190","name":"円香","text":"無理じゃない？　これ","trans":"这你不行吧？"},{"id":"3020003010200","name":"透","text":"……\\nいけるいける────","trans":"……\\n可以可以————"},{"id":"3020003010210","name":"円香","text":"…………","trans":""},{"id":"3020003010220","name":"透","text":"……やばいね","trans":"……真不妙啊"},{"id":"3020003010230","name":"円香","text":"ちょ……\\nちゃんと前向いて","trans":"喂……\\n好好面朝前啊"},{"id":"3020003010240","name":"円香","text":"全然ダメじゃん","trans":"完全不行啊"},{"id":"3020003010250","name":"透","text":"あー……","trans":"啊——……"},{"id":"3020003010260","name":"円香","text":"────全然、かっとんでない","trans":"————完全没打飞"},{"id":"3020003010270","name":"円香","text":"ていうか、なんで急にこんなとこ\\n──ドラマでも観た？","trans":"倒是你怎么突然玩这个\\n——是看电视剧了？"},{"id":"3020003010280","name":"透","text":"んー……","trans":"嗯——……"},{"id":"3020003010290","name":"透","text":"なんか、そう\\nドラマ","trans":"差不多\\n电视剧"},{"id":"3020003010300","name":"透","text":"色々煮詰まっててさ、主人公たちが\\nそれでバッティ────","trans":"主角他们，纠结了很多\\n然后就去了击球————"},{"id":"3020003010310","name":"円香","text":"…………\\nいい。打つならしゃべらないで","trans":"…………\\n算了。要打就别说话"},{"id":"3020003010320","name":"透","text":"ごめんごめん\\nしゃべるわ","trans":"抱歉抱歉\\n我要说"},{"id":"3020003010330","name":"透","text":"──それでバッティングセンター行くんだよね\\nかっとばそうとか言って","trans":"————然后就去了击球场\\n然后说要打飞它"},{"id":"3020003010340","name":"円香","text":"うわ、そのまんま","trans":"呜哇，完全一致"},{"id":"3020003010350","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3020003010360","name":"円香","text":"──で、かっとぶの？","trans":"——然后呢，打飞了吗"},{"id":"3020003010370","name":"透","text":"まー、最後には\\nうん","trans":"算是吧，最后\\n嗯"},{"id":"3020003010380","name":"透","text":"途中うまくいかないんだけど\\nめっちゃ頑張って────","trans":"中间没打好\\n然后很努力————"},{"id":"3020003010390","name":"円香","text":"……","trans":""},{"id":"3020003010400","name":"透","text":"──で、かっとんで\\nハッピーエンド","trans":"——就，打飞了\\n快乐结局"},{"id":"3020003010410","name":"円香","text":"……駄作感がやばい","trans":"……这片肯定超普通"},{"id":"3020003010420","name":"透","text":"ふふふっ","trans":"呵呵呵"},{"id":"3020003010430","name":"透","text":"まー\\nけど──","trans":"算啦\\n不过"},{"id":"3020003010431","name":"透＆円香","text":"頑張らなきゃかっとばない──────","trans":"不努力就打不飞————"},{"id":"3020003010440","name":"透","text":"……\\nうん","trans":"……\\n嗯"},{"id":"3020003010450","name":"透","text":"いいこと気付いたでしょ","trans":"我注意到了很好的地方吧"},{"id":"3020003010460","name":"円香","text":"だから、打つかしゃべるかにして","trans":"所以，要打要说你选一个"},{"id":"3020003010470","name":"透","text":"あー\\nごめん","trans":"啊——\\n抱歉"},{"id":"3020003010480","name":"透","text":"……\\n帰るかー","trans":"……\\n回去吧——"},{"id":"3020003010490","name":"円香","text":"うん","trans":"嗯"},{"id":"3020003010500","name":"透","text":"出直すわ\\nダンス、キメてから","trans":"到时候再来\\n等舞练好"},{"id":"3020003010510","name":"円香","text":"……\\n目的が逆になってる","trans":"……\\n你的目的反了吧"},{"id":"3020003010520","name":"透","text":"あはは","trans":"啊哈哈"},{"id":"3020003010530","name":"透","text":"一緒でしょ","trans":"一样的吧"},{"id":"3020003010540","name":"透","text":"最後、\\nどっちもかっとんだら","trans":"最后，\\n都要打飞的"},{"id":"3020003010550","name":"円香","text":"……","trans":""}]}