{"translator":"告","rows":[{"id":"3021005030010","name":"円香","text":"…………","trans":""},{"id":"3021005030020","name":"円香","text":"なんか……あっつ……","trans":"总觉得……好热……"},{"id":"3021005030030","name":"円香","text":"ちょっと……\\n部屋、暑い","trans":"喂……\\n房间里好热"},{"id":"0000000000000","name":"透","text":"……","trans":""},{"id":"3021005030050","name":"円香","text":"エアコンの温度、下げるよ\\nいい？","trans":"我把暖气温度往下调\\n可以吧？"},{"id":"0000000000000","name":"透","text":"……","trans":""},{"id":"3021005030070","name":"円香","text":"……浅倉？","trans":"……浅仓？"},{"id":"3021005030080","name":"透","text":"………………","trans":""},{"id":"3021005030090","name":"円香","text":"…………","trans":""},{"id":"3021005030100","name":"円香","text":"……ったく","trans":"……真是"},{"id":"3021005030110","name":"円香","text":"……浅倉、浅倉","trans":"……浅仓，浅仓"},{"id":"3021005030120","name":"透","text":"…………","trans":""},{"id":"3021005030130","name":"円香","text":"起きて\\n起きないならほっとく","trans":"快醒\\n不醒就不管你了"},{"id":"3021005030140","name":"透","text":"…………","trans":""},{"id":"3021005030150","name":"円香","text":"……寝るなら、ベッド","trans":"……要睡就上床"},{"id":"3021005030160","name":"透","text":"────\\nあれ……","trans":"————\\n怪了……"},{"id":"3021005030170","name":"透","text":"……寝てた？","trans":"……我睡着了？"},{"id":"3021005030180","name":"円香","text":"…………","trans":""},{"id":"3021005030190","name":"透","text":"……映画────\\n終わったかー","trans":"……电影————\\n放完了吗——"},{"id":"3021005030200","name":"透","text":"見る？\\nつづき","trans":"要看吗？\\n继续看"},{"id":"3021005030210","name":"円香","text":"……それでもいいけど\\nなんかもう０時過ぎてるし","trans":"……倒也可以\\n不过好像已经过了0点"},{"id":"3021005030220","name":"円香","text":"ちゃんと寝たら\\n私も帰る","trans":"你睡吧\\n我也回去了"},{"id":"3021005030230","name":"透","text":"あー……","trans":"啊——……"},{"id":"3021005030240","name":"透","text":"じゃ\\n寝るわ","trans":"那\\n我睡了"},{"id":"3021005030250","name":"円香","text":"明日の予定は？　わかってる？","trans":"明天的安排？ 记得吗？"},{"id":"3021005030260","name":"透","text":"わかってるわかってる……","trans":"记得记得……"},{"id":"3021005030270","name":"円香","text":"言ってみて","trans":"说说看"},{"id":"3021005030280","name":"透","text":"あー……\\nレッスン、なんか","trans":"啊……\\n好像，有课程"},{"id":"3021005030290","name":"円香","text":"…………","trans":""},{"id":"3021005030300","name":"円香","text":"寝な、おやすみ","trans":"睡吧，晚安"},{"id":"3021005030310","name":"透","text":"はいよー……","trans":"好哦——……"},{"id":"3021005030320","name":"円香","text":"……","trans":""},{"id":"3021005030330","name":"透","text":"…………","trans":""},{"id":"3021005030340","name":"円香","text":"……","trans":""},{"id":"0000000000000","name":"off","text":"『ふうん……？　何か見てるのかな』","trans":"“嗯……？ 她在看什么吗”"},{"id":"0000000000000","name":"off","text":"『何か、ずっと見上げてる』","trans":"“好像一直在仰头看什么”"},{"id":"0000000000000","name":"off","text":"『ね、なんだろう……』","trans":"“你说，她在看什么呢”"},{"id":"3021005030350","name":"off","text":"私は、わかる","trans":"我能明白"},{"id":"3021005030360","name":"off","text":"透が何を見てるのか","trans":"透在看的是什么"},{"id":"0000000000000","name":"off","text":"『なるほどね…………』","trans":"“原来如此…………”"},{"id":"0000000000000","name":"off","text":"『見た目だけなら、あんまり使えないかなと思ったけど』","trans":"“只看外表的话，我觉得这张用不了”"},{"id":"3021005030370","name":"off","text":"私は、知ってる","trans":"我知道"},{"id":"3021005030380","name":"off","text":"透が何を秘めてるのか","trans":"透之中隐藏着什么"},{"id":"0000000000000","name":"off","text":"『み、みんな見てる……』","trans":"“大，大家都在看……”"},{"id":"0000000000000","name":"off","text":"『みんな、透ちゃん見てる……』","trans":"“大家都在看小透……”"},{"id":"3021005030390","name":"off","text":"そうだね","trans":"是啊"},{"id":"0000000000000","name":"off","text":"『みんな、見惚れてた』","trans":"“大家都看呆了”"},{"id":"0000000000000","name":"off","text":"『小糸も雛菜も、スタッフさんも』","trans":"“小糸和雏菜，还有工作人员”"},{"id":"3021005030400","name":"off","text":"私以外のみんなはね","trans":"我以外的大家都是"},{"id":"3021005030410","name":"円香","text":"『色々、考えてきたんだ？』","trans":"“你为了今天想了很多吧？”"},{"id":"3021005030420","name":"透","text":"『え？』","trans":"“诶？”"},{"id":"3021005030430","name":"off","text":"知ってる","trans":"我知道"},{"id":"3021005030440","name":"off","text":"わかってる","trans":"我明白"},{"id":"3021005030450","name":"off","text":"私だけは","trans":"只有我"},{"id":"3021005030460","name":"off","text":"浅倉透を","trans":"理解浅仓透"},{"id":"3021005030470","name":"透","text":"…………","trans":""},{"id":"0000000000000","name":"円香","text":"…………","trans":""},{"id":"3021005030490","name":"透","text":"…………\\n……あれ────","trans":"…………\\n……怪了————"},{"id":"0000000000000","name":"円香","text":"…………","trans":""},{"id":"3021005030510","name":"透","text":"……あれ\\nいるし","trans":"……咦\\n还在啊"},{"id":"3021005030520","name":"円香","text":"もう行く","trans":"要走了"},{"id":"3021005030530","name":"透","text":"やば……ふとん蹴ってるじゃん","trans":"不妙……踢棉被了"},{"id":"3021005030540","name":"透","text":"……見てた？","trans":"……看到了？"},{"id":"3021005030560","name":"円香","text":"見てない","trans":"没看到"}]}