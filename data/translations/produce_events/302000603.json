{
  "translator": "告",
  "rows": [
    {
      "id": "3020006030010",
      "name": "透",
      "text": "…………\\n────────…………",
      "trans": "…………\\n────────…………"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "ピース・オブ・エイト！",
      "trans": "Piece of eight！"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "ピース・オブ・エイト！",
      "trans": "Piece of eight"
    },
    {
      "id": "3020006030020",
      "name": "透",
      "text": "────\\n──────────",
      "trans": "────\\n──────────"
    },
    {
      "id": "3020006030030",
      "name": "透",
      "text": "──────…………\\n……あー",
      "trans": "——————…………\\n……啊——"
    },
    {
      "id": "3020006030040",
      "name": "透",
      "text": "…………\\nそっかー…………",
      "trans": "…………\\n是吗——…………"
    },
    {
      "id": "3020006030050",
      "name": "透",
      "text": "いないんだっけ、もう……\\n──────ふぁ…………",
      "trans": "已经不在了啊……\\n——————呵啊…………"
    },
    {
      "id": "3020006030060",
      "name": "雛菜",
      "text": "シャ、ケ～\\n言ってみて、シャ、ケ～！",
      "trans": "鲑，鱼～\\n说一下，鲑，鱼～"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "オキロ　ノロマ！",
      "trans": "起床 慢性子！"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "イケタライクネ！",
      "trans": "能去的话就去了！"
    },
    {
      "id": "3020006030070",
      "name": "小糸",
      "text": "じゃあ、梅は……！\\nウ、メ……！",
      "trans": "那，梅呢……！\\nme ei……！"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "アハ～！",
      "trans": "啊哈～！"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "シャケ～！",
      "trans": "鲑鱼～！"
    },
    {
      "id": "3020006030080",
      "name": "円香",
      "text": "素直じゃない",
      "trans": "真坦率"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "イガイ！",
      "trans": "意外！"
    },
    {
      "id": "3020006030090",
      "name": "円香",
      "text": "……へんなやつ",
      "trans": "……真怪"
    },
    {
      "id": "3020006030100",
      "name": "雛菜",
      "text": "でももうすぐ\\n帰っちゃうんでしょ～？",
      "trans": "不过它\\n马上要回家了吧～？"
    },
    {
      "id": "3020006030110",
      "name": "透",
      "text": "うん",
      "trans": "嗯"
    },
    {
      "id": "3020006030120",
      "name": "透",
      "text": "明日",
      "trans": "明天"
    },
    {
      "id": "3020006030130",
      "name": "小糸",
      "text": "そ、そっか……\\n結構馴れてきたんだけどな……",
      "trans": "是，是吗……\\n明明跟它混得挺熟了"
    },
    {
      "id": "3020006030140",
      "name": "透",
      "text": "ふふっ",
      "trans": "呵呵"
    },
    {
      "id": "3020006030150",
      "name": "透",
      "text": "なんか\\nそうかも",
      "trans": "好像\\n是遮掩"
    },
    {
      "id": "3020006030160",
      "name": "透",
      "text": "こいつが来てからさ",
      "trans": "这家伙来了之后啊"
    },
    {
      "id": "3020006030170",
      "name": "透",
      "text": "夢見たり、\\nずっと前のこと思い出したりするんだよね",
      "trans": "总是会做梦，\\n不然就是会想起很久以前的事"
    },
    {
      "id": "3020006030180",
      "name": "雛菜",
      "text": "どんな夢～？",
      "trans": "什么梦～？"
    },
    {
      "id": "3020006030190",
      "name": "透",
      "text": "え、んー",
      "trans": "诶，嗯——"
    },
    {
      "id": "3020006030200",
      "name": "透",
      "text": "なんか、忘れてるんだけどさ\\n起きたら",
      "trans": "好像就忘了\\n起床之后"
    },
    {
      "id": "3020006030210",
      "name": "透",
      "text": "でも",
      "trans": "可是"
    },
    {
      "id": "3020006030220",
      "name": "透",
      "text": "昔読んだことある本と\\n雰囲気が似てる",
      "trans": "感觉有点像\\n以前看过的书"
    },
    {
      "id": "3020006030230",
      "name": "小糸",
      "text": "そ、そうなんだ……",
      "trans": "这，这样啊……"
    },
    {
      "id": "3020006030240",
      "name": "小糸",
      "text": "た、楽しい感じ？\\n……悲しい感じ？",
      "trans": "很，很快乐？\\n……还是很悲伤？"
    },
    {
      "id": "3020006030250",
      "name": "透",
      "text": "んー……",
      "trans": "嗯——……"
    },
    {
      "id": "3020006030260",
      "name": "透",
      "text": "楽しい感じ\\nどっちかいうと",
      "trans": "很快乐\\n硬要说的话"
    },
    {
      "id": "3020006030270",
      "name": "円香",
      "text": "ふーん",
      "trans": "哼——"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "──────♪",
      "trans": ""
    },
    {
      "id": "3020006030290",
      "name": "円香",
      "text": "……",
      "trans": ""
    },
    {
      "id": "3020006030300",
      "name": "雛菜",
      "text": "……",
      "trans": ""
    },
    {
      "id": "3020006030310",
      "name": "小糸",
      "text": "……",
      "trans": ""
    },
    {
      "id": "3020006030320",
      "name": "透",
      "text": "おおー",
      "trans": "哦哦——"
    },
    {
      "id": "3020006030330",
      "name": "雛菜",
      "text": "風来た～",
      "trans": "风来了～"
    },
    {
      "id": "3020006030340",
      "name": "透",
      "text": "うん",
      "trans": "嗯"
    },
    {
      "id": "0000000000000",
      "name": "透",
      "text": "────あの時みたいだ",
      "trans": "————就像那时候"
    },
    {
      "id": "3020006030350",
      "name": "小糸",
      "text": "……『勝ったら見える』って言ってたの────\\n何が見えたのかな……",
      "trans": "……说是“胜利了才看得到”————\\n是能看到什么呢……"
    },
    {
      "id": "3020006030360",
      "name": "雛菜",
      "text": "え～？\\n何それ～？",
      "trans": "诶～？什么东西～？"
    },
    {
      "id": "3020006030370",
      "name": "円香",
      "text": "あんなの\\nそれらしいこと言ってるだけ",
      "trans": "那种话\\n就只是在敷衍而已"
    },
    {
      "id": "3020006030380",
      "name": "小糸",
      "text": "そ、そっか……",
      "trans": "原、原来是这样……"
    },
    {
      "id": "3020006030390",
      "name": "透",
      "text": "見たいの、\\n小糸ちゃん",
      "trans": "想看吗，\\n小糸"
    },
    {
      "id": "3020006030400",
      "name": "小糸",
      "text": "……！\\nえ……う……",
      "trans": "……！\\n诶……呜……"
    },
    {
      "id": "3020006030410",
      "name": "小糸",
      "text": "そういうのが……\\nほ、ほんとにあるんだったら……",
      "trans": "如果……\\n真，真的有那种东西的话……"
    },
    {
      "id": "3020006030420",
      "name": "雛菜",
      "text": "勝ってないからね～",
      "trans": "因为还没有赢嘛～"
    },
    {
      "id": "3020006030430",
      "name": "小糸",
      "text": "そ、そうだね…………",
      "trans": "是，是啊……"
    },
    {
      "id": "3020006030440",
      "name": "透",
      "text": "────じゃ、お別れ会終了ー",
      "trans": "————那，送别会结束——"
    },
    {
      "id": "3020006030450",
      "name": "透",
      "text": "色々ありがと\\n鳥",
      "trans": "谢谢你\\n鸟"
    },
    {
      "id": "3020006030460",
      "name": "透",
      "text": "みなさんも\\nまたご縁がありましたら",
      "trans": "各位也是\n如果以后还有缘分的话"
    },
    {
      "id": "3020006030470",
      "name": "円香",
      "text": "今度は\\nまともな言葉、覚えてきて",
      "trans": "下次\\n要学一些正常的词语"
    },
    {
      "id": "3020006030480",
      "name": "雛菜",
      "text": "シャケ、忘れないでね～？",
      "trans": "不要忘了鲑鱼哦～？"
    },
    {
      "id": "3020006030490",
      "name": "小糸",
      "text": "ば、ばいばい、オウムさん",
      "trans": "拜，拜拜，鹦鹉"
    },
    {
      "id": "0000000000000",
      "name": "オウム",
      "text": "アー……\\nンー……",
      "trans": "啊——……\\n嗯——……"
    },
    {
      "id": "3020006030500",
      "name": "透",
      "text": "ダメだこりゃ",
      "trans": "这没救啦"
    },
    {
      "id": "3020006030510",
      "name": "透",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "3020006030520",
      "name": "透",
      "text": "そういえば\\n聞きそびれたんだよね、おまえに",
      "trans": "说起来\\n忘了问你了"
    },
    {
      "id": "3020006030530",
      "name": "透",
      "text": "────…………",
      "trans": ""
    },
    {
      "id": "3020006030540",
      "name": "透",
      "text": "……あ、知ってる？\\n『ピース・オブ・エイト』って言葉",
      "trans": "……啊，你们知道吗？\\n“Piece of eight”这个短语"
    },
    {
      "id": "3020006030550",
      "name": "小糸",
      "text": "……？",
      "trans": ""
    },
    {
      "id": "3020006030560",
      "name": "透",
      "text": "鳴くじゃん、こいつ\\n時々",
      "trans": "这家伙在喊的\\n有时候"
    },
    {
      "id": "3020006030570",
      "name": "円香",
      "text": "……？\\n知らない",
      "trans": "……？\\n不知道"
    },
    {
      "id": "3020006030580",
      "name": "透",
      "text": "あれ",
      "trans": "怪了"
    },
    {
      "id": "3020006030590",
      "name": "雛菜",
      "text": "聞いたことない～\\n何それ～",
      "trans": "没听过～\\n那是什么～"
    },
    {
      "id": "3020006030600",
      "name": "透",
      "text": "…………\\nなんなんだっけ、それ",
      "trans": "…………\\n那个到底是什么"
    },
    {
      "id": "3020006030610",
      "name": "透",
      "text": "知ってる気は\\nするんだけど",
      "trans": "总觉得\\n好像知道"
    }
  ]
}