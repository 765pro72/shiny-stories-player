{
  "translator": "楚西瑜",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──……\\nなんだっけ、この曲",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "んーんーん……──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あれ\\n凛世、来てたのか",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──どうしたんだ？",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040010",
      "name": "凛世",
      "text": "──プロデューサーさま……！\\nお疲れ様で……ございます……",
      "trans": "——制作人大人……！\\n您……辛苦了……"
    },
    {
      "id": "2012009040020",
      "name": "凛世",
      "text": "あの──\\n────蝶が……",
      "trans": "那个——\\n————有蝴蝶……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あ、ほんとだ。迷って入ってきちゃったのか\\nええと──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんか、ビニール袋とか……\\nかぶせられるもの……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040030",
      "name": "凛世",
      "text": "──こちらでは……\\nいかがでしょう……",
      "trans": "——用这个……\\n怎么样……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おっ、菓子箱か\\nいいかもしれない！",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──よっ……\\nよーし、もう大丈夫だぞー",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040040",
      "name": "凛世",
      "text": "…………\\nふふっ……",
      "trans": "…………\\n哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん、外に放そ──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ああ……\\nあの曲か……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040050",
      "name": "凛世",
      "text": "プロデューサーさま……？",
      "trans": "制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？　いや──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "select",
      "name": "",
      "text": "──驚いてるかな、\\nこの蝶",
      "trans": "——这只蝴蝶\\n是不是被吓到了"
    },
    {
      "id": "select",
      "name": "",
      "text": "──窓から放そうか",
      "trans": "——这只蝴蝶\\n是不是被吓到了"
    },
    {
      "id": "select",
      "name": "",
      "text": "──なんて蝶かな？",
      "trans": "——这只蝴蝶\\n是不是被吓到了"
    },
    {
      "id": "2012009040060",
      "name": "凛世",
      "text": "ふふ……\\n『ここは……どこだろう……』と……",
      "trans": "哼哼……\\n它在说……“这里是……什么地方……”"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "だよなぁ\\nよしよし、もう心配ないからな──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──それっ\\n行ったか……？",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040070",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012009040080",
      "name": "凛世",
      "text": "────蝶は……\\n月を頼りに飛ぶ……",
      "trans": "————蝴蝶……\\n借着月色去了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040090",
      "name": "凛世",
      "text": "凛世も……\\n同じような……心持ちでございます……",
      "trans": "凛世也……\\n有着……同样的心情……"
    },
    {
      "id": "2012009040100",
      "name": "凛世",
      "text": "プロデューサーさまの……\\nお導きが……あればこそ……",
      "trans": "正因为……\\n有制作人大人的……指引……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──はは、そうやって言われるくらい\\n役に立ててるといいんだけど",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世、不思議だよ",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺は時々、\\n逆みたいに感じる時があるから",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──なんとなくもの悲しい曲だよな",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040110",
      "name": "凛世",
      "text": "……？",
      "trans": "……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、いや……\\nいい道案内しないとなって",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "な？",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040120",
      "name": "凛世",
      "text": "プロデューサーさま……？",
      "trans": "制作人大人……？"
    },
    {
      "id": "2012009040130",
      "name": "凛世",
      "text": "──ふふっ……",
      "trans": "——哼哼……"
    },
    {
      "id": "2012009040140",
      "name": "凛世",
      "text": "今宵は……\\n不思議な……プロデューサーさま……",
      "trans": "今晚的……\\n制作人大人……真是不可思议呢……"
    },
    {
      "id": "2012009040150",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012009040160",
      "name": "凛世",
      "text": "──ほら……\\nお帰り……",
      "trans": "——乖……\\n请回吧……"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "────……\\n……えい",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……閉めとかなきゃな\\nまた迷っちゃったら、かわいそうだ",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040180",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012009040190",
      "name": "凛世",
      "text": "────きっと……\\n迷いたい時も……あるのでしょう……",
      "trans": "————想要迷路的时候……\\n一定……也是会有的吧……"
    },
    {
      "id": "2012009040200",
      "name": "凛世",
      "text": "──……いえ……",
      "trans": "——……不……"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "────……\\n……えい",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ……\\nうん、確かにそういう時もあるかもしれないな",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "でもやっぱり、帰してあげなきゃ",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040220",
      "name": "凛世",
      "text": "……帰して……──\\n──はい……",
      "trans": "……回去……——\\n——嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（んーんーん……──）",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんだろうな……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（なんでこれ、\\n耳から離れないんだろうな）",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040230",
      "name": "凛世",
      "text": "アゲハ……でしょうか……\\n正しい名までは……",
      "trans": "应该是……凤蝶吧……\\n具体的名字就……"
    },
    {
      "id": "2012009040240",
      "name": "凛世",
      "text": "──ふふ……\\n綺麗な……水色……",
      "trans": "——哼哼……\\n漂亮的……水色……"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "──はい……\\nジャケットには──",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "『────』と……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040270",
      "name": "凛世",
      "text": "プロデューサーさま……？",
      "trans": "制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？　あ、すまん\\n──じゃあ、名前付けちゃうか！",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040280",
      "name": "凛世",
      "text": "……ふふっ\\n名前を……？",
      "trans": "……哼哼，\\n起名字……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん\\n『ミズイロアゲハ』とか、どうだ！",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040290",
      "name": "凛世",
      "text": "みずいろ……あげは……",
      "trans": "水色……凤蝶……"
    },
    {
      "id": "0000000000000",
      "name": "凛世",
      "text": "────\\nどぅ、どぅ……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040310",
      "name": "凛世",
      "text": "美しい……\\n名前でございます……",
      "trans": "这名字……\\n真美……"
    },
    {
      "id": "2012009040320",
      "name": "凛世",
      "text": "みずいろ……あげは……\\n…………────",
      "trans": "水色……凤蝶……\\n"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "水色っていうより、ブルーって感じなんだ……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040330",
      "name": "凛世",
      "text": "プロデューサーさま……？",
      "trans": "制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──……ああ\\nはは、何度もごめんな",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それじゃ、そろそろさよならしようか",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "2012009040340",
      "name": "凛世",
      "text": "──……\\nはい……",
      "trans": "——……\\n嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "どぅ、どぅ……",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（……あれ）",
      "trans": "——……\\n这首曲子是"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（また鳴りはじめた）",
      "trans": "——……\\n这首曲子是"
    }
  ]
}