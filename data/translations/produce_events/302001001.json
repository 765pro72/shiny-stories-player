{
  "translator": "Simizu1",
  "rows": [
    {
      "id": "3020010010010",
      "name": "透",
      "text": "あー……",
      "trans": "啊—……"
    },
    {
      "id": "3020010010020",
      "name": "透",
      "text": "んー……",
      "trans": "嗯—……"
    },
    {
      "id": "3020010010030",
      "name": "雛菜",
      "text": "……？",
      "trans": ""
    },
    {
      "id": "3020010010040",
      "name": "透",
      "text": "あー\\n……っつ",
      "trans": "好—\\n……热"
    },
    {
      "id": "3020010010050",
      "name": "透",
      "text": "ちょ……休も",
      "trans": "稍……歇一会吧"
    },
    {
      "id": "3020010010060",
      "name": "小糸",
      "text": "じ、事務所、すぐそこだよ……！",
      "trans": "马、马上就到事务所了哦……！"
    },
    {
      "id": "3020010010070",
      "name": "雛菜",
      "text": "雛菜、影入ろ～",
      "trans": "雏菜，要躲在影子下面~"
    },
    {
      "id": "3020010010080",
      "name": "小糸",
      "text": "え……！\\nこ、ここにいる方が暑いん────",
      "trans": "诶……！\\n待、待在这里比较热———"
    },
    {
      "id": "3020010010090",
      "name": "円香",
      "text": "……お先",
      "trans": "……先走一步"
    },
    {
      "id": "3020010010100",
      "name": "小糸",
      "text": "ぴぇ……！",
      "trans": "噫……！"
    },
    {
      "id": "3020010010110",
      "name": "透",
      "text": "ふぁ……\\nやばいって、歩くの",
      "trans": "呼啊……\\n真累啊，走路"
    },
    {
      "id": "3020010010120",
      "name": "透",
      "text": "来ないし、風とか\\nなんにも────",
      "trans": "也不会来，风什么的\\n什么都没———"
    },
    {
      "id": "3020010010121",
      "name": "一同",
      "text": "──────",
      "trans": ""
    },
    {
      "id": "3020010010130",
      "name": "雛菜",
      "text": "来た～",
      "trans": "来了~"
    },
    {
      "id": "3020010010140",
      "name": "小糸",
      "text": "う、うん……！\\n風があるうちに行こ────",
      "trans": "嗯，嗯……！\\n趁着有风快走吧———"
    },
    {
      "id": "3020010010150",
      "name": "透",
      "text": "────っ",
      "trans": "————！"
    },
    {
      "id": "3020010010160",
      "name": "雛菜",
      "text": "へ～？",
      "trans": "诶~？"
    },
    {
      "id": "3020010010170",
      "name": "透",
      "text": "やばい……",
      "trans": "糟糕……"
    },
    {
      "id": "3020010010180",
      "name": "小糸",
      "text": "だ、大丈夫……？\\n何か、目に入った……？",
      "trans": "没，没事吧……？\\n眼睛里，进什么东西了吗……？"
    },
    {
      "id": "3020010010190",
      "name": "円香",
      "text": "……",
      "trans": ""
    },
    {
      "id": "3020010010200",
      "name": "透",
      "text": "うん……\\n虫",
      "trans": "嗯……\\n虫子"
    },
    {
      "id": "3020010010210",
      "name": "透",
      "text": "虫入った……！",
      "trans": "进虫子了……！"
    },
    {
      "id": "3020010010211",
      "name": "円香＆小糸＆雛菜",
      "text": "……！",
      "trans": ""
    },
    {
      "id": "3020010010220",
      "name": "透",
      "text": "ブゥ……ン",
      "trans": "嗡…… "
    },
    {
      "id": "3020010010230",
      "name": "透",
      "text": "んあー……\\nくるねー────",
      "trans": "啊—……\\n起效了呢——"
    },
    {
      "id": "3020010010240",
      "name": "小糸",
      "text": "と、透ちゃん……\\nきてないと思うよ……！",
      "trans": "小，小透……\\n我觉得还没起效哦……！"
    },
    {
      "id": "3020010010250",
      "name": "小糸",
      "text": "目、閉じるの早くて……",
      "trans": "眼睛，闭上得太早了……"
    },
    {
      "id": "3020010010260",
      "name": "雛菜",
      "text": "あは～\\n目薬、全部こぼれちゃったね～",
      "trans": "啊哈~眼药水，全都滴到外面去了呢~"
    },
    {
      "id": "3020010010270",
      "name": "小糸",
      "text": "う、うん……",
      "trans": "嗯，嗯……"
    },
    {
      "id": "3020010010280",
      "name": "小糸",
      "text": "もう一回差そっか……！\\nはい、目、開け────",
      "trans": "再滴一次吧……！\\n好，睁开眼睛——"
    },
    {
      "id": "3020010010290",
      "name": "透",
      "text": "んー……！",
      "trans": "嗯—……！"
    },
    {
      "id": "3020010010300",
      "name": "透",
      "text": "入る、口にー……\\n目薬……",
      "trans": "跑到，嘴里了—……\\n眼药水……"
    },
    {
      "id": "3020010010310",
      "name": "小糸",
      "text": "ぴぇ……！",
      "trans": "噫……！"
    },
    {
      "id": "3020010010320",
      "name": "円香",
      "text": "……いいんじゃない。よく効きそう",
      "trans": "……不也挺好的吗。感觉会起效"
    },
    {
      "id": "3020010010330",
      "name": "雛菜",
      "text": "雛菜のティッシュ使っていいよ～",
      "trans": "可以用雏菜的纸巾哦~"
    },
    {
      "id": "3020010010340",
      "name": "小糸",
      "text": "ひ、雛菜ちゃん……\\n透ちゃん見えてないから取ってあげないと……！",
      "trans": "小，小雏菜……\\n小透现在看不到，得给她拿过去才行……！"
    },
    {
      "id": "3020010010350",
      "name": "透",
      "text": "んー……！",
      "trans": "嗯—……！"
    },
    {
      "id": "3020010010360",
      "name": "小糸",
      "text": "く、口閉じて……！　透ちゃん……！",
      "trans": "闭、闭上嘴……！小透……！"
    },
    {
      "id": "3020010010370",
      "name": "透",
      "text": "んー…………！",
      "trans": "嗯—…………！"
    },
    {
      "id": "3020010010380",
      "name": "透",
      "text": "ブゥ……ン",
      "trans": "嗡……"
    },
    {
      "id": "3020010010390",
      "name": "小糸",
      "text": "……\\nこ、これ、まつ毛なんじゃないかな……",
      "trans": "……\\n这、这个，应该是睫毛吧……"
    },
    {
      "id": "3020010010400",
      "name": "透",
      "text": "……え？",
      "trans": "……诶？"
    },
    {
      "id": "3020010010410",
      "name": "雛菜",
      "text": "マスカラつけてなくてよかったね～\\nもっと痛かったかも～",
      "trans": "涂了睫毛膏真是太好了呢~\\n不然可能会更疼呢~"
    },
    {
      "id": "3020010010420",
      "name": "透",
      "text": "え\\n虫でしょ？",
      "trans": "诶\\n是虫子吧？"
    },
    {
      "id": "3020010010430",
      "name": "円香",
      "text": "まつ毛でしょ",
      "trans": "是睫毛吧"
    },
    {
      "id": "3020010010440",
      "name": "透",
      "text": "えー……",
      "trans": "诶—……"
    },
    {
      "id": "3020010010450",
      "name": "透",
      "text": "来たんだって、虫",
      "trans": "因为来了啊，虫子"
    },
    {
      "id": "3020010010460",
      "name": "透",
      "text": "めっちゃ\\nがー……って",
      "trans": "超凶\\n嗡—……地"
    },
    {
      "id": "3020010010461",
      "name": "円香＆小糸＆雛菜",
      "text": "……",
      "trans": ""
    },
    {
      "id": "3020010010470",
      "name": "透",
      "text": "見て",
      "trans": "快看"
    },
    {
      "id": "3020010010480",
      "name": "円香",
      "text": "ん……",
      "trans": "嗯……"
    },
    {
      "id": "3020010010490",
      "name": "透",
      "text": "見て",
      "trans": "快看"
    },
    {
      "id": "3020010010500",
      "name": "雛菜",
      "text": "ん～",
      "trans": "嗯~"
    },
    {
      "id": "3020010010510",
      "name": "透",
      "text": "見てって",
      "trans": "都说了快看"
    },
    {
      "id": "3020010010520",
      "name": "小糸",
      "text": "う、うん……\\n……えっと────",
      "trans": "嗯，嗯……\\n……那个————"
    },
    {
      "id": "3020010010530",
      "name": "小糸",
      "text": "い、異常なし……！",
      "trans": "一，一切正常……！"
    },
    {
      "id": "3020010010540",
      "name": "透",
      "text": "えー……",
      "trans": "诶—……"
    },
    {
      "id": "3020010010550",
      "name": "透",
      "text": "入ったんだって\\nもー……",
      "trans": "都说了进去了\\n真是的—……"
    },
    {
      "id": "3020010010560",
      "name": "透",
      "text": "……じゃー",
      "trans": "……那—"
    },
    {
      "id": "3020010010570",
      "name": "透",
      "text": "行ったのか\\nどっか",
      "trans": "是跑掉了吗\\n跑到哪里"
    },
    {
      "id": "3020010010580",
      "name": "透",
      "text": "入った後",
      "trans": "进去之后"
    },
    {
      "id": "3020010010590",
      "name": "透",
      "text": "ブゥ……ン！！",
      "trans": "嗡……！！"
    },
    {
      "id": "3020010010600",
      "name": "円香",
      "text": "……\\n虫、お疲れー",
      "trans": "……\\n虫子，辛苦了—"
    },
    {
      "id": "3020010010610",
      "name": "小糸",
      "text": "こ、今度は目に入らないでねー……",
      "trans": "下，下次别再跑进眼睛里了哦—……"
    },
    {
      "id": "3020010010620",
      "name": "雛菜",
      "text": "あは～\\nもっと休んでったらよかったのにね～",
      "trans": "啊哈~\\n明明再休息一会就好了呢~"
    },
    {
      "id": "3020010010630",
      "name": "透",
      "text": "すごい勢いで来た\\nあの虫は",
      "trans": "猛地扎了过来\\n那只虫子"
    },
    {
      "id": "3020010010640",
      "name": "透",
      "text": "んー……",
      "trans": "嗯—……"
    },
    {
      "id": "3020010010650",
      "name": "透",
      "text": "目の後ろを突き破って",
      "trans": "穿破了眼睛的后面"
    },
    {
      "id": "3020010010660",
      "name": "透",
      "text": "頭の後ろを突き破って",
      "trans": "穿破了脑袋的后面"
    },
    {
      "id": "3020010010670",
      "name": "透",
      "text": "前見ろー",
      "trans": "看前面—"
    },
    {
      "id": "3020010010680",
      "name": "透",
      "text": "もう\\nずっとずっと",
      "trans": "已经飞到了\\n很远很远"
    },
    {
      "id": "3020010010690",
      "name": "透",
      "text": "ずっと遠くに\\n飛んでいってしまった",
      "trans": "很远的地方"
    },
    {
      "id": "3020010010700",
      "name": "透",
      "text": "の\\nかもしれない",
      "trans": "或许是这样"
    },
    {
      "id": "3020010010710",
      "name": "透",
      "text": "太陽を\\n飛び越して",
      "trans": "飞越了\\n太阳"
    },
    {
      "id": "3020010010720",
      "name": "透",
      "text": "ふぁ……",
      "trans": "呼啊……"
    },
    {
      "id": "3020010010730",
      "name": "透",
      "text": "……ゆっくりいけー",
      "trans": "……慢慢飞吧—"
    },
    {
      "id": "3020010010740",
      "name": "透",
      "text": "置いてくなよ",
      "trans": "别丢下我啊"
    }
  ]
}