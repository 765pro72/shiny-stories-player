{"translator":"煉金術式","rows":[{"id":"3025017020010","name":"にちか","text":"美琴さんっ！","trans":"美琴姐！"},{"id":"3025017020020","name":"美琴","text":"大丈夫","trans":"交给我"},{"id":"3025017020030","name":"美琴","text":"捕まえた","trans":"抓住你了"},{"id":"3025017020040","name":"にちか","text":"あ……はは……さすが──……","trans":"啊……哈哈……真不愧是──……"},{"id":"3025017020050","name":"にちか","text":"遠くまで来ちゃいましたね","trans":"一不小心就跑太远了呢"},{"id":"3025017020060","name":"美琴","text":"そうだね","trans":"是啊"},{"id":"3025017020070","name":"にちか","text":"…………","trans":""},{"id":"3025017020080","name":"にちか","text":"……っ、すみません\\n最近、あんまり眠れてなくて……！","trans":"……对不起\\n可能是因为最近没怎么睡好……！"},{"id":"3025017020090","name":"美琴","text":"帰ろうか","trans":"回去吧"},{"id":"3025017020100","name":"にちか","text":"はい……","trans":"好……"},{"id":"3025017020110","name":"にちか","text":"今日、満月なのに……\\n少ないですね、羊","trans":"今天明明是满月……\\n却没见到几只羊呢"},{"id":"3025017020120","name":"美琴","text":"待って","trans":"等等"},{"id":"3025017020130","name":"美琴","text":"今、羊の鳴き声が────","trans":"刚才听见羊的叫声────"},{"id":"3025017020140","name":"にちか","text":"え────…………","trans":"诶────…………"},{"id":"3025017020150","name":"美琴","text":"上！","trans":"上面！"},{"id":"3025017020160","name":"にちか","text":"……っ！","trans":"……！"},{"id":"3025017020170","name":"にちか","text":"あれ、って……","trans":"难道是……"},{"id":"3025017020180","name":"にちか","text":"迷い羊の────群れっ！？","trans":"迷途羊群的────大部队！？"},{"id":"3025017020190","name":"美琴","text":"行こう、急がないと","trans":"快走吧，要是不抓紧——"},{"id":"3025017020200","name":"美琴","text":"街が、眠れなくなる","trans":"整座城市都会失眠的"},{"id":"3025017020210","name":"にちか","text":"でも、こんな大群────\\n見たことない……！","trans":"但是这么庞大的羊群────\\n从来没见过……！"},{"id":"3025017020220","name":"美琴","text":"いつも通りの魔法ができれば\\n大丈夫","trans":"只要使出平时的魔法\\n就没问题"},{"id":"3025017020230","name":"美琴","text":"先に行くね\\n準備ができたら来て","trans":"我先走一步\\n准备好了就跟上来"},{"id":"3025017020240","name":"にちか","text":"美琴さん……\\nめちゃくちゃ、落ち着いてる──……","trans":"美琴姐……\\n也太临危不乱了──……"},{"id":"3025017020250","name":"にちか","text":"…………","trans":""},{"id":"3025017020260","name":"にちか","text":"私も、行かなきゃ……！","trans":"我也要跟上了……！"},{"id":"3025017020270","name":"にちか","text":"美琴さん！\\n────いけますっ！","trans":"美琴姐！\\n────我准备好了！"},{"id":"3025017020280","name":"美琴","text":"私が先頭になるフォーメーションで","trans":"那就我来打头阵"},{"id":"3025017020290","name":"にちか","text":"はい！　サポートします！","trans":"了解！支援就交给我！"},{"id":"3025017020300","name":"美琴","text":"離れるよ","trans":"要分开了"},{"id":"3025017020310","name":"美琴","text":"カウント────１、２、３、４","trans":"倒数────1、2、3、4"},{"id":"3025017020311","name":"にちか＆美琴","text":"５、６、７、８────","trans":"5、6、7、8────"},{"id":"3025017020320","name":"にちか","text":"発動、した────","trans":"魔法，发动了────"},{"id":"3025017020330","name":"にちか","text":"あはは……すごい……","trans":"啊哈哈……好厉害……"},{"id":"3025017020340","name":"にちか","text":"迷い羊が、ついてくる……！","trans":"迷途的羊群，都跟上来了……！"},{"id":"3025017020350","name":"美琴","text":"まだ終わっていないよ","trans":"还没结束"},{"id":"3025017020360","name":"美琴","text":"街を回って\\n羊を返していかなきゃ","trans":"还要绕城一周\\n把羊群都送回去才算结束"},{"id":"3025017020370","name":"にちか","text":"……長い夜になりそうですね","trans":"……看来会是个漫长的夜晚呢"},{"id":"3025017020380","name":"美琴","text":"うん","trans":"嗯"},{"id":"3025017020390","name":"美琴","text":"でも、魔法少女って、そういうものだから","trans":"不过这就是魔法少女的存在意义"},{"id":"3025017020400","name":"美琴","text":"誰も見ていないところで\\n人に夢を与えるの","trans":"在无人知晓的角落\\n为人们编织梦境"},{"id":"3025017020410","name":"にちか","text":"……はい","trans":"……是的"},{"id":"3025017020420","name":"にちか","text":"お供しますね\\n……これからも","trans":"我会一直陪您的\\n……今后也是"},{"id":"3025017020430","name":"美琴","text":"お疲れ様","trans":"辛苦了"},{"id":"3025017020440","name":"にちか","text":"お疲れ様でした","trans":"辛苦啦"},{"id":"3025017020450","name":"にちか","text":"空、明るくなってきましたね……","trans":"天空，都开始泛白了……"},{"id":"3025017020460","name":"にちか","text":"…………","trans":""},{"id":"3025017020470","name":"にちか","text":"すみません……\\nまた、あくび──","trans":"对不起……\\n又打哈欠了──"},{"id":"3025017020480","name":"美琴","text":"この子","trans":"这一只"},{"id":"3025017020490","name":"美琴","text":"あなたの迷い羊でしょう？","trans":"是你的迷途之羊吧？"},{"id":"3025017020500","name":"にちか","text":"あ……！","trans":"啊……！"},{"id":"3025017020510","name":"美琴","text":"帰ろうか","trans":"回去吧"},{"id":"3025017020520","name":"にちか","text":"はい……","trans":"好……"},{"id":"3025017020530","name":"美琴","text":"夜が明けるね","trans":"天要亮了"}]}