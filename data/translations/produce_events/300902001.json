{"translator":"gpt-4o-2024-05-13（社区机翻，未人工审核）","ai":true,"aiHash":"bca31e3","rows":[{"id":"3009020010010","name":"果穂","text":"…………","trans":"…………"},{"id":"3009020010020","name":"樹里","text":"はー……暑いな","trans":"哈……真热啊"},{"id":"3009020010030","name":"凛世","text":"はい……","trans":"是啊……"},{"id":"3009020010040","name":"樹里","text":"冷たい飲み物欲しいわ","trans":"想喝点冷饮"},{"id":"3009020010050","name":"凛世","text":"入れましょう……\\n氷も……たくさん……","trans":"我去准备吧……\\n冰块……多放点……"},{"id":"3009020010060","name":"樹里","text":"な","trans":"嗯"},{"id":"3009020010070","name":"樹里","text":"……ッ！","trans":"……！"},{"id":"3009020010080","name":"凛世","text":"……？","trans":"……？"},{"id":"3009020010090","name":"凛世","text":"樹里さん……？","trans":"樹里姐……？"},{"id":"3009020010100","name":"樹里","text":"果穂が寝てる","trans":"果穂睡着了"},{"id":"3009020010110","name":"凛世","text":"……！","trans":"……！"},{"id":"3009020010120","name":"凛世","text":"静かに……\\n参りましょう……","trans":"小声点……\\n我们走吧……"},{"id":"3009020010130","name":"樹里","text":"おう","trans":"嗯"},{"id":"3009020010131","name":"樹里＆凛世","text":"…………","trans":"…………"},{"id":"3009020010140","name":"果穂","text":"…………","trans":"…………"},{"id":"3009020010150","name":"樹里","text":"……起こしてないっぽいな","trans":"……好像没吵醒她"},{"id":"3009020010160","name":"凛世","text":"はい……","trans":"是的……"},{"id":"3009020010170","name":"樹里","text":"凛世","trans":"凛世"},{"id":"3009020010180","name":"凛世","text":"凛世は……\\nタオルケットを……","trans":"我来给她盖上……\\n毯子……"},{"id":"3009020010190","name":"樹里","text":"サンキュ\\nアタシはエアコン見てくるよ","trans":"谢谢\\n我去看看空调"},{"id":"3009020010200","name":"凛世","text":"果穂さん……\\nタオルケットを……おかけしますね……","trans":"果穂……\\n我给你盖上毯子哦……"},{"id":"3009020010210","name":"凛世","text":"…………","trans":"…………"},{"id":"3009020010220","name":"凛世","text":"……ふふ","trans":"……呵呵"},{"id":"3009020010230","name":"樹里","text":"少しだけ温度上げてきた\\nアタシらは飲み物で調整するか","trans":"我把温度调高了一点\\n我们用冷饮来降温吧"},{"id":"3009020010240","name":"凛世","text":"はい……","trans":"好的……"},{"id":"3009020010250","name":"樹里","text":"凛世は何にする？","trans":"凛世你要喝什么？"},{"id":"3009020010260","name":"樹里","text":"麦茶とウーロン茶は冷えてるやつある","trans":"有冰镇麦茶和乌龙茶"},{"id":"3009020010270","name":"樹里","text":"後は、アイスティーとアイスコーヒー、作れるかな","trans":"另外，冰红茶和冰咖啡也可以现做"},{"id":"3009020010280","name":"凛世","text":"では……\\n麦茶を……","trans":"那我就……\\n麦茶吧……"},{"id":"3009020010290","name":"樹里","text":"了解\\nアタシも麦茶かな","trans":"了解\\n我也喝麦茶"},{"id":"3009020010300","name":"樹里","text":"やっぱりこの時期、\\nなんか飲みたくなんだよなぁ……","trans":"这时候，总是想喝点什么……"},{"id":"3009020010310","name":"凛世","text":"ふふ……\\nはい……","trans":"呵呵……\\n是的……"},{"id":"3009020010320","name":"樹里","text":"コップサンキュな\\n氷入れるよ","trans":"谢谢你准备杯子\\n我来加冰"},{"id":"3009020010330","name":"凛世","text":"いえ……\\n樹里さんも……ありがとうございます……","trans":"不客气……\\n樹里姐……也谢谢你……"},{"id":"3009020010331","name":"樹里＆凛世","text":"…………","trans":"…………"},{"id":"3009020010332","name":"樹里＆凛世","text":"あははっ","trans":"哈哈哈"},{"id":"3009020010333","name":"樹里＆凛世","text":"……！","trans":"……！"},{"id":"3009020010340","name":"凛世","text":"……","trans":"……"},{"id":"3009020010350","name":"凛世","text":"大丈夫でございます……","trans":"没关系的……"},{"id":"3009020010360","name":"樹里","text":"…………\\nあぶねー……","trans":"…………\\n好险……"},{"id":"3009020010370","name":"樹里","text":"時間までは寝かせてあげたいからなー","trans":"我想让果穂多睡一会儿"},{"id":"3009020010380","name":"凛世","text":"はい……\\nお疲れなのでしょう……","trans":"是的……\\n她一定很累了……"},{"id":"3009020010390","name":"果穂","text":"…………","trans":"…………"},{"id":"3009020010400","name":"樹里","text":"……","trans":"……"},{"id":"3009020010410","name":"樹里","text":"忘れてるわけじゃねーんだけどさ\\n果穂って小学生なんだよな","trans":"我知道她是小学生，但总会忘记\\n果穂还在成长，体力和肌肉力量\\n可能还不如我们"},{"id":"3009020010420","name":"樹里","text":"身体もまだ成長途中だし、体力とか筋力だって、\\nたぶんアタシらよりまだ付きづらくてさ","trans":"她的身体也还在发育中，体力和肌肉力量\\n可能还比不上我们"},{"id":"3009020010430","name":"凛世","text":"はい……\\nですが……","trans":"是的……\\n不过……"},{"id":"3009020010440","name":"凛世","text":"凛世たちと……\\n同じだけの……レッスンを……","trans":"她和我们一样……\\n在进行同样的……训练……"},{"id":"3009020010450","name":"樹里","text":"なー","trans":"是啊"},{"id":"3009020010460","name":"樹里","text":"すげーよ、果穂は","trans":"果穂真厉害"},{"id":"3009020010470","name":"凛世","text":"はい……","trans":"是的……"},{"id":"3009020010480","name":"果穂","text":"んー…………","trans":"嗯…………"},{"id":"3009020010481","name":"樹里＆凛世","text":"……！","trans":"……！"},{"id":"3009020010482","name":"樹里＆凛世","text":"…………","trans":"…………"},{"id":"3009020010490","name":"果穂","text":"…………","trans":"…………"},{"id":"3009020010500","name":"樹里","text":"……しばらく静かにしてるか","trans":"……我们再静静地待一会儿吧"},{"id":"3009020010510","name":"凛世","text":"賛成です……","trans":"赞成……"},{"id":"3009020010520","name":"樹里","text":"…………","trans":"…………"},{"id":"0000000000000","name":"凛世","text":"…………","trans":"…………"},{"id":"3009020010540","name":"果穂","text":"……………………","trans":"……………………"}]}