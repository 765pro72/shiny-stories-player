{"translator":"魚見","rows":[{"id":"2020010010010","name":"透","text":"────ねぇ","trans":"————哎"},{"id":"2020010010020","name":"透","text":"ねぇ\\n私は？　じゃ","trans":"哎\\n我呢？　那"},{"id":"2020010010030","name":"透","text":"形？　線？","trans":"形状？　线条？"},{"id":"2020010010040","name":"透","text":"────色？","trans":"————颜色？"},{"id":"0000000000000","name":"スポンサー企業広報","text":"────２８３さん","trans":"————283的"},{"id":"0000000000000","name":"プロデューサー","text":"────えっ","trans":"————诶"},{"id":"0000000000000","name":"スポンサー企業広報","text":"ふふっ、どうされました？\\n……もう出てくる頃ですよ、浅倉ちゃん","trans":"呵呵，你怎么了？\\n……正要出场了哟，浅仓"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……！　ありがとうございます\\nちょっとぼんやりしてしまって────","trans":"啊啊……！　谢谢提醒\\n稍微走了下神————"},{"id":"0000000000000","name":"プロデューサー","text":"──────……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"形\\n線","trans":"形状\\n线条"},{"id":"0000000000000","name":"プロデューサー","text":"色","trans":"颜色"},{"id":"0000000000000","name":"プロデューサー","text":"──────透は……","trans":"——————透是……"},{"id":"0000000000000","name":"プロデューサー","text":"……えっ","trans":"……诶"},{"id":"2020010010050","name":"透","text":"──えっ","trans":"——诶"},{"id":"0000000000000","name":"プロデューサー","text":"えっと……\\n何やってるんだ？","trans":"呃呃……\\n你在这干嘛？"},{"id":"2020010010060","name":"透","text":"え？\\n……休憩？","trans":"诶？\\n……休息？"},{"id":"0000000000000","name":"プロデューサー","text":"休憩……はいいんだけど、\\nそんな電気も点けないで────","trans":"休息……是可以啦，\\n为什么关着灯————"},{"id":"2020010010070","name":"透","text":"えー\\nいい感じだったのに、映画館","trans":"诶——\\n明明还感觉不错的，电影院"},{"id":"0000000000000","name":"プロデューサー","text":"あぁ、そういう……！\\n悪い悪い……","trans":"啊，这回事……！\\n抱歉抱歉……"},{"id":"0000000000000","name":"プロデューサー","text":"映画観てたのか\\n静かにするよ……！","trans":"你在看电影啊\\n那我小点声……！"},{"id":"2020010010080","name":"透","text":"ふふっ\\nいい。暗くしといてくれれば","trans":"呵呵\\n没事。能保持暗度就行了"},{"id":"2020010010090","name":"透","text":"見てないし","trans":"也没在看"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"2020010010100","name":"透","text":"見てるだけだから","trans":"就只是看着"},{"id":"0000000000000","name":"プロデューサー","text":"────……\\nはは","trans":"————……\\n哈哈"},{"id":"0000000000000","name":"プロデューサー","text":"……モノクロか\\n話は気にならないのか？","trans":"……黑白电影啊\\n不在意台词吗？"},{"id":"2020010010110","name":"透","text":"え？　んー……","trans":"诶？　嗯——……"},{"id":"2020010010120","name":"透","text":"うん","trans":"嗯"},{"id":"2020010010130","name":"透","text":"なんか、だから\\n見てるだけ","trans":"大概，所以说\\n就只是看着"},{"id":"2020010010140","name":"透","text":"形と線","trans":"形状和线条"},{"id":"2020010010150","name":"透","text":"あと、色","trans":"还有，颜色"},{"id":"0000000000000","name":"プロデューサー","text":"────色が見えるのか、透","trans":"————能看到颜色吗，透"},{"id":"0000000000000","name":"スポンサー企業広報","text":"ほらほらっ、２８３さん！","trans":"你看你看，283的"},{"id":"0000000000000","name":"スポンサー企業広報","text":"フォトセッション始まっちゃいます！\\n私たちも押さえときましょ！","trans":"准备大合照了！\\n我们也挤过去吧！"},{"id":"0000000000000","name":"プロデューサー","text":"……あっ、ええ！","trans":"……啊，嗯嗯！"},{"id":"0000000000000","name":"プロデューサー","text":"……────","trans":""},{"id":"2020010010160","name":"透","text":"……見えない？","trans":"……看不见？"},{"id":"select","name":"","text":"……見えるよ","trans":"……看得见啊"},{"id":"select","name":"","text":"……見えないよ","trans":"……看不见啊"},{"id":"select","name":"","text":"……わからないよ","trans":"……我不知道"},{"id":"0000000000000","name":"プロデューサー","text":"……見えるよ、今日なら\\n色でいっぱいだ","trans":"……看得见啊，今天\\n充满色彩"},{"id":"0000000000000","name":"プロデューサー","text":"もし","trans":"如果"},{"id":"0000000000000","name":"プロデューサー","text":"もし、この景色すべてを\\nモノクロでしか残せないとして","trans":"如果，这份景色的所有\\n只能作为黑白电影留存下来的话"},{"id":"2020010010170","name":"off","text":"ねぇ\\n私は？　じゃ","trans":"哎\\n我呢？　那"},{"id":"2020010010180","name":"off","text":"形？　線？","trans":"形状？　线条？"},{"id":"2020010010190","name":"off","text":"────色？","trans":"————颜色？"},{"id":"0000000000000","name":"プロデューサー","text":"初めて見る人には\\nどんな色が見えるんだろうか","trans":"对于第一次观看的人\\n能看到什么颜色呢"},{"id":"2020010010200","name":"透","text":"────","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"……はは\\n何が見えてるんだろうな、透────","trans":"……哈哈\\n是看到什么了吧，透————"},{"id":"0000000000000","name":"プロデューサー","text":"……見えなかったよ、透が見てるようには","trans":"……我没法，像透能看到那样"},{"id":"0000000000000","name":"プロデューサー","text":"モノクロの映像だったんだから","trans":"因为是黑白电影啊"},{"id":"0000000000000","name":"プロデューサー","text":"────でも","trans":"————不过"},{"id":"2020010010210","name":"off","text":"ねぇ\\n私は？　じゃ","trans":"哎\\n我呢？　那"},{"id":"2020010010220","name":"off","text":"形？　線？","trans":"形状？　线条？"},{"id":"2020010010230","name":"off","text":"────色？","trans":"————颜色？"},{"id":"0000000000000","name":"プロデューサー","text":"……次は、見えるような気がする","trans":"……感觉，下次就能看到了"},{"id":"2020010010240","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"0000000000000","name":"プロデューサー","text":"もう少し鮮やかに","trans":"再稍微鲜艳些"},{"id":"0000000000000","name":"プロデューサー","text":"……わからないよ\\n白黒以外の色もあるはずだってふうには、思うけど","trans":"……我不知道啊\\n虽然是觉得，除了黑白还会有其他颜色"},{"id":"2020010010250","name":"off","text":"ねぇ\\n私は？　じゃ","trans":"哎\\n我呢？　那"},{"id":"2020010010260","name":"off","text":"形？　線？","trans":"形状？　线条？"},{"id":"2020010010270","name":"off","text":"────色？","trans":"————颜色？"},{"id":"0000000000000","name":"プロデューサー","text":"────でも……","trans":"————不过……"},{"id":"0000000000000","name":"プロデューサー","text":"いろんな色を\\n反射してるみたいに見えるよ","trans":"可以看到\\n仿佛反射出各种颜色"},{"id":"0000000000000","name":"プロデューサー","text":"透の目は","trans":"透的眼里"}]}