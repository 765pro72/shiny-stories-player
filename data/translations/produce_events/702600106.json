{
  "translator": "告",
  "rows": [
    {
      "id": "7902001060010",
      "name": "社長",
      "text": "やはりここまで来ると、\\n乗り越えるべき壁も高かったな……",
      "trans": "果然走到这一步，\n需要跨越的高墙也变得愈发险峻了啊……"
    },
    {
      "id": "7026001060020",
      "name": "はづき",
      "text": "結果は残念でしたけど……\\n立派にやってましたよ",
      "trans": "结果虽然很遗憾……\n但她做得很出色哦"
    },
    {
      "id": "7901001060020",
      "name": "はづき",
      "text": "ここまで来れただけでも、\\n胸を張って誇れることだと私は思います",
      "trans": "能走到这里，\n我认为就已经足以挺起胸膛引以为傲了"
    },
    {
      "id": "7026001060040",
      "name": "社長",
      "text": "…………そうだな",
      "trans": "…………是啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……すみません、俺の力不足です\\n彼女は精一杯やってくれました",
      "trans": "……对不起，是我能力不足\n她已经尽力了"
    },
    {
      "id": "7901001060030",
      "name": "はづき",
      "text": "その言葉を、彼女に直接\\n言ってあげましょう？",
      "trans": "把这句话，当面亲口告诉她吧？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……はい",
      "trans": "……好的"
    },
    {
      "id": "7026001060060",
      "name": "ルカ",
      "text": "────────…………",
      "trans": "——————…………"
    },
    {
      "id": "7026001060070",
      "name": "ルカ",
      "text": "は…………？",
      "trans": "哈…………？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺も、信じられない結果だが……",
      "trans": "我也很难相信这个结果……"
    },
    {
      "id": "7026001060080",
      "name": "ルカ",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "7026001060090",
      "name": "ルカ",
      "text": "そうかよ……",
      "trans": "是吗……"
    },
    {
      "id": "7026001060100",
      "name": "ルカ",
      "text": "どいつもこいつも……！",
      "trans": "每个人都……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ……",
      "trans": "路加……"
    },
    {
      "id": "7026001060110",
      "name": "ルカ",
      "text": "なんだよその目……",
      "trans": "你那什么眼神……"
    },
    {
      "id": "7026001060120",
      "name": "ルカ",
      "text": "その目で見んじゃねェ……！",
      "trans": "你别那么看我……！"
    }
  ]
