{"translator":"","rows":[{"id":"6001004010010","name":"真乃","text":"…………","trans":"……"},{"id":"6001004010020","name":"真乃","text":"………………","trans":"…………"},{"id":"6001004010030","name":"真乃","text":"ん……っ","trans":"嗯……"},{"id":"6001004010040","name":"真乃","text":"──いってきますっ\\nプロデューサーさん","trans":"——我上了\\n制作人先生"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、いってらっしゃい","trans":"嗯嗯，一路顺风"},{"id":"6001004010041","name":"真乃＆プロデューサー","text":"…………","trans":"……"},{"id":"6001004010050","name":"真乃","text":"ふふ……っ","trans":"呵呵……"},{"id":"0000000000000","name":"プロデューサー","text":"はは……これ以上の言葉は、\\nもう必要ない……かな？","trans":"哈哈……多余的话语\\n已经不需要了……吧？"},{"id":"6001004010060","name":"真乃","text":"い、いえ……っ","trans":"不、不……"},{"id":"6001004010070","name":"真乃","text":"そうじゃないんです\\nとってもとっても……必要で……","trans":"不是的\\n非常非常……必要……"},{"id":"6001004010080","name":"真乃","text":"私にとって大事な言葉なので……","trans":"因为对我来说是很重要的话语……"},{"id":"6001004010090","name":"真乃","text":"……胸の中に、ちゃんといます","trans":"……铭刻在心中"},{"id":"6001004010100","name":"真乃","text":"優しくて、あたたかい──","trans":"温柔又暖和——"}]}