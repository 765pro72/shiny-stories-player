{"translator":"煉金術式","rows":[{"id":"0000000000000","name":"スタッフ","text":"セットチェンジのため休憩入ります！\\n再開時にはお声がけさせていただきます──","trans":"换场，休息一下！\\n重新开始时会通知大家──"},{"id":"0000000000000","name":"スタッフ","text":"斑鳩さんお疲れ様でした！","trans":"斑鸠小姐，辛苦了！"},{"id":"1026003090010","name":"ルカ","text":"……","trans":""},{"id":"1026003090020","name":"ルカ","text":"……","trans":""},{"id":"0000000000000","name":"メッセージ","text":"『どうしてんの』","trans":"『最近怎么样』"},{"id":"1026003090030","name":"ルカ","text":"…………","trans":""},{"id":"0000000000000","name":"メッセージ","text":"『　　　　　　』","trans":"“　　　　　　”","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"1026003090040","name":"ルカ","text":"………………","trans":""},{"id":"1026003090050","name":"ルカ","text":"……チッ……","trans":"……啧……"},{"id":"0000000000000","name":"メッセージ","text":"『元気？』","trans":"『还好吗？』"},{"id":"1026003090060","name":"ルカ","text":"──ない","trans":"──不好"},{"id":"0000000000000","name":"メッセージ","text":"『　　　　　　』","trans":""},{"id":"1026003090070","name":"ルカ","text":"…………","trans":""},{"id":"1026003090080","name":"ルカ","text":"めんどくせェ……\\n……なんでこんな──……","trans":"真难搞……\\n……为什么我要──……"},{"id":"1026003090090","name":"ルカ","text":"……","trans":""},{"id":"1026003090100","name":"ルカ","text":"～～……","trans":""},{"id":"1026003090110","name":"ルカ","text":"！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"入るぞ、ルカ","trans":"路加，要上台了"},{"id":"0000000000000","name":"プロデューサー","text":"……どうかしたか？","trans":"……怎么了？"},{"id":"1026003090120","name":"ルカ","text":"──、なんでもねェよ","trans":"──没怎么"},{"id":"0000000000000","name":"プロデューサー","text":"そうか……？　なら、そろそろ準備を頼むよ\\nあと10分ぐらいで再開になるそうだ","trans":"是吗……？那就先准备一下吧\\n再过十分钟就要继续了"},{"id":"0000000000000","name":"プロデューサー","text":"あと、始まったらでいいみたいなんだが\\nスタッフさんから少し打ち合わせをしたいって言われてて","trans":"对了，等下上台前可能要耽误一会\\n那边说要给咱们开个小会"},{"id":"1026003090130","name":"ルカ","text":"……行く","trans":"……走吧"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"嗯？"},{"id":"1026003090140","name":"ルカ","text":"打ち合わせ、今からでいい","trans":"小会，现在开也可以"},{"id":"0000000000000","name":"プロデューサー","text":"りょ、了解……！\\nでも大丈夫か？　スマホ、何か見てたんじゃ──","trans":"好、好的……！\\n……路加方便吗？看你在看手机──"},{"id":"1026003090150","name":"ルカ","text":"いいっつってんだろ","trans":"都说可以了"},{"id":"0000000000000","name":"プロデューサー","text":"わ、わかった、すまん……！","trans":"啊，我知道了，抱歉……！"},{"id":"0000000000000","name":"プロデューサー","text":"じゃあ、行こうか","trans":"那走吧"},{"id":"0000000000000","name":"メッセージ","text":"『ごめん　こっちは、』──────","trans":"『对不起，我』──────"}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}