{
  "translator": "Rosineae",
  "rows": [
    {
      "id": "2012004040010",
      "name": "凛世",
      "text": "プロデュー──",
      "trans": "制作——"
    },
    {
      "id": "2012004040020",
      "name": "凛世",
      "text": "──失礼……致しました……",
      "trans": "——打扰了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（あれ、凛世……？）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──どうも、本日はご足労いただきまして……！\\n……ははは、いえいえ。こちらへどうぞ",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（俺を呼んでたのかな……）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "お、凛世！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040030",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "さっきは──……\\n……と",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "すまん、電話だ\\nまた後でな……！　もしもし──",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040040",
      "name": "凛世",
      "text": "……はい、プロデューサーさま……",
      "trans": "……好的，制作人大人"
    },
    {
      "id": "2012004040050",
      "name": "凛世",
      "text": "……プロデューサーさま……？",
      "trans": "……制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、凛世！\\nさっきは悪かったな……！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "何か用があるんだよな？\\n俺、すぐ出なくちゃならなくなって……",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040060",
      "name": "凛世",
      "text": "いえ……凛世は……",
      "trans": "不……凛世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "後で必ず時間作るからさ、\\n待っててくれ！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040070",
      "name": "凛世",
      "text": "プロデューサーさま……\\nあの……",
      "trans": "制作人大人……\\n那个……"
    },
    {
      "id": "2012004040080",
      "name": "凛世",
      "text": "……はい",
      "trans": "……嗯"
    },
    {
      "id": "2012004040090",
      "name": "凛世",
      "text": "プロデューサーさまは……\\nお忙しいのです……",
      "trans": "制作人大人……\\n非常忙碌……"
    },
    {
      "id": "2012004040100",
      "name": "凛世",
      "text": "──あ",
      "trans": "──啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『必要だったら、遠慮なくメールしてくれ\\nなるべく早く帰るからな』",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040110",
      "name": "凛世",
      "text": "ふふ、プロデューサーさま……\\n凛世は……──",
      "trans": "呵呵，制作人大人……\\n凛世……──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（凛世……メールもなかったけど\\nまだいるかな……）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ふー……\\n今日は慌ただしかったなぁ……",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040120",
      "name": "凛世",
      "text": "『プロデューサーさま……』",
      "trans": "“制作人大人……”"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……え？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（凛世……？）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……どこかにいるのか……？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\n…………",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（踏切の……向こう側か……？）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "（あ──\\nやっぱりそうだ）",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世ー！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世！　……はは、おーい\\n走らなくって大丈夫だぞー！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "select",
      "name": "",
      "text": "もしかして、さっき\\n呼んでくれてたか？",
      "trans": "刚才凛世有叫我吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "お疲れ様",
      "trans": "刚才凛世有叫我吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "今日はごめんな",
      "trans": "刚才凛世有叫我吗？"
    },
    {
      "id": "2012004040130",
      "name": "凛世",
      "text": "はい──いえ……",
      "trans": "是的──不……"
    },
    {
      "id": "2012004040140",
      "name": "凛世",
      "text": "お呼びしたようで……\\nそうでも……なく……",
      "trans": "好像叫了……\\n又好像……没有……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？\\nははは、なんだ、それ",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040150",
      "name": "凛世",
      "text": "いえ……",
      "trans": "没什么……"
    },
    {
      "id": "2012004040160",
      "name": "凛世",
      "text": "とても……",
      "trans": "非常……"
    },
    {
      "id": "2012004040170",
      "name": "凛世",
      "text": "とてもとても……\\n……お会いしたくて",
      "trans": "非常非常……\\n……想见到制作人阁下"
    },
    {
      "id": "2012004040180",
      "name": "凛世",
      "text": "凛世の……心の中の声であったのか……\\nまことの……声か……",
      "trans": "不清楚……究竟是凛世心中的声音……\\n还是……真的发出来的声音……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040190",
      "name": "凛世",
      "text": "ですが……お待ちいただけたのです……\\nどちらであっても……",
      "trans": "但是……无论哪个是答案……\\n制作人阁下都停下了脚步……"
    },
    {
      "id": "2012004040200",
      "name": "凛世",
      "text": "お呼びして……よかった……",
      "trans": "呼唤了您……真是太好了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……うん\\n俺には、聞こえたからさ",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040210",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……そういえば、俺に何か用があったんだよな\\nもう大丈夫だから、聞かせてくれるか？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040220",
      "name": "凛世",
      "text": "それは……\\n──はい。ふふ……",
      "trans": "这个……\\n──好的。哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……偶然だな",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040230",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "今日はどうだった？　……というか、\\n何か俺に話したいことがあったんじゃないか？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040240",
      "name": "凛世",
      "text": "……いえ、その……",
      "trans": "……不，那个……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "遠慮しないで、言ってみてくれ",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040250",
      "name": "凛世",
      "text": "……はい",
      "trans": "……嗯"
    },
    {
      "id": "2012004040260",
      "name": "凛世",
      "text": "おはようございます、と……\\nお伝えしたく……",
      "trans": "想跟您说一声……\\n“早上好”……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え……？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……あ、そうか\\n今日は……ちゃんと挨拶してないかもしれない",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040270",
      "name": "凛世",
      "text": "いえ……！",
      "trans": "不……！"
    },
    {
      "id": "2012004040280",
      "name": "凛世",
      "text": "プロデューサーさまに……\\n非は……ございません……",
      "trans": "制作人大人……\\n并没有错……"
    },
    {
      "id": "2012004040290",
      "name": "凛世",
      "text": "ただ、凛世が……\\nそう……お伝えしたかったのです……",
      "trans": "凛世，就只是想……\\n对您……说这句话……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうだったんだな……\\nそれじゃあ、凛世",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おはよう",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040300",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "2012004040310",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012004040320",
      "name": "凛世",
      "text": "おはようございます……\\nプロデューサーさま……",
      "trans": "早上好……\\n制作人大人……"
    },
    {
      "id": "2012004040330",
      "name": "凛世",
      "text": "……？\\nなぜで……ございましょう……",
      "trans": "……？\\n为什么要……道歉呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "や、なぜって……\\n今日はすれ違ってばっかりだったから",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ごめん、って",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040340",
      "name": "凛世",
      "text": "……プロデューサーさま……",
      "trans": "……制作人大人……"
    },
    {
      "id": "2012004040350",
      "name": "凛世",
      "text": "凛世は……",
      "trans": "凛世……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……え？",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040360",
      "name": "凛世",
      "text": "凛世は……",
      "trans": "凛世以为……"
    },
    {
      "id": "2012004040370",
      "name": "凛世",
      "text": "遮断機が上がる頃には……\\nプロデューサーさまはいらっしゃらないと……",
      "trans": "道口栏杆……升起的时候……"
    },
    {
      "id": "2012004040380",
      "name": "凛世",
      "text": "思っておりました……",
      "trans": "制作人阁下不会在那里……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは……俺もそう思ったんだ\\n凛世の声が聞こえた気がしたけど……",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "きっと電車が行ったあと\\n誰もいないんじゃないかなって",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040390",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……そうか、じゃあ\\n『ごめん』じゃなくて『ありがとう』だよな！",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "呼び止めてくれてありがとう\\nまた……すれ違うとこだった",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040400",
      "name": "凛世",
      "text": "……",
      "trans": ""
    },
    {
      "id": "2012004040410",
      "name": "凛世",
      "text": "それを申すのでしたら……\\n凛世の方で……ございます……",
      "trans": "要说感谢的人……\\n是凛世……才对……"
    },
    {
      "id": "2012004040420",
      "name": "凛世",
      "text": "名を……お呼びくださり……",
      "trans": "谢谢您呼唤了……凛世的名字……"
    },
    {
      "id": "2012004040430",
      "name": "凛世",
      "text": "声を……\\nつかまえて……くださって……──",
      "trans": "听到了……\\n凛世的声音……──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "（咦，凛世……？）"
    },
    {
      "id": "2012004040440",
      "name": "凛世",
      "text": "はい……\\nご一緒に……参りましょう……",
      "trans": "嗯……\\n请一起……走吧……"
    }
  ]
}