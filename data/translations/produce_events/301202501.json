{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"3012025010010","name":"凛世","text":"────\r\n羽を……広げたら……","trans":"────\n把翅膀……展开的话……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010020","name":"凛世","text":"鶴の……\r\nできあがり……","trans":"纸鹤……\n完成了……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-5","name":"姉","text":"わぁ、とっても綺麗ね","trans":"哇，非常漂亮呢","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010040","name":"凛世","text":"姉さまに……\r\nあげます……","trans":"给姐姐……\n送这个……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-10","name":"姉","text":"ありがとう\r\n大切にするね","trans":"谢谢\n我会好好珍惜的","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010050","name":"凛世","text":"凛世……\r\n鶴じゃないのも……折れます……","trans":"凛世……\n别的也能……折出来……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-15","name":"姉","text":"ふふっ\r\nじゃあ姉さまにも教えて？","trans":"呵呵\n那也教教姐姐吧？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010060","name":"凛世","text":"はい……","trans":"好的……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010070","name":"凛世","text":"……\r\n────姉さま……","trans":"……\n────姐姐……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-30","name":"姉","text":"あ、凛世\r\nおはよう","trans":"啊，凛世\n早上好","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010080","name":"凛世","text":"……おはようございます……","trans":"……早上好……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010100","name":"凛世","text":"近頃……\r\n姉さまは──────","trans":"最近……\n姐姐──────","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010110","name":"凛世","text":"いって……らっしゃいませ……","trans":"一路顺风……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010120","name":"凛世","text":"────どこかへ……","trans":"────去了什么地方……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-47","name":"姉","text":"じゃあ、凛世はこっちの皮をむいてくれる？","trans":"那么，凛世来剥这边的皮好吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010140","name":"凛世","text":"凛世は……\r\nそら豆……好きません……","trans":"凛世……不喜欢……\n蚕豆……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010170","name":"凛世","text":"──あの……\r\n姉さま……","trans":"──那个……\n姐姐……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-66","name":"部屋にいる姉の声","text":"────あ、凛世？\r\n入って","trans":"────啊，凛世？\n进来吧","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-69","name":"姉","text":"ごめんね、今電話してたの\r\nちょっとだけ待っていて","trans":"抱歉，我刚才在打电话\n稍微等我一下","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-73","name":"姉","text":"──そう、妹\r\n……ううん、大丈夫","trans":"──嗯，是我妹妹\n……不，没事","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-75","name":"姉","text":"うん、また────\r\nおやすみなさい","trans":"嗯，再见────\n晚安","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-77","name":"姉","text":"凛世、お待たせ\r\nこっちにおいで","trans":"凛世，让你等了\n过来这边","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-81","name":"姉","text":"眠れなくなっちゃった？","trans":"睡不着了吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010210","name":"凛世","text":"姉さま…………","trans":"姐姐…………","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010220","name":"凛世","text":"最近……\r\nどなたに……お会いして……","trans":"最近……\n您是和谁……见面……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010230","name":"凛世","text":"さっきも……\r\nお電話────……","trans":"刚才也……\n在打电话────……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-90","name":"姉","text":"ふふ、誰だか気になる？","trans":"呵呵，在意是谁吗？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-93","name":"姉","text":"────姉さまが恋をしてる人","trans":"────是姐姐在恋爱的人","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010240","name":"凛世","text":"──こい…………","trans":"──恋……爱…………","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-101","name":"姉","text":"────さ、そろそろお布団に入りましょ","trans":"────来，差不多该进被窝了","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-103","name":"姉","text":"電気消すね","trans":"我关灯了哦","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3012025010260","name":"凛世","text":"遠い────…………","trans":"好远────…………","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}