{
  "translator": "",
  "rows": [
    {
      "id": "0000000000000",
      "name": "メモ",
      "text": "『コメティックってどんなユニット？』",
      "trans": "“CoMETIk是个怎样的组合？”"
    },
    {
      "id": "5008002040010",
      "name": "はるき",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040020",
      "name": "はるき",
      "text": "わたしが、一番見たいコメティック────",
      "trans": "我自己，最想看见的CoMETIk────"
    },
    {
      "id": "0000000000000",
      "name": "スタッフ",
      "text": "──お疲れ様でしたー！\\n本日の収録、以上となりまーす！",
      "trans": "──各位辛苦了ー！\\n今天的收录，就到此结束！"
    },
    {
      "id": "5008002040030",
      "name": "羽那",
      "text": "お疲れ様でしたーっ",
      "trans": "大家辛苦了ー"
    },
    {
      "id": "5008002040040",
      "name": "羽那",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040050",
      "name": "羽那",
      "text": "（……この時間なら\\n練習、行けるかも──！）",
      "trans": "（……趁这个时间的话\\n也许可以去练习──！）"
    },
    {
      "id": "5008002040060",
      "name": "はるき",
      "text": "あれ────？",
      "trans": "咦────？"
    },
    {
      "id": "5008002040070",
      "name": "はるき",
      "text": "ルカちゃん……\\n今日も入ってたんだ",
      "trans": "路加……\\n今天也在"
    },
    {
      "id": "5008002040080",
      "name": "はるき",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040090",
      "name": "はるき",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040100",
      "name": "はるき",
      "text": "こんばんは、ルカちゃん",
      "trans": "晚上好，路加"
    },
    {
      "id": "5008002040110",
      "name": "ルカ",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040120",
      "name": "はるき",
      "text": "……\\nえっと……",
      "trans": "……\\n那个……"
    },
    {
      "id": "5008002040130",
      "name": "はるき",
      "text": "ルカちゃん\\nわたしも一緒に練習していいかな？",
      "trans": "路加\\n我能和你一起练习吗？"
    },
    {
      "id": "5008002040140",
      "name": "ルカ",
      "text": "好きにしろよ",
      "trans": "随便你"
    },
    {
      "id": "5008002040150",
      "name": "はるき",
      "text": "うん、ありがとう……！",
      "trans": "嗯，谢谢……！"
    },
    {
      "id": "5008002040160",
      "name": "はるき",
      "text": "ワン、ツー、ダッダッパ！",
      "trans": "1，2，哒哒啪！"
    },
    {
      "id": "5008002040170",
      "name": "はるき",
      "text": "あ──────……！",
      "trans": "啊──────……！"
    },
    {
      "id": "5008002040180",
      "name": "はるき",
      "text": "────────……\\nもう一回……",
      "trans": "────────……\\n再试一次……"
    },
    {
      "id": "5008002040190",
      "name": "ルカ",
      "text": "……",
      "trans": ""
    },
    {
      "id": "5008002040200",
      "name": "はるき",
      "text": "──────……\\nちょっと休憩……",
      "trans": "──────……\\n稍微休息下"
    },
    {
      "id": "5008002040210",
      "name": "はるき",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "5008002040220",
      "name": "ルカ",
      "text": "──────……ッ",
      "trans": "——————……唔"
    },
    {
      "id": "5008002040230",
      "name": "はるき",
      "text": "…………っ",
      "trans": "…………！"
    },
    {
      "id": "5008002040240",
      "name": "はるき",
      "text": "やっぱりすごい……ルカちゃん……",
      "trans": "果然好厉害……路加……"
    },
    {
      "id": "5008002040250",
      "name": "はるき",
      "text": "キラキラしたステージじゃなくたって……\\nあんなに────",
      "trans": "即使没站在闪闪发光的舞台上……\\n也是那么────"
    },
    {
      "id": "5008002040260",
      "name": "ルカ",
      "text": "──────……ッ",
      "trans": "——————……唔"
    },
    {
      "id": "5008002040270",
      "name": "はるき",
      "text": "────綺麗……",
      "trans": "────美丽……"
    },
    {
      "id": "5008002040280",
      "name": "ルカ",
      "text": "──────……ッ",
      "trans": "——————……唔"
    },
    {
      "id": "5008002040290",
      "name": "はるき",
      "text": "ルカちゃんは、そこまで行くのに\\n一体どれだけの──",
      "trans": "路加已经到达了那种地步──\\n到底是花了多少时间"
    },
    {
      "id": "5008002040300",
      "name": "はるき",
      "text": "ルカちゃん、わたしは────",
      "trans": "路加，我────"
    },
    {
      "id": "5008002040310",
      "name": "ルカ",
      "text": "────────……",
      "trans": ""
    },
    {
      "id": "5008002040320",
      "name": "はるき",
      "text": "ルカちゃん────！",
      "trans": "路加────！"
    },
    {
      "id": "5008002040330",
      "name": "はるき",
      "text": "わたし、ルカちゃんの横に立ちたい",
      "trans": "我想，站在路加的身旁"
    },
    {
      "id": "5008002040340",
      "name": "ルカ",
      "text": "…………は？",
      "trans": "…………哈？"
    },
    {
      "id": "5008002040350",
      "name": "はるき",
      "text": "わたしはまだまだ遠く及ばないけど……",
      "trans": "虽然我还远远不及……"
    },
    {
      "id": "5008002040360",
      "name": "はるき",
      "text": "でも、早く追いつきたいから\\n教えてほしい、たくさんのこと──",
      "trans": "但，我想早点追上你\\n希望你能教教我，许多方面的事情──"
    },
    {
      "id": "5008002040370",
      "name": "ルカ",
      "text": "……",
      "trans": ""
    },
    {
      "id": "5008002040380",
      "name": "はるき",
      "text": "ううん、こうして近くにいるだけでいい",
      "trans": "不，能像这样接近一点也好"
    },
    {
      "id": "5008002040390",
      "name": "はるき",
      "text": "目指すものが、すぐそばにいてくれるだけで\\nわたしは──",
      "trans": "只要所追寻的目标近在咫尺\\n我就──"
    },
    {
      "id": "5008002040400",
      "name": "羽那",
      "text": "────あれ？",
      "trans": "────咦？"
    },
    {
      "id": "5008002040410",
      "name": "羽那",
      "text": "はるきちゃんに\\nルカちゃんもいる──！",
      "trans": "阳希在\\n路加也在──！"
    },
    {
      "id": "5008002040420",
      "name": "羽那",
      "text": "ふたりでレッスン中だったの？\\nあはっ、ずるーいっ",
      "trans": "你们俩是在训练中吗？\\n啊哈、好狡猾"
    },
    {
      "id": "5008002040430",
      "name": "はるき",
      "text": "あ、えっと……\\nルカちゃんとは、偶然で……！",
      "trans": "啊，那个……\\n和路加，只是偶然……！"
    },
    {
      "id": "5008002040440",
      "name": "はるき",
      "text": "それより羽那ちゃん、\\n今日はお仕事だったんじゃ──",
      "trans": "说起来羽那\\n你今天不是还有工作吗──"
    },
    {
      "id": "5008002040450",
      "name": "羽那",
      "text": "うん、そうなんだけどね\\n早く終わったから練習しようと思って来たの",
      "trans": "嗯，是这样没错\\n因为提前结束了就想早点来练习一下"
    },
    {
      "id": "5008002040460",
      "name": "羽那",
      "text": "でもふたりがいて嬉しいーっ",
      "trans": "但我好高兴你们俩都在"
    },
    {
      "id": "5008002040470",
      "name": "羽那",
      "text": "あたしも混ぜてくれる？",
      "trans": "能让我也一起练习吗？"
    },
    {
      "id": "5008002040480",
      "name": "ルカ",
      "text": "……",
      "trans": ""
    },
    {
      "id": "5008002040490",
      "name": "はるき",
      "text": "あ──────…………",
      "trans": "啊──────…………"
    },
    {
      "id": "5008002040500",
      "name": "はるき",
      "text": "今──────",
      "trans": "现在──────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうだな、\\n俺が見たいコメティックは────",
      "trans": "是啊\\n我想看见的CoMETIk────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はるきたちが、自分たちで\\n一番見たいと思うコメティックだな",
      "trans": "就是，阳希她们自己\\n所最想看见的CoMETIk吧"
    },
    {
      "id": "5008002040020",
      "name": "はるき",
      "text": "わたしが、一番見たいコメティック────",
      "trans": "我自己，最想看见的CoMETIk────"
    },
    {
      "id": "5008002040520",
      "name": "はるき",
      "text": "見えた",
      "trans": "看到了"
    },
    {
      "id": "5008002040530",
      "name": "はるき",
      "text": "わたしが、見たいもの",
      "trans": "我自己，想看见的景象"
    }
  ]
}