{"translator":"Nast","rows":[{"id":"0000000000000","name":"プロデューサー","text":"やったな、透！\\nお客さんもみんな引き込まれて────","trans":"做到了呢，透！\\n"},{"id":"6020003020010","name":"透","text":"ねぇ、偉い？","trans":"呐，了不起？"},{"id":"0000000000000","name":"プロデューサー","text":"────ええと……\\nうん。偉いぞ","trans":"────那个……\\n嗯。很了不起哦"},{"id":"6020003020020","name":"透","text":"────\\nじゃ……すごい？","trans":"────\\n那……厉害么？"},{"id":"0000000000000","name":"プロデューサー","text":"……すごいよ\\n聞こえてただろ？　歓声","trans":"……很厉害呢\\n在这都能听到吧，欢呼声"},{"id":"6020003020030","name":"透","text":"頑張った？","trans":"竭尽全力了？"},{"id":"0000000000000","name":"プロデューサー","text":"──────\\n頑張ったよ、透","trans":"──────\\n尽力了哦，透"},{"id":"6020003020040","name":"透","text":"────……いっか、じゃあ","trans":"────……是么，那"},{"id":"6020003020050","name":"透","text":"帰ろ","trans":"回去吧"}]}