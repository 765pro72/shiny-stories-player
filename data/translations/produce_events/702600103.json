{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──二次審査も無事通過した\\nおめでとう","trans":"——二审你也顺利通过了\\n恭喜你"},{"id":"7026001030010","name":"ルカ","text":"…………","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"今回も圧倒的な\\nパフォーマンスだった","trans":"这次的表演\\n也压倒了全场"},{"id":"0000000000000","name":"プロデューサー","text":"技術は勿論だけど\\nルカの良さは、それ以外のところにある気がしたよ","trans":"技术不用说\\n我还发现了路加其他的优点"},{"id":"0000000000000","name":"プロデューサー","text":"俺自身\\n驚かされてばかりだ","trans":"我自己\\n也总是很惊讶"},{"id":"0000000000000","name":"プロデューサー","text":"順調に勝ち進んでる","trans":"你赢得很顺利"},{"id":"7026001030020","name":"ルカ","text":"…………","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"今回の反省点と\\n次回に向けての打ち合わせなんだけど","trans":"关于这次的反省\\n以及面向下次的会议"},{"id":"7026001030030","name":"ルカ","text":"いらねぇ……","trans":"不需要……"},{"id":"0000000000000","name":"プロデューサー","text":"え……\\nでも……","trans":"诶……\\n但是……"},{"id":"7026001030040","name":"ルカ","text":"わかっただろ……","trans":"你早知道了吧……"},{"id":"7026001030050","name":"ルカ","text":"私は","trans":"我"},{"id":"7026001030060","name":"ルカ","text":"誰の助けもいらない────","trans":"不需要任何人的帮助————"},{"id":"7026001030070","name":"ルカ","text":"何もいらない────","trans":"什么都不需要————"},{"id":"7026001030080","name":"ルカ","text":"それでも勝っていける","trans":"也能赢得胜利"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ……","trans":"路加……"},{"id":"7026001030090","name":"ルカ","text":"ハッ……\\nなんだよその顔……！","trans":"哈……\\n你这什么表情……！"},{"id":"7026001030100","name":"ルカ","text":"もう\\nほっとけよ……","trans":"够了\\n别再管我了……"},{"id":"7026001030110","name":"ルカ","text":"アンタは何もするな","trans":"你什么也别做"},{"id":"7026001030120","name":"ルカ","text":"次も勝ってやるよ","trans":"我下次也会赢"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":""}]}