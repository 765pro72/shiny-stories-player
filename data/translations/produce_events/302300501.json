{"translator":"魚見","rows":[{"id":"0000000000000","name":"電話の声","text":"『────に……しい……\\n…………たんだ』","trans":"“————来……的……\\n…………了”"},{"id":"3023005010010","name":"雛菜","text":"……？\\n何──……？","trans":"……？\\n什么——……？"},{"id":"3023005010020","name":"雛菜","text":"…………","trans":""},{"id":"3023005010030","name":"雛菜","text":"あは～……","trans":"啊哈～……"},{"id":"3023005010040","name":"透","text":"んー\\n真っ暗。めっちゃ","trans":"嗯——\\n漆黑。超级"},{"id":"3023005010050","name":"雛菜","text":"とりあえず進めばいいかな～？","trans":"总之前进就可以了吧～？"},{"id":"3023005010060","name":"円香","text":"さあ","trans":"谁知道"},{"id":"3023005010070","name":"小糸","text":"ちょ、ちょっと\\nみんなどっちに進んでるの……？","trans":"等、等等\\n大家都在往哪前进……？"},{"id":"3023005010080","name":"小糸","text":"な、なんか上手く歩けないよ……？","trans":"好、好像没法顺利走……？"},{"id":"3023005010090","name":"円香","text":"小糸反対\\n……こっちだから","trans":"小糸反了\\n……在这边"},{"id":"3023005010100","name":"雛菜","text":"……ん～\\n進むの、こっちでいいと思う～？","trans":"……嗯～\\n你觉得，往这边可以吗～？"},{"id":"3023005010110","name":"円香","text":"いいんじゃない？　知らないけど","trans":"不也挺好？　不知道就是了"},{"id":"3023005010120","name":"雛菜","text":"へ～\\n雛菜も知らないよ～～～？","trans":"诶～\\n雏菜也不知道啊～～～？"},{"id":"3023005010130","name":"透","text":"──\\nうん、オッケー","trans":"——\\n嗯，OK——"},{"id":"3023005010140","name":"透","text":"そっちで","trans":"就那边"},{"id":"3023005010150","name":"雛菜","text":"……そう？\\nじゃあいいか～！","trans":"……是吗？\\n那就这样～！"},{"id":"3023005010160","name":"小糸","text":"み、みんな歩くの早い……！","trans":"大、大家走太快了……！"},{"id":"3023005010170","name":"円香","text":"…………","trans":""},{"id":"3023005010180","name":"雛菜","text":"小糸ちゃん、さっきから\\n壁にぶつかってばっかりじゃない～？","trans":"小糸，从刚才开始\\n就一直在撞墙吧～？"},{"id":"3023005010190","name":"透","text":"ふふっ\\n大丈夫？","trans":"呵呵\\n没事吧？"},{"id":"3023005010200","name":"小糸","text":"う、うん、でも\\nもうちょっと……し、慎重に行かないと……","trans":"嗯、嗯，不过\\n不再稍微……谨、谨慎点前进的话……"},{"id":"3023005010210","name":"小糸","text":"なんか……出てきそうだよ……？","trans":"感觉……会冒出来唷……？"},{"id":"3023005010220","name":"雛菜","text":"小糸ちゃん、怖いの～？","trans":"小糸，害怕吗～？"},{"id":"3023005010230","name":"小糸","text":"こ、怖いっていうか……！\\nこういうのって、あんまり──……","trans":"说、说是害怕……！\\n这种，没怎么——……"},{"id":"3023005010240","name":"小糸","text":"…………！","trans":""},{"id":"3023005010250","name":"透","text":"うわ\\n音した","trans":"呜哇\\n有声音"},{"id":"3023005010260","name":"円香","text":"……\\n何……？","trans":"……\\n什么……？"},{"id":"3023005010270","name":"雛菜","text":"音がした方に何かあるのかな～\\n行ったほうがいい？","trans":"发出声音的那边有什么吗～\\n去一下比较好？"},{"id":"3023005010280","name":"透","text":"んー……","trans":"嗯——……"},{"id":"3023005010290","name":"雛菜","text":"じゃあ行ってみよ～！","trans":"那就去看看吧～！"},{"id":"3023005010300","name":"小糸","text":"…………\\nほ、ほんとに行くの……？","trans":"…………\\n真、真的要去吗……？"},{"id":"3023005010310","name":"雛菜","text":"へ～？\\nじゃあ小糸ちゃんは行かない～？","trans":"诶～？\\n那小糸不去吗～？"},{"id":"3023005010320","name":"小糸","text":"ぴぇ……！","trans":"吔……！"},{"id":"3023005010330","name":"円香","text":"…………小糸？","trans":"…………小糸？"},{"id":"3023005010340","name":"円香","text":"…………小糸いなくない？","trans":"…………小糸不在？"},{"id":"3023005010350","name":"雛菜","text":"…………\\n小糸ちゃん消えた～？","trans":"…………\\n小糸消失了～？"},{"id":"3023005010360","name":"透","text":"……\\n消えたかも","trans":"……\\n或许是消失了"},{"id":"3023005010370","name":"雛菜","text":"あは～……\\nなんか思ってたより結構大変だね～","trans":"啊哈～……\\n感觉比想象中的更加累人呢～"},{"id":"3023005010380","name":"透","text":"うん","trans":"嗯"},{"id":"3023005010390","name":"円香","text":"これ、探さないとダメなやつ？","trans":"这是，不找不行的节奏？"},{"id":"3023005010400","name":"雛菜","text":"ん～……？","trans":"嗯～……？"},{"id":"3023005010410","name":"雛菜","text":"探しながら進む～！","trans":"边找边前进～！"},{"id":"3023005010420","name":"透","text":"…………","trans":""},{"id":"3023005010430","name":"透","text":"あれ、\\n……おーい","trans":"啊嘞，\\n……喂——"},{"id":"3023005010440","name":"透","text":"やば","trans":"糟糕"},{"id":"3023005010450","name":"透","text":"迷った","trans":"迷路了"},{"id":"3023005010460","name":"雛菜","text":"へ～\\nなんか透先輩も消えてない～！？","trans":"诶～\\n好像透前辈也消失了～！？"},{"id":"3023005010470","name":"雛菜","text":"円香先輩はまだいる～？","trans":"圆香前辈还在吗～？"},{"id":"3023005010480","name":"円香","text":"いる","trans":"在"},{"id":"3023005010490","name":"雛菜","text":"あは～、なんだいたんだ～！","trans":"啊哈～，什么嘛还在啊～！"},{"id":"3023005010500","name":"円香","text":"……テンション高","trans":"……兴致真高"},{"id":"3023005010510","name":"雛菜","text":"こっち行き止まりみたいだから\\nそっちの蜘蛛の巣いっぱいの方通らないとだめかも～","trans":"这边好像过不去的样子\\n可能得往一堆蜘蛛巢的那边走了～"},{"id":"3023005010520","name":"円香","text":"あ？","trans":"啊？"},{"id":"3023005010530","name":"雛菜","text":"円香先輩、先どうぞ～？","trans":"圆香前辈，前面请～？"},{"id":"3023005010540","name":"円香","text":"ノーサンキュー","trans":"No thank you"},{"id":"3023005010550","name":"雛菜","text":"あは～\\nなんかカサカサいってる！","trans":"啊哈～\\n好像在沙沙作响！"},{"id":"3023005010560","name":"雛菜","text":"気持ち悪い～！","trans":"真恶心～！"},{"id":"3023005010570","name":"円香","text":"…………もういい","trans":"…………够了"},{"id":"3023005010580","name":"雛菜","text":"…………？","trans":""},{"id":"3023005010590","name":"雛菜","text":"あれ、円香先輩もいなくなってる～？","trans":"啊嘞，圆香前辈也不见了～？"},{"id":"3023005010600","name":"雛菜","text":"あは～\\n雛菜だけしかいなくなった～！","trans":"啊哈～\\n变得只剩雏菜一个人了～！"},{"id":"3023005010610","name":"雛菜","text":"ま、進むしかないか～","trans":"嘛，只能前进咯～"},{"id":"3023005010620","name":"雛菜","text":"…………！","trans":""},{"id":"3023005010630","name":"雛菜","text":"うわ～……\\nまた真っ暗になった～","trans":"呜哇～……\\n又变得一片漆黑了～"},{"id":"3023005010640","name":"雛菜","text":"………………","trans":""},{"id":"3023005010650","name":"雛菜","text":"ここのドア開けて進むしかないよね～\\n……絶対なんかいそうだけど～……","trans":"只能打开这里的门前进了吧～\\n……虽然感觉肯定会有什么～……"},{"id":"3023005010660","name":"雛菜","text":"────あ","trans":"————啊"},{"id":"3023005010670","name":"雛菜","text":"……あは～\\nやっぱり死んじゃった～","trans":"……啊哈～\\n果然死掉了～"}]}