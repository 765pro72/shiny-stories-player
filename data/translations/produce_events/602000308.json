{"translator":"Nast","rows":[{"id":"6020003080010","name":"透","text":"よーし……","trans":"好的……"},{"id":"6020003080020","name":"透","text":"じゃ、行こ","trans":"那，我们走吧"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"6020003080030","name":"透","text":"河原","trans":"河滩"},{"id":"0000000000000","name":"プロデューサー","text":"えっ、今からか……！？","trans":"诶，现在吗？"},{"id":"6020003080040","name":"透","text":"え、うん\\n言ったじゃん、朝","trans":"哎，嗯\\n我不是说过了嘛，早上"},{"id":"0000000000000","name":"プロデューサー","text":"あ、あぁ……\\n今日のことだったのか、あれ","trans":"啊，啊啊……\\n原来是说今天嘛，那个"},{"id":"6020003080050","name":"透","text":"あと10周\\nもうちょっと","trans":"还剩10圈\\n还有一点点"},{"id":"0000000000000","name":"プロデューサー","text":"────うん","trans":"────嗯"},{"id":"0000000000000","name":"プロデューサー","text":"透……","trans":"透……"},{"id":"6020003080060","name":"透","text":"え？","trans":"诶？"},{"id":"0000000000000","name":"プロデューサー","text":"頑張れてるぞ、透\\n透は頑張ってる","trans":"尽力了呢，透\\n透在努力"},{"id":"6020003080070","name":"透","text":"うん","trans":"嗯"},{"id":"6020003080080","name":"透","text":"わかるよ、たぶん","trans":"我知道哦，大概"},{"id":"6020003080090","name":"透","text":"あと10周で","trans":"还剩10圈"}]}