{"translator":"告","rows":[{"id":"6024001030010","name":"にちか","text":"────────","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"……にちか\\n大丈夫か","trans":"……日花\\n没问题吧"},{"id":"6024001030020","name":"にちか","text":"────────\\nこれって……続くってことですか…………？","trans":"——————\\n这是……要继续的意思吗…………？"},{"id":"0000000000000","name":"プロデューサー","text":"……そうだよ\\n続けられる、まだまだ","trans":"……没错\\n你还能继续，不断继续下去"},{"id":"6024001030030","name":"にちか","text":"────うそ……","trans":"————不会吧……"},{"id":"0000000000000","name":"プロデューサー","text":"ほんとだ\\n……喜んでいいんだ","trans":"是真的\\n……尽管开心吧"},{"id":"6024001030040","name":"にちか","text":"────────\\nわかんなくて……なんか、もう────","trans":"——————\\n我不知道……我已经，不知道————"},{"id":"6024001030050","name":"にちか","text":"嬉しいか、どうか──────","trans":"自己究竟，开不开心了——————"}]}