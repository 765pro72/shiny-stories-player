      "trans": "不，不是的……！\\n不是，我没有哭……"
    },
    {
      "id": "6027004040081",
      "name": "羽那",
      "text": "えーっ、そう？",
      "trans": "哎，真的吗？"
    },
    {
      "id": "6027004040090",
      "name": "羽那",
      "text": "……一緒に行こうね？",
      "trans": "……我们一起去，好吗？"
    },
