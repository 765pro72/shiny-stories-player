    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……だから行こう\\n一緒に",
      "trans": "……所以一起走吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──って、俺は思ってるんだけど……",
      "trans": "──我就是这么想的……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "羽那はどうかな",
      "trans": "羽那，你觉得呢？"
    },
    {
      "id": "6027004040030",
      "name": "羽那",
      "text": "あはっ、うん\\nあたしも、行きたい──！",
      "trans": "哈哈，嗯\\n我也想去──！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、うん……！\\n……そうか……ありがとう",
      "trans": "啊啊，嗯……！\\n……是吗……谢谢你"
