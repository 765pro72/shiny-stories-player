    },
    {
      "id": "6027004040020",
      "name": "羽那",
      "text": "それはこれよりも、もっと大きなステージ？",
      "trans": "那是比现在还要更大的舞台吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……うん\\n今も、大きなステージだけど",
      "trans": "……嗯\\n现在的舞台也很大"
