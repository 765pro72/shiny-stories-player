{"translator":"煉金術式","rows":[{"id":"2026009110010","name":"ルカ","text":"……じゃあ、この辺歩いとく","trans":"……到这吧，我走着过去"},{"id":"0000000000000","name":"プロデューサー","text":"悪いな……！\\n車停めたらすぐ戻るから","trans":"不好意思……！\\n我停个车就来"},{"id":"2026009110020","name":"ルカ","text":"急がなくていい","trans":"也不用着急"},{"id":"2026009110030","name":"ルカ","text":"──私も久しぶりだし","trans":"──我也好久没来了"},{"id":"0000000000000","name":"プロデューサー","text":"──わかった\\nありがとう……！","trans":"──知道了\\n谢谢……！"},{"id":"2026009110040","name":"ルカ","text":"……","trans":"……"},{"id":"2026009110050","name":"ルカ","text":"…………──","trans":"…………──"},{"id":"2026009110060","name":"ルカ","text":"のんきだな、オマエら","trans":"你们也很闲嘛"},{"id":"2026009110070","name":"ルカ","text":"！","trans":"！  "},{"id":"2026009110080","name":"ルカ","text":"もしもし？\\nこっちはオフなんだけど","trans":"喂喂？\\n我可都下班了——"},{"id":"2026009110090","name":"ルカ","text":"……、\\n揃いも揃ってくだらねぇ……","trans":"……\\n就猜到是这些没营养的……"},{"id":"2026009110100","name":"ルカ","text":"……","trans":""},{"id":"2026009110110","name":"ルカ","text":"ああ──……\\nもう家のそば","trans":"嗯──……\\n马上到家了"},{"id":"2026009110120","name":"ルカ","text":"そっちはもうすぐ仕事だろ\\n集中しとけ──","trans":"你俩不是还在工作吗\\n别走神了——"},{"id":"0000000000000","name":"プロデューサー","text":"（──────ルカ……）","trans":"（──────路加……）  "},{"id":"0000000000000","name":"プロデューサー","text":"（ああ──……\\nもう、昔とは違うんだな）","trans":"（是啊──……）\\n（已经和从前——）"},{"id":"0000000000000","name":"プロデューサー","text":"（……よかった）","trans":"（……太好了）  "},{"id":"2026009110130","name":"ルカ","text":"……切るから","trans":"……那我挂了"},{"id":"2026009110140","name":"ルカ","text":"──うん、じゃあな","trans":"──嗯，拜拜"},{"id":"2026009110150","name":"ルカ","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"ルカ、お待たせ","trans":"路加，让你久等了"},{"id":"2026009110160","name":"ルカ","text":"ああ","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"電話、羽那とはるきか？","trans":"电话那头，是羽那和阳希吗？"},{"id":"2026009110170","name":"ルカ","text":"そうだけど……","trans":"倒是没错……"},{"id":"2026009110180","name":"ルカ","text":"……なんだよ？","trans":"……有事吗？"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ、いや","trans":"哈哈，没事"},{"id":"2026009110190","name":"ルカ","text":"なんの笑い？","trans":"那笑什么？"},{"id":"0000000000000","name":"プロデューサー","text":"なんでもないよ","trans":"没什么"},{"id":"2026009110200","name":"ルカ","text":"……ならいいけど","trans":"……那行吧"},{"id":"0000000000000","name":"プロデューサー","text":"……ふふ","trans":"……呵呵"},{"id":"2026009110210","name":"ルカ","text":"っ、テメェ……！","trans":"！我说你……！"},{"id":"2026009110220","name":"ルカ","text":"…………","trans":""},{"id":"2026009110230","name":"ルカ","text":"（…………朝──────？）","trans":"（…………早上了──────？）"},{"id":"2026009110240","name":"ルカ","text":"……、…………","trans":"………………"},{"id":"2026009110250","name":"ルカ","text":"何か……","trans":"刚才是……"},{"id":"2026009110260","name":"ルカ","text":"……──","trans":""},{"id":"2026009110270","name":"ルカ","text":"（──────くだらねぇ）","trans":"（──────真无聊）"}]}