{"translator":"","rows":[{"id":"3008014020010","name":"恋鐘","text":"怪物のみんな～～～！","trans":"怪物的大家~~~！"},{"id":"3008014020020","name":"結華","text":"普段はニンゲンのふりをしているみんな～～！","trans":"平时假扮成人类的大家~~！"},{"id":"3008014020030","name":"恋鐘","text":"こん会場は怪物が占拠したばい～～～","trans":"这个会场已经被怪物占领啦~~~"},{"id":"3008014020040","name":"咲耶","text":"今日は、楽しもう！","trans":"今天就尽情狂欢吧！"},{"id":"3008014020050","name":"摩美々","text":"好きなだけ笑ってー","trans":"尽情欢笑吧"},{"id":"3008014020060","name":"結華","text":"好きなだけ声出していこう……！","trans":"尽情欢呼吧"},{"id":"3008014020070","name":"霧子","text":"うん……！","trans":"嗯……！"},{"id":"0000000000000","name":"スタイリスト","text":"────あらら～","trans":"————哎呀~"},{"id":"0000000000000","name":"スタイリスト","text":"可愛いじゃない、これ","trans":"这不是挺可爱的嘛"},{"id":"3008014020080","name":"霧子","text":"……？","trans":"……？"},{"id":"0000000000000","name":"スタイリスト","text":"これ～！　このポーズ\\nよく撮れてる～","trans":"噢~！这个姿势\\n拍得不错~"},{"id":"3008014020090","name":"霧子","text":"わ……\\nはい……","trans":"啊……\\n嗯……"},{"id":"0000000000000","name":"ディレクター","text":"あー、それいいよねぇ\\nなんだか食べられちゃいそうだなぁ","trans":"啊，这个妆化得很棒\\n就好像真的要被吃掉了一样"},{"id":"0000000000000","name":"スタイリスト","text":"わかるわかる～","trans":"我懂我懂~"},{"id":"3008014020100","name":"霧子","text":"あの……\\nはい……","trans":"那个……\\n嗯……"},{"id":"3008014020110","name":"咲耶","text":"────『袋から取り出し、表面に少量の水をかける』","trans":"————“从袋中取出后，在表面洒上少量的水”"},{"id":"3008014020120","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008014020130","name":"霧子","text":"そうなんです……","trans":"是的……"},{"id":"0000000000000","name":"スタイリスト","text":"あらら～！？","trans":"哎呀~！？"},{"id":"0000000000000","name":"ディレクター","text":"あははっ\\nほんとに食べちゃうの？","trans":"啊哈哈\\n真的要吃人啦？"},{"id":"3008014020140","name":"霧子","text":"はい……","trans":"嗯……"},{"id":"3008014020150","name":"霧子","text":"お水を……かける……","trans":"洒……水……"},{"id":"3008014020160","name":"恋鐘","text":"ちょっとでよかよ～\\nそいばラップでくるんで～……","trans":"稍微洒一点就可以咯~\\n然后用保鲜膜包起来~……"},{"id":"3008014020170","name":"咲耶","text":"ああ\\n『１個につきレンジで10秒』、だそうだよ","trans":"嗯\\n上面有写着“一个转10秒”"},{"id":"3008014020180","name":"霧子","text":"食べちゃいました……"