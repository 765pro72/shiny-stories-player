{
  "translator": "楚西瑜",
  "rows": [
    {
      "id": "2012010040010",
      "name": "凛世",
      "text": "プロデューサーさま……\\nこちらは……",
      "trans": "制作人大人……\\n这个呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『捨て』！",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040020",
      "name": "凛世",
      "text": "はい……\\n承知いたしました……",
      "trans": "嗯……\\n知道了……"
    },
    {
      "id": "2012010040030",
      "name": "凛世",
      "text": "では……\\nこちらは……",
      "trans": "那么……\\n这个呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『捨て』！",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あぁ、いや。お題ボックスか……\\nうーん……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040040",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "こういうのってさ、\\n捨てたら捨てたで、すぐ必要になるんだよな……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040050",
      "name": "凛世",
      "text": "３……２……──",
      "trans": "3……2……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あっ\\n……えっと、『残し』で！",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040060",
      "name": "凛世",
      "text": "はい……\\nふふ……",
      "trans": "嗯……\\n哼哼……"
    },
    {
      "id": "2012010040070",
      "name": "凛世",
      "text": "凛世も……\\n慣れて参りました……",
      "trans": "凛世也……\\n逐渐习惯了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040080",
      "name": "凛世",
      "text": "心を……\\n鬼にし……",
      "trans": "狠下……\\n心来……"
    },
    {
      "id": "2012010040090",
      "name": "凛世",
      "text": "３秒で……\\n処遇を決める……",
      "trans": "3秒内……\\n做出决定……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、ははっ\\nなんか、優柔不断なとこ見せちゃったけど",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040100",
      "name": "凛世",
      "text": "いえ……",
      "trans": "不……"
    },
    {
      "id": "2012010040110",
      "name": "凛世",
      "text": "──こちらは……\\n『捨て』でしょうか……？",
      "trans": "——这个……\\n要“扔掉”吗……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あーっ……\\nそれ、俺がもらってきたやつだ",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040120",
      "name": "凛世",
      "text": "……\\n日めくり……のようです……",
      "trans": "……\\n看起来……像是日历……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん。いや、カレンダーって\\nいっぱいもらっちゃうんだけどさ",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040130",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんか、捨てられなくてな──",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040140",
      "name": "凛世",
      "text": "３……２……──",
      "trans": "3……2……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あーっ、えっと、『残し』！\\n『残し』で！",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "使うよ！",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040150",
      "name": "凛世",
      "text": "プロデューサーさま……？",
      "trans": "制作人大人……？"
    },
    {
      "id": "2012010040160",
      "name": "凛世",
      "text": "ふふ……\\nもう……師走でございますが……",
      "trans": "呵呵……\\n已经是……师走之月了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "まぁ、うん\\nほとんど破っちゃうことにはなるけど……",
      "trans": "“扔掉”！"
    },
    {
      "id": "select",
      "name": "",
      "text": "なんか、な",
      "trans": "总感觉"
    },
    {
      "id": "select",
      "name": "",
      "text": "それ\\nくれた人がさ──",
      "trans": "总感觉"
    },
    {
      "id": "select",
      "name": "",
      "text": "えいっ！\\n考える間に破ろう",
      "trans": "总感觉"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ここまで放っておいて言えることじゃないけど\\nいざ捨てるってなると",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "一緒に頑張ってきた時間って感じがして\\n捨てづらいというか……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040170",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040180",
      "name": "凛世",
      "text": "──ふふ……\\nそのように……勿体なきお言葉……",
      "trans": "——呵呵……\\n像那样……难以割舍的话……"
    },
    {
      "id": "2012010040190",
      "name": "凛世",
      "text": "……\\nめくりましょう……",
      "trans": "……\\n翻篇吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あっ、いいんだ\\n俺の勝手だから俺が──",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040200",
      "name": "凛世",
      "text": "いえ……",
      "trans": "不……"
    },
    {
      "id": "2012010040210",
      "name": "凛世",
      "text": "──１日……\\n２日……３日……──",
      "trans": "——1号……\\n2号……3号……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040220",
      "name": "凛世",
      "text": "失礼いたしました……",
      "trans": "失礼了……"
    },
    {
      "id": "2012010040230",
      "name": "凛世",
      "text": "日々は……\\n積み重ねてゆくもの……",
      "trans": "时光……\\n是会随着日积月累而变得沉重的……"
    },
    {
      "id": "2012010040240",
      "name": "凛世",
      "text": "『３、２、１』では……\\n逆でございます……",
      "trans": "“3，2，1”……\\n反过来了呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世のこと、\\nすごく好きだって言ってくれてて",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040250",
      "name": "凛世",
      "text": "──プロデューサーさま……",
      "trans": "——制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ、そのこと思い出したんだ\\nもらった時は、そんな感じじゃなかったけど",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……時間は経つもんだよなぁ\\n今じゃ『推し』だってさ！",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040260",
      "name": "凛世",
      "text": "……！",
      "trans": "……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん。やっぱり使おう",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040270",
      "name": "凛世",
      "text": "……\\n嬉しいです……",
      "trans": "……\\n我很高兴……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040280",
      "name": "凛世",
      "text": "ありがとうございます……\\nプロデューサーさま……",
      "trans": "制作人大人……\\n非常感谢……"
    },
    {
      "id": "2012010040290",
      "name": "凛世",
      "text": "捨ててよいのは……\\n物……",
      "trans": "可以扔掉的……\\n只有物品……"
    },
    {
      "id": "2012010040300",
      "name": "凛世",
      "text": "ご縁は……\\nけっして……──",
      "trans": "而缘分……\\n绝不会……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "破ったの古紙に出すから、\\nこのまま置いといてくれ",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040310",
      "name": "凛世",
      "text": "はい……\\nふふっ……",
      "trans": "嗯……\\n呵呵……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はぁー……結構重労働だったな\\n──あれ、どうしたんだ凛世？",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それ、古紙にって……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040320",
      "name": "凛世",
      "text": "あ……\\nあの……いえ……──",
      "trans": "啊……\\n那个……不……——"
    },
    {
      "id": "2012010040330",
      "name": "凛世",
      "text": "この日は……\\nプロデューサーさまと……初めてお会いした日……",
      "trans": "这一天……\\n是和制作人大人……初遇的日子……"
    },
    {
      "id": "2012010040340",
      "name": "凛世",
      "text": "この日は……\\nプロデューサーさまと……即席麺を食した日……",
      "trans": "这一天……\\n是和制作人大人……一起吃方便面的日子……"
    },
    {
      "id": "2012010040350",
      "name": "凛世",
      "text": "この日は……──",
      "trans": "这一天……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040360",
      "name": "凛世",
      "text": "３秒……考えたのです……\\nでも……",
      "trans": "虽然……考虑了3秒……\\n但是……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは──\\nそんな紙、取っておいてくれるのか？",
      "trans": "“扔掉”！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……ありがとな\\n俺もそれ、全部大事な日だって思う",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040370",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "心は、鬼になんてなれないよな\\n取っておいてくれるの、嬉しいよ",
      "trans": "“扔掉”！"
    },
    {
      "id": "2012010040380",
      "name": "凛世",
      "text": "プロデューサーさま……\\nはい……",
      "trans": "制作人大人……\\n嗯……"
    }
  ]
}