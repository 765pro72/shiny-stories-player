{
  "translator": "告",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうですか……参加はできませんでしたか",
      "trans": "这样啊……没能顺利出场吗"
    },
    {
      "id": "7901001080010",
      "name": "はづき",
      "text": "……不参加って連絡が来たとき、\\n聞き間違いかと思いました",
      "trans": "……接到未能入选的联络时，\n我还以为自己听错了"
    },
    {
      "id": "7901001080020",
      "name": "はづき",
      "text": "私には、どうして彼女が参加できないのか\\nちっともわかりません……！",
      "trans": "我完全想不通，\n为什么她会无法参赛……！"
    },
    {
      "id": "7902001080010",
      "name": "社長",
      "text": "その気持ちはわかるが……これが結果なんだ\\n受け入れるより他にあるまい",
      "trans": "你的心情我明白……但这就是结果\n除了坦然接受别无选择"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はい……",
      "trans": "好的……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……社長\\n俺、彼女に会いに行ってきます",
      "trans": "……社长\n我要去见她了"
    },
    {
      "id": "7902001080020",
      "name": "社長",
      "text": "ああ、そうするといい",
      "trans": "嗯，去吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────『W.I.N.G.』には\\n出場できない…………",
      "trans": "————《W.I.N.G》\\n你无法出场…………"
    },
    {
      "id": "7026001080050",
      "name": "ルカ",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカ……？",
      "trans": "路加……？"
    },
    {
      "id": "7026001080060",
      "name": "ルカ",
      "text": "笑えよ",
      "trans": "笑啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………ルカ",
      "trans": "…………路加"
    },
    {
      "id": "7026001080070",
      "name": "ルカ",
      "text": "おかしいだろ？",
      "trans": "很好笑吧？"
    },
    {
      "id": "7026001080080",
      "name": "ルカ",
      "text": "だったら笑えよ……！",
      "trans": "那你倒是笑啊……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺は……",
      "trans": "我……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ルカが努力してたのを知ってる\\nだから……",
      "trans": "我知道路加很努力\\n所以……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "悔しいよ────",
      "trans": "很不甘心————"
    }
  ]
