{"translator":"水塔","rows":[{"id":"0000000000000","name":"会議進行役","text":"──内容についてのご説明は以上となります","trans":"——以上是对内容的说明"},{"id":"0000000000000","name":"会議進行役","text":"それでは、この期間のキャンペーン施策につきまして\\n主に自治体の皆さまへのご共有になりますが──","trans":"那么，关于这个期间宣传活动措施\\n主要想跟在座的各位分享一下──"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"2016010010010","name":"千雪","text":"…………","trans":"…………"},{"id":"0000000000000","name":"会議進行役","text":"──少々押しておりまして\\n私共でも現在できる限りの────","trans":"——稍稍推迟了下\\n我们现在所能做的────"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"『寒くないか』","trans":"“觉得冷吗？”"},{"id":"2016010010020","name":"千雪","text":"……！","trans":"……！"},{"id":"0000000000000","name":"プロデューサー","text":"『大丈夫か』","trans":"“还好吗？”"},{"id":"2016010010030","name":"千雪","text":"『大丈夫です\\nもう少しですから』","trans":"“不要紧的\\n就快结束了”"},{"id":"2016010010040","name":"千雪","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"（うん、大丈夫そうだな\\nじゃ────）","trans":"（唔，好像是不要紧\\n那────）"},{"id":"2016010010050","name":"千雪","text":"────あっ消さ……！","trans":"────啊，就擦掉了……！"},{"id":"0000000000000","name":"周囲の参加者","text":"…………？","trans":"…………？"},{"id":"2016010010060","name":"千雪","text":"し、失礼しました……！","trans":"不，不好意思……！"},{"id":"0000000000000","name":"プロデューサー","text":"（千雪……？）","trans":"（千雪……？）"},{"id":"select","name":"","text":"『どうしたんだ？』","trans":"“怎么了吗？”"},{"id":"select","name":"","text":"『やっぱり\\n寒いか？』","trans":"“果然\\n还是冷吗？”"},{"id":"select","name":"","text":"（──ええと、\\n空調は……）","trans":"（──那个\\n空调……）"},{"id":"2016010010070","name":"千雪","text":"『すみません！』","trans":"“非常抱歉！”"},{"id":"2016010010080","name":"千雪","text":"『消したくなくて』","trans":"“不想要擦掉的说”"},{"id":"0000000000000","name":"プロデューサー","text":"……？","trans":"……？"},{"id":"2016010010090","name":"千雪","text":"『なんでもないです』","trans":"“没什么”"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"2016010010100","name":"千雪","text":"『なんでもないです……！』","trans":"“没什么……！”"},{"id":"2016010010110","name":"千雪","text":"ふふっ……","trans":"哼哼～……"},{"id":"2016010010120","name":"千雪","text":"────た、大変失礼しました……","trans":"────真，真的是非常抱歉……"},{"id":"0000000000000","name":"プロデューサー","text":"…………？","trans":"…………？"},{"id":"2016010010130","name":"千雪","text":"──『気遣ってくださったの\\n嬉しくて。それで』","trans":"──“很开心\\n制作人为我担心什么的。而且”"},{"id":"0000000000000","name":"プロデューサー","text":"『ああ……！』","trans":"“啊～……！”"},{"id":"0000000000000","name":"プロデューサー","text":"『グッ！』","trans":"“(•̀ᴗ•́)و”"},{"id":"2016010010140","name":"千雪","text":"…………っ！","trans":"…………哼～！"},{"id":"2016010010150","name":"千雪","text":"『やめてくださいー……！』","trans":"“请别这样～……！”"},{"id":"0000000000000","name":"プロデューサー","text":"『ははは』","trans":"“哈哈哈”"},{"id":"2016010010160","name":"千雪","text":"────ふふっ……","trans":"────哼哼～"},{"id":"2016010010170","name":"千雪","text":"……！","trans":"……！"},{"id":"2016010010180","name":"千雪","text":"『ちがうんです\\n大丈夫です！』","trans":"“不是的\\n没关系的”"},{"id":"0000000000000","name":"プロデューサー","text":"……？","trans":"……？"},{"id":"2016010010190","name":"千雪","text":"『せっかくのお気づかいなのに』","trans":"“好不容易制作人的一番好意”"},{"id":"2016010010200","name":"千雪","text":"『消しちゃったら\\nさびしいじゃないですか』","trans":"“就这样擦掉了话\\n有些空落落的呢”"},{"id":"0000000000000","name":"プロデューサー","text":"（ああ……）","trans":"（啊啊……）"},{"id":"0000000000000","name":"プロデューサー","text":"…………？","trans":"…………？"},{"id":"0000000000000","name":"プロデューサー","text":"（クマ、かな……\\n上手いもんだ）","trans":"（熊吗……\\n挺厉害的嘛）"},{"id":"0000000000000","name":"プロデューサー","text":"（はは、吹き出しがついたぞ……？）","trans":"（哈哈，附上了对话框……？）"},{"id":"2016010010210","name":"クマ","text":"『あったかいですよ～』","trans":"“很暖和哟~”"},{"id":"2016010010220","name":"クマ","text":"『くしゅんっ！』","trans":"“啊啾”"},{"id":"0000000000000","name":"プロデューサー","text":"（……ん？）","trans":"（……唔？）"},{"id":"2016010010230","name":"千雪","text":"『くしゃみしてるやないかい！』","trans":"“像打了喷嚏似的呢？”"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ……","trans":"哈哈哈……"},{"id":"0000000000000","name":"周囲の参加者","text":"……？","trans":"……？"},{"id":"0000000000000","name":"プロデューサー","text":"し、失礼しました……！","trans":"非，非常抱歉……！"},{"id":"2016010010240","name":"千雪","text":"ふふっ……\\nごめんなさい……！","trans":"哼哼～\\n不好意思……！"},{"id":"2016010010250","name":"千雪","text":"あっ……","trans":"啊～"},{"id":"2016010010260","name":"千雪","text":"…………っ","trans":"…………啊"},{"id":"2016010010270","name":"千雪","text":"『あの、もしかして空調』","trans":"“那个，莫非是空调”"},{"id":"0000000000000","name":"プロデューサー","text":"『いいよな』","trans":"“是的”"},{"id":"0000000000000","name":"プロデューサー","text":"『絶対他の人も寒いし、風邪ひくより』","trans":"“就算不感冒，其他人也会觉的冷吧”"},{"id":"2016010010280","name":"千雪","text":"『はい』────","trans":"“嗯”────"},{"id":"0000000000000","name":"プロデューサー","text":"あーっ……長かったなぁ！","trans":"啊～会议真长啊！"},{"id":"2016010010290","name":"千雪","text":"はい……\\n後半は、ほとんど関係のない話題でしたし……","trans":"确实……\\n后半部分，几乎都是无关的话题……"},{"id":"0000000000000","name":"プロデューサー","text":"うん\\n──あれ、それ……","trans":"唔\\n那个，这是……"},{"id":"0000000000000","name":"プロデューサー","text":"その資料、置いてきてよかったんだぞ？\\n俺が持とうか","trans":"这个资料，放着不拿也行的哦\\n要不我帮你拿着吧"},{"id":"2016010010300","name":"千雪","text":"──あっ、いえ……！","trans":"──啊，不是的……！"},{"id":"2016010010310","name":"千雪","text":"これは……\\nふふっ、持って帰るんです","trans":"这个是……\\n哼哼～要带回去的"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"2016010010320","name":"千雪","text":"せっかく、\\nプロデューサーさんの優しいメモが残ってるのに……","trans":"好不容易，\\n上面留下了制作人温柔体贴的留言……"},{"id":"2016010010330","name":"千雪","text":"置いてこれないですから","trans":"不能就这样弃之不顾了"},{"id":"0000000000000","name":"プロデューサー","text":"千雪……？\\n────ああ！　こんなの、そんな大層なもんじゃ──","trans":"千雪……？\\n────啊～！这么，不会太夸张了吗──"},{"id":"2016010010340","name":"千雪","text":"ふふふっ\\n『こんなの』なんて……言っちゃダメです","trans":"哼呵呵～\\n“这么”什么的……不可以说哦"},{"id":"2016010010350","name":"千雪","text":"ほんとに、\\nあったかかったんですもん……！","trans":"因为真的，\\n很温暖的哦……！"}]}