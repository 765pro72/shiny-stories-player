{
  "translator": "阿柚",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────それでは、どうも\\n失礼いたします",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\nええと、駅は────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────\\n花の匂い……",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "……どうしたのォ、駅ー？",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……えっ\\nああ、いえ────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020010",
      "name": "凛世",
      "text": "────どなたも……おられませんか……",
      "trans": "────谁也……不在吗……"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "ここね、地下鉄わかりづらいのよォ\\nちょうどビルの裏っかわが入口。そっちから回れるから",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え、ええ\\nどうも恐れ入ります……",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "ちょうど今時分はさァ、ほら、沈丁花がわーッと咲いて\\nなんだか人がこっち迷い込んでくるからねぇ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020020",
      "name": "凛世",
      "text": "……この香……\\n沈丁の……",
      "trans": "……这是……\\n沈丁花的飘香……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────じんちょうげ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "そう、これ。ウチの\\n見事だろォ？",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020030",
      "name": "凛世",
      "text": "沈丁の……花の香……",
      "trans": "沈丁花的……香气……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははは、じんちょうげ、ですか……\\nいい匂いだなって思ってたとこなんです……綺麗だなぁ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "そォ？　一枝持ってく？",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "えっ、いえいえいえ……！",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "年配の男性",
      "text": "あんたそんな、花の命は短けぇのよ？\\n持ってきな、胸にチョンってぇのも粋だよ、ハハハ！",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020040",
      "name": "凛世",
      "text": "ふふ……どなたでしょう……\\nよい香り……",
      "trans": "哼哼……是哪位呢……\\n这么好闻……"
    },
    {
      "id": "2012015020050",
      "name": "凛世",
      "text": "春を呼ぶ……香り……",
      "trans": "唤来春天的……香气……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……はは、一枝でいいって言ったのになぁ\\n事務所に飾るか────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020060",
      "name": "凛世",
      "text": "────\\nプロデューサーさまは……",
      "trans": "────\\n制作人大人是……"
    },
    {
      "id": "2012015020070",
      "name": "凛世",
      "text": "──『14時：戻り　16時半：撮影立ち合い\\n18時：収録打ち合わせ　19時すぎ：帰社』────",
      "trans": "──『下午两点：回来　下午四点半：摄影会同席\\n晚上六点：参加收录碰头会　晚上七点后：回公司』────"
    },
    {
      "id": "2012015020080",
      "name": "凛世",
      "text": "────その……",
      "trans": "────那个……"
    },
    {
      "id": "2012015020090",
      "name": "凛世",
      "text": "オフの間……\\n事務所へ……伺っても……？",
      "trans": "休息期间……\\n能来事务所……拜访吗……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020100",
      "name": "凛世",
      "text": "────\\n19時すぎ…………",
      "trans": "────\\n过了七点了…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ははっ、凛世\\nそれじゃ休みにならないよ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "仕事禁止、レッスン禁止\\nそのくらいのつもりで、おもいっきり休んでくれ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020110",
      "name": "凛世",
      "text": "……っ",
      "trans": "……呜"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "な？",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020120",
      "name": "凛世",
      "text": "……\\n忘れ物を……",
      "trans": "……\\n忘了东西……"
    },
    {
      "id": "2012015020130",
      "name": "凛世",
      "text": "忘れ物を……\\n取りにきた……だけでございます……",
      "trans": "我只是……\\n来取……我落下的东西……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020140",
      "name": "凛世",
      "text": "────……",
      "trans": "────……"
    },
    {
      "id": "2012015020150",
      "name": "凛世",
      "text": "……\\nただいま……戻りました……────",
      "trans": "……\\n我……回来了……────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……\\n戻りましたー……誰もいないか",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────あれ、これ……\\n凛世のハンカチ……",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020160",
      "name": "凛世",
      "text": "あ",
      "trans": "啊"
    },
    {
      "id": "2012015020170",
      "name": "凛世",
      "text": "沈丁の……花の香……",
      "trans": "沈丁花……的香气……"
    },
    {
      "id": "2012015020180",
      "name": "凛世",
      "text": "……！\\nプロデューサーさま……",
      "trans": "……！\\n制作人大人……"
    },
    {
      "id": "2012015020190",
      "name": "凛世",
      "text": "──は、はい……！\\n杜野でございます────",
      "trans": "──喂，是的……！\\n我是杜野────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、すまん\\n急に────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『────事務所、来てたのか？\\nもしかして忘れ物してるんじゃないかと思ってさ』",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────ははは、やっぱり凛世のだったのか",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020200",
      "name": "凛世",
      "text": "うっかり……いたしました……\\n忘れ物を取りに……いきながら……",
      "trans": "一不小心……就忘记了……\\n还是在去拿……落下的东西的途中……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『単語帳を取りに来たんだっけか\\nハンカチ、事務所で預かっておくから』",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020210",
      "name": "凛世",
      "text": "はい……お願いいたします……\\n…………あの……それで──────",
      "trans": "好的……拜托您了……\\n…………那个……然后──────"
    },
    {
      "id": "2012015020220",
      "name": "凛世",
      "text": "それで……お電話を…………？",
      "trans": "因为这个……您特意打电话来吗…………？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？\\nああ────",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "沈丁花の匂いがする",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────うん、メッセでもよかったんだけど\\nなんとなく……直接伝えようかなってさ",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020230",
      "name": "凛世",
      "text": "……凛世も────\\n────凛世も……お話したかった……",
      "trans": "……凛世也────\\n────凛世也……想和您说话……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『……うん\\nはは、聞かせてくれ』",
      "trans": "────那么\\n我先告辞了"
    },
    {
      "id": "2012015020240",
      "name": "凛世",
      "text": "本日……\\n春の香りが……したのです────",
      "trans": "今天……\\n渐渐有了……春天的香气────"
    }
  ]
}