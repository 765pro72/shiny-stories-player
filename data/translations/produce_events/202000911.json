{"translator":"魚見","rows":[{"id":"2020009110010","name":"透","text":"……","trans":""},{"id":"2020009110020","name":"画面テロップ","text":"『広告スキップまであと５秒』","trans":"“距离跳过广告还有5秒”"},{"id":"2020009110030","name":"透","text":"あ","trans":"啊"},{"id":"0000000000000","name":"プロデューサー","text":"……あれ、電池切れたか？","trans":"……啊嘞，电池没电了？"},{"id":"2020009110040","name":"透","text":"んー……","trans":"嗯—……"},{"id":"0000000000000","name":"プロデューサー","text":"買ってきてもいいぞ。時間あるし","trans":"去买也可以噢。还有时间"},{"id":"2020009110050","name":"透","text":"え？　あー\\n……いい、いい","trans":"诶？　啊—\\n……不用，不用"},{"id":"2020009110060","name":"透","text":"ないし、連絡とか","trans":"又没有，联络之类的"},{"id":"2020009110070","name":"透","text":"一緒いるし","trans":"都在一起"},{"id":"0000000000000","name":"プロデューサー","text":"……そっか？\\nじゃあ","trans":"……这样吗？\\n那行吧"},{"id":"0000000000000","name":"透","text":"コウコク　ノ\\nコトバ　ヲ","trans":"把  广告\\n的  话语"},{"id":"2020009110090","name":"透","text":"……\\nふぁ……","trans":"……\\n呼啊……"},{"id":"0000000000000","name":"プロデューサー","text":"……はは、つまらないんじゃないか？\\nまだ30分はあるぞー","trans":"……哈哈，不会无聊吗？\\n还有30分钟噢—"},{"id":"2020009110100","name":"透","text":"んー……\\n大丈夫。見てるし","trans":"嗯—……\\n没事。在看着"},{"id":"0000000000000","name":"プロデューサー","text":"何を","trans":"看什么"},{"id":"2020009110110","name":"透","text":"プロデューサー","trans":"制作人"},{"id":"0000000000000","name":"プロデューサー","text":"……透ー","trans":"……透—"},{"id":"2020009110120","name":"透","text":"ふふっ\\nううん。お仕事どうぞー","trans":"呵呵\\n没事。请工作吧—"},{"id":"0000000000000","name":"プロデューサー","text":"……ああ、ええと────\\nいや、俺もやることがあるわけじゃなくて","trans":"……啊啊，那个————\\n不是，我也不是有非得做的事"},{"id":"0000000000000","name":"プロデューサー","text":"……話でもするか？","trans":"……要说说话吗？"},{"id":"0000000000000","name":"透","text":"コウコク　ノ\\nコトバ　ヲ","trans":"把  广告\\n的  话语"},{"id":"0000000000000","name":"透","text":"ブツッ　テ\\nチギッ　テ","trans":"打  破\\n撕  碎"},{"id":"2020009110150","name":"透","text":"話","trans":"说话"},{"id":"0000000000000","name":"プロデューサー","text":"うん、話","trans":"嗯，说话"},{"id":"2020009110151","name":"透＆プロデューサー","text":"……","trans":""},{"id":"2020009110152","name":"透＆プロデューサー","text":"……ははっ","trans":"……哈哈"},{"id":"0000000000000","name":"プロデューサー","text":"悪い\\nそんな急に……なぁ","trans":"抱歉\\n这么突然……呐"},{"id":"0000000000000","name":"透","text":"ソレデ、\\nマッテ　タ","trans":"然后，\\n等待着"},{"id":"0000000000000","name":"透","text":"ツギニ\\nハジ　マ　　ル","trans":"后续\\n就此展开"},{"id":"2020009110180","name":"透","text":"じゃ\\n叫んで","trans":"那\\n喊一下"},{"id":"2020009110190","name":"透","text":"叫ぼう","trans":"喊出来吧"},{"id":"0000000000000","name":"透","text":"コトバ　　ヲ","trans":"话语"},{"id":"0000000000000","name":"プロデューサー","text":"……そんな\\nあんまり迷惑になるような────","trans":"……那样的\\n会造成麻烦的————"},{"id":"0000000000000","name":"プロデューサー","text":"────\\n何を叫ぶんだ？","trans":"————\\n要喊什么？"},{"id":"2020009110210","name":"透","text":"……叫んでくれるんだ？","trans":"……愿意喊的啊？"},{"id":"0000000000000","name":"プロデューサー","text":"おう","trans":"噢"},{"id":"2020009110220","name":"透","text":"なんで？","trans":"为什么？"},{"id":"0000000000000","name":"プロデューサー","text":"なんで、って……","trans":"说是为什么……"},{"id":"2020009110230","name":"透","text":"なんでも？\\nなんでも叫ぶ？","trans":"什么都？\\n什么都喊？"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"────なんでもは叫べない","trans":"————什么都喊是不行的"},{"id":"0000000000000","name":"プロデューサー","text":"……尽くすっていうのは、\\nなんでもやることじゃない","trans":"……尽力所指的，\\n并不是什么都做"},{"id":"0000000000000","name":"プロデューサー","text":"でも────","trans":"但是————"},{"id":"0000000000000","name":"プロデューサー","text":"うわーーーーーーー！！！！！","trans":"呜哇啊啊啊啊啊啊啊！！！！！"},{"id":"2020009110240","name":"透","text":"……！","trans":""},{"id":"2020009110250","name":"透","text":"ウワ","trans":"呜哇"},{"id":"0000000000000","name":"プロデューサー","text":"絶対に受け止める\\n透が言うことは","trans":"绝对会接下\\n透说的话"},{"id":"0000000000000","name":"局のスタッフ","text":"どうされました？\\nなんか、声が聞こえた気がして────","trans":"出什么事了吗？\\n好像，听到了叫喊声————"},{"id":"2020009110251","name":"透＆プロデューサー","text":"ああ、すみません……！","trans":"啊啊，非常抱歉……！"},{"id":"2020009110260","name":"透","text":"コトバデハ\\nナカッタ　ガ","trans":"虽然\\n并不是  话语　"},{"id":"2020009110270","name":"透","text":"……ちょっと\\n声出してました","trans":"……稍微\\n出了点声"},{"id":"2020009110280","name":"透","text":"トドイタラシイ","trans":"但似乎传达到了"},{"id":"2020009110290","name":"透","text":"すみません","trans":"非常抱歉"}]}