{"translator":"","rows":[{"id":"3001017030010","name":"真乃","text":"いってきます……っ","trans":"我出发了……"},{"id":"0000000000000","name":"鮮魚店の店主","text":"らっしゃい、らっしゃい！\\n今日はサワラが安いよ～","trans":"欢迎欢迎！\\n今天的马加鰆很便宜哦~"},{"id":"0000000000000","name":"買い物客","text":"お豆腐くださーい","trans":"要块豆腐"},{"id":"0000000000000","name":"青果店の店主","text":"奥さん、おまけしとくね～","trans":"夫人，给您点优惠~"},{"id":"3001017030020","name":"真乃","text":"…………","trans":"……"},{"id":"3001017030030","name":"真乃","text":"──……","trans":"——……"},{"id":"0000000000000","name":"off","text":"『ガラスアクセサリー特集』","trans":"《玻璃饰品合集》"},{"id":"3001017030040","name":"真乃","text":"……綺麗な青……──","trans":"……好漂亮的蓝色……——"},{"id":"3001017030050","name":"真乃","text":"……ふふっ","trans":"……呵呵"},{"id":"0000000000000","name":"雑貨店の店員","text":"いらっしゃいませ","trans":"欢迎光临"},{"id":"3001017030060","name":"真乃","text":"……っ","trans":"……"},{"id":"0000000000000","name":"女性","text":"そうだねぇ、いいお天気で気持ちいいねぇ","trans":"是啊，天气真好，真舒服"},{"id":"0000000000000","name":"女性","text":"あはは、今日は向こうのお花も見ていこっかぁ","trans":"啊哈哈，今天要不去那边赏花吧"},{"id":"3001017030070","name":"真乃","text":"──……","trans":"——……"},{"id":"3001017030080","name":"真乃","text":"私も次はピーちゃんと一緒に来よう","trans":"我下次也和小P一起来吧"},{"id":"0000000000000","name":"洋菓子店の店員","text":"いちごのショートケーキが３点\\nこちらでお間違いないでしょうか？","trans":"草莓蛋糕3组\\n这边没有弄错吧？"},{"id":"3001017030090","name":"真乃","text":"はい","trans":"是"},{"id":"0000000000000","name":"洋菓子店の店員","text":"お持ち歩きのお時間は……","trans":"路上要携带的时间是……"},{"id":"3001017030100","name":"真乃","text":"30分くらいです","trans":"30分钟左右"},{"id":"0000000000000","name":"洋菓子店の店員","text":"かしこまりました","trans":"我明白了"},{"id":"3001017030110","name":"真乃","text":"……？","trans":"……？"},{"id":"0000000000000","name":"off","text":"『来月の新作：アイスケーキ』","trans":"《次月新品：冰淇淋蛋糕》"},{"id":"3001017030120","name":"真乃","text":"ほわ……","trans":"呼哇……"},{"id":"3001017030130","name":"真乃","text":"────……","trans":"——……"},{"id":"0000000000000","name":"洋菓子店の店員","text":"あ！\\nそちら新作のチラシです、よかったらお持ちください","trans":"啊！\\n那是新品的传单，不介意的话请拿走看看"},{"id":"0000000000000","name":"洋菓子店の店員","text":"いちごを使ったアイスのケ