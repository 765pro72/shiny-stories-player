{"translator":"Satorrri","rows":[{"id":"6017003060010","name":"あさひ","text":"……言ったっすよ","trans":"……我说了哦"},{"id":"0000000000000","name":"プロデューサー","text":"──\\nあさひ……","trans":"──\\n朝日……"},{"id":"6017003060020","name":"あさひ","text":"『毎度ありがとうございます』って言ったっすよ\\nステージで","trans":"我过说“谢谢惠顾”了哦\\n在舞台上"},{"id":"6017003060030","name":"あさひ","text":"でも、ダメだったっす","trans":"但是，没用"},{"id":"0000000000000","name":"プロデューサー","text":"…………\\nうん","trans":"…………\\n嗯"},{"id":"6017003060040","name":"あさひ","text":"つまんないっす","trans":"无聊"},{"id":"0000000000000","name":"プロデューサー","text":"──待ってくれ\\nあさひ……ダメじゃないんだ……！","trans":"──等等\\n朝日……不是没有用……！"},{"id":"0000000000000","name":"プロデューサー","text":"すごくすごく……\\n大きい大きい……一歩なんだ……","trans":"这是非常非常……\\n巨大的……一步……"},{"id":"6017003060050","name":"あさひ","text":"…………","trans":""},{"id":"6017003060060","name":"あさひ","text":"…………","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"…………────","trans":""}]}