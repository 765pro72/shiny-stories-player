{"translator":"StYL3","rows":[{"id":"6019004030010","name":"愛依","text":"あのさ\\nプロデューサー","trans":"那个\\n制作人"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"6019004030020","name":"愛依","text":"ファンのみんなに、\\nうちの気持ちちゃんと……","trans":"要把咱的心意，\\n好好地……"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"……ちゃんと……？","trans":"……“好好地”……？"},{"id":"6019004030030","name":"愛依","text":"……やっぱやめとく","trans":"……还是算了吧"},{"id":"0000000000000","name":"プロデューサー","text":"……そうか","trans":"……这样吗"},{"id":"6019004030040","name":"愛依","text":"伝えられた！\\nって言いきれないんなら","trans":"要是没法让断言\\n“传达到了！”的话"},{"id":"6019004030050","name":"愛依","text":"もっとやるしかないっしょ！","trans":"那只能再加把劲了！"}]}