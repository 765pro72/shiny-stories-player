{"translator":"告","rows":[{"id":"3015010020010","name":"甜花","text":"すみません……！\\n人形焼き──","trans":"不好意思……！\\n人形烧——"},{"id":"3015010020020","name":"甜花","text":"えと……何個……？","trans":"那个……要几个……？"},{"id":"3015010020030","name":"甘奈","text":"一袋にして、ふたりでシェアしよ～！","trans":"装一袋，然后两个人分吧~！"},{"id":"3015010020040","name":"甜花","text":"うん……！","trans":"嗯……！"},{"id":"3015010020050","name":"甜花","text":"じゃあ……\\nひとつで……！","trans":"那……\\n要一个……！"},{"id":"3015010020060","name":"甜花","text":"……なーちゃん……","trans":"……小奈……"},{"id":"3015010020070","name":"甘奈","text":"ん～？","trans":"嗯~？"},{"id":"3015010020080","name":"甜花","text":"焼きそば……多かった……","trans":"炒面……好多……"},{"id":"3015010020090","name":"甘奈","text":"わーっ！\\n無理しないで持って帰ろ？　ね？","trans":"哇——！\\n吃不完就带回去吧？ 好吗？"},{"id":"3015010020100","name":"甜花","text":"あうぅ……","trans":"啊呜呜……"},{"id":"3015010020110","name":"甜花","text":"にへへ……\\n虹色の、かき氷……","trans":"诶嘿嘿……\\n彩虹色的，刨冰……"},{"id":"3015010020120","name":"甜花","text":"夢で見たやつと……\\nそっくり……！","trans":"和梦里看到的……\\n好像……！"},{"id":"3015010020130","name":"甘奈","text":"売り切れてなくてよかったよね☆","trans":"没卖完真是太好了☆"},{"id":"3015010020140","name":"甘奈","text":"あ～っ……！　食べるのがもったいないけど、\\n溶けちゃうのももったいない～っ","trans":"啊~……！ 吃了感觉很可惜，\\n可是化掉也一样很可惜呢~"},{"id":"3015010020150","name":"甜花","text":"…………","trans":""},{"id":"3015010020160","name":"甜花","text":"これ……食べたら\\n舌、虹色になっちゃう……？","trans":"这个……吃完了\\n舌头，会变彩虹色吗……？"},{"id":"3015010020170","name":"甘奈","text":"わっ、なっちゃうかも……！？","trans":"哇，可能会……！？"},{"id":"3015010020180","name":"甘奈","text":"甜花ちゃん、先に食べてみない？\\nそれで、甘奈が写真撮ってあげる！","trans":"甜花先吃一口？\\n然后，甘奈拍张照片给你看！"},{"id":"3015010020190","name":"甜花","text":"え……\\nえ……？","trans":"诶……\\n诶……？"},{"id":"3015010020200","name":"甘奈","text":"大丈夫だよ～\\n甜花ちゃん、舌が虹色になってもかわいーもん☆","trans":"没关系啦~\\n甜花舌头变成彩虹色也很可爱——☆"},{"id":"3015010020210","name":"甜花","text":"や、やってみる、ね……！\\nにへへ……！","trans":"试，试试看，好了……！\\n诶嘿嘿……！"},{"id":"3015010020220","name":"甘奈","text":"ふ～……","trans":"呼~……"},{"id":"3015010020230","name":"甘奈","text":"買ったね～","trans":"买了很多呢~"},{"id":"3015010020240","name":"甜花","text":"うん……","trans":"嗯……"},{"id":"3015010020250","name":"甜花","text":"食べた、ね……","trans":"吃饱了，呢……"},{"id":"3015010020260","name":"甘奈","text":"ね～\\n夕飯、ちゃんと入りそう？","trans":"是啊~\\n晚饭，还吃得下吗？"},{"id":"3015010020270","name":"甜花","text":"大丈夫……！\\nちゃんとスペース、残してる……！","trans":"没问题……！\\n肚子，留好了……！"},{"id":"3015010020280","name":"甘奈","text":"さすが甜花ちゃん！\\n偉いよ～っ☆","trans":"不愧是甜花！\\n真棒~☆"},{"id":"3015010020290","name":"甜花","text":"にへへ……\\nママと約束……したから……","trans":"诶嘿嘿……\\n因为……和妈妈约好了……"},{"id":"3015010020300","name":"甘奈","text":"甜花ちゃん、\\nもう食べ損ねたものとかない？","trans":"甜花，\\n还有什么想吃的吗？"},{"id":"3015010020310","name":"甜花","text":"うん……","trans":"嗯……"},{"id":"3015010020320","name":"甜花","text":"これ以上は……\\nスペース……なくなっちゃう……","trans":"再吃……\\n就没肚子……吃晚饭了……"},{"id":"3015010020330","name":"甘奈","text":"そっか～……","trans":"是吗~……"},{"id":"3015010020340","name":"甘奈","text":"……それじゃあ、帰る？","trans":"……那，回家吧？"},{"id":"3015010020350","name":"甜花","text":"うん……\\n帰ろっか……","trans":"嗯……\\n回家吧……"},{"id":"3015010020360","name":"甜花","text":"──……ね","trans":"——……对了"},{"id":"3015010020370","name":"甜花","text":"遠回りして、帰ろ……？","trans":"绕路一下，再回家吧……？"},{"id":"3015010020380","name":"甘奈","text":"……！","trans":""},{"id":"3015010020390","name":"甘奈","text":"──えへへっ\\nうん！","trans":"——诶嘿嘿\\n嗯！"},{"id":"3015010020400","name":"甘奈","text":"甘奈もそれ、思ってた☆","trans":"甘奈，也在想这个☆"},{"id":"3015010020410","name":"甘奈","text":"きっと、遠回りした方が\\n人通りも少ないし──","trans":"绕远路，一定\\n人也会比较少——"},{"id":"3015010020420","name":"甜花","text":"──なーちゃん","trans":"——小奈"},{"id":"3015010020430","name":"甘奈","text":"ん？","trans":"嗯？"},{"id":"3015010020440","name":"甜花","text":"買ったね……","trans":"买了很多呢……"},{"id":"3015010020450","name":"甘奈","text":"うんっ\\n……って、さっきもこれ、話さなかったっけ？","trans":"嗯\\n……这个，刚才好像讲过了吧？"},{"id":"3015010020460","name":"甜花","text":"にへへ……","trans":"嘿嘿……"},{"id":"3015010020470","name":"甘奈","text":"じゃあ──\\n『食べたね』っ","trans":"那——\\n“吃饱了呢”"},{"id":"3015010020480","name":"甜花","text":"うん……！","trans":"嗯……！"},{"id":"3015010020490","name":"甜花","text":"楽しいね……","trans":"好开心……"},{"id":"3015010020500","name":"甘奈","text":"えへへっ、楽しいね☆","trans":"诶嘿嘿，好开心☆"},{"id":"3015010020510","name":"甜花","text":"夏……だね","trans":"是……夏天呢"},{"id":"3015010020520","name":"甘奈","text":"うん！　夏だね","trans":"嗯！ 是夏天呢"},{"id":"3015010020530","name":"甜花","text":"……にへへ……","trans":"……嘿嘿……"}]}