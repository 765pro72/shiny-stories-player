{
  "translator": "",
  "rows": [
    {
      "id": "2018015020010",
      "name": "冬優子",
      "text": "………………",
      "trans": ""
    },
    {
      "id": "2018015020020",
      "name": "冬優子",
      "text": "………………",
      "trans": ""
    },
    {
      "id": "2018015020030",
      "name": "冬優子",
      "text": "………………",
      "trans": "（时间还……有剩吧）"
    },
    {
      "id": "2018015020040",
      "name": "冬優子",
      "text": "…………なんで？",
      "trans": "…………为什么？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そんな大それた理由じゃないんだ\\n冬優子にはリフレッシュしてほしいなって思ってさ",
      "trans": "并不是什么不得了的理由\\n只是希望冬优子能打起精神"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "地方ロケも控えてるし……\\n仕事続きで疲労も溜まってるかなって",
      "trans": "就快要去拍外景了……\\n再工作下去会让你积累疲劳的吧"
    },
    {
      "id": "2018015020050",
      "name": "冬優子",
      "text": "……ふゆが遅刻したこと\\nまだ根に持ってるんだ",
      "trans": "……你还在纠结\\n冬优迟到的事情啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……！\\nいやいや、それは違────",
      "trans": "……！\\n不不，不是这────"
    },
    {
      "id": "2018015020060",
      "name": "冬優子",
      "text": "……冗談\\nそれで、これがそのリフレッシュ案ってわけね",
      "trans": "……开玩笑的\\n所以，这就是你打起精神的方案吧"
    },
    {
      "id": "2018015020070",
      "name": "冬優子",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "2018015020080",
      "name": "冬優子",
      "text": "────あ……",
      "trans": "────啊……"
    },
    {
      "id": "2018015020090",
      "name": "冬優子",
      "text": "これ……知ってる",
      "trans": "这个……我知道"
    },
    {
      "id": "2018015020100",
      "name": "冬優子",
      "text": "溶けた時計……────",
      "trans": "融化的时钟……────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "サウナ、温泉、ヨガ……\\n────と、美術館は違うか……",
      "trans": "桑拿、温泉、瑜伽……\\n————另外还有美术馆……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "取引先にいただいた招待券も余ってるし……\\nよかったら好きなのを持っていってくれ",
      "trans": "客户给的招待券也还有剩余……\\n想去的话，选个喜欢的拿去吧"
    },
    {
      "id": "2018015020110",
      "name": "冬優子",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "2018015020120",
      "name": "冬優子",
      "text": "あんたこそ行けばいいじゃない\\nふゆが休めてないってことは、あんたもそうなんでしょ",
      "trans": "那你怎么不去呢\\n冬优可没时间休息，你也是一样的吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……はは\\nまぁ、そうだな…………",
      "trans": "……哈哈\\n嘛、说得也是…………"
    },
    {
      "id": "2018015020130",
      "name": "冬優子",
      "text": "溶けてる────３つとも…………",
      "trans": "在融化着────三个同时…………"
    },
    {
      "id": "2018015020140",
      "name": "冬優子",
      "text": "…………──────",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "館内スタッフ",
      "text": "────お客様",
      "trans": "────客人"
    },
    {
      "id": "2018015020150",
      "name": "冬優子",
      "text": "──────\\n……はいっ",
      "trans": "──────\\n……是的"
    },
    {
      "id": "0000000000000",
      "name": "館内スタッフ",
      "text": "長時間ご覧になるようでしたら、館内奥に\\n休憩所がございますので、よろしければご利用ください",
      "trans": "如果您需要长时间参观，请前往展馆里面\\n那里有休息处，不介意的话请随意使用"
    },
    {
      "id": "2018015020160",
      "name": "冬優子",
      "text": "お気遣いありがとうございます",
      "trans": "谢谢您的关心"
    },
    {
      "id": "2018015020170",
      "name": "冬優子",
      "text": "…………\\n……そんな経って────",
      "trans": "…………\\n……居然过了这么久……"
    },
    {
      "id": "2018015020180",
      "name": "冬優子",
      "text": "────っ\\nあれ……？",
      "trans": "────\\n咦……？"
    },
    {
      "id": "2018015020190",
      "name": "冬優子",
      "text": "────嘘",
      "trans": "────不会吧"
    },
    {
      "id": "2018015020200",
      "name": "冬優子",
      "text": "…………壊れた……？",
      "trans": "…………坏掉了……？"
    },
    {
      "id": "2018015020210",
      "name": "冬優子",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "2018015020220",
      "name": "冬優子",
      "text": "……っ",
      "trans": "……！"
    },
    {
      "id": "2018015020221",
      "name": "冬優子＆プロデューサー",
      "text": "────すみません……！",
      "trans": "────对不起……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "冬優子……！？",
      "trans": "冬优子……！？"
    },
    {
      "id": "2018015020230",
      "name": "冬優子",
      "text": "……っ\\nなんであんた……！",
      "trans": "……哈\\n为什么你会……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "その、チケットが１枚減ってたから……\\n冬優子が関心あるものは、一応知っておこうかなって……",
      "trans": "那个，因为少了一张票……\\n于是想起码去了解一下，冬优子感兴趣的东西……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……すまん！\\nまさか同じ日時に被るとは思わなくて…………",
      "trans": "……抱歉！\\n没想到会在同一时间碰上…………"
    },
    {
      "id": "2018015020240",
      "name": "冬優子",
      "text": "リフレッシュって……\\nこれじゃ、いつもと変わんないじゃない",
      "trans": "说是打气精神……\\n这样一来，不就和平时没两样吗"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは…………",
      "trans": "哈哈…………"
    },
    {
      "id": "2018015020250",
      "name": "冬優子",
      "text": "…………はぁ",
      "trans": "…………哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……冬優子",
      "trans": "……冬优子"
    },
    {
      "id": "2018015020260",
      "name": "冬優子",
      "text": "…………何？",
      "trans": "…………怎么？"
    },
    {
      "id": "select",
      "name": "",
      "text": "どうして美術館に？",
      "trans": "为什么会来美术馆?"
    },
    {
      "id": "select",
      "name": "",
      "text": "気晴らしになったか？",
      "trans": "是在散心吗？"
    },
    {
      "id": "select",
      "name": "",
      "text": "勉強熱心だな",
      "trans": "真是热衷学习啊"
    },
    {
      "id": "2018015020270",
      "name": "冬優子",
      "text": "あんたが提案したんじゃない……",
      "trans": "不是你提的建议吗……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうだけど────\\nあの中で、なんでかなって",
      "trans": "虽说是这样……\\n为什么，会在其中选择这个"
    },
    {
      "id": "2018015020280",
      "name": "冬優子",
      "text": "……べつに────\\nそういう気分だっただけ",
      "trans": "……没什么────\\n心血来潮而已"
    },
    {
      "id": "2018015020290",
      "name": "冬優子",
      "text": "……理由なんてないわよ",
      "trans": "……没什么理由"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そっか……",
      "trans": "是嘛……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "けど……いいよな、美術館も\\n落ち着くっていうか、研ぎ澄まされるようで",
      "trans": "不过……美术馆也挺不错嘛\\n能让人冷静下来，或是说给人一种耳目一新的感觉"
    },
    {
      "id": "2018015020300",
      "name": "冬優子",
      "text": "……浅いコメント",
      "trans": "……浅陋的评价"
    },
    {
      "id": "2018015020310",
      "name": "冬優子",
      "text": "……ちょっとはね",
      "trans": "……也算是吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ならよかった",
      "trans": "那还好"
    },
    {
      "id": "2018015020320",
      "name": "冬優子",
      "text": "…………お腹空いた",
      "trans": "…………肚子饿了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "お……\\nどこか寄っていくか？",
      "trans": "噢……\\n想去哪里转一转？"
    },
    {
      "id": "2018015020330",
      "name": "冬優子",
      "text": "……なんで一緒に帰る前提なのよ",
      "trans": "……为什么要以一起回去为前提啊"
    },
    {
      "id": "2018015020340",
      "name": "冬優子",
      "text": "ま、いいけど……？\\nそろそろ帰ろうと思ってたとこ",
      "trans": "算了，也没差……?\\n我想差不多也该回去了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "よし、決まりだな",
      "trans": "好，就这么定了"
    },
    {
      "id": "2018015020350",
      "name": "冬優子",
      "text": "……そういうんじゃないわよ",
      "trans": "……也不是这么一回事"
    },
    {
      "id": "2018015020360",
      "name": "冬優子",
      "text": "なんとなく……\\nただの気分",
      "trans": "不知怎么……\\n只是刚好有这种心情"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん……\\nちゃんとリフレッシュできたならいいんだ",
      "trans": "嗯……\\n要是能让你打起十二分精神就好了"
    },
    {
      "id": "2018015020370",
      "name": "冬優子",
      "text": "それどころか……\\n長居しすぎてクタクタ",
      "trans": "哪算得上啊……\\n待得太久反而更累了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、そろそろ出ようか\\n帰りは送るよ",
      "trans": "哈哈，差不多该出去了吧\\n我送你回去"
    },
    {
      "id": "2018015020380",
      "name": "冬優子",
      "text": "…………お節介どうも",
      "trans": "…………谢谢你的多管闲事"
    }
  ]
}