{"translator":"可可","rows":[{"id":"2024009110010","name":"にちか","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"はっ…………はっ…………","trans":"哈啊…………哈啊…………"},{"id":"0000000000000","name":"プロデューサー","text":"────","trans":"────"},{"id":"2024009110020","name":"にちか","text":"…………はー……","trans":"…………呼……"},{"id":"0000000000000","name":"プロデューサー","text":"────……","trans":"────……"},{"id":"0000000000000","name":"プロデューサー","text":"はぁ……はぁ……\\nすまん……！　遅くなった……","trans":"哈啊……哈啊……\\n抱歉……！　我来晚了……"},{"id":"2024009110030","name":"にちか","text":"……あ","trans":"……啊"},{"id":"0000000000000","name":"プロデューサー","text":"──……っ","trans":"──……唔"},{"id":"0000000000000","name":"プロデューサー","text":"……しまった……\\nファスナー…………！","trans":"……糟了……\\n包的拉链…………！"},{"id":"0000000000000","name":"プロデューサー","text":"────あ\\nありがとう…………にちか","trans":"────啊\\n谢谢…………日花"},{"id":"2024009110040","name":"にちか","text":"……\\nこれ間に合います……？","trans":"……\\n还来得及吗……？"},{"id":"0000000000000","name":"プロデューサー","text":"……ああ……うん\\n時間的には、まだ大丈夫だ…………","trans":"……啊……嗯\\n从时间上来说，还好…………"},{"id":"0000000000000","name":"プロデューサー","text":"ごめんな……！\\n急いで車まわしてくる────","trans":"抱歉……！\\n我马上就去把车开过来────"},{"id":"2024009110050","name":"にちか","text":"────ちょ…………","trans":"────等…………"},{"id":"2024009110060","name":"にちか","text":"…………靴下……！","trans":"…………袜子……！"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？ "},{"id":"2024009110070","name":"にちか","text":"スラックス……！\\n靴下、巻き込んでます……","trans":"裤脚……！\\n给袜子，卷进去了……"},{"id":"0000000000000","name":"プロデューサー","text":"──あっ！\\n本当だ…………","trans":"──啊！\\n真的…………"},{"id":"0000000000000","name":"プロデューサー","text":"あ、ありが────","trans":"谢，谢谢────"},{"id":"2024009110080","name":"にちか","text":"ネクタイも！","trans":"领带也有问题！"},{"id":"0000000000000","name":"プロデューサー","text":"…………え？","trans":"…………诶？"},{"id":"2024009110090","name":"にちか","text":"……あーーーもーーー……","trans":"……啊───真是───……"},{"id":"2024009110100","name":"にちか","text":"ガチで敏腕だな……！\\nその格好で出るつもりだったんです……！？","trans":"你不是很认真能干吗……！\\n结果就穿成这个样子出门的啊……！？"},{"id":"0000000000000","name":"プロデューサー","t