{"translator":"煉金術式","rows":[{"id":"3024014020010","name":"にちか","text":"……うん、録画OK","trans":"……在录了，OK"},{"id":"3024014020020","name":"にちか","text":"あと、１分","trans":"还有一分钟"},{"id":"3024014020030","name":"にちか","text":"えー……","trans":"欸……"},{"id":"3024014020040","name":"にちか","text":"──あ、宅配便……ですか\\nはい、今出まーす","trans":"——啊，外卖……是吧\\n好的，就来——"},{"id":"3024014020050","name":"にちか","text":"……あー\\nもう始まっちゃってるし","trans":"……啊\\n已经开始了欸"},{"id":"3024014020060","name":"にちか","text":"…………","trans":""},{"id":"3024014020070","name":"にちか","text":"うん──\\n大丈夫、うん……","trans":"嗯——\\n没问题，嗯……"},{"id":"3024014020080","name":"にちか","text":"よかった\\nちゃんと、見られるやつ","trans":"还好\\n还算看得过去"},{"id":"3024014020090","name":"off","text":"初見の人が見ても\\nちゃんと全然、大丈夫なやつ","trans":"新观众看来\\n也没哪里不自然"},{"id":"3024014020100","name":"off","text":"──見られる","trans":"——还看得过去"},{"id":"3024014020110","name":"off","text":"見てもらえる","trans":"还能继续下去"},{"id":"3024014020120","name":"off","text":"私たちの……","trans":"我们的……"},{"id":"3024014020130","name":"にちか","text":"あ……\\n……────","trans":"啊……\\n……————"},{"id":"3024014020140","name":"にちか","text":"怖くても","trans":"即使再害怕"},{"id":"3024014020150","name":"美琴","text":"積み重ねて","trans":"经历、积累"},{"id":"3024014020160","name":"にちか","text":"見つめる","trans":"也要看向"},{"id":"3024014020170","name":"美琴","text":"ステージ","trans":"舞台"},{"id":"3024014020180","name":"にちか","text":"立ちたい","trans":"登上舞台"},{"id":"3024014020190","name":"美琴","text":"立ち続ける","trans":"永不退场"},{"id":"3024014020191","name":"にちか＆美琴","text":"────────","trans":""},{"id":"3024014020200","name":"にちか","text":"…………","trans":""},{"id":"3024014020210","name":"にちか","text":"見てる","trans":"视线交错"},{"id":"3024014020220","name":"にちか","text":"見つめ返してる","trans":"看着对方的眼睛"},{"id":"3024014020230","name":"にちか","text":"うん──","trans":"嗯——"},{"id":"3024014020240","name":"にちか","text":"練習、するしかない","trans":"……还得再练练啊"},{"id":"3024014020250","name":"にちか","text":"たぶん","trans":"或许"},{"id":"3024014020260","name":"にちか","text":"あ……","trans":"啊……"},{"id":"3024014020270","name":"美琴","text":"お疲れ様","trans":"辛苦了"},{"id":"3024014020280","name":"にちか","text":"お疲れ様です……！","trans":"您辛苦了……！"},{"id":"3024014020290","name":"美琴","text":"これから仕事？","trans":"之后还有工作？"},{"id":"3024014020300","name":"にちか","text":"いえ、ちょっと書類を取りに来ただけなので……","trans":"没，只是来取点材料……"},{"id":"3024014020310","name":"美琴","text":"そうなんだ","trans":"这样啊"},{"id":"3024014020320","name":"にちか","text":"あ、あの……","trans":"那、那个……"},{"id":"3024014020330","name":"美琴","text":"…………","trans":""},{"id":"3024014020340","name":"にちか","text":"…………","trans":""},{"id":"3024014020350","name":"美琴","text":"……","trans":""},{"id":"3024014020360","name":"にちか","text":"えっ","trans":"欸"},{"id":"3024014020370","name":"美琴","text":"昨日、見た？","trans":"昨天看了吗？"},{"id":"3024014020380","name":"にちか","text":"はい……","trans":"嗯……"},{"id":"3024014020390","name":"美琴","text":"あの時は、やってみようっていう\\n気持ちだけだったから","trans":"明明当时只是\\n抱着试一试的心态……"},{"id":"3024014020400","name":"美琴","text":"改めてちゃんと見てみたの","trans":"但是如今再看"},{"id":"3024014020410","name":"美琴","text":"悪くなかったね","trans":"还挺不错的嘛"},{"id":"3024014020420","name":"にちか","text":"そう……ですね","trans":"是……是呢"},{"id":"3024014020430","name":"美琴","text":"呼び止めてごめんね\\n気を付けて帰って","trans":"耽误你了吧\\n回去时加点小心"},{"id":"3024014020440","name":"にちか","text":"あ……はい\\n失礼します","trans":"啊……好的\\n那我就先走啦"},{"id":"3024014020450","name":"にちか","text":"……卵と、お味噌も買っておくか","trans":"……鸡蛋、味精都买了吧"},{"id":"3024014020460","name":"にちか","text":"──あ、バター安","trans":"——啊，黄油有够便宜"},{"id":"3024014020470","name":"にちか","text":"いや、まだマーガリン残ってるし\\n……やめとこ","trans":"不对，家里人造黄油还有剩\\n……还是算了"},{"id":"3024014020480","name":"にちか","text":"……","trans":""},{"id":"3024014020490","name":"美琴","text":"悪くなかったね","trans":"还挺不错的嘛"},{"id":"3024014020500","name":"off","text":"悪くなかった","trans":"还挺不错的"},{"id":"3024014020510","name":"off","text":"なら、きっと……","trans":"那么，只要……"},{"id":"3024014020520","name":"off","text":"練習すればもっとよくなる","trans":"只要继续练习，就能变得更好"},{"id":"3024014020530","name":"にちか","text":"…………","trans":""},{"id":"3024014020540","name":"にちか","text":"バター買ってこ","trans":"果然黄油也买上吧"}]}