{"translator":"","rows":[{"id":"3027006030010","name":"羽那","text":"──────あれ","trans":"——————咦"},{"id":"3027006030020","name":"羽那","text":"ルカちゃん──！","trans":"路加——！"},{"id":"3027006030030","name":"羽那","text":"すごーい\\n会えて嬉しいっ","trans":"好—开心\\n能在这里遇到你"},{"id":"3027006030040","name":"羽那","text":"ルカちゃんもあれ、見に来たの？","trans":"路加也是来看那个的吗？"},{"id":"3027006030050","name":"ルカ","text":"────","trans":"————"},{"id":"3027006030060","name":"ルカ","text":"……違う","trans":"……不是的"},{"id":"3027006030070","name":"羽那","text":"そうなんだー\\nあたしは見に来たんだよ","trans":"这样啊—\\n我倒是特地来看的哦"},{"id":"3027006030080","name":"羽那","text":"色んなところに\\nコメティックのポスターがあって、すごいよねーっ","trans":"好厉害啊\\n每个角落都贴着CoMETIK的海报"},{"id":"3027006030090","name":"ルカ","text":"……","trans":"……"},{"id":"3027006030100","name":"羽那","text":"それで、今度はるきちゃんとも\\n一緒に見に来ようねって話してるの","trans":"而且，我还和阳希约好了\\n下次要一起来看"},{"id":"3027006030110","name":"羽那","text":"ルカちゃんも来る？","trans":"路加要一起吗？"},{"id":"3027006030120","name":"ルカ","text":"行かねぇ","trans":"我不来"},{"id":"3027006030130","name":"羽那","text":"えーっ、残念","trans":"诶，真可惜"},{"id":"3027006030140","name":"羽那","text":"ねぇルカちゃん、お腹空いてない？","trans":"那个路加，你饿不饿呀？"},{"id":"3027006030150","name":"羽那","text":"何か食べる？","trans":"我们要不要去找点什么东西吃？"},{"id":"3027006030160","name":"ルカ","text":"いい","trans":"我不饿"},{"id":"3027006030170","name":"羽那","text":"ハンバーガーとか──！","trans":"汉堡之类的——！"},{"id":"3027006030180","name":"ルカ","text":"気分じゃない","trans":"没心情"},{"id":"3027006030190","name":"羽那","text":"そっかーっ……","trans":"这样啊……"},{"id":"3027006030200","name":"ルカ","text":"…………","trans":"…………"},{"id":"3027006030210","name":"羽那","text":"あっ──","trans":"啊——"},{"id":"3027006030220","name":"羽那","text":"じゃあ、お茶するのはどう？","trans":"那，要不要去喝杯茶"},{"id":"3027006030230","name":"羽那","text":"ほら、そこのお店","trans":"你看，那边那家店"},{"id":"3027006030240","name":"羽那","text":"期間限定のホワイトチョコキャラメルラテも\\nやってるって──！","trans":"好像在卖限时销售的\\n白巧克力焦糖拿铁哦——！"},{"id":"3027006030250","name":"ルカ","text":"…………","trans":"…………"},{"id":"3027006030260","name":"ルカ","text":"……テイクアウトなら","trans":"……如果能打包的话"},{"id":"3027006030270","name":"羽那","text":"本当？　やったーっ","trans":"真的吗？  好耶"},{"id":"3027006030280","name":"羽那","text":"じゃあメニュー表見よっか","trans":"那我们去看看菜单吧"},{"id":"3027006030290","name":"ルカ","text":"引っ張んな","trans":"别拽我"},{"id":"3027006030300","name":"羽那","text":"ふふっ──！","trans":"呵呵——！"},{"id":"3027006030310","name":"羽那","text":"ルカちゃん、あのね──","trans":"路加，那个——"},{"id":"3027006030320","name":"ルカ","text":"ついてくんな","trans":"别跟我"},{"id":"3027006030330","name":"羽那","text":"あはっ、違った","trans":"啊哈，是我想错了"},{"id":"3027006030340","name":"ルカ","text":"……？","trans":"……？"},{"id":"3027006030350","name":"羽那","text":"なんでもないよ","trans":"没事啦"},{"id":"3027006030360","name":"羽那","text":"ルカちゃん、何にするか決めた？","trans":"路加决定好要点什么了吗？"},{"id":"3027006030370","name":"ルカ","text":"…………","trans":"…………"},{"id":"3027006030380","name":"ルカ","text":"……つーか","trans":"……我说啊"},{"id":"3027006030390","name":"ルカ","text":"さっきから質問ばっか\\nそっちはどうなんだよ","trans":"你从刚刚开始就一直问个不停\\n你自己倒是选好了没有啊"},{"id":"3027006030400","name":"羽那","text":"そっち────","trans":"我选的是————"},{"id":"3027006030410","name":"羽那","text":"──って、どっち？","trans":"——什么来着？"},{"id":"3027006030420","name":"ルカ","text":"……は","trans":"……哈"},{"id":"3027006030430","name":"ルカ","text":"…………","trans":"…………"},{"id":"3027006030440","name":"羽那","text":"あはっ、嘘\\nごめんね──！","trans":"啊哈，骗你的\\n不好意思——！"},{"id":"3027006030450","name":"羽那","text":"あたしもまだ決めてないの","trans":"我也还没决定好点哪个"},{"id":"3027006030460","name":"羽那","text":"だから、ふたりでゆっくり決めよう？","trans":"所以说，我们两个慢慢决定吧？"},{"id":"3027006030470","name":"羽那","text":"……ね？","trans":"……好吗？"},{"id":"3027006030480","name":"ルカ","text":"もう決めた","trans":"选好了"},{"id":"3027006030490","name":"ルカ","text":"買ってくる","trans":"我去买"},{"id":"3027006030500","name":"羽那","text":"えー、早ーいっ","trans":"诶，太快了啦"},{"id":"3027006030510","name":"羽那","text":"待ってルカちゃんーっ──！","trans":"路加等等我——！"}]}