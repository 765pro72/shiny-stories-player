{"translator":"Clôture","rows":[{"id":"6020004030010","name":"透","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nいいステージだよ、すごく","trans":"……舞台表现，真的很不错哦"},{"id":"6020004030020","name":"透","text":"……\\nあー","trans":"……\\n啊——"},{"id":"0000000000000","name":"プロデューサー","text":"……心配か？","trans":"……担心吗？"},{"id":"6020004030030","name":"透","text":"……ふふっ\\n何、真似？","trans":"……嘻嘻\\n这是什么？模仿我的？"},{"id":"6020004030040","name":"透","text":"まあ、いるし。みんなも\\nそれに────","trans":"算了，确实在担心，大家也是\\n而且——"},{"id":"6020004030050","name":"透","text":"────わかんないや","trans":"——我不明白啊"},{"id":"6020004030060","name":"透","text":"でも\\n考えなくてよくなる","trans":"但是\\n在这里的时候"},{"id":"6020004030070","name":"透","text":"ここにいる時は","trans":"不用想那么多让我感觉很好"},{"id":"0000000000000","name":"プロデューサー","text":"……透","trans":"……透"},{"id":"6020004030080","name":"透","text":"わかるんだ、ここなら\\nどうすればいいか","trans":"我明白\\n在这里该怎么做"},{"id":"0000000000000","name":"プロデューサー","text":"うん","trans":"嗯"}]}