{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "user-5",
      "name": "プロデューサー",
      "text": "──お疲れ様\r\nその……────",
      "trans": "──辛苦了\n那个……────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100020",
      "name": "凛世",
      "text": "プロデューサーさまには……",
      "trans": "……制作人大人的话……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100030",
      "name": "凛世",
      "text": "お聴き……\r\nいただけたでしょうか……",
      "trans": "您有……\n听到吗……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-8",
      "name": "プロデューサー",
      "text": "──……\r\nうん。『欲しい』って、きこえた",
      "trans": "──……\n嗯。我听见了“想要”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-9",
      "name": "プロデューサー",
      "text": "『聞いてほしい』『見てほしい』……\r\n『みんなの心を動かしたい』って────",
      "trans": "“希望你们听”“希望你们看”……\n“想打动大家的心”────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-13",
      "name": "プロデューサー",
      "text": "──いいステージだった",
      "trans": "──是一场很棒的演出",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100060",
      "name": "凛世",
      "text": "ありがとうございます……\r\nもう……大丈夫でございます……",
      "trans": "谢谢您……\n已经……没关系了……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100070",
      "name": "凛世",
      "text": "凛世にも……聞こえますゆえ……──",
      "trans": "因为凛世也……听得见……──",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-20",
      "name": "プロデューサー",
      "text": "……うん",
      "trans": "……嗯",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100080",
      "name": "凛世",
      "text": "次は……結果も……\r\n求めてまいります……",
      "trans": "下次……我也会去追求……\n结果……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "6012003100090",
      "name": "凛世",
      "text": "もっと……\r\n『わがまま』に……────",
      "trans": "要更加……\n“任性”一点……────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
