{"translator":"煉金術式","rows":[{"id":"6026003020010","name":"ルカ","text":"あぁ…………","trans":"啊…………"},{"id":"6026003020020","name":"ルカ","text":"…………よかった\\nまだ、奪わないで済む……","trans":"…………太好了\\n还不用夺走什么……"},{"id":"6026003020030","name":"ルカ","text":"……次も──必ず──……","trans":"……下次──也要──……"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ！","trans":"路加！"},{"id":"6026003020040","name":"ルカ","text":"！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"予選突破おめでとう、ルカ……！\\n今日のパフォーマンスも──","trans":"恭喜你通过预选，路加……！\\n今天的表演也很──"},{"id":"6026003020050","name":"ルカ","text":"いちいちうるせェ","trans":"啰嗦死了"},{"id":"6026003020060","name":"ルカ","text":"……もう行く","trans":"……我走了"},{"id":"0000000000000","name":"プロデューサー","text":"え！？\\nお、おう！　わかった……！","trans":"啊！？\\n哦，好的……！"}]}