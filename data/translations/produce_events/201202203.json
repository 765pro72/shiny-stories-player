{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "user-2",
      "name": "衣装スタッフ",
      "text": "うん、丈感もバッチリですね",
      "trans": "嗯，长度也刚刚好呢",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-4",
      "name": "プロデューサー",
      "text": "よく似合ってるよ、凛世",
      "trans": "很适合你哦，凛世",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-6",
      "name": "衣装スタッフ",
      "text": "杜野さんらしい可愛らしさもありながら、\r\nヒールの高い靴が大人っぽさを演出していて……",
      "trans": "有杜野风格的可爱，\n同时高跟鞋又营造出成熟感……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-7",
      "name": "衣装スタッフ",
      "text": "今までとは違う杜野さんって感じで、\r\nとっても素敵ですね",
      "trans": "感觉像是和以往不同的杜野\n非常棒哦",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030010",
      "name": "凛世",
      "text": "──……\r\nありがとうございます……",
      "trans": "──……\n谢谢您……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030020",
      "name": "off",
      "text": "ヒールの高い……\r\n靴…………",
      "trans": "高高的……\n鞋…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030030",
      "name": "off",
      "text": "今までとは違う……\r\n杜野さん────…………",
      "trans": "和以往不同的……\n杜野────…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-22",
      "name": "プロデューサー",
      "text": "凛世、靴の高さも大丈夫そうか？",
      "trans": "凛世，鞋的高度也没问题吗？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030040",
      "name": "凛世",
      "text": "──はい……\r\n問題……ございません……",
      "trans": "──是……\n没有……问题……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-25",
      "name": "プロデューサー",
      "text": "……そうか、よかった────",
      "trans": "……这样啊，太好了────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-28",
      "name": "プロデューサー",
      "text": "私の方からも特にございません\r\n色々とご配慮いただき、ありがとうございました",
      "trans": "我这边也没有什么特别的意见\n感谢您多方照顾",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-29",
      "name": "衣装スタッフ",
      "text": "とんでもないです\r\nそれではこちらの衣装で進行しますね────",
      "trans": "哪里的话\n那么就按这套服装进行吧────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030050",
      "name": "凛世",
      "text": "薩摩芋の甘煮……鯛めし……\r\n洋菓子……紅茶……",
      "trans": "甜煮红薯……鲷鱼饭……\n西式点心……红茶……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030060",
      "name": "凛世",
      "text": "…………手紙……",
      "trans": "…………信……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-43",
      "name": "凛世の母",
      "text": "『食材の他、新調の襦袢と防寒用の足袋も\r\n入れました』",
      "trans": "“除了食材，也放进了新做的襦袢\n和防寒用的足袋”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030070",
      "name": "凛世",
      "text": "母さま……\r\n────…………",
      "trans": "母亲……\n────…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-52",
      "name": "高校生作家",
      "text": "なんていうか……\r\nあの絵の少女、すごく幼く見えたんですよね",
      "trans": "怎么说呢……\n画里那个少女，看起来非常年幼",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030080",
      "name": "off",
      "text": "……違う…………",
      "trans": "……不对…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030090",
      "name": "凛世",
      "text": "────凛世は…………\r\n成長を……────",
      "trans": "────凛世……\n成长────……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-63",
      "name": "凛世の母",
      "text": "『他に必要なものがあれば伝えてください\r\nすぐに送ります』",
      "trans": "“如果还有需要的东西请告诉我\n我马上寄过去”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030110",
      "name": "凛世",
      "text": "少女に手を……差し伸べてくださる方がいれば……",
      "trans": "如果有人……肯向少女伸出手……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030120",
      "name": "off",
      "text": "────違う………………",
      "trans": "────不对………………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030130",
      "name": "凛世",
      "text": "………………違わない────\r\n────何も…………",
      "trans": "………………没有不对────\n────什么都没有…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030140",
      "name": "凛世",
      "text": "──────成長したのは……\r\n……アイドルとして──────",
      "trans": "──────成长了的……\n……是作为偶像的部分──────",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030150",
      "name": "凛世",
      "text": "────凛世は……………\r\nまだ………………",
      "trans": "────凛世……………\n还………………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030160",
      "name": "凛世",
      "text": "──幼い………………",
      "trans": "──太幼小………………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030180",
      "name": "凛世",
      "text": "────ああ…………\r\n────────ああ………………",
      "trans": "────啊…………\n────────啊………………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030190",
      "name": "凛世",
      "text": "もっと……\r\n────しなくては…………",
      "trans": "必须……\n────更加…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-106",
      "name": "カメラマン",
      "text": "うーん……\r\n凛世ちゃん、ちょっとごめんね",
      "trans": "嗯……\n凛世，稍微打扰一下",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-107",
      "name": "カメラマン",
      "text": "なんだか、いつもの凛世ちゃんらしくないっていうか……\r\nもう少し可愛らしい感じでお願いできるかな？",
      "trans": "总觉得，不太像平时的凛世……\n能再可爱一点的感觉吗？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030200",
      "name": "凛世",
      "text": "……\r\n……はい…………",
      "trans": "……\n……是…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-126",
      "name": "トレーナー",
      "text": "もっと殻を破るように！\r\n大きく！",
      "trans": "要更打破外壳！\n再大一点！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030230",
      "name": "off",
      "text": "もっと……大きく……\r\nもっと…………高く…………",
      "trans": "更加……大……\n更加…………高…………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-136",
      "name": "トレーナー",
      "text": "きつそうに見せない！",
      "trans": "别让人看出你很吃力！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030260",
      "name": "off",
      "text": "飛ばなければ………………",
      "trans": "不跳不行………………",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030270",
      "name": "off",
      "text": "もっと────………………！",
      "trans": "再多一点————………………！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-146",
      "name": "プロデューサー",
      "text": "凛世っ────",
      "trans": "凛世————",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-151",
      "name": "プロデューサー",
      "text": "よかったよ、どこも怪我がなくて",
      "trans": "太好了，哪里都没受伤",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030290",
      "name": "凛世",
      "text": "ご心配を……\r\nおかけいたしました……",
      "trans": "让您……\n担心了……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-155",
      "name": "プロデューサー",
      "text": "いや、凛世が無事ならいいんだ\r\nただ…………凛世、あのさ────",
      "trans": "不，只要你平安就好\n只是…………凛世，那个————",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030300",
      "name": "凛世",
      "text": "……っプロデューサーさま……\r\n申し訳ございません……",
      "trans": "……制作人大人……\n非常抱歉……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030310",
      "name": "凛世",
      "text": "本日は……\r\n調子が悪く……",
      "trans": "今天……\n状态不太好……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "2012022030320",
      "name": "凛世",
      "text": "その…………\r\n明日以降は……しっかりと──……",
      "trans": "那个…………\n明天之后……我会好好──……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-164",
      "name": "プロデューサー",
      "text": "俺は、凛世と話したいだけだよ\r\n今の凛世自身のことを",
      "trans": "我只是想和凛世聊聊\n聊聊现在的凛世自己",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-168",
      "name": "プロデューサー",
      "text": "それに、調子が悪そうに見えるのは\r\n今日に限った話じゃない",
      "trans": "而且，你看起来状态不好\n也不只是今天的事",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-169",
      "name": "プロデューサー",
      "text": "座談会の日からずっとだ",
      "trans": "从座谈会那天起就一直这样",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-172",
      "name": "プロデューサー",
      "text": "話し合おう、凛世\r\n凛世のことを、ちゃんと────",
      "trans": "我们谈谈吧，凛世\n好好谈谈凛世你的事————",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-176",
      "name": "プロデューサー",
      "text": "座談会の時のこと、\r\nまだ気にしてるんだよな",
      "trans": "座谈会那时候的事，\n你还在介意吧",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-181",
      "name": "プロデューサー",
      "text": "────少し、話し合おう",
      "trans": "————稍微，聊一聊吧",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-183",
      "name": "プロデューサー",
      "text": "凛世が何を考え、何に悩んで、\r\nどうしたいと思っているのか……",
      "trans": "凛世在想什么，烦恼什么，\n又想要怎么做……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-187",
      "name": "プロデューサー",
      "text": "落ち着いて、話をしよう\r\n凛世が今、抱えているもののこと",
      "trans": "冷静下来，我们谈谈\n谈谈凛世你现在背负的东西",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-191",
      "name": "プロデューサー",
      "text": "俺にどう思われるかとか、どう見られるかとか、\r\nそういうのは、今は一切気にしないでほしい",
      "trans": "我会怎么想、会怎么看你，\n这些现在请你完全不要在意",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-192",
      "name": "プロデューサー",
      "text": "凛世の中にあるものを、ありのまま見せてほしい\r\n────俺にも、分けてほしいんだ",
      "trans": "希望你原样展现你心里的东西\n————也希望能分给我一些",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
