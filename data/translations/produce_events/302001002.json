{"translator":"Simizu1","rows":[{"id":"3020010020010","name":"透","text":"ういーん……がしゃ","trans":"嗡—……咔嚓"},{"id":"3020010020020","name":"小糸","text":"……","trans":""},{"id":"3020010020030","name":"透","text":"ういーん……","trans":"嗡—……"},{"id":"3020010020040","name":"透","text":"ういーん、がしゃ","trans":"嗡—，咔嚓"},{"id":"3020010020050","name":"小糸","text":"……","trans":""},{"id":"3020010020060","name":"小糸","text":"と、透ちゃん……","trans":"小、小透……"},{"id":"3020010020070","name":"透","text":"ういーん……","trans":"嗡……"},{"id":"3020010020080","name":"透","text":"うぃんうぃんうぃんうぃん……","trans":"嗡嗡嗡嗡……"},{"id":"3020010020090","name":"小糸","text":"ぴぇ……！\\n透ちゃ──────","trans":"噫……！\\n小透————"},{"id":"3020010020091","name":"透＆小糸","text":"お疲れ様でーす……","trans":"辛苦了……"},{"id":"3020010020100","name":"小糸","text":"あ、あれ……\\n誰もいないね……？","trans":"诶，诶……\\n谁都不在呢……？"},{"id":"3020010020110","name":"透","text":"んー","trans":"嗯—"},{"id":"3020010020120","name":"小糸","text":"鍵、返したらすぐ出る……？","trans":"还了钥匙之后马上就走……？"},{"id":"3020010020130","name":"透","text":"んー","trans":"嗯—"},{"id":"3020010020140","name":"小糸","text":"じゃ、戻してくる────","trans":"那，我去去就回———"},{"id":"3020010020150","name":"透","text":"あ\\n待った","trans":"啊\\n等一下"},{"id":"3020010020160","name":"小糸","text":"────！\\nど、どうしたの……？","trans":"———！\\n怎，怎么了……？"},{"id":"3020010020170","name":"透","text":"やばい\\nあれ","trans":"糟糕\\n那个"},{"id":"3020010020180","name":"小糸","text":"────ぴぇ……！","trans":"———噫……！"},{"id":"3020010020181","name":"透＆小糸","text":"カマキリいる……","trans":"有只螳螂……"},{"id":"3020010020190","name":"透","text":"────うぃんうぃんうぃんうぃん……","trans":"———嗡嗡嗡嗡……"},{"id":"3020010020200","name":"小糸","text":"と、透ちゃん……！","trans":"小、小透……！"},{"id":"3020010020201","name":"透＆小糸","text":"か、カマキリの動きに音つけるの、怖いよ……！","trans":"给，给螳螂的动作配音什么的，好可怕啊……！"},{"id":"3020010020210","name":"透","text":"……え？　んー","trans":"……诶？嗯—"},{"id":"3020010020220","name":"透","text":"でも、暇だし\\n誰か来るまで","trans":"不过，毕竟很闲啊\\n在谁来之前"},{"id":"3020010020230","name":"透","text":"……動いたっ\\nいけ、もっと右、右……ガシャーン……","trans":"……动了\\n上吧，再往右边一点，右边……咔嚓……"},{"id":"3020010020240","name":"小糸","text":"……","trans":""},{"id":"3020010020250","name":"小糸","text":"も、もうちょっと窓の近くに行ってくれたら\\n入れるのにな……","trans":"要，要是再往窗户那边靠近一点的话\\n就能进去了呢……"},{"id":"3020010020260","name":"透","text":"……んー","trans":"……嗯—"},{"id":"3020010020270","name":"透","text":"置いてく？　鍵\\nここに","trans":"放下就走？钥匙\\n放在这"},{"id":"3020010020280","name":"小糸","text":"え……？","trans":"诶……？"},{"id":"3020010020290","name":"透","text":"カマキリいるので、入れませんでしたって","trans":"就说有螳螂在，不敢进去"},{"id":"3020010020300","name":"小糸","text":"……！\\nわ、わかるかな……","trans":"……！\\n会，会明白吗……"},{"id":"3020010020310","name":"透","text":"わかるわかる\\nある？　書くもの────","trans":"会的会的\\n有吗？能写字的———"},{"id":"3020010020311","name":"透＆小糸","text":"…………！","trans":""},{"id":"3020010020320","name":"小糸","text":"と、飛んだ……！","trans":"飞、飞起来了……！"},{"id":"3020010020321","name":"透＆小糸","text":"わ……！","trans":"哇……！"},{"id":"3020010020330","name":"小糸","text":"……\\nさ、さっきより後退しちゃったね……","trans":"……\\n我、我比刚才还要害怕呢……"},{"id":"3020010020340","name":"透","text":"んー……","trans":"嗯—……"},{"id":"3020010020350","name":"透","text":"だって、めっちゃ構えてるし\\nうちらに","trans":"毕竟，超级戒备呢\\n对我们"},{"id":"3020010020360","name":"小糸","text":"……\\nそ、そうだね……","trans":"……\\n说、说的是呢……"},{"id":"3020010020370","name":"小糸","text":"それじゃ────","trans":"那就———"},{"id":"3020010020380","name":"小糸","text":"『注意！　ここにレッスン室の』────","trans":"『注意！ 训练室的』———"},{"id":"3020010020390","name":"透","text":"こらー、もうよしなさい……\\n君のお母さんは泣いているー……","trans":"你这家伙—，快停手吧……\\n你的母亲非常伤心—……"},{"id":"3020010020400","name":"小糸","text":"──……\\n『鍵があります』────","trans":"——……\\n『钥匙在这里』———"},{"id":"3020010020410","name":"透","text":"武器を下ろしなさい……\\nきみはよく頑張ったー……","trans":"快放下武器……\\n你做得已经够好了—……"},{"id":"3020010020420","name":"小糸","text":"……『カマキリが入り口にいたため』────","trans":"……『由于在入口处有只螳螂』"},{"id":"3020010020430","name":"透","text":"ここにいても何も解決しない……\\nおとなしく立ち退きなさーい……","trans":"你待在这里也改变不了什么……\\n老老实实离开吧……"},{"id":"3020010020440","name":"小糸","text":"────\\n『ここに置いて帰ります。申し訳ありません』","trans":"———\\n『就放在这里了。非常抱歉』"},{"id":"3020010020450","name":"小糸","text":"よ、よし────","trans":"好、好了———"},{"id":"3020010020460","name":"透","text":"言ってやって、小糸ちゃんも","trans":"小糸也，来试着说说"},{"id":"3020010020470","name":"小糸","text":"────え……！","trans":"——诶……？"},{"id":"3020010020480","name":"透","text":"こいつに","trans":"对这家伙"},{"id":"3020010020490","name":"透","text":"聞いてるから、ほら","trans":"它有在听，你看"},{"id":"3020010020500","name":"小糸","text":"……！\\nえ……！　き、聞いてるって言われても────","trans":"……！\\n诶……！就，就算你说它有在听———"},{"id":"3020010020510","name":"透","text":"聞けー\\nこれから小糸ちゃんが話すー……","trans":"听好了—\\n接下来小小糸要讲话了—……"},{"id":"3020010020520","name":"小糸","text":"ぴぇ……","trans":"噫……"},{"id":"3020010020530","name":"透","text":"いけるいける\\nがつんと","trans":"能行的能行的\\n狠一点"},{"id":"3020010020540","name":"小糸","text":"う、うん……","trans":"嗯、嗯……"},{"id":"3020010020541","name":"透＆小糸","text":"……せ、せっかくの夏なのに────","trans":"……明、明明是宝贵的夏天———"},{"id":"3020010020550","name":"小糸","text":"────え……？","trans":"————诶……？"},{"id":"3020010020560","name":"透","text":"言って","trans":"说吧"},{"id":"3020010020570","name":"小糸","text":"う、うん……","trans":"嗯、嗯……"},{"id":"3020010020571","name":"透＆小糸","text":"……せっかくの夏なのに、\\nここにいたら時間がもったい────","trans":"……明、明明是宝贵的夏天，\\n待在这里的话时间就都浪费—-"},{"id":"3020010020580","name":"小糸","text":"ここにいたら時間がもったいないよ……！","trans":"待在这里的话时间就都浪费掉了哦……！"},{"id":"3020010020581","name":"透＆小糸","text":"飛んだ……！","trans":"飞起来了……！"},{"id":"3020010020590","name":"小糸","text":"い、行っちゃったね……！","trans":"飞、飞走了呢……！"},{"id":"3020010020600","name":"透","text":"うん……\\nすごい、小糸ちゃん","trans":"嗯……\\n好厉害，小小糸"},{"id":"3020010020610","name":"透","text":"いいこと言う","trans":"说得真不错"}]}