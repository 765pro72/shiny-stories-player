{
  "translator": "",
  "rows": [
    {
      "id": "3007020040010",
      "name": "結華",
      "text": "プロデューサー、いるー？",
      "trans": "Producer，在嘛——？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おお、結華か\\nいるよ。どうぞ",
      "trans": "哦哦，是结华啊\\n在的哦。请进"
    },
    {
      "id": "3007020040020",
      "name": "結華",
      "text": "はーい",
      "trans": "好的——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "どうかしたか？",
      "trans": "怎么了吗？"
    },
    {
      "id": "3007020040030",
      "name": "結華",
      "text": "や、着替えみんなより先に終わったからさ\\nこのあとのこともっかい確認しとこうと思って",
      "trans": "没事，就是换衣服比大家稍微快了一点\\n想着趁这时候来再确认一遍后续事宜"
    },
    {
      "id": "3007020040040",
      "name": "結華",
      "text": "変わりない？",
      "trans": "没有变动吧？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ\\n特に変更点は聞いてないよ",
      "trans": "嗯嗯\\n没收到其他变更通知"
    },
    {
      "id": "3007020040050",
      "name": "結華",
      "text": "おっけーありがと",
      "trans": "Okay感谢"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おう",
      "trans": "嗯"
    },
    {
      "id": "3007020040060",
      "name": "結華",
      "text": "……ところでＰたん",
      "trans": "……话说回来，P碳"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん？",
      "trans": "嗯？"
    },
    {
      "id": "3007020040070",
      "name": "結華",
      "text": "三峰に他に何か\\n言うことないです？",
      "trans": "就没有什么其他的\\n想对三峰我说的吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "他に……\\nああ",
      "trans": "其他的……\\n对了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "結華は黒うさぎなんだな",
      "trans": "结华是黑色兔子啊"
    },
    {
      "id": "3007020040080",
      "name": "結華",
      "text": "そうだけどそうじゃないー！",
      "trans": "话说得没错但没问这个——！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ",
      "trans": "哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "冗談だよ\\n衣装、よく似合ってる",
      "trans": "开个玩笑\\n衣服，很适合你哦"
    },
    {
      "id": "3007020040090",
      "name": "結華",
      "text": "最初からそれ言って！",
      "trans": "一开始就该说这句的！"
    },
    {
      "id": "3007020040091",
      "name": "結華＆プロデューサー",
      "text": "──ふふふっ",
      "trans": "——哈哈哈"
    },
    {
      "id": "3007020040100",
      "name": "結華",
      "text": "意地悪めー",
      "trans": "坏心眼的家伙——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "試すような言い方するのは\\n意地悪じゃないのか？",
      "trans": "试探性的这种问法\\n就不是坏心眼了吗？"
    },
    {
      "id": "3007020040110",
      "name": "結華",
      "text": "今のがもう意地悪な返しじゃん！",
      "trans": "刚刚明明都使坏回来了嘛！"
    },
    {
      "id": "3007020040111",
      "name": "結華＆プロデューサー",
      "text": "──",
      "trans": ""
    },
    {
      "id": "3007020040112",
      "name": "結華＆プロデューサー",
      "text": "──あははっ",
      "trans": "——啊哈哈"
    }
  ]
}