{"translator":"Satorrri","rows":[{"id":"5005004010001","name":"一同","text":"────…………","trans":""},{"id":"5005004010010","name":"愛依","text":"……誰もしゃべらないね\\n集中してる……","trans":"……谁都不说话呢\\n都很集中……"},{"id":"5005004010020","name":"あさひ","text":"早くやりたいっすよ","trans":"想早点上场哦"},{"id":"5005004010030","name":"冬優子","text":"もうちょっとでしょ、待ちなさいよ","trans":"还有一会儿了，再等等吧"},{"id":"5005004010040","name":"冬優子","text":"──……っていうか、硬い","trans":"──……话说，好硬"},{"id":"5005004010050","name":"愛依","text":"……え？","trans":"……诶？"},{"id":"5005004010060","name":"冬優子","text":"はい、肩回してー","trans":"好，活动活动肩——"},{"id":"5005004010061","name":"あさひ＆愛依","text":"はーい","trans":"好——"},{"id":"5005004010070","name":"冬優子","text":"次\\n吸ってー、吐いてー……吸ってー、吐いてー","trans":"接下来\\n吸气，吐气……吸气，吐气"},{"id":"5005004010071","name":"あさひ＆愛依","text":"…………","trans":""},{"id":"5005004010080","name":"冬優子","text":"よし","trans":"好"},{"id":"5005004010090","name":"冬優子","text":"────ふゆは、誰にも負けない","trans":"────冬优我，不会输给任何人"},{"id":"5005004010100","name":"あさひ","text":"わたしも負けないっすよ！","trans":"我也不会输的哦！"},{"id":"5005004010110","name":"愛依","text":"うちも──負けない……！","trans":"咱也──不会输……！"},{"id":"5005004010120","name":"冬優子","text":"見せつけるわよ\\nストレイライトの──最高地点","trans":"让你们看看\\nStraylight的──最高峰"},{"id":"5005004010121","name":"あさひ＆愛依","text":"おー！","trans":"哦！"}]}