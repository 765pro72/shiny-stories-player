{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"……そろそろ出番だな","trans":"……差不多到你出场了"},{"id":"0000000000000","name":"プロデューサー","text":"一応、今回の審査について\\nもらってきた情報を共有しておくと──","trans":"关于这次审查\\n我先跟你分享我获得的情报——"},{"id":"6026001010010","name":"ルカ","text":"いらねぇって言ってんだろ……","trans":"我不是说了不要……"},{"id":"0000000000000","name":"プロデューサー","text":"でも、情報はあった方が……","trans":"但是，有情报会更……"},{"id":"6026001010020","name":"ルカ","text":"何度も言わすなよ","trans":"要我说几次"},{"id":"6026001010030","name":"ルカ","text":"誰のサポートもいらねぇ","trans":"我不要任何人的支援"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ…………","trans":"路加…………"},{"id":"6026001010040","name":"ルカ","text":"あと少し……","trans":"还差一点……"},{"id":"6026001010050","name":"ルカ","text":"あと少し…………","trans":"还差一点…………"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"}]}