{"translator":"铃叶","rows":[{"id":"6020003010010","name":"透","text":"ねぇ","trans":"呐"},{"id":"6020003010020","name":"透","text":"勝ったらさ、すごい？","trans":"假如赢了的话，很厉害吧？"},{"id":"0000000000000","name":"プロデューサー","text":"そりゃあ、うん\\nすごいよ","trans":"那样的话，嗯\\n很厉害哦"},{"id":"6020003010030","name":"透","text":"……あー\\nじゃなくって、なんだろ。偉い？","trans":"……啊\\n不是，那换个问法。了不起？"},{"id":"0000000000000","name":"プロデューサー","text":"え？\\n勝ったらか","trans":"诶？\\n如果赢了的话么"},{"id":"6020003010040","name":"透","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"プロデューサー","text":"……偉い、と思うよ\\nそれだけが偉さってわけじゃないけど","trans":"……算了不起吧\\n但我觉得也没到那种程度"},{"id":"6020003010050","name":"透","text":"……あー\\nんーと────","trans":"……啊\\n嗯────"},{"id":"6020003010060","name":"透","text":"────いいや、行ってくるね","trans":"────不想了，我出发了"},{"id":"0000000000000","name":"プロデューサー","text":"────透……","trans":"────透……"}]}