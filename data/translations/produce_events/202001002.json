{"translator":"魚見","rows":[{"id":"2020010020010","name":"透","text":"──────\\nあー……","trans":"——————\\n啊——……"},{"id":"2020010020020","name":"透","text":"あじ","trans":"有"},{"id":"2020010020030","name":"透","text":"する","trans":"味道"},{"id":"2020010020040","name":"透","text":"────ベベベベーン……","trans":"————penpenpenpen——……"},{"id":"0000000000000","name":"ニュースの音声","text":"『────と寒気の影響で\\n平野部では雨が雪に変わり』────","trans":"“————冷空气影响\\n平原地区将经历降雨转变为降雪”————"},{"id":"2020010020050","name":"透","text":"……べべ、べべべべー────","trans":"……penpen，penpenpenpen————"},{"id":"2020010020060","name":"透","text":"────っつ\\nあつ……","trans":"————烫\\n好烫……"},{"id":"2020010020070","name":"透","text":"３分３分……","trans":"三分钟三分钟……"},{"id":"2020010020080","name":"透","text":"……あれ、４分？","trans":"……咦，四分钟？"},{"id":"2020010020090","name":"透","text":"『お湯を入れて４分待ち、液体スープを』────\\nあー……","trans":"“注入热水后等待四分钟，将液体汤料”————\\n啊——……"},{"id":"2020010020100","name":"透","text":"４分\\nしゃー","trans":"四分钟\\n好嘞"},{"id":"0000000000000","name":"ニュースの音声","text":"『お天気の次は、今週のお出かけ情報です』────","trans":"“天气预报过后，是本周的出游情报”"},{"id":"2020010020110","name":"透","text":"ベベベベーン……","trans":"penpenpenpen——……"},{"id":"0000000000000","name":"プロデューサー","text":"────冷えるな……","trans":"————降温了啊……"},{"id":"0000000000000","name":"プロデューサー","text":"……\\n腹も減った……","trans":"……\\n肚子也饿了……"},{"id":"0000000000000","name":"ラジオの音声","text":"『──日朝までの24時間に降る雪の量は\\nいずれも多いところで』────","trans":"“——日早为止24小时的降雪量\\n不管怎么说都不在少”————"},{"id":"0000000000000","name":"プロデューサー","text":"ああ……","trans":"啊啊……"},{"id":"2020010020120","name":"透","text":"ベベン、べーン……","trans":"penpen，pen——……"},{"id":"0000000000000","name":"プロデューサー","text":"あったかいものが食べたい……！","trans":"想吃点热的……！"},{"id":"2020010020130","name":"透","text":"────しゃー\\nきたきた……","trans":"————好嘞\\n来了来了……"},{"id":"0000000000000","name":"プロデューサー","text":"────ただいまです……\\n……カップ麺１つ残ってたよな","trans":"————我回来了……\\n……我记得还剩下桶杯面"},{"id":"2020010020140","name":"透","text":"液体スープ……調味オイル……","trans":"液体汤料……调味油……"},{"id":"0000000000000","name":"プロデューサー","text":"寒い寒い……","trans":"好冷好冷……"},{"id":"2020010020141","name":"透＆プロデューサー","text":"ただいま────","trans":"我开动了————\\n我回来了————"},{"id":"2020010020150","name":"透","text":"あ……","trans":"啊……"},{"id":"0000000000000","name":"プロデューサー","text":"あ、おう……","trans":"啊，噢……"},{"id":"0000000000000","name":"プロデューサー","text":"来てたのか","trans":"你来了啊"},{"id":"2020010020160","name":"透","text":"え、んー\\n────","trans":"诶，嗯——\\n————"},{"id":"0000000000000","name":"プロデューサー","text":"はは、いいもの食べてるなぁ","trans":"哈哈，在吃好东西呢"},{"id":"2020010020170","name":"透","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"プロデューサー","text":"俺もちょうどさ────","trans":"我也正准备————"},{"id":"0000000000000","name":"プロデューサー","text":"────あれっ","trans":"————咦"},{"id":"0000000000000","name":"プロデューサー","text":"えっと……あれっ\\n透さ、このへんにそれと同じカップ麺──────","trans":"呃呃……咦\\n透啊，有看到这里和你那杯一样的——————"},{"id":"2020010020180","name":"透","text":"え","trans":"诶"},{"id":"2020010020190","name":"透","text":"──────あー……！","trans":"——————啊——……！"},{"id":"2020010020200","name":"透","text":"汁、いる？　もっと","trans":"汤汁，要吗？　再加点"},{"id":"0000000000000","name":"プロデューサー","text":"もう十分だよ\\nありがとう","trans":"已经很够了\\n谢谢"},{"id":"2020010020210","name":"透","text":"んー","trans":"嗯——"},{"id":"0000000000000","name":"プロデューサー","text":"──────あー……！","trans":"——————啊——……！"},{"id":"2020010020220","name":"透","text":"……怒ってる？","trans":"……生气了？"},{"id":"0000000000000","name":"プロデューサー","text":"怒ってないよ","trans":"没有啊"},{"id":"2020010020230","name":"透","text":"怒ってるねー","trans":"生气了啊——"},{"id":"0000000000000","name":"プロデューサー","text":"えっ、いや……！\\n半分ももらっちゃって、むしろ悪いなっていうか────","trans":"诶，没……！\\n你都分我一半了，倒不如说不好意思————"},{"id":"2020010020240","name":"透","text":"──────あー……！\\nふふふっ、食べた？","trans":"——————啊——……！\\n呵呵呵，吃到了吗？"},{"id":"0000000000000","name":"プロデューサー","text":"あー……！　はははっ\\nいや……","trans":"啊——……！　哈哈哈\\n不是……"},{"id":"0000000000000","name":"プロデューサー","text":"雪なんて、口に入ったかもわからないよ\\n小さすぎる……！","trans":"雪什么的，都不清楚有没有进到嘴里啊\\n太小了……！"},{"id":"2020010020250","name":"透","text":"えー","trans":"诶——"},{"id":"0000000000000","name":"プロデューサー","text":"さ、車入ってくれ\\n冷えないうちに帰────","trans":"来，快上车吧\\n在降温之前回————"},{"id":"2020010020260","name":"透","text":"あー……\\n────あ……","trans":"啊——……\\n————啊……"},{"id":"2020010020270","name":"透","text":"あじ","trans":"有"},{"id":"2020010020280","name":"透","text":"味する","trans":"味道"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"select","name":"","text":"……はは、何味だ？","trans":"……哈哈，是什么味？"},{"id":"select","name":"","text":"……\\nあー……！","trans":"……\\n啊——……！"},{"id":"select","name":"","text":"……\\nするかな？","trans":"……\\n有味道吗？"},{"id":"2020010020290","name":"透","text":"んー……\\nゆきあじ？","trans":"嗯——……\\n雪味"},{"id":"0000000000000","name":"プロデューサー","text":"……雪味","trans":"……雪味"},{"id":"2020010020300","name":"透","text":"食べてよ、ほらー……！","trans":"尝尝嘛，你看——……！"},{"id":"2020010020310","name":"透","text":"デザートー\\nおごりー……！","trans":"饭后甜点\\n我请客——……！"},{"id":"0000000000000","name":"プロデューサー","text":"────ははは、気にしてたのか……","trans":"————哈哈哈，还在在意吗……"},{"id":"2020010020320","name":"透","text":"早くー……！\\n何味ー……？","trans":"快点——……！\\n什么味道——？"},{"id":"2020010020330","name":"透","text":"美味しい？","trans":"好吃吗？"},{"id":"0000000000000","name":"プロデューサー","text":"えっと、うーん……","trans":"呃呃，嗯——……"},{"id":"2020010020340","name":"透","text":"カップ麺より？","trans":"跟杯面比起来？"},{"id":"0000000000000","name":"プロデューサー","text":"……はは、気にしてるのか\\n美味しい、以外で答えるのは？","trans":"……哈哈，你还在在意吗\\n好吃，这之外的回答是？"},{"id":"2020010020350","name":"透","text":"ダメ","trans":"不行"},{"id":"0000000000000","name":"プロデューサー","text":"じゃ","trans":"那"},{"id":"0000000000000","name":"プロデューサー","text":"美味しいよ、透","trans":"很好吃哟，透"},{"id":"2020010020360","name":"透","text":"するって\\nほら","trans":"都说有了\\n你看"},{"id":"0000000000000","name":"プロデューサー","text":"あっ……！\\nいや、ええとべつに腹は────","trans":"啊……！\\n不是，那个倒不是肚子————"},{"id":"2020010020370","name":"透","text":"……食べてく？　うちで\\n少なかったし","trans":"……去吃吗？　在我家\\n刚也没吃到多少"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、いや、そんなわけにはいかないよ……！\\n────さっきのは、ほんと気にしてないから","trans":"啊啊，不是，那样可不行啊……！\\n————刚才那事，真的没在意啦"},{"id":"2020010020380","name":"透","text":"雪","trans":"雪"},{"id":"0000000000000","name":"プロデューサー","text":"えっ","trans":"诶"},{"id":"2020010020390","name":"透","text":"雪食べてく？　って聞いたのー……\\nうちでー……！","trans":"在问你“要不要吃雪？”啊——……\\n在我家——……！"}]}