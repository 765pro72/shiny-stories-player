{"translator":"魚見","rows":[{"id":"3023009010010","name":"雛菜","text":"………ふ……ぁ……","trans":"………呼……啊……"},{"id":"3023009010020","name":"雛菜","text":"また跳ねた～","trans":"又溅起来了～"},{"id":"3023009010030","name":"小糸","text":"え……\\nど、どこ……？","trans":"诶……\\n哪、哪里……？"},{"id":"3023009010040","name":"雛菜","text":"ほら、あそこ～","trans":"你看，那边～"},{"id":"3023009010050","name":"小糸","text":"ほ、ほんとだ……！","trans":"真、真的耶……！"},{"id":"3023009010060","name":"雛菜","text":"湖、おっきいね～","trans":"这湖可真大啊～"},{"id":"3023009010070","name":"小糸","text":"う、うん……！\\nここ湖じゃなくて、池なんだって……！","trans":"嗯、嗯……！\\n好像说这个不是湖，是池塘来着……！"},{"id":"3023009010080","name":"雛菜","text":"そうなんだ～","trans":"这样啊～"},{"id":"3023009010090","name":"雛菜","text":"ね～\\nあれって鴨……？","trans":"嗳～\\n那个是鸭子……？"},{"id":"3023009010100","name":"透","text":"え？\\nあー","trans":"诶？\\n啊——"},{"id":"3023009010110","name":"透","text":"そう、かも","trans":"可能、是呀"},{"id":"3023009010120","name":"雛菜","text":"あは～","trans":"啊哈～"},{"id":"3023009010130","name":"雛菜","text":"オヤジギャグ～","trans":"大叔玩笑～"},{"id":"3023009010140","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3023009010150","name":"円香","text":"……","trans":""},{"id":"3023009010160","name":"小糸","text":"お、遅いね……\\nスタッフさん……","trans":"好、好慢啊……\\n工作人员……"},{"id":"3023009010170","name":"雛菜","text":"ね～……","trans":"是吧～……"},{"id":"3023009010180","name":"小糸","text":"まだかかるのかな……","trans":"还要等多久呢……"},{"id":"3023009010190","name":"雛菜","text":"…………ふぁ……","trans":"…………呼啊……"},{"id":"0000000000000","name":"撮影スタッフ","text":"──────すみませーん！\\nお待たせしちゃって……","trans":"——————非常抱歉——！\\n让你们等这么久……"},{"id":"0000000000000","name":"撮影スタッフ","text":"監督がちょっと構図が気に入らないみたいで\\nミーティング長引いちゃってて……","trans":"监督好像是对构图有点不满意\\n会议拖久了……"},{"id":"0000000000000","name":"撮影スタッフ","text":"時間かかりそうなので、\\nみなさんは休憩入っちゃいましょうか","trans":"感觉还要花点时间，\\n各位先去休息一下吧"},{"id":"3023009010191","name":"一同","text":"はーい","trans":"好——"},{"id":"3023009010200","name":"雛菜","text":"ずっと見てると眠くなっちゃうね～","trans":"一直看下去感觉有点困呢～"},{"id":"3023009010210","name":"小糸","text":"そ、そう……？\\nわたしは、綺麗だと思うけど……","trans":"这、这样吗……？\\n我觉得很漂亮呀……"},{"id":"3023009010220","name":"雛菜","text":"へ～？","trans":"诶～？"},{"id":"3023009010230","name":"雛菜","text":"──────あっ","trans":"——————啊"},{"id":"3023009010240","name":"雛菜","text":"ね、見て～\\n池に木がうつってる～","trans":"嗳、快看～\\n池子里映着树～"},{"id":"3023009010250","name":"雛菜","text":"なんかこういうの見たことあるよね～？","trans":"感觉之前有看过这样的对吧～？"},{"id":"3023009010260","name":"透","text":"おー\\n逆さま","trans":"噢——\\n反转"},{"id":"3023009010270","name":"小糸","text":"う、うん……！\\n逆さ富士みたいだね","trans":"嗯、嗯……！\\n就像富士倒影一样"},{"id":"3023009010280","name":"雛菜","text":"……！\\nそうだ～","trans":"……！\\n对了～"},{"id":"3023009010290","name":"小糸","text":"ぴぇ……\\nひ、雛菜ちゃん……！","trans":"噼诶……\\n雏、雏菜……！"},{"id":"3023009010300","name":"雛菜","text":"あは～\\n落ちる～～！","trans":"啊哈～\\n掉下去了～～！"},{"id":"3023009010310","name":"透","text":"おー","trans":"噢——"},{"id":"3023009010320","name":"小糸","text":"ひ、雛菜ちゃん……！","trans":"雏、雏菜……！"},{"id":"3023009010330","name":"雛菜","text":"小糸ちゃんもどう～？\\nせっかくスタッフさんがシート敷いてくれたんだし","trans":"小糸也来吧～？\\n难得工作人员都帮我们铺好薄膜了"},{"id":"3023009010340","name":"小糸","text":"そ、そっか……","trans":"对、对哦……"},{"id":"3023009010350","name":"雛菜","text":"見て、透先輩～\\n雛菜飛んでる～","trans":"看、透前辈～\\n雏菜在飞～"},{"id":"3023009010360","name":"透","text":"ふふっ\\nやばい","trans":"呵呵\\n不得了"},{"id":"3023009010370","name":"透","text":"イエー","trans":"耶——"},{"id":"3023009010380","name":"小糸","text":"じ、じゃあ……\\nわたしも……！","trans":"那、那……\\n我也来……！"},{"id":"3023009010390","name":"雛菜","text":"あは～\\nひっくり返った～","trans":"啊哈～\\n翻转过来了～"},{"id":"3023009010400","name":"円香","text":"……","trans":""},{"id":"3023009010410","name":"小糸","text":"……\\nなんか不思議だね……！","trans":"……\\n感觉好不可思议啊……！"},{"id":"3023009010420","name":"透","text":"んー","trans":"嗯——"},{"id":"3023009010430","name":"雛菜","text":"円香先輩は\\n下に落ちそう～","trans":"圆香前辈\\n感觉要落到下面去了～"},{"id":"3023009010440","name":"雛菜","text":"それとも～\\n飛んでる～？","trans":"还是说～\\n是在飞着～？"},{"id":"3023009010450","name":"円香","text":"どっちでもいい","trans":"怎样都好"},{"id":"3023009010460","name":"雛菜","text":"あは～","trans":"啊哈～"},{"id":"3023009010470","name":"小糸","text":"み、みんな飛んでるね……！","trans":"大、大家都在飞呢……！"},{"id":"3023009010480","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"0000000000000","name":"撮影スタッフ","text":"…………あっ","trans":"…………啊"},{"id":"3023009010490","name":"小糸","text":"ぴぇ……\\nあ、あの…………！","trans":"噼诶……\\n那、那个…………！"},{"id":"0000000000000","name":"撮影スタッフ","text":"……ああ、いいですよ！\\nそのままで","trans":"……啊啊、没事的！\\n就那样子"},{"id":"0000000000000","name":"撮影スタッフ","text":"みなさん、ありがとうございます！","trans":"各位，非常感谢！"},{"id":"3023009010500","name":"小糸","text":"……？","trans":""},{"id":"0000000000000","name":"撮影スタッフ","text":"みなさんがさっき取ってたポーズ\\n監督がえらく気に入ったみたいで","trans":"各位刚才摆出的造型\\n监督看到了非常中意"},{"id":"0000000000000","name":"撮影スタッフ","text":"あの構図で行こうって\\nようやくなりまして","trans":"总算定下来了\\n说是就照着那个构图来"},{"id":"3023009010501","name":"一同","text":"…………","trans":""},{"id":"0000000000000","name":"撮影スタッフ","text":"10分後に撮影再開しますんで\\nもう少しだけ……！","trans":"十分钟之后我们重新开始拍摄\\n麻烦再等一会……！"},{"id":"3023009010510","name":"透","text":"おー","trans":"噢——"},{"id":"3023009010520","name":"小糸","text":"す、すごいね……！\\n雛菜ちゃん","trans":"好、好厉害啊……！\\n雏菜"},{"id":"3023009010530","name":"雛菜","text":"あは～","trans":"啊哈～"},{"id":"3023009010540","name":"雛菜","text":"ひっくり返しちゃった～","trans":"反转过来了～"}]}