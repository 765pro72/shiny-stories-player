{"translator":"魚見","rows":[{"id":"3020011010010","name":"off","text":"──────ぺぺベンベンベン…………","trans":"——————pepepenpenpen……"},{"id":"3020011010020","name":"off","text":"ぺぺベンベンベン…………","trans":"pepepenpenpen…………"},{"id":"3020011010030","name":"off","text":"ぺぺ──────","trans":"pepe——————"},{"id":"3020011010040","name":"あさひ","text":"──────あっ","trans":"——————啊"},{"id":"0000000000000","name":"イベントスタッフ","text":"────はーい、芹沢さんお待たせです\\nサイン、書けましたー？","trans":"————来了，芹泽小姐让你久等了\\n签名，写好了吗——？"},{"id":"3020011010050","name":"あさひ","text":"──っ\\nあ……書いたっす","trans":"——\\n啊……写好了的说"},{"id":"0000000000000","name":"イベントスタッフ","text":"あらー、ありがとうございます！\\nそれじゃもらってっちゃいますねー","trans":"哎呀——，非常感谢！\\n那我就收下了——"},{"id":"0000000000000","name":"イベントスタッフ","text":"────あ、プロデューサーさんはまだノクチルさんたちの\\nお仕事見てるので、しばらく待っててあげてください？","trans":"————啊，制作人还在看noctchill们的工作\\n请你再等等他？"},{"id":"3020011010060","name":"あさひ","text":"……っ\\n待つ────","trans":"……\\n等————"},{"id":"3020011010070","name":"off","text":"ベンベンベン、ベン、ベン、ベン、ベン──────","trans":"benbenbenben、ben、ben、ben——————"},{"id":"3020011010080","name":"あさひ","text":"──────","trans":""},{"id":"3020011010090","name":"あさひ","text":"────それって、自由時間ってことっすか？","trans":"————也就是说，是自由时间的说吗？"},{"id":"0000000000000","name":"イベントスタッフ","text":"……え？\\nあ、うーん……そうかなぁ？","trans":"……诶？\\n啊、嗯——……是吧？"},{"id":"3020011010100","name":"off","text":"……べ、べ、べ、ベン──────","trans":"……be、be、be、ben——————"},{"id":"0000000000000","name":"イベントスタッフ","text":"────何かお急ぎでした……？","trans":"————是有什么急事吗……？"},{"id":"3020011010110","name":"あさひ","text":"自由時間だったら、ちょっと行ってくるっす！","trans":"是自由时间的话，我出去一趟的说！"},{"id":"0000000000000","name":"イベントスタッフ","text":"えっ……！","trans":"诶……！"},{"id":"3020011010120","name":"off","text":"べ、べーべー、ベッ、ベーン──────","trans":"be、be——be——、be、ben——————"},{"id":"3020011010130","name":"あさひ","text":"逃げたっす……！","trans":"逃走了的说……！"},{"id":"0000000000000","name":"イベントスタッフ","text":"──────えっ","trans":"——————诶"},{"id":"3020011010131","name":"あさひ","text":"さっき、そこから────","trans":"刚才，从那里————"},{"id":"3020011010140","name":"あさひ","text":"クマが逃げ出したっすよ…………！","trans":"熊逃走了的说…………！"},{"id":"3020011010150","name":"透","text":"ベベンッ","trans":"beben"},{"id":"3020011010160","name":"透","text":"…………","trans":""},{"id":"3020011010170","name":"あさひ","text":"…………","trans":""},{"id":"3020011010180","name":"透","text":"…………","trans":""},{"id":"3020011010190","name":"あさひ","text":"…………っ","trans":"…………"},{"id":"0000000000000","name":"現場スタッフ","text":"────え、クマ？\\n……ああー、アイドルの子？","trans":"————诶，熊？\\n……啊啊——，那个偶像？"},{"id":"3020011010200","name":"透","text":"…………","trans":""},{"id":"3020011010210","name":"あさひ","text":"…………","trans":""},{"id":"0000000000000","name":"現場スタッフ","text":"あははっ、外行っちゃったの？","trans":"啊哈哈，她出去了吗？"},{"id":"0000000000000","name":"現場スタッフ","text":"着ぐるみ着っぱなしで暑そうだったからさ\\n休憩どうぞって伝えたんだけど────","trans":"看她穿着玩偶服很热的样子\\n跟她说了可以去休息一下————"},{"id":"3020011010220","name":"透","text":"…………おーい","trans":"…………喂——"},{"id":"3020011010230","name":"透","text":"ついてくんなー","trans":"别跟过来——"},{"id":"3020011010240","name":"あさひ","text":"わたしっすか\\nついてってないっす","trans":"我吗\\n没跟过去的说"},{"id":"3020011010250","name":"透","text":"……\\nじゃ、見んなー","trans":"……那，别看——"},{"id":"3020011010260","name":"あさひ","text":"見てるんじゃないっす","trans":"不是在看的说"},{"id":"3020011010270","name":"透","text":"……","trans":""},{"id":"3020011010280","name":"あさひ","text":"調べてるっすよ","trans":"在调查的说"},{"id":"3020011010290","name":"あさひ","text":"やっぱり\\n透ちゃんっす！","trans":"果然\\n是透的说！"},{"id":"3020011010300","name":"透","text":"……","trans":""},{"id":"3020011010310","name":"透","text":"ちがーう","trans":"错了——"},{"id":"3020011010320","name":"あさひ","text":"……っ","trans":"……"},{"id":"3020011010330","name":"あさひ","text":"えっ、そうっすよ\\n透ちゃんの声っす","trans":"诶，没错的说\\n是透的声音的说"},{"id":"3020011010340","name":"透","text":"ちがう","trans":"错了"},{"id":"3020011010350","name":"あさひ","text":"……っ\\nえっ……","trans":"……\\n诶……"},{"id":"3020011010360","name":"あさひ","text":"違うっすか……！","trans":"错了的说吗……！"},{"id":"3020011010370","name":"透","text":"ちがうね","trans":"错了呢"},{"id":"3020011010380","name":"透","text":"……はぁー","trans":"……哈啊——"},{"id":"3020011010390","name":"透","text":"──────ふー…………","trans":"——————呼——…………"},{"id":"3020011010400","name":"あさひ","text":"やっぱり透ちゃんっす！","trans":"果然是透的说！"},{"id":"3020011010410","name":"透","text":"てぃがう","trans":"戳啦"},{"id":"3020011010420","name":"あさひ","text":"なんで違うって言うっすか","trans":"为什么要说错了的说"},{"id":"3020011010430","name":"透","text":"え？\\nんー……","trans":"诶？\\n嗯——……"},{"id":"3020011010440","name":"あさひ","text":"怒られるっすか？","trans":"会被骂的说吗？"},{"id":"3020011010450","name":"透","text":"え？","trans":"诶？"},{"id":"3020011010460","name":"あさひ","text":"仕事の時に、外行ったりしたら\\n怒られるっす","trans":"工作的时候，出去外面的话\\n会被骂的说"},{"id":"3020011010470","name":"透","text":"え、あー……","trans":"诶、啊——……"},{"id":"3020011010480","name":"透","text":"イエス","trans":"YES"},{"id":"3020011010490","name":"透","text":"じゃ、替わろ","trans":"那，来替换吧"},{"id":"3020011010500","name":"あさひ","text":"えっ","trans":"诶"},{"id":"3020011010510","name":"透","text":"半分替わろ──────","trans":"换一半吧————"},{"id":"3020011010520","name":"あさひ","text":"────うわっ、重い……","trans":"————呜哇、好重……"},{"id":"3020011010530","name":"透","text":"んー……ふふっ","trans":"嗯——……呵呵"},{"id":"3020011010540","name":"透","text":"怒られてよ、半分\\n一緒に","trans":"被骂吧，一半\\n一起"},{"id":"3020011010550","name":"あさひ","text":"わたしは怒られないっすよ\\n自由時間っす","trans":"我是不会被生气的说\\n是自由时间的说"},{"id":"3020011010560","name":"透","text":"えー\\nでも私じゃん、半分。今","trans":"诶——\\n但你不是我吗，一半。现在"},{"id":"3020011010570","name":"あさひ","text":"……？\\n勝手にかぶせたっすよ","trans":"……？\\n是被擅自戴上的说"},{"id":"3020011010580","name":"透","text":"えー","trans":"诶——"},{"id":"3020011010590","name":"あさひ","text":"なんでここ来たっすか","trans":"为什么来这边了的说"},{"id":"3020011010600","name":"透","text":"え、んー……","trans":"诶、嗯——……"},{"id":"3020011010610","name":"透","text":"……なんか、ここっていうか\\nんー……","trans":"……感觉，与其说这里\\n嗯——……"},{"id":"3020011010620","name":"透","text":"なんだっけ、この曲","trans":"是什么来着，这首歌"},{"id":"3020011010630","name":"透","text":"────まぁ、行こ","trans":"————算了，走吧"},{"id":"3020011010640","name":"あさひ","text":"帰るっすか","trans":"要回去的说吗"},{"id":"3020011010650","name":"透","text":"え、ううん","trans":"诶，不是"},{"id":"3020011010660","name":"透","text":"行く","trans":"出发"},{"id":"3020011010670","name":"透","text":"どこ行きたいか……\\n思い出すまで","trans":"想去哪里呢……\\n在想起来之前"}]}