{"translator":"蛋羹、可可","rows":[{"id":"3024009030010","name":"にちか","text":"……っ……\\n…………っ…………","trans":"……哈……\\n…………哈…………"},{"id":"3024009030020","name":"にちか","text":"電柱","trans":"电线杆"},{"id":"3024009030030","name":"にちか","text":"……っ…………\\n………………っ…………","trans":"……哈…………\\n………………哈…………"},{"id":"3024009030040","name":"にちか","text":"電柱","trans":"电线杆"},{"id":"3024009030050","name":"にちか","text":"…………っ…………\\n……っ…………","trans":"…………哈…………\\n……哈…………"},{"id":"3024009030060","name":"にちか","text":"電柱","trans":"电线杆"},{"id":"3024009030070","name":"にちか","text":"…………っ────────","trans":"…………呃────────"},{"id":"3024009030080","name":"にちか","text":"電柱ごとに\\n死神みたいなのがいて","trans":"每根电线杆上\\n都像是有死神在窥伺"},{"id":"3024009030090","name":"にちか","text":"──────はっ……","trans":"──────哈……"},{"id":"3024009030100","name":"にちか","text":"捕まらないように\\n走り抜ける","trans":"为了不被抓住\\n必须坚持跑到底"},{"id":"3024009030110","name":"にちか","text":"──────\\n……っ……","trans":"──────\\n……哈……"},{"id":"3024009030120","name":"にちか","text":"苦しい","trans":"好痛苦"},{"id":"3024009030130","name":"にちか","text":"つらい","trans":"好难受"},{"id":"3024009030140","name":"にちか","text":"きつい","trans":"好疲惫"},{"id":"3024009030150","name":"にちか","text":"やめたい","trans":"想放弃"},{"id":"3024009030160","name":"にちか","text":"…………っ…………\\n……っ…………","trans":"…………哈…………\\n……哈…………"},{"id":"3024009030170","name":"にちか","text":"走り込みって────","trans":"所谓耐力跑────"},{"id":"3024009030180","name":"にちか","text":"────走り込みって\\nそういうものじゃないですー……？","trans":"────所谓耐力跑\\n不就是这种感觉的吗……？"},{"id":"0000000000000","name":"整形外科医","text":"……\\nわぁ……","trans":"……\\n哇……"},{"id":"0000000000000","name":"整形外科医","text":"病んでるねぇー","trans":"你脑袋病得不轻啊──"},{"id":"3024009030190","name":"にちか","text":"えっ\\nそういう意味じゃ────","trans":"诶\\n我不是这个意思────"},{"id":"3024009030200","name":"にちか","text":"────った……！","trans":"────啊痛……！"},{"id":"0000000000000","name":"整形外科医","text":"はい、消毒終わり","trans":"好，消毒好了"},{"id":"0000000000000","name":"整形外科医","text":"捻挫とかじゃなくてよかったと言うべきか\\n擦りむいちゃって不幸だったと言うべきか────","trans":"不知是该说没扭伤脚真幸运呢\\n还是该说擦破了皮真倒霉呢"},{"id":"3024009030210","name":"にちか","text":"……\\nすみません。ありがとうございましたー……","trans":"……\\n抱歉啦。谢谢你……"},{"id":"0000000000000","name":"整形外科医","text":"────\\n追いかけられるような走り方してるからだよ？","trans":"────\\n因为你像是被人追着似的跑步才会这样的哦？"},{"id":"3024009030220","name":"にちか","text":"……","trans":"……"},{"id":"0000000000000","name":"整形外科医","text":"センセも朝夜走るヒトだけど────","trans":"医生我也是要晨跑晚跑的人────"},{"id":"0000000000000","name":"整形外科医","text":"楽しいよぉ、走るのはー","trans":"跑步这件事，明明是很开心的啊"},{"id":"3024009030230","name":"にちか","text":"……\\nそれは……","trans":"……\\n那是……"},{"id":"3024009030240","name":"にちか","text":"それはだって、趣味なら楽し──────","trans":"那是因为，只是作为兴趣去跑当然开──────"},{"id":"0000000000000","name":"整形外科医","text":"走るメカニズムはあなたと同じです","trans":"支撑我们跑步的身体机制是一样的"},{"id":"3024009030250","name":"にちか","text":"……っ","trans":"……唔"},{"id":"3024009030260","name":"にちか","text":"…………っ…………\\n……っ…………","trans":"…………哈…………\\n……哈…………"},{"id":"0000000000000","name":"整形外科医","text":"────メカニズムは何も変わらない","trans":"────在身体机制上没有任何区别"},{"id":"0000000000000","name":"整形外科医","text":"ボクが素人で、あなたが何でも","trans":"我的确是外行，但不论你是谁"},{"id":"3024009030270","name":"にちか","text":"…………っ…………\\n……っ…………","trans":"…………哈…………\\n……哈…………"},{"id":"0000000000000","name":"整形外科医","text":"走ることを不幸にしないで","trans":"都请不要将奔跑这件事本身视作不幸"},{"id":"3024009030280","name":"にちか","text":"……っ…………\\n………………っ…………","trans":"……哈…………\\n………………哈…………"},{"id":"3024009030290","name":"にちか","text":"電柱","trans":"电线杆"},{"id":"3024009030300","name":"にちか","text":"……っ……\\n…………っ…………","trans":"……哈……\\n…………哈…………"},{"id":"3024009030310","name":"にちか","text":"電柱\\n電柱","trans":"电线杆\\n电线杆"},{"id":"3024009030320","name":"にちか","text":"…………っ────────","trans":"…………哈────────"},{"id":"3024009030330","name":"にちか","text":"美琴さん","trans":"美琴小姐"},{"id":"3024009030340","name":"美琴","text":"…………っ……\\n……っ…………","trans":"…………哈……\\n……哈…………"},{"id":"3024009030350","name":"にちか","text":"……っ…………\\n………………っ…………","trans":"……哈…………\\n………………哈…………"},{"id":"3024009030360","name":"にちか","text":"美琴さん","trans":"美琴小姐"},{"id":"3024009030370","name":"にちか","text":"電柱\\n美琴さん","trans":"电线杆\\n美琴小姐"},{"id":"3024009030380","name":"にちか","text":"────────…………","trans":"────────…………"},{"id":"3024009030390","name":"にちか","text":"………\\nお疲れ……様です…………","trans":"………\\n你辛……苦了…………"},{"id":"3024009030400","name":"美琴","text":"……\\nうん……","trans":"……\\n嗯……"},{"id":"3024009030410","name":"にちか","text":"──────水……","trans":"──────水……"},{"id":"3024009030420","name":"にちか","text":"ん……","trans":"唔……"},{"id":"3024009030430","name":"にちか","text":"────けっこう日がのぼってきましたね……\\nまぶしい────","trans":"────太阳升起来不少了呢……\\n好耀眼────"},{"id":"3024009030440","name":"美琴","text":"……うん","trans":"……嗯"},{"id":"3024009030450","name":"にちか","text":"────あ","trans":"────啊"},{"id":"3024009030460","name":"にちか","text":"桜","trans":"樱花"},{"id":"3024009030470","name":"美琴","text":"……え？","trans":"……诶？"},{"id":"3024009030480","name":"にちか","text":"あ、いえ……！","trans":"啊，没什么……！"},{"id":"3024009030490","name":"にちか","text":"桜、いつのまにか\\n葉っぱだけになっちゃってるなーって思って……","trans":"就是突然奇怪\\n樱花树，不知什么时候起只剩下叶子了……"},{"id":"3024009030500","name":"美琴","text":"……これ、桜なの","trans":"……这个，是樱花树吗"},{"id":"3024009030510","name":"にちか","text":"えっ\\nあ……ですですたぶん！","trans":"诶\\n啊……是吧是吧大概！"},{"id":"3024009030520","name":"美琴","text":"咲いてたっけ","trans":"有开花过吗"},{"id":"3024009030530","name":"にちか","text":"……えっ","trans":"……诶"},{"id":"3024009030540","name":"にちか","text":"あははっ……","trans":"啊哈哈……"},{"id":"3024009030550","name":"にちか","text":"美琴さんだ","trans":"这才是美琴小姐啊"},{"id":"3024009030560","name":"にちか","text":"あのっ、いえいえ……！","trans":"啊，没事没事……！"},{"id":"0000000000000","name":"整形外科医","text":"走ることを不幸にしないで","trans":"都请不要将奔跑这件事本身视作不幸"},{"id":"3024009030570","name":"にちか","text":"ちょっとなんか、気持ちよくて────","trans":"就是不知为什么，有点开心────"},{"id":"3024009030580","name":"美琴","text":"……飲み終わったら、行こう","trans":"……喝完水，就一起走吧"},{"id":"3024009030590","name":"にちか","text":"はい……！","trans":"好……！"}]}