      "id": "2012014020260",
      "name": "凛世",
      "text": "赤い……",
      "trans": "好红……"
    },
    {
      "id": "2012014020270",
      "name": "凛世",
      "text": "遠い……",
      "trans": "好远……"
    },
    {
      "id": "2012014020280",
      "name": "凛世",
      "text": "……\\nプロデューサーさま……",
