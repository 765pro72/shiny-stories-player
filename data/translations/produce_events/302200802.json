{"translator":"Rosineae","rows":[{"id":"3022008020010","name":"雛菜","text":"なんか最近\\n雨ばっかり～……","trans":"总感觉最近老是下雨～……"},{"id":"3022008020020","name":"雛菜","text":"暇だね～……","trans":"真闲啊～……"},{"id":"3022008020030","name":"小糸","text":"そ、そうだね","trans":"是、是啊"},{"id":"3022008020040","name":"小糸","text":"…………","trans":""},{"id":"3022008020050","name":"小糸","text":"これじゃあ桜も\\n散っちゃいそうだね……","trans":"这样子樱花都要凋谢了呢"},{"id":"3022008020060","name":"雛菜","text":"ん～？\\nそれは別にいいけど～","trans":"嗯～？\\n这倒没什么～"},{"id":"3022008020070","name":"雛菜","text":"雨だと学校行くのも濡れちゃって\\n大変だし","trans":"下雨的话去学校会被淋湿\\n挺难受的"},{"id":"3022008020080","name":"雛菜","text":"ちょっとお腹すいた時にも\\n気軽にコンビニ行けないでしょ～？","trans":"肚子有些饿的时候\\n也不能随便去便利店吧～？"},{"id":"3022008020090","name":"小糸","text":"う、うん\\nそう、かな……？","trans":"嗯、嗯\\n是这样吧……"},{"id":"3022008020100","name":"雛菜","text":"だから、はい！\\nみんな手出して～","trans":"所以，来！\\n大家伸出手～"},{"id":"3022008020110","name":"円香","text":"何？","trans":"什么？"},{"id":"3022008020120","name":"雛菜","text":"コンビニじゃんけん！","trans":"便利店猜拳！"},{"id":"3022008020130","name":"透","text":"え、行く？","trans":"诶，要去？"},{"id":"3022008020140","name":"透","text":"コンビニ","trans":"便利店"},{"id":"3022008020150","name":"雛菜","text":"うん～\\nじゃんけんで負けた人がね～！","trans":"嗯～\\n猜拳输了的人去～！"},{"id":"3022008020160","name":"小糸","text":"で、でも\\n結構雨すごいよ？","trans":"可、可是\\n雨下得很大哦？"},{"id":"3022008020170","name":"雛菜","text":"だから\\nじゃんけんするんでしょ～？","trans":"所以才要猜拳吧～？"},{"id":"3022008020180","name":"雛菜","text":"雛菜行きたくないから勝つ～！","trans":"雏菜不想去所以要赢～！"},{"id":"3022008020190","name":"透","text":"おー","trans":"噢"},{"id":"3022008020200","name":"円香","text":"やるか","trans":"那就来吧"},{"id":"3022008020210","name":"小糸","text":"ぴぇ……！\\nみ、みんな……！","trans":"呀……！\\n大、大家……！"},{"id":"3022008020220","name":"小糸","text":"今行ったらすごい濡れちゃうよ……？","trans":"现在去的话会被淋得很厉害哦……？"},{"id":"3022008020230","name":"円香","text":"じゃ、小糸は不参加？","trans":"那么小糸不参加吗？"},{"id":"3022008020240","name":"小糸","text":"あ……\\nそ、そうじゃなくて……！","trans":"啊……\\n不、不是……！"},{"id":"3022008020250","name":"小糸","text":"お、お腹空いたんだよね？\\n雛菜ちゃんは","trans":"肚子饿了是吧？\\n雏菜"},{"id":"3022008020260","name":"雛菜","text":"うん～！","trans":"嗯～！"},{"id":"3022008020270","name":"小糸","text":"それなら、この間スーパーで買った\\n春雨のスープがあるんじゃない……？","trans":"这样的话，之前不是在超市买了粉丝吗……？"},{"id":"3022008020280","name":"小糸","text":"透ちゃんのお家に置いておくって\\n一緒にお菓子も買ってたよね……？","trans":"雏菜说放在小透家里\\n然后还买了点心对吧……？"},{"id":"3022008020290","name":"雛菜","text":"あ～！\\nそうだった！","trans":"啊～！\\n没错呢！"},{"id":"3022008020300","name":"雛菜","text":"透先輩、あれまだある？","trans":"透学姐，那些还有剩吗？"},{"id":"3022008020310","name":"透","text":"あー……\\nある","trans":"啊──……\\n有的"},{"id":"3022008020320","name":"透","text":"台所","trans":"在厨房"},{"id":"3022008020330","name":"雛菜","text":"やは～\\nじゃあお湯入れてこよ～！","trans":"呀哈～\\n那就泡来吃吧……！"},{"id":"3022008020340","name":"雛菜","text":"要る人～～～～～？","trans":"谁要吃～～～～～？"},{"id":"3022008020350","name":"透","text":"はい","trans":"这里"},{"id":"3022008020360","name":"円香","text":"はい","trans":"这里"},{"id":"3022008020370","name":"雛菜","text":"……小糸ちゃんは？","trans":"……小糸呢？"},{"id":"3022008020380","name":"小糸","text":"え……えっと……","trans":"啊……那个……"},{"id":"3022008020390","name":"小糸","text":"……あ……","trans":"……啊……"},{"id":"3022008020400","name":"雛菜","text":"はい\\n要るね～","trans":"好\\n也吃是吧～"},{"id":"3022008020410","name":"小糸","text":"う、うん……！\\nあ、ありがとう……！","trans":"嗯、嗯……！\\n谢谢……！"},{"id":"3022008020420","name":"小糸","text":"…………","trans":""},{"id":"3022008020430","name":"透","text":"なんにもしてなくてもさ","trans":"就算什么都不做"},{"id":"3022008020440","name":"透","text":"空くよね\\nお腹","trans":"还是会饿呢\\n肚子"},{"id":"3022008020450","name":"透","text":"なんにもしなくても","trans":"就算什么都不做"},{"id":"3022008020460","name":"小糸","text":"…………！\\nそ、そうだね……！","trans":"…………！\\n是、是啊……！"},{"id":"3022008020470","name":"小糸","text":"な、なんでかな……","trans":"为、为什么呢……"},{"id":"3022008020480","name":"小糸","text":"わたし、雛菜ちゃん\\n手伝ってくる","trans":"我去帮一下雏菜"},{"id":"3022008020490","name":"透","text":"んー","trans":"嗯"},{"id":"3022008020500","name":"円香","text":"よろしく","trans":"拜托了"},{"id":"3022008020510","name":"小糸","text":"う、うん……！","trans":"嗯、嗯……！"}]}