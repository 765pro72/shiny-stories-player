{"translator":"魚見","rows":[{"id":"3020012020010","name":"小糸","text":"と、透ちゃん\\n夏休みの予定とか考えた……？","trans":"透、透\\n你有想好暑假的安排什么的吗……？"},{"id":"3020012020020","name":"透","text":"え\\nあー……","trans":"诶\\n啊——……"},{"id":"3020012020030","name":"透","text":"……っ","trans":"……"},{"id":"3020012020040","name":"小糸","text":"え……？","trans":"诶……？"},{"id":"3020012020050","name":"透","text":"んー","trans":"嗯——"},{"id":"3020012020060","name":"透","text":"小糸ちゃんは？","trans":"小糸呢？"},{"id":"3020012020070","name":"小糸","text":"わ、わたしは……\\nお仕事の合間に色々入れたいなって……！","trans":"我、我是想着……\\n在工作之余去做各种事情……！"},{"id":"3020012020080","name":"透","text":"おー","trans":"噢——"},{"id":"3020012020090","name":"小糸","text":"どんどん暑くなってるから……\\n涼しいところに行くのとか、いいよね……！","trans":"天气也逐渐变热了……\\n去点凉快的地方避暑之类的、也不错吧……！"},{"id":"3020012020100","name":"透","text":"……っ","trans":"……"},{"id":"3020012020110","name":"小糸","text":"え……？","trans":"诶……？"},{"id":"3020012020120","name":"透","text":"……てー……","trans":"……痛——……"},{"id":"3020012020130","name":"透","text":"あ……\\nねー","trans":"啊……\\n嗳——"},{"id":"3020012020140","name":"透","text":"寄ってもいい？\\nドラッグストア","trans":"能绕路去一趟吗？\\n杂货店"},{"id":"0000000000000","name":"撮影スタッフ","text":"それじゃ、ノクチルのみなさんは\\n各々、好きなポーズ取ってくださいー","trans":"那么、noctchill的各位\\n就请按各自喜欢摆好动作——"},{"id":"3020012020150","name":"円香","text":"はい","trans":"好的"},{"id":"3020012020160","name":"小糸","text":"ぴぇ……！\\nむ、難しいねこれ……","trans":"噼诶……！\\n好、好难啊这个……"},{"id":"0000000000000","name":"撮影スタッフ","text":"ポーズ取るだけで大丈夫ですよー！\\n転ばないようにお気をつけて！","trans":"只要摆个动作就好了噢——！\\n请小心不要摔倒了！"},{"id":"3020012020170","name":"小糸","text":"は、はい……！","trans":"好、好的……！"},{"id":"3020012020180","name":"雛菜","text":"あは～\\n透先輩いい感じだね～","trans":"啊哈～\\n透前辈感觉不错呢～"},{"id":"3020012020190","name":"透","text":"んー","trans":"嗯——"},{"id":"3020012020200","name":"透","text":"イエー","trans":"耶——"},{"id":"3020012020210","name":"小糸","text":"と、透ちゃん……\\n危ないよ……！","trans":"透、透……\\n很危险的……！"},{"id":"3020012020220","name":"透","text":"ふふっ、んー","trans":"呵呵、嗯——"},{"id":"3020012020230","name":"透","text":"乗れそう","trans":"感觉能乘上"},{"id":"0000000000000","name":"撮影スタッフ","text":"あー\\n浅倉さーん！","trans":"啊——\\n浅仓小姐——！"},{"id":"0000000000000","name":"撮影スタッフ","text":"振りでいいんですよー\\n振りで……！","trans":"摆动作就好了——\\n摆动作……！"},{"id":"0000000000000","name":"off","text":"イケイケだねー\\n今年の夏は","trans":"积极向前呢——\\n今年夏天"},{"id":"3020012020240","name":"透","text":"来い","trans":"来吧"},{"id":"3020012020250","name":"透","text":"素敵な夏","trans":"美妙的夏天"},{"id":"3020012020251","name":"小糸＆雛菜","text":"………………！","trans":""},{"id":"3020012020260","name":"透","text":"────────っ","trans":"————————"},{"id":"0000000000000","name":"撮影スタッフ","text":"ちょっ\\n浅倉さん……！","trans":"啊\\n浅仓小姐……！"},{"id":"3020012020261","name":"円香＆小糸＆雛菜","text":"………………","trans":"透……！（小糸）\\n啊哈……（雏菜）\\n嗯……（圆香）"},{"id":"3020012020270","name":"透","text":"……てー","trans":"……痛—"},{"id":"3020012020280","name":"小糸","text":"透ちゃん\\n先買ったよ……！","trans":"透\\n我先买好了……！"},{"id":"3020012020290","name":"透","text":"あ、うん","trans":"啊、嗯"},{"id":"3020012020300","name":"小糸","text":"それ、湿布……？","trans":"那个是、湿巾……？"},{"id":"3020012020310","name":"透","text":"んー\\n足りるかな","trans":"嗯——\\n够不够呢"},{"id":"3020012020320","name":"透","text":"筋肉痛","trans":"肌肉拉伤"},{"id":"3020012020330","name":"小糸","text":"う、うん……\\nこれだけあれば……！","trans":"嗯、嗯……\\n有这么多的话……！"},{"id":"0000000000000","name":"店員","text":"いらっしゃいませー","trans":"欢迎光临——"},{"id":"3020012020340","name":"小糸","text":"スケボーの……時のだよね？","trans":"是滑滑板的时候……弄的吧？"},{"id":"3020012020350","name":"透","text":"うん","trans":"嗯"},{"id":"0000000000000","name":"店員","text":"次、お待ちのお客様\\nどうぞー","trans":"下一位，久等了\\n请来——"},{"id":"3020012020360","name":"透","text":"なんか、やばくて","trans":"感觉、有点严重"},{"id":"3020012020370","name":"小糸","text":"……あ","trans":"……啊"},{"id":"3020012020380","name":"小糸","text":"アイスも買うんだね……！","trans":"也买了冰淇淋呢……！"},{"id":"3020012020390","name":"透","text":"んー\\nふふっ","trans":"嗯——\\n呵呵"},{"id":"0000000000000","name":"店員","text":"お待たせしました\\n雑貨１点、食品２点で────","trans":"让您久等了\\n日用品1件、食品2件————"},{"id":"3020012020400","name":"透","text":"２つ\\nいる？","trans":"两个\\n要吗？"},{"id":"3020012020410","name":"小糸","text":"え……！","trans":"诶……！"},{"id":"3020012020420","name":"小糸","text":"と、透ちゃん、ありがとう……！\\nいただきます……","trans":"透、透，谢谢你……！\\n我不客气了……"},{"id":"3020012020430","name":"透","text":"ふふっ\\nイエー","trans":"呵呵\\n耶——"},{"id":"3020012020440","name":"小糸","text":"筋肉痛、早く治るといいね……","trans":"肌肉拉伤，希望能快点好起来呢……"},{"id":"3020012020450","name":"透","text":"んー","trans":"嗯——"},{"id":"3020012020460","name":"小糸","text":"す、素敵な夏になるんだもんね……！","trans":"要、要迎来美妙夏天的嘛……！"},{"id":"3020012020470","name":"透","text":"ふふっ、んー","trans":"呵呵、嗯——"},{"id":"3020012020480","name":"透","text":"…………","trans":""},{"id":"3020012020490","name":"透","text":"…………あ","trans":"…………啊"},{"id":"3020012020500","name":"小糸","text":"……？","trans":""},{"id":"3020012020510","name":"透","text":"ねー\\nアイス","trans":"嗳——\\n冰淇淋"},{"id":"3020012020520","name":"小糸","text":"え？","trans":"诶？"},{"id":"3020012020530","name":"小糸","text":"ぴぇ……！\\nま、また当たり……！","trans":"噼诶……！\\n又、又中奖了……！"},{"id":"3020012020540","name":"透","text":"んー\\nやべー","trans":"嗯——\\n不得了——"},{"id":"3020012020550","name":"小糸","text":"す、素敵な夏……増えちゃったね","trans":"美、美妙的夏天……变多了呢"},{"id":"3020012020560","name":"透","text":"え？　おー……","trans":"诶？　噢——……"},{"id":"3020012020570","name":"透","text":"じゃ","trans":"那"},{"id":"3020012020580","name":"透","text":"もらってよ、１個","trans":"收下吧，一个"},{"id":"3020012020590","name":"透","text":"夏","trans":"夏天"}]}