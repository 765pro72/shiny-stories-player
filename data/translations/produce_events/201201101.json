{
  "translator": "阿柚",
  "rows": [
    {
      "id": "2012011010010",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……ん？\\nはは",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "何か撮ったのか",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010020",
      "name": "凛世",
      "text": "は、はい……\\n────いえ……",
      "trans": "额，嗯……\\n────不……"
    },
    {
      "id": "2012011010030",
      "name": "凛世",
      "text": "……\\nバスを……",
      "trans": "…\\n公交……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？\\nははっ、この中撮ったのか",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010040",
      "name": "凛世",
      "text": "は、はい……\\nその……",
      "trans": "额，嗯……\\n那个……"
    },
    {
      "id": "2012011010050",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……あぁ、『夏の一枚』のこと\\n気にしてくれてるんだな",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "雑誌用に提供するやつ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そっか、ありがとな\\nあんまり難しく考えないで、好きに撮っていいんだぞ？",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010060",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん\\nせっかくこんなとこ来れたんだ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "無人のバスもいいけど\\n窓の外の方が、シャッターチャンスあるからさ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、ほらほら────",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "夏雲だ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010070",
      "name": "凛世",
      "text": "夏雲だ────",
      "trans": "夏云啊────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おーい、凛世\\n宿、こっちだってさ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010080",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あぁ……気持ちいいなぁ……\\n空気が違うよ……！",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010090",
      "name": "凛世",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あ、すまん\\n俺が観光気分じゃまずいな",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010100",
      "name": "凛世",
      "text": "いえ……\\nこのように……明媚な場所……",
      "trans": "不会……\\n像这样……明媚的地方……"
    },
    {
      "id": "2012011010110",
      "name": "凛世",
      "text": "凛世の……心も……\\n同じように……",
      "trans": "凛世……也是……\\n同样的心情……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうか？\\nじゃあ……",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いいか！",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "今日だけは特別だ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010120",
      "name": "凛世",
      "text": "……────",
      "trans": "……────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "明日からの撮影、\\n頑張ろうな",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あ、それそれ！\\nそのまま……！",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010130",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "やっと笑った、凛世",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010140",
      "name": "凛世",
      "text": "……っ\\nプロデューサーさま……？",
      "trans": "……\\n制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "このロケのことか、雑誌の件かわからないけど\\nバスに乗ってる間、ぼんやりしてたから",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010150",
      "name": "凛世",
      "text": "………………",
      "trans": "………………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "気になることがあったら\\nなんでも教えてくれよ？",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010160",
      "name": "凛世",
      "text": "……\\nい、いえ……その…………",
      "trans": "……\\n不，不是……那个…………"
    },
    {
      "id": "2012011010170",
      "name": "凛世",
      "text": "これが……\\nまことで……うつつのことか────",
      "trans": "这……\\n真的是……现实吗────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……え？",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010180",
      "name": "凛世",
      "text": "……\\nこのようなところに……プロデューサーさまと……",
      "trans": "……\\n与制作人大人……一起到这样的地方……"
    },
    {
      "id": "2012011010190",
      "name": "凛世",
      "text": "これが……\\nまことのことか……どうかと…………",
      "trans": "就会想……\\n这到底……是不是真的…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あぁ……\\nははっ────",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "select",
      "name": "",
      "text": "よーく見てくれ",
      "trans": "来好好看看啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "実感ないもんな、\\nこんなとこ来たって",
      "trans": "来好好看看啊"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺も、そうかも",
      "trans": "来好好看看啊"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ほら、今の写真\\nちゃんと写ってるぞ、この場所に",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010200",
      "name": "凛世",
      "text": "……っ\\nは、はい……",
      "trans": "……\\n嗯。嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "よーし、それならもう一枚だ！\\n今度はでっかく風景を入れよう────",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010210",
      "name": "凛世",
      "text": "ぷ、プロデュー────",
      "trans": "制、制作────"
    },
    {
      "id": "2012011010220",
      "name": "凛世",
      "text": "ふふっ……",
      "trans": "哼哼……"
    },
    {
      "id": "2012011010230",
      "name": "凛世",
      "text": "凛世も……\\n確かめたくて……",
      "trans": "凛世也想……\\n确认一下……"
    },
    {
      "id": "2012011010240",
      "name": "凛世",
      "text": "撮ったのです……",
      "trans": "拍到的……"
    },
    {
      "id": "2012011010250",
      "name": "凛世",
      "text": "これが……\\nまことである……ということを────",
      "trans": "是究竟……\\n是不是……真的────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ほら、笑って────",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010260",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "2012011010270",
      "name": "凛世",
      "text": "はい……\\nうつつのようには……思われず……",
      "trans": "嗯……\\n难以想象……这是现实……"
    },
    {
      "id": "2012011010280",
      "name": "凛世",
      "text": "せめて……\\n写真にと……",
      "trans": "至少……\\n让照片……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？　あぁ、そうか──\\nじゃあ、いっぱい撮ろうな！",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "現実って感じがするまでさ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010290",
      "name": "凛世",
      "text": "プロデュー────",
      "trans": "制作────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おーい、雑誌のことはいいから！\\nほら、こっちいい眺めだぞ！",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010300",
      "name": "凛世",
      "text": "──！\\nはい……",
      "trans": "──！\\n是……"
    },
    {
      "id": "2012011010310",
      "name": "凛世",
      "text": "やはり……\\nうつつであるとは……とても──────",
      "trans": "果然……\\n现实是……非常──────"
    },
    {
      "id": "2012011010320",
      "name": "凛世",
      "text": "────っ",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ほんの２、３時間前まで事務所だったんだ\\nそれが……",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ\\n俺も信じられない感じだよ",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010330",
      "name": "凛世",
      "text": "……\\nふふっ……",
      "trans": "……\\n哼哼……"
    },
    {
      "id": "2012011010340",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、凛世！\\n土産物もあるみたいだぞ────",
      "trans": "……嗯？\\n哈哈"
    },
    {
      "id": "2012011010350",
      "name": "凛世",
      "text": "これに乗って……\\nここへ来た……",
      "trans": "乘此……\\n来此……"
    },
    {
      "id": "2012011010360",
      "name": "凛世",
      "text": "すべて……\\nまことのことで……ありますようにと……",
      "trans": "祈愿着……\\n一切……是真的……"
    },
    {
      "id": "2012011010370",
      "name": "凛世",
      "text": "写真を────",
      "trans": "拍了照────"
    },
    {
      "id": "2012011010380",
      "name": "凛世",
      "text": "ふふっ……\\nブレております……",
      "trans": "哼哼……\\n照片拍糊了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──おーい、凛世？\\n行こう……！",
      "trans": "……嗯？\\n哈哈"
    }
  ]
}