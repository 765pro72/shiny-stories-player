{
  "translator": "阿柚",
  "rows": [
    {
      "id": "0000000000000",
      "name": "off",
      "text": "あおい",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "あかい",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "べー",
      "trans": "蓝"
    },
    {
      "id": "2012011020010",
      "name": "凛世",
      "text": "べー……",
      "trans": "呸——"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "あかい",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "あおい",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ\\n赤いなぁ、凛世",
      "trans": "蓝"
    },
    {
      "id": "2012011020020",
      "name": "凛世",
      "text": "ふふっ……\\n青いです……プロデューサーさま……",
      "trans": "哼哼……\\n制作人大人也……很蓝……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "休憩中に冷えすぎないようにしないとな\\n──氷、美味しいか？",
      "trans": "蓝"
    },
    {
      "id": "2012011020030",
      "name": "凛世",
      "text": "はい……\\nいちごの……味がいたします……",
      "trans": "嗯……\\n是草莓……的味道……"
    },
    {
      "id": "2012011020040",
      "name": "凛世",
      "text": "プロデューサーさまは……？",
      "trans": "制作人大人呢……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "うん、うまいよ\\n青いハワイの……味がする",
      "trans": "蓝"
    },
    {
      "id": "2012011020041",
      "name": "凛世＆プロデューサー",
      "text": "ははっ……",
      "trans": "哈哈……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "これ、混ざったら紫になるのかな？",
      "trans": "蓝"
    },
    {
      "id": "2012011020050",
      "name": "凛世",
      "text": "ふふふ……\\n紫の舌は……恐ろしいです……",
      "trans": "哼哼哼……\\n紫色的舌头……有些吓人呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうだな\\n青でやめておこう",
      "trans": "蓝"
    },
    {
      "id": "2012011020060",
      "name": "凛世",
      "text": "はい……\\n赤でやめておきます……",
      "trans": "嗯……\\n我也……继续吃红色……"
    },
    {
      "id": "2012011020061",
      "name": "凛世＆プロデューサー",
      "text": "ふふっ……",
      "trans": "哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あっ\\nこれ、撮っといたらいいんじゃないか？",
      "trans": "蓝"
    },
    {
      "id": "2012011020070",
      "name": "凛世",
      "text": "それは……\\nはい……",
      "trans": "那个……\\n嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "じゃあ凛世の携帯がいいよな\\nもう一回、ベーだ",
      "trans": "蓝"
    },
    {
      "id": "2012011020080",
      "name": "凛世",
      "text": "心得ました……\\n──べー……",
      "trans": "知道了……\\n──呸——……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おお、いい感じだぞ\\n夏って雰囲気、出てるよ！",
      "trans": "蓝"
    },
    {
      "id": "2012011020090",
      "name": "凛世",
      "text": "ふふっ……\\nでは……その────",
      "trans": "哼哼……\\n那么……那个────"
    },
    {
      "id": "2012011020100",
      "name": "凛世",
      "text": "──……\\nプロデューサーさまも……",
      "trans": "──……\\n制作人大人也……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え？",
      "trans": "蓝"
    },
    {
      "id": "2012011020110",
      "name": "凛世",
      "text": "もう一度……\\nべー……でございます……",
      "trans": "请再……\\n呸——……一下……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ──\\nははっ",
      "trans": "蓝"
    },
    {
      "id": "select",
      "name": "",
      "text": "俺はいいよ",
      "trans": "我就算了啦"
    },
    {
      "id": "select",
      "name": "",
      "text": "ありがとな",
      "trans": "我就算了啦"
    },
    {
      "id": "select",
      "name": "",
      "text": "ダメダメ",
      "trans": "我就算了啦"
    },
    {
      "id": "2012011020120",
      "name": "凛世",
      "text": "────",
      "trans": "────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世のことを伝えるんだから\\n──あ、器を撮るのはどうだ？",
      "trans": "蓝"
    },
    {
      "id": "2012011020130",
      "name": "凛世",
      "text": "い、いえ……\\n…………はい……",
      "trans": "不，不……\\n…………嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──おおー、いい感じじゃないか\\n赤いシロップ、綺麗だなぁ",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、でも俺の器も写っちゃってるな\\n使う時は切らないと",
      "trans": "蓝"
    },
    {
      "id": "2012011020140",
      "name": "凛世",
      "text": "…………────",
      "trans": "…………────"
    },
    {
      "id": "2012011020150",
      "name": "凛世",
      "text": "紫に……",
      "trans": "要是……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なぁ、りん────",
      "trans": "蓝"
    },
    {
      "id": "2012011020160",
      "name": "凛世",
      "text": "してしまえばよかった……",
      "trans": "有混成紫色就好了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──\\n凛世……？",
      "trans": "蓝"
    },
    {
      "id": "2012011020170",
      "name": "凛世",
      "text": "──\\n……いえ…………",
      "trans": "──\\n……没事…………"
    },
    {
      "id": "2012011020180",
      "name": "凛世",
      "text": "はい……\\n綺麗な……赤でございます……",
      "trans": "嗯……\\n真是……非常漂亮的……红色呢……"
    },
    {
      "id": "2012011020190",
      "name": "凛世",
      "text": "ふふっ……\\nでは────",
      "trans": "哼哼……\\n那么────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "でも、俺は写る方の人じゃないからさ",
      "trans": "蓝"
    },
    {
      "id": "2012011020200",
      "name": "凛世",
      "text": "────\\nプロデューサーさま……？",
      "trans": "────\\n制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは\\n俺は、写る人を支える方",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世の携帯にさ\\n俺がこんなに遊んでるの、残せないよ",
      "trans": "蓝"
    },
    {
      "id": "2012011020210",
      "name": "凛世",
      "text": "────…………",
      "trans": "────…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "な？　じゃあ仕事するぞー\\nほら、もう一枚────",
      "trans": "蓝"
    },
    {
      "id": "2012011020220",
      "name": "凛世",
      "text": "混ざらないのですね……",
      "trans": "不混起来呢……"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "青と\\n赤",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あれ\\n凛世……？",
      "trans": "蓝"
    },
    {
      "id": "2012011020230",
      "name": "凛世",
      "text": "いえ……",
      "trans": "没事……"
    },
    {
      "id": "2012011020240",
      "name": "凛世",
      "text": "──べー……",
      "trans": "——呸——……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺なんか撮ったって\\nいいことないぞ？",
      "trans": "蓝"
    },
    {
      "id": "2012011020250",
      "name": "凛世",
      "text": "い、いえ……\\n青いべー……赤いベー…………",
      "trans": "不，不……\\n青色的呸——和……红色的呸——…………"
    },
    {
      "id": "2012011020260",
      "name": "凛世",
      "text": "ふたつともに……\\n今日の……思い出…………",
      "trans": "两个都是……\\今天的……回忆…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……凛世",
      "trans": "蓝"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ありがとな、そんなふうに言ってくれて\\nじゃあ俺の携帯でお願いしようかな",
      "trans": "蓝"
    },
    {
      "id": "2012011020270",
      "name": "凛世",
      "text": "いえ……\\n凛世の────",
      "trans": "不……\\n凛世的────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ほら、このボタンでカメラが起動するから",
      "trans": "蓝"
    },
    {
      "id": "2012011020280",
      "name": "凛世",
      "text": "──……\\nでは……────",
      "trans": "──……\\n那么……────"
    },
    {
      "id": "2012011020290",
      "name": "凛世",
      "text": "ふふっ……\\n青い……",
      "trans": "哼哼……\\n蓝色的……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ、うーん……\\nアイドルの写真と比べられるのはきついなぁ",
      "trans": "蓝"
    },
    {
      "id": "2012011020291",
      "name": "凛世＆プロデューサー",
      "text": "──はははっ……",
      "trans": "──哈哈哈……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "こんな写真、入れとくもんじゃないぞ？",
      "trans": "蓝"
    },
    {
      "id": "2012011020300",
      "name": "凛世",
      "text": "……\\nプロデューサーさま……？",
      "trans": "……\\n制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "な",
      "trans": "蓝"
    }
  ]
}