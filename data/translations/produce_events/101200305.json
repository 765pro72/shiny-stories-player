    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世が苦しいこと……わかってたつもりなんだ…………\\nなのにな……────",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────凛世\\n一緒に、戻ってくれるか？",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050260",
      "name": "凛世",
      "text": "────っ\\n……こ、このまま……────",
      "trans": "————\\n……这，这样下去的话……————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "こんなこと……\\n簡単に言っていいとは思ってない…………",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世が困ってる時になんにもできなくて……\\n自分が嫌になるよ……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050270",
      "name": "凛世",
      "text": "プロデューサーさま…………\\n凛世こそ…………──────",
      "trans": "制作人大人…………\\n凛世才是…………——————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "でも凛世、だからお願いだ\\n思ってることを、教えてもらえないか……？",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050280",
      "name": "凛世",
      "text": "……っ\\n…………────────",
      "trans": "……\\n…………────────"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それで、また……\\n一緒にステージを目指したい……！",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050290",
      "name": "凛世",
      "text": "プロデューサーさま……！　な、何を……────",
      "trans": "制作人大人……！  什，什么……————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "休めばいいなんて、安直にも程があるよ……\\nそんなことじゃないんだろうって、わかってたのに……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ちゃんと凛世のこと、聞かせてほしいんだ\\nそれで、本当に大丈夫なら大丈夫って……確認させてくれ",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050300",
      "name": "凛世",
      "text": "────だ……大丈夫で……ございます…………\\nで、でも……────",
      "trans": "————没……没有……问题…………\\n但是……————"
    },
    {
      "id": "1012003050310",
      "name": "凛世",
      "text": "…………このままでは……\\n戻れ……ません…………",
      "trans": "…………就这样下去的话……\\n还不能……回去…………"
    },
    {
      "id": "1012003050320",
      "name": "凛世",
      "text": "お役に…………立て……ないのです…………",
      "trans": "因为…………凛世……帮不到您…………"
    },
    {
      "id": "1012003050330",
      "name": "凛世",
      "text": "────り……凛世には……\\n『あ』……が……ないゆえ…………────",
      "trans": "————凛……凛世是……\\n没有……“a”……的孩子…………————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──────",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "ダンストレーナー",
      "text": "んー、こう……\\n表現したいっていう欲……みたいなー？",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……──────\\n凛世、そういう…………そういうことなのか……？",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "それは違う……俺にはわかるよ\\n凛世の中に、あも、あじゃない音も、全部あるってこと……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ないんじゃない……\\n出すのをためらってるだけなんだ、きっと────",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "言ってくれ！　心にあること、外に出して……\\nぶつけてくれ……！",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ステージに立つ人間は……\\nもっと、わがままになっていいんだ……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『聞け！』ってさ……────！",
