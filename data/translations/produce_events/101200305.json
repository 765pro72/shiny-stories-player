      "text": "…………っ",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『────\\n待っててくれ…………──────』",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────\\n凛世…………",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "select",
      "name": "",
