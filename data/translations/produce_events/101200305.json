    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『どこにいるんだ！　無事なのか……！』",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050220",
      "name": "凛世",
      "text": "そ……それは……\\nその…………寮に……────",
      "trans": "我……我在……\\n那个…………宿舍……————"
