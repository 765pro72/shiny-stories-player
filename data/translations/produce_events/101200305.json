      "text": "あーーーーー…………っ",
      "trans": "a~~~~~…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──そちらへ伺っていたり……\\nああ、はい……そうですか…………",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………\\n凛世…………",
      "trans": "——凛世，没接电话啊……"
