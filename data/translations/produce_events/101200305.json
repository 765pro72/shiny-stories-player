{
  "translator": "楚西瑜",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──凛世、出ないな……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050010",
      "name": "凛世",
      "text": "────…………",
      "trans": "————…………"
    },
    {
      "id": "1012003050020",
      "name": "凛世",
      "text": "ふたりになってしまった《彼女》たちは\\n互いのことをうらやましく思った",
      "trans": "变成了两个人的“她”们\\n相互羡慕着彼此"
    },
    {
      "id": "1012003050030",
      "name": "凛世",
      "text": "今では屋敷の外の小屋で寝泊まりし、\\n薪を割り水を汲んでその日を営んでいるα",
      "trans": "如今搬出了宅邸，住在破旧的小屋里，\\n每天砍柴打水，寥寥虚度的α"
    },
    {
      "id": "1012003050040",
      "name": "凛世",
      "text": "博士のそばで、\\n何不自由なく暮らしているβ",
      "trans": "呆在博士身旁，\\n生活上没有任何不便之处的β"
    },
    {
      "id": "1012003050050",
      "name": "凛世",
      "text": "少女αは寂しかった",
      "trans": "少女α很寂寞"
    },
    {
      "id": "1012003050060",
      "name": "凛世",
      "text": "愛する人から、\\n遠く隔たってしまったから",
      "trans": "因为和所爱之人\\n远远的隔开了"
    },
    {
      "id": "1012003050070",
      "name": "凛世",
      "text": "『あ』……\\n……『あ』……────",
      "trans": "“a”……\\n……“a”……————"
    },
    {
      "id": "1012003050080",
      "name": "凛世",
      "text": "少女βは苦しかった",
      "trans": "少女β很痛苦"
    },
    {
      "id": "1012003050090",
      "name": "凛世",
      "text": "博士の心の中にいるのは\\nオリジナルの方だと知っていたから",
      "trans": "因为她知道\\n博士心中的那个人，不是身为仿造品的自己"
    },
    {
      "id": "1012003050100",
      "name": "凛世",
      "text": "『＿いたい』……\\n『＿いたい』……──",
      "trans": "“__心好痛”……\\n“__心好痛”……——"
    },
    {
      "id": "0000000000000",
      "name": "通知音声",
      "text": "『お客様のおかけになった電話は────』",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──電源切るなんて……珍しいな……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……いや、まさか\\nどこか行っちゃうなんてことないよな",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世にかぎって……────",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "1012003050110",
      "name": "凛世",
      "text": "──心を……こめて……\\n勤めてまいります……",
      "trans": "——全心……全意……\\n献上表演……"
    },
    {
      "id": "1012003050120",
      "name": "凛世",
      "text": "……プロデューサーさま……！\\n凛世は……大丈夫でございます────",
      "trans": "……制作人大人……！\\n凛世……没事的————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──\\n凛世…………",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……すみません！　はい！\\n──見かけてないですか……",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "ダンストレーナー",
      "text": "そっちの方向よそっちのー！",
      "trans": "——凛世，没接电话啊……"
    },
    {
      "id": "0000000000000",
      "name": "ボイストレーナー",
