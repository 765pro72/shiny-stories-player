{
  "translator": "楚西瑜",
  "rows": [
    {
      "id": "2012010030010",
      "name": "凛世",
      "text": "ひとつ……",
      "trans": "一个……"
    },
    {
      "id": "2012010030020",
      "name": "凛世",
      "text": "ふたつ……",
      "trans": "两个……"
    },
    {
      "id": "2012010030030",
      "name": "凛世",
      "text": "──\\n３つめは……覚えておりません……",
      "trans": "——\\n第三个……已经记不得了……"
    },
    {
      "id": "2012010030040",
      "name": "凛世",
      "text": "貴方さまを……\\n見ておりましたから……",
      "trans": "因为……\\n在看着您……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ええと……\\nはい……",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "すぐにそちらに向かいますので……\\n今、別の現場でして──",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はい、それでは……\\n後ほどです。よろしくお願いいたします──",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030050",
      "name": "凛世",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ぁっと、凛世……！",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030060",
      "name": "凛世",
      "text": "…………\\nプロデューサーさま……あの──",
      "trans": "…………\\n制作人大人……那个——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……凛世、見られるぞ！\\n花火！",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030070",
      "name": "凛世",
      "text": "…………！",
      "trans": "…………！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "今日さ、この現場から見えるかもって\\n言ってただろ？",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030080",
      "name": "凛世",
      "text": "…………\\nプロデューサーさま……",
      "trans": "…………\\n制作人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺はちょっと、ずっとはいられないんだけど……\\n20分くらいは、な？",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "すぐに向かいますので……",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030090",
      "name": "凛世",
      "text": "いえ……あの……\\nプロデューサーさまは────",
      "trans": "不……那个……\\n制作人大人————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "行こう。楽しみにしてたんじゃないか？\\n屋上、上がっていいってさ！",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030100",
      "name": "凛世",
      "text": "…………！",
      "trans": "…………！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世はずっといてくれて大丈夫だからな\\n許可取っとい──",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あ、凛世──！",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030110",
      "name": "凛世",
      "text": "プロデューサーさま……！",
      "trans": "制作人大人……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そんな、急が──",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030120",
      "name": "凛世",
      "text": "参りましょう……！",
      "trans": "快走吧……！"
    },
    {
      "id": "2012010030130",
      "name": "凛世",
      "text": "まばゆく……\\nまばゆく……",
      "trans": "熠熠生辉……\\n璀璨夺目……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ、着替えもまだじゃないか",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030140",
      "name": "凛世",
      "text": "ふふ……っ\\n時間が……ございません……",
      "trans": "哼哼……\\n时间……不多了……"
    },
    {
      "id": "2012010030150",
      "name": "凛世",
      "text": "照らされる……\\n貴方さま……",
      "trans": "被烟花……\\n照耀着的您……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おおー……！\\nここ、すごいなぁ！　穴場ってやつだよ",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030160",
      "name": "凛世",
      "text": "貴方さまを……\\n見る凛世……",
      "trans": "注视着您的……\\n凛世……"
    },
    {
      "id": "2012010030170",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012010030180",
      "name": "凛世",
      "text": "ふふ……",
      "trans": "哼哼……"
    },
    {
      "id": "2012010030190",
      "name": "凛世",
      "text": "３つめは……\\n何色だったでしょう……",
      "trans": "第三个……\\n是什么颜色呢……"
    },
    {
      "id": "2012010030200",
      "name": "凛世",
      "text": "──……\\n…………プロデューサーさま",
      "trans": "——……\\n…………制作人大人"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ん？",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030210",
      "name": "凛世",
      "text": "…………\\nどうぞ……行ってくださいませ……",
      "trans": "…………\\n还请……赶紧去吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………えっと\\n凛世──",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030220",
      "name": "凛世",
      "text": "本当は……\\nすぐにお発ちに……ならなければ────",
      "trans": "实际上……\\n早就应该……赶过去了吧————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………聞いてたのか、電話",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030230",
      "name": "凛世",
      "text": "──ああ……\\nそうだ……",
      "trans": "————啊……\\n是的……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──じゃあ、凛世",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030240",
      "name": "凛世",
      "text": "はい……\\nお気をつけて……",
      "trans": "嗯……\\n路上小心……"
    },
    {
      "id": "2012010030250",
      "name": "凛世",
      "text": "紅だったかも……\\nしれません……",
      "trans": "或许是红的……\\n也说不定……"
    },
    {
      "id": "2012010030260",
      "name": "凛世",
      "text": "貴女なら……\\n引き留めたのでしょうか……",
      "trans": "如果是她的话……\\n会选择挽留他吗……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────……ひとりじゃ心細いよなぁ、凛世\\nええと……",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『たまやー』\\n『見えてるか？』",
      "trans": "——嗯嗯……\\n我知道了……"
    },
    {
      "id": "2012010030270",
      "name": "凛世",
      "text": "──……プロデューサーさま",
      "trans": "——……制作人大人"
    },
    {
      "id": "2012010030280",
      "name": "凛世",
      "text": "……\\nなんと……ばかな凛世……",
      "trans": "……\\n凛世我……太过愚昧了……"
    },
    {
      "id": "2012010030290",
      "name": "凛世",
      "text": "はい……\\nお引き留めせずとも……",
      "trans": "嗯……\\n即使不选择挽留……"
    },
    {
      "id": "2012010030300",
      "name": "凛世",
      "text": "ひとつ空のもとに……\\n貴方さまは……──",
      "trans": "您也……——\\n在同一片天空下……"
    }
  ]
}