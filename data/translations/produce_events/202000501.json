{"translator":"","rows":[{"id":"0000000000000","name":"プロデューサー","text":"あー……","trans":"啊——……"},{"id":"0000000000000","name":"プロデューサー","text":"暑いな…………","trans":"好热啊…………"},{"id":"0000000000000","name":"プロデューサー","text":"────はぁ……\\n事務所、遠いなぁ……","trans":"────哈……\\n事务所，好远啊……"},{"id":"0000000000000","name":"プロデューサー","text":"木陰は気持ちよさそうだ……","trans":"树荫下好凉爽的样子……"},{"id":"0000000000000","name":"プロデューサー","text":"…………って\\nあそこで寝てるの…………","trans":"…………\\n在那里睡觉的是…………"},{"id":"0000000000000","name":"プロデューサー","text":"透──────？","trans":"透──────？"},{"id":"2020005010010","name":"透","text":"ふぁ────…………","trans":"哈————…………"},{"id":"0000000000000","name":"プロデューサー","text":"ええと……おーい\\n透ー……────？","trans":"那个……喂——\\n透——……"},{"id":"2020005010020","name":"透","text":"────え","trans":"————诶"},{"id":"2020005010030","name":"透","text":"……プロデューサー","trans":"……制作人"},{"id":"0000000000000","name":"プロデューサー","text":"ははっ、おう","trans":"哈哈，是我"},{"id":"2020005010040","name":"透","text":"────仕事？","trans":"————工作？"},{"id":"0000000000000","name":"プロデューサー","text":"そりゃあ、平日の午後だからな\\n透は昼寝か？","trans":"是啊，毕竟是平日的下午\\n透在午睡吗？"},{"id":"2020005010050","name":"透","text":"うん\\n平日の午後だからね","trans":"嗯\\n毕竟是平日的下午啊"},{"id":"0000000000000","name":"プロデューサー","text":"はは、優雅な平日だ\\n────事務所まで行けば涼しいのに","trans":"哈哈，真是个优雅的平日\\n————在事务所会更凉爽哦"},{"id":"2020005010060","name":"透","text":"あー\\nうん","trans":"啊——\\n嗯"},{"id":"2020005010070","name":"透","text":"ふふっ、無理だった","trans":"哈哈，不行"},{"id":"0000000000000","name":"プロデューサー","text":"無理ってことないぞ\\n一緒に行こ────","trans":"说什么不行\\n我们一块去吧————"},{"id":"2020005010080","name":"透","text":"座ってよ","trans":"坐下吧"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"2020005010090","name":"透","text":"風、くるよ\\nここ","trans":"风，要起了\\n这儿"},{"id":"0000000000000","name":"プロデューサー","text":"──おぉ……\\nいい風だな……！","trans":"——喔……\\n好舒服的风啊……！"},{"id":"2020005010100","name":"透","text":"でしょ\\nほら","trans":"你看\\n是吧"},{"id":"0000000000000","name":"プロデューサー","text":"じゃあ────","trans":"那么————"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"2020005010110","name":"透","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"2020005010120","name":"透","text":"…………\\n……止まったね、風","trans":"…………\\n……风，停了呢…………"},{"id":"0000000000000","name":"プロデューサー","text":"……\\nうん……","trans":"……\\n嗯……"},{"id":"select","name":"","text":"……すまん\\n俺のせいかな","trans":"……抱歉\\n都怪我"},{"id":"select","name":"","text":"……来ちゃ\\nいけなかったな","trans":"……风\\n来不了了呢"},{"id":"select","name":"","text":"風よ、こい！\\n……なんて","trans":"风，起！\\n……说笑的"},{"id":"2020005010130","name":"透","text":"……\\nなんで？","trans":"……\\n为什么呢？"},{"id":"0000000000000","name":"プロデューサー","text":"いや、なんとなく……\\nタイミング的に","trans":"不，总觉得……\\n是时机不对"},{"id":"2020005010140","name":"透","text":"ふふっ\\nそんなわけないじゃん","trans":"哈哈\\n怎么可能嘛"},{"id":"0000000000000","name":"プロデューサー","text":"いやぁ、ほら、俺が来たことでさ\\n涼しいはずの未来が書き換わって……みたいな","trans":"不，你看，就像是因为我来了\\n才把本应该凉爽的未来给改写了……什么的"},{"id":"2020005010150","name":"透","text":"……だったらさ","trans":"……如果是那样的话"},{"id":"2020005010160","name":"透","text":"もっかい、書き換えられるでしょ\\nプロデューサー","trans":"再改写一次，也能做到吧\\n制作人"},{"id":"0000000000000","name":"プロデューサー","text":"……え","trans":"……诶"},{"id":"2020005010170","name":"透","text":"ほらほら、なんかやって\\n未来が変わるっぽいこと","trans":"好啦好啦，做些什么吧\\n看上去像是能改变未来的那种"},{"id":"0000000000000","name":"プロデューサー","text":"ええっ、あぁ……！　うーん…………！\\n……じゃあ、ここ来なかったってことにして俺は戻────","trans":"诶诶，啊……！嗯…………！\\n……那就当我没来过这里吧，我先回————"},{"id":"2020005010180","name":"透","text":"────きた…………","trans":"————来了…………"},{"id":"2020005010181","name":"透＆プロデューサー","text":"あははっ…………","trans":"啊哈哈…………"},{"id":"2020005010190","name":"透","text":"あー……","trans":"啊——……"},{"id":"2020005010200","name":"透","text":"戻らない未来でいいから","trans":"没回去的未来明明也挺好的"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"2020005010210","name":"透","text":"で、いいから\\n私","trans":"明明，也挺好的\\n对我来说"},{"id":"2020005010220","name":"透","text":"──？\\nなんで","trans":"——？\\n为什么"},{"id":"0000000000000","name":"プロデューサー","text":"いや、なんというか……\\n俺が止めちゃったみたいな雰囲気だからさ","trans":"不，怎么说呢……\\n感觉就像是我让它停下来一样"},{"id":"2020005010230","name":"透","text":"そうだけど","trans":"是这样没错"},{"id":"0000000000000","name":"プロデューサー","text":"ええっ、そうなのか","trans":"诶诶，是这样吗"},{"id":"2020005010240","name":"透","text":"タイミング的には、うん","trans":"就时机上来说，是这样"},{"id":"0000000000000","name":"プロデューサー","text":"それは……すまない","trans":"那……真是抱歉"},{"id":"2020005010250","name":"透","text":"ふふっ","trans":"哈哈"},{"id":"2020005010260","name":"透","text":"……止むことになってたから\\nきっと","trans":"……所以风才会停啊\\n一定"},{"id":"0000000000000","name":"プロデューサー","text":"え……？","trans":"诶……？"},{"id":"2020005010270","name":"透","text":"それで……\\nここに来ることになってた。プロデューサー","trans":"然后……\\n你就来了。制作人"},{"id":"0000000000000","name":"プロデューサー","text":"……おう","trans":"……喔"},{"id":"2020005010280","name":"透","text":"だから、\\nいなよ","trans":"所以，\\n不要"},{"id":"2020005010290","name":"透","text":"いなよ","trans":"不要"},{"id":"2020005010300","name":"透","text":"────何？","trans":"————什么？"},{"id":"0000000000000","name":"プロデューサー","text":"っ、その……\\n呼んでみようかなと思って…………","trans":"我……\\n想着要不要喊下试试…………"},{"id":"2020005010310","name":"透","text":"ふふっ","trans":"哈哈"},{"id":"0000000000000","name":"プロデューサー","text":"笑わないでくれよ\\n──透は呼べそうな雰囲気あるけどな","trans":"别笑我啊\\n——透看起来倒像是会喊出来的人"},{"id":"2020005010320","name":"透","text":"無理でしょ","trans":"我办不到啊"},{"id":"0000000000000","name":"プロデューサー","text":"いや\\n無理かどうかは、やってみなきゃ","trans":"不\\n这得试过才知道，自己究竟能不能办到"},{"id":"2020005010330","name":"透","text":"……\\n風よ、こい……！","trans":"……\\n风，起……！"},{"id":"2020005010331","name":"透＆プロデューサー","text":"────あははっ……","trans":"————啊哈哈"},{"id":"2020005010340","name":"透","text":"汗かいちゃったじゃん、もう\\n……じゃ、交代ね","trans":"都出汗了，真是的\\n……那么，换人"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"2020005010350","name":"透","text":"────呼んでよ、風","trans":"————喊啊，风"},{"id":"2020005010360","name":"透","text":"やってみなきゃ","trans":"不是说试过才知道吗"}]}