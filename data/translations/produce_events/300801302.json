{"translator":"Rosineae","rows":[{"id":"3008013020010","name":"にちか","text":"────……","trans":""},{"id":"0000000000000","name":"バスの運転手","text":"────はい、発車……","trans":"────好，发车……"},{"id":"3008013020020","name":"にちか","text":"──────","trans":""},{"id":"3008013020030","name":"霧子","text":"────……","trans":""},{"id":"3008013020040","name":"霧子","text":"────わ……\\n眩しい……","trans":"────哇……\\n好刺眼……"},{"id":"3008013020050","name":"にちか","text":"────……","trans":""},{"id":"0000000000000","name":"チェインのメッセージ","text":"『事務所でお渡しするものがあります\\nレッスン前に立ち寄っていただけると嬉しいです』","trans":"“事务所有件东西是给你的\\n上课前能去一趟的话我会很高兴的”"},{"id":"3008013020060","name":"にちか","text":"────えー……","trans":"────诶……"},{"id":"3008013020070","name":"にちか","text":"……早く言ってよ……","trans":"……早点说啊……"},{"id":"3008013020080","name":"霧子","text":"……\\n２分後……","trans":"……\\n两分后……"},{"id":"3008013020090","name":"霧子","text":"もう少し……","trans":"快了……"},{"id":"0000000000000","name":"バスの運転手","text":"はい次停車……","trans":"下一站到了……"},{"id":"3008013020100","name":"にちか","text":"……はー\\nタクシーにすればよかった……","trans":"……哈\\n早知道就坐出租车了……"},{"id":"3008013020110","name":"霧子","text":"────","trans":""},{"id":"3008013020120","name":"にちか","text":"────あ","trans":"────啊"},{"id":"3008013020130","name":"霧子","text":"────\\nあ……","trans":"────\\n啊……"},{"id":"3008013020140","name":"にちか","text":"はっ？　休んで上手くなるなら休みますよ……！\\nプロデューサーさんもゆっくり休んでくださいねじゃ……！","trans":"哈？要是休息能进步的话我就去休息了……！\\n那制作人也请慢慢休息哦……！"},{"id":"3008013020150","name":"にちか","text":"あははっ、練習量なんか関係ないですもんねー\\nお友だちごっこでアイドルやってる人たちには……！","trans":"啊哈哈，跟练习量什么的根本没关系呢\\n对那些装好朋友做偶像的人来说……！"},{"id":"3008013020160","name":"霧子","text":"……？","trans":""},{"id":"3008013020170","name":"にちか","text":"それじゃ、休んで友だち作ってきますねー\\n失礼しますー","trans":"那么，我这就休息去交朋友了\\n再见──"},{"id":"3008013020171","name":"霧子＆にちか","text":"──────！","trans":""},{"id":"3008013020180","name":"にちか","text":"────幽谷……さん……","trans":"────幽谷……小姐……"},{"id":"3008013020190","name":"にちか","text":"……っ\\nお、お疲れ様です……","trans":"……\\n辛、辛苦了……"},{"id":"3008013020200","name":"霧子","text":"は、はい……！\\nお疲れさま……です……","trans":"嗯、嗯……！\\n辛苦了……"},{"id":"3008013020210","name":"にちか","text":"────失礼しますー……","trans":"────失陪了……"},{"id":"3008013020220","name":"霧子","text":"あ……\\nさようなら……","trans":"啊……\\n再见……"},{"id":"3008013020230","name":"にちか","text":"……あ、どうも────","trans":"……啊，你好────"},{"id":"3008013020240","name":"にちか","text":"……うわ\\nこっち来るかな……","trans":"……呜哇\\n会过来这里吗……"},{"id":"3008013020250","name":"にちか","text":"……","trans":""},{"id":"3008013020260","name":"霧子","text":"────……","trans":""},{"id":"3008013020270","name":"にちか","text":"あー……\\n前行った","trans":"啊……\\n到前面去了"},{"id":"0000000000000","name":"バスの運転手","text":"はい発車……","trans":"发车……"},{"id":"3008013020280","name":"にちか","text":"……────","trans":""},{"id":"3008013020290","name":"霧子","text":"……","trans":""},{"id":"3008013020300","name":"にちか","text":"……\\n事務所、かな","trans":"……\\n是去事务所吗"},{"id":"3008013020310","name":"にちか","text":"降りたら一緒歩こうとかって、なるかな……","trans":"“下车后一起走吧”之类的，会变成这样吗……"},{"id":"3008013020320","name":"にちか","text":"────途中でコンビニとか寄れー……\\nていうかどっか違うとこで降りますように……","trans":"────请中途下车去趟便利店什么的吧……\\n希望在不同地方下车……"},{"id":"3008013020330","name":"にちか","text":"……","trans":""},{"id":"3008013020340","name":"霧子","text":"……────","trans":""},{"id":"0000000000000","name":"にちか","text":"あははっ、練習量なんか関係ないですもんねー\\nお友だちごっこでアイドルやってる人たちには……！","trans":"啊哈哈，跟练习量什么的根本没关系呢\\n对那些装好朋友做偶像的人来说……！"},{"id":"3008013020360","name":"にちか","text":"……どこから聞こえてただろ","trans":"……听到了多少呢"},{"id":"3008013020370","name":"にちか","text":"あんな……","trans":"像那样……"},{"id":"3008013020380","name":"にちか","text":"……あんな────","trans":"……像那样────"},{"id":"3008013020390","name":"霧子","text":"……","trans":""},{"id":"3008013020400","name":"にちか","text":"────っ……","trans":"────……"},{"id":"0000000000000","name":"バスの運転手","text":"はい次停車……","trans":"下一站到了……"},{"id":"3008013020410","name":"にちか","text":"…………あっ","trans":"…………啊"},{"id":"3008013020420","name":"にちか","text":"……","trans":""},{"id":"3008013020430","name":"霧子","text":"……","trans":""},{"id":"3008013020440","name":"にちか","text":"……っ\\n振り向いた────","trans":"……\\n回头了────"},{"id":"3008013020441","name":"霧子＆にちか","text":"あの…………","trans":"那个…………"},{"id":"3008013020442","name":"霧子＆にちか","text":"────あ、どうぞ……","trans":"────啊，对不起……/────啊，你说……"},{"id":"3008013020443","name":"霧子＆にちか","text":"事務所、行くんですか……！","trans":"那个，事务所──/是去事务所吗……！"},{"id":"3008013020450","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008013020460","name":"霧子","text":"事務所に……行きます……","trans":"是去事务所……"},{"id":"3008013020470","name":"にちか","text":"……あ、あー\\nじゃ、一緒ですねー……","trans":"……啊，啊──\\n那我们一样呢……"},{"id":"3008013020480","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008013020490","name":"霧子","text":"あの……","trans":"那个……"},{"id":"3008013020500","name":"霧子","text":"ゆっくり……","trans":"慢慢……"},{"id":"3008013020510","name":"霧子","text":"ゆっくりで……","trans":"慢慢来……"},{"id":"3008013020520","name":"にちか","text":"……っ","trans":"……"},{"id":"3008013020530","name":"霧子","text":"お話……しなくてよくて……","trans":"不用……说话也可以……"},{"id":"3008013020540","name":"霧子","text":"歩きませんか……","trans":"能一起走吗……"},{"id":"3008013020550","name":"霧子","text":"事務所まで……","trans":"到事务所……"},{"id":"3008013020560","name":"にちか","text":"……\\nは、はい────","trans":"……\\n嗯、嗯────"},{"id":"3008013020570","name":"にちか","text":"────あの……","trans":"────那个……"},{"id":"0000000000000","name":"off","text":"お友だちごっこ","trans":"假装朋友"},{"id":"3008013020580","name":"にちか","text":"……はい────","trans":"……好────"}]}