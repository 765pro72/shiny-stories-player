{"translator":"岛木","rows":[{"id":"6020001010010","name":"透","text":"よーし……","trans":"好"},{"id":"0000000000000","name":"プロデューサー","text":"うん、透\\n気合十分みたいだな","trans":"嗯，透\\n好像蛮有干劲啊"},{"id":"6020001010020","name":"透","text":"うん\\nこれ、あのゴミ箱に入ったら勝つ──","trans":"嗯\\n丢进垃圾箱，就算赢──"},{"id":"0000000000000","name":"プロデューサー","text":"……え？","trans":"……诶？"},{"id":"6020001010030","name":"透","text":"──んっ……","trans":"──嘿……"},{"id":"6020001010040","name":"透","text":"えっ","trans":"诶"},{"id":"0000000000000","name":"プロデューサー","text":"えっ……\\nま、負ける……のか？","trans":"诶……\\n输，输了吗？"},{"id":"6020001010050","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"6020001010060","name":"透","text":"入るまでやる","trans":"投到进为止"},{"id":"6020001010070","name":"透","text":"で、勝つから","trans":"就会赢的"}]}