{"translator":"","rows":[{"id":"3020005010010","name":"小糸","text":"──と、透ちゃん\\n忘れ物って、何を忘れたの……？","trans":"——小，小透\\n你说忘拿东西，是忘了什么……？"},{"id":"3020005010020","name":"透","text":"え？","trans":"诶？"},{"id":"3020005010030","name":"雛菜","text":"ジャージ～\\nポケットになんか入ってるって","trans":"外套～\\n口袋里好像有什么"},{"id":"3020005010040","name":"円香","text":"──どうせ家のカギとかでしょ","trans":"——反正就是家门钥匙什么的吧"},{"id":"3020005010050","name":"透","text":"え\\nうん","trans":"诶\\n嗯"},{"id":"3020005010060","name":"円香","text":"……","trans":""},{"id":"3020005010070","name":"雛菜","text":"あは～\\n大変～～～","trans":"啊哈～\\n不妙～～～"},{"id":"3020005010080","name":"小糸","text":"で、でも\\n部活棟はまだ明るいけど────","trans":"可，可是\\n虽然社团楼还开着灯————"},{"id":"3020005010090","name":"小糸","text":"２年生の教室の方、\\n真っ暗だよ……！","trans":"二年级的教室那边\\n黑压压的……！"},{"id":"3020005010100","name":"円香","text":"入れると思うけど\\n生徒指導とかに見つかったらだるい","trans":"我觉得能进去\\n但被指导老师看到就完了"},{"id":"3020005010110","name":"透","text":"────","trans":""},{"id":"0000000000000","name":"off","text":"月","trans":"月亮"},{"id":"3020005010130","name":"小糸","text":"──透ちゃん……？","trans":"——小透……？"},{"id":"3020005010140","name":"透","text":"──落ちてる\\nなんか","trans":"——有东西掉下来了\\n好像"},{"id":"3020005010150","name":"透","text":"サッカーボール","trans":"足球"},{"id":"3020005010160","name":"透","text":"月\\n冷えてる月","trans":"月亮\\n寒冷的月亮"},{"id":"3020005010170","name":"円香","text":"……パス","trans":"……传球"},{"id":"3020005010180","name":"小糸","text":"ま、円香ちゃん……！","trans":"圆，圆香……！"},{"id":"3020005010190","name":"雛菜","text":"あは～\\n透先輩、こっちにパス～！","trans":"啊哈～\\n透学姐，传到这边～！"},{"id":"3020005010200","name":"透","text":"を\\n蹴っ飛ばす","trans":"把\\n月亮踢飞"},{"id":"3020005010210","name":"小糸","text":"も、もう……！\\nせ、先生とか来たら────","trans":"真，真是……！\\n老，老师来的话————"},{"id":"3020005010220","name":"透","text":"よーし\\nじゃ小糸ちゃんから────","trans":"好\\n那就交给小糸————"},{"id":"3020005010230","name":"小糸","text":"ぴ、ぴぇ……！","trans":"耶，耶……！"},{"id":"3020005010240","name":"透","text":"──えいっ","trans":"——嘿"},{"id":"3020005010241","name":"一同","text":"……！","trans":""},{"id":"3020005010250","name":"雛菜","text":"あは～！","trans":"啊哈～！"},{"id":"3020005010260","name":"透","text":"そしたら、\\nこうなる","trans":"然后，\\n就变这样"},{"id":"3020005010270","name":"雛菜","text":"あ～\\n飛んでったね～？","trans":"啊～\\n飞走了啊～？"},{"id":"3020005010280","name":"小糸","text":"ぷ、プールに\\n入っちゃったよ……！？","trans":"掉，掉进\\n泳池里了啊……！？"},{"id":"3020005010290","name":"透","text":"よし\\nフェンス越えよう","trans":"好\\n翻过护栏吧"},{"id":"3020005010300","name":"透","text":"雛菜、はい\\n跨いだら支えるから","trans":"雏菜，来\\n跨的时候会撑住你的"},{"id":"3020005010310","name":"雛菜","text":"うん～！","trans":"嗯～！"},{"id":"3020005010320","name":"小糸","text":"だ、誰か来ちゃうって……！","trans":"都，都说会有人来……！"},{"id":"3020005010330","name":"円香","text":"拾いに行くんだし\\nいいことでしょ","trans":"只是去捡球\\n是好事吧"},{"id":"3020005010340","name":"小糸","text":"い、いいことなのかな……！？","trans":"这，这是好事吗……！？"},{"id":"3020005010350","name":"雛菜","text":"よい……\\nしょ～～～！","trans":"嘿……\\n咻～～～！"},{"id":"3020005010360","name":"透","text":"着地成功\\n──じゃ、小糸ちゃん","trans":"着陆成功\\n——那换小糸"},{"id":"3020005010370","name":"小糸","text":"え、ええ……！","trans":"诶，诶……！"},{"id":"3020005010380","name":"円香","text":"──誰か来るかも\\n早く","trans":"——可能会有人来\\n快点"},{"id":"3020005010390","name":"小糸","text":"……！\\nい、いいことしてるって──","trans":"……！\\n你，你不说是好事——"},{"id":"3020005010400","name":"雛菜","text":"頑張って～～","trans":"加油～～"},{"id":"3020005010410","name":"小糸","text":"ぴ、ぴぇ…………！","trans":"耶，耶…………！"},{"id":"3020005010420","name":"透","text":"オッケーオッケー\\n跨ぐ時ゆっくり────","trans":"OKOK\\n跨的时候慢慢来————"},{"id":"0000000000000","name":"誰かの声","text":"おーい……！","trans":"喂——……！"},{"id":"3020005010421","name":"一同","text":"……！？","trans":""},{"id":"0000000000000","name":"応答する声","text":"おー！\\n部室閉めんぞー！　早くー！","trans":"哦——！\\n社团教室要锁门了！ 快点——！"},{"id":"3020005010430","name":"小糸","text":"──────！","trans":""},{"id":"3020005010440","name":"円香","text":"──セーフ","trans":"——安全"},{"id":"3020005010450","name":"透","text":"小糸ちゃん、大丈夫？","trans":"小糸没事吧？"},{"id":"3020005010460","name":"小糸","text":"う、うん……！\\n────あ…………","trans":"啊，嗯……！\\n————啊…………"},{"id":"3020005010470","name":"透","text":"月が、落ちてた","trans":"月亮，掉了下来"},{"id":"3020005010480","name":"小糸","text":"プール……\\n水、ないんだね……！","trans":"泳池离……\\n没水啊……！"},{"id":"3020005010490","name":"透","text":"あはは、ほんとだ\\nやばい","trans":"啊哈哈，真的没水\\n不妙"},{"id":"3020005010500","name":"透","text":"飛び込めー\\nどぼーん","trans":"跳进去——\\n噗通——"},{"id":"3020005010510","name":"雛菜","text":"やは～\\nどぼ～ん！","trans":"呀哈～\\n噗通～！"},{"id":"3020005010520","name":"透","text":"プール、イエー","trans":"泳池，耶——"},{"id":"3020005010530","name":"小糸","text":"ぼ、ボールあるー？","trans":"有，有球吗——？"},{"id":"3020005010540","name":"円香","text":"排水溝のあたりとか","trans":"是不是在排水沟附近"},{"id":"3020005010550","name":"雛菜","text":"透先輩～\\nクロール～～～","trans":"透学姐～\\n自由泳～～～"},{"id":"3020005010560","name":"透","text":"あ、いいね\\n背泳ぎー","trans":"啊，这个好\\n仰泳——"},{"id":"3020005010570","name":"小糸","text":"──わ、わぁ……！\\n危ないよもう……！","trans":"——哇，哇……\\n好危险啊……！"},{"id":"3020005010580","name":"小糸","text":"──はぁ……！","trans":"——哈……！"},{"id":"3020005010590","name":"小糸","text":"ボール、回収……！","trans":"足球回收完成……！"},{"id":"3020005010600","name":"透","text":"よーし","trans":"好——"},{"id":"3020005010610","name":"透","text":"じゃ、いくよ\\n今度はいい感じに蹴る────","trans":"那要踢了\\n这次会踢得很好————"},{"id":"3020005010620","name":"透","text":"空には\\n水が張られている","trans":"天上\\n充满了水"},{"id":"3020005010630","name":"小糸","text":"──え……！\\nも、もう蹴っちゃ────","trans":"——诶……！\\n不，不可以踢————"},{"id":"3020005010640","name":"雛菜","text":"いけ～\\nシュート～～～","trans":"上吧～\\n射门～～～"},{"id":"3020005010650","name":"円香","text":"狙ってけー","trans":"瞄好了——"},{"id":"3020005010660","name":"透","text":"しゃ────","trans":"好————"},{"id":"3020005010661","name":"一同","text":"────","trans":""},{"id":"3020005010662","name":"一同","text":"──────！","trans":""},{"id":"3020005010670","name":"透","text":"泳ぐには\\nいい夜かもしれない","trans":"游泳的话\\n或许是个不错的夜晚"},{"id":"3020005010680","name":"透","text":"ね、月","trans":"对吧，月亮"},{"id":"3020005010690","name":"円香","text":"行こ\\n外には出したし","trans":"走吧\\n都已经出来了"},{"id":"3020005010700","name":"小糸","text":"い、いいかな……","trans":"可，可以吗……"},{"id":"3020005010710","name":"雛菜","text":"雛菜、\\n帰りにコンビニ寄りたい～","trans":"雏菜，\\n回去的时候想去便利店～"},{"id":"3020005010720","name":"円香","text":"寒いしね","trans":"很冷了"},{"id":"3020005010730","name":"円香","text":"──浅倉","trans":"——浅仓"},{"id":"3020005010740","name":"透","text":"────え、うん","trans":"————诶，嗯"},{"id":"3020005010750","name":"透","text":"行こう","trans":"走吧"},{"id":"3020005010760","name":"透","text":"月まで行こう","trans":"走到月亮那"},{"id":"3020005010770","name":"透","text":"ドボン","trans":"噗通"}]}