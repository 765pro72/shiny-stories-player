{"translator":"可可","rows":[{"id":"0000000000000","name":"プロデューサー","text":"────えっ！？\\nすまん、よく聞こえない……","trans":"────诶！？\\n抱歉，我听不清……"},{"id":"0000000000000","name":"プロデューサー","text":"……うん、ちょっと待ってくれ\\n静かなところ移動するから……！","trans":"……嗯，稍等一下\\n我找个安静点的位置……！"},{"id":"0000000000000","name":"プロデューサー","text":"にちか、今どのあたりなんだ……？","trans":"日花，你现在在哪里……？"},{"id":"0000000000000","name":"プロデューサー","text":"…………わかった\\nどこか目印になりそうなところ────","trans":"…………知道了\\n有没有什么可以参考的地标────"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、うん、チェインしてくれ\\n…………１回切るよ","trans":"啊，嗯，发信息给我吧\\n…………先挂电话了"},{"id":"2024011110010","name":"にちか","text":"………………","trans":"………………"},{"id":"0000000000000","name":"off","text":"ああいうイベントとか\\nにちか、あまり好きじゃないかなって","trans":"像那种活动\\n日花，应该是不太喜欢的吧"},{"id":"2024011110020","name":"にちか","text":"──────…………","trans":"──────…………"},{"id":"0000000000000","name":"若者たち","text":"フゥ～～～～～ッ！！","trans":"唔呼～～～～～！！"},{"id":"0000000000000","name":"若者たち","text":"ぎゃははは……！","trans":"嘎哈哈哈……！"},{"id":"2024011110030","name":"にちか","text":"…………いやほんと……","trans":"…………那种事说真的……"},{"id":"0000000000000","name":"off","text":"会いにくる日じゃん……家族に\\nハロウィンって","trans":"因为据说万圣节是个……能和家人\\n相见的节日"},{"id":"0000000000000","name":"off","text":"亡くなった人たちが──────","trans":"能和去世的家人相见────"},{"id":"2024011110040","name":"にちか","text":"────……ないでしょ、普通に","trans":"────……当然是，不可能的吧"},{"id":"2024011110050","name":"にちか","text":"…………────────","trans":"…………────────"},{"id":"0000000000000","name":"off","text":"──────ただいま","trans":"──────我回来了"},{"id":"2024011110060","name":"にちか","text":"…………え……","trans":"…………诶……"},{"id":"2024011110070","name":"にちか","text":"…………おか──────","trans":"…………欢迎──────"},{"id":"0000000000000","name":"プロデューサー","text":"にちか……！","trans":"日花……！"},{"id":"0000000000000","name":"プロデューサー","text":"よかった……","trans":"太好了……"},{"id":"2024011110080","name":"にちか","text":"──────あ……","trans":"──────啊……"},{"id":"0000000000000","name":"プロデューサー","text":"ごめんな、はぐれちゃって\\n……やっぱりすごいな、ハロウィン","trans":"抱歉，和你走散了\\n……果然很不得了啊，万圣节"},{"id":"2024011110090","name":"にちか","text":"………………","trans":"………………"},{"id":"0000000000000","name":"プロデューサー","text":"…………にちか？","trans":"…………日花？"},{"id":"2024011110100","name":"にちか","text":"…………──────","trans":"…………──────"},{"id":"2024011110110","name":"にちか","text":"…………どーんっ！","trans":"…………咚！"},{"id":"0000000000000","name":"プロデューサー","text":"────てっ……！？","trans":"────呃……！？"},{"id":"2024011110120","name":"にちか","text":"がうがう…………！\\n……どーーんっ！","trans":"嘎哦嘎哦…………！\\n……咚！"},{"id":"0000000000000","name":"プロデューサー","text":"に、にちか……？\\n痛いって…………！","trans":"日，日花……？\\n痛痛…………！"},{"id":"2024011110130","name":"にちか","text":"…………ハロウィンなので……！","trans":"…………因为是万圣节……！"},{"id":"2024011110140","name":"にちか","text":"どーんっ！","trans":"咚！"},{"id":"0000000000000","name":"プロデューサー","text":"おい…………にちか……！","trans":"喂…………日花……！"},{"id":"2024011110150","name":"にちか","text":"…………！","trans":"…………！"},{"id":"0000000000000","name":"プロデューサー","text":"お、おーい！？\\nまたはぐれるぞ──────にちか！","trans":"喂，喂！？\\n别又走散了啊──────日花！"}]}