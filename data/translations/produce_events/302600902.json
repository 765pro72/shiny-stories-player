{"translator":"煉金術式","rows":[{"id":"3026009020010","name":"off","text":"鈴木羽那","trans":"铃木羽那"},{"id":"3026009020020","name":"off","text":"────……","trans":""},{"id":"3026009020030","name":"ルカ","text":"……","trans":""},{"id":"3026009020040","name":"羽那","text":"……","trans":""},{"id":"3026009020050","name":"ルカ","text":"いっ……","trans":"啧……"},{"id":"3026009020060","name":"羽那","text":"……？","trans":""},{"id":"3026009020070","name":"羽那","text":"ルカちゃん？","trans":"路加？"},{"id":"3026009020080","name":"ルカ","text":"……指、切った","trans":"……切到指尖了"},{"id":"3026009020090","name":"羽那","text":"えーっ、大丈夫？","trans":"欸，没事吧？"},{"id":"3026009020100","name":"ルカ","text":"ああ……","trans":"嗯……"},{"id":"3026009020110","name":"ルカ","text":"（救急箱──）","trans":"（医疗箱──）"},{"id":"3026009020120","name":"ルカ","text":"────……","trans":""},{"id":"3026009020130","name":"羽那","text":"……","trans":""},{"id":"3026009020140","name":"羽那","text":"あたしがやろっか？","trans":"我帮你吧？"},{"id":"3026009020150","name":"ルカ","text":"いや──","trans":"不用──"},{"id":"3026009020160","name":"羽那","text":"でも、片手じゃやりにくくない？","trans":"但是，单手不好贴吧？"},{"id":"3026009020170","name":"ルカ","text":"……","trans":""},{"id":"3026009020180","name":"羽那","text":"？","trans":""},{"id":"3026009020190","name":"ルカ","text":"…………じゃあ、頼む","trans":"…………那拜托了"},{"id":"3026009020200","name":"羽那","text":"うんっ","trans":"嗯"},{"id":"3026009020210","name":"羽那","text":"消毒もする？","trans":"要先消毒吗？"},{"id":"3026009020220","name":"ルカ","text":"いい\\n……血がつかなければいいから","trans":"不用\\n……止个血就行"},{"id":"3026009020230","name":"羽那","text":"はーいっ","trans":"好──"},{"id":"3026009020240","name":"ルカ","text":"……悪い","trans":"……麻烦你了"},{"id":"3026009020250","name":"羽那","text":"えーっ？","trans":"欸──？"},{"id":"3026009020260","name":"羽那","text":"ブライダルの撮影までに治るといいね","trans":"希望拍婚纱照之前能好呢"},{"id":"3026009020270","name":"ルカ","text":"は……？","trans":"啊……？"},{"id":"3026009020280","name":"羽那","text":"ルカちゃん、撮影用のネイルとかするかなと思って","trans":"拍照的时候，路加不是会做美甲吗"},{"id":"3026009020290","name":"羽那","text":"綺麗なやつ──！","trans":"超漂亮的那个──！"},{"id":"3026009020300","name":"羽那","text":"絆創膏してたら見えないでしょ？","trans":"被创可贴遮住多可惜嘛？"},{"id":"3026009020310","name":"ルカ","text":"……\\n撮影で絆創膏しないだろ","trans":"……\\n拍照的时候又不用贴"},{"id":"3026009020320","name":"羽那","text":"あはっ、確かに","trans":"啊哈，也是"},{"id":"3026009020330","name":"ルカ","text":"……アンタもやれば","trans":"……你也做呗"},{"id":"3026009020340","name":"羽那","text":"……？","trans":""},{"id":"3026009020350","name":"ルカ","text":"ネイル\\n興味あるなら","trans":"美甲\\n你没兴趣吗"},{"id":"3026009020360","name":"羽那","text":"あーっ","trans":"啊──"},{"id":"3026009020370","name":"羽那","text":"でも、ずっとお店で座ってなきゃいけないんだよね？\\n大変そうー……","trans":"不过要在店里坐着不动很久吧\\n感觉很累人……"},{"id":"3026009020380","name":"ルカ","text":"……","trans":""},{"id":"3026009020390","name":"ルカ","text":"ライブ用にやる時とか、普通に待ててんじゃん","trans":"演出之前，不也能乖乖坐着让人帮你做吗"},{"id":"3026009020400","name":"羽那","text":"それは──","trans":"那是因为──"},{"id":"3026009020410","name":"羽那","text":"──メイクさんと話してるから？","trans":"──能和化妆师聊天？"},{"id":"3026009020420","name":"ルカ","text":"……","trans":""},{"id":"3026009020430","name":"羽那","text":"……だから、ルカちゃんがネイルをやってくれたら\\nきっと大変じゃないね？","trans":"……所以，要是路加能帮我做美甲\\n说不定我就不抱怨咯？"},{"id":"3026009020440","name":"ルカ","text":"は、──……","trans":"哈──……"},{"id":"3026009020450","name":"ルカ","text":"……じゃあ一生大変だな","trans":"……那你还是抱怨去吧"},{"id":"3026009020460","name":"羽那","text":"えーっ","trans":"欸──"},{"id":"3026009020470","name":"羽那","text":"──はいっ\\nできたよ、ルカちゃん","trans":"──好啦\\n贴好咯，路加"},{"id":"3026009020480","name":"ルカ","text":"……","trans":""},{"id":"3026009020490","name":"ルカ","text":"……どうも","trans":"……谢了"},{"id":"3026009020500","name":"羽那","text":"ふふっ、うん──！","trans":"呵呵，嗯──！"},{"id":"3026009020510","name":"ルカ","text":"（────変なヤツ）","trans":"（────真是怪人）"}]}