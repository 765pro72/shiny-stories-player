{"translator":"魚見","rows":[{"id":"3023011010010","name":"小糸","text":"なんか、いつもより静かだね","trans":"总感觉，比平时要安静呢"},{"id":"3023011010020","name":"小糸","text":"テスト期間だからかな……","trans":"是因为考试周吗……"},{"id":"3023011010030","name":"雛菜","text":"へ～\\nそうなの～？","trans":"诶～\\n这样吗～？"},{"id":"3023011010040","name":"雛菜","text":"雛菜、いつもすぐ帰っちゃうからよくわかんないかも～","trans":"雏菜，平时都很早回去，可能不太清楚～"},{"id":"3023011010050","name":"小糸","text":"そ、そっか……","trans":"这、这样啊……"},{"id":"3023011010060","name":"小糸","text":"と、図書室で少し勉強していく？","trans":"要、要去图书馆学会习吗？"},{"id":"3023011010070","name":"雛菜","text":"ん～……\\nでも、人いっぱいいそうだよね～……","trans":"嗯～……\\n但是，感觉会很多人～……"},{"id":"3023011010080","name":"小糸","text":"……そ、そうだね","trans":"……那、那也是"},{"id":"3023011010090","name":"小糸","text":"あ……","trans":"啊……"},{"id":"3023011010100","name":"雛菜","text":"ん～？","trans":"嗯～？"},{"id":"3023011010110","name":"雛菜","text":"あ～！","trans":"啊～！"},{"id":"3023011010120","name":"雛菜","text":"透先輩～！","trans":"透前辈～！"},{"id":"3023011010130","name":"雛菜","text":"あれ～、円香先輩もいる～！\\n何してるの～？","trans":"咦～、圆香前辈也在～！\\n你们在干嘛～？"},{"id":"3023011010140","name":"透","text":"見てた\\n中","trans":"在看\\n里面"},{"id":"3023011010150","name":"雛菜","text":"中って、体育館？","trans":"里面，是说体育馆？"},{"id":"3023011010160","name":"雛菜","text":"誰もいないよ～","trans":"一个人都没有呀～"},{"id":"3023011010170","name":"小糸","text":"いつもはバスケ部の人たちがいるもんね……！","trans":"平时都是排球部的人在这吧……！"},{"id":"3023011010180","name":"小糸","text":"と、透ちゃん……！","trans":"透、透……！"},{"id":"3023011010190","name":"透","text":"あー","trans":"啊——"},{"id":"3023011010200","name":"透","text":"あー","trans":"啊——"},{"id":"3023011010210","name":"透","text":"響いてる","trans":"响起来了"},{"id":"3023011010220","name":"雛菜","text":"あは～\\n雛菜もやる～！","trans":"啊哈～\\n雏菜也要玩～！"},{"id":"3023011010230","name":"雛菜","text":"……あ～っ！","trans":"……啊～！"},{"id":"3023011010240","name":"雛菜","text":"あは～\\nなんか楽しいかも～","trans":"啊哈～\\n感觉还挺好玩的～"},{"id":"3023011010250","name":"小糸","text":"そ、そうなんだ……","trans":"这、这样啊……"},{"id":"0000000000000","name":"小糸","text":"……","trans":""},{"id":"3023011010270","name":"透","text":"……あー","trans":"……啊——"},{"id":"3023011010280","name":"雛菜","text":"あ～……！","trans":"啊～……！"},{"id":"3023011010281","name":"透＆雛菜","text":"あー……！","trans":"啊——……！"},{"id":"3023011010282","name":"透＆雛菜","text":"……","trans":""},{"id":"0000000000000","name":"円香","text":"…………","trans":""},{"id":"3023011010300","name":"小糸","text":"……あー","trans":"……啊——"},{"id":"0000000000000","name":"小糸","text":"……","trans":""},{"id":"3023011010311","name":"透＆雛菜","text":"あー！","trans":"啊——！"},{"id":"3023011010320","name":"小糸","text":"あー……","trans":"啊——……"},{"id":"3023011010330","name":"小糸","text":"あー……！","trans":"啊——……！"},{"id":"3023011010340","name":"透","text":"うん\\n響いてる","trans":"嗯\\n响起来了"},{"id":"3023011010350","name":"小糸","text":"えへへ……","trans":"欸嘿嘿……"},{"id":"3023011010360","name":"透","text":"樋口は？","trans":"樋口呢？"},{"id":"3023011010370","name":"円香","text":"いい","trans":"算了"},{"id":"3023011010380","name":"円香","text":"それより寒い……\\n私は先に行くから","trans":"而且好冷……\\n我先走了"},{"id":"0000000000000","name":"教師","text":"ちょっと何やってんの、こんなとこで","trans":"喂、你们在这干什么呢"},{"id":"0000000000000","name":"教師","text":"あなたたち、演劇部じゃないわよね？","trans":"你们几个，不是演剧部的吧？"},{"id":"3023011010390","name":"雛菜","text":"あ～……","trans":"啊～……"},{"id":"3023011010400","name":"雛菜","text":"はい、そうですね～","trans":"是的，您说得对～"},{"id":"0000000000000","name":"教師","text":"発声練習でもしてるのかと思ったわよ","trans":"我还以为你们是在搞发声练习呢"},{"id":"0000000000000","name":"教師","text":"遊んでないで、早く帰って勉強しなさいよ","trans":"别在这玩了，赶紧回去好好学习吧"},{"id":"3023011010401","name":"一同","text":"……","trans":""},{"id":"3023011010410","name":"小糸","text":"え、演劇部だって……","trans":"说、说是演剧部的……"},{"id":"3023011010420","name":"円香","text":"滅相もない\\n帰宅部のたわむれ","trans":"夸张\\n归宅部的儿戏罢了"}]}