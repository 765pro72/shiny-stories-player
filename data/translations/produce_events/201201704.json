      "text": "…………",
      "trans": ""
    },
    {
      "id": "2012017040020",
      "name": "凛世",
      "text": "あの……\\n花のつぼみ……",
      "trans": "那朵……\\n花蕾……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おしとやかで、控えめで、慎ましくて……",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040030",
      "name": "凛世",
      "text": "……ふふっ……",
      "trans": "……哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世の内側が輝いている証だなって、 \\nそのことも俺は嬉しかったんだよ",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040040",
      "name": "凛世",
      "text": "つぼみであっても……",
      "trans": "就是还是花蕾……"
    },
    {
      "id": "0000000000000",
      "name": "カメラマン",
      "text": "──はい、じゃあそこに立ってもらって……\\nうん、そう……いいですねー",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "0000000000000",
      "name": "カメラマン",
      "text": "それじゃあ今から、\\n月を背景に何枚か撮らせていただきます",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040050",
      "name": "凛世",
      "text": "はい……\\nよろしくお願いいたします……",
      "trans": "嗯……\\n麻烦您了……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世、お疲れ様\\nすごくよかったぞ！",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040060",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんだか今日は、\\n自信に満ち溢れてる感じだったな",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "カメラマンさんも絶賛してたし、\\nきっとすごく素敵な写真になるよ",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040070",
      "name": "凛世",
      "text": "ふふ……\\nはい……",
      "trans": "哼哼……\\n嗯……"
    },
    {
      "id": "2012017040080",
      "name": "凛世",
      "text": "シチュエーションの……\\n賜物です……",
      "trans": "得益于……\\n环境……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ\\n夜の菜の花畑なんて、なかなか粋だよな",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040090",
      "name": "凛世",
      "text": "はい……\\nそのうえ……",
      "trans": "嗯……\\n还有……"
    },
    {
      "id": "2012017040100",
      "name": "凛世",
      "text": "空には……\\n朧月も……",
      "trans": "空中的……\\n月晕……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ははっ、粋だなぁ",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "────さて、そろそろ帰るか",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040110",
      "name": "凛世",
      "text": "…………",
      "trans": ""
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……？",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040120",
      "name": "凛世",
      "text": "…………っ……",
      "trans": "…………呃……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……？",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040130",
      "name": "凛世",
      "text": "…………\\nプロデューサーさま……",
      "trans": "…………\\n制作人大人……"
    },
    {
      "id": "2012017040140",
      "name": "凛世",
      "text": "このように……\\n美しい景色……",
      "trans": "这番……\\n美景……"
    },
    {
      "id": "2012017040150",
      "name": "凛世",
      "text": "そう……\\n見られるものでは……",
      "trans": "并……\\n不常见……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "…………",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……少し散歩してから帰るか？",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040160",
      "name": "凛世",
      "text": "……！\\nはい……",
      "trans": "……！\\n好……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……うん、いい景色だな\\nのどかで、春っぽくてさ",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040170",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "朧月か……",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はっきりと見える月もいいけど、\\nこんなふうにぼんやりと見えるのも風情があっていいな",
      "trans": "娴静，内敛，稳重……"
    },
    {
      "id": "2012017040180",
      "name": "凛世",
      "text": "ふふ……\\nはい……",
      "trans": "哼哼……\\n嗯……"
    },
    {
      "id": "2012017040190",
      "name": "凛世",
      "text": "とても……",
      "trans": "非常……"
    }
  ]
}