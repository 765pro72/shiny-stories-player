{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"──出番だ、みんな","trans":"——大家该出场了"},{"id":"5004002060001","name":"一同","text":"……はいっ！","trans":"……好的！"},{"id":"5004002060010","name":"甘奈","text":"──今日も！","trans":"——今天也要！"},{"id":"5004002060020","name":"甜花","text":"……元気に……！","trans":"……充满精神地……"},{"id":"5004002060030","name":"千雪","text":"笑顔の花を咲かせよう──","trans":"让笑容的花朵绽放——"},{"id":"5004002060031","name":"一同","text":"……アルストロメリア──！","trans":"……ALSTROEMERIA——！"}]}