{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"もう夜か","trans":"晚上了啊"},{"id":"0000000000000","name":"プロデューサー","text":"ルカは──……","trans":"路加在——……"},{"id":"0000000000000","name":"プロデューサー","text":"来週、また同じ時間に来てもらえたら────","trans":"下周，你能同样时间过来的话————"},{"id":"0000000000000","name":"プロデューサー","text":"やっぱり、来ないな……","trans":"果然不来啊……"},{"id":"0000000000000","name":"プロデューサー","text":"ライブ……ですか？","trans":"演唱会……吗？"},{"id":"0000000000000","name":"制作プロデューサー","text":"ええ……！\\nハコはそれほど大きくないですが","trans":"是的……！\\n场地虽然不算太大"},{"id":"0000000000000","name":"制作プロデューサー","text":"音楽系のメディアと組んで盛り上げるつもりです\\nよければぜひ……！","trans":"我们打算和音乐类媒体合作来造势\n如果方便的话务必……！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"0000000000000","name":"プロデューサー","text":"ありがとうございます！\\n検討させていただきます……！","trans":"非常感谢！\\n"},{"id":"2026004020010","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"本当はすぐに相談したかったけど……\\n今の状態じゃ…………","trans":"实在是很想现在就和她商量……\\n但她现在的状态…………"},{"id":"0000000000000","name":"プロデューサー","text":"『大丈夫か？』","trans":"“没事吧？”"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"…………連絡","trans":"…………联络"},{"id":"0000000000000","name":"プロデューサー","text":"来てるわけないよな……","trans":"不可能联络我吧……"},{"id":"0000000000000","name":"プロデューサー","text":"あ、おっと────────","trans":"啊，哦——————"},{"id":"2026004020020","name":"ルカ","text":"どこかで落とした時、割れた","trans":"掉在什么地方的时候，碎掉的"},{"id":"2026004020030","name":"ルカ","text":"川の見えるカフェで────……\\nぼーっとしてた","trans":"我在看得见河边的咖啡厅————……\\n放空自己"},{"id":"0000000000000","name":"プロデューサー","text":"たしか……","trans":"我记得……"},{"id":"2026004020040","name":"ルカ","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"探したぞ","trans":"找你很久了"},{"id":"0000000000000","name":"プロデューサー","text":"今日、来てくれるかと思って待ってたんだ\\n……できれば連絡くらいは欲しかったかな","trans":"我觉得你今天会来才在事务所等你的\\n……至少我希望你能联络一下"},{"id":"2026004020050","name":"ルカ","text":"…………","trans":"…………"},{"id":"2026004020060","name":"ルカ","text":"帰れ","trans":"回去"},{"id":"2026004020070","name":"ルカ","text":"呼んでねぇ","trans":"没叫你来"},{"id":"0000000000000","name":"プロデューサー","text":"ああ、勝手に来た","trans":"没错，我擅自来了"},{"id":"2026004020080","name":"ルカ","text":"……","trans":"……"},{"id":"2026004020090","name":"ルカ","text":"…………","trans":"…………"},{"id":"2026004020100","name":"ルカ","text":"ドリンクメニュー","trans":"菜单"},{"id":"0000000000000","name":"プロデューサー","text":"え？","trans":"诶？"},{"id":"2026004020110","name":"ルカ","text":"いつも……\\n頼むやつ……","trans":"平常……\\n都会点的……"},{"id":"2026004020120","name":"ルカ","text":"気に入ってたやつ…………","trans":"我挺喜欢的饮料…………"},{"id":"2026004020130","name":"ルカ","text":"…………\\nなくなった────────","trans":"…………\\n没有了——————"},{"id":"0000000000000","name":"プロデューサー","text":"そうか","trans":"是吗"},{"id":"2026004020140","name":"ルカ","text":"好きだったのに","trans":"我很喜欢的"},{"id":"2026004020150","name":"ルカ","text":"…………好きだったのに────────","trans":"…………我很喜欢的——————"},{"id":"0000000000000","name":"プロデューサー","text":"…………帰ろう","trans":"…………回去吧"},{"id":"2026004020160","name":"ルカ","text":"勝手に、帰れよ……","trans":"你自己回去啊……"},{"id":"2026004020170","name":"ルカ","text":"どうせ、たいして仕事もねぇ","trans":"反正也不是什么大工作"},{"id":"0000000000000","name":"プロデューサー","text":"……ルカにオファーがあったよ","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"相談したい","trans":"我想和你谈谈"},{"id":"2026004020180","name":"ルカ","text":"……………","trans":"………………"}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}