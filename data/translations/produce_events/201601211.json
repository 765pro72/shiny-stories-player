{"translator":"沙漏","rows":[{"id":"2016012110010","name":"千雪","text":"────…………","trans":""},{"id":"2016012110020","name":"千雪","text":"うーん、構図……\\n決まらない……","trans":"嗯——，构图……\\n决定不下来……"},{"id":"2016012110030","name":"千雪","text":"紅葉をメインに描いて……","trans":"把红叶当作主体部分来画……"},{"id":"2016012110040","name":"千雪","text":"……\\nそれから────","trans":"……\\n然后————"},{"id":"0000000000000","name":"プロデューサー","text":"おーい、千雪","trans":"喂——，千雪"},{"id":"2016012110050","name":"千雪","text":"────プロデューサーさん","trans":"————制作人先生"},{"id":"0000000000000","name":"プロデューサー","text":"車、入っててくれればよかったのに","trans":"明明如果你上车了就好了"},{"id":"0000000000000","name":"プロデューサー","text":"──寒くないか？","trans":"——你冷吗？"},{"id":"2016012110060","name":"千雪","text":"ええ……！","trans":"不冷……！"},{"id":"2016012110070","name":"千雪","text":"ふふ\\nなんだか、もったいなくって","trans":"呵呵\\n总感觉，那样就太浪费了"},{"id":"0000000000000","name":"プロデューサー","text":"ん？","trans":"嗯？"},{"id":"2016012110080","name":"千雪","text":"夕方の色、\\nもっと眺めてたいなーって","trans":"我想多看看，黄昏时候夕阳的颜色——"},{"id":"0000000000000","name":"プロデューサー","text":"──あぁ……","trans":"——啊啊……"},{"id":"0000000000000","name":"プロデューサー","text":"うん\\nいい色だ","trans":"嗯\\n很漂亮的颜色"},{"id":"2016012110090","name":"千雪","text":"ええ\\nいい色なんです","trans":"嗯\\n是很漂亮的颜色"},{"id":"2016012110091","name":"千雪＆プロデューサー","text":"ははっ……","trans":"哈哈……"},{"id":"0000000000000","name":"プロデューサー","text":"──あ","trans":"——啊"},{"id":"0000000000000","name":"プロデューサー","text":"紅葉、落ちてる","trans":"红叶，飘下来了"},{"id":"2016012110100","name":"千雪","text":"……わ\\nどこから来たんでしょう","trans":"……哇\\n是从哪里飘落的呢"},{"id":"2016012110101","name":"千雪＆プロデューサー","text":"────！","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"ち、千雪、すまん\\nぶつかっちゃったな────！","trans":"千、千雪，抱歉\\n不小心撞上了啊————！"},{"id":"2016012110110","name":"千雪","text":"わ、あの……！\\nいえ……！","trans":"哇，那个……！\\n没事……！"},{"id":"2016012110120","name":"千雪","text":"ご、ごめんなさい……","trans":"对、对不起……"},{"id":"0000000000000","name":"プロデューサー","text":"いや、俺こそ……！","trans":"不，我才是……！"},{"id":"0000000000000","name":"プロデューサー","text":"大丈夫か？\\nおでこのとこ────","trans":"没事吧？\\n额头上————"},{"id":"2016012110130","name":"千雪","text":"ぜ、全然……！\\nプロデューサーさんこそ────","trans":"完、完全没事……！\\n制作人先生才是————"},{"id":"2016012110131","name":"千雪＆プロデューサー","text":"────あー……！","trans":"————啊——……！"},{"id":"2016012110140","name":"千雪","text":"もみじー……！","trans":"红叶——……！"},{"id":"2016012110150","name":"千雪","text":"──ふふっ\\nふふふっ……","trans":"——呵呵\\n呵呵呵……"},{"id":"2016012110160","name":"千雪","text":"飛んでっちゃうんだもんなぁ……","trans":"毕竟一不小心让它飞走了啊……"},{"id":"2016012110170","name":"千雪","text":"────\\nええと、構図は…………","trans":"————\\n嗯，构图…………"},{"id":"2016012110180","name":"千雪","text":"コートの人影……\\nふたつ……────","trans":"两个……\\n穿着风衣的人影……————"},{"id":"2016012110190","name":"千雪","text":"────","trans":""},{"id":"0000000000000","name":"プロデューサー","text":"────拾ってくるよ！\\n待っててくれ……","trans":"————我去捡回来！\\n等我一下……"},{"id":"2016012110200","name":"千雪","text":"ああ、いえ……！\\nそんな、いいんです────","trans":"啊啊，不用……！\\n不用这么麻烦您的————"},{"id":"0000000000000","name":"プロデューサー","text":"なんかさ、\\n大事な葉っぱって気がするんだ","trans":"我总感觉，那是片很重要的叶子"},{"id":"2016012110210","name":"千雪","text":"────え？","trans":"————诶？"},{"id":"2016012110220","name":"千雪","text":"────やめた","trans":"————我放弃了"},{"id":"2016012110230","name":"千雪","text":"──\\n大事な……？","trans":"——\\n很重要的……？"},{"id":"0000000000000","name":"プロデューサー","text":"うん、なんていうか","trans":"嗯，该怎么说呢"},{"id":"0000000000000","name":"プロデューサー","text":"あれも、千雪の夕方の……\\n大事な一色なんじゃないかなって","trans":"我觉得，那会不会也是……\\n属于千雪的黄昏的，重要的一抹色彩呢"},{"id":"2016012110240","name":"千雪","text":"…………！","trans":""},{"id":"2016012110250","name":"千雪","text":"────ふふっ……","trans":"————呵呵……"},{"id":"2016012110260","name":"千雪","text":"夕空……","trans":"黄昏的天空……"},{"id":"2016012110270","name":"千雪","text":"それから……\\n紅葉、一枚────","trans":"然后还有……\\n一片、红叶————"},{"id":"2016012110280","name":"千雪","text":"──うん\\nそれだけ","trans":"——嗯\\n只有这些"},{"id":"0000000000000","name":"プロデューサー","text":"おーい……！\\n見つけたぞー！","trans":"喂——……！\\n我找到了哦——！"},{"id":"2016012110290","name":"千雪","text":"わぁ……！","trans":"哇……！"},{"id":"2016012110300","name":"千雪","text":"……だって\\nそれで十分","trans":"……因为，\\n这样就已经"},{"id":"2016012110310","name":"千雪","text":"全部の気持ちが、描けてるんだもん────","trans":"足够能把我的心情，全部画下来了啊————"}]}