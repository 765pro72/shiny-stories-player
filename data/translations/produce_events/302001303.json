{"translator":"魚見","rows":[{"id":"0000000000000","name":"カメラマン","text":"オッケー、いいね！\\nうん、最高！","trans":"OK—，不错！\\n嗯，超棒！"},{"id":"0000000000000","name":"カメラマン","text":"目線ちょうだい！","trans":"来个视线！"},{"id":"0000000000000","name":"カメラマン","text":"ナイス！\\nいいねー！","trans":"nice！\\n真不错—！"},{"id":"0000000000000","name":"カメラマン","text":"オッケー！\\nんじゃ、フィルター変えてもう一回撮るから！","trans":"OK—！\\n那就换个滤镜接着再拍一组！"},{"id":"0000000000000","name":"スタッフ","text":"それじゃあノクチルさん\\nそのまま少し休憩でお願いしまーす！","trans":"noctchill的各位\\n请先那样休息一会吧——！"},{"id":"3020013030001","name":"一同","text":"はーい","trans":"好的——"},{"id":"3020013030010","name":"雛菜","text":"透先輩～、雛菜このままでもいい～？","trans":"透前辈～，雏菜继续这样靠着可以吗～？"},{"id":"3020013030020","name":"透","text":"うん、いいよ","trans":"嗯、可以哦"},{"id":"3020013030030","name":"雛菜","text":"あは～♡\\n今日の撮影、楽しいね～～～！","trans":"啊哈～♡\\n今天的拍摄真好玩呢～～～！"},{"id":"3020013030040","name":"円香","text":"……休憩、まだかかりそう","trans":"……休息，好像还有一阵子"},{"id":"3020013030050","name":"円香","text":"一旦ロケバスで休ませてもらう？","trans":"要说一下去外景车里休息吗？"},{"id":"3020013030060","name":"小糸","text":"で、でも、そのまま少しって言ってたから……","trans":"不、不过，刚才说一会就好了……"},{"id":"3020013030070","name":"円香","text":"……\\n小糸、暑くない？","trans":"……\\n小糸，你不热吗？"},{"id":"3020013030080","name":"小糸","text":"えっ、う、うん……！\\nまだ、大丈夫だよ……！","trans":"诶、嗯、嗯……！\\n我还好哦……！"},{"id":"3020013030090","name":"雛菜","text":"円香先輩、暑いの～？\\nいいよ～、戻ってても","trans":"圆香前辈很热吗～？\\n可以的啊～、回车里"},{"id":"3020013030100","name":"円香","text":"……いい","trans":"……算了"},{"id":"3020013030110","name":"雛菜","text":"ね～、透先輩～！\\nしりとりしよ～？","trans":"嗳～、透前辈～！\\n来词语接龙吧～？"},{"id":"3020013030120","name":"透","text":"んー、いいよ","trans":"嗯—、好哦"},{"id":"3020013030130","name":"雛菜","text":"じゃあ～、みんなでじゃんけんして～\\n負けた人からね～？","trans":"那～、大家一起来猜拳～\\n从输了的开始～？"},{"id":"3020013030140","name":"円香","text":"はいはい、みんなでね","trans":"好好好，大家一起"},{"id":"3020013030150","name":"小糸","text":"う、うん……！","trans":"嗯、嗯……！"},{"id":"3020013030151","name":"一同","text":"じゃんけん、ぽん","trans":"剪刀石头、布"},{"id":"3020013030160","name":"円香","text":"……","trans":""},{"id":"3020013030170","name":"雛菜","text":"じゃあ～、円香先輩からね～！","trans":"那就～，从圆香前辈开始咯～！"},{"id":"3020013030180","name":"円香","text":"……花","trans":"……花"},{"id":"3020013030190","name":"雛菜","text":"花～？\\n『な』……菜の花～！","trans":"花～？\\n“na”……油菜花～！"},{"id":"3020013030200","name":"小糸","text":"ぴぇ……！　また、『な』……？\\nえっと、『な』……な、ナイチンゲール……！","trans":"噼诶……！　又是、“na”……？\\n我想想、“na”……南、南丁格尔……！"},{"id":"3020013030210","name":"小糸","text":"次は『る』だよ、透ちゃん","trans":"下一个是“ru”哦、透"},{"id":"3020013030220","name":"透","text":"え？\\nあー、私か……","trans":"诶？\\n啊—、到我了啊……"},{"id":"3020013030230","name":"透","text":"え……『る』？","trans":"诶……“ru”？"},{"id":"3020013030240","name":"透","text":"あ、ルー","trans":"啊、卤"},{"id":"3020013030250","name":"円香","text":"……何？","trans":"……什么来的？"},{"id":"3020013030260","name":"透","text":"え、カレー？","trans":"诶、咖喱？"},{"id":"3020013030270","name":"円香","text":"アリなの？\\nそれ","trans":"行的吗？\\n这样"},{"id":"3020013030280","name":"透","text":"え、ナシ？","trans":"诶、不行？"},{"id":"3020013030290","name":"円香","text":"知らない\\n他にしたら？","trans":"不知道\\n你换一个呗？"},{"id":"3020013030300","name":"透","text":"んー……","trans":"嗯—……"},{"id":"3020013030310","name":"円香","text":"あるでしょ、いっぱい","trans":"还有的吧、很多"},{"id":"3020013030320","name":"透","text":"えー？","trans":"诶—？"},{"id":"3020013030330","name":"透","text":"るー、るー、るー……\\n……","trans":"ru—、ru—、ru—、……\\n……"},{"id":"3020013030331","name":"一同","text":"ふふっ","trans":"呵呵"},{"id":"3020013030340","name":"透","text":"えっ……？","trans":"诶……？"},{"id":"3020013030350","name":"小糸","text":"と、とおるちゃん……！\\nとおるちゃんのばんだよ……！","trans":"透、透……！\\n轮到透了哟……！"},{"id":"3020013030360","name":"透","text":"え……\\nあー、なんだっけ？","trans":"诶……\\n啊—、什么来着？"},{"id":"3020013030370","name":"円香","text":"『る』","trans":"“ru”"},{"id":"3020013030380","name":"透","text":"『る』？\\nるー、るー、るー……","trans":"“ru”？\\nru—、ru—、ru—……"},{"id":"3020013030390","name":"透","text":"あ、ルー","trans":"啊、卤"},{"id":"3020013030400","name":"円香","text":"え……なに？","trans":"诶……什么来的？"},{"id":"3020013030410","name":"透","text":"カレー？","trans":"咖喱？"},{"id":"3020013030420","name":"透","text":"ふふっ","trans":"呵呵"},{"id":"3020013030430","name":"雛菜","text":"透先輩～？\\nいきなり笑って、どうしたの～？","trans":"透前辈～？\\n突然就笑起来了、怎么了吗～？"},{"id":"3020013030440","name":"透","text":"え？　あー……\\n見てたかも、夢","trans":"诶？　啊—……\\n做了个梦、好像"},{"id":"3020013030450","name":"雛菜","text":"え～？\\n透先輩、寝てたの～～～？","trans":"诶～？\\n透前辈，刚睡着了吗～～～？"},{"id":"3020013030460","name":"円香","text":"……いい加減始まるんじゃない","trans":"……差不多也该开始了吧"},{"id":"0000000000000","name":"スタッフ","text":"ノクチルさん、お待たせしましたー！\\n撮影再開しまーす！","trans":"noctchill的各位，让你们久等了——！\\n继续开始拍摄咯——！"},{"id":"3020013030461","name":"一同","text":"はーい","trans":"好的——"},{"id":"3020013030470","name":"off","text":"これは、現実？\\nそれとも──","trans":"这是、现实？\\n还是说——"},{"id":"3020013030480","name":"off","text":"まだ、夢？","trans":"依然、是梦？"},{"id":"3020013030490","name":"off","text":"どこから、夢だった？","trans":"从哪开始、就已经是梦了？"},{"id":"3020013030500","name":"透","text":"なんか、浮いてるみたい……","trans":"感觉、像是浮了起来……"}]}