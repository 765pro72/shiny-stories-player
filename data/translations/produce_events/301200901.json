{
  "translator": "阿柚",
  "rows": [
    {
      "id": "3012009010010",
      "name": "凛世",
      "text": "かごめ……\\nかごめ……",
      "trans": "竹笼缝……\\n竹笼缝……"
    },
    {
      "id": "3012009010020",
      "name": "凛世",
      "text": "…………────",
      "trans": "…………────"
    },
    {
      "id": "3012009010030",
      "name": "凛世",
      "text": "かごのなかの……\\nとりは……",
      "trans": "竹笼中关着的……\\n鸟儿啊……"
    },
    {
      "id": "3012009010040",
      "name": "凛世",
      "text": "いつ……いつ……\\nでやる……",
      "trans": "何时……何刻……\\n才能逃……"
    },
    {
      "id": "3012009010050",
      "name": "凛世",
      "text": "よあけの……\\nばんに……",
      "trans": "黎明前的……\\n那夜里……"
    },
    {
      "id": "3012009010060",
      "name": "凛世",
      "text": "つると……かめが……\\nすべった……",
      "trans": "白鹤和……乌龟……\\n滑倒了……"
    },
    {
      "id": "3012009010070",
      "name": "凛世",
      "text": "うしろの……しょうめん……",
      "trans": "在背后的……正面是……"
    },
    {
      "id": "3012009010080",
      "name": "凛世",
      "text": "────\\n姉さま…………────",
      "trans": "────\\n姐姐…………────"
    },
    {
      "id": "3012009010090",
      "name": "凛世",
      "text": "………………",
      "trans": "………………"
    },
    {
      "id": "3012009010100",
      "name": "凛世",
      "text": "…………姉さま",
      "trans": "…………姐姐"
    },
    {
      "id": "3012009010101",
      "name": "一同",
      "text": "──つーるとかーめがすーべった！",
      "trans": "──白──鹤和乌──龟滑──倒了！"
    },
    {
      "id": "3012009010102",
      "name": "一同",
      "text": "うしろのしょうめんだーあれっ！",
      "trans": "在背后的那个人是谁！"
    },
    {
      "id": "3012009010110",
      "name": "智代子",
      "text": "んん～……！\\n……えっとねぇ……！",
      "trans": "嗯～……！\\n……那个……！"
    },
    {
      "id": "3012009010120",
      "name": "智代子",
      "text": "果穂！\\n──の声は、前から聞こえた気がするから……！",
      "trans": "果穗！\\n──的声音，听上去感觉是在前面……！"
    },
    {
      "id": "3012009010130",
      "name": "果穂",
      "text": "はいっ！　当たりです！\\n……あっ！",
      "trans": "对！　猜中了！\\n……啊！"
    },
    {
      "id": "3012009010140",
      "name": "樹里",
      "text": "……っ！",
      "trans": "……！"
    },
    {
      "id": "3012009010150",
      "name": "夏葉",
      "text": "うふふっ……\\nそれじゃあヒントになるわ、果────",
      "trans": "嗯哼哼……\\n那样就相当于给提示了，果────"
    },
    {
      "id": "3012009010160",
      "name": "夏葉",
      "text": "──あっ",
      "trans": "──啊"
    },
    {
      "id": "3012009010170",
      "name": "智代子",
      "text": "はいっ、果穂がそっち！\\n夏葉ちゃんがこっち！",
      "trans": "好，那边是果穗！\\n这边是夏叶！"
    },
    {
      "id": "3012009010180",
      "name": "夏葉",
      "text": "……っ、うっかりしたわ……！",
      "trans": "……大，大意了……！"
    },
    {
      "id": "3012009010190",
      "name": "果穂",
      "text": "ご、ごめんなさい夏葉さん……っ！",
      "trans": "对，对不起夏叶姐……！"
    },
    {
      "id": "3012009010200",
      "name": "夏葉",
      "text": "あら、アナタが謝ることないのよ\\n巧みな駆け引きに負けてしまっただけ……",
      "trans": "哎呀，你不需要道歉哦\\n只是我输给了巧妙的策略而已……"
    },
    {
      "id": "3012009010210",
      "name": "夏葉",
      "text": "──そうよ、私はここ",
      "trans": "──没错，我在这里"
    },
    {
      "id": "3012009010220",
      "name": "樹里",
      "text": "……っ────",
      "trans": "……────"
    },
    {
      "id": "3012009010230",
      "name": "智代子",
      "text": "──ということで……！\\nうしろのしょうめんは樹里ちゃんか凛世ちゃんの２択……！",
      "trans": "──也就是说……！\\n我背后的人只剩树里和凛世这两个选项……！"
    },
    {
      "id": "3012009010231",
      "name": "果穂＆夏葉",
      "text": "……っ",
      "trans": "……"
    },
    {
      "id": "3012009010240",
      "name": "樹里",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "3012009010250",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "3012009010260",
      "name": "智代子",
      "text": "……っ\\nは、反応なし……",
      "trans": "……\\n完，完全没反应……"
    },
    {
      "id": "3012009010270",
      "name": "夏葉",
      "text": "手強いふたりよ\\nよく考えて、感じて！",
      "trans": "两个人都不好对付哦\\n用心想，仔细感受！"
    },
    {
      "id": "3012009010280",
      "name": "智代子",
      "text": "っ、うん……！\\n感じる……────",
      "trans": "嗯……！\\n感受……────"
    },
    {
      "id": "3012009010290",
      "name": "智代子",
      "text": "──ふたりとも～！？\\n完全に気配が消えちゃってるよ～！？",
      "trans": "──两位！？\\n连呼吸声都完全听不见了啊～！？"
    },
    {
      "id": "3012009010300",
      "name": "果穂",
      "text": "──あっ、すみません、あたしです！",
      "trans": "──啊，对不起，是我的手机！"
    },
    {
      "id": "3012009010310",
      "name": "果穂",
      "text": "プロデューサーさん……\\nちょっと出てきますっ！",
      "trans": "是制作人先生……\\n我稍微离开下！"
    },
    {
      "id": "3012009010320",
      "name": "果穂",
      "text": "もしもし────",
      "trans": "喂────"
    },
    {
      "id": "3012009010330",
      "name": "凛世",
      "text": "──プロデューサーさま……？",
      "trans": "──制作人大人……？"
    },
    {
      "id": "3012009010340",
      "name": "樹里",
      "text": "おっ、おいっ……！",
      "trans": "喂，喂……！"
    },
    {
      "id": "3012009010350",
      "name": "智代子",
      "text": "はいっ！　成りました────っ！",
      "trans": "好！　我知道了────！"
    },
    {
      "id": "3012009010360",
      "name": "智代子",
      "text": "うしろのしょうめんは、\\n凛世ちゃんですっ！",
      "trans": "在背后的那个人是\\n凛世！"
    },
    {
      "id": "3012009010370",
      "name": "樹里",
      "text": "あっちゃー……！",
      "trans": "哎呀——……！"
    },
    {
      "id": "3012009010380",
      "name": "凛世",
      "text": "ふふ……\\nはい……",
      "trans": "哼哼……\\n嗯……"
    },
    {
      "id": "3012009010390",
      "name": "凛世",
      "text": "凛世でございます……",
      "trans": "正是凛世……"
    },
    {
      "id": "3012009010400",
      "name": "智代子",
      "text": "えへへ、全然わかんなかったよー\\n鬼って意外と緊張するね……",
      "trans": "诶嘿嘿，根本感受不到呢\\n当鬼意外的紧张啊……"
    },
    {
      "id": "3012009010410",
      "name": "凛世",
      "text": "お疲れ様でした……智代子さん……\\nでは……",
      "trans": "辛苦了……智代子……\\n那么……"
    },
    {
      "id": "3012009010420",
      "name": "凛世",
      "text": "替わりましょう……",
      "trans": "换凛世吧……"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "かーごめー……かーごーめー…………",
      "trans": "竹——笼缝——……竹——笼——缝——…………"
    },
    {
      "id": "3012009010430",
      "name": "樹里",
      "text": "ああ、凛世\\n果穂が戻ってからで大丈夫だ────",
      "trans": "啊，凛世\\n等果穗回来再开始也没关系────"
    },
    {
      "id": "3012009010440",
      "name": "凛世",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "3012009010450",
      "name": "樹里",
      "text": "──？\\n凛世……どうかしたか？",
      "trans": "──？\\n凛世……怎么了？"
    },
    {
      "id": "3012009010460",
      "name": "凛世",
      "text": "…………っ\\nいえ……────",
      "trans": "…………啊\\n没事……────"
    },
    {
      "id": "3012009010470",
      "name": "凛世",
      "text": "『凛世が鬼』",
      "trans": "『凛世是鬼』"
    },
    {
      "id": "3012009010480",
      "name": "凛世",
      "text": "『みなが凛世を囲み、』",
      "trans": "『大家将凛世围住，』"
    },
    {
      "id": "3012009010490",
      "name": "夏葉",
      "text": "集中……！\\n今度は集中していくわよ……！",
      "trans": "注意……！\\n集中精神准备开始了……！"
    },
    {
      "id": "3012009010500",
      "name": "凛世",
      "text": "『楽しく、楽しく』",
      "trans": "『欢快，愉悦』"
    },
    {
      "id": "3012009010510",
      "name": "凛世",
      "text": "『まだまだ、帰りたくない……と』",
      "trans": "『一点也，不想回去……』"
    },
    {
      "id": "3012009010520",
      "name": "智代子",
      "text": "果穂ーっ、大丈夫だった？\\n呼ばれちゃったりとか──",
      "trans": "果穗——什么事？\\n难道是喊你过去之类的──"
    },
    {
      "id": "3012009010530",
      "name": "凛世",
      "text": "『あの折も、このようなあかい陽に』",
      "trans": "『那时也是，悬在高空的艳阳里』"
    },
    {
      "id": "3012009010540",
      "name": "凛世",
      "text": "『群青の濃いのが混ざっておりました』",
      "trans": "『群青色的叆融了进去』"
    },
    {
      "id": "3012009010550",
      "name": "果穂",
      "text": "大丈夫ですっ！\\nスケジュールの確認でした！",
      "trans": "没事！\\n只是确认了下日程表而已！"
    },
    {
      "id": "3012009010560",
      "name": "果穂",
      "text": "それじゃあ、次の勝負……\\n始めましょう！",
      "trans": "那么，赶紧开始……\\n下一局游戏吧！"
    },
    {
      "id": "3012009010570",
      "name": "凛世",
      "text": "…………────",
      "trans": "…………────"
    },
    {
      "id": "3012009010580",
      "name": "凛世",
      "text": "……っ\\nは、はい……！",
      "trans": "……啊\\n呃，嗯……！"
    },
    {
      "id": "3012009010590",
      "name": "凛世",
      "text": "『ふと思い出し、したためております』",
      "trans": "『不知为何，突然想起此景』"
    },
    {
      "id": "0000000000000",
      "name": "off",
      "text": "うしろのしょうめん……だーあれ……",
      "trans": "竹——笼缝——……竹——笼——缝——…………"
    },
    {
      "id": "0000000000000",
      "name": "？？？",
      "text": "ふふっ……\\n凛世……────",
      "trans": "竹——笼缝——……竹——笼——缝——…………"
    },
    {
      "id": "3012009010600",
      "name": "凛世",
      "text": "あれっ……姉さま……！",
      "trans": "咦……姐姐……！"
    },
    {
      "id": "3012009010610",
      "name": "凛世",
      "text": "姉さま……",
      "trans": "姐姐……"
    },
    {
      "id": "3012009010620",
      "name": "凛世",
      "text": "どこに……\\n行かれるのですか……",
      "trans": "您究竟……\\n要去何方……"
    }
  ]
}