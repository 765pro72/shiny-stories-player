{"translator":"告","rows":[{"id":"0000000000000","name":"コンビニ店員","text":"17円のお返しです\\nありがとうございましたー","trans":"找您17日元\\n谢谢惠顾—"},{"id":"3021002010010","name":"透","text":"はーい","trans":"好的—"},{"id":"0000000000000","name":"コンビニ店員","text":"次の方どうぞー","trans":"下一位—"},{"id":"3021002010020","name":"透","text":"……樋口","trans":"……樋口"},{"id":"3021002010030","name":"円香","text":"ん","trans":"嗯"},{"id":"3021002010040","name":"透","text":"あれ、さっきからいた？","trans":"咦，你刚才在吗？"},{"id":"3021002010050","name":"円香","text":"いた","trans":"在"},{"id":"3021002010060","name":"透","text":"え、呼んでた？","trans":"诶，你叫我吗？"},{"id":"3021002010070","name":"円香","text":"ううん","trans":"没有"},{"id":"3021002010080","name":"円香","text":"入った時から、いるのは気付いてたけど","trans":"我进来才发现你在"},{"id":"3021002010090","name":"透","text":"そっか","trans":"是吗"},{"id":"0000000000000","name":"コンビニ店員","text":"……238円、１点。157円、１点","trans":"……238元，1样。157元，1样"},{"id":"3021002010100","name":"円香","text":"あ……あと、カフェラテのMで","trans":"啊……再要一杯中杯拿铁"},{"id":"0000000000000","name":"コンビニ店員","text":"カフェラテMですねー……\\n──合計３点、545円になります","trans":"中杯拿铁对吧—……\\n——3样一共545日元"},{"id":"3021002010110","name":"円香","text":"ICカードでお願いします\\n……じゃ、お疲れ","trans":"麻烦刷IC卡\\n……那，辛苦了"},{"id":"3021002010120","name":"透","text":"んー","trans":"嗯—"},{"id":"0000000000000","name":"コンビニ店員","text":"ありがとうございましたー","trans":"谢谢惠顾—"},{"id":"3021002010130","name":"円香","text":"……あれ","trans":"……咦"},{"id":"3021002010140","name":"透","text":"ん？","trans":"嗯？"},{"id":"3021002010150","name":"円香","text":"……待っててくれたの？","trans":"……你在等我吗？"},{"id":"3021002010160","name":"透","text":"あー……コーヒー飲んでた","trans":"啊—……咖啡，我喝掉了"},{"id":"3021002010170","name":"円香","text":"……じゃ、帰ろうか","trans":"……那，回去吧"},{"id":"3021002010180","name":"透","text":"うん","trans":"嗯"},{"id":"3021002010190","name":"透","text":"……","trans":""},{"id":"3021002010200","name":"円香","text":"……","trans":""},{"id":"3021002010210","name":"透","text":"……おはよ","trans":"……早上好"},{"id":"3021002010220","name":"円香","text":"は？","trans":"哈？"},{"id":"3021002010230","name":"円香","text":"何、急に。夜だけど","trans":"突然怎么了。现在是晚上啊"},{"id":"3021002010240","name":"透","text":"夜でもおはようなんだって","trans":"晚上也要说早上好"},{"id":"3021002010250","name":"透","text":"業界だと","trans":"在业界的话"},{"id":"3021002010260","name":"円香","text":"え？　あー……","trans":"诶？ 啊—……"},{"id":"3021002010270","name":"円香","text":"働き方が色々だから、\\n時間帯問わずでおはよう……なんだっけ","trans":"因为什么样的工作方式都有，\\n所以什么时间都要说早上好……之类的"},{"id":"3021002010280","name":"透","text":"ふふっ\\nらしいよ","trans":"呵呵\\n好像是"},{"id":"3021002010290","name":"透","text":"だから、おはよ","trans":"所以，早上好"},{"id":"3021002010300","name":"円香","text":"私、芸能人じゃないし","trans":"我可不是艺人"},{"id":"3021002010310","name":"透","text":"そうなの？","trans":"是吗？"},{"id":"3021002010320","name":"円香","text":"そっちはどうなの？","trans":"你又怎么样？"},{"id":"3021002010330","name":"透","text":"んー……","trans":"嗯—……"},{"id":"3021002010340","name":"透","text":"どうだろ？","trans":"怎么样呢？"},{"id":"3021002010350","name":"円香","text":"ほら","trans":"你看"},{"id":"3021002010360","name":"透","text":"まあ、そうなんだって","trans":"不过，大概是吧"},{"id":"3021002010370","name":"円香","text":"ふうん……","trans":"哼……"},{"id":"3021002010380","name":"円香","text":"……","trans":""},{"id":"3021002010390","name":"円香","text":"もう、色々やってるんだ","trans":"我们已经做了很多事吧"},{"id":"3021002010400","name":"透","text":"え、うん\\nテレビ局行ったよ、挨拶","trans":"诶，嗯\\n我去了电视台，去打招呼"},{"id":"3021002010410","name":"円香","text":"ふうん……","trans":"哼……"},{"id":"3021002010420","name":"透","text":"そっちは？","trans":"你呢？"},{"id":"3021002010430","name":"円香","text":"宣材写真、撮った","trans":"拍了宣传照"},{"id":"3021002010440","name":"透","text":"あー、撮った撮った","trans":"啊—，我也有"},{"id":"3021002010450","name":"透","text":"見せてよ、樋口の","trans":"给我看看嘛，樋口的"},{"id":"3021002010460","name":"円香","text":"嫌","trans":"不要"},{"id":"3021002010470","name":"透","text":"えー","trans":"诶—"},{"id":"3021002010480","name":"円香","text":"なんか嫌。勘違いしてるみたいで","trans":"我觉得不好。好像会错意一样"},{"id":"3021002010490","name":"透","text":"そうなんだ？","trans":"是这样啊？"},{"id":"3021002010500","name":"円香","text":"…………","trans":""},{"id":"3021002010510","name":"円香","text":"っていうかさ、\\n浅倉は、なんで──……","trans":"话说，\\n浅仓，你为什么——……"},{"id":"3021002010520","name":"透","text":"……？","trans":""},{"id":"3021002010530","name":"円香","text":"…………","trans":""},{"id":"3021002010540","name":"円香","text":"……コンビニにいたの？","trans":"……会在便利店？"},{"id":"3021002010550","name":"透","text":"え……なんとなく","trans":"诶……顺其自然"},{"id":"3021002010560","name":"透","text":"コーヒー買うため？","trans":"为了买咖啡？"},{"id":"3021002010570","name":"円香","text":"ま、そうだよね","trans":"我想也是"},{"id":"3021002010580","name":"透","text":"うん","trans":"嗯"},{"id":"3021002010590","name":"透","text":"えっ、何","trans":"诶，怎么了"},{"id":"3021002010600","name":"円香","text":"ううん、別に","trans":"没有，没事"},{"id":"3021002010610","name":"透","text":"──じゃ、家入るから","trans":"——那，我进家门了"},{"id":"3021002010620","name":"円香","text":"ん、お疲れ","trans":"嗯，辛苦了"},{"id":"3021002010630","name":"透","text":"お疲れ","trans":"辛苦了"},{"id":"3021002010640","name":"透","text":"おはようございました","trans":"早上好了"},{"id":"3021002010650","name":"円香","text":"ふっ……それ、絶対違うでしょ","trans":"呵……你这绝对说错了吧"}]}