{"translator":"魚見","rows":[{"id":"3021009020010","name":"円香","text":"……あ","trans":"……啊"},{"id":"3021009020020","name":"円香","text":"購買、寄る","trans":"去下小卖部"},{"id":"3021009020030","name":"透","text":"うぃー","trans":"好——"},{"id":"3021009020040","name":"小糸","text":"あ……\\n雛菜ちゃんも行く？","trans":"啊……\\n雏菜也去吗？"},{"id":"3021009020050","name":"雛菜","text":"うん～！\\nでも教室寄ってから～","trans":"嗯～！\\n不过先回趟教室"},{"id":"3021009020060","name":"小糸","text":"そっか\\nじゃあわたしも……","trans":"这样啊\\n那我也……"},{"id":"3021009020070","name":"小糸","text":"──透ちゃん、円香ちゃん\\n先に行ってて……！","trans":"——透，圆香\\n你们先过去吧……！"},{"id":"3021009020080","name":"円香","text":"ん……","trans":"嗯……"},{"id":"3021009020090","name":"透","text":"お","trans":"噢"},{"id":"3021009020091","name":"透＆円香","text":"クリームパン──────","trans":"奶油面包——————"},{"id":"3021009020100","name":"円香","text":"……最後のひとつなんだけど","trans":"……就剩最后一个了"},{"id":"3021009020110","name":"透","text":"え？　うん","trans":"诶？　嗯"},{"id":"3021009020120","name":"透","text":"樋口も？\\nクリームパン","trans":"樋口也是？\\n奶油面包"},{"id":"3021009020130","name":"円香","text":"まあ","trans":"嘛"},{"id":"3021009020140","name":"円香","text":"この間、売り切れてたから","trans":"之前，卖光了"},{"id":"3021009020150","name":"透","text":"あー","trans":"啊——"},{"id":"3021009020160","name":"円香","text":"浅倉はよく食べてるでしょ","trans":"浅仓经常吃的吧"},{"id":"3021009020170","name":"円香","text":"他のにしたら\\n今日は","trans":"也试试别的呗\\n今天"},{"id":"3021009020180","name":"透","text":"んー","trans":"嗯——"},{"id":"3021009020190","name":"透","text":"食べてないから\\n最近","trans":"没吃啊\\n最近"},{"id":"3021009020200","name":"円香","text":"最近っていつ？\\n昨日？","trans":"最近是什么时候？\\n昨天？"},{"id":"3021009020210","name":"透","text":"あー","trans":"啊——"},{"id":"3021009020220","name":"透","text":"どうだろ\\nだいぶ","trans":"谁知道呢\\n相当"},{"id":"3021009020221","name":"透＆円香","text":"…………………………","trans":""},{"id":"3021009020230","name":"円香","text":"この前、500円貸した","trans":"之前，借了你500元"},{"id":"3021009020240","name":"透","text":"あー","trans":"啊——"},{"id":"3021009020250","name":"透","text":"でも、貸したじゃん","trans":"但是，不是给你了吗"},{"id":"3021009020260","name":"透","text":"傘\\nその後","trans":"伞\\n那之后"},{"id":"3021009020270","name":"円香","text":"傘は返した","trans":"伞还给你了"},{"id":"3021009020280","name":"円香","text":"それで500円が帳消し？","trans":"那样子500元就销账了？"},{"id":"3021009020290","name":"透","text":"え？","trans":"诶？"},{"id":"3021009020300","name":"円香","text":"おかしいでしょ","trans":"太奇怪了吧"},{"id":"3021009020310","name":"透","text":"あー……","trans":"噢——……"},{"id":"3021009020320","name":"円香","text":"だからここは\\n譲るっていうのも、アリ","trans":"所以这里\\n让给我也，可以有"},{"id":"3021009020330","name":"透","text":"んー……","trans":"嗯——……"},{"id":"3021009020340","name":"透","text":"ねぇ","trans":"呐"},{"id":"3021009020350","name":"円香","text":"ん","trans":"嗯"},{"id":"3021009020360","name":"透","text":"食べたい？\\nクリームパン","trans":"想吃吗？\\n奶油面包"},{"id":"3021009020370","name":"透","text":"めっ……ちゃ","trans":"超……想"},{"id":"3021009020380","name":"円香","text":"…………………………","trans":""},{"id":"3021009020390","name":"円香","text":"……まあ","trans":"……嘛"},{"id":"3021009020400","name":"円香","text":"別に……\\nめっちゃってほどじゃない","trans":"并不……\\n倒也没到超想"},{"id":"3021009020410","name":"透","text":"そうなんだ","trans":"这样啊"},{"id":"3021009020420","name":"透","text":"じゃ\\nもらっていい？","trans":"那\\n能收下吗？"},{"id":"3021009020430","name":"円香","text":"いやおかしいでしょ","trans":"不是太奇怪了吧"},{"id":"3021009020440","name":"透","text":"えー","trans":"诶——"},{"id":"3021009020450","name":"円香","text":"浅倉は食べたいの？","trans":"浅仓想吃吗？"},{"id":"3021009020460","name":"透","text":"え？　うん\\nめっ……ちゃ","trans":"诶？　嗯\\n超……想"},{"id":"3021009020470","name":"円香","text":"ふーん","trans":"哼——嗯"},{"id":"3021009020480","name":"円香","text":"じゃ、もらっていい？","trans":"那，能收下吗？"},{"id":"3021009020490","name":"透","text":"え？","trans":"诶？"},{"id":"3021009020500","name":"透","text":"あー……","trans":"啊——……"},{"id":"3021009020510","name":"円香","text":"……","trans":"……"},{"id":"3021009020520","name":"透","text":"ふふっ\\n欲しいってことか、めっ……ちゃ","trans":"呵呵\\n所以是想吃啊，超……想"},{"id":"3021009020530","name":"透","text":"オッケー\\nじゃ、貸し１","trans":"OK——\\n那，一次借"},{"id":"3021009020540","name":"円香","text":"………………","trans":""},{"id":"3021009020550","name":"円香","text":"いい、もう","trans":"算了，真是"},{"id":"3021009020560","name":"透","text":"え","trans":"诶"},{"id":"3021009020570","name":"円香","text":"あげる","trans":"给你了"},{"id":"3021009020580","name":"円香","text":"他のにするから\\nどうぞ","trans":"我吃其他的\\n请吧"},{"id":"3021009020590","name":"透","text":"おー","trans":"噢——"},{"id":"3021009020600","name":"透","text":"神","trans":"神"},{"id":"3021009020610","name":"透","text":"あざーす","trans":"感谢——"},{"id":"3021009020620","name":"雛菜","text":"あは～！","trans":"啊哈～！"},{"id":"3021009020630","name":"雛菜","text":"クリームパン残ってた！\\n最後のひとつ～！","trans":"奶油面包还有剩！\\n最后一个～！"},{"id":"3021009020640","name":"雛菜","text":"すみません～！\\nお会計お願いします────","trans":"打扰一下～！\\n麻烦结账————"},{"id":"3021009020641","name":"透＆円香","text":"…………………………","trans":""},{"id":"3021009020650","name":"小糸","text":"ご、ごめんね……！\\nちょっと遅くなっちゃった","trans":"抱、抱歉啊……！\\n稍微晚了点"},{"id":"3021009020660","name":"小糸","text":"欲しいのあった？\\nもう買っちゃった……？","trans":"有想吃的吗？\\n已经买好了……？"},{"id":"3021009020661","name":"透＆円香","text":"…………………………","trans":""},{"id":"3021009020662","name":"透＆円香","text":"まだ","trans":"还没"}]}