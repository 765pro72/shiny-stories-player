{"translator":"告","rows":[{"id":"3020007020010","name":"雛菜","text":"透先輩～\\n首貸してね～！","trans":"透学姐～\\n脖子借一下～！"},{"id":"3020007020020","name":"透","text":"……っ\\nつめた……","trans":"……\\n好冷……"},{"id":"3020007020030","name":"透","text":"つめたい、指\\nめっちゃ","trans":"手指好冷\\n超冷"},{"id":"3020007020040","name":"雛菜","text":"うん～\\nでも透先輩の首はあったかいよ～？","trans":"嗯～\\n可是透学姐的脖子很温暖哦～？"},{"id":"3020007020050","name":"小糸","text":"だ、だからって\\n雛菜ちゃ──","trans":"就，就算这样\\n雏菜也——"},{"id":"3020007020060","name":"透","text":"ふふっ\\nいいでしょ","trans":"呵呵\\n没关系啦"},{"id":"3020007020070","name":"小糸","text":"────い、いいんだ……","trans":"————没，没关系啊……"},{"id":"3020007020080","name":"円香","text":"……\\n首より、あっちの方がよくない？","trans":"……\\n脖子应该不如那个吧？"},{"id":"3020007020090","name":"雛菜","text":"へ～？","trans":"诶～？"},{"id":"3020007020100","name":"小糸","text":"あ、たいやき……！\\n屋台来てるんだ……","trans":"啊，鲷鱼烧……！\\n原来有摊子来了……"},{"id":"3020007020110","name":"透","text":"おー","trans":"哦——"},{"id":"3020007020120","name":"透","text":"雛菜\\n首にする？　たいやきにする？","trans":"雏菜\\n选脖子？ 还是选鲷鱼烧？"},{"id":"3020007020130","name":"雛菜","text":"ん～……","trans":"嗯～……"},{"id":"3020007020140","name":"雛菜","text":"たいやき～！","trans":"鲷鱼烧～！"},{"id":"3020007020150","name":"透","text":"イエー","trans":"耶——"},{"id":"3020007020160","name":"円香","text":"あつ……","trans":"好烫……"},{"id":"3020007020170","name":"円香","text":"何","trans":"干什么"},{"id":"3020007020180","name":"透","text":"貸す？\\n耳たぶ","trans":"要用吗？\\n耳垂"},{"id":"3020007020190","name":"円香","text":"いい","trans":"不用"},{"id":"3020007020200","name":"雛菜","text":"ね、『天然』って何～？","trans":"“天然”是什么意思～？"},{"id":"3020007020210","name":"小糸","text":"あ……包み紙に『天然』って\\n書いてあるね……","trans":"啊……包装纸上\\n写着“天然”呢……"},{"id":"3020007020220","name":"小糸","text":"これは天然の鯛で……\\n養殖の鯛じゃないですって言いたいのかな……？","trans":"是说这是天然的鲷鱼……\\n而不是养殖的鲷鱼吗……？"},{"id":"3020007020230","name":"円香","text":"……それ、どういうこと？","trans":"……那是什么意思？"},{"id":"3020007020240","name":"透","text":"あ、じゃあ\\n養殖かも、こっち","trans":"啊，那这样\\n这可能养殖的"},{"id":"3020007020250","name":"小糸","text":"……！\\n全部、天然じゃないかな……！","trans":"……！\\n全都不是天然的吗……！"},{"id":"3020007020260","name":"透","text":"勢いがない\\n目に","trans":"眼神\\n没有劲"},{"id":"3020007020270","name":"円香","text":"養殖に失礼","trans":"对养殖的很失礼啊"},{"id":"3020007020280","name":"雛菜","text":"それじゃ、雛菜のも養殖かも～","trans":"那雏菜的也可能是养殖的～"},{"id":"3020007020290","name":"小糸","text":"い、一緒だよ全部……！","trans":"全，全都一样啦……！"},{"id":"3020007020300","name":"透","text":"じゃ、ひと口\\n小糸ちゃんの","trans":"那来一口\\n小糸的"},{"id":"3020007020310","name":"小糸","text":"ぴぇ……！\\nあ、熱いから気を付けて……！","trans":"耶……！\\n要，要小心烫……！"},{"id":"3020007020320","name":"透","text":"──む\\n……あっつ","trans":"——呣\\n……好烫"},{"id":"3020007020330","name":"小糸","text":"ほ、ほら……！\\n一回、出す……？","trans":"你，你看吧……！\\n要先吐出来吗……？"},{"id":"3020007020340","name":"透","text":"だ……らいじょーぶ","trans":"没……没关西——"},{"id":"3020007020350","name":"円香","text":"持つ？","trans":"帮你拿？"},{"id":"3020007020360","name":"透","text":"うん","trans":"嗯"},{"id":"3020007020370","name":"小糸","text":"──わ……！","trans":"——哇……！"},{"id":"3020007020380","name":"小糸","text":"……！\\nわんちゃんだ……！","trans":"……！\\n是小狗……！"},{"id":"3020007020390","name":"円香","text":"え……どこから来たの","trans":"诶……哪来的"},{"id":"3020007020400","name":"透","text":"狙ってるのかな\\n天然のやつ","trans":"盯上了吗\\n天然的鲷鱼烧"},{"id":"3020007020410","name":"雛菜","text":"あ～\\nお腹減ってるのか～","trans":"啊～\\n是肚子饿了吗～"},{"id":"3020007020420","name":"円香","text":"変な物、食べさせない方がいいと思うけど","trans":"别给它吃怪东西比较好"},{"id":"3020007020430","name":"透","text":"天然物だよ","trans":"这是天然的"},{"id":"3020007020440","name":"円香","text":"はいはい","trans":"知道了知道了"},{"id":"3020007020450","name":"小糸","text":"ご、ごめんね……\\nたいやきは、あげられないんだ……！","trans":"对，对不起……\\n鲷鱼烧不能给你吃……！"},{"id":"3020007020460","name":"雛菜","text":"飼い主は～？","trans":"饲主呢～？"},{"id":"3020007020470","name":"透","text":"ふふっ\\nひとりぼっちなの、おまえ？","trans":"呵呵\\n就你一个吗？"},{"id":"3020007020480","name":"透","text":"……あー","trans":"……啊——"},{"id":"3020007020490","name":"透","text":"おまえ、あいつ？","trans":"你，是它？"},{"id":"3020007020500","name":"小糸","text":"あ、透ちゃん……！\\nだめだよ、あげちゃ……！","trans":"啊，小透……！\\n不可以给它……！"},{"id":"3020007020510","name":"透","text":"大丈夫大丈夫\\n見てるだけ","trans":"没事没事\\n就看看"},{"id":"3020007020520","name":"雛菜","text":"あは～\\n飛びつきそう～","trans":"啊哈～\\n快扑上来了～"},{"id":"3020007020530","name":"円香","text":"天然物らしいからね","trans":"因为这好像是天然的"},{"id":"3020007020540","name":"透","text":"おーす、この前ぶり\\n元気そう","trans":"好啊，前段时间不见\\n很有精神啊"},{"id":"3020007020550","name":"小糸","text":"あれ\\n知り合いなの……？","trans":"咦\\n原来认识吗……？"},{"id":"3020007020560","name":"透","text":"ふふっ\\nまーね","trans":"呵呵\\n算吧——"},{"id":"3020007020570","name":"透","text":"よしよし\\nじゃ、撫でてやろ────","trans":"乖乖\\n那来摸摸你————"},{"id":"0000000000000","name":"飼い主","text":"うなぎちゃーん……！","trans":"鳗鱼——……！"},{"id":"0000000000000","name":"飼い主","text":"あれ……！\\n──すみません、うちの子がお邪魔しました……！","trans":"咦……！\\n——不好意思，我们家的狗打扰到你们了……！"},{"id":"3020007020580","name":"透","text":"────あ\\nいえ……","trans":"————啊\\n不会……"},{"id":"3020007020590","name":"雛菜","text":"ばいば～い","trans":"拜拜～"},{"id":"3020007020600","name":"透","text":"…………","trans":""},{"id":"3020007020610","name":"透","text":"さびしい","trans":"寂寞"},{"id":"3020007020620","name":"透","text":"と\\nいうのは","trans":"是\\n指的"},{"id":"3020007020630","name":"小糸","text":"……？\\nどうしたの……？","trans":"……？\\n怎么了……？"},{"id":"3020007020640","name":"透","text":"……あ、ううん","trans":"……啊，没事"},{"id":"3020007020650","name":"透","text":"ひとりぼっちだ","trans":"孑然一身啊"},{"id":"3020007020660","name":"透","text":"と\\nいうこととは","trans":"又\\n不是这个"},{"id":"3020007020670","name":"透","text":"うん\\n人違いだった","trans":"嗯\\n认错人了"},{"id":"3020007020680","name":"透","text":"関係がない","trans":"没关系的"},{"id":"3020007020690","name":"円香","text":"……\\n犬違いね","trans":"……\\n认错狗吧"},{"id":"3020007020700","name":"雛菜","text":"うなぎって呼んでたよ～？","trans":"可它叫鳗鱼啊～？"},{"id":"3020007020710","name":"小糸","text":"う、うん……！\\n天然物かな……！？","trans":"嗯，嗯……！\\n它是天然的吧……！？"},{"id":"3020007020720","name":"小糸","text":"え……！\\nう、うなぎって言うから────","trans":"诶……！\\n因，因为它叫鳗鱼————"},{"id":"3020007020730","name":"円香","text":"……確かに\\nいきはよかったんじゃない","trans":"……确实\\n看起来活蹦乱跳的"},{"id":"3020007020740","name":"雛菜","text":"あは～\\n目に勢いがあった～！","trans":"啊哈～\\n眼神很有劲～！"},{"id":"3020007020750","name":"透","text":"うん","trans":"嗯"},{"id":"3020007020760","name":"透","text":"さびしいことと\\n仲良くなれるしね","trans":"还能\\n和孤独的存在友好相处呢"},{"id":"3020007020770","name":"透","text":"天然物だねー","trans":"是天然的啊——"}]}