{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "user-0",
      "name": "プロデューサー",
      "text": "凛世、おめでとう\r\n『W.I.N.G.』の参加がきまったぞ！",
      "trans": "凛世，恭喜\n“W.I.N.G.”的参加定下来了！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070010",
      "name": "凛世",
      "text": "……本当で、ございますか……？",
      "trans": "……真的、是这样吗……？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-2",
      "name": "プロデューサー",
      "text": "もちろん、本当に決まってるだろ！",
      "trans": "当然，是真的定下来了！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070020",
      "name": "凛世",
      "text": "それは……\r\nとても……うれしいです",
      "trans": "那真是……\n非常……高兴",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-4",
      "name": "プロデューサー",
      "text": "ああ、よくやった\r\n一緒に頑張ってきたもんな！",
      "trans": "嗯，做得好\n我们一起努力过来的嘛！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070030",
      "name": "凛世",
      "text": "はい……",
      "trans": "好的……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070040",
      "name": "凛世",
      "text": "凛世を、応援してくださる、\r\nファンのみなさまと……",
      "trans": "支持凛世的\n各位粉丝……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070050",
      "name": "凛世",
      "text": "プロデューサーさまの、おかげです……",
      "trans": "都是多亏了制作人大人……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-8",
      "name": "プロデューサー",
      "text": "何言っているんだ、凛世",
      "trans": "说什么呢，凛世",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-10",
      "name": "プロデューサー",
      "text": "俺たちが凛世を連れてきたんじゃない",
      "trans": "不是我们把凛世带到这里的",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-11",
      "name": "プロデューサー",
      "text": "凛世が、俺たちをここまで連れてきてくれたんだよ！",
      "trans": "是凛世把我们带到了这里啊！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070070",
      "name": "凛世",
      "text": "プロデューサーさま方を、\r\n凛世が……？",
      "trans": "凛世把制作人大人你们……\n带到这里……？",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070080",
      "name": "凛世",
      "text": "そのようなこと、考えたことも、\r\nございませんでした……",
      "trans": "这种事，凛世从未\n想过……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-14",
      "name": "プロデューサー",
      "text": "はは。凛世らしいな",
      "trans": "哈哈。真像凛世啊",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070090",
      "name": "凛世",
      "text": "ならば、凛世は……\r\n優勝しなければ、なりません",
      "trans": "那么，凛世就……\n必须拿下冠军了",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "7012001070100",
      "name": "凛世",
      "text": "凛世を、応援してくださる、\r\nみなさまのためにも……",
      "trans": "也是为了那些\n支持凛世的各位……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-17",
      "name": "プロデューサー",
      "text": "ああ、その意気だ！\r\n凛世ならきっと、優勝できる！",
      "trans": "嗯，就是这股劲！\n凛世的话一定能夺冠！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-18",
      "name": "プロデューサー",
      "text": "最後まで、一緒に頑張ろうな！",
      "trans": "一起努力到最后吧！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
