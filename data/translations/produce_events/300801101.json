{"translator":"奶油茄子炖兔","rows":[{"id":"3008011010010","name":"霧子","text":"いーち……\\nにーい……","trans":"一——……\\n二——……"},{"id":"3008011010020","name":"霧子","text":"────くしゅんっ……","trans":"────哈啾……"},{"id":"3008011010030","name":"恋鐘","text":"ふ、ふぇ……\\n霧子……！？","trans":"呼、呼诶……\\n雾子……！？"},{"id":"3008011010040","name":"恋鐘","text":"さ～ん～～\\nし～い～～","trans":"三～～\\n四～～"},{"id":"3008011010050","name":"恋鐘","text":"さ、寒かと～～！？\\nこれ羽織らん────","trans":"冻、冻到了吗～～！？\\n来披上这个────"},{"id":"3008011010060","name":"恋鐘","text":"────くしゅっ……！","trans":"────啊啾……！"},{"id":"3008011010070","name":"霧子","text":"こ、恋鐘ちゃん……！","trans":"小、小恋钟……！"},{"id":"3008011010080","name":"霧子","text":"ごーお……","trans":"五——……"},{"id":"3008011010090","name":"霧子","text":"わたし、大丈夫だよ……！\\n恋鐘ちゃんが……さむ────","trans":"我没问题的哦……！\\n小恋钟才是……受凉────"},{"id":"3008011010100","name":"霧子","text":"────くしゅんっ……","trans":"────咕咻……"},{"id":"3008011010110","name":"恋鐘","text":"くしゅっ……！","trans":"哈啾……！"},{"id":"3008011010111","name":"恋鐘＆霧子","text":"ふふっ……","trans":"呵呵……"},{"id":"3008011010120","name":"恋鐘","text":"ろ～く～～","trans":"六～～"},{"id":"3008011010130","name":"霧子","text":"い、急ごうね……！","trans":"我、我们快一点吧……！"},{"id":"3008011010140","name":"恋鐘","text":"うん～～！","trans":"嗯～～！"},{"id":"3008011010150","name":"霧子","text":"しーち……","trans":"七——……"},{"id":"3008011010160","name":"霧子","text":"どんなとこかな……\\n銭湯……","trans":"到底会是怎样的地方呢……\\n澡堂……"},{"id":"3008011010170","name":"恋鐘","text":"は～ち～～","trans":"八～～"},{"id":"3008011010180","name":"恋鐘","text":"んふふ～","trans":"哼哼～"},{"id":"3008011010190","name":"恋鐘","text":"寒か～～からの\\n熱か～～で────","trans":"是能够从冷飕飕\\n变得暖烘烘的────"},{"id":"3008011010191","name":"恋鐘＆霧子","text":"きゅ～う～……","trans":"九～……"},{"id":"3008011010200","name":"恋鐘","text":"ば～り、気持ちよかとこばい～～！","trans":"非常，舒服的地方哦～～！"},{"id":"3008011010210","name":"霧子","text":"……！","trans":"……！"},{"id":"3008011010211","name":"恋鐘＆霧子","text":"じゅう～～～……！","trans":"十～～～……！"},{"id":"3008011010220","name":"恋鐘","text":"はぁ～～\\nよかお湯やね～～～","trans":"哈啊～～\\n真棒的热水呢～～～"},{"id":"3008011010230","name":"霧子","text":"うん……！","trans":"嗯……！"},{"id":"3008011010240","name":"恋鐘","text":"どがん～～？\\nよかとこやろ～？","trans":"怎样～～？\\n这地方不错吧～？"},{"id":"3008011010250","name":"霧子","text":"うん……！","trans":"嗯……！"},{"id":"3008011010260","name":"霧子","text":"寒か～からの……\\n熱か～で……","trans":"从冷飕飕……\\n变得暖烘烘……"},{"id":"3008011010270","name":"霧子","text":"とっても……\\nいいとこ……","trans":"真是非常……棒的地方……"},{"id":"3008011010280","name":"恋鐘","text":"来たことなかって言うけん\\nびっくりしたとよ～","trans":"你说没有来过澡堂的时候\\n我还真是吓了一大跳呢～"},{"id":"3008011010290","name":"霧子","text":"小さい頃は……あるんだけど……\\nあんまり……覚えてなくて……","trans":"虽然小的时候是有去过……\\n不过现在……几乎没什么印象了……"},{"id":"3008011010300","name":"恋鐘","text":"そいやったら、い～っぱい銭湯のこと\\n知ってから帰らんばね～～","trans":"这样的话，\\n就得好～好的了解一下澡堂的美好之处再回去才行了呢～～"},{"id":"3008011010310","name":"霧子","text":"うん……！　じゃあ……\\nもうちょっと……浸かるね……","trans":"嗯……！　那么……\\n我就再泡上一会儿吧……"},{"id":"3008011010320","name":"恋鐘","text":"よかよ～！\\nあと10～～！","trans":"好嘞～！\\n再数一次10秒～～！"},{"id":"3008011010330","name":"霧子","text":"ふふっ……うん……\\nあと10……","trans":"呼呼……嗯……\\n再数一次……"},{"id":"3008011010340","name":"恋鐘","text":"そいじゃあ\\n11からいくばい～～！","trans":"那么\\n就从11开始数起吧～～！"},{"id":"3008011010350","name":"霧子","text":"う、うん────…………","trans":"嗯、嗯────…………"},{"id":"3008011010360","name":"霧子","text":"じゅういち……\\nじゅうに……────","trans":"十一……\\n十二……────"},{"id":"0000000000000","name":"霧子の母","text":"わぁ……\\nきりちゃん、かぞえるのじょうず","trans":"哇……\\n雾子，数的可真不错呢"},{"id":"0000000000000","name":"霧子の母","text":"あったまったねー！","trans":"这下就变暖和了吧！"},{"id":"3008011010370","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008011010371","name":"恋鐘＆霧子","text":"じゅうさん……\\nじゅうし……","trans":"十三……\\n十四……"},{"id":"0000000000000","name":"霧子の母","text":"ちゃんと10\\nかぞえられたねー","trans":"要好好的数到10哦——"},{"id":"3008011010380","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008011010381","name":"恋鐘＆霧子","text":"じゅうご……\\nじゅうろく……","trans":"十五……\\n十六……"},{"id":"0000000000000","name":"霧子の母","text":"もうおっきいんだもんねー","trans":"你已经长大了呢——"},{"id":"3008011010390","name":"霧子","text":"うん……","trans":"嗯……"},{"id":"3008011010391","name":"恋鐘＆霧子","text":"じゅうしち……\\nじゅうはち……","trans":"十七……\\n十八……"},{"id":"0000000000000","name":"霧子の母","text":"それじゃあ\\n10のつぎ、しりたい？","trans":"那么\\n想学学10以后的数字吗？"},{"id":"3008011010400","name":"霧子","text":"…………！","trans":"…………！"},{"id":"3008011010410","name":"霧子","text":"じゅうく……","trans":"十九……"},{"id":"3008011010420","name":"霧子","text":"10の……\\nつぎ……？","trans":"10……\\n以后……？"},{"id":"3008011010430","name":"霧子","text":"わ……\\n美味しい……","trans":"哇……\\n好好喝……"},{"id":"3008011010440","name":"恋鐘","text":"いちご牛乳もうまかよ～\\nひとくち～～！","trans":"草莓牛奶也很好喝哦～\\n来尝一口吧～～！"},{"id":"3008011010450","name":"霧子","text":"いいの……？","trans":"可以吗……？"},{"id":"3008011010460","name":"霧子","text":"じゃ……\\nコーヒー牛乳も……","trans":"那么……\\n我的咖啡牛奶也……"},{"id":"3008011010470","name":"恋鐘","text":"んふふ～","trans":"嘿嘿～"},{"id":"3008011010480","name":"恋鐘","text":"口の中、\\nいちごコーヒーになったば～い！","trans":"嘴里面\\n变成草莓咖啡味了呢～！"},{"id":"3008011010490","name":"霧子","text":"もしもし……？\\nふふ……そう……","trans":"喂喂……？\\n呵呵……没错……"},{"id":"3008011010500","name":"霧子","text":"11があるって……\\n知らなかったの……","trans":"我原来都不知道……\\n10的后面还有11……"},{"id":"3008011010510","name":"霧子","text":"特別な……\\nいちご牛乳なのかな……","trans":"难道是因为……\\n特别的草莓牛奶的缘故吗……"},{"id":"3008011010520","name":"恋鐘","text":"ん～？","trans":"嗯～？"},{"id":"3008011010530","name":"霧子","text":"なんだか……\\nとっても……美味しい……","trans":"总觉得……\\n非常的……美味呢……"},{"id":"3008011010540","name":"恋鐘","text":"んふふ────","trans":"呵呵────"},{"id":"3008011010550","name":"霧子","text":"でも……","trans":"但是……"},{"id":"3008011010560","name":"霧子","text":"11があるって……\\n知ったら……","trans":"一旦知道了……\\n还有11的话……"},{"id":"3008011010570","name":"恋鐘","text":"そいは～～～","trans":"那也就是说～～～"},{"id":"3008011010580","name":"霧子","text":"そこからは……","trans":"在那之后……"},{"id":"3008011010590","name":"恋鐘","text":"そいは銭湯のこと\\nわかったってことばい～～！","trans":"那也就说明了\\n你已经理解了澡堂的美妙之处哦～～！"},{"id":"3008011010600","name":"霧子","text":"わぁって……\\n光が……広がって……","trans":"哗的一下……\\n光芒一下子就……扩散开来……"},{"id":"3008011010610","name":"霧子","text":"100もあって……\\n1000も……あるんだって……","trans":"在那以后还有100……\\n甚至……还会有1000……"},{"id":"3008011010620","name":"霧子","text":"────\\nふふっ……そうなんだね……","trans":"────\\n呵呵……确实是呢……"},{"id":"3008011010630","name":"霧子","text":"美味しい……","trans":"真好喝……"},{"id":"0000000000000","name":"霧子の母","text":"『わぁ、そのお話なつかしいな\\nよかったね、銭湯』","trans":"『哎呀，这话题还真是令人怀念\\n很不错呢，澡堂』"},{"id":"3008011010640","name":"霧子","text":"うん……！","trans":"嗯……！"},{"id":"0000000000000","name":"霧子の母","text":"『それじゃあ\\n霧子の11は、恋鐘ちゃんたちなのね』","trans":"『也就是说\\n雾子的11，就是恋钟她们呢』"},{"id":"3008011010650","name":"霧子","text":"……！\\nうん……！","trans":"……！\\n嗯……！"},{"id":"0000000000000","name":"霧子の母","text":"『ふふ、そろそろおやすみなさい\\n霧子も早く寝てね』","trans":"『呼呼，差不多也该睡了\\n雾子你也要早点睡哦』"},{"id":"3008011010660","name":"霧子","text":"うん……\\nママもお仕事……頑張ってね……","trans":"嗯……\\n妈妈你工作也要加油哦……"},{"id":"3008011010670","name":"霧子","text":"ふふふ……\\n11……────","trans":"呼呼呼……\\n11……────"}]}