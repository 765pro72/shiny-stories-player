{
  "translator": "楚西瑜",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "来年も──",
      "trans": "来年也——"
    },
    {
      "id": "2012010110010",
      "name": "凛世",
      "text": "『来年も』……",
      "trans": "“来年也”……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世をよろしく──",
      "trans": "来年也——"
    },
    {
      "id": "2012010110020",
      "name": "凛世",
      "text": "『凛世を』……\\n『よろしく』……",
      "trans": "“麻烦您”……\\n“多多关照凛世”……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "お願いします！　と",
      "trans": "来年也——"
    },
    {
      "id": "2012010110030",
      "name": "凛世",
      "text": "『お願いいたします』──",
      "trans": "“拜托了”——"
    },
    {
      "id": "2012010110040",
      "name": "凛世",
      "text": "ふふっ……",
      "trans": "哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──あのメイクさんさ、\\nフリーだったよな",
      "trans": "来年也——"
    },
    {
      "id": "2012010110050",
      "name": "凛世",
      "text": "はい……\\nいかが……なさいましたか……",
      "trans": "嗯……\\n您感觉……怎么样……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いや、個人宛のやつは、年賀状に一筆入れたいんだけどさ\\nうーん……",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "一文だけ入れるの、難しいんだよなぁ……！",
      "trans": "来年也——"
    },
    {
      "id": "2012010110060",
      "name": "凛世",
      "text": "年賀状を……",
      "trans": "年贺状……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『あけましておめでとうございます』\\nってことが印刷してあるから、",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『あけましておめでとうございます！』ってのもなんだし",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『今年もよろしくお願いします！』っていうのも、\\nもう書いてあるだろ……？",
      "trans": "来年也——"
    },
    {
      "id": "2012010110070",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012010110080",
      "name": "凛世",
      "text": "ふふ……\\n凛世は……──",
      "trans": "哼哼……\\n凛世我……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おっ、凛世は？",
      "trans": "来年也——"
    },
    {
      "id": "2012010110090",
      "name": "凛世",
      "text": "すべて……\\n手書きにて……したためますゆえ……",
      "trans": "全部……\\n亲手……写上去……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ああっ、そうかぁ\\nうーん……！",
      "trans": "来年也——"
    },
    {
      "id": "2012010110100",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "2012010110110",
      "name": "凛世",
      "text": "特別に……\\nお伝えしたいことなどは……？",
      "trans": "有什么……\\n想要传达的吗……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "えーと……\\n『来年も凛世をよろしくお願いします』",
      "trans": "来年也——"
    },
    {
      "id": "2012010110120",
      "name": "凛世",
      "text": "……",
      "trans": "……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あと──",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『いつも凛世の魅力を\\n引き出してくださってありがとうございます』",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──でも、どっちも\\n言ってることは定型文と同じなんだよなぁ",
      "trans": "来年也——"
    },
    {
      "id": "2012010110130",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あっ、そうだ\\n『俺も化粧品のこと、勉強します！』かな！",
      "trans": "来年也——"
    },
    {
      "id": "2012010110140",
      "name": "凛世",
      "text": "…………！",
      "trans": "…………！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "さすがに、メイクはできないけどな\\nこの間……ちょっといつもと違う感じだっただろ？",
      "trans": "来年也——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ちゃんとさ\\nそういうこと、わかるようになるから",
      "trans": "来年也——"
    },
    {
      "id": "2012010110150",
      "name": "凛世",
      "text": "──プロデューサーさま……",
      "trans": "——制作人大人……"
    },
    {
      "id": "2012010110160",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012010110170",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    },
    {
      "id": "2012010110180",
      "name": "凛世",
      "text": "大変……\\nお世話になっております……",
      "trans": "非常感谢……\\n您的关照……"
    },
    {
      "id": "2012010110190",
      "name": "凛世",
      "text": "来年も……凛世を……\\nよろしくお願いいたします……",
      "trans": "来年也……请您……\\n多多关照凛世……"
    },
    {
      "id": "2012010110200",
      "name": "凛世",
      "text": "……っ……\\nはーっ……",
      "trans": "……呵……\\n哈——……"
    },
    {
      "id": "2012010110210",
      "name": "凛世",
      "text": "──『手紙・はがき』……",
      "trans": "——“信箱”……"
    },
    {
      "id": "2012010110220",
      "name": "凛世",
      "text": "……\\nふふ……",
      "trans": "……\\n哼哼……"
    },
    {
      "id": "2012010110230",
      "name": "凛世",
      "text": "定型文のように……\\nなってしまいました……",
      "trans": "结果还是……\\n写成定型文了呢……"
    },
    {
      "id": "2012010110240",
      "name": "凛世",
      "text": "けれど……",
      "trans": "但是……"
    },
    {
      "id": "2012010110250",
      "name": "凛世",
      "text": "足すものも……\\n引くものもなく……",
      "trans": "即不增……\\n也不减……"
    },
    {
      "id": "2012010110260",
      "name": "凛世",
      "text": "心のまま……",
      "trans": "心中所想……"
    },
    {
      "id": "2012010110270",
      "name": "凛世",
      "text": "プロデューサーさま……",
      "trans": "制作人大人……"
    }
  ]
}