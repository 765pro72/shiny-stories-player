{
  "translator": "Latiaous",
  "rows": [
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ほら、お茶",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110010",
      "name": "凛世",
      "text": "──……プロデューサーさま……！",
      "trans": "——……制作人大人……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "驚かせたか？　すまん──",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110020",
      "name": "凛世",
      "text": "──い、いえ……\\nそのようなこと……凛世が……",
      "trans": "——不，不是……\\n这种事的话……就由凛世来……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ、いや、ダメだ\\n勉強中だろ？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110030",
      "name": "凛世",
      "text": "……はい",
      "trans": "……是的"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はは、すごく集中してたからさ\\n……テストだっけ",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110040",
      "name": "凛世",
      "text": "はい……\\nすぐに……模擬試験が……",
      "trans": "嗯……\\n马上……就到模拟考了"
    },
    {
      "id": "2012007110050",
      "name": "凛世",
      "text": "ですが……",
      "trans": "但是……"
    },
    {
      "id": "2012007110060",
      "name": "凛世",
      "text": "今は……\\nただ……ぼんやりしていたのです……",
      "trans": "刚才……\\n就只是……在发呆而已……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうなのか？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110070",
      "name": "凛世",
      "text": "はい……\\n不思議な言葉を……見つけましたゆえ……",
      "trans": "嗯……\\n因为看到了……不可思议的词……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……うわぁ、古語辞典か\\n俺、つらい模試を思い出すよ……",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110080",
      "name": "凛世",
      "text": "ふふ……",
      "trans": "呵呵……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "どれ──？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110090",
      "name": "凛世",
      "text": "はい……\\n『蜂吹く』……──",
      "trans": "嗯……\\n“蜂吹く”……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "え、ハチブク……？\\nどういう意味なんだ",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110100",
      "name": "凛世",
      "text": "口をとがらせ……\\n不満げな顔をすること……と……",
      "trans": "像这样噘嘴……\\n摆出一副不满的样子……这样……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ああ……蜂の羽音みたいにってことなのかな……\\n──こんな感じか？",
      "trans": "茶，放在这了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ブー……",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110110",
      "name": "凛世",
      "text": "…………ふふっ\\nふふふ……",
      "trans": "…………哼哼\\n哼哼哼……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "ええっ、こういうことじゃないか？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110120",
      "name": "凛世",
      "text": "…………いえ……",
      "trans": "…………不是……"
    },
    {
      "id": "2012007110130",
      "name": "凛世",
      "text": "『ふくれっ面』とも……書いてありますゆえ……\\nこのような具合でしょう……──",
      "trans": "这里有写……和“鼓脸颊”相近的话……\\n大概是这样的吧……——"
    },
    {
      "id": "2012007110140",
      "name": "凛世",
      "text": "ぶぅ……",
      "trans": "卟呜……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "あははっ、凛世\\n確かにな！",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110150",
      "name": "凛世",
      "text": "ふふふ……",
      "trans": "呵呵……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……ああ、でも懐かしいな\\n俺は電子辞書だったけど、凛世は紙なんだな",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110160",
      "name": "凛世",
      "text": "はい……\\nぱらぱらと……めくっておりますと……",
      "trans": "嗯……\\n像这样……随意地翻着……"
    },
    {
      "id": "2012007110170",
      "name": "凛世",
      "text": "思わぬ言葉が……",
      "trans": "就会跳出意料之外的词语……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "へぇ……\\n俺にも見せてくれるか？　──と",
      "trans": "茶，放在这了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──なんか、マルがつけてある",
      "trans": "茶，放在这了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……『うらごい』……？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110180",
      "name": "凛世",
      "text": "……それは……！\\nあの……──",
      "trans": "……那个是……！\\n那个……——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "『心恋』？　これでうらごいって読むのか\\n……ええと、慕っている人を思──",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110190",
      "name": "凛世",
      "text": "慕っている人を……心の中に想うこと……\\nでございます……",
      "trans": "是指……在心中想着……自己思慕之人的意思……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……凛世……？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110200",
      "name": "凛世",
      "text": "いえ……\\n…………漫画で……見かけましたので……",
      "trans": "没什么……\\n…………是之前在漫画里……有见过……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……そうか。へぇ……",
      "trans": "茶，放在这了"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──……「心」って、「うら」って読むんだな",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110210",
      "name": "凛世",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "2012007110220",
      "name": "凛世",
      "text": "……きっと\\n見通せぬもの……だからでしょう……",
      "trans": "……一定\\n是因为无法轻易看透……的关系吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "見通せぬもの……それで、裏か",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110230",
      "name": "凛世",
      "text": "……プロデューサーさまには……",
      "trans": "……制作人大人的话……"
    },
    {
      "id": "2012007110240",
      "name": "凛世",
      "text": "隠しておられるものが……\\nございますか……？",
      "trans": "有什么……\\n隐瞒着的事吗……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "俺か？　うーん……\\n……あんまり隠してるつもりもないけど……",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110250",
      "name": "凛世",
      "text": "…………",
      "trans": "…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……凛世はどうなんだ？\\nあるのか、隠してるもの",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110260",
      "name": "凛世",
      "text": "……\\n凛世は…………",
      "trans": "……\\n凛世的话…………"
    },
    {
      "id": "2012007110270",
      "name": "凛世",
      "text": "……\\n……見えないでしょうか？",
      "trans": "……\\n您看不出来吗？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……え？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110280",
      "name": "凛世",
      "text": "…………いえ──",
      "trans": "…………没什么——"
    },
    {
      "id": "2012007110290",
      "name": "凛世",
      "text": "…………\\n──ぶぅ……",
      "trans": "…………\\n——卟呜……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……！\\n…………蜂吹いた",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110300",
      "name": "凛世",
      "text": "……ふふっ…………",
      "trans": "……呵呵…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "や、すまん……\\nなんか……変なこと聞いちゃったかな……？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110310",
      "name": "凛世",
      "text": "いえ……",
      "trans": "不是……"
    },
    {
      "id": "2012007110320",
      "name": "凛世",
      "text": "ですが……\\n隠さなくても……見えぬもののようです……",
      "trans": "但是……\\n看来有些事物……就算不加隐藏……也会看不见呢……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "……凛世？",
      "trans": "茶，放在这了"
    },
    {
      "id": "2012007110330",
      "name": "凛世",
      "text": "心とは……",
      "trans": "比如说心意……"
    }
  ]
}