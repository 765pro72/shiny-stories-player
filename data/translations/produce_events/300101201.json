{"translator":"告","rows":[{"id":"3001012010001","name":"真乃＆めぐる","text":"……っ……はっ……\\n……はっ……","trans":"…………哈……\\n……哈……"},{"id":"3001012010010","name":"真乃","text":"……っ……\\nはっ……────","trans":"…………\\n哈……————"},{"id":"3001012010020","name":"めぐる","text":"……はっ……\\nはっ……","trans":"……哈……\\n哈……"},{"id":"3001012010021","name":"真乃＆めぐる","text":"────\\nはぁ…………っ","trans":"————\\n哈…………"},{"id":"3001012010030","name":"真乃","text":"……っ\\n────ふふっ……","trans":"……\\n————呵呵……"},{"id":"3001012010040","name":"真乃","text":"夕焼け…………","trans":"夕阳…………"},{"id":"3001012010050","name":"めぐる","text":"うんっ","trans":"嗯"},{"id":"3001012010060","name":"めぐる","text":"夕焼け……！","trans":"夕阳……！"},{"id":"3001012010070","name":"真乃","text":"──\\nそれじゃあ……","trans":"——\\n那就……"},{"id":"3001012010080","name":"真乃","text":"暗くなっちゃう前に……\\nもう一周……っ","trans":"趁天黑之前……\\n再一圈……"},{"id":"3001012010090","name":"めぐる","text":"オッケー！","trans":"OK——！"},{"id":"3001012010100","name":"真乃","text":"あ……っ","trans":"啊……"},{"id":"3001012010110","name":"めぐる","text":"──真乃っ\\n大丈夫……？","trans":"——真乃\\n没事吧……？"},{"id":"3001012010120","name":"真乃","text":"う、うん……っ","trans":"嗯、嗯……"},{"id":"3001012010130","name":"真乃","text":"空き缶、\\n蹴っちゃったみたい……","trans":"我好像，\\n踢到空罐了……"},{"id":"3001012010140","name":"めぐる","text":"ケガしてない……！？","trans":"有没受伤……！？"},{"id":"3001012010150","name":"真乃","text":"大丈夫\\n──でも、缶が……","trans":"没事\\n——不过，空罐……"},{"id":"3001012010160","name":"めぐる","text":"あーっ\\n草むらに入っちゃったんだね","trans":"啊——\\n掉到草丛里了啊"},{"id":"3001012010170","name":"めぐる","text":"──おーい\\n缶、出てこーい！","trans":"——喂——\\n空罐，快出来——！"},{"id":"3001012010180","name":"真乃","text":"たぶん……こっちの方なんだけど……","trans":"大概……往这方向飞了……"},{"id":"3001012010190","name":"めぐる","text":"おーい……っ\\n────あ","trans":"喂——……\\n————啊"},{"id":"3001012010200","name":"めぐる","text":"あった！\\n見つけたぞー、サイダーくん！","trans":"有了！\\n找到你了，苏打水！"},{"id":"3001012010210","name":"真乃","text":"ふふっ\\nサイダーだったんだね","trans":"呵呵\\n原来是苏打水"},{"id":"3001012010220","name":"めぐる","text":"ごみ箱……は、\\nないかー","trans":"垃圾箱……\\n没有吗——"},{"id":"3001012010230","name":"真乃","text":"うん……","trans":"嗯……"},{"id":"3001012010240","name":"真乃","text":"持って帰ろうかな……","trans":"带回去吧……"},{"id":"3001012010250","name":"真乃","text":"──サイダーくんと、ランニング……っ","trans":"——和苏打水一起，慢跑……！"},{"id":"3001012010260","name":"めぐる","text":"いいねいいね！\\n楽しそう！","trans":"好耶好耶！\\n好像很好玩！"},{"id":"3001012010270","name":"めぐる","text":"じゃあ\\n持つの、途中で交代！","trans":"那\\n中途换着拿！"},{"id":"3001012010280","name":"めぐる","text":"行こう\\n真乃、サイダーくんっ","trans":"走吧\\n真乃，苏打水"},{"id":"3001012010290","name":"真乃","text":"うんっ","trans":"嗯"},{"id":"3001012010300","name":"真乃","text":"……っ……\\nはっ……はっ……","trans":"…………\\n哈……哈……"},{"id":"3001012010310","name":"真乃","text":"────っ","trans":"————"},{"id":"3001012010320","name":"真乃","text":"……\\nまた……缶……","trans":"……\\n又是……空罐……"},{"id":"3001012010330","name":"真乃","text":"────よい、しょ……","trans":"————嘿、咻……"},{"id":"3001012010340","name":"真乃","text":"……っ……はっ……\\nはっ……","trans":"…………哈……\\n哈……"},{"id":"3001012010350","name":"真乃","text":"────あ……","trans":"————啊……"},{"id":"3001012010360","name":"真乃","text":"また……缶……","trans":"又有……空罐……"},{"id":"3001012010370","name":"真乃","text":"……っ\\nこっちにも────","trans":"……\\n这边也有————"},{"id":"3001012010380","name":"真乃","text":"…………\\n手……ふさがっちゃった……","trans":"…………\\n手里……都拿满了……"},{"id":"3001012010390","name":"真乃","text":"ごめんね……\\nりんごジュースさん……っ","trans":"对不起……\\n苹果汁……"},{"id":"3001012010400","name":"真乃","text":"後で来るね……っ","trans":"我之后再来……"},{"id":"3001012010410","name":"真乃","text":"……っ\\nはっ……はっ……","trans":"……\\n哈……哈……"},{"id":"3001012010420","name":"めぐる","text":"──あっ","trans":"——啊"},{"id":"3001012010430","name":"めぐる","text":"あれっ……真乃……！？","trans":"诶……真乃……！？"},{"id":"3001012010440","name":"めぐる","text":"真乃ー！","trans":"真乃——！"},{"id":"3001012010450","name":"真乃","text":"────っ\\nめぐるちゃん……？","trans":"————\\n小巡……？"},{"id":"3001012010460","name":"めぐる","text":"どうしたの？\\n両手にいっぱい……空き缶……？","trans":"怎么了？\\n拿这么多……空罐……？"},{"id":"3001012010470","name":"真乃","text":"……っ\\nえっとね……その……────","trans":"……\\n这是……哪个……————"},{"id":"3001012010480","name":"めぐる","text":"────ふふふっ\\nびっくりしちゃった","trans":"——————呵呵呵\\n吓我一跳"},{"id":"3001012010490","name":"めぐる","text":"真乃、ごみを持って走ってるんだもん！","trans":"毕竟真乃抱着垃圾在慢跑嘛！"},{"id":"3001012010500","name":"真乃","text":"う、うん……っ","trans":"嗯、嗯……"},{"id":"3001012010510","name":"真乃","text":"ひとつ見つけたら、\\nいっぱい、目に入っちゃうようになって……","trans":"见到一个，\\n眼睛就一直在找空罐了……"},{"id":"3001012010520","name":"めぐる","text":"この間の、サイダーくんのこと？","trans":"因为之前那罐苏打水？"},{"id":"3001012010530","name":"真乃","text":"うん……","trans":"嗯……"},{"id":"3001012010540","name":"真乃","text":"あの後も\\n走ってると、落ちてるなって……","trans":"之后\\n一边跑，一边也会看到掉地上的空罐……"},{"id":"3001012010550","name":"真乃","text":"でも、２つしか持てないから\\n袋を持っていくことにしたの……っ","trans":"可是，我只能拿两个\\n所以就拿着袋子去了……"},{"id":"3001012010560","name":"めぐる","text":"ふふっ……ふふふっ……","trans":"呵呵……呵呵呵……"},{"id":"3001012010570","name":"真乃","text":"……？","trans":""},{"id":"3001012010580","name":"めぐる","text":"──もう！\\nこんな楽しいことがあるなら、わたしにも教えてー！","trans":"——真是！\\n有这么好玩的事，就告诉我啊——！"},{"id":"3001012010590","name":"真乃","text":"……\\nめぐるちゃん","trans":"……\\n小巡"},{"id":"3001012010600","name":"めぐる","text":"はい、袋ひとつ\\n貸してー！","trans":"来，袋子\\n借我一个——！"},{"id":"3001012010610","name":"真乃","text":"──あっ……","trans":"——啊……"},{"id":"3001012010620","name":"めぐる","text":"いーっぱい、拾っちゃおうー！","trans":"去捡一～堆空罐吧！"},{"id":"3001012010630","name":"真乃","text":"い、いいの……っ\\n私が、勝手にやってることだから────","trans":"没、没关系的……\\n只是我自己想做这个————"},{"id":"3001012010640","name":"めぐる","text":"うん\\nだから、わたしも勝手にやるの！","trans":"嗯\\n所以我也是自己想做！"},{"id":"3001012010650","name":"めぐる","text":"真乃の隣で！","trans":"在真乃旁边！"},{"id":"3001012010660","name":"真乃","text":"────っ\\nめぐるちゃん……","trans":"————\\n小巡……"},{"id":"3001012010670","name":"真乃","text":"そしたら、えっと────","trans":"然后呢，我想想————"},{"id":"3001012010680","name":"真乃","text":"一緒に、持てるだけ……","trans":"一起，能捡多少……"},{"id":"3001012010690","name":"真乃","text":"一緒に持てる分だけ、拾おう……っ","trans":"一起能捡多少，就捡多少吧……"},{"id":"3001012010700","name":"真乃","text":"──その、隣どうしで","trans":"——就，在身边一起捡"},{"id":"3001012010710","name":"めぐる","text":"──うんっ","trans":"——嗯"},{"id":"3001012010720","name":"めぐる","text":"あっ、灯織もずるいって言うかなぁ？",