      "text": "どぅ　　どぅ\\n──",
      "trans": "doux   doux\\n——"
    },
    {
      "id": "2012009020020",
      "name": "凛世",
      "text": "心臓が……\\n鳴っていた……",
      "trans": "心脏……\\n在动鸣……"
    },
    {
      "id": "2012009020030",
      "name": "凛世",
      "text": "どぅ",
      "trans": "doux"
    },
    {
      "id": "2012009020040",
      "name": "凛世",
      "text": "どぅ",
      "trans": "doux"
    },
    {
      "id": "2012009020050",
      "name": "凛世",
      "text": "──\\nら　　むぅ　　れ",
      "trans": "——\\nL'a   mour    est"
    },
    {
      "id": "2012009020060",
      "name": "凛世",
      "text": "どぅ────",
      "trans": "doux————"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "凛世……！",
      "trans": "凛世……！"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "店主さん、聴かせてくれるってさ！",
      "trans": "店主说可以放给我们听呢！"
    },
    {
      "id": "2012009020070",
      "name": "凛世",
      "text": "……プロデューサーさま……？",
      "trans": "……制作人大人……？"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "レコード！\\n──聴いてみたかったんだよな？",
      "trans": "黑胶唱片！\n──你之前一直很想听听看对吧？"
    },
    {
      "id": "2012009020080",
      "name": "凛世",
      "text": "それは……\\n……素敵でございます……！",
      "trans": "那真是……\\n……太好了……！"
    },
    {
      "id": "2012009020090",
      "name": "凛世",
      "text": "つややかで……\\n黒い……",
      "trans": "光艳……\\n而又黯淡……"
    },
    {
      "id": "2012009020100",
      "name": "凛世",
      "text": "音の出る……\\n盤……",
      "trans": "轻响着的……\\n碟……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──ほら、すごいな\\n見てくれ、機材も立派だ……",
      "trans": "──你看，好厉害啊\n快看，播放设备也好气派……"
    },
    {
      "id": "2012009020110",
      "name": "凛世",
      "text": "貴方さまは……\\n嬉しそうに……",
      "trans": "您好像……\\n很高兴……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "な、まずスイッチ入れて……\\nターンテーブルが回り始めるだろ……──",
      "trans": "你看，先把开关打开……\n转盘就会开始转动了对吧……──"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そしたら、レコードの一番外側の溝に……\\n──ほら、ここ。針を置いてみてくれ",
      "trans": "然后，在黑胶唱片最外侧的纹路上……\n──来，这里。试着把唱针放上去看看"
    },
    {
      "id": "2012009020120",
      "name": "凛世",
      "text": "まわる……まわる……",
      "trans": "转着……转着……"
    },
    {
      "id": "2012009020130",
      "name": "凛世",
      "text": "……\\nこの……",
      "trans": "……\\n这个……"
    },
    {
      "id": "2012009020140",
      "name": "凛世",
      "text": "回っている……こちらに……\\nでしょうか……？",
      "trans": "正旋转的……这里……\\n是吗……？"
    },
    {
      "id": "2012009020150",
      "name": "凛世",
      "text": "まわる……\\nレコード……",
      "trans": "旋转着的……\\n唱片……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そう！　──あぁでも\\n回ってる上に置くの、ちょっと難しいよな……",
      "trans": "对！──啊，不过\n要放在转动中的唱片上，稍微有点难度呢……"
    },
    {
      "id": "2012009020160",
      "name": "凛世",
      "text": "はい……\\n──いえ……お貸しくださいませ……",
      "trans": "嗯……\\n——不……请让我试试……"
    },
    {
      "id": "2012009020170",
      "name": "凛世",
      "text": "貴方さまが……\\nお喜びに……なるならば……",
      "trans": "只要能……\\n让您……高兴的话……"
    },
    {
      "id": "2012009020180",
      "name": "凛世",
      "text": "……\\n上手く……いきましょうか……",
      "trans": "……\\n能顺利……放出来吗……"
    },
    {
      "id": "2012009020190",
      "name": "凛世",
      "text": "まわる……まわれ……",
      "trans": "转着……转吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "いくよ、きっと！　置くだけだ",
      "trans": "肯定行的！只要放上去就好"
    },
    {
      "id": "2012009020200",
      "name": "凛世",
      "text": "まわれ……",
      "trans": "转吧……"
    },
    {
      "id": "2012009020210",
      "name": "凛世",
      "text": "────……\\n……えい",
      "trans": "————……\\n……诶"
    },
    {
      "id": "2012009020220",
      "name": "凛世",
      "text": "鳴れ…………",
      "trans": "唱吧…………"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "おおっ、鳴った！",
      "trans": "噢噢，响起来了！"
    },
    {
      "id": "2012009020230",
      "name": "凛世",
      "text": "──\\nどぅ……どぅ……",
      "trans": "——\\ndoux……doux……"
    },
    {
      "id": "2012009020240",
      "name": "凛世",
      "text": "はい……！",
      "trans": "是的……！"
    },
    {
      "id": "2012009020250",
      "name": "凛世",
      "text": "らむぅれ……どぅ……\\n──",
      "trans": "L'amour est……doux……\\n——"
    },
    {
      "id": "2012009020260",
      "name": "凛世",
      "text": "鳴りました……",
      "trans": "有声音了呢……"
    },
    {
      "id": "2012009020270",
      "name": "凛世",
      "text": "針が……\\n溝を走り……",
      "trans": "唱针……\\n在沟痕里漫步……"
    },
    {
      "id": "2012009020280",
      "name": "凛世",
      "text": "音が鳴る……",
      "trans": "鸣唱着音乐……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なんか……\\nものすごくいい音みたいな気がするな！",
      "trans": "感觉……\n音质真的好得不可思议啊！"
    },
    {
      "id": "2012009020290",
      "name": "凛世",
      "text": "貴方さまが……\\n笑い……",
      "trans": "只要您……\\n展露笑容……"
    },
    {
      "id": "2012009020300",
      "name": "凛世",
      "text": "心臓が鳴る……",
      "trans": "我心便会开始动鸣……"
    },
    {
      "id": "2012009020310",
      "name": "凛世",
      "text": "ふふっ……\\nはい……",
      "trans": "哼哼……\\n嗯……"
    },
    {
      "id": "2012009020320",
      "name": "凛世",
      "text": "どぅ　　どぅ\\n──",
      "trans": "doux   doux\\n——"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "──なんて歌ってるんだろうなぁ",
      "trans": "──这究竟是在唱些什么呢"
    },
    {
      "id": "2012009020330",
      "name": "凛世",
      "text": "──\\nら　　むぅ　　れ",
      "trans": "——\\nL'a   mour    est"
    },
    {
      "id": "2012009020340",
      "name": "凛世",
      "text": "どぅ",
      "trans": "doux"
    },
    {
      "id": "2012009020350",
      "name": "凛世",
      "text": "──はい……\\nジャケットには──",
      "trans": "——嗯……\\n包装上写的是——"
    },
    {
      "id": "2012009020360",
      "name": "凛世",
      "text": "『────』と……",
      "trans": "“————”……"
    },
    {
      "id": "2012009020370",
      "name": "凛世",
      "text": "意味は……\\n知らない……",
      "trans": "我也……\\n看不懂……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "お、名前は聞いたことあるよ\\nシャンソン……とかかな",
      "trans": "哦，名字我倒是有听说过\n是叫香颂（Chanson）……什么的吧"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "はははっ。浅学で、すまん",
      "trans": "哈哈哈。是我学识浅薄了，抱歉抱歉"
    },
    {
      "id": "2012009020380",
      "name": "凛世",
      "text": "ふふふ……\\n浅学にて……申し訳ございません……",
      "trans": "哼哼哼……\\n我也要……为我的无知而道歉……"
    },
    {
      "id": "2012009020390",
      "name": "凛世",
      "text": "────\\n聴いていれば……わかるような気がして……",
      "trans": "————\\n但是只要听了……就能明白……"
    },
    {
      "id": "2012009020400",
      "name": "凛世",
      "text": "まわれ……まわれ……",
      "trans": "转吧……转吧……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "そうか？　それじゃ……\\nわかるまで聴こうか",
      "trans": "是吗？既然这样的话……\n我们就听到彻底听懂为止吧"
    },
    {
      "id": "2012009020410",
      "name": "凛世",
      "text": "……！\\nプロデューサーさま……",
      "trans": "……！\\n制作人大人……"
    },
    {
      "id": "0000000000000",
      "name": "プロデューサー",
      "text": "なっ",
      "trans": "对吧"
    },
    {
      "id": "2012009020420",
      "name": "凛世",
      "text": "凛世の……心に……\\n何度でも……──",
      "trans": "凛世的……内心……\\n不论几次……——"
    },
    {
      "id": "2012009020430",
      "name": "凛世",
      "text": "はい……",
      "trans": "嗯……"
    },
    {
      "id": "2012009020440",
      "name": "凛世",
      "text": "────\\nどぅ、どぅ……",
      "trans": "————\\ndoux，doux……"
    },
    {
      "id": "2012009020450",
      "name": "凛世",
      "text": "らむぅれ……\\nどぅ……──",
      "trans": "L'amour est……\\ndoux……——"
    }
  ]
}