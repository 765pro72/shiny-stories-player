{"translator":"告","rows":[{"id":"0000000000000","name":"プロデューサー","text":"ルカ、そろそろだ","trans":"路加，差不多了"},{"id":"2026004040010","name":"ルカ","text":"────────────────……","trans":"────────────────……"},{"id":"0000000000000","name":"プロデューサー","text":"……大丈夫そうか？","trans":"……没事吧？"},{"id":"0000000000000","name":"観客１","text":"ルカー！","trans":"路加——！"},{"id":"0000000000000","name":"観客２","text":"ルカちゃーん！","trans":"路加——！"},{"id":"2026004040020","name":"ルカ","text":"……ありがとう────────","trans":"……谢谢你们——————"},{"id":"2026004040030","name":"ルカ","text":"大好き──────","trans":"最喜欢你们了——————"},{"id":"2026004040040","name":"ルカ","text":"この傷\\n消えればいいって……思うけど……","trans":"这个伤痕\\n本以为……消失了就好……"},{"id":"2026004040050","name":"ルカ","text":"ずっとつきまとってきて離れねェから……\\nごめん…………","trans":"因为总是缠着自己没法脱身……\\n对不起…………"},{"id":"2026004040060","name":"ルカ","text":"今日は\\n付き合って────────","trans":"今天\\n谢谢你们陪——————"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"2026004040070","name":"ルカ","text":"──────続ける","trans":"——————继续"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ…………","trans":"路加…………"},{"id":"0000000000000","name":"プロデューサー","text":"────？","trans":"————？"},{"id":"0000000000000","name":"プロデューサー","text":"あの、すみません\\n機材ですかね、かなりノイズが────……","trans":"不好意思\\n器材好像杂音相当严重————……"},{"id":"0000000000000","name":"スタッフ","text":"すみません！\\n今ちょっと見てますっ……おかしいな……","trans":"不好意思！\\n我马上检查……真怪……"},{"id":"0000000000000","name":"プロデューサー","text":"ルカ──────","trans":"路加——————"},{"id":"0000000000000","name":"観客１","text":"ねぇ……","trans":"喂……"},{"id":"0000000000000","name":"観客２","text":"うん、ノイズ酷いな……\\n音割れも……","trans":"嗯，杂音好严重……\\n爆音也很……"},{"id":"2026004040080","name":"ルカ","text":"────────────……","trans":"────────────……"},{"id":"0000000000000","name":"観客１","text":"あぁ……演奏止まっちゃった……","trans":"啊……音乐停了……"},{"id":"0000000000000","name":"観客２","text":"なんだよこれ……","trans":"这什么情况……"},{"id":"2026004040090","name":"ルカ","text":"────────────────……","trans":"────────────────……"},{"id":"2026004040100","name":"ルカ","text":"また\\n　　　　　　　　　　　　　　　　　　割れる","trans":"又要\\n　　　　　　　　　　　　　　　　　　碎了"},{"id":"0000000000000","name":"ディレクター","text":"おい、どうなってる！？\\n音、全部止まったぞ……！","trans":"喂，什么情况！？\\n音乐全部停了啊……！"},{"id":"0000000000000","name":"スタッフ","text":"いま確認中で────","trans":"现在在确认————"},{"id":"0000000000000","name":"プロデューサー","text":"（ルカ──────！）","trans":"（路加——————！）"},{"id":"2026004040110","name":"ルカ","text":"もう、いいよ────────","trans":"已经，够了————————"},{"id":"0000000000000","name":"プロデューサー","text":"……！","trans":"……！"},{"id":"2026004040120","name":"ルカ","text":"雑音……雑音……\\n邪魔ばっか────────","trans":"杂音……杂音……\\n总是干扰我————————"},{"id":"2026004040130","name":"ルカ","text":"割れて────────\\n壊れて────────","trans":"碎掉————————\\n坏掉————————"},{"id":"2026004040140","name":"ルカ","text":"アハハッ……！","trans":"啊哈哈……！"},{"id":"2026004040150","name":"ルカ","text":"もうさ\\nいいよ","trans":"我说\\n够了啊"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"2026004040160","name":"ルカ","text":"────────私は、歌う","trans":"————————我会唱的"},{"id":"2026004040170","name":"ルカ","text":"だから、聴けよ","trans":"所以，给我听好"},{"id":"0000000000000","name":"スタッフ","text":"すみません！\\nやはりすぐには直らないかと……！","trans":"不好意思！\\n果然不能马上修好……！"},{"id":"0000000000000","name":"ディレクター","text":"わかった、止めよう\\n一旦、ステージ止めて────────！","trans":"我知道了，停下吧\\n表演暂停————————！"},{"id":"0000000000000","name":"プロデューサー","text":"あ……\\nいえ……！","trans":"啊……\\n不必……！"},{"id":"2026004040180","name":"ルカ","text":"邪魔すんなよ…………","trans":"别干扰我…………"},{"id":"2026004040190","name":"ルカ","text":"邪魔すんなよぉぉぉぉぉ────…………！","trans":"别干扰我————…………！"},{"id":"0000000000000","name":"プロデューサー","text":"息を呑んだ","trans":"屏息"},{"id":"0000000000000","name":"プロデューサー","text":"その瞬間、誰もがステージを見た","trans":"那个瞬间，所有人都看向舞台"},{"id":"0000000000000","name":"プロデューサー","text":"それしかできなかった","trans":"只能这么做"},{"id":"0000000000000","name":"プロデューサー","text":"なあ、ルカ","trans":"路加"},{"id":"0000000000000","name":"プロデューサー","text":"どうして、やめなかったんだ？","trans":"为什么，没有停下来？"},{"id":"2026004040200","name":"ルカ","text":"知るか…………","trans":"谁知道…………"},{"id":"2026004040210","name":"ルカ","text":"ただ………………","trans":"就是………………"},{"id":"2026004040220","name":"ルカ","text":"叫びたかった────────","trans":"想要呐喊——————"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"0000000000000","name":"プロデューサー","text":"そうか、うん","trans":"是吗，嗯"},{"id":"select","name":"","text":"やめないでくれて、\\nよかった","trans":"你没停下\\n真是太好了"},{"id":"select","name":"","text":"また……","trans":"又……"},{"id":"select","name":"","text":"お客さんにとっても……","trans":"对客人而言……"},{"id":"0000000000000","name":"プロデューサー","text":"本当に素晴らしい歌だったよ","trans":"唱得真的很好"},{"id":"0000000000000","name":"プロデューサー","text":"だけど、それ以上の何か……何かが、\\n心に突き刺さった気もしたんだ","trans":"但是，还有一种什么……有种，\\n穿透心灵的感觉"},{"id":"0000000000000","name":"プロデューサー","text":"だから、ただ叫びたかったって聞いて、\\nなんとなく合点したというか────","trans":"所以，听你说只是想呐喊，\\n我就大概理解了————"},{"id":"2026004040230","name":"ルカ","text":"うるせぇ\\nごちゃごちゃと……","trans":"吵死了\\n碎碎念……"},{"id":"0000000000000","name":"プロデューサー","text":"…………","trans":"…………"},{"id":"0000000000000","name":"プロデューサー","text":"ステージのルカを観たいって\\nそう思った……","trans":"我想要\\n看看舞台上的路加……"},{"id":"2026004040240","name":"ルカ","text":"あ…………？","trans":"啊…………？"},{"id":"2026004040250","name":"ルカ","text":"誰がテメェのためにやんだよ","trans":"谁会为了你唱歌啊"},{"id":"0000000000000","name":"プロデューサー","text":"はは……そうだな","trans":"哈哈……是啊"},{"id":"0000000000000","name":"プロデューサー","text":"今日のライブは最高だったと思うよ","trans":"今天的演唱会真的太棒了"},{"id":"2026004040260","name":"ルカ","text":"……機材、壊れてんだろ","trans":"……器材坏了吧"},{"id":"0000000000000","name":"プロデューサー","text":"それが大したことじゃなくなるくらい、\\n今日のライブの、あの瞬間は……","trans":"今天演唱会的那个瞬间，\\n让故障都逊色……"},{"id":"0000000000000","name":"プロデューサー","text":"最高だった\\nありがとう","trans":"最棒了\\n谢谢你"},{"id":"2026004040270","name":"ルカ","text":"……うるせぇ","trans":"……吵死了"}]}