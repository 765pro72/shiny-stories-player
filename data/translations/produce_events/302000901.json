{"translator":"用户提供汉化包（原译者未注明）","rows":[{"id":"3020009010010","name":"透","text":"────裏庭でさ","trans":"————在后院啊","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010020","name":"透","text":"……あれ\r\n裏庭？　裏路地？","trans":"……咦\n后院？　后巷？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010040","name":"透","text":"駐車場みたいなとこ\r\n裏にある、店とかの","trans":"像停车场一样的地方\n在店后面的那种","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010050","name":"雛菜","text":"じゃ、駐車場～？","trans":"那，是停车场～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010060","name":"透","text":"んー、そういうとこ\r\n夜で、めっちゃ","trans":"嗯——，就是那种地方\n晚上，超级","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010080","name":"透","text":"いなくて、まわり\r\n歩いてる人とか","trans":"没什么人，周围\n走路的人也是","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010100","name":"透","text":"殴り合ってる\r\nめっちゃ","trans":"在那儿互殴\n超级","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010110","name":"雛菜","text":"誰が～？","trans":"谁啊～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010120","name":"透","text":"……え？　会社員みたいな人とか\r\nよくわかんない人とか","trans":"……诶？　像公司职员的人\n还有不太认识的人","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010140","name":"透","text":"んー\r\nふふっ、１対１でやる。集まってきて","trans":"嗯——\n呵呵，1对1地打。还围上来","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-60","name":"透の担任","text":"──おーい、浅倉ー","trans":"——喂——，浅仓——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010190","name":"透","text":"────えっ\r\nはい","trans":"————诶\n在","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-63","name":"透の担任","text":"いいとこ来た\r\nカメラ、持ってってくれるかー","trans":"来得正好\n能把相机拿过去吗——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010200","name":"透","text":"……あー\r\n明日のやつ","trans":"……啊——\n明天那个","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-73","name":"透の担任","text":"おー、球技大会な。係だったろー\r\n先生、明日は朝から会議が続くから","trans":"哦，球类比赛啊。你是负责人吧——\n老师明天从早上开始一直开会","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010210","name":"雛菜","text":"透先輩、カメラ係やるの～？","trans":"透前辈，要当摄影负责人吗～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010220","name":"透","text":"うん","trans":"嗯","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010230","name":"雛菜","text":"じゃ、雛菜もやる～！","trans":"那，雏菜也要干～！","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-85","name":"透の担任","text":"……市川さんだっけ。自分のクラスで頑張ることー\r\n種目、何か出るでしょう","trans":"……是市川吧。就好好在自己班上努力吧——\n项目，总有要参加的吧","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010240","name":"雛菜","text":"へ～？\r\n雛菜ってなんか出るんだっけ～？","trans":"诶～？\n雏菜有要参加什么吗～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010250","name":"透","text":"んー……\r\nバスケとか？","trans":"嗯——……\n篮球之类的？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010260","name":"雛菜","text":"バスケか～……","trans":"篮球啊——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010280","name":"雛菜","text":"あは～\r\nそしたら雛菜、バスケに出る～","trans":"啊哈～\n那雏菜就去打篮球～","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"user-100","name":"透の担任","text":"……それじゃまぁ、取りにきて\r\nカメラ扱えるようになっといてくれなー","trans":"……那就，来拿吧\n先练到会用相机吧——","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010310","name":"透","text":"殴り合う\r\n夜になると","trans":"互殴\n一到晚上","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010320","name":"透","text":"どこかから集まってきた\r\n人たちが","trans":"从某处聚集过来的\n人们","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010330","name":"透","text":"ガッ\r\nドン、バシッ","trans":"轰\n咚、啪","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010340","name":"透","text":"歌うみたいに\r\n泣くみたいに","trans":"像在唱歌\n像在哭泣","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010360","name":"透","text":"夢から覚めるみたいに","trans":"像从梦中醒来一样","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010370","name":"透","text":"────なんで","trans":"————为什么","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010390","name":"雛菜","text":"さっきの話～？","trans":"刚才说的那个～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010400","name":"透","text":"んー\r\n観てよ、雛菜も","trans":"嗯——\n你也看看，雏菜","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010410","name":"雛菜","text":"その人たちどこにいるの～？","trans":"那些人是在哪里～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010420","name":"透","text":"テレビ……\r\n映画","trans":"电视……\n电影","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010430","name":"雛菜","text":"あ～\r\nテレビのことか～","trans":"啊～\n是说电视啊～","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010470","name":"透","text":"殴る\r\nガツン","trans":"殴打\n砰","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010490","name":"雛菜","text":"透先輩、ちゃんとこっち見てる～？","trans":"透前辈，有好好看着这边吗～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010500","name":"透","text":"────見てるよ","trans":"————看着呢","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010510","name":"雛菜","text":"いい感じ～？","trans":"感觉不错～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010520","name":"透","text":"うん。いい\r\nもっと","trans":"嗯。不错\n再多来点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010530","name":"透","text":"来て、もっと","trans":"来吧，再多点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010540","name":"透","text":"ガツン、ドン\r\nもっと","trans":"砰、咚\n再多点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010550","name":"雛菜","text":"あは～\r\nもっと何～？","trans":"啊哈～\n再多点什么～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010560","name":"透","text":"ふふっ\r\nもっと────","trans":"呵呵\n再多————","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010570","name":"透","text":"レンズの向こう\r\n雛菜が","trans":"镜头对面\n雏菜","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010580","name":"透","text":"ズダン、バキッ\r\nドン","trans":"咚咣、咔嚓\n咚","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010590","name":"透","text":"────もっときて","trans":"————再多来点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010600","name":"透","text":"ガツン\r\nカシャッ","trans":"砰\n咔嚓","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010610","name":"透","text":"────いいねー……","trans":"————不错啊——……","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010620","name":"雛菜","text":"あは～\r\nもっといく～？","trans":"啊哈～\n还要再来～？","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010640","name":"透","text":"いけるなら\r\nもっと","trans":"能行的话\n再多点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010650","name":"透","text":"カシャッ\r\nバキバキ","trans":"咔嚓\n咔嚓咔嚓","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010660","name":"透","text":"こういう感じかもしれない\r\nたぶん","trans":"也许就是这种感觉\n大概","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010670","name":"透","text":"殴ったり\r\n殴られたり","trans":"殴打\n被打","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010680","name":"透","text":"────いいよ、雛菜","trans":"————可以哦，雏菜","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010690","name":"透","text":"撮らせて\r\nもっと","trans":"让我拍\n再多点","sourceId":"user-enza-fix-2026-11-13","exactOnly":true},{"id":"3020009010700","name":"透","text":"殴ろう","trans":"来打吧","sourceId":"user-enza-fix-2026-11-13","exactOnly":true}],"additionalSources":[{"id":"user-enza-fix-2026-11-13","package":"enza-player-app-fix.zip","dictionary":"data/translations/zh_dynamic.json","sha256":"63c8feb976e689fa7d5b8d21e48ce143c9f462fdaa8a2d1c3367e9c7fccefd98","credit":"用户提供汉化包（原译者未注明）"}]}