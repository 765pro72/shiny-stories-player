{
  "translator": "用户提供汉化包（原译者未注明）",
  "rows": [
    {
      "id": "user-1",
      "name": "プロデューサー",
      "text": "『みんなお疲れ\r\n活動報告用に最近の写真探してるんだけど』",
      "trans": "“大家辛苦了\n我在找最近的照片，用来做活动报告”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020010",
      "name": "結華",
      "text": "『活動報告用？』",
      "trans": "“活动报告用？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-3",
      "name": "プロデューサー",
      "text": "『早いな\r\n返信ありがとう』",
      "trans": "“回得真快\n谢谢回复”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-4",
      "name": "プロデューサー",
      "text": "『今月こんなことしましたよってまとめたいんだ\r\nみんなで仕事した時の写真なんかがあると嬉しい』",
      "trans": "“我想汇总一下这个月做了这些事\n要是有大家一起工作时的照片就好了”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020020",
      "name": "摩美々",
      "text": "『どうぞー』",
      "trans": "“请用——”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020030",
      "name": "結華",
      "text": "『まみみん、それ出しちゃう？』",
      "trans": "“摩美美，那张要发出去吗？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-9",
      "name": "プロデューサー",
      "text": "『早いな\r\nありがとう』",
      "trans": "“真快\n谢谢”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-10",
      "name": "プロデューサー",
      "text": "『なんだこれ笑』",
      "trans": "“这是什么啊笑”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020040",
      "name": "咲耶",
      "text": "『笑いを誘えたようだね。光栄だ』",
      "trans": "“看来成功逗笑你了。真是荣幸”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020050",
      "name": "結華",
      "text": "『プールの仕事の時の写真』",
      "trans": "“是泳池工作时的照片”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020060",
      "name": "結華",
      "text": "『カメラマンさんが記念に撮ってくれて』",
      "trans": "“摄影师给我们拍了做纪念”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-16",
      "name": "プロデューサー",
      "text": "『いつのまに笑』",
      "trans": "“什么时候拍的啊笑”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020070",
      "name": "摩美々",
      "text": "『隙あらば』",
      "trans": "“只要逮到机会”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020080",
      "name": "結華",
      "text": "『この世はアンティーカの遊び場なのです』",
      "trans": "“这世上就是L'Antica的游乐场”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020090",
      "name": "咲耶",
      "text": "『そしてステージでもある』",
      "trans": "“同时也是舞台”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020100",
      "name": "霧子",
      "text": "──……あ……\r\nメッセ……",
      "trans": "——……啊……\n消息……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-28",
      "name": "プロデューサー",
      "text": "『ありがとう。みんながいいなら使わせてもらうよ\r\n@恋鐘　@霧子　お手すきで連絡してくれ』",
      "trans": "“谢谢。如果大家都没问题，我就用了\n@恋钟　@雾子　方便的时候回我一下”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020110",
      "name": "霧子",
      "text": "え、と……\r\nはい……大丈夫で……",
      "trans": "那、那个……\n嗯……没问题……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020120",
      "name": "霧子",
      "text": "……あ──",
      "trans": "……啊──",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020130",
      "name": "結華",
      "text": "『おっと\r\nまだ許可はしてないけど？』",
      "trans": "“哎呀\n我可还没同意哦？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020150",
      "name": "咲耶",
      "text": "『私もね』",
      "trans": "“我也一样”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-39",
      "name": "プロデューサー",
      "text": "『>_<』",
      "trans": "“>_<”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020160",
      "name": "霧子",
      "text": "『はい　大丈夫です』",
      "trans": "“好　没问题的”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-42",
      "name": "プロデューサー",
      "text": "『お』",
      "trans": "“哦”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020170",
      "name": "霧子",
      "text": "『あ』",
      "trans": "“啊”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020180",
      "name": "霧子",
      "text": "……どうしよう\r\nゆっくり……打っちゃったから……",
      "trans": "……怎么办\n我打得太……慢了……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020190",
      "name": "霧子",
      "text": "……\r\nみんな……嫌だったのかな……",
      "trans": "……\n大家……是不是不愿意啊……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020200",
      "name": "結華",
      "text": "『否定もしてないけどね』",
      "trans": "“不过我也没否认哦”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020220",
      "name": "咲耶",
      "text": "『私もだ』",
      "trans": "“我也是”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020230",
      "name": "咲耶",
      "text": "『存分に使ってほしい、プロデューサー』",
      "trans": "“请尽情使用吧，制作人”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020250",
      "name": "結華",
      "text": "『おっけーだよー』",
      "trans": "“OK哦——”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020260",
      "name": "霧子",
      "text": "わ……みんな……\r\nふふ……",
      "trans": "哇……大家……\n呵呵……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-73",
      "name": "霧子",
      "text": "『^^』",
      "trans": "“^^”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-74",
      "name": "プロデューサー",
      "text": "『すまんな　みんなありがとう\r\n恋鐘にも聞いてみるよ^^』",
      "trans": "“抱歉啊　谢谢大家\n我也会去问问恋钟的^^”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020270",
      "name": "結華",
      "text": "『www\r\nＰたん真似しないの』",
      "trans": "“哈哈哈\n别学P碳啊”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020280",
      "name": "結華",
      "text": "『まみみーん』",
      "trans": "“摩美美——”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-80",
      "name": "恋鐘",
      "text": "『^^^^^^^^^^^^^^^^^^^^^^^^^^』",
      "trans": "“^^^^^^^^^^^^^^^^^^^^^^^^^^”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020290",
      "name": "結華",
      "text": "『うわめっちゃ笑ってる\r\nおはようこがたん』",
      "trans": "“哇，笑得超夸张\n早上好啊小宫”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020300",
      "name": "摩美々",
      "text": "『ちょっと何\r\n恋鐘』",
      "trans": "“等一下，你这是\n恋钟”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020310",
      "name": "恋鐘",
      "text": "『うちもOK!!!!!!!!!!』",
      "trans": "“我也OK!!!!!!!!!!”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020320",
      "name": "恋鐘",
      "text": "『ばりにこにこまーく!!!!!!!!!!』",
      "trans": "“超大的笑脸符号!!!!!!!!!!”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020330",
      "name": "結華",
      "text": "『はい\r\nじゃあ満場一致』",
      "trans": "“好\n那就全场一致”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020340",
      "name": "摩美々",
      "text": "『この写真社内共有決定とかｗ』",
      "trans": "“这张照片要公司内部共享了是吧笑”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020350",
      "name": "咲耶",
      "text": "『ディスイズアンティーカさ』",
      "trans": "“这就是L'Antica呢”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020360",
      "name": "恋鐘",
      "text": "『あれ　プロデューサー？』",
      "trans": "“咦　制作人？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020370",
      "name": "結華",
      "text": "『どっかいっちゃったかも？\r\n忙しそう』",
      "trans": "“好像跑哪去了？\n感觉挺忙的”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020380",
      "name": "恋鐘",
      "text": "『ふぇ今ー！　返事急いだとに!!!!!!!!!!』",
      "trans": "“诶，现在才——！　我明明急着回信的说!!!!!!!!!!”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020390",
      "name": "霧子",
      "text": "ふふふっ……\r\n──あ……そうだ……",
      "trans": "呵呵呵……\n——啊……对了……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020400",
      "name": "霧子",
      "text": "『あのね』",
      "trans": "“那个”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020420",
      "name": "霧子",
      "text": "『この写真　待ち受けにしたいの\r\nでも　よこだから』",
      "trans": "“这张照片　我想拿来当手机壁纸\n可是　是横的”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020430",
      "name": "霧子",
      "text": "えっと……なんていうんだろう……",
      "trans": "呃……该怎么说呢……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020440",
      "name": "咲耶",
      "text": "『切れてしまうのかい？』",
      "trans": "“会被裁掉吗？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020450",
      "name": "結華",
      "text": "『あー待って』",
      "trans": "“啊——等等”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020460",
      "name": "摩美々",
      "text": "『このリンクは？』",
      "trans": "“这个链接呢？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020470",
      "name": "結華",
      "text": "『早』",
      "trans": "“快”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020480",
      "name": "咲耶",
      "text": "『アプリかい？』",
      "trans": "“是应用吗？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020490",
      "name": "摩美々",
      "text": "『じゃないと無理かも』",
      "trans": "“不用的话可能不行”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020500",
      "name": "結華",
      "text": "『機種はなんだっけ』",
      "trans": "“机型是什么来着”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020510",
      "name": "霧子",
      "text": "え、と……機種……",
      "trans": "呃……机型……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020520",
      "name": "結華",
      "text": "『でも基本切れちゃうか、ちっちゃくなっちゃうかな』",
      "trans": "“不过基本上都会被裁掉，或者变小吧”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020530",
      "name": "恋鐘",
      "text": "『とろ！』",
      "trans": "“托罗！”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020540",
      "name": "結華",
      "text": "『トロ？』",
      "trans": "“托罗？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020550",
      "name": "恋鐘",
      "text": "『ちがう～　とればよかやろ！\r\nもっかい写真』",
      "trans": "“不对～　拍一下不就好了！\n再拍一张照片”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020560",
      "name": "恋鐘",
      "text": "『たてで！』",
      "trans": "“竖着拍！”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020570",
      "name": "咲耶",
      "text": "『なるほど\r\nしかし目は開けられるようになったのかい？』",
      "trans": "“原来如此\n不过你已经能睁开眼睛了吗？”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020580",
      "name": "恋鐘",
      "text": "『そいはまだやけど!!!!\r\n水中っぽくとればよかよ！』",
      "trans": "“那个还不行啦!!!!\n拍得像在水里就好了！”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020590",
      "name": "結華",
      "text": "『あー、ホリゾントで撮って\r\n加工するのもアリか』",
      "trans": "“啊——用背景幕拍\n再加工一下也可以啊”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020600",
      "name": "摩美々",
      "text": "『確かにー』",
      "trans": "“确实——”",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020610",
      "name": "霧子",
      "text": "ふふ……\r\nおもしろそう……！",
      "trans": "呵呵……\n好像很有趣……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "3008008020620",
      "name": "結華",
      "text": "『じゃあさ』────",
      "trans": "“那，我说”————",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-179",
      "name": "プロデューサー",
      "text": "えーと、恋鐘からレスもらわなきゃな",
      "trans": "呃，得收到恋钟的回复才行啊",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-181",
      "name": "プロデューサー",
      "text": "──み、未読192件……！",
      "trans": "——未、未读192条……！",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    },
    {
      "id": "user-182",
      "name": "プロデューサー",
      "text": "はは……\r\n楽しそうだな……",
      "trans": "哈哈……\n看起来很开心啊……",
      "sourceId": "user-enza-fix-2026-11-13",
      "exactOnly": true
    }
  ],
