{"translator":"可可","rows":[{"id":"6024003100010","name":"にちか","text":"────…………","trans":"────…………"},{"id":"0000000000000","name":"プロデューサー","text":"……にちか","trans":"……日花"},{"id":"0000000000000","name":"プロデューサー","text":"お疲れ様","trans":"辛苦了"},{"id":"6024003100020","name":"にちか","text":"……\\nほんとに落ちましたけど","trans":"……\\n还真的落选了"},{"id":"6024003100030","name":"にちか","text":"あははっ、自分で勝手に応募したんだから\\n自業自得かー","trans":"啊哈哈，毕竟是我自作主张报名的\\n这就是自作自受吧"},{"id":"0000000000000","name":"プロデューサー","text":"……","trans":"……"},{"id":"6024003100040","name":"にちか","text":"これで終わりですね","trans":"已经结束了呢"},{"id":"0000000000000","name":"プロデューサー","text":"……そうかもしれない","trans":"……也许是这样吧"},{"id":"6024003100050","name":"にちか","text":"……っ","trans":"……呃"},{"id":"0000000000000","name":"プロデューサー","text":"でも","trans":"不过"},{"id":"0000000000000","name":"プロデューサー","text":"……だとしても、俺の提案のせいで終わったんだ\\nにちかのせいじゃない","trans":"……即便如此，也是因为我的要求才结束的\\n不是日花的错"},{"id":"0000000000000","name":"プロデューサー","text":"始めてくれ、にちか","trans":"那么开始吧，日花"},{"id":"6024003100060","name":"にちか","text":"…………え","trans":"…………诶"},{"id":"0000000000000","name":"プロデューサー","text":"次はにちかが始めてくれ","trans":"接下来日花就能重新开始了"}]}